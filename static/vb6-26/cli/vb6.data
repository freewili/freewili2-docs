Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Declare Function TextOut Lib "gdi32" Alias "TextOutA" (ByVal hdc As Long, ByVal X As Long, ByVal Y As Long, ByVal lpString As String, ByVal nCount As Long) As Long

Private Sub tmr1_Timer()
    tmr1.Enabled = False   '// one-shot
    txtEdit.Text = ""
    txtEdit.Move grd1.Left + grd1.CellLeft, grd1.Top + grd1.CellTop, grd1.CellWidth, grd1.CellHeight
    txtEdit.Visible = True
    txtEdit.SetFocus
End Sub

Private Sub grd1_KeyPress(KeyAscii As Integer)
    '// If the grid steals characters meant for the overlay editor, they land here.
    lblGridKey.Caption = lblGridKey.Caption & Chr(KeyAscii)
End Sub

Private Sub pctHost_Resize()
    '// container Resize handler must fire when the box is sized -> re-flows its child
    lblInner.Width = pctHost.ScaleWidth
End Sub

Private Sub Form_Load()
    Dim h As Long
    '// 1) GDI-on-surface + PaintPicture double buffer
    pctSrc.ForeColor = vbWhite
    pctSrc.Cls
    h = pctSrc.hdc
    TextOut h, 5, 5, "HELLO", 5
    pctDst.PaintPicture pctSrc.Image, 0, 0

    '// 2) resizing a container fires its _Resize (re-flows children)
    pctHost.Width = 4000   '// ScaleWidth becomes ~3940; pctHost_Resize copies it to lblInner

    '// 3) FlexGrid current-cell geometry for in-place editing
    grd1.ColWidth(0) = 600
    grd1.ColWidth(1) = 900
    grd1.ColWidth(2) = 900
    grd1.Row = 2
    grd1.Col = 2

    If h <> 0 Then lblOut.Caption = "ok " & pctSrc.ScaleMode Else lblOut.Caption = "no-hdc"
End Sub
wait 0.5
expect lblOut.Caption == "ok 1"
expect frmMain.pctSrc.ScaleMode == 1
expect (frmMain.pctSrc.hdc > 0) == True
expect (lblInner.Width > 3000) == True
expect grd1.CellLeft == 1500
expect grd1.CellWidth == 900
expect grd1.CellTop == 510
expect grd1.CellHeight == 255
expect (frmMain.pnlBottom.Top + frmMain.pnlBottom.Height >= frmMain.ScaleHeight - 20) And (frmMain.pnlBottom.Top + frmMain.pnlBottom.Height <= frmMain.ScaleHeight + 20) == True
expect tbLeft.Buttons.Count == 3
wait 0.6
type txtEdit AB
wait 0.5
expect txtEdit.Text == "AB"
expect lblGridKey.Caption == ""
end
