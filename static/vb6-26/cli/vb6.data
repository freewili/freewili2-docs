Attribute VB_Name = "frmMain"
Attribute VB_Creatable = False
Attribute VB_Exposed = False
Attribute VB_GlobalNameSpace = False
Attribute VB_PredeclaredId = True
Option Explicit

Private ticks As Long

Private Sub Form_Load()
    List1.AddItem "Apple"
    List1.AddItem "Banana"
    List1.AddItem "Cherry"
    Combo1.AddItem "One"
    Combo1.AddItem "Two"
    Combo1.ListIndex = 0
    Caption = "Sample Two - " & App.Title
End Sub

Private Sub cmdGo_Click()
    gClicks = gClicks + 1
    If Check1.Value = vbChecked Then
        lblOut.Caption = "Hello, " & txtName.Text & " (" & gClicks & ")"
    Else
        lblOut.Caption = Shout(txtName.Text)
    End If
    If optSize(1).Value Then lblOut.FontBold = True Else lblOut.FontBold = False
End Sub

Private Sub Check1_Click()
    lblOut.Caption = "check=" & Check1.Value
End Sub

Private Sub List1_Click()
    lblOut.Caption = "list: " & List1.List(List1.ListIndex)
End Sub

Private Sub Combo1_Click()
    lblOut.Caption = "combo: " & Combo1.Text
End Sub

Private Sub optSize_Click(Index As Integer)
    lblOut.Caption = "size " & Index
End Sub

Private Sub Timer1_Timer()
    ticks = ticks + 1
    lblTicks.Caption = CStr(ticks)
    Circle (5000, 3300), 200 + (ticks Mod 5) * 40, vbBlue
End Sub

Private Sub txtName_KeyPress(KeyAscii As Integer)
    If KeyAscii = Asc("!") Then KeyAscii = 0
End Sub

Private Sub mnuNew_Click()
    txtName.Text = ""
    lblOut.Caption = "new"
End Sub

Private Sub mnuExit_Click()
    Unload Me
End Sub

Private Sub Form_Unload(Cancel As Integer)
    Debug.Print "unloading after"; gClicks; "clicks"
End Sub
Attribute VB_Name = "modUtil"
Option Explicit

Public gClicks As Long

Public Function Shout(s As String) As String
    Shout = UCase$(s) & "!"
End Function
wait 0.5
expect frmMain.Caption == "Sample Two - Sample Two"
expect lblOut.Caption == "combo: One"
expect txtName.Text == "World"
expect List1.ListCount == 3
expect Combo1.Text == "One"
click cmdGo
wait 0.2
expect lblOut.Caption == "Hello, World (1)"
click Check1
wait 0.2
expect Check1.Value == 0
expect lblOut.Caption == "check=0"
click cmdGo
wait 0.2
expect lblOut.Caption == "WORLD!"
click optSize(1)
wait 0.2
expect optSize(1).Value == True
expect optSize(0).Value == False
expect lblOut.Caption == "size 1"
click txtName
key ctrl+a
type txtName Bob!
wait 0.3
expect txtName.Text == "WorldBob"
key Enter
wait 0.3
expect lblOut.Caption == "WORLDBOB!"
expect gClicks == 3
wait 0.6
expect Val(lblTicks.Caption) > 3
key ctrl+n
wait 0.3
expect lblOut.Caption == "new"
expect txtName.Text == ""
wait 0.3
end
