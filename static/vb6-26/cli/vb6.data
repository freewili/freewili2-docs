Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private mClicks As Integer
Private mDbl As Integer
Private Sub Form_Load()
    List1.AddItem "alpha"
    List1.AddItem "beta"
    List1.AddItem "gamma"
End Sub
Private Sub List1_Click()
    mClicks = mClicks + 1
    lblClick.Caption = CStr(mClicks)
End Sub
Private Sub List1_DblClick()
    mDbl = mDbl + 1
    lblDbl.Caption = CStr(mDbl)
End Sub
wait 0.6
dblclick list1
wait 0.4
expect lblDbl.Caption == "1"
expect (Val(lblClick.Caption) <= 1) == True
end
