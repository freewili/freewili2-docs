Attribute VB_Name = "frmMain"
Option Explicit

' mscomctl constants (not yet in the core constant table)
Private Const tvwChild = 4

Private Sub Form_Load()
    Dim li As ListItem, nd As Node
    Set li = ListView1.ListItems.Add(, "a", "Alpha")
    li.SubItems(1) = "10"
    Set li = ListView1.ListItems.Add(, "b", "Beta")
    li.SubItems(1) = "20"
    Set li = ListView1.ListItems.Add(, "c", "Gamma")
    li.SubItems(1) = "30"
    Set nd = TreeView1.Nodes.Add(, , "root", "Root")
    nd.Expanded = True
    TreeView1.Nodes.Add "root", tvwChild, "c1", "Child 1"
    TreeView1.Nodes.Add "root", tvwChild, "c2", "Child 2"
    StatusBar1.Panels(1).Text = "Loaded"
End Sub

Private Sub Timer1_Timer()
    If ProgressBar1.Value < ProgressBar1.Max Then ProgressBar1.Value = ProgressBar1.Value + 10
End Sub

Private Sub Slider1_Change()
    lblOut.Caption = "slider " & Slider1.Value
End Sub

Private Sub TabStrip1_Click()
    lblOut.Caption = "tab " & TabStrip1.SelectedItem.Index & " " & TabStrip1.SelectedItem.Caption
End Sub

Private Sub ListView1_ItemClick(ByVal Item As MSComctlLib.ListItem)
    lblOut.Caption = "item " & Item.Text & "/" & Item.SubItems(1)
End Sub

Private Sub TreeView1_NodeClick(ByVal Node As MSComctlLib.Node)
    lblOut.Caption = "node " & Node.FullPath
End Sub

Private Sub Toolbar1_ButtonClick(ByVal Button As MSComctlLib.Button)
    lblOut.Caption = "tool " & Button.Key
End Sub

Private Sub UpDown1_Change()
    lblOut.Caption = "updown " & UpDown1.Value
End Sub

Private Sub cmdTab_Click()
    TabStrip1.Tabs(2).Selected = True
End Sub

Private Sub cmdSlide_Click()
    Slider1.Value = 42
End Sub

Private Sub cmdItem_Click()
    ListView1_ItemClick ListView1.ListItems(3)
End Sub

Private Sub cmdNode_Click()
    TreeView1_NodeClick TreeView1.Nodes("c2")
End Sub

Private Sub cmdTool_Click()
    Toolbar1_ButtonClick Toolbar1.Buttons(2)
End Sub

Private Sub cmdUp_Click()
    UpDown1.Value = 5
End Sub

Private Sub cmdOpen_Click()
    On Error Resume Next
    CommonDialog1.CancelError = True
    CommonDialog1.Filter = "Text (*.txt)|*.txt|All files (*.*)|*.*"
    CommonDialog1.ShowOpen
    lblDlg.Caption = "err=" & Err.Number
End Sub
wait 0.5
expect lblOut.Caption == "ready"
expect ListView1.ListItems.Count == 3
expect ListView1.ColumnHeaders.Count == 2
expect ListView1.ListItems(2).SubItems(1) == "20"
expect ListView1.ListItems("c").Text == "Gamma"
expect TreeView1.Nodes.Count == 3
expect TreeView1.Nodes("root").Children == 2
expect TreeView1.Nodes("c2").FullPath == "Root\Child 2"
expect StatusBar1.Panels.Count == 2
expect StatusBar1.Panels(1).Text == "Loaded"
expect Toolbar1.Buttons.Count == 2
expect Toolbar1.Buttons(2).Key == "open"
expect TabStrip1.Tabs.Count == 3
expect TabStrip1.SelectedItem.Index == 1
click cmdTab
wait 0.2
expect lblOut.Caption == "tab 2 Two"
click cmdSlide
wait 0.2
expect lblOut.Caption == "slider 42"
click Slider1
wait 0.3
expect Slider1.Value >= 40 And Slider1.Value <= 60
click cmdItem
wait 0.2
expect lblOut.Caption == "item Gamma/30"
click cmdNode
wait 0.2
expect lblOut.Caption == "node Root\Child 2"
click cmdTool
wait 0.2
expect lblOut.Caption == "tool open"
click cmdUp
wait 0.2
expect lblOut.Caption == "updown 5"
expect ProgressBar1.Value > 0
click cmdOpen
wait 0.6
key Escape
wait 0.4
expect lblDlg.Caption == "err=32755"
end
