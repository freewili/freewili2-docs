Private Sub mnuSetupMonitor_Click()
    
    '// Show the setup monitor dialog
    MousePointer = vbHourglass
    Set frmSetupMonitor.obApp = obApp
    frmSetupMonitor.Show vbModal, Me
    MousePointer = vbDefault

    '// setup the bus load max
    pgBusLoad.Max = obApp.Monitor.BusLoadMaxMessages

    With obApp.Monitor

        '// setup the backcolor of the on and off screen drawning objects
        pctRead.BackColor = .BackColor
        pctDraw.BackColor = .BackColor
    
        '// setup the display
        Call SetShowParameters(.ShowDescription, .ShowDataBytes, .DisplayFormat)
        
        If .ShowDescription Then
            tbScroll.Buttons("description").Value = tbrPressed
        Else
            tbScroll.Buttons("description").Value = tbrUnpressed
        End If
        
        If .ShowDataBytes Then
            tbScroll.Buttons("databytes").Value = tbrPressed
        Else
            tbScroll.Buttons("databytes").Value = tbrUnpressed
        End If
        
        tbScroll.Buttons("format").Image = .DisplayFormat + 3
        
        '// setup bothe the toolbar and context menu for monitor
        If .UseFilters Then
            tbMonitor.Buttons("filterson").Value = tbrPressed
            mnuMonitorFilterOn.Checked = True
        Else
            tbMonitor.Buttons("filterson").Value = tbrUnpressed
            mnuMonitorFilterOn.Checked = False
        End If
    End With
    
    '// force an update the scrolling monitor
    UpdateMonitorDisplay True
    
    
End Sub

Private Sub ShowHelpFile(sFile As String, Optional bShowImmediately As Boolean = False)
    Dim sFullPath As String '// full path of the help file
    
    If Not (mfrmHelp Is Nothing) Then
        If mfrmHelp.Visible Then
            
            sFullPath = "its:" & App.Path & "\icsVehicleSpy.chm::\" & sFile
            If sFullPath <> sOldHelpPath Then
                
                If bNotWaitTimeStarted Then
                    dStartHelpTime = Timer + 1
                    bNotWaitTimeStarted = False
                End If
                
                If Timer > dStartHelpTime Or bShowImmediately Then

                    sOldHelpPath = sFullPath
                    Call mfrmHelp.WebBrowser1.Navigate(sFullPath)
                    bNotWaitTimeStarted = True
                End If
                
            End If
        Else
            Set mfrmHelp = Nothing
        End If
    End If
    
End Sub

