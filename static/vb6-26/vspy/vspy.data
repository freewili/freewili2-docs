Attribute VB_Name = "cTxButtons"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Attribute VB_Ext_KEY = "Collection" ,"cTransmitButton"
Attribute VB_Ext_KEY = "Member0" ,"cTransmitButton"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'local variable to hold collection
Private mCol As Collection

Public Function Add(Optional sKey As String) As cTransmitButton
    
    'create a new object
    Dim objNewMember As cTransmitButton
    Set objNewMember = New cTransmitButton


    'set the properties passed into the method
    If Len(sKey) = 0 Then
        mCol.Add objNewMember
    Else
        mCol.Add objNewMember, sKey
    End If


    'return the object created
    Set Add = objNewMember
    Set objNewMember = Nothing

End Function


Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage)
    '// used to read/write the
    Dim obPB As New PropertyBag '//
    Dim bContents() As Byte
    Dim vDummy As Variant
    Dim vReturn As Variant
    Dim lCount As Long
    Dim lNumItems As Long
    Dim sKey As String
    Dim obTxButton As cTransmitButton
    
    
    If bWriteDirection Then
        
        '// write the number of items to the bag
        Call obPB.WriteProperty("NumberOfTxButtons", mCol.Count, 0)
        
        '// write the key to the bag and then the object
        For lCount = 1 To mCol.Count
            Call Item(lCount).ReadWrite(bWriteDirection, obPB, lCount)
        Next lCount

        '// store the array
        bContents = obPB.Contents
        obSave.ReadWriteArray bContents
        
    Else
        RemoveAll '// erase the current collection
        
        '// fill the property bag
        obSave.ReadWriteArray vDummy, vReturn
        If Not IsEmpty(vReturn) Then
        
        obPB.Contents = vReturn
        
        '// read number of items
        lNumItems = obPB.ReadProperty("NumberOfTxButtons", 0)
        
        '// read the key, add the item, and then read it from the property bag
        For lCount = 1 To lNumItems
            Set obTxButton = Add()
            Call obTxButton.ReadWrite(bWriteDirection, obPB, lCount)
        Next lCount
        
        End If
    End If
End Function

