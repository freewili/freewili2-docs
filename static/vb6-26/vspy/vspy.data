Attribute VB_Name = "frmAutoRespond"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public obApp As cicsSpy
Public sIncomingMessageKey As String                   '// index of the equation we are editing

Public Sub SetupUI()
    Dim sName As String
    Dim lCount As Long
    Dim inMsg As cIncomingMessage
    Dim lIndex As Long
    
    
    Set inMsg = obApp.IncomingMessages(sIncomingMessageKey)
    
    '// fill the outgoing message box
    lstOutgoingMessages.Clear
    lstOutgoingMessages.AddItem "None"
    For lCount = 1 To obApp.OutgoingMessages.Count
        sName = obApp.OutgoingMessages(lCount).Description
        If sName = "" Then sName = "Unamed message " & lCount
        lstOutgoingMessages.AddItem sName
    Next lCount
    
    '// set the selected item
    If Len(inMsg.ResponseKey) = 0 Then
        lstOutgoingMessages.ListIndex = 0
    Else
        If obApp.OutgoingMessages.KeyExists(inMsg.ResponseKey) Then
            lstOutgoingMessages.ListIndex = obApp.OutgoingMessages.ReturnIndexFromKey(inMsg.ResponseKey)
        End If
    End If
    
    '// set the correct option
    optRespond(inMsg.AutoRepondType).Value = True
    
    txtFixedDelay = Format$(inMsg.AutoRepondDelayOne)
    txtShortDelay = Format$(inMsg.AutoRepondDelayOne)
    txtLongDelay = Format$(inMsg.AutoRepondDelayTwo)
    
End Sub

Private Sub CmdCancel_Click()
    Unload Me
End Sub

Private Sub CmdOk_Click()
    With obApp.IncomingMessages(sIncomingMessageKey)
        
        If lstOutgoingMessages.ListIndex > 0 Then
            .ResponseKey = obApp.OutgoingMessages(lstOutgoingMessages.ListIndex).Key
        Else
            If lstOutgoingMessages.ListIndex = 0 Then
                .ResponseKey = ""
            End If
        End If
        
        If optRespond(0) Then .AutoRepondType = icsspyRespondImmediately
        If optRespond(1) Then
            .AutoRepondType = icsspyRespondFixedDelay
            .AutoRepondDelayOne = Val(txtFixedDelay)
        End If
        If optRespond(2) Then
            .AutoRepondType = icsspyRespondRandomDelay
            .AutoRepondDelayOne = Val(txtShortDelay)
            .AutoRepondDelayTwo = Val(txtLongDelay)
        End If
    End With
    obApp.App.SaveNeeded = True
    Unload Me
End Sub

Private Sub Form_Load()
    lblOutgoingMessage = LoadResString(101)
    fRespond = LoadResString(102)
    optRespond(0).Caption = " " & LoadResString(103)
    optRespond(1).Caption = " " & LoadResString(104)
    optRespond(2).Caption = " " & LoadResString(106)
    lblDelaySec = LoadResString(105)
    lblDelayShortSec = LoadResString(107)
    lblDelayLongSec = LoadResString(108)
    cmdOk.Caption = LoadResString(109)
    Me.Caption = LoadResString(110)
End Sub


Private Sub optRespond_Click(Index As Integer)
    If optRespond(0) Then
        txtFixedDelay.Enabled = False
        lblDelaySec.Enabled = False
        lblDelayShortSec.Enabled = False
        lblDelayLongSec.Enabled = False
        txtShortDelay.Enabled = False
        txtLongDelay.Enabled = False
    End If
    If optRespond(1) Then
        txtFixedDelay.Enabled = True
        lblDelaySec.Enabled = True
        lblDelayShortSec.Enabled = False
        lblDelayLongSec.Enabled = False
        txtShortDelay.Enabled = False
        txtLongDelay.Enabled = False
    End If
    If optRespond(2) Then
        txtFixedDelay.Enabled = False
        lblDelaySec.Enabled = False
        lblDelayShortSec.Enabled = True
        lblDelayLongSec.Enabled = True
        txtShortDelay.Enabled = True
        txtLongDelay.Enabled = True
    End If
End Sub
