Attribute VB_Name = "ModifyTime"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Option Explicit

Public timevalue As Long

Private hours As Integer
Private seconds As Integer
Private minutes As Integer
Private QuarterSeconds As Integer





Private Sub sclTime_Change(Index As Integer)
Const cHours = 0
Const cMinutes = 1
Const cSeconds = 2
Const cQuarters = 3


Select Case Index

    Case cHours
        
        If sclTime(cHours) = -1 Then hours = hours + 1
        If sclTime(cHours) = 1 Then hours = hours - 1
        If hours < 0 Then hours = 999
        If hours > 999 Then hours = 0
        
        
    Case cMinutes
        
        If sclTime(cMinutes) = -1 Then minutes = minutes + 1
        If sclTime(cMinutes) = 1 Then minutes = minutes - 1
        If minutes > 59 Then minutes = 0
        If minutes < 0 Then minutes = 59
        
    Case cSeconds
        
        If sclTime(cSeconds) = -1 Then seconds = seconds + 1
        If sclTime(cSeconds) = 1 Then seconds = seconds - 1
        If seconds > 59 Then seconds = 0
        If seconds < 0 Then seconds = 59
    
    Case cQuarters
        
        If sclTime(cQuarters) = -1 Then QuarterSeconds = QuarterSeconds + 25
        If sclTime(cQuarters) = 1 Then QuarterSeconds = QuarterSeconds - 25
        If QuarterSeconds > 75 Then QuarterSeconds = 0
        If QuarterSeconds < 0 Then QuarterSeconds = 75

End Select


sclTime(Index).Value = 0
Call ShowTime
End Sub

Private Function buildStepValue() As Long

'// Build the quarter secondstring
buildStepValue = 14400 * CLng(hours) + 240 * CLng(minutes) + 4 * CLng(seconds) + CLng(QuarterSeconds) / 25

End Function

Private Sub UserLoad()

Dim lvalue

QuarterSeconds = 0
seconds = 0
minutes = 0
hours = 0
    
    lvalue = timevalue
        
        Do While lvalue - 14400 >= 0
            lvalue = lvalue - 14400
            hours = hours + 1
        Loop
        
        Do While lvalue - 240 >= 0
            lvalue = lvalue - 240
            minutes = minutes + 1
        Loop
        
        Do While lvalue - 4 >= 0
            lvalue = lvalue - 4
            seconds = seconds + 1
        Loop
        
        QuarterSeconds = lvalue * 25
    
    Call ShowTime

End Sub

Public Sub ShowTime()
    lblTime = Format(hours, "000") & ":" & Format(minutes, "00")
    lblTime = lblTime & ":" & Format(seconds, "00") & "." & Format(QuarterSeconds, "00")
End Sub


Public Property Get Value() As Long
Attribute Value.VB_UserMemId = 0
    Value = buildStepValue
End Property

Public Property Let Value(ByVal vNewValue As Long)
    timevalue = vNewValue
    Call UserLoad
End Property

Public Property Let Enabled(ByVal bNew As Boolean)
    sclTime(0).Enabled = bNew
    sclTime(1).Enabled = bNew
    sclTime(2).Enabled = bNew
    sclTime(3).Enabled = bNew
    lbl(0).Enabled = bNew
    lbl(1).Enabled = bNew
    lbl(2).Enabled = bNew
    lbl(3).Enabled = bNew
    lblTime.Enabled = bNew
End Property
Public Property Get Enabled() As Boolean
    Enabled = sclTime(0).Enabled
End Property

