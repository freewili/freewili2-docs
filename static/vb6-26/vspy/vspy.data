    Dim lMaxRow As Long
    Dim lNumItems As Long
    Dim lItemCount As Long
    Dim lRowCount As Long
    

    '// Determine the minimum and the maximum
    DetermineMinAndMax grdOutgoingMessages.Row, grdOutgoingMessages.RowSel, lMinRow, lMaxRow
    lNumItems = Abs(lMinRow - lMaxRow) + 1        '// Determine the number of steps
    
    ReDim sKeys(1 To lNumItems)
    
    '// for each row
    For lRowCount = lMinRow To lMaxRow
        lItemCount = lItemCount + 1
        sKeys(lItemCount) = grdOutgoingMessages.TextMatrix(lRowCount, 0)
    Next lRowCount
        
    '// copy the messages to the clipboard

    '// Determine the number of steps
    lNumSteps = Abs(LBound(sKeys) - UBound(sKeys)) + 1

    ob.WriteDirection = True
    ob.UseByteArray = True

    ob.ReadWriteLong lNumSteps

    '// lMin To lMax
    For lCount = LBound(sKeys) To UBound(sKeys)
        Set obMsg = obApp.OutgoingMessages(sKeys(lCount))
        Call obMsg.ReadWrite(True, ob, lVersion)
    Next lCount

    data = ob.Bytes
    ob.UseByteArray = False

    '// Place the data on the clip board
    Call obClipBoardOutgoing.PlaceDataOnClipBoard(hwnd, data)
    
    'For lCount = lMin To lMax
    '    sClip = sClip & Steps(CInt(lCount)).StepDescription(lCount) & vbCrLf
    'Next lCount

    '// Set the text on the clipboard
