Private Property Get IicsHardware_NumberForIOPointType(ByVal IOPointType As icsHardware.iicsIOPointType) As Long
    Dim lCount As Long
    Dim lNumItems As Long
    Dim lItemCount As Long
    
    Select Case IOPointType
        Case iicsTypeAnalogOutput
            lNumItems = OutgoingMessages.Count
            For lCount = 1 To lNumItems
                If OutgoingMessages(lCount).ValueType = icsVSPYAnalogoutput Then
                    lItemCount = lItemCount + 1
                End If
            Next lCount
            IicsHardware_NumberForIOPointType = lItemCount
        Case iicsTypeAnalogInput
            lNumItems = IncomingMessages.Count
            For lCount = 1 To lNumItems
                If IncomingMessages(lCount).ValueType = icsVSPYAnalogInput Then
                    lItemCount = lItemCount + 1
                End If
            Next lCount
            '// return the number of io points
            IicsHardware_NumberForIOPointType = lItemCount
        Case iicsTypeDigitalOutput
            IicsHardware_NumberForIOPointType = OutgoingMessages.Count
        Case iicsTypeDigitalInput
            lNumItems = IncomingMessages.Count
            For lCount = 1 To lNumItems
                If IncomingMessages(lCount).ValueType = icsVSPYDigitalInput Then
                    lItemCount = lItemCount + 1
                End If
            Next lCount
            '// all messages for present and all messages for in flags
            IicsHardware_NumberForIOPointType = lItemCount + IncomingMessages.Count
        Case Else
            IicsHardware_NumberForIOPointType = 0
    End Select
End Property

Private Function IicsHardware_OpenHardware(ByVal AnalogInputMinRanges As Variant, ByVal AnalogInputMaxRanges As Variant, ByVal InitalCounts As Variant, ErrorString As String) As Boolean
    Dim lNumInputs As Long
    Dim lNumOutputs As Long
    Dim lCount As Long
    
    Debug.Print "hardware opened"
    
    '// build the cache vectors //////////////////////////////////////////
    lNumInputs = IncomingMessages.Count
    lNumOutputs = OutgoingMessages.Count
        
    '// reset the input counts
    lNumAnalogInputs = 0
    lNumDigitalInputs = 0
    lNumAnalogOutputs = 0
    
    
    m_bRoboTechRunMode = True
    
    If lNumOutputs > 0 Then
        ReDim lAnalogOutputVector(1 To lNumOutputs)
        
        For lCount = 1 To lNumOutputs
            If OutgoingMessages(lCount).ValueType = icsVSPYAnalogoutput Then
                lNumAnalogOutputs = lNumAnalogOutputs + 1
                lAnalogOutputVector(lNumAnalogOutputs) = lCount
            End If
        Next lCount
        
        '// re-size  to the correct size
        If lNumAnalogOutputs = 0 Then
            Erase lAnalogOutputVector
        Else
            ReDim Preserve lAnalogOutputVector(1 To lNumAnalogOutputs)
        End If
        
    End If
    
    
    If lNumInputs > 0 Then '// only if there are actually inputs
        
        '// setup the vectors max size
        ReDim lAnalogInputVector(1 To lNumInputs)
        ReDim lDigitalInputVector(1 To lNumInputs)
        
        
        For lCount = 1 To lNumInputs '// cycle through all of the inputs
            '// is the input analog or digital
            Select Case IncomingMessages(lCount).ValueType
                Case icsVSPYAnalogInput
                    lNumAnalogInputs = lNumAnalogInputs + 1
                    lAnalogInputVector(lNumAnalogInputs) = lCount
                Case icsVSPYDigitalInput
                    lNumDigitalInputs = lNumDigitalInputs + 1
                    lDigitalInputVector(lNumDigitalInputs) = lCount
            End Select
        Next lCount
        
        '// free the memory not used - analog inputs
        If lNumAnalogInputs = 0 Then
            Erase lAnalogInputVector
        Else
            ReDim Preserve lAnalogInputVector(1 To lNumAnalogInputs)
        End If
        
        '// free the memory not used - digital inputs
        If lNumDigitalInputs = 0 Then
            Erase lDigitalInputVector
        Else
            ReDim Preserve lDigitalInputVector(1 To lNumDigitalInputs)
        End If
        
        
        
        
    End If
    '/////////////////////////////////////////////////////////////////////
    
    '// save the incoming count when started
    m_lRoboTechInputCount = IncomingMessages.Count
    m_lRoboTechOutputCount = OutgoingMessages.Count
    
    MonitorOn = True
    
    IicsHardware_OpenHardware = MonitorOn

End Function





