End Property

Public Property Get AutoRespondValueFile() As String
    If Trim$(mvarAutoRespondValueFile) = "" Then
        AutoRespondValueFile = "(none)"
    Else
        AutoRespondValueFile = mvarAutoRespondValueFile
    End If
End Property

Public Property Let AutoRespondValueFile(sNew As String)
   mvarAutoRespondValueFile = sNew
End Property

Friend Property Get DoubleValue() As Double
    DoubleValue = mvarValue
End Property

'// build the message for transmission

Friend Property Get J1850Msg() As icsSpyMessageJ1850
    SetupMSG
    LSet J1850Msg = msg
End Property

Friend Property Get canmsg() As icsSpyMessageLong
    SetupCANMSG
    LSet canmsg = msg
End Property

Private Sub SetupMSG()

Dim lNumMessageBytes As Long
Dim lCount As Long
Dim lMsg As icsSpyMessageJ1850
Dim amsg As icsSpyMessageLong
Dim dResult As Double


On Error Resume Next

LSet lMsg = msg



lMsg.StatusBitField = icsSpyStatusNetworkMessageType

'// Determine the number of message bytes
For lCount = 1 To 20
    If Trim$(mByteString(lCount)) = "" Then
        Exit For
    End If
Next lCount

lNumMessageBytes = lCount - 1

If lNumMessageBytes > 3 Then
    lMsg.NumberBytesHeader = 3
    lMsg.NumberBytesData = lNumMessageBytes - 3
Else
    lMsg.NumberBytesHeader = lNumMessageBytes
End If

'// Setup the header bytes
For lCount = 1 To lMsg.NumberBytesHeader
    If InStr(1, mByteString(lCount), "=") = 0 Then
        lMsg.Header(lCount) = Val("&H" & mByteString(lCount))
    Else
        '// Evaluate the expression, make sure to remove the "equal sign"
        If ParseExpressionForAnalogItems(Parent, False, _
            Right$(mByteString(lCount), Len(mByteString(lCount)) - 1), _
                                                            dResult, mvarValue) Then
            If dResult < 0 Then dResult = 0
            If dResult > 255 Then dResult = 255
            lMsg.Header(lCount) = CByte(dResult)
        Else
            ReportError "There was an error in the equation the message bytes"
        End If
    End If
Next lCount

'// Setup the data bytes
For lCount = 1 To lMsg.NumberBytesData
    If Mid$(mByteString(lCount + 3), 1, 1) <> "=" Then
        lMsg.data(lCount) = Val("&H" & mByteString(lCount + 3))
    Else
        '// Evaluate the expression, make sure to remove the "equal sign"
        If ParseExpressionForAnalogItems(Parent, False, _
            Right$(mByteString(lCount + 3), Len(mByteString(lCount + 3)) - 1), _
                                                            dResult, mvarValue) Then
           If dResult < 0 Then dResult = 0
           If dResult > 255 Then dResult = 255
            lMsg.data(lCount) = CByte(dResult)
        Else
            ReportError "There was an error in the equation the message bytes"
        End If
    End If
Next lCount

LSet msg = lMsg

If Err.Number <> 0 Then
    ReportError "Problem Setting up outgoing message named:" & Me.Description _
                        & vbCrLf & vbCrLf & "Details : SetupMSG"
End If


End Sub

Private Sub ReportError(sError As String)
    If Parent Is Nothing Then
        MsgBox sError, vbInformation
    Else
        Parent.AddVehicleSpyError sError
    End If
End Sub

Private Sub SetupCANMSG()

Dim lNumMessageBytes As Long
Dim lCount As Long
Dim lMsg As icsSpyMessageLong
Dim amsg As icsSpyMessageJ1850
Dim dResult As Double
Dim lNumDataBytes As Long


On Error Resume Next

LSet lMsg = msg


lMsg.StatusBitField = icsSpyStatusNetworkMessageType


'// Determine the number of message bytes
For lCount = 3 To 20
    If Trim$(mByteString(lCount)) = "" Then
        Exit For
    End If
Next lCount

'// these are the number of data bytes
lMsg.NumberBytesData = lCount - 3


'// Setup the arbitration ID
If InStr(1, mByteString(1), "=") = 0 Then
    lMsg.ArbIDOrHeader = Val(mByteString(1))
Else
    '// Evaluate the expression, make sure to remove the "equal sign"
    If ParseExpressionForAnalogItems(Parent, False, _
        Right$(mByteString(1), Len(mByteString(1)) - 1), _
                                                        dResult, mvarValue) Then
        If dResult < 0 Then dResult = 0
        If dResult > 2 ^ 29 Then dResult = 2 ^ 29 - 1
        lMsg.ArbIDOrHeader = CLng(dResult)
    Else
        ReportError "There was an error in the equation the message bytes"
    End If
End If

'// remote frame
If Len(mByteString(2)) >= 1 Then
    If LCase$(Mid$(mByteString(2), 1, 1)) = "y" Then
        lMsg.StatusBitField = lMsg.StatusBitField + icsSpyStatusRemoteFrame
    End If
End If

LSet amsg = lMsg

'// Setup the data bytes
For lCount = 1 To amsg.NumberBytesData
    If Mid$(mByteString(lCount + 2), 1, 1) <> "=" Then
        amsg.data(lCount) = Val("&H" & mByteString(lCount + 2))
    Else
        '// Evaluate the expression, make sure to remove the "equal sign"
        If ParseExpressionForAnalogItems(Parent, False, _
            Right$(mByteString(lCount + 2), Len(mByteString(lCount + 2)) - 1), _
                                                            dResult, mvarValue) Then
           If dResult < 0 Then dResult = 0
           If dResult > 255 Then dResult = 255
            amsg.data(lCount) = CByte(dResult)
        Else
            ReportError "There was an error in the equation the message bytes"
        End If
    End If
Next lCount

LSet msg = amsg

If Err.Number <> 0 Then
    ReportError "Problem Setting up outgoing message named:" & Me.Description _
                        & vbCrLf & vbCrLf & "Details : SetupMSG"
    
End If


End Sub


Public Sub StartTransmitCount()
    mvarNextUpdateTime = timeGetTime + CLng(mvarUpdateRate * 1000)
End Sub
Public Function IncrementTransmitCount() As Boolean
   If timeGetTime >= mvarNextUpdateTime Then
        mvarNextUpdateTime = timeGetTime + CLng(mvarUpdateRate * 1000)
        IncrementTransmitCount = True
    End If
End Function

Public Property Get ValueType() As icsVSPYOutgoingType
    ValueType = mvarValueType
End Property
Public Property Let ValueType(ByVal vNewValue As icsVSPYOutgoingType)
    mvarValueType = vNewValue
End Property

Public Property Get ByteString(ByVal lByte As Long) As String
    ByteString = mByteString(lByte)
End Property
Public Property Let ByteString(ByVal lByte As Long, ByVal sNew As String)
    mByteString(lByte) = UCase(sNew)
End Property

Public Property Let Description(ByVal vData As String)
    If mvarDescription <> vData Then
        mvarDescription = vData
        RaiseEvent DescriptionChanged
    End If
End Property
Public Property Get Description() As String
    Description = mvarDescription
End Property


'// This stores this object to a stream
Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage, lVersion As Long) As Boolean
Dim lCount As Long
Dim lSpace As Long
Dim sSpace As String
Dim dSpace As Double

With obSave
    .ReadWriteString mvarDescription
    .ReadWriteLong mvarValueType
    .ReadWriteLong lSpace
    .ReadWriteDouble mvarValue

    .ReadWriteString mvarFormat
    .ReadWriteDouble mvarUpperRange
    .ReadWriteDouble mvarLowerRange
    
    '// add padding //////////////////////////////
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    '////////////////////////////////////////////////

    '.. new padding
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
                        '// DAVE EDIT 12/20/98
    .ReadWriteDouble mvarUpdateRate
                        '// END DAVE EDIT 12/20/98
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    
                        '// DAVE EDIT 12/19/98
    .ReadWriteString mvarAutoRespondValueFile
                        '// END DAVE EDIT 12/19/98
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace

    For lCount = 1 To 20
        .ReadWriteString mByteString(lCount)
    Next lCount
    
End With

End Function

Public Function SetEqualTo(cOb As cOutgoingMessage)

End Function

Private Sub Class_Initialize()
    Dim lCount As Long
    ReDim ByteDataMsb(20)
    ReDim ByteDataLsb(20)
    ReDim Equations(20)
    
    For lCount = 1 To 20
       ByteDataMsb(lCount) = icsVSPYNothing
       ByteDataLsb(lCount) = icsVSPYNothing
    Next lCount
End Sub

Public Property Get ValueTypeString() As String
    
    Select Case mvarValueType
        Case icsVSPYAnalogoutput
            ValueTypeString = "Analog Out"
        Case icsVSPYDigitalOutput
            ValueTypeString = "Digital Out"
    End Select
        
End Property

Public Property Get Value() As Variant
    
    Select Case mvarValueType
        Case icsVSPYAnalogoutput
            Value = mvarValue
        Case Else
            Value = "n/a"
    End Select

End Property

Public Property Let Value(ByVal vNewValue As Variant)
    mvarValue = CDbl(vNewValue)
End Property

Public Property Get UpdateRateString() As String
    
    If mvarUpdateRate = 0 Then
        UpdateRateString = "Manual"
    Else
        UpdateRateString = Format$(mvarUpdateRate, "0.000")
    End If
    
End Property

Public Property Get UpdateRate() As Double
    UpdateRate = mvarUpdateRate
End Property

Public Property Let UpdateRate(ByVal vNewValue As Double)
    mvarUpdateRate = vNewValue
End Property
