Private Sub obApp_UIVoiceCommand(sCommand As String)
    Select Case LCase(sCommand)
        Case "toggle timestamp"
            mnuMonitorRelative_Click
        Case "toggle buffer"
            ShowNextBuffer
        Case "toggle view"
            Select Case CurrentView
                Case icsSpyTextView
                    CurrentView = icsSpyNotesView
                Case icsSpyNotesView
                    CurrentView = icsSpyGraphicalView
                Case Else
                    CurrentView = icsSpyTextView
            End Select
        Case "save monitor buffer"
            obApp.Speak "Saving Monitor Buffer"
            SaveMonitorData True
        Case Else
            Debug.Print "Unhandled command: " & sCommand
    End Select
End Sub

