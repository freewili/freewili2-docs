Friend Sub CreateOrderForm(hwnd As Long, bPrint As Boolean, bShow As Boolean)
    Dim lFileNum As Long
    Dim sDocPath As String
    Dim sGIFPath As String
    Dim bFirstData As Boolean
    Dim bFirstHalfByte() As Byte
    Dim bSecondHalfByte() As Byte
    
    
    '// first do the document
    bFirstHalfByte = LoadResData(HTML_FIRST_HALF_ORDER, "HTML")
    bSecondHalfByte = LoadResData(HTML_SECOND_HALF_ORDER, "HTML")
    
    sDocPath = VB.App.Path & "\LicReq.htm"
    
    lFileNum = FreeFile
    If FileExists(sDocPath) Then Kill sDocPath
    
    Open sDocPath For Binary As lFileNum
    Put #lFileNum, , bFirstHalfByte
    Put #lFileNum, , SiteCode
    Put #lFileNum, , bSecondHalfByte
    Close #lFileNum

    '// now do the logo gif
    bFirstHalfByte = LoadResData(101, "GIF")
    sGIFPath = VB.App.Path & "\icslogo.gif"
    
    lFileNum = FreeFile
    If FileExists(sGIFPath) Then Kill sGIFPath
    
    Open sGIFPath For Binary As lFileNum
    Put #lFileNum, , bFirstHalfByte
    Close #lFileNum

    '// show the path
    If bPrint Then
        Call PrintThisFile(hwnd, sDocPath)
    Else
        If bShow Then
            Call OpenThisDoc(hwnd, sDocPath)
        End If
    End If

End Sub

Public Function LoadVLTFile(ByVal sFile As String) As Boolean
    Dim lFieldCount As Long
    Dim sPriority As String
    Dim sType As String
    Dim obFile As New cParseFileString
    Dim bAllXX As Boolean
    Dim sTemp As String
    Dim obIn As cIncomingMessage
    Dim obOut As cOutgoingMessage
    Dim vFields As Variant
    Dim vDataBytes As Variant
    Dim lCount As Long
    Dim lFileNum As Long
    Dim lDataByteCount As Long
    
    Const ID_FIRSTFILTER  As String = "[FILTER "
    Const ID_MESSAGE As String = "[MESSAGE "
    

    On Error GoTo LoadVLTFileError
    
    
    obFile.FullPath = sFile
    
    lFileNum = FreeFile '// get a file num
    Open sFile For Input As lFileNum        '// open the file
    
    
    If LCase$(obFile.FileExtension) = ".msg" Then
        
        For lCount = 0 To 15
            
            
            If EOF(lFileNum) Then Exit For '// don't read if  eof
        
            Do
                Line Input #lFileNum, sTemp
            
            Loop Until EOF(lFileNum) Or UCase$(Left$(sTemp, Len(ID_MESSAGE & lCount))) = (ID_MESSAGE & lCount)
            
            
            
            '// the first field is the name of the message
            If Not EOF(lFileNum) Then
                Line Input #lFileNum, sTemp             '// read the next line from the file
                vFields = Split(sTemp, "=")             '// split the string into fields
                Set obOut = OutgoingMessages.Add '// add an outgoing message
                obOut.Description = vFields(1)
            Else
                Exit For
            End If
        
            '// get priority/type
            If Not EOF(lFileNum) Then
                Line Input #lFileNum, sTemp             '// read the next line from the file
                vFields = Split(sTemp, "=")             '// split the string into fields
                sPriority = Right$(vFields(1), 1)
                If Not EOF(lFileNum) Then
                    Line Input #lFileNum, sTemp             '// read the next line from the file
                    vFields = Split(sTemp, "=")             '// split the string into fields
                    sType = Right$(vFields(1), 1)
                End If
                obOut.ByteString(1) = sPriority & sType
            End If
            
            '// get target
            If Not EOF(lFileNum) Then
                Line Input #lFileNum, sTemp             '// read the next line from the file
                vFields = Split(sTemp, "=")             '// split the string into fields
                obOut.ByteString(2) = vFields(1)
            End If
            
            '// get source
            If Not EOF(lFileNum) Then
                Line Input #lFileNum, sTemp             '// read the next line from the file
                vFields = Split(sTemp, "=")             '// split the string into fields
                obOut.ByteString(3) = vFields(1)
            End If
            
            '// get data bytes
            If Not EOF(lFileNum) Then
                Line Input #lFileNum, sTemp             '// read the next line from the file
                vFields = Split(sTemp, "=")             '// split the string into fields
                vDataBytes = Split(vFields(1), " ")
                For lDataByteCount = 0 To UBound(vDataBytes)
                    obOut.ByteString(4 + lDataByteCount) = vDataBytes(lDataByteCount)
                Next lDataByteCount
            End If
                

        Next lCount
            
        
    Else
        '// its a filter table
        For lCount = 0 To 15
        
            '// find the first line in the data file
            Do
                Line Input #lFileNum, sTemp
                
            Loop Until EOF(lFileNum) Or UCase$(Left$(sTemp, Len(ID_FIRSTFILTER & lCount))) = (ID_FIRSTFILTER & lCount)
            
        
            Set obIn = IncomingMessages.Add
            obIn.Description = obFile.FileName & " msg " & lCount
            
            bAllXX = True
            
            '// priority
            If Not EOF(lFileNum) Then
                Line Input #lFileNum, sTemp             '// read the next line from the file
                vFields = Split(sTemp, "=")             '// split the string into fields
                sPriority = vFields(1)
                '// type
                If Not EOF(lFileNum) Then
                    Line Input #lFileNum, sTemp             '// read the next line from the file
                    vFields = Split(sTemp, "=")             '// split the string into fields
                    sType = vFields(1)
                    
                    
                    '// build the priority type byte
                    If sPriority = "100" Then
                        sPriority = "X"
                    Else
                        sPriority = Right$(sPriority, 1)
                        bAllXX = False
                    End If
                    If sType = "100" Then
                        sType = "X"
                    Else
                        sType = Right$(sType, 1)
                        bAllXX = False
                    End If
                    obIn.DataByteString(1) = sPriority & sType
                End If
            End If
            
            '// read the next eight bytes from the file
            For lFieldCount = 2 To 5
                
                If Not EOF(lFileNum) Then
                    
                    Line Input #lFileNum, sTemp             '// read the next line from the file
                    vFields = Split(sTemp, "=")             '// split the string into fields
                    
                    If vFields(1) = "100" Then
                        obIn.DataByteString(lFieldCount) = "XX"
                    Else
                        obIn.DataByteString(lFieldCount) = vFields(1)
                        bAllXX = False
                    End If
                
                End If
                    
            Next lFieldCount
                    
            '// set the value source to bus if you need to
            If Not bAllXX Then
                 obIn.ValueSource = icsVSPYSourceBus
            End If
            
        Next lCount
    
    End If
    
    Close lFileNum '// close the file

    '// return success
    LoadVLTFile = True
    

    Exit Function

LoadVLTFileError:

    Debug.Print "Error loading VLT file cicsspy::LoadVLTFile"
    LoadVLTFile = False
    
    
    
End Function

