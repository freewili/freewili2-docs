Attribute VB_Name = "frmSetupTest"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public obApp As cicsSpy
Public Test As cTest                '// The current test being edited
Public NumTestEdit As Long
Private bTabSet As Boolean

Private Expressions(2) As String
Private IndexEdited As Long


Private Analyses As New cSpyAnalyses
Private CurrentFilter As New cFilters
Private CurrentFilter2 As New cFilters


Private Sub chkStoreRawData_Click()
    If chkStoreRawData = vbChecked Then
        chkAppendCounter.Enabled = True
        chkApendTimeDate.Enabled = True
        chkUseSaveExpression.Enabled = True
        lstMessagesFileAppend.Enabled = True
        lblFilePath.Enabled = True
        LogTime.Enabled = True
        lblMessagesFileAppend.Enabled = True
        LogTime.Enabled = True
        bfFilePath.Enabled = True
        chkDecimalFormat.Enabled = True
        
    Else
        chkAppendCounter.Enabled = False
        chkApendTimeDate.Enabled = False
        chkUseSaveExpression.Enabled = False
        lstMessagesFileAppend.Enabled = False
        lblFilePath.Enabled = False
        LogTime.Enabled = False
        lblMessagesFileAppend.Enabled = False
        bfFilePath.Enabled = False
        chkDecimalFormat.Enabled = False
    End If
End Sub

Private Sub cmdAdd_Click()
Dim analysis As cSpyAnalysis

Dim iCount As Integer
Dim iNumItems As Integer

'// First verify that the user has gave this analysis a description
If Trim$(txtAnalysisDescription) = "" Then
    MsgBox "Please give this analysis a description a description before adding.", vbInformation
    txtAnalysisDescription.SetFocus
    Exit Sub
End If

Set analysis = Analyses.Add

With analysis
    .Description = txtAnalysisDescription
    .AnalysisType = lstAnalysis.ListIndex
    If lstAnalogInputs.ListIndex >= 0 Then
        .ResultLocationKey = obApp.IncomingMessages(lstAnalogInputs.ListIndex + 1).Key
    End If
    .FailedResult = Val(txtAnalysisFailed)
    Call .Filters.SetEqualTo(CurrentFilter)
    Call .Filters2.SetEqualTo(CurrentFilter2)
End With

lstAnalyses.AddItem txtAnalysisDescription

End Sub

Private Sub cmdAddMessage_Click()
    ctlUserExpression1.InsertText ("{" & lstMessages.List(lstMessages.ListIndex) & "}")
End Sub

Private Sub cmdAddMessageStarted_Click()
    InsertText txtTestStartSound, ("{" & lstMessagesSounds.List(lstMessagesSounds.ListIndex) & "}")
End Sub

Private Sub cmdAddMessageTestComplete_Click()
    InsertText txtTestCompleteSound, ("{" & lstMessagesSounds.List(lstMessagesSounds.ListIndex) & "}")
End Sub

Private Sub cmdAddMessageTriggered_Click()
    InsertText txtTestTriggeredSound, ("{" & lstMessagesSounds.List(lstMessagesSounds.ListIndex) & "}")
End Sub

Private Sub CmdCancel_Click()
    Unload Me
End Sub

Private Sub cmdEditAnalysisFilter_Click()
    MousePointer = vbHourglass
    With frmEditFilter
        Set .obApp = obApp '// Show the filter dialog
        Set .FiltersToEdit = CurrentFilter
        .SetupUI
        .Show vbModal, Me
    End With
    MousePointer = vbDefault
End Sub

Private Sub cmdEditAnalysisFilter2_Click()
    MousePointer = vbHourglass
    With frmEditFilter
        Set .obApp = obApp '// Show the filter dialog
        Set .FiltersToEdit = CurrentFilter2
        .SetupUI
        .Show vbModal, Me
    End With
    MousePointer = vbDefault
End Sub

Private Sub cmdFilter_Click()
    MousePointer = vbHourglass
    With frmEditFilter
        Set .obApp = obApp '// Show the filter dialog
        Set .FiltersToEdit = Test.Filters
        Select Case lstTestType.ListIndex
            Case 1, 3, 7
                .DonotShowExcluded = True
                .Caption = "Select the values"
            Case Else
                .DonotShowExcluded = False
                .Caption = "Select the input messages for the filter"
        End Select
        .SetupUI
        .Show vbModal, Me
    End With
    MousePointer = vbDefault
End Sub

Private Sub CmdOk_Click()
    Dim dTemp As Double
    Dim lCount As Long
    Dim lSelectedCount As Long
    
    dTemp = Val(txtAfterStopMessages)
    If dTemp < 1 Or dTemp > 2 ^ 20 Then
        MsgBox "The number of messages for after stop messages is out of range (1 to " & 2 ^ 20 & "). Please fix.", vbInformation, "Problem with range of input"
        Exit Sub
    End If
    
    dTemp = Val(txtBufferLength)
    If dTemp < 1 Or dTemp > 2 ^ 30 Then
        MsgBox "The number of messages for the circular buffer messages is out of range (1 to " & 2 ^ 30 & "). Please fix.", vbInformation, "Problem with range of input"
        Exit Sub
    End If
    
    dTemp = Val(txtTestMessages)
    If dTemp < 1 Or dTemp > 2 ^ 20 Then
        MsgBox "The number of messages for the test messages is out of range (1 to " & 2 ^ 20 & "). Please fix.", vbInformation, "Problem with range of input"
        Exit Sub
    End If
    
    dTemp = Val(txtNumberGenerations)
    If dTemp < 1 Or dTemp > 2 ^ 20 Then
        If lstTestType.ListIndex = 3 Then   'transmit raw messages from file
            MsgBox "The number of regenerations is out of range (1 to " & 2 ^ 20 & ").  Please fix.", vbInformation, "Problem with range of input"
            Exit Sub
        Else
            txtNumberGenerations = "1"
        End If
    End If
    
    dTemp = Val(txtTxInterMsgDelay)
    

    
    '// transfer current expression to expression array
    Expressions(IndexEdited) = ctlUserExpression1.Expression
    
    With Test
        If Val(txtTxInterMsgDelay) > 214748 Then
             .TxMessageTestIntermessageDelaySec = 0
        Else
            .TxMessageTestIntermessageDelaySec = Val(txtTxInterMsgDelay)
        End If
        .StopTestAction = lstStopAction.ListIndex
        .StopTestActionTestIndex = lstStopActionTest.ListIndex + 1
        If lstValueTXMessages.ListIndex >= 0 Then
            .ValueReplayOutKey = obApp.OutgoingMessages(lstValueTXMessages.ListIndex + 1).Key
        End If
        
        If Val(txtOffsetDelay) > 214748 Then
            .TxMessageTestOffsetDelaySec = 0
        Else
            .TxMessageTestOffsetDelaySec = Val(txtOffsetDelay)
        End If
        .TxMessageTestWhenTransmit = lstTxCondition.ListIndex
        
        .ActiveXServerClassID = txtActiveXID
        .TestType = lstTestType.ListIndex
        .StoreRawData = chkStoreRawData And vbChecked
        .filepath = bfFilePath.FileName
        .AppendValueToFileName = chkAppendCounter And vbChecked
        .AppendDateTimeToFileName = chkApendTimeDate And vbChecked
        .UseSaveExpression = chkUseSaveExpression And vbChecked
        .ResetAllValues = optReset(0)
        .Description = txtDescription
        .StartMode = lstStartMode.ListIndex
        .AutoRestart = chkAutoRestart = vbChecked
        .StartExpression = Expressions(0)
        .TriggerEquation = Expressions(1)
        .SaveExpression = Expressions(2)
        .LogRate = LogTime
        If optStopOrTrigger(0) Then .AfterStopCollect = False
        If optStopOrTrigger(1) Then .AfterStopCollect = True
        .ReplayFilePath = bfReplayDataFile.FileName
        .NumberOfGenerations = txtNumberGenerations
        If optGenerations(0) Then .ContinuousGeneration = True
        If optGenerations(1) Then .ContinuousGeneration = False
        If optAfterStop(0) Then .AfterStopDataType = icsSpyAfterMessages
        If optAfterStop(1) Then .AfterStopDataType = icsSpyAfterValues
        
        If optActuateTriggerType(0) Then .DigitalActuateTriggerType = icsVSPYTestActutateTriggerSoftware
        If optActuateTriggerType(1) Then .DigitalActuateTriggerType = icsVSPYTestActutateTriggerHardware
        .DigitalActuatePinID = lstParallelPort.ListIndex
        
        .AfterStopMessages = CLng(Val(txtAfterStopMessages))
        .AfterStopTime = tmAfterStop.Value
        .CircularBufferLength = Val(txtBufferLength)
        .StopOnExpressionEnabled = lstStopCondtions.Selected(0)
        .StopTimeEnabled = lstStopCondtions.Selected(1)
        .StopNumberOfMessagesEnabled = lstStopCondtions.Selected(2)
        .StopNumberOfMessages = Val(txtTestMessages)
        .StopAfterTime = tmTest.Value
        .SaveDecimalFormatting = chkDecimalFormat = vbChecked
    
        .SoundCompleteExpression = txtTestCompleteSound
        .SoundStartedExpression = txtTestStartSound
        .SoundTriggeredExpression = txtTestTriggeredSound
    
        '// setup the file append message
        If lstMessagesFileAppend.ListIndex >= 0 Then
            If lstMessagesFileAppend.ListIndex > (obApp.IncomingMessages.Count - 1) Then
                 .AppendFileValueTypeInput = False
                 .ValueToAppendKey = obApp.OutgoingMessages(lstMessagesFileAppend.ListIndex - obApp.IncomingMessages.Count + 1).Key
            Else
                .AppendFileValueTypeInput = True
                .ValueToAppendKey = obApp.IncomingMessages(lstMessagesFileAppend.ListIndex + 1).Key
            End If
        End If
    
        If .TestType = icsTestTransmitMessages Then
            '// setup the filters object with the message object
            If lstTXMessages.SelCount > 0 Then
                Call .Filters.SetNumIncludedFilters(lstTXMessages.SelCount) '// set the number of included filters
                For lCount = 0 To lstTXMessages.ListCount - 1   '// though the entire list
                    If lstTXMessages.Selected(lCount) Then
                        lSelectedCount = lSelectedCount + 1 '// count the selected items
                        .Filters.IncludedFiltersKey(lSelectedCount) = obApp.OutgoingMessages(lCount + 1).Key
                    End If
                Next lCount
            End If
        End If
    
    
    End With
    
    Call Test.Analyses.SetEqualTo(Analyses) '// Save the analyses
    
    filterUI1.SaveUI
    
    obApp.App.SaveNeeded = True
    
    Unload Me
End Sub

Private Sub cmdRemove_Click()
    With lstAnalyses
        If .ListIndex >= 0 Then
            Call Analyses.Remove(.ListIndex + 1)
            .RemoveItem .ListIndex
        End If
    End With
End Sub


'// called to tranfer data from the test object to the dialog
Public Sub SetupUI()

    Dim lCount As Long
    Dim lNumItems As Long
    Dim lNew As Long
    Dim lIndexTx As Long
    
    
    On Error Resume Next '// trap the errors that may occur
    

    Set Test = obApp.Tests(NumTestEdit)
    Set Test.Parent = obApp
    
    Call FillListBoxes
    
    With Test
        If .AutoRestart Then chkAutoRestart = vbChecked Else chkAutoRestart = vbUnchecked
        txtActiveXID = .ActiveXServerClassID
        lIndexTx = obApp.OutgoingMessages.ReturnIndexFromKey(.ValueReplayOutKey)
        If lIndexTx > 0 And lIndexTx <= lstValueTXMessages.ListCount Then
            lstValueTXMessages.ListIndex = lIndexTx - 1
        End If
        lstStopAction.ListIndex = .StopTestAction
        If .StopTestActionTestIndex > 0 And .StopTestActionTestIndex <= lstStopActionTest.ListCount Then
            lstStopActionTest.ListIndex = .StopTestActionTestIndex - 1
        End If
        txtTxInterMsgDelay = Format$(.TxMessageTestIntermessageDelaySec)
        txtOffsetDelay = Format$(.TxMessageTestOffsetDelaySec)
        lstTxCondition.ListIndex = (.TxMessageTestWhenTransmit)
        
        bfReplayDataFile.FileName = .ReplayFilePath
        txtNumberGenerations = .NumberOfGenerations
        If .ContinuousGeneration Then optGenerations(0) = True Else optGenerations(1) = True
        txtDescription = .Description           '// test decription
        lstExpressionType.ListIndex = 0         '// setup the expresion list box
        Expressions(0) = .StartExpression       '// setup the private array of expressions
        Expressions(1) = .TriggerEquation
        Expressions(2) = .SaveExpression
        ctlUserExpression1.Expression = Expressions(0)  '// assign the current expression to the User Control
        tmAfterStop.Value = .AfterStopTime              '// setup the afterstop time
        If .AfterStopCollect Then optStopOrTrigger(1) = True Else optStopOrTrigger(0) = True
        Call optStopOrTrigger_Click(0)
        If .AfterStopDataType = icsSpyAfterMessages Then optAfterStop(0) = True Else optAfterStop(1) = True
        lstStopCondtions.Selected(0) = .StopOnExpressionEnabled
        lstStopCondtions.Selected(1) = .StopTimeEnabled
        lstStopCondtions.Selected(2) = .StopNumberOfMessagesEnabled
        
        If .DigitalActuateTriggerType = icsVSPYTestActutateTriggerSoftware Then optActuateTriggerType(0) = True Else optActuateTriggerType(1) = True
        Call optActuateTriggerType_Click(0)
        lstParallelPort.ListIndex = .DigitalActuatePinID
        
        Call lstStopCondtions_ItemCheck(0)  '// call event to update dependant UI items
        txtTestMessages = Format$(.StopNumberOfMessages)
        txtAfterStopMessages = Format$(.AfterStopMessages)
        txtBufferLength = Format$(.CircularBufferLength)
        tmTest.Value = .StopAfterTime
        lstStartMode.ListIndex = .StartMode '// Load properties
        lstTestType.ListIndex = .TestType
        bfFilePath.FileName = .filepath
        If .StoreRawData Then chkStoreRawData = vbChecked Else chkStoreRawData = vbUnchecked
        chkStoreRawData_Click   '// update the raw data items
        If .UseSaveExpression Then chkUseSaveExpression = vbChecked Else chkUseSaveExpression = vbUnchecked
        If .AppendDateTimeToFileName Then chkApendTimeDate = vbChecked Else chkApendTimeDate = vbUnchecked
        If .AppendValueToFileName Then chkAppendCounter = vbChecked Else chkAppendCounter = vbUnchecked
        LogTime = .LogRate
        If .SaveDecimalFormatting Then chkDecimalFormat = vbChecked Else chkDecimalFormat = vbUnchecked
        If .ResetAllValues Then optReset(0) = True Else optReset(1) = True
        Call Analyses.SetEqualTo(.Analyses) '// Add the analysis
    
        txtTestCompleteSound = .SoundCompleteExpression
        txtTestStartSound = .SoundStartedExpression
        txtTestTriggeredSound = .SoundTriggeredExpression
        
        lNumItems = Analyses.Count  '// add the analyses to a list box
        For lCount = 1 To lNumItems
            lstAnalyses.AddItem Analyses(lCount).Description
        Next lCount
        
        filterUI1.DonotShowExcluded = True '// Setup the reset filters
        Set filterUI1.obApp = obApp
        Set filterUI1.Filters = .ResetFilters
        filterUI1.SetupUI
        
        '// setup the message to append
        If Len(.ValueToAppendKey) <> 0 Then
            If .AppendFileValueTypeInput Then
                If obApp.IncomingMessages.KeyExists(.ValueToAppendKey) Then
                    lstMessagesFileAppend.ListIndex = obApp.IncomingMessages.ReturnIndexFromKey(.ValueToAppendKey) - 1
                End If
            Else
                If obApp.OutgoingMessages.KeyExists(.ValueToAppendKey) Then
                    lstMessagesFileAppend.ListIndex = obApp.OutgoingMessages.ReturnIndexFromKey(.ValueToAppendKey) + obApp.IncomingMessages.Count - 1
                End If
            End If
        Else
            If lstMessagesFileAppend.ListCount > 0 Then
                lstMessagesFileAppend.ListIndex = 0
            Else
                lstMessagesFileAppend.Enabled = False
            End If
        End If
    
        
        If .TestType = icsTestTransmitMessages Then
            
            '// number of selected items
            lNumItems = .Filters.IncludedFiltersCount
            
            For lCount = 1 To lNumItems
                lNew = obApp.OutgoingMessages.ReturnIndexFromKey(.Filters.IncludedFiltersKey(lCount))
                '// make sure that this message is still there
                If lNew > 0 And lNew <= lstTXMessages.ListCount Then
                    lstTXMessages.Selected(lNew - 1) = True
                End If
            Next lCount
            
        End If
        
        
    End With 'test
    
    
    
    If Err.Number <> 0 Then
        MsgBox "There was a problem setting up this test." & _
            vbCrLf & vbCrLf & "Description: " & Err.Description & _
            vbCrLf & "Error Number: " & Err.Number, vbInformation
    End If
    
End Sub

'// this sub fills the listboxes with static info and dynamic info from the main object
Private Sub FillListBoxes()
    Dim lCount As Long
    Dim lNumItems As Long
    Dim sDescription As String
    Dim sDescriptionKey As String
    Dim obIn As cIncomingMessage
    Dim obOut As cOutgoingMessage
    Dim sKey As String
    
    
    '// first, clear all the list boxes which hold a incoming or outgoing equation
    lstAnalogInputs.Clear
    lstMessagesFileAppend.Clear
    lstMessages.Clear
    lstMessagesSounds.Clear
    lstTXMessages.Clear
    lstValueTXMessages.Clear
    
    '// Now add them to the list
    lCount = 0
    For Each obIn In obApp.IncomingMessages
        lCount = lCount + 1
        sDescription = obIn.Description
        If Len(sDescription) = 0 Then
            sDescription = "Unnamed In Message " & lCount
        End If
        sDescriptionKey = sDescription & " :" & obIn.Key
        
        '// add items to the lists
        lstAnalogInputs.AddItem sDescription
        lstMessagesFileAppend.AddItem sDescriptionKey
        lstMessages.AddItem sDescriptionKey
        lstMessagesSounds.AddItem sDescriptionKey
    Next obIn
    
    '// setup the list boxes
    If obApp.IncomingMessages.Count > 0 Then
        lstAnalogInputs.ListIndex = 0
        lstMessages.ListIndex = 0
        lstMessagesSounds.ListIndex = 0
    End If
    
    '// Cycle through the outgoing messages
    lCount = 0
    For Each obOut In obApp.OutgoingMessages
        lCount = lCount + 1
        sDescription = obOut.Description
        If Len(sDescription) = 0 Then
            sDescription = "Unnamed Out Message " & lCount
        End If
        sDescriptionKey = sDescription & " :" & obOut.Key
    
        lstMessages.AddItem sDescriptionKey
        lstMessagesFileAppend.AddItem sDescriptionKey
        lstMessagesSounds.AddItem sDescriptionKey
        lstTXMessages.AddItem sDescription
        lstValueTXMessages.AddItem sDescription
    Next obOut
    
    If obApp.OutgoingMessages.Count > 0 Then
        lstMessages.ListIndex = 0
        lstMessagesSounds.ListIndex = 0
    End If
    
    '// add the test types to the list box
    With lstTestType
        .Clear
        .AddItem "Collect raw messages"
        .AddItem "Collect values"
        .AddItem "Transmit raw messages"
        .AddItem "Transmit raw messages from file"
        .AddItem "Transmit message values from file"
        .AddItem "Wait"
        .AddItem "Call ActiveX server component"
        .AddItem "Actuate output on event"
    End With

    '// add the analysis types to the list boxes
    With lstAnalysis
        .Clear
        .AddItem "Count of messages"
        .AddItem "Time Until Messages Received"
        .AddItem "Time Difference between messages"
        .ListIndex = 0
    End With
    
    With lstStopAction
        .Clear
        .AddItem "Do nothing"
        .AddItem "Start a Test"
        .AddItem "Stop a Test"
        .AddItem "Trigger a Test"
        .AddItem "Save a Test's Data"
    End With
        
    lNumItems = obApp.Tests.Count
    lstStopActionTest.Clear
    For lCount = 1 To lNumItems
        sDescription = obApp.Tests(lCount).Description
        If Trim$(sDescription) = "" Then sDescription = "Unnamed Test " & lCount
        lstStopActionTest.AddItem sDescription
    Next lCount
    If lNumItems > 0 Then
        lstStopActionTest.ListIndex = 0
    End If
        

End Sub

Private Sub cmdTestComplete_Click()
    Dim sReturn As String
    If ParseStringExpressionForAnalogItems(obApp, True, txtTestCompleteSound, sReturn) Then
        obApp.Speak sReturn
    End If
End Sub

Private Sub cmdTestStart_Click()
    Dim sReturn As String
    If ParseStringExpressionForAnalogItems(obApp, True, txtTestStartSound, sReturn) Then
        obApp.Speak sReturn
    End If
End Sub

Private Sub cmdTestTrigger_Click()
    Dim Value As Double
    If ParseExpressionForAnalogItems(obApp, True, ctlUserExpression1.Expression, Value, 0#) Then
        MsgBox "The value is " & CBool(Value), vbInformation, "Result of Expression"
    Else
        MsgBox "There was an error in the expression ", vbInformation, "Error in Expression"
    End If
End Sub


Private Sub cmdTestTriggered_Click()
    Dim sReturn As String
    If ParseStringExpressionForAnalogItems(obApp, True, txtTestTriggeredSound, sReturn) Then
        obApp.Speak sReturn
    End If
End Sub





Public Sub InsertText(txt As TextBox, sString As String)
    Dim sExpression As String
    Dim sFront As String
    Dim sBack As String
    With txt
        sExpression = .text
        sFront = Left$(.text, .SelStart)
        sBack = Right$(.text, Len(.text) - .SelStart)
        .text = sFront & sString & sBack
        .SelStart = Len(sFront & sString)
        .SetFocus
    End With
End Sub




