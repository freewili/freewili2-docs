Private Sub mnuEdit_Click()
    
    If obApp.UndoStack.Count = 0 Then
        mnuEditUndo.Caption = "Can't Undo"
        mnuEditUndo.Enabled = False
    Else
        mnuEditUndo.Caption = obApp.UndoStack(obApp.UndoStack.Count).Description
        mnuEditUndo.Enabled = True
    End If
    
    Select Case CurrentView
        Case icsSpyIncomingMessagesView
            mnuEditCopy.Enabled = True
            mnuEditCut.Enabled = True
            If IncomingItemsOnClipBoard Then
                mnuEditPaste.Enabled = True
            Else
                mnuEditPaste.Enabled = False
            End If
        Case icsSpyOutgoingMessagesView
            mnuEditCopy.Enabled = True
            mnuEditCut.Enabled = True
            If OutgoingItemsOnClipBoard Then
                mnuEditPaste.Enabled = True
            Else
                mnuEditPaste.Enabled = False
            End If
            
        Case Else
            mnuEditCopy.Enabled = False
            mnuEditCut.Enabled = False
            mnuEditPaste.Enabled = False
    End Select
End Sub



