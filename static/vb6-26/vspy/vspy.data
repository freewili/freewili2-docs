Private Sub mnuEditUndo_Click()
    Dim obTest As cTest
    Dim obIn As cIncomingMessage
    Dim obOut As cOutgoingMessage
    Dim lNewRowPosition As Long
    
    '// remove the undo operation from the stack
    With obApp.UndoStack

        With .Item(.Count)
            '// perform the undo operation
            Select Case .OperationType
                Case cicsUndoDeleteTest
                    
                    Set obTest = obApp.Tests.Add
                    
                    obTest.ItemByteArray = .bData
                    Call InitializeTheTestsGrid
                    
                    
                Case cicsUndoDeleteIncomingMessages
                    
                    Set obIn = obApp.IncomingMessages.PrivateAdd(.KeyData)
                    
                    obIn.ItemByteArray = .bData
                    lNewRowPosition = grdIncomingMessages.Row                       '// get current position
                    If lNewRowPosition = 0 Then lNewRowPosition = 1                 '// verify the range of the position
        
                    Call grdIncomingMessages.AddItem("", lNewRowPosition)           '// add an item to the grid
                    grdIncomingMessages.TextMatrix(lNewRowPosition, 0) = obIn.Key   '// set the key parameter
                    Call UpdateIncomingMessageRow(lNewRowPosition)                  '// update the row
                    
                    InitializeTheValuesGrid
                    
                Case cicsUndoDeleteOutgoingMessages
                    
                    Set obOut = obApp.OutgoingMessages.PrivateAdd(.KeyData)
                    obOut.ItemByteArray = .bData
                    
                    InitializeTheOutgoingMessagesGrid
                    RaiseEvent NumberOfOutputsChanged
                    
            End Select
        End With
        
        '// remove the last item from the stack
        .Remove .Count
    End With
    
End Sub

Private Sub mnuFileReviewBuffer_Click()
    MousePointer = vbHourglass
    On Error GoTo ReviewBufferError
    With cmn
        .DialogTitle = "Select raw message file to replay"
        .InitDir = GetSetting("icsVSpy", "Defaults", "DefaultSavePath", App.Path)
        .Filter = "Data Files (*.csv)|*.csv|VLT Data Files (*.txt)|*.txt"
        .Flags = &H1000& Or &H4&    '// Setup filters to hide read only and force existences of file
        .FileName = ""
        .ShowOpen
        If Not obApp.Monitor.MonitorBuffer.LoadBufferFromFile(.FileName) Then
            MsgBox "There was an problem loading this buffer." & vbCrLf & vbCrLf & "Details: " & obApp.Monitor.MonitorBuffer.LastErrorString, vbInformation, "Problem opening file"
            obApp.Monitor.MonitorBuffer.Reset
        End If
    End With

    '// handle cancel errors
ReviewBufferError:
    MousePointer = vbDefault

End Sub



Private Sub mnuHelpTechSupport_Click()
    
    Dim obOut As Object 'Outlook.Application
    Dim obMail As Object ' Outlook.MailItem
    Dim obRecipient As Object 'Outlook.Recipient
    Dim sMsg As String
    Dim obInfo As New cicsSystemInfo
    Dim lFileNum As Long
    

    '// create the recipient object
    sMsg = "Vehicle Spy Support Requirement" & vbCrLf & vbCrLf
    sMsg = sMsg & "*********PLEASE DO NOT MODIFY ANYTHING BELOW THIS LINE**************" & vbCrLf
    sMsg = sMsg & "[Vehicle Spy Component and Version Information]" & vbCrLf
    sMsg = sMsg & "Vehicle Spy Main: " & vbTab & obApp.VehicleSpyVersionString & vbCrLf
    sMsg = sMsg & vbCrLf & vbCrLf
    sMsg = sMsg & "[Current Hardware Object Information]" & vbCrLf
    sMsg = sMsg & "Hardware Description: " & vbTab & obApp.HardwareDescription & vbCrLf
    sMsg = sMsg & "Hardware ID: " & vbTab & obApp.HardwareID & vbCrLf
    sMsg = sMsg & "Hardware Baud Rate: " & vbTab & obApp.HardwareBaudRate & vbCrLf
    sMsg = sMsg & "Hardware (Comm) Port: " & vbTab & obApp.HardwareBaudRate & vbCrLf
    sMsg = sMsg & vbCrLf & vbCrLf
    sMsg = sMsg & "[System Information]" & vbCrLf
    sMsg = sMsg & "Operating System Build: " & vbTab & SysInfo1.OSBuild & vbCrLf
    sMsg = sMsg & "Operating System Platform: " & vbTab & SysInfo1.OSPlatform & vbCrLf
    sMsg = sMsg & "Operating System Version: " & vbTab & SysInfo1.OSVersion & vbCrLf
    sMsg = sMsg & "Windows System Directory: " & vbTab & obInfo.SystemDirectory & vbCrLf
    sMsg = sMsg & "Computer Name: " & vbTab & obInfo.ComputerName & vbCrLf
    sMsg = sMsg & "User Name: " & vbTab & obInfo.UserName & vbCrLf
    sMsg = sMsg & "Network Present: " & vbTab & obInfo.IsNetworkPresent & vbCrLf
    sMsg = sMsg & vbCrLf & vbCrLf
    
    sMsg = sMsg & vbCrLf & vbCrLf
    
    
    '//
    If CreateOutlookObject(obOut) Then
        
        Set obMail = obOut.CreateItem(0) 'olMailItem=0
        Set obRecipient = obMail.Recipients.Add("vspysupport@intrepidcs.com")
        
        obRecipient.AddressEntry = "vspysupport@intrepidcs.com"
         
        '// display the mail object
        obMail.Subject = "Vehicle Spy Support"
        obMail.Body = sMsg & vbCrLf
        
        '// attachments
        ' obMail.Attachments.Add "C:\test.txt", olByValue, Len(obMail.Body), "RoboTech Data"
        obMail.Display
    Else
        lFileNum = FreeFile
        Open App.Path & "\tech support.txt" For Output As lFileNum
        Print #lFileNum, sMsg
        Close lFileNum
        Call OpenThisDoc(Me.hwnd, App.Path & "\tech support.txt")
    End If
    
       
End Sub

Private Function CreateOutlookObject(obOutLook) As Boolean
    On Error GoTo CreateOutlookObjectError
    Set obOutLook = CreateObject("Outlook.Application")
    CreateOutlookObject = True
    Exit Function
CreateOutlookObjectError:
    CreateOutlookObject = False
End Function

