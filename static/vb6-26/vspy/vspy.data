Private Function IicsHardware_UpdateSinglePointOutputs(AnalogOutputValues As Variant, _
                DigitalOutputValues As Variant) As Boolean

    Dim lCount As Long
    Dim lItemCount As Long
    
    '// update the analog outputs
    For lCount = 1 To lNumAnalogOutputs         '// transfer the analog inputs
        OutgoingMessages(lAnalogOutputVector(lCount)).Value = AnalogOutputValues(lCount)
    Next lCount
    
    '// update the digital outputs
    For lCount = 1 To m_lRoboTechOutputCount
        If DigitalOutputValues(lCount) Then
            Transmit lCount
            DigitalOutputValues(lCount) = False
        End If
    Next lCount
    
    '// return success
    IicsHardware_UpdateSinglePointOutputs = True

End Function

