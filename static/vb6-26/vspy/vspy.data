VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cBinaryStorage"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Option Explicit

'/////////////////////////////////////////////////////////////////////
'// Copyright 1996 Intrepid Control Systems
'// All rights reserved
'//
'// Written by: Dave Robins
'/////////////////////////////////////////////////////////////////////
'// Description:
'// This object is a wrapper for basic VB binary file operations
'/////////////////////////////////////////////////////////////////////

Private m_bWriteMode As Boolean     '// Holds the direction of the file transfer
Private Declare Sub CopyData Lib "apigid32.dll" Alias "agCopyData" (Source As Any, dest As Any, ByVal nCount&)
'Private Declare Sub CopyData Lib "kernel32" Alias "RtlMoveMemory" _
'        (pDest As Any, pSource As Any, ByVal ByteLen As Long)
        
'// Binary file operations
Private m_iFileNumber As Integer    '// Holds the current file number
Private m_bFileOpen As Boolean      '// Indicates that this file has been opened or not
Private m_sfilepathname As String   '// Holds the name of the current path

'// Byte array operations
Private m_UseByteArray As Boolean   '// Indicates that data is stored in byte array
Private m_CurrentOffset As Long
Private m_CurrentMax As Long
Private m_Byte() As Byte

Public Property Get Bytes() As Variant
    '// Return the byte array
    ReDim Preserve m_Byte(m_CurrentOffset)
    Bytes = m_Byte
End Property

Public Property Let Bytes(vNewBytes As Variant)
    m_Byte = vNewBytes
    m_CurrentMax = UBound(m_Byte)
    m_CurrentOffset = 0
End Property


Public Property Get UseByteArray() As Boolean
    UseByteArray = m_UseByteArray
End Property

Public Property Let UseByteArray(bNewValue As Boolean)
    m_UseByteArray = bNewValue
    If m_UseByteArray Then
        ReDim m_Byte(1000)      '// Start off with 1000 bytes
        m_CurrentMax = 1000
        m_CurrentOffset = 0
    Else
        ReDim m_Byte(0)
        m_CurrentMax = 0
        m_CurrentOffset = 0
    End If
End Property


Public Sub ReadWriteString(sData As String)

Dim lLength As Long
Dim sTemp As String


If m_UseByteArray Then
    
    If m_bWriteMode Then
        lLength = Len(sData)
    End If
    
    ReadWriteLong lLength
    
    If lLength > 0 Then
        '// Copy the data
        If m_bWriteMode Then
            '// Determmine if we need to increase the byte size
            If (lLength + m_CurrentOffset) > m_CurrentMax Then
                m_CurrentMax = m_CurrentMax + 1000
                ReDim Preserve m_Byte(m_CurrentMax)
            End If
            Call CopyData(ByVal sData, m_Byte(m_CurrentOffset), lLength)
        Else
            sData = String(lLength, " ")
            Call CopyData(m_Byte(m_CurrentOffset), ByVal sData, lLength)
        End If
    Else
        sData = ""
    End If
        
    m_CurrentOffset = m_CurrentOffset + lLength
        
Else
    '// Write to file
    If m_bWriteMode Then
        lLength = Len(sData)
        '// First, write the length as a long
        Put #m_iFileNumber, , lLength
    
        '// Now, write the string
        Put #m_iFileNumber, , sData
    Else
        '// First read the length from the file
        Get #m_iFileNumber, , lLength
    
        '// Create a string of the appropiate length
        sTemp = String(lLength, " ")
    
        '// Get the string
        Get #m_iFileNumber, , sTemp

        '// Return the string
        sData = sTemp
    End If
End If


End Sub

Public Sub ReadWriteInteger(iData As Integer)

If m_UseByteArray Then
    Const length = 2
    '// Copy the data
    If m_bWriteMode Then
        '// Determmine if we need to increase the byte size
        If (length + m_CurrentOffset) > m_CurrentMax Then
            m_CurrentMax = m_CurrentMax + 1000
            ReDim Preserve m_Byte(m_CurrentMax)
        End If
        Call CopyData(iData, m_Byte(m_CurrentOffset), length)
    Else
        Call CopyData(m_Byte(m_CurrentOffset), iData, length)
    End If
    
    m_CurrentOffset = m_CurrentOffset + length
    
Else
    
    If m_bWriteMode Then
        '// Store the integer
        Put #m_iFileNumber, , iData
    Else
        '// Read an integer
        Get #m_iFileNumber, , iData
    End If
End If

End Sub

Public Sub ReadWriteBoolean(bData As Boolean)


If m_UseByteArray Then
    Const length = 2
    '// Copy the data
    If m_bWriteMode Then
        '// Determmine if we need to increase the byte size
        If (length + m_CurrentOffset) > m_CurrentMax Then
            m_CurrentMax = m_CurrentMax + 1000
            ReDim Preserve m_Byte(m_CurrentMax)
        End If
        Call CopyData(bData, m_Byte(m_CurrentOffset), length)
    Else
        Call CopyData(m_Byte(m_CurrentOffset), bData, length)
    End If
    
    m_CurrentOffset = m_CurrentOffset + length
    
Else

    
    '// Save it to file
    
    If m_bWriteMode Then
        '// Store the BOOL
        Put #m_iFileNumber, , bData
    Else
        '// Read a BOOL
        Get #m_iFileNumber, , bData
    End If

End If

End Sub

Public Sub ReadWriteDouble(dData As Double)

If m_UseByteArray Then
    Const length = 8
    '// Copy the data
    If m_bWriteMode Then
        '// Determmine if we need to increase the byte size
        If (length + m_CurrentOffset) > m_CurrentMax Then
            m_CurrentMax = m_CurrentMax + 1000
            ReDim Preserve m_Byte(m_CurrentMax)
        End If
        Call CopyData(dData, m_Byte(m_CurrentOffset), length)
    Else
        Call CopyData(m_Byte(m_CurrentOffset), dData, length)
    End If
    
    m_CurrentOffset = m_CurrentOffset + length
    
Else

    If m_bWriteMode Then
        '// Store the Double
        Put #m_iFileNumber, , dData
    Else
        '// Read a double
        Get #m_iFileNumber, , dData
    End If
End If

End Sub

