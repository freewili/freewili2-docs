Private Sub txt_Change()
    RaiseEvent ValueChanging(Val(txt.Text))
End Sub

Private Sub txt_LostFocus()
    RaiseEvent ValueChanged(Val(txt.Text))
End Sub

Private Sub ud_Change()
    Dim dNumberValue As Double

    dNumberValue = Val(txt) 'Remove the units on the text box
    
    ' which direction do we increment
    If ud.Value = 1 Then dNumberValue = dNumberValue - 1
    If ud.Value = -1 Then dNumberValue = dNumberValue + 1
    
    ' setup the new value
    txt = Format$(dNumberValue)
    
    ' reset the scroll bar
    ud.Value = 0
    
End Sub

Private Sub UserControl_Resize()
    Dim lNewWidth As Long
    ud.Move 0, 0, ud.Width, ScaleHeight
    lNewWidth = ScaleWidth - ud.Width
    If lNewWidth > 0 Then
        txt.Move ud.Width, 0, lNewWidth, ScaleHeight
    End If
End Sub
