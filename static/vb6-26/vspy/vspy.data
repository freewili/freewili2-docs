'// This function fills up the ValueScanList structure used for value collections
Private Sub BuildMessageScanList()
    
    Dim lCount As Long
    Dim lNumValues As Long
    Dim sIncomingKey As String
    Dim lNumBusMessages As Long
    Dim lBusMessageCount As Long
    
    '// first determine the number of incoming messages that have a value source set to bus
    lNumValues = Filters.IncludedFiltersCount  '// How many values are we collecting?
    For lCount = 1 To lNumValues
        sIncomingKey = Filters.IncludedFiltersKey(lCount)
        With Parent.IncomingMessages(sIncomingKey)
            If .ValueSource = icsVSPYSourceBus And .RequestIndex > 0 Then
                lNumBusMessages = lNumBusMessages + 1
            End If
        End With
    Next lCount
    
    '// are there any messages that are of bus type?
    If lNumBusMessages > 0 Then
        ReDim ScanValueList(1 To lNumBusMessages)           '// Setup the structure size
        
        '// Transfer these value into the scan list
        For lCount = 1 To lNumValues
            sIncomingKey = Filters.IncludedFiltersKey(lCount)
            '// only add to the scan list those messages which are bus messages
            With Parent.IncomingMessages(sIncomingKey)
            If .ValueSource = icsVSPYSourceBus And .RequestIndex > 0 Then
                lBusMessageCount = lBusMessageCount + 1
                ScanValueList(lBusMessageCount).IncomingMessageKey = sIncomingKey
                ScanValueList(lBusMessageCount).RequestMessageIndex = .RequestIndex
            End If
            End With
        Next lCount
    
        ScanNextValue = 1                       '// start at the first index
        ScanNumberOfValues = lNumBusMessages    '// set the number of values cache
        ScanWaitingForIncomingKey = ScanValueList(1).IncomingMessageKey
    Else
        ScanNextValue = 0                       '// start at the first index
        ScanNumberOfValues = 0                  '// set the number of values cache
        ScanWaitingForIncomingKey = ""
    End If
    
End Sub

'// In a value scan, this sub requests the next value and sets the incoming
'// message to look for. It also sets the pointer to the next value to request
Private Sub TransmitNextRequest()
    
    If ScanNumberOfValues = 0 Then Exit Sub
    
    '// First, transmit the request and set the waiting flag
    Call Parent.Transmit(ScanValueList(ScanNextValue).RequestMessageIndex)
    ScanWaitingForIncomingKey = ScanValueList(ScanNextValue).IncomingMessageKey
    
    '// Now set the ScanNextValue property
    ScanNextValue = ScanNextValue + 1
    If ScanNextValue > ScanNumberOfValues Then ScanNextValue = 1
    ScanTimeOut = timeGetTime + 1000
    
End Sub

