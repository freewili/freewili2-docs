Const MAX_PATH = 260    '' max. length of full pathname */
Const MAX_DRIVE = 3     '' max. length of drive component */
Const MAX_DIR = 256     '' max. length of path component */
Const MAX_FNAME = 256   '' max. length of file name component */
Const MAX_EXT = 256     '' max. length of extension component */





'private const _MAX_PATH   256 ' max. length of full pathname */
'private const _MAX_DIR    32  ' max. length of path component */
'private const _MAX_FNAME  64  ' max. length of file name component */

Public Property Get ComputerName() As String
    
    Dim sName As String
    Dim lNameLength As Long
    Dim lSuccess As Long
    
    sName = String(MAX_COMPUTER_NAME_LENGTH + 1, " ")
    lNameLength = MAX_COMPUTER_NAME_LENGTH
    lSuccess = GetComputerName(sName, lNameLength)
    
    '// return success
    If lSuccess = 0 Then
        Debug.Print "problem getting computer name in cicsSystemInfo::ComputerName"
        ComputerName = "Problem retreiving computer name"
    Else
        ComputerName = Left$(sName, lNameLength - 1)
    End If

    
End Property


Public Property Get UserName() As String
    
    Dim sName As String
    Dim lNameLength As Long
    Dim lSuccess As Long
    
    sName = String(MAX_COMPUTER_NAME_LENGTH + 1, " ")
    lNameLength = MAX_COMPUTER_NAME_LENGTH
    lSuccess = GetUserName(sName, lNameLength)
    
    '// return success
    If lSuccess = 0 Then
        Debug.Print "problem getting user name in cicsSystemInfo::ComputerName"
        UserName = "Problem retreiving user name"
    Else
        UserName = Left$(sName, lNameLength - 1)
    End If

    
End Property

Public Property Get IsNetworkPresent() As Boolean
    Dim lValue As Long
    lValue = GetSystemMetrics(SM_NETWORK)
    IsNetworkPresent = (lValue And 1) > 0  '// if lsb is present then network is present
End Property

Public Property Get NumberOfMouseButtons() As Long
    Dim lValue As Long
    lValue = GetSystemMetrics(SM_CMOUSEBUTTONS)
    NumberOfMouseButtons = lValue  '// if lsb is present then network is present
End Property

Public Property Get SystemDirectory() As String
 
    Dim sName As String
    Dim lNameLength As Long
    Dim lSuccess As Long
    
    sName = String(MAX_COMPUTER_NAME_LENGTH + 1, " ")
    lNameLength = MAX_COMPUTER_NAME_LENGTH
    lSuccess = GetSystemDirectory(sName, lNameLength)
    
    If lSuccess = 0 Then
        Debug.Print "problem getting SystemDirectory in cicsSystemInfo::SystemDirectory"
        SystemDirectory = "Problem retreiving system directory"
    Else
        SystemDirectory = Left$(sName, lSuccess)
    End If
End Property
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cicsspyMIO"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Option Explicit

'// Analog Input management object for Vehicle Spy
Public ClassNameOfServer As String              '// indicates the class name of the server
Public Enabled As Boolean                       '// indicates if analog inputs are enabled or not

Public LastErrorNumber As Long
Public LastErrorString As String


'// used to holde Channel descriptions
Private mChannelNames() As String                   '// This is an array to hold the custom descriptions as given by the user
Private mChannelIndexes() As Long
'Private mChannelValues() As Double
Private mNumberOfConfiguredInputs As Long           '// indicates the number of configured inputs
Private mbServerSetupData() As Byte                 '// byte array holding the server data
Private mHardwareOpen As Boolean


'// property defaults
Private Const defEnabled = True
Private Const defClassNameOfServer = ""
Private Const defNumberOfConfiguredInputs = 0
Private Const defChannelName = "Channel"
Private Const defChannelIndex = 0

'// actual readings array sent to the hardware object
Private mAnalogReadings() As Double      '// holds the values for the configured channel values
Private mDigitalInputs() As Boolean
Private mCounterValues() As Long
Private mMessages() As String

Public ObICSHardware As IicsHardware     '// Hardware object

Public Property Get NumberOfChannels() As Long
    NumberOfChannels = mNumberOfConfiguredInputs
End Property

Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage, lVersion As Long) As Boolean
    'this is it
    Dim vData As Variant
    Dim obPB As New PropertyBag
    Dim vDummy As Variant
    Dim vReturn As Variant
    Dim vBytes As Variant
    Dim lCount As Long
    Dim vServerData As Variant
    
    If bWriteDirection Then
        
        '// first, write the properties into the bag
        With obPB
            .WriteProperty "MIOEnabled", Enabled, defEnabled
            .WriteProperty "ClassNameOfServer", ClassNameOfServer, defClassNameOfServer
            .WriteProperty "NumberOfConfiguredInputs", mNumberOfConfiguredInputs, defNumberOfConfiguredInputs
            
            '// write the channel descriptions and indexes
            For lCount = 1 To mNumberOfConfiguredInputs
                .WriteProperty "ChannelDescription" & lCount, mChannelNames(lCount), defChannelName
                .WriteProperty "ChannelIndex" & lCount, mChannelIndexes(lCount), defChannelIndex
            Next lCount
            
            '// write the servers data if one exists
            If Not (ObICSHardware Is Nothing) Then
                '// get the servers data
                Call ObICSHardware.ReadWriteHardware(bWriteDirection, vBytes)
                mbServerSetupData = vBytes
                Call .WriteProperty("ServerSetupData", mbServerSetupData)
            End If
            
        End With


        '// return the contents of the bag
        vData = obPB.Contents
        
        '// write the array with the binary storage object
        obSave.ReadWriteArray vData
        
    Else
        '// read the array from the binary storage object
        obSave.ReadWriteArray vDummy, vReturn
        
        '// fill the property bag if there is somethign in the return array
        If Not IsEmpty(vReturn) Then
            
            '// fill the property bag with the data
            obPB.Contents = vReturn
            
            '// read the data out of the property bag
            With obPB
                Enabled = .ReadProperty("MIOEnabled", defEnabled)
                ClassNameOfServer = .ReadProperty("ClassNameOfServer", defClassNameOfServer)
                mNumberOfConfiguredInputs = .ReadProperty("NumberOfConfiguredInputs", defNumberOfConfiguredInputs)
                Call SetNumberOfChannels(mNumberOfConfiguredInputs)  '// setup the channel/index arrays
                
                '// read the channel descriptions and indexes
                For lCount = 1 To mNumberOfConfiguredInputs
                     mChannelNames(lCount) = .ReadProperty("ChannelDescription" & lCount, defChannelName)
                     mChannelIndexes(lCount) = .ReadProperty("ChannelIndex" & lCount, defChannelIndex)
                Next lCount
                
                '// create the server if there is one named
                If Trim$(ClassNameOfServer) <> "" Then
                    If CreateServerObject Then
                        vServerData = .ReadProperty("ServerSetupData", Empty)
                        If Not IsEmpty(vServerData) Then
                        mbServerSetupData = vServerData
                        Call ObICSHardware.ReadWriteHardware(bWriteDirection, mbServerSetupData)
                        End If
                    End If
                End If
            End With
        End If
    End If
    

End Function

'// sets the number of channels ////////////////////////////////////////////////
Public Sub SetNumberOfChannels(ByVal lNumber As Long)
    If lNumber > 0 Then
        ReDim Preserve mChannelNames(1 To lNumber)
        ReDim Preserve mChannelIndexes(1 To lNumber)
        'ReDim Preserve mChannelValues(1 To lNumber)
        mNumberOfConfiguredInputs = lNumber
    Else
        Erase mChannelNames
        Erase mChannelIndexes
        'Erase mChannelValues
        mNumberOfConfiguredInputs = 0
    End If
End Sub
'////////////////////////////////////////////////////////////////////////////////////


Public Property Let ChannelDescription(ByVal lIndex As Long, ByVal sDescription As String)
    mChannelNames(lIndex) = sDescription
End Property

Public Property Get ChannelDescription(ByVal lIndex As Long) As String
    ChannelDescription = mChannelNames(lIndex)
End Property

Public Property Let ChannelIndex(ByVal lIndex As Long, ByVal lChannelIndex As Long)
    mChannelIndexes(lIndex) = lChannelIndex
End Property

Public Property Get ChannelIndex(ByVal lIndex As Long) As Long
    ChannelIndex = mChannelIndexes(lIndex)
End Property

'// get only type property //////////////////////////////////
Public Property Get InputValue(ByVal lIndex As Long) As Double
    InputValue = mAnalogReadings(mChannelIndexes(lIndex) + 1)
End Property
'////////////////////////////////////////////////////////////////////////////////////


Public Function OpenHardware() As Boolean
    
    Dim vAnalogInputRangesMin() As Variant
    Dim vAnalogInputRangesMax() As Variant
    Dim vInitialCounts As Variant
    Dim sErrorString As String
    Dim bSuccess As Boolean
    Dim lCount As Long
    Dim lNumberSinglePoint As Long
    Dim lNumberDigitalIn As Long
    
    On Error GoTo OpenHardwareError:
    
    
    '// get the number of analog inputs
    lNumberDigitalIn = ObICSHardware.NumberForIOPointType(iicsTypeDigitalInput)
    If lNumberDigitalIn >= 1 Then
        ReDim mDigitalInputs(1 To lNumberDigitalIn)
    End If
    
    lNumberSinglePoint = ObICSHardware.NumberForIOPointType(iicsTypeAnalogInput)
    If lNumberSinglePoint >= 1 Then
        ReDim mAnalogReadings(1 To lNumberSinglePoint)
        ReDim vAnalogInputRangesMin(1 To lNumberSinglePoint)
        ReDim vAnalogInputRangesMax(1 To lNumberSinglePoint)
        
        For lCount = 1 To lNumberSinglePoint
            vAnalogInputRangesMin(lCount) = -10
            vAnalogInputRangesMax(lCount) = 10
        Next lCount
        
    End If
    
    
    lNumberSinglePoint = ObICSHardware.NumberForIOPointType(iicsTypeEventCounter)
    If lNumberSinglePoint >= 1 Then
        ReDim mCounterValues(1 To lNumberSinglePoint)
    End If
    lNumberSinglePoint = ObICSHardware.NumberForIOPointType(iicsTypeMessage)
    If lNumberSinglePoint >= 1 Then
        ReDim mMessages(1 To lNumberSinglePoint)
    End If
    
    
    '// Open the hardware
    bSuccess = ObICSHardware.OpenHardware(vAnalogInputRangesMin, _
                        vAnalogInputRangesMax, vInitialCounts, sErrorString)
        
    '// return success or not
    OpenHardware = bSuccess
    mHardwareOpen = bSuccess


    Exit Function

OpenHardwareError:
    
    OpenHardware = False
    Exit Function


End Function


Public Function CloseHardware() As Boolean
    Dim lErrorCode As Long
    
    On Error GoTo CloseHardwareError
    
    If mHardwareOpen Then
        '// close the hardware
        CloseHardware = ObICSHardware.CloseHardware(lErrorCode)
    End If
    
    mHardwareOpen = False

    Exit Function

CloseHardwareError:
    
    CloseHardware = False

End Function

'// read the single point inputs and store the values
Public Function ReadInputs(obApp As cicsSpy) As Boolean
    
    Dim bSuccess As Boolean
    Dim vAnalogInputValues As Variant
    Dim spymsg As icsSpyMessageJ1850
    Dim spyAI As icsSpyMessageAnalog
    Dim lCount As Long
    
    On Error GoTo ReadInputsError
    
    If Not mHardwareOpen Then Exit Function
    
    '// read the single point inputs
    bSuccess = ObICSHardware.ReadSinglePointInputs(mAnalogReadings, _
                        mDigitalInputs, mMessages, mCounterValues)
    
    If bSuccess Then
    
        '// read the first
        For lCount = 1 To mNumberOfConfiguredInputs
            
             '// send the message
             With spyAI
                  .StatusBitField = icsSpyStatusAnalogDigitalInputValue
                  .Value = mAnalogReadings(mChannelIndexes(lCount) + 1)
                  .TimeSystem = timeGetTime
                  .AIDataID = lCount
             End With
        
             LSet spymsg = spyAI
             Call obApp.NewMsgJ1850(spymsg)
       
        Next lCount
       
        ReadInputs = True
    Else
        obApp.AddVehicleSpyError ("Problem reading inputs " & vbCrLf & "Description: " & ObICSHardware.LastErrorString)
        ReadInputs = False
    End If
    
    Exit Function
    
ReadInputsError:

    obApp.AddVehicleSpyError ("Problem reading inputs  " & vbCrLf & "Description: Unhandled Error: " & Err.Description)
    ReadInputs = False
    
End Function

'// this function creates the server object
Public Function CreateServerObject() As Boolean
    
    On Error GoTo CreateServerObjectError
    
    
    '// create the object as defined by the class id
     Set ObICSHardware = CreateObject(ClassNameOfServer)
     
     '// return success
     CreateServerObject = True
     
     Exit Function
     
CreateServerObjectError:
     
     '// return failure
     CreateServerObject = False
     LastErrorNumber = Err.Number
     LastErrorString = Err.Description
     
End Function

Friend Sub FillListWithAnalogInputPoints(lst As ComboBox)
    Dim lNumberSinglePoint As Long
    Dim lNumberWaveform As Long
    Dim sDescription As String, sPlus As String, sMinus As String
    Dim lCount As Long
    
    lst.Clear   '// clear the list
    
    '// get the number of analog inputs
    lNumberSinglePoint = ObICSHardware.NumberForIOPointType(iicsTypeAnalogInput)

    For lCount = 1 To lNumberSinglePoint
        Call ObICSHardware.GetNameForIOPoint(iicsTypeAnalogInput, lCount, sDescription, sPlus, sMinus)
        lst.AddItem sDescription    '// add an item to the list
    Next lCount
    
    '// set the item in the list
    If lNumberSinglePoint > 0 Then
        lst.ListIndex = 0
        lst.Enabled = True
    Else
        lst.Enabled = False
    End If


End Sub


Public Sub ShowHardwareEditDialog()
    If Not (ObICSHardware Is Nothing) Then
        
        ObICSHardware.ShowConfigurationDialog     '// show the configuration dialog
        '// redim the channel names and the descriptions
        
    Else
        MsgBox "You must create a hardware object first before configuring it.", vbInformation, "Test Information"
    End If
End Sub


Public Property Get HardwareDescription() As String
    '// return the description from the hardware object
    HardwareDescription = ObICSHardware.HardwareDescription
End Property
