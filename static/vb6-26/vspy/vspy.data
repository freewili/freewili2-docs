Private Sub UpdateMessageMonitorDisplay()

    Dim bRedrawOff As Boolean   '// flag for handling the redraw property
    Dim inMsg As cIncomingMessage
    Dim lCount As Long
    
    For Each inMsg In obApp.IncomingMessages
        lCount = lCount + 1
        If inMsg.UpdateScreen Then
            If Not bRedrawOff Then '// only turn redraw off once
                bRedrawOff = True
                gValues.Redraw = False
            End If
            UpdateValuesRow lCount
            inMsg.UpdateScreenClear
        End If
    Next inMsg
    
    '// turn redraw back on if necessary (forces a repaint)
    If bRedrawOff Then gValues.Redraw = True


End Sub


Private Sub UpdateMessageMonitorDisplayVisible()

    Dim bRedrawOff As Boolean   '// flag for handling the redraw property
    Dim inMsg As cIncomingMessage
    Dim lCount As Long
    
    For Each inMsg In obApp.IncomingMessages
        lCount = lCount + 1
        If inMsg.UpdateScreen Then
            If Not bRedrawOff Then '// only turn redraw off once
                bRedrawOff = True
                gValues.Redraw = False
            End If
            UpdateValuesRow lCount
            inMsg.UpdateScreenClear
        End If
    Next inMsg
    
    '// turn redraw back on if necessary (forces a repaint)
    If bRedrawOff Then gValues.Redraw = True


End Sub


'// This function updates the test display only when necessary
Private Sub UpdateTestDisplay()
    
    Dim bRedrawOff As Boolean       '// flag indicating redraw is off
    Dim sTestStatus As String       '// temp var for holding test status
    Dim obTest As cTest             '// test object
    Dim lCount As Long
    
    With gTest
        For Each obTest In obApp.Tests
            lCount = lCount + 1
            '// cache the test status string
            sTestStatus = obTest.TestStatusString
            '// update only if the current one is different
            If sTestStatus <> .TextMatrix(lCount, 1) Then
                '// turn redraw off if it wasn't already
                If Not bRedrawOff Then
                    bRedrawOff = True
                    .Redraw = False
                End If
                '// assign the new status string
                .TextMatrix(lCount, 1) = sTestStatus
            End If
        Next obTest
        '// turn back on redraw if it was turned off
        If bRedrawOff Then .Redraw = True
    End With
    
End Sub

Public Sub NavigateToFilename()
    Dim sUrl As String
    
    If obApp Is Nothing Then Exit Sub
    
    sUrl = obApp.LogBook.LogBookPath
    If Trim$(sUrl) <> "" And Dir$(sUrl) <> "" Then
        '// this file exists, navigate to it
        wbNotes.Navigate sUrl
    Else
        '// this file does not exist, do not navigate to it
        
        obApp.LogBook.CreateLogBook
        wbNotes.Navigate obApp.LogBook.LogBookPath
        
    End If
    
End Sub

Public Sub UpdateTxPanel()
    Dim lCount As Long
    Dim obTxButton As cTransmitButton

    tbsTX.Tabs.Clear
    '// add the tab and attach to the txbutton object
    For Each obTxButton In obApp.Monitor.TxButtons
        Set obTxButton.aTab = tbsTX.Tabs.Add
        obTxButton.aTab.Caption = obTxButton.FullCaption
    Next obTxButton
    
End Sub


Private Sub ShowObjectsOnDialog(cObject As Object, ControlOb As Object)
'// This sub shows the controls on the dialog according to there size and
'// position properties
    
    Dim lNumItems As Long
    Dim lCount As Long
    Dim lNumToLoad As Long
    
    '// For each object in the collection load it into the control array and
    '// make it visible
    lNumItems = cObject.Count
    For lCount = 1 To lNumItems
        lNumToLoad = Val(cObject(lCount).Key)   '// Cache the key
        Load ControlOb(lNumToLoad)              '// Load the control
        With ControlOb(lNumToLoad)
            .Move cObject(lCount).Left, cObject(lCount).Top, _
                    cObject(lCount).Width, cObject(lCount).Height   '// Set position
            .Visible = True                     '// Make it visible
        End With
    Next lCount
    
End Sub


Private Sub SetupUserDialog()

    Dim lNumItems As Long
    Dim lCount As Long
    Dim sKey As String
    
    
    UnloadAllControls
    

    '// Load all the user interface elements on to the display form
    Call ShowObjectsOnDialog(obApp.UserDialog.Graphs, cwg)
    Call ShowObjectsOnDialog(obApp.UserDialog.cDigitalEntries, cmdTX)
    Call ShowObjectsOnDialog(obApp.UserDialog.TestButtons, cwbTest)
    Call ShowObjectsOnDialog(obApp.UserDialog.cDigitalDisplays, cwbLight)
    Call ShowObjectsOnDialog(obApp.UserDialog.OnOffButtons, cwbOnOff)
    Call ShowObjectsOnDialog(obApp.UserDialog.cStaticTexts, lblStatic)
    Call ShowObjectsOnDialog(obApp.UserDialog.cAnalogEntries, cwkKnob)
    Call ShowObjectsOnDialog(obApp.UserDialog.cAnalogDisplays, cwkMeter)
    Call ShowObjectsOnDialog(obApp.UserDialog.NumericEntries, ineNumericEntry)
    

    '////////////////////////////////////////////////////////////////

    UI.mLockControls = obApp.UserDialog.DisplayLocked

    
    '// static text
    lNumItems = obApp.UserDialog.cStaticTexts.Count
    For lCount = 1 To lNumItems
        lblStatic(Val(obApp.UserDialog.cStaticTexts(lCount).Key)) = obApp.UserDialog.cStaticTexts(lCount).Caption
    Next lCount

    '// the graph
    lNumItems = obApp.UserDialog.Graphs.Count
    For lCount = 1 To lNumItems
        Set obApp.UserDialog.Graphs(lCount).ParentUD = obApp.UserDialog
        Call SetupGraph(cwg(Val(obApp.UserDialog.Graphs(lCount).Key)))
    Next lCount

    '// the transmit buttons
    lNumItems = obApp.UserDialog.cDigitalEntries.Count
    For lCount = 1 To lNumItems
        Set obApp.UserDialog.cDigitalEntries(lCount).ParentUD = obApp.UserDialog
        
        cmdTX(Val(sKey)).Caption = _
                obApp.OutgoingMessages(obApp.UserDialog.cDigitalEntries(lCount).DataID).Description
    Next lCount

    '// The test buttons
    lNumItems = obApp.UserDialog.TestButtons.Count
    For lCount = 1 To lNumItems
        Set obApp.UserDialog.TestButtons(lCount).ParentUD = obApp.UserDialog
         '// setup the test button
        SetupTestButton cwbTest(Val(obApp.UserDialog.TestButtons(lCount).Key))
    Next lCount

    '// The LEDs
    lNumItems = obApp.UserDialog.cDigitalDisplays.Count
    For lCount = 1 To lNumItems
        Set obApp.UserDialog.cDigitalDisplays(lCount).ParentUD = obApp.UserDialog
    Next lCount
    
    '/// The on/off buttons
    lNumItems = obApp.UserDialog.OnOffButtons.Count
    For lCount = 1 To lNumItems
        Set obApp.UserDialog.OnOffButtons(lCount).ParentUD = obApp.UserDialog
        sKey = obApp.UserDialog.OnOffButtons(lCount).Key
        cwbOnOff(Val(sKey)).Caption = _
                obApp.IncomingMessages(obApp.UserDialog.OnOffButtons(lCount).DataID).Description
    Next lCount
    
                
    '// the meters
    lNumItems = obApp.UserDialog.cAnalogDisplays.Count
    For lCount = 1 To lNumItems
        Set obApp.UserDialog.cAnalogDisplays(lCount).ParentUD = obApp.UserDialog
        '// setup the knob
        SetupMeter cwkMeter(Val(obApp.UserDialog.cAnalogDisplays(lCount).Key))
    Next lCount
    
    '// the knobs
    lNumItems = obApp.UserDialog.cAnalogEntries.Count
    For lCount = 1 To lNumItems
        Set obApp.UserDialog.cAnalogEntries(lCount).ParentUD = obApp.UserDialog
        SetupKnob cwkKnob(Val(obApp.UserDialog.cAnalogEntries(lCount).Key))
    Next lCount
    
    '// numeric entries
    lNumItems = obApp.UserDialog.NumericEntries.Count
    For lCount = 1 To lNumItems
        Set obApp.UserDialog.NumericEntries(lCount).ParentUD = obApp.UserDialog
    Next lCount
    
    
End Sub

'// this function reads the positions of the controls and their size into their respective properties.
Private Sub SaveDialogSettings()
Dim lNumItems As Long
Dim lCount As Long

Debug.Print "Save dialog settings"

obApp.UserDialog.DisplayLocked = UI.mLockControls

'// Graphs
lNumItems = obApp.UserDialog.Graphs.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.Graphs(lCount).ReadSizeAndPosition(cwg(Val(obApp.UserDialog.Graphs(lCount).Key)))
Next lCount

'// Transmit Buttons
With obApp.UserDialog.cDigitalEntries
    lNumItems = .Count
    For lCount = 1 To lNumItems
        With .Item(lCount)
            Call .ReadSizeAndPosition(cmdTX(Val(.Key)))
        End With
    Next lCount
End With '

'// Test Buttons
With obApp.UserDialog.TestButtons
    lNumItems = .Count
    For lCount = 1 To lNumItems
        With .Item(lCount)
            Call .ReadSizeAndPosition(cwbTest(Val(.Key)))
        End With
    Next lCount
End With '

'// LEDs
With obApp.UserDialog.cDigitalDisplays
    lNumItems = .Count
    For lCount = 1 To lNumItems
        With .Item(lCount)
            Call .ReadSizeAndPosition(cwbLight(Val(.Key)))
        End With
    Next lCount
End With '

'// on/off buttons
With obApp.UserDialog.OnOffButtons
    lNumItems = .Count
    For lCount = 1 To lNumItems
        With .Item(lCount)
            Call .ReadSizeAndPosition(cwbOnOff(Val(.Key)))
        End With
    Next lCount
End With '

'// Meters
With obApp.UserDialog.cAnalogDisplays
    lNumItems = .Count
    For lCount = 1 To lNumItems
        With .Item(lCount)
            Call .ReadSizeAndPosition(cwkMeter(Val(.Key)))
        End With
    Next lCount
End With '

'// Knobs
With obApp.UserDialog.cAnalogEntries
    lNumItems = .Count
    For lCount = 1 To lNumItems
        With .Item(lCount)
            Call .ReadSizeAndPosition(cwkKnob(Val(.Key)))
        End With
    Next lCount
End With '

'// Static Text
lNumItems = obApp.UserDialog.cStaticTexts.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.cStaticTexts(lCount).ReadSizeAndPosition(lblStatic(Val(obApp.UserDialog.cStaticTexts(lCount).Key)))
Next lCount

'// Numeric Entries
lNumItems = obApp.UserDialog.NumericEntries.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.NumericEntries(lCount).ReadSizeAndPosition(ineNumericEntry(Val(obApp.UserDialog.NumericEntries(lCount).Key)))
Next lCount



End Sub

'// the function removes all controls on the user dialog except the default version of the control, which is at the
'// control array index of 0
Private Sub UnloadAllControls()

Dim lblX As Label
Dim obCwg As CWGraph
Dim obCwb As CWButton
Dim obCwk As CWKnob
Dim obCwn As Control


'// the static text items
For Each lblX In lblStatic
    If lblX.Index <> 0 Then
        Unload lblX
    End If
Next lblX

'// the graph items
For Each obCwg In cwg
    If obCwg.Index <> 0 Then
        Unload obCwg
    End If
Next obCwg


'// the transmit buttons
For Each obCwb In cmdTX
    If obCwb.Index <> 0 Then
        Unload obCwb
    End If
Next obCwb


'// the test buttons
For Each obCwb In cwbTest
    If obCwb.Index <> 0 Then
        Unload obCwb
    End If
Next obCwb

'// the leds
For Each obCwb In cwbLight
    If obCwb.Index <> 0 Then
        Unload obCwb
    End If
Next obCwb

'// the on/off buttons
For Each obCwb In cwbOnOff
    If obCwb.Index <> 0 Then
        Unload obCwb
    End If
Next obCwb

'// the meters
For Each obCwk In cwkMeter
    If obCwk.Index <> 0 Then
        Unload obCwk
    End If
Next obCwk

'// the knobs
For Each obCwk In cwkKnob
    If obCwk.Index <> 0 Then
        Unload obCwk
    End If
Next obCwk

'// the numeric entry controls
For Each obCwn In ineNumericEntry
    If obCwn.Index <> 0 Then
        Unload obCwn
    End If
Next obCwn

'// remove the reference to the selected control
Set UI.SelectedControl = Nothing

End Sub



Friend Property Get OutgoingItemsOnClipBoard() As Boolean
    OutgoingItemsOnClipBoard = obClipBoardOutgoing.IsThereData
End Property
Friend Property Get IncomingItemsOnClipBoard() As Boolean
    IncomingItemsOnClipBoard = obClipBoardIncoming.IsThereData
End Property

Public Sub IncomingInsertItems(lNumToAdd As Long)
    
    Dim lNewRowPosition As Long
    Dim obIn As cIncomingMessage
    Dim lCount As Long
    
    '// add the incoming message
    For lCount = 1 To lNumToAdd
        
        Set obIn = obApp.IncomingMessages.Add                           '// add an item
        
        lNewRowPosition = grdIncomingMessages.Row                       '// get current position
        If lNewRowPosition = 0 Then lNewRowPosition = 1                 '// verify the range of the position
        
        Call grdIncomingMessages.AddItem("", lNewRowPosition)           '// add an item to the grid
        
        grdIncomingMessages.TextMatrix(lNewRowPosition, 0) = obIn.Key   '// set the key parameter
        
        Call UpdateIncomingMessageRow(lNewRowPosition)                  '// update the row

    Next lCount

    InitializeTheValuesGrid

End Sub
'////////////////////////////////////////////////////////////////////////

Private Sub IncomingCutSteps()
    Call IncomingCopyToClipBoard
    Call IncomingDeleteItems
End Sub

Private Sub OutgoingCutSteps()
    Call OutgoingCopyToClipBoard
    Call OutgoingDeleteItems
End Sub
Private Sub IncomingPasteSteps()

    Dim ob As New cBinaryStorage
    Dim data() As Byte
    Dim lNumSteps As Long
    Dim lCount As Long
    Dim lStopStep As Long
    Dim lNewRowPosition As Long
    Dim obIn As cIncomingMessage
    
    If obClipBoardIncoming.GetDataFromClipBoard(hwnd, data) Then
    
        ob.WriteDirection = False
        ob.UseByteArray = True
        ob.Bytes = data
    
        '// Read the data from the byte array
        ob.ReadWriteLong lNumSteps
    
        
        
        
        '// turn off grid repainting
        grdIncomingMessages.Redraw = False
    
        '// add the incoming message
        For lCount = 1 To lNumSteps
        
            Set obIn = obApp.IncomingMessages.Add                           '// add an item
            Call obIn.ReadWrite(False, ob, 0)                               '// read data from object
            
            lNewRowPosition = grdIncomingMessages.Row                       '// get current position
            If lNewRowPosition = 0 Then lNewRowPosition = 1                 '// verify the range of the position
            
            Call grdIncomingMessages.AddItem("", lNewRowPosition)           '// add an item to the grid
            
            grdIncomingMessages.TextMatrix(lNewRowPosition, 0) = obIn.Key   '// set the key parameter
            
            Call UpdateIncomingMessageRow(lNewRowPosition)                  '// update the row

        Next lCount
        
        grdIncomingMessages.Redraw = True
        
        ob.UseByteArray = False
        
    
    End If
    
    
    InitializeTheValuesGrid
    
End Sub

Private Sub OutgoingPasteSteps()

    Dim ob As New cBinaryStorage
    Dim data() As Byte
    Dim lNumSteps As Long
    Dim lCount As Long
    Dim lStopStep As Long
    Dim lNewRowPosition As Long
    Dim obOut As cOutgoingMessage
    
    If obClipBoardOutgoing.GetDataFromClipBoard(hwnd, data) Then
    
        ob.WriteDirection = False
        ob.UseByteArray = True
        ob.Bytes = data
    
        '// Read the data from the byte array
        ob.ReadWriteLong lNumSteps
    
        
        '// turn off grid repainting
        grdOutgoingMessages.Redraw = False
    
        '// add the incoming message
        For lCount = 1 To lNumSteps
        
            Set obOut = obApp.OutgoingMessages.Add                           '// add an item
            Call obOut.ReadWrite(False, ob, 0)                               '// read data from object
            
            lNewRowPosition = grdOutgoingMessages.Row                       '// get current position
            If lNewRowPosition = 0 Then lNewRowPosition = 1                 '// verify the range of the position
            
            Call grdOutgoingMessages.AddItem("", lNewRowPosition)           '// add an item to the grid
            
            grdOutgoingMessages.TextMatrix(lNewRowPosition, 0) = obOut.Key   '// set the key parameter
            
            Call UpdateOutgoingMessageRow(lNewRowPosition)                  '// update the row

        Next lCount
        
        grdOutgoingMessages.Redraw = True
        
        ob.UseByteArray = False
        
    
    End If
    
End Sub



Private Function IncomingCopyToClipBoard()

    '// Copy steps onto the clipboard
    Dim lMax As Long
    Dim lMin As Long
    Dim lCount As Long
    Dim sClip As String
    Dim data() As Byte
    Dim lNumSteps As Long
    Dim ob As New cBinaryStorage
    Dim obMsg As cIncomingMessage
    Dim lVersion As Long
    
    '// Clear the clip board
    Clipboard.Clear
    
    Dim sKeys() As String
    Dim lMinRow   As Long
    Dim lMaxRow As Long
    Dim lNumItems As Long
    Dim lItemCount As Long
    Dim lRowCount As Long
    

    '// Determine the minimum and the maximum
    DetermineMinAndMax grdIncomingMessages.Row, grdIncomingMessages.RowSel, lMinRow, lMaxRow
    lNumItems = Abs(lMinRow - lMaxRow) + 1        '// Determine the number of steps
    
    ReDim sKeys(1 To lNumItems)
    
    '// for each row
    For lRowCount = lMinRow To lMaxRow
        lItemCount = lItemCount + 1
        sKeys(lItemCount) = grdIncomingMessages.TextMatrix(lRowCount, 0)
    Next lRowCount
        
    '// copy the messages to the clipboard

    '// Determine the number of steps
    lNumSteps = Abs(LBound(sKeys) - UBound(sKeys)) + 1

    ob.WriteDirection = True
    ob.UseByteArray = True

    ob.ReadWriteLong lNumSteps

    '// lMin To lMax
    For lCount = LBound(sKeys) To UBound(sKeys)
        Set obMsg = obApp.IncomingMessages(sKeys(lCount))
        Call obMsg.ReadWrite(True, ob, lVersion)
    Next lCount

    data = ob.Bytes
    ob.UseByteArray = False

    '// Place the data on the clip board
    Call obClipBoardIncoming.PlaceDataOnClipBoard(hwnd, data)
    
    'For lCount = lMin To lMax
    '    sClip = sClip & Steps(CInt(lCount)).StepDescription(lCount) & vbCrLf
    'Next lCount

    '// Set the text on the clipboard
    'Clipboard.SetText sClip, vbCFText

End Function

Private Function OutgoingCopyToClipBoard()

    '// Copy steps onto the clipboard
    Dim lMax As Long
    Dim lMin As Long
    Dim lCount As Long
    Dim sClip As String
    Dim data() As Byte
    Dim lNumSteps As Long
    Dim ob As New cBinaryStorage
    Dim obMsg As cOutgoingMessage
    Dim lVersion As Long
    
    '// Clear the clip board
    Clipboard.Clear
    
    Dim sKeys() As String
