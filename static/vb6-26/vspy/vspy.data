Attribute VB_Name = "frmGraphProperties"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public G As cGraph
Public IncomingMessageDescriptions As Variant
Public OutgoingMessageDescriptions As Variant



Private Sub chkAutoScaleParameter1_Click()
    If chkAutoScaleParameter1 = vbChecked Then
        lblMaxParameter1.Enabled = False
        lblMinParameter1.Enabled = False
        txtMinParameter1.Enabled = False
        txtMaxParameter1.Enabled = False
    Else
        lblMaxParameter1.Enabled = True
        lblMinParameter1.Enabled = True
        txtMinParameter1.Enabled = True
        txtMaxParameter1.Enabled = True
    End If
End Sub

Private Sub chkAutoScaleParameter2_Click()
    If chkAutoScaleParameter2 = vbChecked Then
        lblMaxParameter2.Enabled = False
        lblMinParameter2.Enabled = False
        txtMinParameter2.Enabled = False
        txtMaxParameter2.Enabled = False
    Else
        lblMaxParameter2.Enabled = True
        lblMinParameter2.Enabled = True
        txtMinParameter2.Enabled = True
        txtMaxParameter2.Enabled = True
    End If
End Sub

Private Sub CmdCancel_Click()
    Unload Me
End Sub

Private Sub CmdOk_Click()
    Dim lNewId As Long
    Dim lNumAnalogInputs As Long
    Dim dValue As Double
    
    '// enforce a range around the chart history
    dValue = Val(txtChartHistory)
    If dValue < 5 Or dValue > 1000 Then
        MsgBox "The chart length must be between 5 and 1000.", _
                vbInformation, "Problem with chart length"
        Exit Sub
    End If
    
    '// Record the striprate
    With G
        .Title = txtTitle
        .StripRate = lstStripRate.ItemData(lstStripRate.ListIndex)
        
        '// - handle the first data item -
        If optParameter1Type(0) Then
            .DataIDType = icsUDIncomingMessage
            .DataID = lstAnalogInputs(0).ListIndex
        Else
            .DataIDType = icsUDOutgoingMessage
            .DataID = lstOutgoingMessages(0).ListIndex
        End If
        
        '// - handle the first data item -
        If optParameter2Type(0) Then
            .AnalogItemID2Type = icsUDIncomingMessage
            .AnalogItemID2 = lstAnalogInputs(1).ListIndex
        Else
            .AnalogItemID2Type = icsUDOutgoingMessage
            .AnalogItemID2 = lstOutgoingMessages(1).ListIndex
        End If
        
        .StripLength = CLng(Val(txtChartHistory))
        
        .Parameter1AutoScale = chkAutoScaleParameter1 = vbChecked
        .Parameter1Max = Val(txtMaxParameter1)
        .Parameter1Min = Val(txtMinParameter1)
        
        .Parameter2AutoScale = chkAutoScaleParameter2 = vbChecked
        .Parameter2Max = Val(txtMaxParameter2)
        .Parameter2Min = Val(txtMinParameter2)
        
        
    End With
    
    '// Setup the graph type
    If optType(1) = True Then G.GraphType = 1
    If optType(2) = True Then G.GraphType = 2

    
    Unload Me
    
End Sub

Private Sub Form_Load()
    
    Dim lCount As Long
    Dim lNumItems As Long
    Dim lNumberOfAnalogInputs As Long
    
    'lNumberOfAnalogInputs = G.AnalogInputs.Count
    
    With lstStripRate
        .AddItem "0.25 sec"
        .ItemData(.NewIndex) = 1
        .AddItem "0.50 sec"
        .ItemData(.NewIndex) = 2
        .AddItem "1 sec"
        .ItemData(.NewIndex) = 4
        .AddItem "2 sec"
        .ItemData(.NewIndex) = 8
        .AddItem "5 sec"
        .ItemData(.NewIndex) = 20
        .AddItem "10 sec"
        .ItemData(.NewIndex) = 40
        .AddItem "30 sec"
        .ItemData(.NewIndex) = 120
        .AddItem "1 min"
        .ItemData(.NewIndex) = 180
        .AddItem "5 min"
        .ItemData(.NewIndex) = 900
        .AddItem "30 min"
        .ItemData(.NewIndex) = 5400
        .AddItem "1 hr"
        .ItemData(.NewIndex) = 10800
    End With
    
    '// Setup the striprate
    For lCount = 1 To lstStripRate.ListCount
        If lstStripRate.ItemData(lCount - 1) = G.StripRate Then
            lstStripRate.ListIndex = lCount - 1
        End If
    Next lCount
    
    
    '// set the properties
    With G
        txtTitle = .Title
        txtChartHistory = .StripLength
    End With
    
    
    '// add the default for the analog items
    lstAnalogInputs(0).AddItem "(none)"
    lstAnalogInputs(1).AddItem "(none)"
    
    
    If Not IsEmpty(IncomingMessageDescriptions) Then
        '// Add the analog input items to the form
        lNumItems = UBound(IncomingMessageDescriptions)
    
        For lCount = 1 To lNumItems
            lstAnalogInputs(0).AddItem IncomingMessageDescriptions(lCount)
            lstAnalogInputs(1).AddItem IncomingMessageDescriptions(lCount)
        Next lCount
            
    End If
    
    
    '// Add the analog output items to the form
    lNumItems = UBound(OutgoingMessageDescriptions)
    
    lstOutgoingMessages(0).AddItem "(none)"
    lstOutgoingMessages(1).AddItem "(none)"
    
    For lCount = 1 To lNumItems
        lstOutgoingMessages(0).AddItem OutgoingMessageDescriptions(lCount)
        lstOutgoingMessages(1).AddItem OutgoingMessageDescriptions(lCount)
    Next lCount
    
    '// set for the first analog item
    If G.DataIDType = icsUDIncomingMessage Then
        '// it is an incoming message
        If G.DataID >= 0 And G.DataID < lstAnalogInputs(0).ListCount Then
            lstAnalogInputs(0).ListIndex = G.DataID
        Else
            lstAnalogInputs(0).ListIndex = 0
        End If
        lstOutgoingMessages(0).ListIndex = 0
    Else
        '// its an outgoing message
        If G.DataID >= 0 And G.DataID < lstOutgoingMessages(0).ListCount Then
            lstOutgoingMessages(0).ListIndex = G.DataID
        Else
            lstOutgoingMessages(0).ListIndex = 0
        End If
        lstAnalogInputs(0).ListIndex = 0
    End If
    
    
    '// set for the second analog item
    If G.AnalogItemID2Type = icsUDIncomingMessage Then
        If G.AnalogItemID2 >= 0 And G.AnalogItemID2 < lstAnalogInputs(1).ListCount Then
            lstAnalogInputs(1).ListIndex = G.AnalogItemID2
        Else
            lstAnalogInputs(1).ListIndex = 0
        End If
        lstOutgoingMessages(1).ListIndex = 0
    Else
        If G.AnalogItemID2 >= 0 And G.AnalogItemID2 < lstOutgoingMessages(1).ListCount Then
            lstOutgoingMessages(1).ListIndex = G.AnalogItemID2
        Else
            lstOutgoingMessages(1).ListIndex = 0
        End If
        lstAnalogInputs(1).ListIndex = 0
    End If
    

    '// Setup the graph type
    If G.GraphType = 1 Then optType(1) = True
    If G.GraphType = 2 Then optType(2) = True
    
    
    '// set the autoscale setting
    chkAutoScaleParameter1 = Abs(G.Parameter1AutoScale)
    txtMaxParameter1 = Format$(G.Parameter1Max)
    txtMinParameter1 = Format$(G.Parameter1Min)
    
    '// set the autoscale setting
    chkAutoScaleParameter2 = Abs(G.Parameter2AutoScale)
    txtMaxParameter2 = Format$(G.Parameter2Max)
    txtMinParameter2 = Format$(G.Parameter2Min)
    
    '// set the graph item type (in or out)
    If G.DataIDType = icsUDIncomingMessage Then optParameter1Type(0) = True
    If G.DataIDType = icsUDOutgoingMessage Then optParameter1Type(1) = True
    Call optParameter1Type_Click(0)
    
    '// set the graph item type parameter (in or out)
    If G.AnalogItemID2Type = icsUDIncomingMessage Then optParameter2Type(0) = True
    If G.AnalogItemID2Type = icsUDOutgoingMessage Then optParameter2Type(1) = True
    Call optParameter2Type_Click(0)
    
    
    
    End Sub

Private Sub optParameter1Type_Click(Index As Integer)
    If optParameter1Type(0) = True Then
        lstOutgoingMessages(0).Visible = False
        lstAnalogInputs(0).Visible = True
    Else
        lstOutgoingMessages(0).Visible = True
        lstAnalogInputs(0).Visible = False
    End If
End Sub

Private Sub optParameter2Type_Click(Index As Integer)
    If optParameter2Type(0) = True Then
        lstOutgoingMessages(1).Visible = False
        lstAnalogInputs(1).Visible = True
    Else
        lstOutgoingMessages(1).Visible = True
        lstAnalogInputs(1).Visible = False
    End If
End Sub
