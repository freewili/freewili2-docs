Private Sub lstAnalyses_Click()
    Dim analysis As cSpyAnalysis
    Dim iCount As Integer
    Dim iNumItems As Integer
    
    Set analysis = Analyses.Item(lstAnalyses.ListIndex + 1)
    
    With analysis
        txtAnalysisDescription = .Description
        lstAnalysis.ListIndex = .AnalysisType
        If obApp.IncomingMessages.KeyExists(.ResultLocationKey) Then
            lstAnalogInputs.ListIndex = obApp.IncomingMessages.ReturnIndexFromKey(.ResultLocationKey) - 1
        End If
        txtAnalysisFailed = Val(.FailedResult)
        Call CurrentFilter.SetEqualTo(.Filters)
        Call CurrentFilter2.SetEqualTo(.Filters2)
    End With
End Sub

Private Sub lstAnalysis_Click()
    Select Case lstAnalysis.ListIndex
    
        Case 0: cmdEditAnalysisFilter2.Visible = False
        Case 1: cmdEditAnalysisFilter2.Visible = False
        Case 2: cmdEditAnalysisFilter2.Visible = True
    End Select
End Sub


Private Sub lstExpressionType_Click()
    Expressions(IndexEdited) = ctlUserExpression1.Expression
    IndexEdited = lstExpressionType.ListIndex
    ctlUserExpression1.Expression = Expressions(IndexEdited)
End Sub


Private Sub lstStopCondtions_ItemCheck(Item As Integer)

Dim bBufferVisible As Boolean
Dim bMessagesVisible As Boolean
Dim bTimeVisible As Boolean
Dim bCheckEnabled As Boolean


bBufferVisible = True
bMessagesVisible = False
bTimeVisible = False
bCheckEnabled = False


If lstStopCondtions.Selected(0) Then
    '// stop expression enabled
    bCheckEnabled = True
End If

If lstStopCondtions.Selected(1) Then
    '// stop time
    bTimeVisible = True
    bCheckEnabled = True
End If

If lstStopCondtions.Selected(2) Then
    '// stop number message
   bBufferVisible = False
   bMessagesVisible = True
   bCheckEnabled = True
   
    If optStopOrTrigger(1) Then
        tmAfterStop.Enabled = False
        optAfterStop(0) = True
        optAfterStop(1).Enabled = False
    End If
Else
    If optStopOrTrigger(1) Then
        tmAfterStop.Enabled = True
        optAfterStop(1).Enabled = True
    End If
End If

'// show or hide the buffer based on the item clicks
pctBuffer.Visible = bBufferVisible
pctMessages.Visible = bMessagesVisible
pctTime.Visible = bTimeVisible
'chkCollectAfter.Enabled = bCheckEnabled
If bCheckEnabled = False Then
    'chkCollectAfter = vbUnchecked
End If

'// update the check
'chkCollectAfter_Click

End Sub

Private Sub lstTestType_Click()
  '// Based on the selection show or hide UI items
  pctLogRate.Visible = False
  fmGenerations.Visible = False
  bfReplayDataFile.Visible = False
  lblReplayDataFile.Visible = False
  lblTXMessages.Visible = False
  lblTXMessages = "Tx Messages"
  lstTXMessages.Visible = False
  cmdFilter.Visible = False
  fmActutateOut.Visible = False
  fmActiveXServer.Visible = False
  txtTxInterMsgDelay.Visible = False
  lstValueTXMessages.Visible = False
  lblTxInterMsgDelayCaption.Visible = False
  pctMessagesAnalysis.Visible = False
  lblNoMessageAnalysis.Visible = True
  lblNoTriggerOrBufferSize.Visible = True
  fmTrigAndStop.Visible = False
  fmPostTriggerSetup.Visible = False
  lblNoStorage.Visible = True
  fmStore.Visible = False
  chkStoreRawData.Visible = False
  txtOffsetDelay.Visible = False
  lblOffsetTimeDelay.Visible = False
  lstTxCondition.Visible = False
  lblTXCaption.Visible = False
  
  
  Select Case lstTestType.ListIndex
        Case 0 'collect raw messages
            cmdFilter.Caption = "Filters..."
            pctMessagesAnalysis.Visible = True
            lblNoMessageAnalysis.Visible = False
            cmdFilter.Visible = True
            pctMessagesAnalysis.Visible = True
            lblNoMessageAnalysis.Visible = False
            lblNoTriggerOrBufferSize.Visible = False
            fmTrigAndStop.Visible = True
            fmPostTriggerSetup.Visible = True
            lblNoStorage.Visible = False
            fmStore.Visible = True
            chkStoreRawData.Visible = True
        Case 1 'collect values
            cmdFilter.Caption = "Values..."
            pctLogRate.Visible = True
            cmdFilter.Visible = True
            lblNoStorage.Visible = False
            fmStore.Visible = True
            chkStoreRawData.Visible = True
        Case 2 'transmit raw messages
            lblTXMessages.Visible = True
            lstTXMessages.Visible = True
            txtTxInterMsgDelay.Visible = True
            lblTxInterMsgDelayCaption.Visible = True
            txtOffsetDelay.Visible = True
            lblOffsetTimeDelay.Visible = True
            lstTxCondition.Visible = True
            lblTXCaption.Visible = True
        Case 3 'transmit raw messages from file
            cmdFilter.Visible = True
            cmdFilter.Caption = "Filters..."
            fmGenerations.Visible = True
            bfReplayDataFile.Visible = True
            lblReplayDataFile.Visible = True
        Case 4 'transmit message values from file
            lblTXMessages = "Tx Message"
            lblTXMessages.Visible = True
            lstValueTXMessages.Visible = True
            bfReplayDataFile.Visible = True
            lblReplayDataFile.Visible = True
            fmGenerations.Visible = True
        Case 5 'wait a specific period of time
            cmdFilter.Visible = True
            cmdFilter.Caption = "Filters..."
            fmTrigAndStop.Visible = True
            fmPostTriggerSetup.Visible = True
        Case 6 'call an activex component
            fmActiveXServer.Visible = True
        Case 7 'actuate output on event
            cmdFilter.Visible = True
            cmdFilter.Caption = "Filters..."
            fmActutateOut.Visible = True
    End Select

End Sub

Private Sub optActuateTriggerType_Click(Index As Integer)
    If optActuateTriggerType(0) = True Then
        lblPinUsed.Enabled = True
        lstParallelPort.Enabled = True
        lblSignalGroundDescriptions.Enabled = True
        lblAVTTriggerMessage.Enabled = False
    Else
        lblPinUsed.Enabled = False
        lstParallelPort.Enabled = False
        lblSignalGroundDescriptions.Enabled = False
        lblAVTTriggerMessage.Enabled = True
    End If
End Sub


Private Sub optGenerations_Click(Index As Integer)
    If Index = 0 Then
        txtNumberGenerations.Enabled = False
    Else
        txtNumberGenerations.Enabled = True
    End If
End Sub

Private Sub optStopOrTrigger_Click(Index As Integer)
    If optStopOrTrigger(0) = True Then
        '// no pretrigger
        With lstStopCondtions
            .Clear
            .AddItem "Stop on an expression"
            .AddItem "Stop after a length of time"
            .AddItem "Stop after a number of messages"
        End With
            
        fmPostTriggerSetup.Enabled = False
        optAfterStop(0).Enabled = False
        optAfterStop(1).Enabled = False
        txtAfterStopMessages.Enabled = False
        tmAfterStop.Enabled = False
    Else
        With lstStopCondtions
            .Clear
            .AddItem "Trigger on an expression"
            .AddItem "Trigger after a length of time"
            .AddItem "Trigger after a number of messages"
        End With
        fmPostTriggerSetup.Enabled = True
        optAfterStop(0).Enabled = True
        txtAfterStopMessages.Enabled = True
        If Not lstStopCondtions.Selected(2) Then
            tmAfterStop.Enabled = True
            optAfterStop(1).Enabled = True
        End If
    End If
End Sub

