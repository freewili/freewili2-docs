Attribute VB_Name = "cMonitorScroll"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

Public WithEvents scl As VScrollBar
Attribute scl.VB_VarHelpID = -1
Public mon As cMonitor
Attribute mon.VB_VarHelpID = -1
Public lItemsPerPage As Long

'// private members
Private lViewLocationMax As Long
Private lViewLocationMin As Long

Public lNumBeforeStartIndex As Long
Public lStartPointMsgNumber As Long
Public lStartMsgPointer As Long

'// these two flags indicate the state of the buffer
Private bOverFlow As Boolean
Private bExtendedRange As Boolean
Private bOverFlowOffset As Long

'//public event
Public Event PausedScrollChanged()

Public Sub SetupScroll(lWholePage As Long)

    '// what range of operation are we in?
    If mon.Buffer.NumberItems >= mon.Buffer.BufferLength Then
        bOverFlow = True
        If mon.Buffer.BufferLength > 60000 Then
            bExtendedRange = True
        Else
            bExtendedRange = False
        End If
    Else
        bOverFlow = False
        If mon.Buffer.NumberItems > 60000 Then
            bExtendedRange = True
        Else
            bExtendedRange = False
        End If
        bOverFlowOffset = 0
    End If
    
    '// save the number of items per page
    lItemsPerPage = lWholePage
    lStartPointMsgNumber = mon.Buffer.NumberItems
    lStartMsgPointer = mon.Buffer.MsgHistoryPointer - 1
    If lStartMsgPointer = 0 Then lStartMsgPointer = lStartPointMsgNumber
      
    With scl

        '// what is the max
        If bOverFlow Then
            lViewLocationMax = mon.Buffer.BufferLength
        Else
            lViewLocationMax = mon.Buffer.NumberItems
        End If
        
        If bExtendedRange Then
            .Max = 30000
            .SmallChange = 1
            .LargeChange = 1000
            .Value = 30000
        Else
            .Max = -30000 + lViewLocationMax
 
            '// setup the max scroll region
            If lWholePage > lViewLocationMax Then
                .Min = .Max
            Else
                .Min = -30000 + lWholePage
            End If
    
            lNumBeforeStartIndex = 30000 + CLng(.Max)
            .Value = .Max
            
            If lWholePage > 0 Then
                .LargeChange = lWholePage
            End If
            .SmallChange = 1
            
        End If
        
        .Visible = True
        
    End With


End Sub



Public Sub MovePageUp()
    Dim lNew As Long
    lNew = lNumBeforeStartIndex - lItemsPerPage
    If lNew >= lItemsPerPage Then
        lNumBeforeStartIndex = lNew
    End If
    UpdateSclBar
End Sub

Public Sub MovePageDown()
    Dim lNew As Long
    lNew = lNumBeforeStartIndex + lItemsPerPage
    If lNew <= lViewLocationMax Then
       lNumBeforeStartIndex = lNew
    End If
    UpdateSclBar
End Sub

Public Sub MoveUpOne()
    Dim lNew As Long
    lNew = lNumBeforeStartIndex + 1
    If lNew <= lViewLocationMax Then
        lNumBeforeStartIndex = lNew
    End If
    UpdateSclBar
End Sub
Public Sub MoveDownOne()
    Dim lNew As Long
    lNew = lNumBeforeStartIndex - 1
    If lNew >= lItemsPerPage Then
        lNumBeforeStartIndex = lNew
    End If
    UpdateSclBar
End Sub

Private Sub scl_Change()
    PauseScrollChanged
End Sub
Private Sub scl_Scroll()
    PauseScrollChanged
End Sub

Private Sub UpdateSclBar()
    Dim lNew As Long
    
    If bExtendedRange Then
        'Debug.Print scl.Min, scl.Max
        lNew = CInt(lNumBeforeStartIndex / lViewLocationMax * 60000 - 30000)
        If lNew > scl.Max Then lNew = scl.Max
        If lNew < scl.Min Then lNew = scl.Min
        scl.Value = lNew
    Else
        scl.Value = lNumBeforeStartIndex - 30000
    End If
    RaiseEvent PausedScrollChanged
End Sub

Public Sub PauseScrollChanged()
    '// update the display
    If bExtendedRange Then
        lNumBeforeStartIndex = (30000 + CLng(scl.Value)) / 60000 * lViewLocationMax
    Else
        lNumBeforeStartIndex = 30000 + CLng(scl.Value)
    End If
    RaiseEvent PausedScrollChanged
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
