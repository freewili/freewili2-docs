'Load property values from storage
Private Sub UserControl_ReadProperties(PropBag As PropertyBag)

    comm.CommPort = PropBag.ReadProperty("CommPort", 2)
    m_DLCBaudRate = PropBag.ReadProperty("DLCBaudRate", m_def_DLCBaudRate)
    m_BaudRate = PropBag.ReadProperty("BaudRate", m_def_BaudRate)
    m_MonitorMode = PropBag.ReadProperty("MonitorMode", m_def_MonitorMode)
    m_DLCConnection = PropBag.ReadProperty("DLCConnection", m_def_DLCConnection)
End Sub

Private Sub UserControl_Terminate()
    Set mvarcMessageBytes = Nothing
    If mPortOpen Then PortOpen = False
End Sub

'Write property values to storage
Private Sub UserControl_WriteProperties(PropBag As PropertyBag)

    Call PropBag.WriteProperty("CommPort", comm.CommPort, 2)
    Call PropBag.WriteProperty("DLCBaudRate", m_DLCBaudRate, m_def_DLCBaudRate)
    Call PropBag.WriteProperty("BaudRate", m_BaudRate, m_def_BaudRate)
    Call PropBag.WriteProperty("MonitorMode", m_MonitorMode, m_def_MonitorMode)
    Call PropBag.WriteProperty("DLCConnection", m_DLCConnection, m_def_DLCConnection)
End Sub

'// This method resets the VSI by toggling
Public Function Reset() As Boolean


Dim sString As String

'// Pull DTR low for 100mS
comm.DTREnable = True
Call WaitMs(100)

comm.DTREnable = False
'// Wait another 100mS to reset
Call WaitMs(100)


'// Set up for pin to connect DLC //////
sString = comm.Input    '// Clear comm port
Transmit ("C" & Trim$(Str$(m_DLCConnection)) & vbCr)
If Not WaitForBytes(1, 500) Then
    LastErrorMessage = ERR_NO_RESPONSE
    Reset = False
    Exit Function
Else
    If comm.InBufferCount <> 1 Then
        LastErrorMessage = ERR_CONNECT_DLC_TO_ALDL
        Reset = False
        Exit Function
    End If
End If


'// Clear the buffer on the VSI
sString = comm.Input    '// Clear comm port
Transmit ("CB" & vbCr)
If Not WaitForBytes(1, 500) Then
    LastErrorMessage = ERR_NO_RESPONSE
    Reset = False
    Exit Function
End If

'// Set the DLC Baud Rate
sString = comm.Input    '// Clear comm port
Transmit ("I" & Trim$(Str$(m_DLCBaudRate)) & vbCr)
If Not WaitForBytes(1, 500) Then
    LastErrorMessage = ERR_NO_RESPONSE
    Reset = False
    Exit Function
End If

Reset = True

End Function

Private Function WaitMs(ByVal lMs As Long)
    Dim StartTime As Long
    StartTime = timeGetTime
    Do
    Loop Until Abs(timeGetTime - StartTime) > lMs
End Function


Public Function Read() As String
    Read = comm.Input
End Function

Public Function Transmit(SendString As String)
    comm.Output = SendString
End Function

Public Property Get DLCBaudRate() As icsVSIDLCBaudRate
Attribute DLCBaudRate.VB_Description = "Sets the baud rate for the DLC."
    DLCBaudRate = m_DLCBaudRate
End Property

Public Property Let DLCBaudRate(ByVal New_DLCBaudRate As icsVSIDLCBaudRate)
    m_DLCBaudRate = New_DLCBaudRate
    PropertyChanged "DLCBaudRate"
End Property

'Initialize Properties for User Control
Private Sub UserControl_InitProperties()
        m_DLCBaudRate = m_def_DLCBaudRate
    m_BaudRate = m_def_BaudRate
    m_MonitorMode = m_def_MonitorMode
    m_DLCConnection = m_def_DLCConnection
End Sub

Public Property Get BaudRate() As Long
Attribute BaudRate.VB_Description = "This sets the Baud rate of the VSI RS232 interface."
    BaudRate = m_BaudRate
End Property

Public Property Let BaudRate(ByVal New_BaudRate As Long)
    m_BaudRate = New_BaudRate
    PropertyChanged "BaudRate"
End Property

Public Property Get MonitorMode() As icsVSIMonitorMode
Attribute MonitorMode.VB_Description = "Indicates how messages should be sent to the host computer."
    MonitorMode = m_MonitorMode
End Property

Public Property Let MonitorMode(ByVal New_MonitorMode As icsVSIMonitorMode)
    m_MonitorMode = New_MonitorMode
    PropertyChanged "MonitorMode"
End Property

Public Property Get DLCConnection() As icsVSIConnectDLCtoALDLPin
Attribute DLCConnection.VB_Description = "Specifies how the DLC connects to the ALDL connector."
    DLCConnection = m_DLCConnection
End Property

Public Property Let DLCConnection(ByVal New_DLCConnection As icsVSIConnectDLCtoALDLPin)
    m_DLCConnection = New_DLCConnection
    PropertyChanged "DLCConnection"
End Property

