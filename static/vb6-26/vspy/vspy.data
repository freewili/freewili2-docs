Private Sub mnuWizardsLoadVLTC2Filter_Click()
    'Dim mTest As cTest
   Dim vFiles As Variant
   Dim lCount As Long
   
    
    On Error GoTo mnuWizardsLoadVLTC2Filter
    
    MousePointer = vbHourglass
    
    With cmn
        .DialogTitle = "Select VLT File"
        .FileName = ""  '// clear the file name
        If DirectoryExists("C:\VLTC2\SETUP") Then
            .InitDir = "C:\VLTC2\SETUP"
        Else
            .InitDir = App.Path
        End If
        .Flags = cdlOFNFileMustExist + cdlOFNAllowMultiselect + cdlOFNHideReadOnly + cdlOFNExplorer
        .Filter = "VLT C2 Filters (*.flt)|*.flt|VLT C2 Messages (*.msg)|*.msg|All VLT Files (*.msg,*.flt)|*.flt;*.msg"
        .ShowOpen
        
    End With
    
    vFiles = Split(cmn.FileName, Chr$(0))
    
    For lCount = LBound(vFiles) To UBound(vFiles)
        If Not obApp.LoadVLTFile(vFiles(lCount)) Then
            MsgBox "There was a problem trying to load this VLT file: " & vFiles(lCount), vbInformation
        End If
    Next lCount
    
    UpdateDisplay '// update everything
        
    '// return the mousepointer
    MousePointer = vbDefault
    

    Exit Sub

mnuWizardsLoadVLTC2Filter:

    If Err.Number <> 32755 Then
        '// Report the error
        MsgBox "num " & Err.Description & " des: " & Err.Number
    End If
    
    '// return the mousepointer
    MousePointer = vbDefault
End Sub

