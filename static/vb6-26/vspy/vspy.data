Private m_lKWP2000Mode As icsavtKWP2000Mode
Private m_lKWP2000MonitorBaud As Long
Private m_lPWMMode As icsavtPWMMode
Private m_lISOMode As icsavtISOMode
Private m_lISOMonitorBaud As Long

Private Const STATUS_TX_NO_ERR As Long = icsSpyStatusNetworkMessageType + icsSpyStatusTx

'// Defaults ////////////////////////////////////////////////////////
Private Const def_m_lProtocol As Long = icsavtProtocolVPW
Private Const def_m_lUnitType As Long = icsavtUnitAVT716
Private Const def_m_lKWP2000Mode As Long = icsavtKWPFastInitMode
Private Const def_m_lKWP2000MonitorBaud As Long = 10400
Private Const def_m_lPWMMode As Long = icsavtDiagnosticMode
Private Const def_m_lISOMode As Long = icsavtISOInitMode
Private Const def_m_lISOMonitorBaud As Long = 10400


Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage, lVersion As Long) As Boolean
    'this is it
    Dim vData As Variant
    Dim obPB As New PropertyBag
    Dim vDummy As Variant
    Dim vReturn As Variant
        
    If bWriteDirection Then
        
        '// first, write the properties into the bag
        With obPB
            .WriteProperty "Protocol", m_lProtocol, def_m_lProtocol
            .WriteProperty "UnitType", m_lUnitType, def_m_lUnitType
            .WriteProperty "KWP2000Mode", m_lKWP2000Mode, def_m_lKWP2000Mode
            .WriteProperty "KWP2000MonitorBaud", m_lKWP2000MonitorBaud, def_m_lKWP2000MonitorBaud
            .WriteProperty "PWMMode", m_lPWMMode, def_m_lPWMMode
            .WriteProperty "ISOMode", m_lISOMode, def_m_lISOMode
            .WriteProperty "ISOMonitorBaud", m_lISOMonitorBaud, def_m_lISOMonitorBaud
        End With

        '// return the contents of the bag
        vData = obPB.Contents
        
        '// write the array with the binary storage object
        obSave.ReadWriteArray vData
    Else
        '// read the array from the binary storage object
        obSave.ReadWriteArray vDummy, vReturn
        
        '// fill the property bag if there is somethign in the return array
        If Not IsEmpty(vReturn) Then
            
            '// fill the property bag with the data
            obPB.Contents = vReturn
            
            '// read the data out of the property bag
            With obPB
                m_lProtocol = .ReadProperty("Protocol", def_m_lProtocol)
                m_lUnitType = .ReadProperty("UnitType", def_m_lUnitType)
                m_lKWP2000Mode = .ReadProperty("KWP2000Mode", def_m_lKWP2000Mode)
                m_lKWP2000MonitorBaud = .ReadProperty("KWP2000MonitorBaud", def_m_lKWP2000MonitorBaud)
                m_lPWMMode = .ReadProperty("PWMMode", def_m_lPWMMode)
                m_lISOMode = .ReadProperty("ISOMode", def_m_lISOMode)
                m_lISOMonitorBaud = .ReadProperty("ISOMonitorBaud", def_m_lISOMonitorBaud)
            End With
        End If
    End If

End Function


