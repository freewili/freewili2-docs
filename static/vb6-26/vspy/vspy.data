Friend Function LoadOutputMessageFromDatabase(DatabaseID As Long, sKey As String) As Boolean

    Dim outMsg As cOutgoingMessage
    
    On Error GoTo LoadOutputMessageFromDatabaseError
    
    If OpenDataBase Then
        If OutgoingMessages.KeyExists(sKey) Then
            Set outMsg = OutgoingMessages(sKey)
            tblOutputs.Index = "PrimaryKey"
            tblOutputs.Seek "=", DatabaseID
            Call TransferDataFromOutputRecordToObject(outMsg)
        End If
        CloseDataBase
        LoadOutputMessageFromDatabase = True
    Else
        LoadOutputMessageFromDatabase = False
    End If

    Exit Function
LoadOutputMessageFromDatabaseError:
    
    LoadOutputMessageFromDatabase = False
    Call MsgBoxShowErrorGeneric("There was an error transfering from the database.", "No suggestions")
    Err.Clear

End Function

Private Function TransferDataFromOutputRecordToObject(outMsg As cOutgoingMessage) As Boolean
    
    On Error GoTo TransferDataFromOutputRecordToObjectError
    
    Dim lAdjustmentForCan As Long
    
    If Protocol = icsVSPYProtocolCAN Then
        lAdjustmentForCan = -1
    Else
        lAdjustmentForCan = 0
    End If
    
    If Not IsNull(tblOutputs("Description")) Then outMsg.Description = tblOutputs("Description")
    If Not IsNull(tblOutputs("PT")) Then outMsg.ByteString(1) = tblOutputs("PT")
    If Not IsNull(tblOutputs("Trgt")) Then outMsg.ByteString(2) = tblOutputs("Trgt")
    If Not IsNull(tblOutputs("Src")) Then outMsg.ByteString(3) = tblOutputs("Src")
    
    If Not IsNull(tblOutputs("B1")) Then outMsg.ByteString(4 + lAdjustmentForCan) = tblOutputs("B1")
    If Not IsNull(tblOutputs("B2")) Then outMsg.ByteString(5 + lAdjustmentForCan) = tblOutputs("B2")
    If Not IsNull(tblOutputs("B3")) Then outMsg.ByteString(6 + lAdjustmentForCan) = tblOutputs("B3")
    If Not IsNull(tblOutputs("B4")) Then outMsg.ByteString(7 + lAdjustmentForCan) = tblOutputs("B4")
    If Not IsNull(tblOutputs("B5")) Then outMsg.ByteString(8 + lAdjustmentForCan) = tblOutputs("B5")
    If Not IsNull(tblOutputs("B6")) Then outMsg.ByteString(9 + lAdjustmentForCan) = tblOutputs("B6")
    If Not IsNull(tblOutputs("B7")) Then outMsg.ByteString(10 + lAdjustmentForCan) = tblOutputs("B7")
    If Not IsNull(tblOutputs("B8")) Then outMsg.ByteString(11 + lAdjustmentForCan) = tblOutputs("B8")
    
    If Not IsNull(tblOutputs("ValueType")) Then outMsg.ValueType = tblOutputs("ValueType")
    If Not IsNull(tblOutputs("Value")) Then outMsg.Value = tblOutputs("Value")
    If Not IsNull(tblOutputs("TXRate")) Then outMsg.UpdateRate = tblOutputs("TXRate")
    
        
    TransferDataFromOutputRecordToObject = True
    
    Exit Function
TransferDataFromOutputRecordToObjectError:
    
    TransferDataFromOutputRecordToObject = False
    Call MsgBoxShowErrorGeneric("There was an error transfering from the database.", "No suggestions")
    Err.Clear

End Function

Friend Function RemoveIncomingMessageFromDatabase(DatabaseID As Long) As Boolean
    On Error GoTo RemoveInputFromDatabaseError
    With tblInputs
        .Index = "PrimaryKey"
        .Seek "=", DatabaseID
        .Delete
    End With
    RemoveIncomingMessageFromDatabase = True
    Exit Function
RemoveInputFromDatabaseError:
    RemoveIncomingMessageFromDatabase = False
    Call MsgBoxShowErrorGeneric("There was an error removing an incoming message to the database.", "No suggestions")
    Err.Clear
End Function
Friend Function RemoveOutgoingMessageFromDatabase(DatabaseID As Long) As Boolean
    On Error GoTo RemoveOutputFromDatabaseError
    With tblOutputs
        .Index = "PrimaryKey"
        .Seek "=", DatabaseID
        .Delete
    End With
    RemoveOutgoingMessageFromDatabase = True
    Exit Function
RemoveOutputFromDatabaseError:
    RemoveOutgoingMessageFromDatabase = False
    Call MsgBoxShowErrorGeneric("There was an error removing an outgoing message to the database.", "No suggestions")
    Err.Clear
End Function

Public Sub CloseDataBase()
    On Error Resume Next
    tblInputs.Close         '// Close the tables and then the database
    tblOutputs.Close
    db.Close
    If Err.Number <> 0 Then
        Call MsgBoxShowErrorGeneric("There was an error closing the database.", "No suggestions")
        Err.Clear
    End If
End Sub

