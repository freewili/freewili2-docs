Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

'// Intrepid Control Systems, Inc.
'// Copyright 1997-98 All rights reserved
'// Written by Dave Robins

'// used for combo box
Private Declare Function SendMessage Lib "user32" Alias "SendMessageA" _
    (ByVal hwnd As Long, ByVal wMsg As Long, _
                            ByVal wParam As Long, lParam As Any) As Long
Private Declare Function HtmlHelpA Lib "hhctrl.ocx" (ByVal hwnd As Long, ByVal sFile As String, ByVal uCommand As Long, ByVal word As Long) As Long
Private Const HH_DISPLAY_TOC = 1


'// private or public object variables
Private mfrmHelp As frmHelp
Private m_bGridSelChanged As Boolean    '// used for fill down operations

Private WithEvents mmSound As cSoundMCI
Attribute mmSound.VB_VarHelpID = -1
Public WithEvents obApp As cicsSpy              '// ref to app object
Attribute obApp.VB_VarHelpID = -1
Private WithEvents UI As cCustomUI
Attribute UI.VB_VarHelpID = -1
Private WithEvents fComment As frmComment
Attribute fComment.VB_VarHelpID = -1
Private WithEvents fAudioComment As frmAudioComment
Attribute fAudioComment.VB_VarHelpID = -1
Private WithEvents obScl As cMonitorScroll
Attribute obScl.VB_VarHelpID = -1

'// Constants used with sendmessage
Private Const CB_SHOWDROPDOWN = &H14F
Private Const CB_FINDSTRING = &H14C

'// enum defines which view is currently shown in the monitor
Public Enum ICSSpyMainUIView
    icsSpyGraphicalView
    icsSpyTextView
    icsSpyNotesView
    icsSpyIncomingMessagesView
    icsSpyOutgoingMessagesView
End Enum

Private mCurrentView As ICSSpyMainUIView        '// holds the current view shown
Private MouseY As Single                        '// Cache for scrolling monitor display

Private obClipBoardIncoming As New cPlaceData
Private obClipBoardOutgoing As New cPlaceData

Private lCurrentMessageHighlighted As Long      '// index of incoming message match
Private lLastValueHighlight As Long


'// vars that deal with the transmit buttons
Private lastvalue  As Long          '// used for message counting/bus stats
Private bEditIncoming As Boolean    '// indicates an inplace edit is inprogress for incoming messages
Private bEditOutgoing As Boolean    '// indicates an inplace edit is inprogress for outgoing messages
Private lEditRow As Long            '// Row where editing is taking place
Private sEditKey As String          '// key of the item being edited

Private lEditCol As Long            '// Records col where edit is
Private EditControl As Control      '// refs control used to edit
Private lCurrentTest As Long        '// indicates the current test viewed in the monitor

'// private members for the highlight bar
Private lOldStartX As Long
Private lOldEndX As Long
Private lOldEndY As Long
Private lLastRowFirst As Boolean
Private lOldDrawStyle As Long

'// Constants define the grid locations
Private mOutMsgDescriptionCol As Long
Private mOutMsgValueCol As Long
Private mOutMsgValueTypeCol As Long
Private mOutMsgUpdateRateCol As Long
Private mOutMsgFirstHeaderCol As Long
Private mOutMsgLastByteCol As Long
Private mOutMsgFirstByteCol As Long
Private mOutMsgRespondFileName As Long


'// constants used for the tests grid
