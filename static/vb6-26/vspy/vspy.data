Private Sub pctBufferTab_Resize()
    Dim lNewWidth As Long
    lNewWidth = pctBufferTab.ScaleWidth - tbScroll.Width
    If lNewWidth > 0 Then
        tsBuffers.Move 0, 0, lNewWidth, pctBufferTab.ScaleHeight
        tbScroll.Move lNewWidth, 0, tbScroll.Width, pctBufferTab.ScaleHeight
    End If
End Sub

