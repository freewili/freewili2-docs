Public Sub MakeNew()
    Dim lCount As Long
    

    '// Create the mcFilters object when the cMonitor class is created
    mvarFontName = GetSetting("icsVSpy", "Defaults", "MonitorFontName", "Arial")
    mvarFontSize = GetSetting("icsVSpy", "Defaults", "MonitorFontSize", 8.25)
    mvarFontBold = GetSetting("icsVSpy", "Defaults", "MonitorFontBold", False)
    mvarForeColor = GetSetting("icsVSpy", "Defaults", "MonitorForeColor", vbBlack)
    mvarBackColor = GetSetting("icsVSpy", "Defaults", "MonitorBackColor", vbWhite)
    mvarNumberOfMessagesHistory = GetSetting("icsVSpy", "Defaults", "MonitorMessagesHistory", 20000)
    mvarBusLoadMaxMessages = GetSetting("icsVSpy", "Defaults", "MonitorBusLoadMax", 200)
    mvarShowDescription = GetSetting("icsVSpy", "Defaults", "MonitorShowDescription", True)
    mvarShowValue = GetSetting("icsVSpy", "Defaults", "MonitorShowValue", True)
    mvarShowDataBytes = GetSetting("icsVSpy", "Defaults", "MonitorShowDataBytes", True)
    mvarDisplayFormat = GetSetting("icsVSpy", "Defaults", "MonitorDisplayFormat", icsspyMonitorHex)
    
    
    '// create a new set of filters and new monitor buffer
    Set mvarcFilters = Nothing
    Set mvarcFilters = New cFilters
    Set mvarcBuffer = Nothing
    Set mvarcBuffer = New cBuffer
    
    '// add the tx buttons //////////////////////////////////////////
    TxButtons.RemoveAll
    For lCount = 1 To 9 '// start with 9
        TxButtons.Add
        TxButtons(lCount).Caption = ""
    Next lCount
    '////////////////////////////////////////////////////////////////
    
End Sub

'// save the current values to the registry
Public Sub MakeCurrentValuesDefault()
    Call SaveSetting("icsVSpy", "Defaults", "MonitorFontName", mvarFontName)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorFontSize", mvarFontSize)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorFontBold", mvarFontBold)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorForeColor", mvarForeColor)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorBackColor", mvarBackColor)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorMessagesHistory", mvarNumberOfMessagesHistory)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorBusLoadMax", mvarBusLoadMaxMessages)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorShowDescription", mvarShowDescription)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorShowValue", mvarShowValue)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorShowDataBytes", mvarShowDataBytes)
    Call SaveSetting("icsVSpy", "Defaults", "MonitorDisplayFormat", mvarDisplayFormat)
End Sub

Friend Sub ShowFiltersSetupForm(obApp As cicsSpy)
    With frmEditFilter
        Set .obApp = obApp '// Show the filter dialog
        Set .FiltersToEdit = mvarcFilters
        .DonotShowExcluded = False
        .Caption = "Select the input messages for the filter"
        .SetupUI
        .Show vbModal
    End With
    Set frmEditFilter = Nothing
End Sub

Public Property Get MonitorBuffer() As cBuffer
    Set MonitorBuffer = mvarcBuffer
End Property

Public Sub Reset()
    mvarcBuffer.Reset   '// reset the monitor buffer
End Sub

Friend Sub AddMessage(msg As icsSpyMessageLong)
    If Not mHaveFirstMessage Then
        SetupStartTime msg
    End If
    Call mvarcBuffer.AddElement(msg)
End Sub

Friend Property Get SpyMsgTime() As SpyMsgTime
    If UseTestBuffer Then
        SpyMsgTime = Test.SpyMsgTime
    Else
        SpyMsgTime = mSpyMsgStartTime
    End If
End Property

Private Sub SetupStartTime(msg As icsSpyMessageLong)
    
    Dim lDiff As Long
    Dim lStartHardware As Long
    Dim mSpyMsgTime As SpyMsgTime
    
    If (msg.StatusBitField And icsSpyStatusHardwareTimePresent) Then
        '// calculate a hardware time based on the
        lDiff = msg.TimeSystem - mvarStartTimeMs
        lStartHardware = (msg.TimeHardware - lDiff) Mod 60000
        If lStartHardware < 0 Then
            lStartHardware = 60000 + lStartHardware
        End If
        mSpyMsgStartTime.SystemTimeMs = mvarStartTimeMs
        mSpyMsgStartTime.HardwareTimeMs = lStartHardware
        mSpyMsgStartTime.HardwareTimePresent = True
    Else
        mSpyMsgStartTime.SystemTimeMs = mvarStartTimeMs
        mSpyMsgStartTime.HardwareTimePresent = False
    End If
    mHaveFirstMessage = True
    
End Sub

Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage) As Boolean
    
    Dim lTemp As Long
    Dim dSpace As Double
    Dim lSpace As Long
    Dim sSpace As String
    Dim lCount As Long
    Dim lDummy As Long
    Dim dDummy As Double
    Dim bSpace As Boolean
    Dim bHasTxButtonData As Boolean

With obSave
    
    .ReadWriteBoolean mvarShowDescription
    .ReadWriteBoolean mvarUseFilters
    .ReadWriteLong mvarNumberOfMessagesHistory
    .ReadWriteLong mvarBusLoadMaxMessages
    .ReadWriteLong mvarBackColor
    .ReadWriteLong mvarForeColor
    
    '.ReadWriteLong lTemp       '// modified 7/29
    .ReadWriteBoolean mvarFontBold
    .ReadWriteBoolean mvarFontItalic
                                '// end modification
    
    .ReadWriteLong lTemp
    
    
    '// padding for TX buttons and panel sizes /////////////////////////
    lDummy = 12
    .ReadWriteLong lDummy '// say 12 for now
    lDummy = 0
    For lCount = 1 To 12
        .ReadWriteLong lDummy
    Next lCount

    dDummy = 0.25
    .ReadWriteDouble dDummy '//panel left right
    dDummy = 0.5
    .ReadWriteDouble dDummy ' panel up down
    '// end new padding /////////////////////////////////////////////
    
    '.. new padding
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
                            '// DAVEEDIT modified 7/29/98
    .ReadWriteDouble mvarFontSize
    If Not bWriteDirection Then
       If mvarFontSize < 2 Then
            mvarFontSize = 8.25
        End If
    End If
                            '// DAVEEDIT end modified 7/29/98
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    
                    '// DAVEEDIT BEGIN MODIFIED 7/29/98
    .ReadWriteString mvarFontName
    If Not bWriteDirection Then
       If mvarFontName = "" Then
            mvarFontName = "Arial"
        End If
    End If
                    '// DAVEEDIT END MODIFIED 7/29/98
    
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    
                    '// DAVEEDIT BEGIN MODIFIED 10/24/98 '' adding saving for the tx buttons
    If bWriteDirection Then
        bHasTxButtonData = True
    End If
    
    
    .ReadWriteBoolean bHasTxButtonData
    .ReadWriteBoolean bSpace
                    '// DAVEEDIT BEGIN END 10/24/98
    
    If bHasTxButtonData Then
        Call TxButtons.ReadWrite(bWriteDirection, obSave)
    End If
    
    
    '/// DAVEEDIT BEGIN 2/4/99
    '.ReadWriteLong lSpace
    .ReadWriteLong mvarDisplayFormat
    '//DAVEEDIT BEGIN END2/4/99
    
    
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace

End With

'// read write the filters
Call mvarcFilters.ReadWrite(bWriteDirection, obSave)


End Function

