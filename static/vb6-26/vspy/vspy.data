Private Sub DetermineMinAndMax(stepNumber1 As Long, StepNumber2 As Long, lMin As Long, lMax As Long)

    If StepNumber2 = 0 Then
        lMax = stepNumber1
        lMin = stepNumber1
    ElseIf StepNumber2 > stepNumber1 Then
        lMax = StepNumber2
        lMin = stepNumber1
    Else
        lMax = stepNumber1
        lMin = StepNumber2
    End If

End Sub

