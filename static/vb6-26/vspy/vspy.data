    mnuMonitorSetup_Click '// show monitor setup
End Sub



Private Sub pctRead_GotFocus()
    Call DrawHightLightBar(pctRead, True)
End Sub

Private Sub pctRead_KeyDown(KeyCode As Integer, Shift As Integer)
    Dim lTextHeight As Long

    '// what is the text height of one char
    lTextHeight = pctRead.TextHeight("A")

    Select Case KeyCode
        Case vbKeyUp
            MouseY = MouseY - lTextHeight
            If MouseY < lTextHeight Then
                MouseY = lTextHeight
                If obApp.Monitor.Paused Then
                    obScl.MoveUpOne
                End If
            End If
        Case vbKeyDown
            If (MouseY + lTextHeight) <= pctRead.ScaleHeight Then
                MouseY = MouseY + lTextHeight
            Else
                If obApp.Monitor.Paused Then
                    obScl.MoveDownOne
                End If
            End If
        Case vbKeyPageUp
            If obApp.Monitor.Paused Then
                obScl.MovePageUp
            End If
        Case vbKeyPageDown
            If obApp.Monitor.Paused Then
                obScl.MovePageDown
            End If
        Case vbKeyHome
            MouseY = lTextHeight
        Case vbKeyEnd
            MouseY = lTextHeight * NumberOfDisplayedLines
        Case vbKeyReturn
            '// Show the context menu
            PopupMenu mnuMonitor, , pctRead.Left + pctRead.ScaleWidth \ 2, pctRead.Top + lOldEndY
            
    End Select
    
    
    DrawHightLightBar pctRead, True
    
    
End Sub

Private Sub pctRead_LostFocus()
    Call DrawHightLightBar(pctRead, True)
End Sub

Private Sub pctRead_MouseDown(Button As Integer, Shift As Integer, _
                                                        X As Single, Y As Single)
    MouseY = Y
    DrawHightLightBar pctRead, True
    

    '// Show the context menu
    If Button And vbRightButton Then
        PopupMenu mnuMonitor
    End If

End Sub

Private Sub pctRead_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If Button And vbLeftButton Then
        MouseY = Y
        DrawHightLightBar pctRead, True
    End If
    
    '// work the help file
    ShowHelpFile "spyScrolling.htm"
End Sub


Private Sub Form_Load()
    
    '// positions of the main form
    Dim lnewleft As Long
    Dim lNewTop As Long
    Dim lNewWidth As Long
    Dim lNewHeight As Long

    '// set the middle bar
    MiddleBarPercent = GetSetting("ICSVSpy", "UI", "BarUpDwn", 0.5)
    MiddleBarPercentRL = GetSetting("ICSVSpy", "UI", "BarLftRght", 0.25)
    '// enfore limits on the middle bar percent
    If MiddleBarPercent > 1 Then MiddleBarPercent = 1
    If MiddleBarPercent < 0.01 Then MiddleBarPercent = 0.01
    
    '// restore the last location of the user interface
    lnewleft = GetSetting("ICSVSpy", "UI", "MainLeft", -2000)
    lNewTop = GetSetting("ICSVSpy", "UI", "MainTop", -2000)
    lNewWidth = GetSetting("ICSVSpy", "UI", "MainWidth", -2000)
    lNewHeight = GetSetting("ICSVSpy", "UI", "MainHeight", -2000)
    
    '// verify that there were previous settings
    If lnewleft > -200 And lNewTop > -200 And lNewWidth > -200 And lNewHeight > -200 Then
        '// ok, verify that the old settings still fit on the screen
        If ((lnewleft + lNewWidth) < (Screen.Width + 200)) And _
            ((lNewTop + lNewHeight) < (Screen.Height + 200)) Then
            '// set the form location
            Move lnewleft, lNewTop, lNewWidth, lNewHeight
        Else
            Call centerform(Me)
        End If
    Else
        Call centerform(Me)
    End If
    
    LoadToolBarFromResource '// Load the toolbar
    
    '// Hide these because we want to access it only at design time
    mnuMonitor.Visible = False
    mnuCustomDisplay.Visible = False
    mnuControl.Visible = False
    mnutestcontext.Visible = False
    mnuOutgoing.Visible = False
    mnubusload.Visible = False
    mnuIncomingFilter.Visible = False
    mnuIncomingValues.Visible = False
    
    CurrentView = icsSpyTextView    '// start with the text view
    
    lstOutgoingMessageType.AddItem "Digital Out"
    lstOutgoingMessageType.AddItem "Analog Out"
    With lstIncomingMessageValueType
        .AddItem "None"
        .AddItem "Analog In"
        .AddItem "Digital In"
        .AddItem "State Encoded"
        .AddItem "ASCII"
    End With
    With lstOutgoingMessageTxRate
        .AddItem "Manual"
        .AddItem "0.05"
        .AddItem "0.1"
        .AddItem "0.20"
        .AddItem "0.30"
        .AddItem "0.50"
        .AddItem "1.00"
        .AddItem "2.00"
        .AddItem "5.00"
        .AddItem "10.00"
        .AddItem "30.00"
        .AddItem "60.00"
    End With
    
    '// register the clipboard formats
    Call obClipBoardIncoming.RegisterFormat("VSPY InMsgs")
    Call obClipBoardOutgoing.RegisterFormat("VSPY OutMsgs")
    
End Sub

Public Sub ShowFirstForm()
    Dim ob As Object
    On Error GoTo ShowFirstFormError
    MousePointer = vbHourglass
    Set ob = CreateObject("icsvspyFirst.cicsvspyFirst")
    ob.ShowWelcome = True
    Set ob.obApp = obApp
    ob.showform
    Set ob = Nothing
    MousePointer = vbDefault
    Exit Sub
ShowFirstFormError:
    MsgBox "There was an error showing the first form." & vbCrLf & vbCrLf & "Description: " & Err.Description, vbInformation
    Set ob = Nothing
    MousePointer = vbDefault
End Sub


Private Sub Form_QueryUnload(Cancel As Integer, UnloadMode As Integer)
    Dim bCallSave As Boolean
    
    If App.StartMode = vbSModeStandalone Then
        If obApp.MonitorOn Then obApp.MonitorOn = False
        If Not obApp.App.NewOk(bCallSave) Then
            If bCallSave Then
                mnuFileSave_Click
            Else
                Cancel = True
                Exit Sub
            End If
        End If
        obApp.StopVoiceEngine
    End If
    Set obApp = Nothing '// Free the ref to the main object
End Sub

Private Sub Form_Resize()
    
    Dim lNew As Long
    Dim lNewWidth As Long
    Dim lNewTop As Long
    Dim lNewHeight As Long
    Dim lNewBufferDisplayWidth As Long
    
    
    '// cwstats

    
    
    '// setup the filters and messages scaling
    lNew = ScaleHeight - sBar.Height - tb.Height
    If lNew > 0 Then
        grdIncomingMessages.Move 0, tb.Height, ScaleWidth, lNew
        grdOutgoingMessages.Move 0, tb.Height, ScaleWidth, lNew
        pctDisplay.Move 0, tb.Height, ScaleWidth, lNew
        
        wbNotes.Move tbNotes.Width, tb.Height, ScaleWidth - tbNotes.Width, lNew
    End If
    
    '// calculate the width of the middle bar
    If ScaleWidth > 0 Then
        pctmonTest.Width = Abs(MiddleBarPercentRL) * (ScaleWidth - tbMonitor.Width)
    End If
    
    lNewWidth = ScaleWidth - tbMonitor.Width - pctmonTest.Width
    lNewBufferDisplayWidth = lNew - pctBufferTab.Height
    If lNewBufferDisplayWidth > 0 And lNewWidth > 0 Then
        pctRead.Move tbMonitor.Width, tb.Height, lNewWidth, lNewBufferDisplayWidth
        pctDraw.Move tbMonitor.Width, tb.Height, lNewWidth, lNewBufferDisplayWidth
        pctBufferTab.Move tbMonitor.Width, tb.Height + lNewBufferDisplayWidth, lNewWidth
    End If
    
    '// Size the test grid
    If lNew > 0 Then
        pctmonTest.Move pctRead.Width + tbMonitor.Width, tb.Height, pctmonTest.Width, lNew
    End If
    
    lNew = ScaleWidth - pctBuffer.Width
    If lNew >= 3000 Then
        pctBuffer.Move ScaleWidth - pctBuffer.Width
    End If
    
End Sub
