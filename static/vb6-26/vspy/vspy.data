Attribute VB_Name = "frmSetupMonitor"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False


Option Explicit

Public obApp As cicsSpy
Private bFontSet As Boolean

Private Sub chkFontBold_Click()
    SetupFontLabel
End Sub

Private Sub chkFontItalic_Click()
    SetupFontLabel
End Sub

Private Sub cmdBackColor_Click()
    On Error GoTo colorerrorback
    cmn.ShowColor
    pctBackColor.BackColor = cmn.Color
    SetupFontLabel
    Exit Sub
colorerrorback:
End Sub

Private Sub cmdCancel_Click()
    Unload Me
End Sub

Private Sub cmdFilters_Click()
    MousePointer = vbHourglass
    obApp.Monitor.ShowFiltersSetupForm obApp
    MousePointer = vbDefault
End Sub

Private Sub cmdMakeDefault_Click()

End Sub

Private Sub cmdOk_Click()
    Dim dValue As Double

    If mt.Value = 0 Then
        MsgBox "The averaging period must be greater than zero. Please fix.", vbInformation, "Problem with data entry"
        Exit Sub
    End If
    
    dValue = Val(txtHistory)
    If dValue < 100 Then
        MsgBox "The message history has a minimum length of 100 messages. Please fix.", vbInformation, "Problem with data entry"
        Exit Sub
    End If
    
    If dValue > 2 ^ 30 Then
        MsgBox "The message history has a maximum length of 2 ^ 30 messages. Please fix.", vbInformation, "Problem with data entry"
        Exit Sub
    End If

    
    dValue = Val(lstFontSize)
    If dValue < 1 Then
        MsgBox "The font size must be greater than 1. Please fix.", vbInformation, "Problem with data entry"
        Exit Sub
    End If
    If dValue > 200 Then
        MsgBox "The font size must be less than 200. Please fix.", vbInformation, "Problem with data entry"
        Exit Sub
    End If
    
    dValue = Val(txtBusLoadMax)
    If dValue < 1 Then
        MsgBox "The bus load max must be greater than 1. Please fix.", vbInformation, "Problem with data entry"
        Exit Sub
    End If
    If dValue > 2 ^ 30 Then
        MsgBox "The bus load max must be less than " & (2 ^ 30) & ". Please fix.", vbInformation, "Problem with data entry"
        Exit Sub
    End If
    
    With obApp.Monitor
        .FontName = lstFonts
        .BusLoadMaxMessages = CLng(Val(txtBusLoadMax))
        .NumberOfMessagesHistory = CLng(Val(txtHistory))
        .UseFilters = chkEnableFilters = vbChecked
        obApp.BusLoadUpdateRate = mt.Value
        .ForeColor = pctTextColor.BackColor
        .BackColor = pctBackColor.BackColor
        .FontSize = Val(lstFontSize)
        .FontBold = chkFontBold = vbChecked
        .FontItalic = chkFontItalic = vbChecked
        .ShowCBit = chkShowCBit = vbChecked
        .ShowQBit = chkShowQBit = vbChecked
        .ShowValue = chkShowValue = vbChecked
        .ShowDescription = chkShowDescription = vbChecked
        .ShowDataBytes = chkShowDataBytes = vbChecked
        .DisplayFormat = lstDisplayFormat.ListIndex
    End With
    
    '// Do we need to make the current values the default
    If chkMakeDefault = vbChecked Then
        obApp.Monitor.MakeCurrentValuesDefault
    End If
    
    obApp.App.SaveNeeded = True
    
    Unload Me
    
End Sub

Private Sub cmdTextColor_Click()
    On Error GoTo colorerrortext
    cmn.ShowColor
    pctTextColor.BackColor = cmn.Color
    SetupFontLabel
    Exit Sub
colorerrortext:
End Sub

Private Sub Form_Load()
    Dim lCount As Long

    bFontSet = False    '// we want to set the font only once
    
    '// do not allow buffer editing while running
    If obApp.MonitorOn Then
        lblHistory.Enabled = False
        txtHistory.Enabled = False
        lblHistory = "Monitor History can only be adjusted when not collecting data."
    End If
    
    With obApp.Monitor
        chkEnableFilters = Abs(.UseFilters)
        chkFontBold = Abs(.FontBold)
        chkFontItalic = Abs(.FontItalic)
        chkShowDescription = Abs(.ShowDescription)
        chkShowDataBytes = Abs(.ShowDataBytes)
        chkShowQBit = Abs(.ShowQBit)
        chkShowCBit = Abs(.ShowCBit)
        chkShowValue = Abs(.ShowValue)
        txtHistory = Format(.NumberOfMessagesHistory)
        txtBusLoadMax = Format(.BusLoadMaxMessages)
        mt.Value = obApp.BusLoadUpdateRate
        pctTextColor.BackColor = .ForeColor
        pctBackColor.BackColor = .BackColor
        lstFonts = .FontName
        lstFontSize = str$(.FontSize)
        lstDisplayFormat.ListIndex = .DisplayFormat
        SetupFontLabel
    End With
   
   With lstSchemes
        .AddItem "(select one)"
        .AddItem "Detroit Red Wings"
        .AddItem "Detroit Lions"
        .AddItem "University of Michigan Wolverines"
        .AddItem "Michigan State University Spartans"
        .AddItem "Macomb Community College Monarchs"
        .AddItem "Henry Ford II Falcons"
        .AddItem "Halloween"
        .AddItem "December Holiday"
        .AddItem "Valentines Day"
        .ListIndex = 0
    End With
        
   
End Sub


Private Sub SetupFontLabel()
    On Error Resume Next
    With lblTestFont
        .FontName = lstFonts
        .FontSize = Val(lstFontSize)
        .FontBold = chkFontBold = vbChecked
        .FontItalic = chkFontItalic = vbChecked
        .BackColor = pctBackColor.BackColor
        .ForeColor = pctTextColor.BackColor
    End With
End Sub

Private Sub lblTestFont_Click()
    Debug.Print "forecolor: " & (lblTestFont.ForeColor)
    Debug.Print "backcolor: " & (lblTestFont.BackColor)
    
End Sub

Private Sub lstFonts_Click()
    SetupFontLabel
End Sub

Private Sub lstFontSize_Change()
    SetupFontLabel
End Sub

Private Sub lstFontSize_Click()
    If Val(lstFontSize) > 2 Then
        lblTestFont.FontSize = Val(lstFontSize)
    End If
End Sub


Private Sub lstSchemes_Click()
Dim lIndex As Long

    Select Case lstSchemes.ListIndex
        Case 0 ' "(select one)"
        Case 1 ' "Red Wings"
            lblTestFont.ForeColor = &HFFFFFF
            lblTestFont.BackColor = &HFF
        Case 2 ' "Detroit Lions"
            lblTestFont.ForeColor = &HC0C0C0
            lblTestFont.BackColor = &H800000
        Case 3 ' "University of Michigan"
            lblTestFont.ForeColor = 65535
            lblTestFont.BackColor = 8388608
        Case 4 ' "Michigan State University"
            lblTestFont.ForeColor = 16777215
            lblTestFont.BackColor = 32768
        Case 5 ' "Henry Ford II Falcons"
            lblTestFont.ForeColor = &HFFFFFF
            lblTestFont.BackColor = &HA00000
        Case 6 ' "Macomb Community College"
            lblTestFont.ForeColor = &HDFDFDF
            lblTestFont.BackColor = &H400080
        Case 7 ' "Halloween"
            lblTestFont.ForeColor = 4210816
            lblTestFont.BackColor = 33023
        Case 8 ' "Christmas"
            lblTestFont.ForeColor = 255
            lblTestFont.BackColor = 32768
        Case 9 ' "Valentines Day"
            lblTestFont.ForeColor = &H8000FF
            lblTestFont.BackColor = &HFF80FF
    End Select
    
    pctBackColor.BackColor = lblTestFont.BackColor
    pctTextColor.BackColor = lblTestFont.ForeColor
    
    
End Sub

Private Sub SSTab1_Click(PreviousTab As Integer)
    Dim lNumFonts As Long
    Dim lCount As Long
    MousePointer = vbHourglass
    If SSTab1.Tab = 1 And Not bFontSet Then
        bFontSet = True
          
        lNumFonts = Screen.FontCount - 1
        For lCount = 0 To lNumFonts
            lstFonts.AddItem Screen.Fonts(lCount)
        Next lCount

        lstFonts = obApp.Monitor.FontName
        
        '// setup the font size list
        For lCount = 8 To 90
            lstFontSize.AddItem str$(lCount)
        Next lCount
        lstFontSize = str$(obApp.Monitor.FontSize)
    End If
    
    MousePointer = vbDefault
End Sub

