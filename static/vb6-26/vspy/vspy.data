End Sub

Private Sub Class_Initialize()
    DataID = 1
End Sub


Public Sub ReadWriteData(bWriteDirection As Boolean, obSave As Object)

    Dim vData As Variant
    Dim obPB As New PropertyBag
    Dim vDummy As Variant
    Dim vReturn As Variant
    
    If bWriteDirection Then
        
        '// first, write the properties into the bag
        With obPB
            .WriteProperty "Key", Key, ""
            .WriteProperty "Top", Top, 0
            .WriteProperty "Height", height, 0
            .WriteProperty "Left", Left, 0
            .WriteProperty "Width", Width, 0
            .WriteProperty "DataID", DataID, 0
        End With


        '// return the contents of the bag
        vData = obPB.Contents
        
        '// write the array with the binary storage object
        obSave.readwritearray vData
        
    Else
        '// read the array from the binary storage object
        obSave.readwritearray vDummy, vReturn
        
    
        '// fill the property bag if there is somethign in the return array
        If Not IsEmpty(vReturn) Then
            
            '// fill the property bag with the data
            obPB.Contents = vReturn
            
            '// read the data out of the property bag
            With obPB
                Key = .ReadProperty("Key", "")
                Top = .ReadProperty("Top", 0)
                height = .ReadProperty("Height", 0)
                Left = .ReadProperty("Left", 0)
                Width = .ReadProperty("Width", 0)
                DataID = .ReadProperty("DataID", 0)
            End With
        End If
    End If
'//////////////////////////////


End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
