   MinButton       =   0   'False
   ScaleHeight     =   5280
   ScaleWidth      =   3720
   ShowInTaskbar   =   0   'False
   StartUpPosition =   3  'Windows Default
   Begin MSFlexGridLib.MSFlexGrid g 
      Height          =   1725
      Left            =   90
      TabIndex        =   0
      Top             =   75
      Width           =   2445
      _ExtentX        =   4313
      _ExtentY        =   3043
      _Version        =   393216
      AllowUserResizing=   1
