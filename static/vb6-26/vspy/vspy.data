End Sub

Private Sub pctMiddle_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If Button And vbLeftButton Then
        pctResizeUpDwn.Visible = True
    End If
End Sub

Private Sub pctMiddle_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim lNewTop As Long
    
    If Button And vbLeftButton Then
        lNewTop = pctMiddle.Top + Y
        If lNewTop < (pctmonTest.ScaleHeight - 100) Then
            pctResizeUpDwn.Move pctMiddle.Left, lNewTop, pctMiddle.Width, 75
        End If
    End If
    

End Sub

Private Sub pctMiddle_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
Dim lNewTop As Long
    
    If Button And vbLeftButton Then
        lNewTop = pctResizeUpDwn.Top
        If lNewTop < (ScaleHeight - 100) Then
            MiddleBarPercent = lNewTop / pctmonTest.ScaleHeight
            pctmonTest_Resize
        End If
        pctResizeUpDwn.Visible = False               '// Hide the resizing bar
    End If

End Sub

Private Sub pctmonTest_GotFocus()
    pctRead.SetFocus
End Sub

