Attribute VB_Name = "frmEditFilter"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public FiltersToEdit As cFilters
Public obApp As cicsSpy
Public DonotShowExcluded As Boolean

Public Sub SetupUI()
    Set filterUI1.obApp = obApp
    Set filterUI1.Filters = FiltersToEdit
    filterUI1.DonotShowExcluded = DonotShowExcluded
    filterUI1.SetupUI
    Form_Resize
End Sub

Private Sub CmdCancel_Click()
    Unload Me
End Sub

'// Save the UI
Private Sub CmdOk_Click()
    filterUI1.SaveUI
    Call FiltersToEdit.CompileFilterIndexes(obApp.IncomingMessages)  '// setup the indexes
    obApp.App.SaveNeeded = True
    Unload Me
End Sub

Private Sub Form_Resize()
    Dim lNewHeight As Long
    lNewHeight = ScaleHeight - pctBottom.Height
    If lNewHeight > 0 Then
        filterUI1.Move 0, 0, ScaleWidth, lNewHeight
    End If
End Sub

Private Sub pctBottom_Resize()
    Dim lnewleft As Long
    lnewleft = pctBottom.ScaleWidth - pctButtons.Width
    If lnewleft > 0 Then
        pctButtons.Move lnewleft
    End If
End Sub
