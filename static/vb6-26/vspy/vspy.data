Attribute VB_Name = "frmSelectItem"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public OkPressed As Boolean
Public ItemDescriptions As Variant
Public SelectedItem As Long
Public LeftPosition As Long


Private Sub CmdCancel_Click()
    Me.Hide
End Sub

Private Sub CmdOk_Click()
    SelectedItem = lstItems.ListIndex + 1
    OkPressed = True
    Me.Hide
End Sub


Private Sub Form_Load()
    
    Dim lCount As Long
    Dim lNumItems As Long
    
    Me.Left = LeftPosition
    
    OkPressed = False


    

    lNumItems = UBound(ItemDescriptions)
    For lCount = 1 To lNumItems
        lstItems.AddItem ItemDescriptions(lCount)
    Next lCount
    
    If lstItems.ListCount >= SelectedItem Then
        lstItems.ListIndex = SelectedItem - 1
    End If
    
End Sub

