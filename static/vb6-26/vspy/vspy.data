Attribute VB_Name = "frmBitwise"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

'// These properties setup this form
Public MaximumNumberOfBits As Long             '//
Public HasBitDescriptions As Boolean
Public BitDescriptions As Variant
Public obApp As cicsSpy
Public sIncomingMessageKey As String    '// key  of the incoming message we are editing
Public lDataByteIndex As Long
Public IsStatusByte As Boolean


Public Sub SetupUI()
    
    Dim lCount As Long
    Dim sBitField As String
    Dim sBit As String
    Dim lNum As Long
    
    
    '//
    If HasBitDescriptions Then
        For lCount = 0 To MaximumNumberOfBits
            lstTrue.AddItem "B" & lCount & ": " & BitDescriptions(lCount)
            lstFalse.AddItem "B" & lCount & ": " & BitDescriptions(lCount)
        Next lCount
    Else
        For lCount = 0 To MaximumNumberOfBits
            lstTrue.AddItem "Bit " & lCount
            lstFalse.AddItem "Bit " & lCount
        Next lCount
    End If
    
    '// Decode the bit string
    If IsStatusByte Then
        sBitField = obApp.IncomingMessages(sIncomingMessageKey).Status
    Else
        sBitField = obApp.IncomingMessages(sIncomingMessageKey).DataByteString(lDataByteIndex)
    End If
    
    '// First let's check if there is an exist status byte
    If Len(sBitField) = MaximumNumberOfBits + 3 Then
        '// Load the list boxes
        For lCount = 3 To MaximumNumberOfBits + 3
            lNum = MaximumNumberOfBits - lCount + 3
            sBit = Mid$(sBitField, lCount, 1)
            Select Case sBit
                Case "1"
                    lstTrue.Selected(lNum) = True
                Case "0"
                    lstFalse.Selected(lNum) = True
            End Select
        Next lCount
    End If
    
        
    
End Sub

Private Sub cmdCancel_Click()
    Unload Me
End Sub

Private Sub cmdOk_Click()   '// save the changes
    
    Dim lCount As Long
    Dim sBitString As String
    Dim sTempBit As String
    
    For lCount = MaximumNumberOfBits To 0 Step -1
        
        sTempBit = "X"  '// Default to X
        
        '// Is it a true bit
        If lstTrue.Selected(lCount) Then
            sTempBit = "1"
        End If
        
        '// Is it a false bit
        If lstFalse.Selected(lCount) Then
            sTempBit = "0"
        End If
        
        '// Concatenate the bit
        sBitString = sBitString & sTempBit
    
    Next lCount
    
    '// Store the result
    
    
    If IsStatusByte Then
        obApp.IncomingMessages(sIncomingMessageKey).Status = "#b" & sBitString
    Else
        obApp.IncomingMessages(sIncomingMessageKey).DataByteString(lDataByteIndex) = "#b" & sBitString
    End If
    
    obApp.App.SaveNeeded = True
    
    '// unload the form
    Unload Me
    
End Sub


Private Sub Form_Load()
    Caption = LoadResString(154)
    lblBitsMustBe = LoadResString(155)
    lblLeastCaption = LoadResString(159)
    CmdOk.Caption = LoadResString(158)
    SSTab1.TabCaption(0) = LoadResString(156)
    SSTab1.TabCaption(1) = LoadResString(157)
End Sub

Private Sub lstFalse_ItemCheck(Item As Integer)
    If lstFalse.Selected(Item) Then
        lstTrue.Selected(Item) = False
    End If
End Sub
Private Sub lstTrue_ItemCheck(Item As Integer)
    If lstTrue.Selected(Item) Then
        lstFalse.Selected(Item) = False
    End If
End Sub
