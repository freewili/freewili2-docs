'// call back function prototype
'typedef  NCTYPE_STATE (_NCFUNC_ * NCTYPE_NOTIFY_CALLBACK) (
'                                    NCTYPE_OBJH       ObjHandle,
'                                    NCTYPE_STATE      State,
'                                    NCTYPE_STATUS     Status,
'                                    NCTYPE_ANY_P      RefData);

'/* Type for ncWrite of CAN Network Interface Object */
'typedef  struct {
'   NCTYPE_CAN_ARBID                    ArbitrationId;
'   NCTYPE_BOOL                         IsRemote;
'   NCTYPE_UINT8                        DataLength;
'   NCTYPE_UINT8                        Data[8];
'} NCTYPE_CAN_FRAME;

Private Type ncTypeCanFrame
    ArbitrationID As Long
    IsRemote As Byte
    DataLength As Byte
    data(1 To 8) As Byte
End Type



' /* Type for ncRead of CAN Network Interface Object */
'typedef  struct {
'   NCTYPE_ABS_TIME                     Timestamp;
'   NCTYPE_CAN_ARBID                    ArbitrationId;
'   NCTYPE_BOOL                         IsRemote;
'   NCTYPE_UINT8                        DataLength;
'   NCTYPE_UINT8                        Data[8];
'} NCTYPE_CAN_FRAME_TIMED;
Private Type SixtyFourBitInteger
    MSL As Long
    LSL As Long
End Type
    
Private Type ncTypeCanFrameTimed
    TimeStamp As SixtyFourBitInteger
    ArbitrationID As Long
    IsRemote As Byte
    DataLength As Byte
    data(1 To 8) As Byte
End Type

Public Event FrameRecieved(Frame As Variant)


'   /* Type for ncWrite of CAN Object */
'typedef  struct {
'   NCTYPE_UINT8                        Data[8];
'} NCTYPE_CAN_DATA;
Private Type ncTypeCanData
    data(1 To 8) As Byte
End Type

'   /* Type for ncRead of CAN Object */
'typedef  struct {
'   NCTYPE_ABS_TIME                     Timestamp;
'   NCTYPE_UINT8                        Data[8];
'} NCTYPE_CAN_DATA_TIMED;
Private Type ncTypeCanDataTimed
    TimeStamp As SixtyFourBitInteger
    data(1 To 8) As Byte
End Type

'// Constants which define baud rates
Private Const NC_BAUD_10K = 10000
Private Const NC_BAUD_100K = 100000
Private Const NC_BAUD_125K = 125000
Private Const NC_BAUD_250K = 250000
Private Const NC_BAUD_500K = 500000
Private Const NC_BAUD_1000K = 1000000

'/* NCTYPE_STATE (bit masks for states) */
Private Const NC_ST_READ_AVAIL = &H1
Private Const NC_ST_WRITE_SUCCESS = &H2
Private Const NC_ST_STOPPED = &H4
Private Const NC_ST_ERROR = &H10
Private Const NC_ST_WARNING = &H20

'// CAN mask attributes
Private Const NC_CAN_MASK_STD_MUSTMATCH = &H7FF
Private Const NC_CAN_MASK_XTD_MUSTMATCH = &H1FFFFFFF
Private Const NC_CAN_MASK_STD_DONTCARE = 0
Private Const NC_CAN_MASK_XTD_DONTCARE = 0

'   /* NCTYPE_STATUS (values for code field)
'      This is the primary warning/error code referenced in NI-CAN
'      documentation.  Even though these codes may be used as warnings,
'      they all use the prefix NC_ERR_.
'   */
Private Const NC_ERR_TIMEOUT = &H1                      '  /* timeout */
Private Const NC_ERR_DRIVER = &H2                       ' /* driver specific err */
Private Const NC_ERR_BAD_NAME = &H3                     ' /* bad object name */
Private Const NC_ERR_BAD_PARAM = &H4                    ' /* bad parameter */
Private Const NC_ERR_BAD_VALUE = &H5                    '  /* bad (attr) value */
Private Const NC_ERR_ALREADY_OPEN = &H6                 '  /* object already open */
Private Const NC_ERR_NOT_STOPPED = &H7                  ' /* can't set if started */
Private Const NC_ERR_OVERFLOW = &H8                     '  /* data lost on overflow */
Private Const NC_ERR_OLD_DATA = &H9                      ' /* data was already read */
Private Const NC_ERR_NOT_SUPPORTED = &HA                '  /* not supported */
Private Const NC_ERR_CAN_BUS_OFF = &H101                '  /* CAN comm err/warn */


'   /* NCTYPE_STATUS (values for qualifer field)
'   */
'         /* For NC_ERR_CAN_BUS_OFF, the qualifier field indicates the most
'            most recent communications error detected on the CAN bus.  */
Private Const NC_QUAL_CAN_STUFF = &H10000                '  /* stuff error */
Private Const NC_QUAL_CAN_FORM = &H20000                 '  /* form error */
Private Const NC_QUAL_CAN_ACK = &H30000                  ' /* ack error */
Private Const NC_QUAL_CAN_BIT1 = &H40000                 '  /* bit 1 error */
Private Const NC_QUAL_CAN_BIT0 = &H50000                 '  /* bit 0 error */
Private Const NC_QUAL_CAN_CRC = &H60000                  '  /* CRC checksum error */

'         /* For NC_ERR_TIMEOUT, the qualifier indicates the location
'            where the timeout occurred.  */
Private Const NC_QUAL_TIMO_FUNCTION = &H0                 '/* wait/notif timeout */
Private Const NC_QUAL_TIMO_WATCHDOG = &H10000             '/* watchdog timeout */

'         /* For NC_ERR_OVERFLOW, the qualifier indicates the location
'            where the overflow occurred.  */
Private Const NC_QUAL_OVFL_WRITE = &H0                    '/* write q (ncWrite) */
Private Const NC_QUAL_OVFL_READ = &H10000                 ' /* read q (background) */
Private Const NC_QUAL_OVFL_CHIP = &H20000                 '/* CAN comm chip */

Private Const NC_QUAL_NONE = &H0                          '/* no qualifier */

 Private Const NC_ATTR_STATE = &H80000009

'   /* Special values for background read/write data
'   sizes (NC_ATTR_BKD_READ_SIZE and NC_ATTR_BKD_WRITE_SIZE).
'   These values are used to indicate a Data Frame with zero
'   data bytes (whereas zero indicates no Data Frame at all).  */
Private Const NC_BKD_CAN_ZERO_SIZE = &H8000



'// action constants
Private Const NC_OP_RESET = &H80000003
Private Const NC_OP_START = &H80000001
Private Const NC_OP_STOP = &H80000002

Private Const NC_ATTR_STATUS = &H8000000A

Public ObjectName As String
Private pOb As Long
Private mPortOpen As Boolean
Public WithEvents tmrPoll As Timer
Attribute tmrPoll.VB_VarHelpID = -1


Public Property Get PortOpen() As Boolean
    PortOpen = mPortOpen
End Property

Public Property Let PortOpen(bNewValue As Boolean)
    
    Dim lNIError As Long
    
    If bNewValue Then
        If Not mPortOpen Then
            '// open the port
            lNIError = ncOpenObject(ObjectName, pOb)
            If lNIError = 0 Then
                mPortOpen = True
                'Debug.Print "Object opened successfully"
                ResetObject
                StartObject
            Else
                mPortOpen = False
                Debug.Print "Error in NICAN::PortOpen (Open object)--> " & ReturnErrorStringForErrorNumber(lNIError)
                Err.Raise ERR_OPENING_PORT_NUM, , ERR_OPENING_PORT_DESCRIPTION
                'Debug.Print "Error opening object"
            End If
        Else
            '// This port is already open
        End If
    Else
        If mPortOpen Then
            '// close the port
            
            lNIError = ncCloseObject(pOb)
            If lNIError = 0 Then
                mPortOpen = False
                'Debug.Print "Object closed successfully"
            Else
                Debug.Print "Error in NICAN::PortOpen (CLose object)--> " & ReturnErrorStringForErrorNumber(lNIError)
                Err.Raise ERR_CLOSING_PORT_NUM, , ERR_CLOSING_PORT_DESCRIPTION
                'Debug.Print "Error closing object"
            End If

        Else
            '// we are already closed
        End If

    End If
    
End Property


Public Function ResetObject() As Boolean
    Dim lNIError As Long
    
    lNIError = ncAction(pOb, NC_OP_RESET, 0)
    If lNIError <> 0 Then
        Debug.Print "Error in NICAN::ResetObject--> " & ReturnErrorStringForErrorNumber(lNIError)
        ResetObject = False
    Else
        ResetObject = True
    End If
    
End Function

Public Function StopObject() As Boolean
    Dim lNIError As Long
    
    lNIError = ncAction(pOb, NC_OP_STOP, 0)
    If lNIError <> 0 Then
        Debug.Print "Error in NICAN::StopObject--> " & ReturnErrorStringForErrorNumber(lNIError)
        StopObject = False
    Else
        StopObject = True
    End If
    
End Function

Public Function StartObject() As Boolean
    Dim lNIError As Long
    
    lNIError = ncAction(pOb, NC_OP_START, 0)
    If lNIError <> 0 Then
        Debug.Print "Error in NICAN::StartObject--> " & ReturnErrorStringForErrorNumber(lNIError)
        StartObject = False
    Else
        StartObject = True
    End If
    
End Function

Friend Function TransmitMessage(msg As icsSpyMessage) As Boolean

Dim frm As ncTypeCanFrame
Dim lNIError As Long
Dim lCount As Long

'// Transfer the data from the spy message to the CAN message
frm.ArbitrationID = msg.ArbIDOrHeader
frm.DataLength = msg.NumberBytesData

If (msg.StatusBitField And icsSpyStatusRemoteFrame) > 0 Then
    frm.IsRemote = 1
Else
    frm.IsRemote = 0
End If

For lCount = 1 To frm.DataLength
    frm.data(lCount) = msg.data(lCount)
Next lCount


lNIError = ncWrite(pOb, Len(frm), frm)
If lNIError <> 0 Then
    Debug.Print "Error in NICAN::TransmitMessage--> " & ReturnErrorStringForErrorNumber(lNIError)
    TransmitMessage = False
Else
    TransmitMessage = True
End If

End Function

'//
'// This function returns what data is availiable at the can port
Public Function IsDataAvailiable() As Boolean
    Dim lNIError As Long
    Dim IsAvailable As Long
    
    lNIError = ncGetAttribute(pOb, NC_ATTR_STATE, Len(IsAvailable), IsAvailable)
    
    If lNIError <> 0 Then
        Debug.Print "Error in NICAN::IsDataAvailiable--> " & ReturnErrorStringForErrorNumber(lNIError)
        IsDataAvailiable = False
    Else
        '// check the data available flag
        If (NC_ST_READ_AVAIL And IsAvailable) > 0 Then
            IsDataAvailiable = True
        Else
            IsDataAvailiable = False
        End If
        
        '// check the data available flag
        If (NC_ST_READ_AVAIL And IsAvailable) > 0 Then
            IsDataAvailiable = True
        Else
            IsDataAvailiable = False
        End If
        
    End If
        
    'Debug.Print "Data id " & IsAvailable
    
    
    
End Function

'//
'// This function checks the status of the CAN port and reads the data from it
Public Function ReadCANPort() As Boolean

Dim frm As ncTypeCanFrameTimed
Dim lNIError As Long
Dim msg As icsSpyMessage
Dim bData() As Byte
Dim lCount As Long
Dim State As Long



'// read the status

lNIError = ncGetAttribute(pOb, NC_ATTR_STATE, Len(State), State)
If lNIError <> 0 Then
    Debug.Print "Error in NICAN::ReadCANPort (Check State)--> " & ReturnErrorStringForErrorNumber(lNIError)
    ReadCANPort = False
Else
    If (NC_ST_ERROR And State) > 0 Then
        '// there was an error
        Debug.Print "Error!!!"
        CheckErrorStatus
        SendErrorMessage
    End If

    If (NC_ST_STOPPED And State) > 0 Then
        '// there was an error
        Debug.Print "Stopped!!!"
        CheckErrorStatus
        SendErrorMessage
    End If

    If (NC_ST_WARNING And State) > 0 Then
        '// there was an error
        Debug.Print "Warning!!!"
        CheckErrorStatus
        SendErrorMessage
    End If
End If

'// read the data
Do While IsDataAvailiable
    'read the port
    lNIError = ncRead(pOb, Len(frm), frm)
    
    If lNIError <> 0 Then
        ReadCANPort = False
        Debug.Print "Error in NICAN::ReadCANPort--> " & ReturnErrorStringForErrorNumber(lNIError)
        Exit Function
    Else
        'bData = frm
        '// copy the data collected into the icsspy data structure
        
        msg.ArbIDOrHeader = frm.ArbitrationID
        msg.NumberBytesHeader = 4
        msg.NumberBytesData = frm.DataLength
        msg.TimeSystem = timeGetTime
        msg.StatusBitField = icsSpyStatusNetworkMessageType + icsSpyStatusIsCanType
        For lCount = 1 To 8
            msg.data(lCount) = frm.data(lCount)
        Next lCount

        Call CopySpyMessageToByteArray(msg, bData)
        RaiseEvent FrameRecieved(bData)
        'Debug.Print "ArbID " & frm.ArbitrationId & "  Len Data: " & frm.DataLength
    End If
Loop

'// return passed
ReadCANPort = True

End Function

Private Function SendErrorMessage()
    Dim msg As icsSpyMessage
    Dim bData() As Byte
    msg.TimeSystem = timeGetTime
    msg.StatusBitField = icsSpyStatusGlobalError + icsSpyStatusNetworkMessageType + icsSpyStatusIsCanType
    Call CopySpyMessageToByteArray(msg, bData)
    RaiseEvent FrameRecieved(bData)
End Function


Private Sub Class_Initialize()
    ObjectName = "CAN0"
End Sub

Private Sub Class_Terminate()
    PortOpen = False    '// close the port when closed
End Sub

Private Sub tmrPoll_Timer()
    ReadCANPort '// read the port and generate events
End Sub

Private Function CheckErrorStatus() As Boolean
    Dim lStatus As Long
    Dim lNIError As Long
    
    '// read the status of the CAN object
    lNIError = ncGetAttribute(pOb, NC_ATTR_STATUS, Len(lStatus), lStatus)
    If lNIError <> 0 Then
        Debug.Print "Error in NICAN::CheckErrorStatus--> " & ReturnErrorStringForErrorNumber(lNIError)
        Exit Function
    End If
    
    Debug.Print "Status: " & ReturnErrorStringForErrorNumber(lStatus)
    
    '// return success
    CheckErrorStatus = True
End Function
Public Function ReturnErrorStringForErrorNumber(lError As Long) As String
    Dim sReport As String
    Dim lErrorMask As Long
    Dim lQualifier As Long
    Dim lTemp As Long
    
    
    lErrorMask = lError And 32767
    lTemp = &H3FFF0000
    lQualifier = (lError And lTemp) \ 2 ^ 16
    
    Select Case lErrorMask
        Case NC_ERR_TIMEOUT     '  /* timeout */
            sReport = "There was a time out"
        Case NC_ERR_DRIVER          '  /* driver specific err */
            sReport = "There was a driver specific error"
        Case NC_ERR_BAD_NAME     ' /* bad object name */
            sReport = "This was a bad object name"
        Case NC_ERR_BAD_PARAM    ' /* bad parameter */
            sReport = "This is a bad parameter"
        Case NC_ERR_BAD_VALUE    '  /* bad (attr) value */
            sReport = "This was a bad attribute value"
        Case NC_ERR_ALREADY_OPEN   '  /* object already open */
            sReport = "This object is already open."
        Case NC_ERR_NOT_STOPPED ' /* can't set if started */
            sReport = "Can't set this if already started."
        Case NC_ERR_OVERFLOW '  /* data lost on overflow */
            sReport = "There was data lost on overflow"
        Case NC_ERR_OLD_DATA ' /* data was already read */
            sReport = "This data was already read"
        Case NC_ERR_NOT_SUPPORTED = &HA                '  /* not supported */
            sReport = "This is not supported"
        Case NC_ERR_CAN_BUS_OFF                '  /* CAN comm err/warn */
            sReport = "CAN communication error or warning"
        Case Else
            sReport = "Undefined NICAN error: " & lError
    End Select
    
    '// return the error report
    ReturnErrorStringForErrorNumber = sReport
    
End Function

VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cPlaceData"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit


Private Declare Function OpenTheClipBoard Lib "user32" Alias "OpenClipboard" (ByVal hwnd As Long) As Long
Private Declare Function SetClipBoardData Lib "user32" Alias "SetClipboardData" _
                            (ByVal wFormat As Long, ByVal hMem As Long) As Long
Private Declare Function RegisterClipboardFormatA Lib "user32" _
                    (ByVal lpString As String) As Long
Private Declare Function CloseClipboard Lib "user32" () As Long
Private Declare Function GlobalAlloc Lib "kernel32" (ByVal wFlags As Long, _
                                        ByVal dwBytes As Long) As Long

Private Declare Function GlobalLock Lib "kernel32" (ByVal hMem As Long) As Long
Private Declare Function GlobalUnlock Lib "kernel32" (ByVal hMem As Long) As Long
Private Declare Function GlobalFree Lib "kernel32" (ByVal hMem As Long) As Long
Private Declare Sub CopyToBoard Lib "apigid32.dll" Alias "agCopyData" (Source As Any, ByVal dest As Any, ByVal nCount&)
Private Declare Sub CopyFromBoard Lib "apigid32.dll" Alias "agCopyData" (ByVal Source As Any, dest As Any, ByVal nCount&)
Private Declare Function GlobalSize Lib "kernel32" (ByVal hMem As Long) As Long

Private Declare Function EmptyClipboard Lib "user32" () As Long

Private Const GMEM_DDESHARE = &H2000

Private Declare Function GetLastError Lib "kernel32" () As Long


Private Declare Function GetClipboardFormatName Lib "user32" Alias _
    "GetClipboardFormatNameA" (ByVal wFormat As Long, ByVal lpString As String, _
                                ByVal nMaxCount As Long) As Long

Private Declare Function GetClipboardData Lib "user32" _
                                (ByVal wFormat As Long) As Long

Private Declare Function IsClipboardFormatAvailable Lib "user32" (ByVal wFormat As Long) As Long

'// Private members
Private cFormat As Long     '// Holds the ID of the registered format

Public Sub Clear()
    Dim lResult As Long
    lResult = EmptyClipboard
End Sub

Public Property Get IsThereData() As Boolean
    IsThereData = IsClipboardFormatAvailable(cFormat)
End Property

Public Function PlaceDataOnClipBoard(hwnd As Long, data() As Byte) As Boolean
    
    Dim hData As Long
    Dim hBData As Long
    Dim numBytes As Long
    Dim lResult As Long
    
    '// Open the clipboard
    OpenTheClipBoard (hwnd)
    
    numBytes = UBound(data)
    hData = GlobalAlloc(GMEM_DDESHARE, numBytes)    '// Create Global Memory
    hBData = GlobalLock(hData)                      '// lock it
    Call CopyToBoard(data(0), hBData, numBytes)         '// Copy it
    lResult = GlobalUnlock(hData)                       '// unlock
    lResult = GetLastError
    lResult = SetClipBoardData(cFormat, hData)           '// Place it on the clipboard
    Call CloseClipboard
    
    PlaceDataOnClipBoard = True
    
End Function

Public Function GetDataFromClipBoard(hwnd As Long, data() As Byte) As Boolean
    
    Dim IsThere As Boolean
    Dim hBData As Long
    
    Dim hData As Long
    Dim lResult As Long
    Dim lSize As Long
    
    '// Determine the number of bytes for this data
    
    
    '// Open the clip board
    lResult = OpenTheClipBoard(hwnd)
    
    '//
    IsThere = IsClipboardFormatAvailable(cFormat)
    
    If IsThere Then
        hData = GetClipboardData(cFormat)
        If hData <> &O0 Then
            lSize = GlobalSize(hData)
            ReDim data(lSize)
            If lSize <> 0 Then
                hBData = GlobalLock(hData)                      '// lock it
                Call CopyFromBoard(hBData, data(0), lSize)      '// Copy it
                lResult = GlobalUnlock(hData)                       '// unlock it
                If lResult = 0 Then GetDataFromClipBoard = True
            End If
        End If
    Else
        'MsgBox "There is no data"
    End If
    
    Call CloseClipboard
    
End Function

Public Sub RegisterFormat(sFormat As String)
    '// get a format number for this format
    cFormat = RegisterClipboardFormatA(sFormat)
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cSpyAnalyses"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Attribute VB_Ext_KEY = "Collection" ,"cAnalysis"
Attribute VB_Ext_KEY = "Member0" ,"cAnalysis"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'local variable to hold collection
Private mCol As Collection
Public Function Add(Optional sKey As String) As cSpyAnalysis
    'create a new object
    Dim objNewMember As cSpyAnalysis
    Set objNewMember = New cSpyAnalysis

    If Len(sKey) = 0 Then
        mCol.Add objNewMember
    Else
        mCol.Add objNewMember, sKey
    End If


    'return the object created
    Set Add = objNewMember
    Set objNewMember = Nothing


End Function

Public Property Get Item(vntIndexKey As Variant) As cSpyAnalysis
Attribute Item.VB_UserMemId = 0
    'used when referencing an element in the collection
    'vntIndexKey contains either the Index or Key to the collection,
    'this is why it is declared as a Variant
    'Syntax: Set foo = x.Item(xyz) or Set foo = x.Item(5)
  Set Item = mCol(vntIndexKey)
End Property



Public Property Get Count() As Long
    'used when retrieving the number of elements in the
    'collection. Syntax: Debug.Print x.Count
    Count = mCol.Count
End Property


Public Sub Remove(vntIndexKey As Variant)
    'used when removing an element from the collection
    'vntIndexKey contains either the Index or Key, which is why
    'it is declared as a Variant
    'Syntax: x.Remove(xyz)


    mCol.Remove vntIndexKey
End Sub


Public Property Get NewEnum() As IUnknown
Attribute NewEnum.VB_UserMemId = -4
Attribute NewEnum.VB_MemberFlags = "40"
    'this property allows you to enumerate
    'this collection with the For...Each syntax
    Set NewEnum = mCol.[_NewEnum]
End Property


Private Sub Class_Initialize()
    'creates the collection when this class is created
    Set mCol = New Collection
End Sub


Private Sub Class_Terminate()
    'destroys collection when this class is terminated
    Set mCol = Nothing
End Sub

Public Sub RemoveAll()                          '// removes all the items from this collection
    Call CollectionRemoveAll(mCol)
End Sub



Friend Sub SetEqualTo(ob As cSpyAnalyses)
Dim lCount As Long
Dim lNumItems As Long
Dim obAnalysis As cSpyAnalysis

'// How many analyses are there?
lNumItems = ob.Count
RemoveAll
For lCount = 1 To lNumItems
    Set obAnalysis = Add    '// add this to our collection
    Call obAnalysis.SetEqualTo(ob(lCount))
Next lCount

End Sub

VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cSpyAnalysis"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'// This class holds the analysis code for messages

'// This is it
Public Filters As New cFilters
Public Filters2 As New cFilters
Public AnalysisType As icsVSPYAnalysisType
Public ResultLocationKey As String
Public FailedResult As Double
Public Description As String
Public Result As Double
Public AnalysisComplete As Boolean  '// flag that indicates that this analysis is complete
Public AnalysisString As String

Public LastErrorMessage As String

Public ParentTest As cTest          '// ref to the parent test object

Public Enum icsVSPYAnalysisType
    icsVSPYCountOfMessages
    icsVSPYTimeAllMessagesReceived
    icsVSPYTimeBetweenMessages
End Enum

Private Type MessageFound
    WasFound As Boolean
    FoundTime As SpyMsgTime
End Type

'// private members
Private TimeStartArray() As MessageFound
Private TimeStopArray() As MessageFound

Private FirstMessageDetected As Boolean
Private dFirstMessageTime As Double


Public Function Reset() As Boolean '// This is called when a test is restarted
    
    Result = 0                  '// you can cook while I stand looking
    AnalysisComplete = False    '// reset the analysis complete flag
    FirstMessageDetected = False
    
    '// check the first filter (common to all analysis types)
    If Not Filters.CompileFilterIndexes(ParentTest.Parent.IncomingMessages) Then
            '// There was a problem
            LastErrorMessage = "There was an reference to a message (in analysis " & Description & ") that has been deleted." & vbCrLf & vbCrLf & "The message reference was changed."
            Reset = False
            Exit Function
    End If
    
    Select Case AnalysisType
        Case icsVSPYCountOfMessages
            '// do nothing
        Case icsVSPYTimeAllMessagesReceived
            ReDim TimeStartArray(Filters.IncludedFiltersCount) '// setup the get array
            If Filters.IncludedFiltersCount = 0 Then
                '// There was a problem
                LastErrorMessage = "There are no messages selected in a wait for messages analysis. (in analysis " & Description & ") that has been deleted." & vbCrLf & vbCrLf & "This analysis is disabled."
                Reset = False
                Exit Function
            End If
        Case icsVSPYTimeBetweenMessages
            ReDim TimeStartArray(Filters.IncludedFiltersCount) '// setup the get array
            ReDim TimeStopArray(Filters2.IncludedFiltersCount) '// setup the get array
            If Filters.IncludedFiltersCount = 0 Or Filters2.IncludedFiltersCount = 0 Then
                '// There was a problem
                LastErrorMessage = "There are no messages selected in a wait" _
                        & "for messages analysis. (in analysis: " & Description & ")." _
                                            & vbCrLf & vbCrLf & "This analysis is disabled."
                AnalysisComplete = True
                Result = FailedResult
                Reset = False
                Exit Function
            End If
            
            '// Check the second filter
            If Not Filters2.CompileFilterIndexes(ParentTest.Parent.IncomingMessages) Then
                '// There was a problem
                LastErrorMessage = "There was an reference to a message (in analysis " & Description & ") that has been deleted." & vbCrLf & vbCrLf & "The message reference was changed."
                Reset = False
                Exit Function
            End If
    End Select
    
    Reset = True    '// Return a true

End Function


Friend Function AddMessage(lMsg As icsSpyMessageLong)
    
    Dim byteArray() As Byte
    Dim lNumItems As Long
    Dim lCount As Long
    Dim bAllComplete As Boolean
    Dim dTime As Double
    'Dim msg As icsSpyMessage
    Dim FoundTime As SpyMsgTime
    
    If AnalysisComplete Then Exit Function '// do nothing if we are complete
    
    Select Case AnalysisType
        
        Case icsVSPYCountOfMessages
            
            '////////////////////////////////////////////////////////////////////
            If Filters(ParentTest.Parent) Then
                Result = Result + 1     '// count these messages
            End If
            
        
        Case icsVSPYTimeAllMessagesReceived
            
            '// Pass it through the filters
            If Filters(ParentTest.Parent) Then
                lNumItems = UBound(TimeStartArray)  '// for each -item
                For lCount = 1 To lNumItems         '// cycle through all of the items
                    If Not TimeStartArray(lCount).WasFound Then
                        '// check this message
                        If ParentTest.Parent.IncomingMessagePassed(Filters.IncludedFiltersIndex(lCount)) Then
                            TimeStartArray(lCount).WasFound = True   '// set the found flag
                            '// record the found time...
                            FoundTime.HardwareTimePresent = (lMsg.StatusBitField And icsSpyStatusHardwareTimePresent) > 0
                            FoundTime.HardwareTimeMs = lMsg.TimeHardware
                            FoundTime.SystemTimeMs = lMsg.TimeSystem
                            dTime = GetSpyTimeSec(ParentTest.SpyMsgTime, FoundTime)
                            LSet TimeStartArray(lCount).FoundTime = FoundTime
                            Exit For '// don't check any more
                        End If
                    End If
                Next lCount

                '// Are we done?
                bAllComplete = True
                For lCount = 1 To lNumItems         '// cycle through all of the items
                    If Not TimeStartArray(lCount).WasFound Then
                        bAllComplete = False
                    End If
                Next lCount
            
                '// if ball complete is still true, this analysis is complete
                If bAllComplete Then
                    Result = dTime
                    ParentTest.Parent.IncomingMessages(ResultLocationKey).Value = Result
                    AnalysisString = SetupAnalysisString(Filters, TimeStartArray)
                    AnalysisComplete = True
                End If
            End If
            
        Case icsVSPYTimeBetweenMessages
            
            If Not FirstMessageDetected Then
                '// Pass it through the filters
                If Filters(ParentTest.Parent) Then
                    lNumItems = UBound(TimeStartArray)  '// for each item
                    For lCount = 1 To lNumItems         '// cycle through all of the items
                        If Not TimeStartArray(lCount).WasFound Then
                            '// check this message
                            If ParentTest.Parent.IncomingMessagePassed(Filters.IncludedFiltersIndex(lCount)) Then
                                TimeStartArray(lCount).WasFound = True   '// set the found flag
                                
                                FoundTime.HardwareTimePresent = (lMsg.StatusBitField And icsSpyStatusHardwareTimePresent) > 0
                                FoundTime.HardwareTimeMs = lMsg.TimeHardware
                                FoundTime.SystemTimeMs = lMsg.TimeSystem
                                dTime = GetSpyTimeSec(ParentTest.SpyMsgTime, FoundTime)
                                
                                '// transfer to the time start array
                                TimeStartArray(lCount).FoundTime = FoundTime

                                
                                Exit For '// don't check any more
                            End If
                        End If
                    Next lCount
    
                    '// Are we done?
                    bAllComplete = True
                    For lCount = 1 To lNumItems         '// cycle through all of the items
                        If Not TimeStartArray(lCount).WasFound Then
                            bAllComplete = False
                        End If
                    Next lCount
                
                    '// if ball complete is still true, this analysis is complete
                    If bAllComplete Then
                        dFirstMessageTime = dTime
                        FirstMessageDetected = True
                    End If
                End If
            Else
            
                    '// Pass it through the filters
                If Filters2(ParentTest.Parent) Then
                    lNumItems = UBound(TimeStopArray)  '// for each item
                    For lCount = 1 To lNumItems         '// cycle through all of the items
                        If Not TimeStopArray(lCount).WasFound Then
                            '// check this message
                            If ParentTest.Parent.IncomingMessagePassed(Filters2.IncludedFiltersIndex(lCount)) Then
                                TimeStopArray(lCount).WasFound = True   '// set the found flag
                                
                                FoundTime.HardwareTimePresent = (lMsg.StatusBitField And icsSpyStatusHardwareTimePresent) > 0
                                FoundTime.HardwareTimeMs = lMsg.TimeHardware
                                FoundTime.SystemTimeMs = lMsg.TimeSystem
                                dTime = GetSpyTimeSec(ParentTest.SpyMsgTime, FoundTime)
                                
                                '// transfer to the time start array
                                LSet TimeStopArray(lCount).FoundTime = FoundTime
                                
                                Exit For '// don't check any more
                            End If
                        End If
                    Next lCount
    
                    '// Are we done?
                    bAllComplete = True
                    For lCount = 1 To lNumItems         '// cycle through all of the items
                        If Not TimeStopArray(lCount).WasFound Then
                            bAllComplete = False
                        End If
                    Next lCount
                
                    '// if ballcomplete is still true, this analysis is complete
                    If bAllComplete Then
                        Result = dTime - dFirstMessageTime
                        ParentTest.Parent.IncomingMessages(ResultLocationKey).Value = Result
                        AnalysisString = ",Start Messages" & SetupAnalysisString(Filters, TimeStartArray) & ",Stop Messages" & SetupAnalysisString(Filters2, TimeStopArray)
                        AnalysisComplete = True
                    End If
                End If
            End If
    End Select
    
End Function

Friend Function PerformAnalysis() As Boolean
    Dim lNumMessages As Long
    Dim lMessageCount As Long

    Select Case AnalysisType
        Case icsVSPYCountOfMessages
            '// already done
            ParentTest.Parent.IncomingMessages(ResultLocationKey).Value = Result
        Case icsVSPYTimeAllMessagesReceived
            If Not AnalysisComplete Then
                Result = FailedResult
                ParentTest.Parent.IncomingMessages(ResultLocationKey).Value = Result
            End If
        Case icsVSPYTimeBetweenMessages
            If Not AnalysisComplete Then
                Result = FailedResult
                ParentTest.Parent.IncomingMessages(ResultLocationKey).Value = Result
            End If
    End Select

AnalysisComplete = True

End Function



Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage) As Boolean
    Dim lSpace As Long
    Dim dSpace As Double
    Dim sSpace As String
    Dim lJunk As Long
    
    
    With obSave
        obSave.ReadWriteLong AnalysisType
        '// DAVEEDIT 2/9/99 START
        'obSave.ReadWriteLong ResultLocation
        obSave.ReadWriteLong lJunk
        '// DAVEEDIT 2/9/99 STOP
        obSave.ReadWriteDouble FailedResult
        obSave.ReadWriteString Description
   
    
'    '.. new padding
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
     '// DAVEEDIT 2/9/99 START
    '.ReadWriteString sSpace
    .ReadWriteString ResultLocationKey
     '// DAVEEDIT 2/9/99 STop
     End With
    
    Call Filters.ReadWrite(bWriteDirection, obSave)
    Call Filters2.ReadWrite(bWriteDirection, obSave)
    
End Function


Friend Function SetEqualTo(ObToCopy As cSpyAnalysis)

    With ObToCopy
        Call Filters.SetEqualTo(.Filters)
        Call Filters2.SetEqualTo(.Filters2)
        AnalysisType = .AnalysisType
        ResultLocationKey = .ResultLocationKey
        FailedResult = .FailedResult
        Description = .Description
    End With

End Function

Private Function SetupAnalysisString(ObFilters As cFilters, MessageFoundArray() As MessageFound) As String
    Dim lNum As Long
    Dim lCount As Long
    Dim sString As String
    lNum = UBound(MessageFoundArray)
    For lCount = 1 To lNum
        sString = sString & ", " & _
        ParentTest.Parent.IncomingMessages(ObFilters.IncludedFiltersKey(lCount) _
            ).Description & " @ " & Format(GetSpyTimeSec(ParentTest.SpyMsgTime, MessageFoundArray(lCount).FoundTime), "0.000")
    Next lCount
    SetupAnalysisString = sString
    
End Function
