Attribute VB_Name = "cAnalogDisplay"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Option Explicit

Public Key As String

'// This identifies the analog value
Public DataID As Long
Public DataIDType As icsSpyUDDataType

'// Your frankly vulgar, red-pullover...
Public ParentUD As cUserDialog

'// Location
Public Top As Long
Public height As Long
Public Width As Long
Public Left As Long


Public Maximum As Double
Public Minimum As Double

Public Sub ShowPropertiesDialog()
    
    Dim RxNames As Variant
    
    RxNames = ParentUD.FireRXNamesEvent
        
    '// check rxnames, determine if it is empty or not
    
    If IsEmpty(RxNames) Then
        MsgBox "There are no incoming messages to assign to this display.", vbInformation
    Else
        
        '// Shows the properties dialog
        With frmSelectItemAndRange
            .ItemDescriptions = RxNames
            .SelectedItem = DataID
            .txtMaxParameter1 = Format$(Maximum)
            .txtMinParameter1 = Format$(Minimum)
            .Caption = "Select Message"
            .Show vbModal
            DataID = .SelectedItem
            Maximum = Val(.txtMaxParameter1)
            Minimum = Val(.txtMinParameter1)
        End With
    
        Unload frmSelectItem

    End If
    
End Sub

'// Read the size and position //////////////////////////
Friend Sub Update(ob As CWKnob)
If DataID <> 0 Then
'    If DataIDType = icsUDAnalogInput Then
'        ob.Value = AnalogInputs(DataID).CurrentValue
'    Else
'        ob.Value = AnalogOutputs(DataID)
'    End If
End If
End Sub

'// Read the size and position //////////////////////////
Public Sub ReadSizeAndPosition(ob As Variant)
    Top = ob.Top
    height = ob.height
    Width = ob.Width
    Left = ob.Left
End Sub
'////////////////////////////////////////////////////

Public Sub SetEqualTo(MasterOb As cAnalogDisplay)

'// Equalize all the properties
With MasterOb
    Key = .Key
    Top = .Top
    height = .height
    Width = .Width
    Left = .Left
    DataID = .DataID
    DataIDType = .DataIDType
    Maximum = .Maximum
    Minimum = .Minimum
End With
'//////////////////////////////

End Sub

Public Sub ReadWriteData(bWriteDirection As Boolean, obSave As Object)

    Dim vData As Variant
    Dim obPB As New PropertyBag
    Dim vDummy As Variant
    Dim vReturn As Variant
    
    If bWriteDirection Then
        
        '// first, write the properties into the bag
        With obPB
            .WriteProperty "Key", Key, ""
            .WriteProperty "Top", Top, 0
            .WriteProperty "Height", height, 0
            .WriteProperty "Left", Left, 0
            .WriteProperty "Width", Width, 0
            .WriteProperty "DataID", DataID, 0
            .WriteProperty "DataIDType", DataIDType, 0
            .WriteProperty "Maximum", Maximum, 0
            .WriteProperty "Minimum", Minimum, 0
        End With


        '// return the contents of the bag
        vData = obPB.Contents
        
        '// write the array with the binary storage object
        obSave.readwritearray vData
        
    Else
        '// read the array from the binary storage object
        obSave.readwritearray vDummy, vReturn
        
    
        '// fill the property bag if there is somethign in the return array
        If Not IsEmpty(vReturn) Then
            
            '// fill the property bag with the data
            obPB.Contents = vReturn
            
            '// read the data out of the property bag
            With obPB
                Key = .ReadProperty("Key", "")
                Top = .ReadProperty("Top", 0)
                height = .ReadProperty("Height", 0)
                Left = .ReadProperty("Left", 0)
                Width = .ReadProperty("Width", 0)
                DataID = .ReadProperty("DataID", 0)
                DataIDType = .ReadProperty("DataIDType", 0)
                Maximum = .ReadProperty("Maximum", 0)
                Minimum = .ReadProperty("Minimum", 0)
            End With
            
        End If
    End If
    

'//////////////////////////////


End Sub

Private Sub Class_Initialize()
    DataIDType = icsUDIncomingMessage
    DataID = 1
    Minimum = 0
    Maximum = 10000
End Sub
