Private Sub fAudioComment_AddComment(sComment As String)
    
    
    Call obApp.LogBook.AddAudioCommentToLog(obApp, sComment)
    
    If CurrentView = icsSpyNotesView Then
        wbNotes.Refresh
    End If
    
    '// Play the error wave file
    If obApp.UseEventSounds Then
        obApp.Speak "The comment was saved."
        'obApp.PlaySoundFile VB.App.Path & "\spycommentsaved.wav"
    End If
    
End Sub

Private Sub fAudioComment_RecordStart()
    '// turn off the voice
    obApp.VoiceRecEnabled = False
End Sub

Private Sub fAudioComment_RecordStop()
    '// turn back on the voice
    obApp.VoiceRecEnabled = True
End Sub

Private Sub fComment_AddComment(sComment As String)
    
    Call obApp.LogBook.AddTextCommentToLog(obApp, sComment)
    
    If CurrentView = icsSpyNotesView Then
        wbNotes.Refresh
    End If
    
    '// Play the error wave file
    obApp.PlaySoundFile VB.App.Path & "\spycommentsaved.wav"
End Sub

'// make sure the toolbar buttons behave properly
Private Sub Form_Activate()
    CurrentView = CurrentView
    If obApp.MonitorOn Then
        tb.Buttons("start").Value = tbrPressed
        tb.Buttons("stop").Value = tbrUnpressed
    Else
        tb.Buttons("start").Value = tbrUnpressed
        tb.Buttons("stop").Value = tbrPressed
    End If
End Sub
'//
Public Sub LicensedExpired()
    Dim obButton As Button
    Dim obTab As msComctlLib.Tab
    Dim bData() As Byte
    Dim lFileNum As Long
    
    CurrentView = icsSpyNotesView
    mnuFile.Enabled = False
    mnuEdit.Enabled = False
    mnuView.Enabled = False
    mnuRun.Enabled = False
    mnuToolsWizards.Enabled = False
    mnuSetupMonitor.Enabled = False
    
    Call obApp.CreateOrderForm(Me.hwnd, False, False)

    '// disable all toolbar buttons
    For Each obButton In frmMain.tb.Buttons
        obButton.Enabled = False
    Next obButton
    
    tbsTX.Enabled = False
    cmdMasterTx.Enabled = False
    
    '// create the license file
    bData = LoadResData(HTML_LICENSE_EXPIRED, "HTML")
    lFileNum = FreeFile
    Open App.Path & "\" & "spyExpired.htm" For Binary As #1
    Put #lFileNum, , bData
    Close #lFileNum
    
    wbNotes.Navigate App.Path & "\spyExpired.htm"
    

End Sub

