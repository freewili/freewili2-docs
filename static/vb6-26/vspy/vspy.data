Friend Sub TriggerSet()
    Dim bData(0 To 2) As Byte
    
    bData(0) = &H52
    bData(1) = &H44
    bData(2) = &H1
    mComm.Output = bData
    
End Sub

Friend Sub TriggerClear()
    
    Dim bData(0 To 2) As Byte
    
    bData(0) = &H52
    bData(1) = &H44
    bData(2) = &H0
    mComm.Output = bData
    
End Sub

Friend Sub SetupTrigger(stFilter As spyFilterJ1850)
    Dim bData() As Byte
    Dim lFilterLength As Long
    Dim lByteCount As Long
    

    TriggerClear    '// this clears the trigger
    
    '// determine the number of bytes in the filter
    If stFilter.ByteData(3) = 0 And stFilter.ByteDataMask(3) = 0 Then
        If stFilter.ByteData(2) = 0 And stFilter.ByteDataMask(2) = 0 Then
            If stFilter.ByteData(1) = 0 And stFilter.ByteDataMask(1) = 0 Then
                If stFilter.J1850Header(3) = 0 And stFilter.J1850HeaderMask(3) = 0 Then
                    If stFilter.J1850Header(2) = 0 And stFilter.J1850HeaderMask(2) = 0 Then
                        lFilterLength = 1
                    Else
                        lFilterLength = 2
                    End If
                Else
                    lFilterLength = 3
                End If
            Else
                lFilterLength = 4
            End If
        Else
            lFilterLength = 5
        End If
        
    Else
        lFilterLength = 6
    End If
    Debug.Print "Filter Length: " & lFilterLength
    
    
    
    '// Mask Bytes Command
    ReDim bData(0 To lFilterLength + 1)
    bData(0) = &H50 + lFilterLength + 1
    bData(1) = &H42
    For lByteCount = 1 To lFilterLength
        If lByteCount <= 3 Then
            bData(1 + lByteCount) = stFilter.J1850HeaderMask(lByteCount)
        Else
            bData(1 + lByteCount) = stFilter.ByteDataMask(lByteCount - 3)
        End If
    Next lByteCount
    '// send the mask
    mComm.Output = bData
    
    '// match bytes command
    ReDim bData(0 To lFilterLength + 1)
    bData(0) = &H50 + lFilterLength + 1
    bData(1) = &H43
    For lByteCount = 1 To lFilterLength
        If lByteCount <= 3 Then
            bData(1 + lByteCount) = stFilter.J1850Header(lByteCount)
        Else
            bData(1 + lByteCount) = stFilter.ByteData(lByteCount - 3)
        End If
    Next lByteCount
    '// send the mask
    mComm.Output = bData
    
    ReDim bData(0 To 2)
    '// enable the trigger
    bData(0) = &H52
    bData(1) = &H41
    bData(2) = &H1
    
    mComm.Output = bData
    
End Sub


Friend Property Set MsCommControl(newComm As MSComm)
    Set mComm = newComm
    mCommControlSet = True
End Property

Friend Property Get PortOpen() As Boolean
    PortOpen = mPortOpen
End Property

'// This property opens and closes the serial port
Friend Property Let PortOpen(bNew As Boolean)

If Not mCommControlSet Then
    Err.Raise vbObjectError + 100, , "The MSComm Control property was not set."
    Exit Property
End If

If bNew Then
    '// open the port if necessary
    If mPortOpen Then
        '// do nothing we are already open
        Debug.Print "warning: an attempt to open the port was made with it already being open " & Now
    Else
        '// Open the port
        With mComm
            .InBufferSize = 4096
            .DTREnable = False
            .RTSEnable = False
            .Settings = BaudRate & ",n,8,1"
            .InputMode = comInputModeBinary
            .Handshaking = comRTS
            .PortOpen = True
        End With
        mPortOpen = True
    End If
Else
    '// Close the port if necessary
    If mPortOpen Then
        '// close it
        mComm.PortOpen = False
        mPortOpen = False
    Else
        Debug.Print "warning: an attempt to close the port was made with it already being closed " & Now
    End If
End If

End Property



'// Throw away the serial port
Private Function ReadSerialPortPWM() As Boolean
    
    Dim lNumberOfBytes As Long
    Dim lCount As Long
    Dim sHexValues As String
    Dim lNumMessageBytes As Long
    Dim lMessageByteCount As Long
    Dim bNumBytesToFollow As Byte
    Dim lTotalBytes As Long
    Dim bCount As Long
    Dim lLastValidIndex As Long
    Dim ReadTime As Long
    Dim LastTime As Long
    Dim bHighNibble As Byte
    Dim lBadMessage As Long
    Dim bCommand As Byte
    Dim lCommandIndex As Long
    Dim lOldValidIndex As Long
    
    Dim stMsg As icsSpyMessageJ1850
    Dim stTxMsg As icsSpyMessageJ1850
    Dim bStatus As Byte
    
    lNumberOfBytes = 0
    
    '// Read the comm port
    If mComm.InBufferCount >= 1 Then
        bNewData() = mComm.Input
        ReadTime = timeGetTime
        lNumberOfBytes = UBound(bNewData) + 1 '// How many bytes were in the comm port
    Else
        Exit Function
    End If
    
    If lNumberOfBytes > 0 Then
        
        '// do we have new data
        lLastValidIndex = 1 '// initalize to 1
        lTotalBytes = lNumberOfBytes + lNumberOfBytesOld
        ReDim bDataUsed(lTotalBytes)
        For lCount = 1 To lNumberOfBytesOld
            bDataUsed(lCount) = bOldData(lCount)
        Next lCount
        bCount = 0
        For lCount = (lNumberOfBytesOld + 1) To lTotalBytes
            'frmdebug.txtDebug = frmdebug.txtDebug & Hex(bNewData(bCount)) & vbCrLf
            bDataUsed(lCount) = bNewData(bCount)
            bCount = bCount + 1
        Next lCount
        
        '// Look for the first char with a upper nibble of 0
        lCount = 0
        Do
            lCount = lCount + 1             '// increment the byte check count
            lCommandIndex = lCount
            bCommand = bDataUsed(lCommandIndex)    '// get the command byte
            
            bNumBytesToFollow = bCommand And &HF
            
            
            If (bNumBytesToFollow + lCount) > lTotalBytes Then
                lCount = lTotalBytes '// added 2/10/99
            Else
                '// Setup last index property
                lBadMessage = lCommandIndex + 1
                lCount = lCount + bNumBytesToFollow
                lOldValidIndex = lLastValidIndex
                lLastValidIndex = lCount + 1
                        
                '// if the lower nibble
                Select Case (bCommand And &HF0) '// clear the lower nibble
                    Case 0 '// valid packet received from the bus
                         stMsg.StatusBitField = icsSpyStatusNetworkMessageType
                         stMsg.DescriptionID = 0 '// reset descriptionid (may have been set by txing)

                         '// copy the message bytes into the message structure
                         If bNumBytesToFollow - 5 > 0 Then
                             '// there is larger than a 3 byte header
                             stMsg.NumberBytesData = bNumBytesToFollow - 5
                         Else
                             stMsg.NumberBytesData = 0
                         End If

                         If bNumBytesToFollow > 1 Then
                             If bNumBytesToFollow > 5 Then
                                 stMsg.NumberBytesHeader = 3
                             Else
                                 stMsg.NumberBytesHeader = bNumBytesToFollow - 2
                             End If
                         Else
                             stMsg.NumberBytesHeader = 0
                         End If

                         '// Copy the header bytes
                         For lMessageByteCount = 1 To stMsg.NumberBytesHeader
                             stMsg.Header(lMessageByteCount) = bDataUsed(lCommandIndex + lMessageByteCount + 1)
                         Next lMessageByteCount

                         '// Copy the data bytes
                         For lMessageByteCount = 1 To stMsg.NumberBytesData
                             stMsg.data(lMessageByteCount) = bDataUsed(lCommandIndex + lMessageByteCount + stMsg.NumberBytesHeader + 1)
                         Next lMessageByteCount

                        stMsg.TimeSystem = timeGetTime '// time stamp with system stamp
                        
                        '// set the message
                        lMessageCount = lMessageCount + 1
                        LSet m_stVSpyMessages(lMessageCount) = stMsg
                    
                    Case &HA0
                        
                        If TXFIFO.PopItem(stTxMsg) Then
                            LSet stMsg = stTxMsg
                        Else
                            TXFIFO.Init '// clear the fifo
                        End If
                        stMsg.StatusBitField = STATUS_TX_NO_ERR
                        stMsg.TimeSystem = timeGetTime '// time stamp with system stamp
                        
                        '// set the message
                        lMessageCount = lMessageCount + 1
                        LSet m_stVSpyMessages(lMessageCount) = stMsg
                        
                        
                    Case &H20
                        '// error message, error bytes follow
                        If bNumBytesToFollow >= 1 Then
                            Debug.Print "Error Message " & Hex(bDataUsed(lCommandIndex + 1))
                            stMsg.TimeSystem = ReadTime   '// set this messages read time
                            stMsg.NumberBytesData = 0
                            stMsg.NumberBytesHeader = 1
                            stMsg.Header(1) = bDataUsed(lCount)
                            If bDataUsed(lCommandIndex + 1) = &H17 Then
                                stMsg.StatusBitField = icsSpyStatusGlobalError + icsSpyStatusAVT_VSIRecOverflow
                            Else
                                stMsg.StatusBitField = icsSpyStatusGlobalError + icsSpyStatusErrUndefined
                            End If
                            lMessageCount = lMessageCount + 1
                            LSet m_stVSpyMessages(lMessageCount) = stMsg
                        End If
                    Case &H30
                        '// command message error bytes follow
                        Debug.Print "Command message error bytes follow"
                    Case &H40
                        '// match function info
                        Debug.Print "Match function info"
                    Case &H90
                        '// board status information
                        Debug.Print "Board status information"
                    Case &HB0
                        '// Real time clock status report
                        Debug.Print "Real time clock status report"
                    Case &HC0
                        '// 4x Mode Report
                        Debug.Print "4x Mode Report"
                    Case &HE0
                        '// Processor memory read
                        Debug.Print "Processor memory read"
                    Case Else
                        '// THIS IS ERROR data
                        stMsg.TimeSystem = ReadTime   '// set this messages read time
                        stMsg.NumberBytesData = 0
                        stMsg.NumberBytesHeader = 1
                        stMsg.Header(1) = bDataUsed(lCount)
                        stMsg.StatusBitField = icsSpyStatusGlobalError + icsSpyStatusErrUndefined
                        lMessageCount = lMessageCount + 1
                        LSet m_stVSpyMessages(lMessageCount) = stMsg
                        lCount = lBadMessage
                        lLastValidIndex = lOldValidIndex
                End Select
                
            End If
            
        Loop Until lCount >= lTotalBytes
        
        '// How many bytes do we have left over
        lNumberOfBytesOld = lTotalBytes - lLastValidIndex + 1
        If lNumberOfBytesOld > 0 Then
            ReDim bOldData(lNumberOfBytesOld)
            bCount = 0
            For lCount = lLastValidIndex To lTotalBytes
                bCount = bCount + 1
                bOldData(bCount) = bDataUsed(lCount)
            Next lCount
        End If
    
    End If
        
End Function

'// This function reads the serial port and parses out the messages
Private Function ReadSerialPortVPW() As Boolean
    
    Dim lNumberOfBytes As Long
    Dim lCount As Long
    Dim sHexValues As String
    Dim lNumMessageBytes As Long
    Dim lMessageByteCount As Long
    Dim bNumBytesToFollow As Byte
    Dim lTotalBytes As Long
    Dim bCount As Long
    Dim lLastValidIndex As Long
    Dim ReadTime As Long
    Dim LastTime As Long
    Dim bHighNibble As Byte
    Dim lBadMessage As Long
    Dim bCommand As Byte
    Dim lCommandIndex As Long
    Dim lOldValidIndex As Long
    
    Dim stMsg As icsSpyMessageJ1850
    Dim stTxMsg As icsSpyMessageJ1850
    Dim bStatus As Byte
    
    lNumberOfBytes = 0
    
    '// Read the comm port
    If mComm.InBufferCount >= 1 Then
        bNewData() = mComm.Input
        ReadTime = timeGetTime
        lNumberOfBytes = UBound(bNewData) + 1 '// How many bytes were in the comm port
    Else
        Exit Function
    End If
    
    If lNumberOfBytes > 0 Then
        
        '// do we have new data
        lLastValidIndex = 1 '// initalize to 1
        lTotalBytes = lNumberOfBytes + lNumberOfBytesOld
        ReDim bDataUsed(lTotalBytes)
        For lCount = 1 To lNumberOfBytesOld
            bDataUsed(lCount) = bOldData(lCount)
        Next lCount
        bCount = 0
        For lCount = (lNumberOfBytesOld + 1) To lTotalBytes
            bDataUsed(lCount) = bNewData(bCount)
            bCount = bCount + 1
        Next lCount
        
        '// Look for the first char with a upper nibble of 0
        lCount = 0
        Do
            lCount = lCount + 1             '// increment the byte check count
            lCommandIndex = lCount
            bCommand = bDataUsed(lCommandIndex)    '// get the command byte
            
            bNumBytesToFollow = bCommand And &HF
            If (bNumBytesToFollow + lCount) > lTotalBytes Then
                lCount = lTotalBytes '// added 2/10/99
            Else
                '// Setup last index property
                lBadMessage = lCommandIndex + 1
                lCount = lCount + bNumBytesToFollow
                lOldValidIndex = lLastValidIndex
                lLastValidIndex = lCount + 1
                        
                '// if the lower nibble
                Select Case (bCommand And &HF0) '// clear the lower nibble
                    Case 0 '// valid packet received from the bus
                        '// get the status byte
                        bStatus = bDataUsed(lCommandIndex + 1)
                        If bStatus = &H60 Then '// is this a tx message
                            If TXFIFO.PopItem(stTxMsg) Then
                                LSet stMsg = stTxMsg
                            Else
                                TXFIFO.Init '// clear the fifo
                            End If
                            stMsg.StatusBitField = STATUS_TX_NO_ERR
                        Else
                            
                            stMsg.StatusBitField = icsSpyStatusNetworkMessageType
                            stMsg.DescriptionID = 0 '// reset descriptionid (may have been set by txing)
                            
                            '// check for errors...
                            If bStatus <> 0 Then
                                TXFIFO.Init '// clear the fifo
                                stMsg.StatusBitField = stMsg.StatusBitField + icsSpyStatusGlobalError
                                bStatus = bDataUsed(lCommandIndex + 1)
                                If (bStatus And 2 ^ 0) > 0 Then '// CRC Error
                                    stMsg.StatusBitField = stMsg.StatusBitField + icsSpyStatusErrCRCError
                                End If
                                If (bStatus And 2 ^ 1) > 0 Then '// Incomplete Message
                                    stMsg.StatusBitField = stMsg.StatusBitField + icsSpyStatusErrIncompleteFrame
                                End If
                                If (bStatus And 2 ^ 2) > 0 Then '// Break Received
                                    stMsg.StatusBitField = stMsg.StatusBitField + icsSpyStatusBreak
                                End If
                                If (bStatus And 2 ^ 3) > 0 Then '// IFR Data
                                    stMsg.StatusBitField = stMsg.StatusBitField + icsSpyStatusIFRData
                                End If
                                If (bStatus And 2 ^ 4) > 0 Then '// Lost Arbitration
                                    stMsg.StatusBitField = stMsg.StatusBitField + icsSpyStatusErrLostArbitration
                                End If
                                If (bStatus And 2 ^ 7) > 0 Then '// Bad Message
                                    stMsg.StatusBitField = stMsg.StatusBitField + icsSpyStatusErrBadMessageBitTimeError
                                End If
                            End If
                                
                        
                            '// copy the message bytes into the message structure
                            If bNumBytesToFollow - 4 > 0 Then
                                '// there is larger than a 3 byte header
                                stMsg.NumberBytesData = bNumBytesToFollow - 4
                            Else
                                stMsg.NumberBytesData = 0
                            End If
                            
                            If bNumBytesToFollow > 1 Then
                                If bNumBytesToFollow > 4 Then
                                    stMsg.NumberBytesHeader = 3
                                Else
                                    stMsg.NumberBytesHeader = bNumBytesToFollow - 1
                                End If
                            Else
                                stMsg.NumberBytesHeader = 0
                            End If
                            
                            '// Copy the header bytes
                            For lMessageByteCount = 1 To stMsg.NumberBytesHeader
                                stMsg.Header(lMessageByteCount) = bDataUsed(lCommandIndex + lMessageByteCount + 1)
                            Next lMessageByteCount
                            
                            '// Copy the data bytes
                            For lMessageByteCount = 1 To stMsg.NumberBytesData
                                stMsg.data(lMessageByteCount) = bDataUsed(lCommandIndex + lMessageByteCount + stMsg.NumberBytesHeader + 1)
                            Next lMessageByteCount

                        End If
                        
                        
                        stMsg.TimeSystem = timeGetTime '// time stamp with system stamp
                        
                        '// set the message
                        lMessageCount = lMessageCount + 1
                        LSet m_stVSpyMessages(lMessageCount) = stMsg
                    
                        
                    Case &H20
                        '// error message, error bytes follow
                        If bNumBytesToFollow >= 1 Then
                            Debug.Print "Error Message " & Hex(bDataUsed(lCommandIndex + 1))
                            stMsg.TimeSystem = ReadTime   '// set this messages read time
                            stMsg.NumberBytesData = 0
                            stMsg.NumberBytesHeader = 1
                            stMsg.Header(1) = bDataUsed(lCount)
                            If bDataUsed(lCommandIndex + 1) = &H17 Then
                                stMsg.StatusBitField = icsSpyStatusGlobalError + icsSpyStatusAVT_VSIRecOverflow
                            Else
                                stMsg.StatusBitField = icsSpyStatusGlobalError + icsSpyStatusErrUndefined
                            End If
                            lMessageCount = lMessageCount + 1
                            LSet m_stVSpyMessages(lMessageCount) = stMsg
                        End If
                    Case &H60
                        '// trigger bytes
                    Case &H30
                        '// command message error bytes follow
                        Debug.Print "command message error bytes follow"
                    Case &H40
                        '// match function info
                        Debug.Print " match function info"
                    Case &H90
                        '// board status information
                        Debug.Print "board status information"
                    Case &HB0
                        '// Real time clock status report
                        Debug.Print "Real time clock status report"
                    Case &HC0
                        '// 4x Mode Report
                        Debug.Print "4x Mode Report"
                    Case &HE0
                        '// Processor memory read
                        Debug.Print "Processor memory read"
                    Case Else
                        '// THIS IS ERROR data
                        stMsg.TimeSystem = ReadTime   '// set this messages read time
                        stMsg.NumberBytesData = 0
                        stMsg.NumberBytesHeader = 1
                        stMsg.Header(1) = bDataUsed(lCount)
                        stMsg.StatusBitField = icsSpyStatusGlobalError + icsSpyStatusErrUndefined
                        lMessageCount = lMessageCount + 1
                        LSet m_stVSpyMessages(lMessageCount) = stMsg
                        lCount = lBadMessage
                        lLastValidIndex = lOldValidIndex
                End Select
                
            End If
            
        Loop Until lCount >= lTotalBytes
        
        '// How many bytes do we have left over
        lNumberOfBytesOld = lTotalBytes - lLastValidIndex + 1
        If lNumberOfBytesOld > 0 Then
            ReDim bOldData(lNumberOfBytesOld)
            bCount = 0
            For lCount = lLastValidIndex To lTotalBytes
                bCount = bCount + 1
                bOldData(bCount) = bDataUsed(lCount)
            Next lCount
        End If
    
    End If
        
End Function



Friend Function ResetHardware() As Boolean
    
    Dim lstarttime As Long
    Dim lWait As Long
    Dim bData() As Byte
    Dim bDataRead() As Byte
    Dim bDataTemp() As Byte
    Dim bFound As Boolean
    Dim lCount As Long
    Dim lBytesReadCount As Long
    Dim lBytesReadSize As Long
    Dim lBytesReadSizeRequired As Long
    Dim lIndexOfLastByteResponse As Long
    Dim bMsb As Byte
    Dim bLsb As Byte
    
    
    '// Transmit the reset command
    mComm.InBufferCount = 0 '// Clear the comm port receive buffer
    
    '// setup the protocole
    ReDim bData(0 To 1)
    
    '// first byte of protocol setup
    bData(0) = &HE1
    
    '// Setup the protocol (second byte)
    Select Case m_lProtocol
        Case icsavtProtocolCCD
            bData(1) = &H55
        Case icsavtProtocolALDL
            bData(1) = &HBB
        Case icsavtProtocolISO9141
            bData(1) = &HAA
        Case icsavtProtocolKeyword2000
            bData(1) = &HDD
        Case icsavtProtocolPWM
            bData(1) = &HCC
        Case icsavtProtocolVPW
            bData(1) = &O33
    End Select
    
    mComm.Output = bData '// Set protocol message
    
    '// send specific protocol information
    Select Case m_lProtocol
        Case icsavtProtocolISO9141
            '// set the baud rate
            Select Case m_lISOMode
                Case icsavtISOInitMode
                    '// set the default
                    ReDim bData(0 To 1)
                    bData(0) = &H61
                    bData(1) = &H2
                    mComm.Output = bData
                Case icsavtISOMonitorMode
                    Call CalculatedLoadValue(Me.ISOMonitorBaud, bMsb, bLsb)
                    '// set the defaul
                    ReDim bData(0 To 5)
                    '// command bytes
                    bData(0) = &H61
                    bData(1) = &H4
                    '// counter load bytes
                    bData(2) = &H53
                    bData(3) = &H2
                    bData(4) = bMsb
                    bData(5) = bLsb
                    mComm.Output = bData
            End Select
        Case icsavtProtocolKeyword2000
            '// set the init parameters
            Select Case m_lKWP2000Mode
                Case icsavtKWPMonitorMode
                    Call CalculatedLoadValue(Me.ISOMonitorBaud, bMsb, bLsb)
                    '// set the defaul
                    ReDim bData(0 To 5)
                    '// command bytes
                    bData(0) = &H61
                    bData(1) = &H4
                    '// counter load bytes
                    bData(2) = &H53
                    bData(3) = &H2
                    bData(4) = bMsb
                    bData(5) = bLsb
                    mComm.Output = bData
                Case icsavtKWPFiveBaudMode
                    '// set the default
                    ReDim bData(0 To 1)
                    bData(0) = &H61
                    bData(1) = &H12
                    mComm.Output = bData
                Case icsavtKWPFastInitMode
                    '// fast init message
                    
                Case icsavtKWPCARBMode
                    '// set the default
                    ReDim bData(0 To 1)
                    bData(0) = &H61
                    bData(1) = &H11
                    mComm.Output = bData
            End Select
        Case icsavtProtocolPWM
            Select Case m_lPWMMode
                Case icsavtDiagnosticMode
                    '// set the default
                    ReDim bData(0 To 3)
                    bData(0) = &H83
                    bData(1) = &H1
                    bData(2) = &H2
                    bData(3) = &H72
                    mComm.Output = bData
                Case icsavtMonitorMode
                    ReDim bData(0 To 3)
                    bData(0) = &H83
                    bData(1) = &H1
                    bData(2) = &H2
                    bData(3) = &H16
                    mComm.Output = bData
                Case icsavtNodeSimulationMode
                    '// setup the HBCC here
            End Select
    End Select
    
    '// send protocol and reset command
    ReDim bData(0 To 1)
    bData(0) = &H21
    bData(1) = &H4
    
    mComm.Output = bData '// Set the reset message
    
    '// size up the buffer
    ReDim bDataRead(1 To 100)
    lBytesReadSize = 100
    
    '// Wait for the response
    lstarttime = timeGetTime
    Do
        lWait = Abs(timeGetTime - lstarttime)
        bDataTemp = mComm.Input '// read the
        
        '// how many bytes is require for the read cache?
        lBytesReadSizeRequired = lBytesReadCount + UBound(bDataTemp) + 1
        
        '// resize the read cache if necessary
        If lBytesReadSizeRequired > lBytesReadSize Then
            ReDim Preserve bDataRead(1 To lBytesReadSizeRequired + 100)
            lBytesReadSize = lBytesReadSizeRequired + 100
        End If
        '// transfer the data to the read cache
        For lCount = 0 To UBound(bDataTemp)
            lBytesReadCount = lBytesReadCount + 1
            bDataRead(lBytesReadCount) = bDataTemp(lCount)
        Next lCount
        '// determine if the sequece is present in the message stream
        
        For lCount = 1 To lBytesReadCount - 1
            If bDataRead(lCount) = &H91 And bDataRead(lCount + 1) = &HC Then
                  bFound = True
                  lIndexOfLastByteResponse = lCount + 1
                  Exit For
            End If
        Next lCount
        
        
    Loop Until bFound Or lWait > 1000
    
    '// Verify the message bytes
    If bFound Then
        ResetHardware = True
        '// copy the additional bytes in the old message buffer for processsing
        '// by the read serial port command
        lNumberOfBytesOld = lBytesReadCount - lIndexOfLastByteResponse
        If lNumberOfBytesOld > 0 Then
            ReDim bOldData(lNumberOfBytesOld)
            For lCount = 1 To lNumberOfBytesOld
                bOldData(lCount) = bDataRead(lIndexOfLastByteResponse + lCount)
            Next lCount
        End If
    Else
        '// there was a response error
        ResetHardware = False
        Debug.Print "reset timeout"
    End If

End Function

Friend Sub SendMessage(msg As icsSpyMessageJ1850)
    
    Dim bData() As Byte
    Dim lNumMessageBytes As Long
    Dim lNumHeader As Long
    Dim lNumData As Long
    Dim lCount As Long
    
    Call TXFIFO.PushItem(msg)
    lNumData = msg.NumberBytesData
    lNumHeader = msg.NumberBytesHeader
    
    Select Case m_lProtocol
        Case icsavtProtocolPWM
            '// Setup the data used to send the message with no source
            lNumMessageBytes = lNumHeader + lNumData - 1
            ReDim bData(0 To lNumMessageBytes)
            
            bData(0) = lNumMessageBytes                     '// Setup the array
            
            For lCount = 1 To lNumHeader
                If lCount < 3 Then
                    bData(lCount) = msg.Header(lCount)
                End If
            Next lCount
            
            For lCount = 1 To lNumData
                bData(2 + lCount) = msg.data(lCount)
            Next lCount
            
            mComm.Output = bData '// Set the reset message
            
        Case Else
            '// Setup the data used to send the message
            lNumMessageBytes = lNumHeader + lNumData
            If lNumMessageBytes < 1 Then Exit Sub
            ReDim bData(0 To lNumMessageBytes)
            bData(0) = lNumMessageBytes                     '// Setup the array
            CopyData msg.Header(1), bData(1), lNumHeader    '// first the header
            If lNumData > 0 Then
                CopyData msg.data(1), bData(4), lNumData    '// now the data
            End If
            mComm.Output = bData '// Set the reset message
    End Select
        
End Sub

Friend Function ReadMessagesJ1850(stVSPYMessages() As icsspyHardware.icsSpyMessageJ1850, _
            lNumberOfMessages As Long) As Boolean
    
    '//
    Select Case m_lProtocol
        Case icsavtProtocolPWM
            ReadSerialPortPWM
        Case Else
            ReadSerialPortVPW
    End Select
    
    '// return the messages
    stVSPYMessages = m_stVSpyMessages
    lNumberOfMessages = lMessageCount
    lMessageCount = 0                               '// reset the message count
    ReadMessagesJ1850 = True  '// return success

    
End Function

'// this load calculation is used for the ISO and KY2K protocols
Private Sub CalculatedLoadValue(lBaud As Long, bMsb As Byte, bLsb As Byte)

    Dim dBaud As Double
    Dim dTimerLoad As Double
    Dim lTimerLoad As Long
    Dim lMsb As Long
    Dim lLsb As Long
    
    dBaud = CDbl(lBaud)
    
    dTimerLoad = 3686400# / (32 * dBaud)
    
    If dTimerLoad > 0 And dTimerLoad < 65535 Then
        '// convert to and integer
        lTimerLoad = CLng(dTimerLoad)
        
        lLsb = lTimerLoad And 255
        bLsb = CByte(lLsb)
        
        lMsb = (lTimerLoad \ 256) And 255
        bMsb = CByte(lMsb)
        
    End If

End Sub

Private Sub Class_Initialize()
    Call MakeNew
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cAVTThreaded"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Option Explicit

VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cApplicationClass"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'////////////////////////////////////////////////////////////////////
'// This class provides an application management service.  It manages
'// the most recent documents, the menus/toolbars, and file access.
'////////////////////////////////////////////////////////////////////
'// Copyright 1995-97 Intrepid Control Systems, Inc.
'// All Rights reserved
'////////////////////////////////////////////////////////////////////

Const APPNAME = " - Intrepid Control Systems Vehicle Spy"
Const m_sFileExtension = "IVS"
Const m_sFileTypeName = "Vehicle Spy Setup "


'// Structure to Hold Most Recent files
Private MostRecentFiles(3) As String

'////////////////////////////////////////////////////////////////////
'// Private member variables
'////////////////////////////////////////////////////////////////////
Private m_bValidDocument As Boolean     '// Indicates a valid document is available
Private m_bSaveNeeded As Boolean        '// Indicates a save is required
Private m_sPathFileName As String       '// Path and file name of the current application file
Private m_sCaptionString As String      '// the caption of the main form

Event NewFilePath(ByRef FilePath As String)
Event SaveData(SaveSuccessful As Boolean)
Event LoadData(LoadSuccessful As Boolean)
Event MakeDataNew()

Public Function LoadMRUFile(Index As Integer) As Boolean
    LoadMRUFile = LoadFile(MostRecentFiles(Index))
End Function

Public Property Get SaveNeeded() As Boolean
    SaveNeeded = m_bSaveNeeded
End Property

Public Property Let SaveNeeded(bNewValue As Boolean)
    m_bSaveNeeded = bNewValue
End Property

'// This sub prompts the user if s/he really wants
'// to start a new document because previous changes will be lost
'// This function returns a true if the user does not want to save
'// or cancel the operation.  The "CallSave" is a flag which indicates
'// to call save before quiting
Public Function NewOk(CallSave As Boolean) As Boolean

Dim Number As Integer  'return value from the message box

'/// Return constants from the message box
Const MYES = 6
Const MNO = 7
Const MCANCEL = 2

If m_bSaveNeeded Then

    '/// Show message box and get response
    Number = MsgBox("Current changes will be lost, would you like to save them?", 51, "Attention...")
    
    Select Case Number
        Case MYES               '// Call the save as Ps
                m_bSaveNeeded = False
                CallSave = True
                NewOk = False
                Exit Function
        Case MCANCEL            '// Cancel the current operation by exiting
            NewOk = False
            CallSave = False
            Exit Function
    End Select
    
Else
    '////////////////////////////////
    '/// No change code goes here
    '////////////////////////////////
End If
    
'////////////////////////////////
'// it is okay to change
'////////////////////////////////

NewOk = True

End Function

Public Property Get PathFileName() As String
    PathFileName = m_sPathFileName
End Property

Public Property Let PathFileName(sNewValue As String)
    m_sPathFileName = sNewValue
End Property

'// This Ps saves the current file, it requires the commondialog
'// control in case a saveas needs to be called
Public Function SaveFile(cmnDialog As CommonDialog) As Boolean

On Error GoTo SaveFileErrorHandler

Const NotSet = ""

If m_sPathFileName = NotSet Then
    SaveFile = SaveAs(cmnDialog)    '// SaveFile sucess depends on
    Exit Function
Else
    Dim bsuccess As Boolean
    RaiseEvent NewFilePath(m_sPathFileName)
    RaiseEvent SaveData(bsuccess)
    
    Call SetupCaption(m_sPathFileName)
End If

SaveNeeded = False
SaveFile = True     '// Successful save


Exit Function

SaveFileErrorHandler:

#If DebugOn Then
MsgBox "Error saving file - in Save" & vbCrLf & Err.Description, vbInformation
#End If

SaveFile = False     '// Unsuccessful save


End Function
'/// This Ps implements the save as Ps
'// it requires
Public Function SaveAs(cmnDialog As CommonDialog) As Boolean

On Error GoTo SaveAsErrorHandler

'************************************************************************
'*      Setup and use the common dialog file control in Save as mode
'************************************************************************
With cmnDialog
    .FileName = ""
    .DialogTitle = "Save file as"
    .InitDir = App.Path         '// setup intial directory based on app object
    .Filter = m_sFileTypeName & "(*." & m_sFileExtension & ")|*." & m_sFileExtension & "|"   '// setup default extension
    .Flags = &H1000& Or &H4&    '// Setup filters to hide read only and force existences of file
    .DefaultExt = m_sFileExtension
    .ShowSave                   '// Shows the save as dialog
End With

m_sPathFileName = cmnDialog.FileName    '// Place the current filename
                                        '// the member variable

Dim bsuccess As Boolean

RaiseEvent NewFilePath(m_sPathFileName)
RaiseEvent SaveData(bsuccess)
Call SetupCaption(m_sPathFileName)

'// Update the Most Recent Document Menu archive file
Call UpdateMRPmenu

SaveNeeded = False      '// Reset the change made flag
SaveAs = True           '// Successful save


Exit Function
SaveAsErrorHandler:

'// Handle the Error
Select Case Err.Number
    Case 32755  '// Cancel was pressed
    
    Case Else
        #If DebugOn Then
            MsgBox "Error saving file - in save as" & vbCrLf & Err.Description, vbInformation
        #End If
End Select

#If DebugOn Then
    Debug.Print "Error saving file - in save as" & vbCrLf & Err.Description & " : " & Err.Number
#End If


SaveAs = False          '// Unsucessful save

End Function



Public Function OpenFile(cmnDialog As CommonDialog) As Boolean
Dim CallSave As Boolean

On Error GoTo OpenErrHandler  '// Setup error trapping for common dialog
                              '// such as cancel press

If Not NewOk(CallSave) Then
    If CallSave Then
        If Not SaveFile(cmnDialog) Then   '// Call save, if there is no filename, save as
            OpenFile = False
            Exit Function                 '// will be called
        End If
    Else
        OpenFile = False
        Exit Function
    End If
End If

'************************************************************************
'*      Setup and use the common dialog file control in open mode
'************************************************************************
With cmnDialog
    .FileName = ""
    .DialogTitle = "Select a file to open"
    .InitDir = App.Path
    .Filter = m_sFileTypeName & "(*." & m_sFileExtension & ")|*." & m_sFileExtension & "|"   'setup default extension
    .Flags = &H1000& Or &H4&       'Setup filters to hide read only and force existences of file
    .ShowOpen
End With

m_sPathFileName = cmnDialog.FileName   'load new filename into form global

Call OpenModify

'// Update the Most Recent Document Menu archive file
Call UpdateMRPmenu
OpenFile = True

'// User pressed cancel button or other file error
Exit Function

OpenErrHandler:

'// Handle the Error
Select Case Err.Number
    Case 32755  '// Cancel was pressed
    
    Case Else
        '#If DebugOn Then
            MsgBox "Error opening file - in openfile" & vbCrLf & Err.Description, vbInformation
        '#End If
End Select

'#If DebugOn Then
    Debug.Print "Error opening file - in openfile" & vbCrLf & Err.Description & " : " & Err.Number
'#End If

OpenFile = False

End Function


Private Sub OpenModify()

'//////////////////////////////////////////////////
'// Edit code to modify file here
'//////////////////////////////////////////////////
Dim bsuccess As Boolean

DoEvents    '// Call doevents to start up the mouse cursor
RaiseEvent NewFilePath(m_sPathFileName)
RaiseEvent LoadData(bsuccess)

If bsuccess Then
    Call SetupCaption(m_sPathFileName)
Else
    MsgBox "There is a problem opening this file. " & vbCrLf & "File:  " & m_sPathFileName, vbInformation, "Error loading file"
    m_sPathFileName = ""
    NewModify
End If

'//////////////////////////////////////////////////
SaveNeeded = False      '// This flag changed when the form was intialized with new data

End Sub

Friend Function OpenedThroughCode(sFilePath As String)
    m_sPathFileName = sFilePath
    Dim bsuccess As Boolean
    UpdateMenu                          '// read the menu from code
    bsuccess = True
    Call UpdateMRPmenu                  '// update the most recent file menu
    RaiseEvent LoadData(bsuccess)       '// fire the loaddata event
    Call SetupCaption(m_sPathFileName)  '// setup the caption
    SaveNeeded = False                  '// clear the save needed flag
End Function

'// This function creates a new document.  It returns true if
'// it was completed sucessfully, false if it doesn't.
Public Function CreateNew(cmnDialog As CommonDialog) As Boolean

Dim SaveFirst As Boolean '// Flag argument to the NewOk member function

On Error GoTo CreateNewErrorHandler

'// Check if user wishes to save old document, if required, by calling member NewOk
If Not NewOk(SaveFirst) Then
    If SaveFirst Then
        If Not SaveFile(cmnDialog) Then
            CreateNew = False
            Exit Function
        End If
    Else
        '// this action was cancelled
        CreateNew = False
        Exit Function
    End If
End If

m_sPathFileName = ""

Call NewModify          '// Call the function which can be modified

CreateNew = True        '// Return Sucess

Exit Function

CreateNewErrorHandler:

#If DebugOn Then
    MsgBox "Error occured in CreateNew Test " & vbCrLf & Err.Description, vbCritical
#End If

CreateNew = False       '// Return Failure


End Function

Public Sub NewModify()

'////////////////////////////////////////////////
'// Add code for new action here
'////////////////////////////////////////////////
RaiseEvent MakeDataNew
Call SetupCaption("New Spy Setup")
'////////////////////////////////////////////////

End Sub


Public Function LoadFile(PathFileName As String) As Boolean

On Error GoTo LoadFileErrorHandler


m_sPathFileName = PathFileName
SaveNeeded = False

Call OpenModify

'// Success = true
Call UpdateMRPmenu
LoadFile = True

Exit Function

LoadFileErrorHandler:

#If DebugOn Then
    MsgBox "Error occured in LoadFile Ps " & vbCrLf & Err.Description, vbCritical
#End If

LoadFile = False       '// Return Failure


End Function


'// This function updates the intialization file for the Most
'// Recent document menu
Private Sub UpdateMRPmenu()
Dim mName As String
Dim Swap As String

mName = m_sPathFileName


'// Save the document information for the most recient document display
    Select Case Trim$(mName)
        Case Trim$(MostRecentFiles(0))
            '// Do nothing
        Case Trim$(MostRecentFiles(1))
            MostRecentFiles(1) = MostRecentFiles(0)
            MostRecentFiles(0) = Trim$(mName)
        Case Trim$(MostRecentFiles(2))
            MostRecentFiles(2) = MostRecentFiles(1)
            MostRecentFiles(1) = MostRecentFiles(0)
            MostRecentFiles(0) = Trim$(mName)
        Case Else
            MostRecentFiles(3) = MostRecentFiles(2)
            MostRecentFiles(2) = MostRecentFiles(1)
            MostRecentFiles(1) = MostRecentFiles(0)
           MostRecentFiles(0) = Trim$(mName)
    End Select
    


'// Save the patient file
Dim obFile As New cBinaryStorage

obFile.FilePathName = App.Path & "\last.dat"
obFile.FileOpen = True
obFile.WriteDirection = True
obFile.ReadWriteString MostRecentFiles(0)
obFile.ReadWriteString MostRecentFiles(1)
obFile.ReadWriteString MostRecentFiles(2)
obFile.ReadWriteString MostRecentFiles(3)
obFile.FileOpen = False

'////////////////////////////////////////////
'// Modify section

UpdateMenu

'////////////////////////////////////////////

End Sub


Public Sub SetupCaption(Captionstring)
    m_sCaptionString = LongDirFix(Trim$(Captionstring), 50) & APPNAME
    frmMain.Caption = m_sCaptionString
End Sub

Public Function GetCaption() As String
    If m_sCaptionString = "" Then Call SetupCaption("New Spy Setup")
    GetCaption = m_sCaptionString
End Function

'This function maintains the MRU (Most recently used)
'list in the file menu.
Public Sub UpdateMenu()

Dim Index As Integer
Static NotFirstTime As Boolean

'Open the permanent file where the MRU patients are stored
If Not NotFirstTime Then
    If Dir(App.Path & "\last.dat") = "" Then
        MostRecentFiles(0) = ""
        MostRecentFiles(1) = ""
        MostRecentFiles(2) = ""
        MostRecentFiles(3) = ""
    Else
       '// Save the patient file
        Dim obFile As New cBinaryStorage

        obFile.FilePathName = App.Path & "\last.dat"
        obFile.FileOpen = True
        obFile.WriteDirection = False
        obFile.ReadWriteString MostRecentFiles(0)
        obFile.ReadWriteString MostRecentFiles(1)
        obFile.ReadWriteString MostRecentFiles(2)
        obFile.ReadWriteString MostRecentFiles(3)
        obFile.FileOpen = False
    End If
End If

'Make the intial element visible and display the seperator bar

frmMain.MnuFileMRUArray(0).Caption = "&1 " & LongDirFix(Trim$(MostRecentFiles(0)), 50)

If Trim$(MostRecentFiles(0)) <> "" Then
    frmMain.MnuFileMRUArray(0).Visible = True
End If

For Index = 1 To 3
    If Trim$(MostRecentFiles(Index)) = "" Then Exit For
    If (Index + 1) > frmMain.MnuFileMRUArray.Count Then
        Load frmMain.MnuFileMRUArray(Index)
    End If
        'Set the caption for the new menu item
    frmMain.MnuFileMRUArray(Index).Caption = "&" & Index + 1 & " " & LongDirFix(Trim$(MostRecentFiles(Index)), 50)
    frmMain.MnuFileMRUArray(Index).Visible = True   'Make the new menu item visible
    
Next Index

NotFirstTime = True

End Sub


VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cBuffer"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'// Buffer Object
Private MessageHistory() As icsSpyMessageLong       '// Variant array containing message data
Private MessageHistoryPointer As Long               '// The point in the circular buffer we are at
Private mBufferLength As Long                       '// The length of the buffer
Private mMesssagesInBuffer As Long                  '// Indicates how many messages are in the buffer

Public LastErrorString As String                    '// the last error string

Event SaveCompletePercent(ByVal lPercent As Long)   '// This object has an event which fires while it saves its data
Event BufferRollover()
Event BufferSaved(sFileNameActual, sFileNameAttempted, bSaveSucceeded As Boolean)

Private mUpdateScreen As Boolean

Private Const MAX_LONG = 2 ^ 31
Public Function LoadBufferFromFile(sFilePath As String) As Boolean
    Dim lFileNum As Long
    Dim sTemp As String
    Dim lMessageCount As Long
    Dim lCommaCount As Long
    Dim lNextComma As Long
    Dim lCount As Long
    Dim sOut As String
    Dim msg As icsSpyMessageJ1850
    Dim spyGPS As icsSpyMessageGPS
    Dim spyAI As icsSpyMessageAnalog
    Dim spyLng As icsSpyMessageLong
    Dim lItemCount As Long
    Dim dTimeMs As Double
    Dim sByte As String
    Dim dStatus As Long
    Dim vFields As Variant
    Dim lNumFieldsMinusOne As Long
    Dim sGPSType As String
    
    Dim bCanProtocol As Boolean
    Dim vHeaderLines As Variant
    
    
    
    
    '// field constants
    Const FIELD_LINE = 0
    Const FIELD_TIME = 1
    Const FIELD_STATUS = 2
    Const FIELD_ERR = 3
    Const FIELD_HEADER_ONE = 6 '4
    Const FIELD_BYTE_ONE = 9 '7
    Const FIELD_TRIGGER = 18 '15
    Const FIELD_LONG_DATA = 9 '8
    Const FIELD_LAT_DATA = 7 '6
    Const FIELD_SPEED_DATA = 7 ' 6
    Const FIELD_ANALOG_DATA = 7 ' 6
    Const FIELD_ALTITUDE = 7 '6
    Const FIELD_GPS_TYPE = 6 '5
    Const FIELD_TYPE_INDEX = 6 '5
    
    On Error GoTo LoadBufferFromFileErrorHandle '// implement error handling (reading files is risky)
    
    
    lFileNum = FreeFile '// get a file num
    Open sFilePath For Input As lFileNum        '// open the file
    
    
    '// set the initial buffer length
    ReDim MessageHistory(1000)  '// This function returns
    mBufferLength = 1000
    
    
    
    '// find the first line in the data file
    Do
        Line Input #lFileNum, sTemp
    Loop Until EOF(lFileNum) Or Left$(sTemp, 5) = "Line,"
    
    
    '// check the header to determine if the data is CAN or J1850
    vHeaderLines = Split(sTemp, ",")
    If Trim$(vHeaderLines(6)) = "Arb ID" Then
        bCanProtocol = True
    Else
        bCanProtocol = False
    End If
    
    
    Do ' read each line of the file
        
        Line Input #lFileNum, sTemp             '// read the next line from the file
        vFields = Split(sTemp, ",")             '// split the string into fields
        lNumFieldsMinusOne = UBound(vFields)    '// what are the number of fields
        lMessageCount = lMessageCount + 1       '// count the number of messages (one per line)
        
        '// do we need to make the buffer larger (resize it every 1000 messages)?
        If lMessageCount > mBufferLength Then
            mBufferLength = mBufferLength + 1000
            ReDim Preserve MessageHistory(mBufferLength)
        End If
        
        '// read the time
        If lNumFieldsMinusOne >= FIELD_TIME Then
            '// read the time
            dTimeMs = Val(vFields(FIELD_TIME)) * 1000
            If dTimeMs > 0 And dTimeMs <= MAX_LONG Then
                msg.TimeSystem = CLng(dTimeMs)
            End If
        End If
        
        '// get the status byte
        If lNumFieldsMinusOne >= FIELD_STATUS Then
            dStatus = Val(vFields(FIELD_STATUS)) '// status
            If dStatus > 0 And dStatus <= MAX_LONG Then
                msg.StatusBitField = CLng(dStatus)
            End If
        End If
            
        
        If (msg.StatusBitField And icsSpyStatusAnalogDigitalInputValue) > 0 Then
            '// read the filed
            If lNumFieldsMinusOne >= FIELD_ANALOG_DATA Then
                LSet spyAI = msg
                spyAI.Value = Val(vFields(FIELD_ANALOG_DATA))
                LSet msg = spyAI
            End If
        ElseIf (msg.StatusBitField And icsSpyStatusGPSDataValue) > 0 Then
            '// First determine the type of GPS data
            If lNumFieldsMinusOne >= FIELD_GPS_TYPE Then
                LSet spyGPS = msg '// copy the current data into the gps msg
                sGPSType = vFields(FIELD_GPS_TYPE)
                If Len(sGPSType) > 0 Then
                    Select Case LCase$(Mid$(Trim$(sGPSType), 1, 1))
                        Case "l" '// lat and long
                            If lNumFieldsMinusOne >= FIELD_LONG_DATA Then
                                spyGPS.GPSDataID = SPY_GPS_LOCATION
                                spyGPS.Value1 = Val(vFields(FIELD_LAT_DATA))
                                spyGPS.Value2 = Val(vFields(FIELD_LONG_DATA))
                            End If
                        Case "a" '// altitude
                            If lNumFieldsMinusOne >= FIELD_ALTITUDE Then
                                spyGPS.GPSDataID = SPY_GPS_ALTITUDE
                                spyGPS.Value1 = Val(vFields(FIELD_ALTITUDE))
                            End If
                        Case "s" '// speed
                            If lNumFieldsMinusOne >= FIELD_SPEED_DATA Then
                                spyGPS.GPSDataID = SPY_GPS_SPEED
                                spyGPS.Value1 = Val(vFields(FIELD_SPEED_DATA))
                            End If
                    End Select
                End If
                LSet msg = spyGPS '// copy the msg into spymsg
            End If
        ElseIf (msg.StatusBitField And icsSpyStatusTextCommentType) > 0 Then '// this is a message of type analog
            '// read the filed
            If lNumFieldsMinusOne >= FIELD_TYPE_INDEX Then msg.Value = Val(vFields(FIELD_TYPE_INDEX))
        ElseIf (msg.StatusBitField And icsSpyStatusAudioCommentType) > 0 Then '// this is a message of type analog
            '// read the filed
            If lNumFieldsMinusOne >= FIELD_TYPE_INDEX Then msg.Value = Val(vFields(FIELD_TYPE_INDEX))
        Else
            '// its a bus message!!!!!!
            '// force the network message flag
            msg.StatusBitField = msg.StatusBitField Or icsSpyStatusNetworkMessageType
            
            If bCanProtocol Then
                '// read a can message
                
                LSet spyLng = msg
                
                If lNumFieldsMinusOne >= FIELD_HEADER_ONE Then
                    spyLng.ArbIDOrHeader = Val(vFields(FIELD_HEADER_ONE))
                End If
                
                LSet msg = spyLng
                
                '// now do the message bytes
                For lCount = 1 To 8
                    If lNumFieldsMinusOne >= (FIELD_BYTE_ONE + lCount - 1) Then
                        If Trim$(vFields(FIELD_BYTE_ONE + lCount - 1)) <> "" Then
                            msg.data(lCount) = CByte(Val("&H" & vFields(FIELD_BYTE_ONE + lCount - 1)))
                            msg.NumberBytesData = lCount
                        Else
                            Exit For
                        End If
                    End If
                Next lCount
                
                
            Else
                '// read a J1850 message
            
                '// first the three byte header
                For lCount = 1 To 3
                    If lNumFieldsMinusOne >= (FIELD_HEADER_ONE + lCount - 1) Then
                        If Trim$(vFields(FIELD_HEADER_ONE + lCount - 1)) <> "" Then
                            msg.Header(lCount) = CByte(Val("&H" & vFields(FIELD_HEADER_ONE + lCount - 1)))
                            msg.NumberBytesHeader = lCount
                        Else
                            Exit For
                        End If
                    End If
                Next lCount
                
            
                '// now do the message bytes
                For lCount = 1 To 8
                    If lNumFieldsMinusOne >= (FIELD_BYTE_ONE + lCount - 1) Then
                        If Trim$(vFields(FIELD_BYTE_ONE + lCount - 1)) <> "" Then
                            msg.data(lCount) = CByte(Val("&H" & vFields(FIELD_BYTE_ONE + lCount - 1)))
                            msg.NumberBytesData = lCount
                        Else
                            Exit For
                        End If
                    End If
                Next lCount
                
            End If
        End If
        
        LSet MessageHistory(lMessageCount) = msg
           
    Loop Until EOF(lFileNum)
    
    '// resize the buffer to the message size
    ReDim Preserve MessageHistory(lMessageCount)
    mBufferLength = lMessageCount           '// set the buffer length
    mMesssagesInBuffer = mBufferLength      '// we XX messages in this buffer
    MessageHistoryPointer = 1               '// the buffer is full, so the next message is this
    mUpdateScreen = True                    '// new buffer, needs updating
     
    '// close the file
    Close lFileNum
    
    '// if we made it this file the file is valid
    LoadBufferFromFile = True
    
    
    Exit Function
    
LoadBufferFromFileErrorHandle:

    LastErrorString = Err.Description
    LoadBufferFromFile = False
    
End Function

Friend Property Get MsgHistoryPointer() As Long
    MsgHistoryPointer = MessageHistoryPointer
End Property

Public Property Get UpdateScreen() As Boolean
    UpdateScreen = mUpdateScreen
End Property
Public Sub UpdateScreenClear()
    mUpdateScreen = False
End Sub
Public Sub UpdateScreenNeeded()
    mUpdateScreen = True
End Sub

Public Property Get BufferLength() As Long
    BufferLength = mBufferLength    '// Return the size of the buffer
End Property

Public Function SetBufferLength(ByVal lNewLength As Long) As Boolean
    On Error Resume Next
    If lNewLength <> mBufferLength Then
        ReDim MessageHistory(lNewLength)  '// This function returns
    End If
    If Err.Number <> 0 Then
        ClearBuffer
        SetBufferLength = False
    Else
        SetBufferLength = True
        mBufferLength = lNewLength
        Reset
    End If
End Function

'// this function eliminates empty buffer space ()
Public Function TrimBuffer()
    Dim lNumItems As Long
    lNumItems = NumberItems
    If lNumItems < BufferLength And lNumItems > 0 Then
        ReDim Preserve MessageHistory(lNumItems)      '// This function returns
        mBufferLength = lNumItems
        MessageHistoryPointer = MessageHistoryPointer = 1   '// the buffer is full, so the next message
        mUpdateScreen = True
    End If
End Function

'// This subroutines clears the buffer by freeing the memory associated with it.
Public Sub ClearBuffer()
    MessageHistoryPointer = 1
    mMesssagesInBuffer = 0
    mBufferLength = 0
    Erase MessageHistory
    mUpdateScreen = True
End Sub

Public Sub Reset()
    MessageHistoryPointer = 1
    mMesssagesInBuffer = 0
    mUpdateScreen = True
End Sub

Public Sub ResetMessageHistoryPointer()
    MessageHistoryPointer = 1
End Sub

'// This sub add a byte array to the end of the buffer
Friend Sub AddElement(msg As icsSpyMessageLong)
    mUpdateScreen = True
    
    CopyData msg, MessageHistory(MessageHistoryPointer), Len(msg)
    mMesssagesInBuffer = mMesssagesInBuffer + 1   '// Running count of all messages

    '// Adjust the pointer
    MessageHistoryPointer = MessageHistoryPointer + 1
    If MessageHistoryPointer > mBufferLength Then
        RaiseEvent BufferRollover
        MessageHistoryPointer = 1
    End If
End Sub

'// This function returns the number of items in the buffer
Public Property Get NumberItems() As Long
    NumberItems = mMesssagesInBuffer
End Property

'// This function saves the buffer to disk
'//

Friend Function SaveBuffer(ByVal filepath As String, ByVal TriggerLocation As Long, _
         SpyStartTime As SpyMsgTime, bUseDecimalFormatting As Boolean, _
         obApp As cicsSpy, Optional HeaderString As String = "") As Boolean

    Dim sTempFilename As String

    '// Save the buffer
    If SaveBufferPrivate(filepath, TriggerLocation, SpyStartTime, HeaderString, bUseDecimalFormatting, obApp) Then
        SaveBuffer = True   '// return success
        sTempFilename = filepath
    Else
        '// there was a problem saving the buffer create a temp file path and save the buffer
        sTempFilename = App.Path & "\Temp Test Buffer - " & Format(Now(), "mm-dd-yyyy hh-mm-ss") & ".csv"
        
        '// try to save as a temporary filename
        If SaveBufferPrivate(sTempFilename, TriggerLocation, SpyStartTime, HeaderString, bUseDecimalFormatting, obApp) Then
            SaveBuffer = True
        Else
            '// indicate a failure
            MsgBox LastErrorString, vbInformation, "Problem saving buffer."
            SaveBuffer = False
        End If
    End If
    
    '// fire the buffer saved event
    RaiseEvent BufferSaved(sTempFilename, filepath, SaveBuffer)
    
End Function

Private Function SaveBufferPrivate(filepath As String, ByVal TriggerLocation As Long, _
         SpyStartTime As SpyMsgTime, HeaderString As String, bUseDecimalFormatting As Boolean, _
         obApp As cicsSpy) As Boolean
    
    Dim lFileNum As Long                '// indicates the file name for a particular buffer
    Dim lCount As Long                  '// count of a particular number
    Dim sBuff As String
    Dim Count As Long
    Dim lNum As Long
    Dim lNumItems As Long
    Dim lbytecount As Long
    Dim lLastPercent As Long
    Dim lNewPercent As Long
    Dim lTime As Long
    Dim msg As icsSpyMessageJ1850
    Dim spyGPS As icsSpyMessageGPS
    Dim spyAI As icsSpyMessageAnalog
    Dim sCause As String
    Dim dTime As Double
    Dim MsgTime As SpyMsgTime
    Dim sDescription As String
    Dim canmsg As icsSpyMessageLong
    
    '// Wow, Charlie Parker makes my ears dance!
    On Error GoTo savebuffererror   '// implement the error handling
    
    '// Initialize the count to start at the oldest sample based on rollover
    '// did the circular buffer rollover yet?
    If mMesssagesInBuffer > mBufferLength Then
        
        '// the buffer did rollover
        lNum = mBufferLength        '// the number of elements to
                                    '// be save is the entire buffer length
        Count = MessageHistoryPointer '+ 1
        'If Count > mBufferLength Then Count = 1
    Else
        Count = 1 '// 1 is the first sample in the buffer
        lNum = mMesssagesInBuffer    '// the number of elements to save is the number in the buffer
    End If
    '/////////////////////////////////////////////////////////////////
    
    lLastPercent = 0                        '// cache the percent marker
    RaiseEvent SaveCompletePercent(0)       '// indicate the save is complete
    
    lFileNum = FreeFile                     '// get an available file number
    Open filepath For Output As lFileNum    '// open the file
            
            
    '// do we have a header string or do we have to create one....
    If HeaderString = "" Then
        '// create a header string
        Print #lFileNum, "ICS Vehicle Spy Data file"
        Print #lFileNum, "Save Date ," & Format(Now(), "mm/dd/yyyy")
        Print #lFileNum, "Save Time ," & Format(Now(), "hh:mm:ss am/pm")
    Else
        '// place the sent header string into the datafile
        Print #lFileNum, HeaderString
    End If
    
    '// Print the header file line into the file
    Select Case obApp.Protocol
        Case icsVSPYProtocolCAN
            Print #lFileNum, "Line,Time(Sec),Status,Er,Tx,Description,Arb ID,Remote,, B1,B2,B3,B4,B5,B6,B7,B8,Value,Trigger"
        Case icsVSPYProtocolJ1850
            Print #lFileNum, "Line,Time(Sec),Status,Er,Tx,Description,PT,Trgt,Src,B1,B2,B3,B4,B5, B6,B7,B8,Value,Trigger"
    End Select
    
    '// Cycle through the number of samples requested
    For lCount = 1 To lNum '// lNum indicates the number of messages in the buffer
    
        '// Get the data for this location
        CopyData MessageHistory(Count), msg, Len(msg)
        
        '// message time
        MsgTime.HardwareTimePresent = (MessageHistory(Count).StatusBitField And icsSpyStatusHardwareTimePresent) > 0
        MsgTime.HardwareTimeMs = MessageHistory(Count).TimeHardware
        MsgTime.SystemTimeMs = MessageHistory(Count).TimeSystem
        
        '// calculate the time
        dTime = GetSpyTimeSec(SpyStartTime, MsgTime)
        
        '// Move forwards in the buffer ////////////////////////
        Count = Count + 1
        If Count > mBufferLength Then Count = 1
        '//////////////////////////////////////////////////////
        
        sBuff = ""  '// clear the line for this item
        
        
        '// what type of data does this message contain?
        If (msg.StatusBitField And icsSpyStatusAnalogDigitalInputValue) > 0 Then
        
            '// this is a analog input data type
            LSet spyAI = msg
            
            If spyAI.AIDataID > 0 And spyAI.AIDataID <= obApp.MultiIO.NumberOfChannels Then
                sDescription = "MIO," & obApp.MultiIO.ChannelDescription(spyAI.AIDataID) & "," & Format$(spyAI.Value, "0.0000")
            Else
                sDescription = "MIO,Undefined Analog," & Format$(spyAI.Value, "0.0000")
            End If
            
            '// fill in the trigger information
            If (spyAI.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                sDescription = sDescription & SuperString(11, ",") & "*"
            End If
            
            '// write the data to the file
            Print #lFileNum, str$(lCount) & "," & _
                Format$(dTime, "0.000") & "," & spyAI.StatusBitField & "," _
                & ReturnTFString((spyAI.StatusBitField And icsSpyStatusGlobalError) <> 0) & ",," & sDescription
            
            '// fill in the trigger information
            
            
        ElseIf (msg.StatusBitField And icsSpyStatusGPSDataValue) > 0 Then
            
            '// change to the gps format
            LSet spyGPS = msg

            '// handle the different types of GPS data available
            Select Case spyGPS.GPSDataID
                Case SPY_GPS_LOCATION
                    sDescription = "GPS, Lat," & Format$(spyGPS.Value1, "0.00000") & ",Long," & Format$(spyGPS.Value2, "0.00000")
                    '// fill in the trigger information
                    If (msg.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                        sDescription = sDescription & SuperString(9, ",") & "*"
                    End If
                Case SPY_GPS_ALTITUDE
                    sDescription = "GPS, Altitude, " & spyGPS.Value1
                    '// fill in the trigger information
                    If (msg.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                        sDescription = sDescription & SuperString(11, ",") & "*"
                    End If
                Case SPY_GPS_SPEED
                    sDescription = "GPS, Speed, " & spyGPS.Value1
                    '// fill in the trigger information
                    If (msg.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                        sDescription = sDescription & SuperString(11, ",") & "*"
                    End If
            End Select
        
            '// write the data to the file
            Print #lFileNum, str$(lCount) & "," & _
                Format$(dTime, "0.000") & "," & msg.StatusBitField & "," _
                & ReturnTFString((msg.StatusBitField And icsSpyStatusGlobalError) > 0) & ",," & sDescription
            
        ElseIf (msg.StatusBitField And icsSpyStatusTextCommentType) > 0 Then '// this is a message of type analog
    
            
            sDescription = "Text Comment ," & Format$(msg.Value, "0")
            
            '// fill in the trigger information
            If (msg.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                sDescription = sDescription & SuperString(12, ",") & "*"
            End If
        
            '// write the data to the file
            Print #lFileNum, str$(lCount) & "," & _
                Format$(dTime, "0.000") & "," & msg.StatusBitField & "," _
                & ReturnTFString((msg.StatusBitField And icsSpyStatusGlobalError) > 0) & ",," & sDescription
        
            '// fill in the trigger information
            
        ElseIf (msg.StatusBitField And icsSpyStatusAudioCommentType) > 0 Then '// this is a message of type analog
        
            sDescription = "Audio Comment, " & Format$(msg.Value, "0")
        
            '// fill in the trigger information
            If (msg.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                sDescription = sDescription & SuperString(12, ",") & "*"
            End If
        
            '// write the data to the file
            Print #lFileNum, str$(lCount) & "," & _
                Format$(dTime, "0.000") & "," & msg.StatusBitField & "," _
                & ReturnTFString((msg.StatusBitField And icsSpyStatusGlobalError) > 0) & ",," & sDescription
            
            '// fill in the trigger information
        Else
            
            '// its message data
            
            
            
            Select Case obApp.Protocol
            
                Case icsVSPYProtocolJ1850

                    If bUseDecimalFormatting Then
                    
                        '// Build the byte string for the header
                        For lbytecount = 1 To msg.NumberBytesHeader
                            sBuff = sBuff & msg.Header(lbytecount) & ","
                        Next lbytecount
                        
                        '// Build the byte string for the data bytes
                        For lbytecount = 1 To msg.NumberBytesData
                            sBuff = sBuff & msg.data(lbytecount) & ","
                        Next lbytecount
                    
                    Else
                    
                        '// Build the byte string for the header
                        For lbytecount = 1 To msg.NumberBytesHeader
                            sBuff = sBuff & Hex(msg.Header(lbytecount)) & ","
                        Next lbytecount
                        
                        '// Build the byte string for the data bytes
                        For lbytecount = 1 To msg.NumberBytesData
                            sBuff = sBuff & Hex(msg.data(lbytecount)) & ","
                        Next lbytecount
                    
                    End If
                    
                    '// Place the trigger in the data file
                    lNumItems = msg.NumberBytesData + msg.NumberBytesHeader
                    If (msg.StatusBitField And icsSpyStatusHasValue) > 0 And lNumItems <= 11 Then
                        If (msg.StatusBitField And icsSpyStatusValueIsBoolean) > 0 Then
                            sBuff = sBuff & SuperString(11 - lNumItems, ",") & CBool(msg.Value)
                        Else
                            sBuff = sBuff & SuperString(11 - lNumItems, ",") & msg.Value
                        End If
                        If (msg.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                            sBuff = sBuff & ",*"
                        End If
                    ElseIf (msg.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                        sBuff = sBuff & SuperString(12 - lNumItems, ",") & "*"
                    End If
                    
                Case icsVSPYProtocolCAN
                    '// write out the CAN data
                    LSet canmsg = msg
                    
                    '// handle the header
                    sBuff = canmsg.ArbIDOrHeader & "," & ((canmsg.StatusBitField And icsSpyStatusRemoteFrame) > 0) & ",,"
                        
                    '// now the data bytes
                    For lbytecount = 1 To canmsg.NumberBytesData
                        sBuff = sBuff & Hex(msg.data(lbytecount)) & ","
                    Next lbytecount
                    
                    If (canmsg.StatusBitField And icsSpyStatusHasValue) > 0 And lNumItems <= 11 Then
                        If (canmsg.StatusBitField And icsSpyStatusValueIsBoolean) > 0 Then
                            sBuff = sBuff & SuperString(11 - lNumItems, ",") & CBool(canmsg.Value)
                        Else
                            sBuff = sBuff & SuperString(11 - lNumItems, ",") & canmsg.Value
                        End If
                        If (canmsg.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                            sBuff = sBuff & ",*"
                        End If
                    ElseIf (canmsg.StatusBitField And icsSpyStatusTestTrigger) > 0 Then
                        sBuff = sBuff & SuperString(12 - lNumItems, ",") & "*"
                    End If
            
            End Select
            
            '// print the data row
            If msg.DescriptionID <> 0 Then
                Print #lFileNum, str$(lCount) & "," & _
                    Format$(dTime, "0.000") & "," & msg.StatusBitField & "," _
                    & ReturnTFString((msg.StatusBitField And icsSpyStatusGlobalError) > 0) & "," & _
                        ReturnTFString((msg.StatusBitField And icsSpyStatusGlobalError) > 0) & "," _
                        & obApp.IncomingMessages(msg.DescriptionID).Description & "," & sBuff
            Else
                Print #lFileNum, str$(lCount) & "," & _
                        Format$(dTime, "0.000") & "," & msg.StatusBitField & "," _
                     & ReturnTFString((msg.StatusBitField And icsSpyStatusGlobalError) > 0) & "," & _
                        ReturnTFString((msg.StatusBitField And icsSpyStatusGlobalError) > 0) & ",," & sBuff
            End If
        
        End If
        
        
        '// Handle the percent complete display
        lNewPercent = lCount / lNum * 100
        If lNewPercent <> lLastPercent Then
            If (lNewPercent Mod 10) = 0 Then
              '  Debug.Print lNewPercent
                RaiseEvent SaveCompletePercent(lNewPercent)
                DoEvents
            End If
            lLastPercent = lNewPercent
        End If
    Next lCount


    Close lFileNum
    
    SaveBufferPrivate = True
    
    Exit Function
savebuffererror:
    
    
    '// Test the error number
    Select Case Err.Number
        Case 70 '// permission denied
            sCause = "The file is already opened by another program. Please close the " & _
            "file in the other program or choose another file name."
        Case 61 '// disk full
            sCause = "The disk you are trying to save to is full, so either make room on it or " & _
                " select another file name"
        Case Else
            sCause = "No causes are suggested."
    End Select

    LastErrorString = "There was an error saving to the path: ( " & filepath & " ). The save will be aborted." _
        & vbCrLf & vbCrLf & "Error Number: " & Err.Number & vbCrLf _
            & "Error Description: " & Err.Description & vbCrLf & "Possible cause: " & sCause
    
    '// Indicate a error occured saving the buffer
    SaveBufferPrivate = False
    
End Function

Private Function ReturnTFString(bValue As Boolean) As String
    If bValue Then
        ReturnTFString = "T"
    Else
        ReturnTFString = "F"
    End If
End Function


Private Function SuperString(lNum, sString) As String
    Dim lCount As Long
    Dim sTemp As String
    For lCount = 1 To lNum
        sTemp = sTemp & sString
    Next lCount
    SuperString = sTemp
End Function

'// returns the percentage of fullness of this buffer
Public Property Get PercentFull() As Long
    Dim lNew As Long
    If mBufferLength = 0 Then Exit Property
    
    lNew = (mMesssagesInBuffer / mBufferLength * 100)
    If lNew > 100 Then
        PercentFull = 100
    Else
        PercentFull = lNew
    End If
End Property

'// Returns where the current pointer is in percent
Public Property Get PointerPercent() As Long
    If mBufferLength <> 0 Then
        PointerPercent = (MessageHistoryPointer / mBufferLength * 100)
    End If
End Property

Friend Function GetElement(spymsg As icsSpyMessageLong, lIndex As Long) As Boolean
    Dim lNewIndex As Long
    '// handle rollover numbers
    lNewIndex = lIndex Mod mBufferLength
    If lNewIndex = 0 Then
        lNewIndex = mBufferLength
    End If
    '// return the message
    spymsg = MessageHistory(lNewIndex)
    GetElement = True
End Function

