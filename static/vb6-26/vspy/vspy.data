Public Function Add(sDescription As String, _
    lOperationType As cicsUndoOperationType, _
    bData() As Byte, sKey As String) As cUndoOperation
    
    'create a new object
    Dim objNewMember As cUndoOperation
    
    Set objNewMember = New cUndoOperation

    'set the properties passed into the method
    mCol.Add objNewMember
    
    With objNewMember
        .Description = sDescription
        .OperationType = lOperationType
        .bData = bData
        .KeyData = sKey
    End With
    
    'return the object created
    Set Add = objNewMember
    Set objNewMember = Nothing

    '// do not let undo stack get greater than 50
    If mCol.Count > 50 Then
        mCol.Remove 1
    End If

End Function

