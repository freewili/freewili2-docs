Attribute VB_Name = "frmDatabase"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

'// form object which handles the database
'// copyright 1998-99 intrepid control systems, inc.

Public obApp As cicsSpy             '// obApp
Public fMain As frmMain
Private bDatabaseOpen As Boolean

'// strings loaded from the resource file to descibe inputs/outputs that are not named
Dim sNoNamedInputText As String
Dim sNoNamedOutputText As String
Dim sNoDataBaseConfiguredText As String
    
Private Sub cmdAddToDataBaseIn_Click()
    Dim sErrorDescription As String
    If obApp.AddIncomingMessageToDatabase(lstInputMessages.ListIndex + 1) Then
        Call obApp.LoadListWithIncomingMessages(lstDBInputMessages)
    End If
End Sub

Private Sub cmdAddToDataBaseOut_Click()
    If obApp.AddOutgoingMessageToDatabase(lstOutputMessages.ListIndex + 1) Then
        Call obApp.LoadListWithOutputs(lstDBOutputMessages)
    End If
End Sub


Private Sub cmdChangeCurrentDatabase_Click()
    Dim sDefaultDatabasePath As String
    Dim obPath As New cParseFileString
    
    On Error GoTo cmdChangeCurrentDatabaseError
    
    MousePointer = vbHourglass
    Me.Refresh
    
    '// get the current database directory default from the registry
    sDefaultDatabasePath = GetSetting("icsVSpy", "Defaults", "DataBasePath", App.Path)
        
    With CommonDialog1
        .InitDir = sDefaultDatabasePath
        .DialogTitle = LoadResString(131)
        .Flags = cdlOFNHideReadOnly
        .Filter = LoadResString(132) & " (*.mdb)|*.mdb"
        .ShowOpen
        obApp.DatabasePath = .FileName
        obApp.App.SaveNeeded = True
    End With
    
    obPath.FullPath = CommonDialog1.FileName
    Call SaveSetting("icsVSpy", "Defaults", "DataBasePath", obPath.DirectoryPath)
    
    If bDatabaseOpen Then
        bDatabaseOpen = False
        obApp.CloseDataBase
    End If
    
    '// make sure the mains form lists update
    fMain.UpdateDataBaseLists
    
    '// refresh this dialog
    SetupUI
    
    MousePointer = vbDefault
    
    Exit Sub
cmdChangeCurrentDatabaseError:

    MousePointer = vbDefault
    
End Sub

Private Sub cmdLoadAllIncoming_Click()
   
    On Error GoTo cmdLoadAllIncomingError
    
    MousePointer = vbHourglass
    
    If bDatabaseOpen Then
        obApp.LoadInputsWithAllDatabaseMessages
        obApp.CloseDataBase
        obApp.App.SaveNeeded = True
        bDatabaseOpen = False
        fMain.UpdateDisplay
    End If
    
    
    Unload Me   '// unload the form
    
    Exit Sub
    
cmdLoadAllIncomingError:
    
   Call MsgBoxShowErrorGeneric(LoadResString(134)) '// show the error message
   
End Sub

Private Sub cmdLoadAllOutgoing_Click()
    
    On Error GoTo cmdLoadAllOutgoingError
    
    MousePointer = vbHourglass
    
    '// load all the messages from the database
    If bDatabaseOpen Then
        obApp.LoadOutputsWithAllDatabaseMessages
        obApp.CloseDataBase
        obApp.App.SaveNeeded = True
        bDatabaseOpen = False
        fMain.UpdateDisplay
    End If
    
    Unload Me       '// unload the form
        
    Exit Sub

cmdLoadAllOutgoingError:
    
    Call MsgBoxShowErrorGeneric(LoadResString(133)) '// show the error message
    
End Sub

Private Sub cmdNoDatabase_Click()
    obApp.DatabasePath = ""
    obApp.App.SaveNeeded = True
    SetupUI                         '// refresh this dialog
End Sub

Private Sub CmdOk_Click()
    If chkMakeDatabaseDefault = vbChecked Then
        With obApp
            .DefaultDatabasePath = .DatabasePath
            .SaveApplicationDefaults
        End With
    End If
    Unload Me
End Sub

Private Sub cmdRemoveIn_Click()
    If lstDBInputMessages.ListIndex >= 0 Then   '// remove select item from data base
        If obApp.RemoveIncomingMessageFromDatabase(lstDBInputMessages.ItemData(lstDBInputMessages.ListIndex)) Then
            Call obApp.LoadListWithIncomingMessages(lstDBInputMessages)
        End If
    End If
End Sub

Private Sub cmdRemoveOut_Click()
    If lstDBOutputMessages.ListIndex >= 0 Then   '// remove select item from data base
        If obApp.RemoveOutgoingMessageFromDatabase(lstDBOutputMessages.ItemData(lstDBOutputMessages.ListIndex)) Then
            Call obApp.LoadListWithOutputs(lstDBOutputMessages)
        End If
    End If
End Sub


Private Sub Form_Load()

    '// Load the resourse strings
    sNoNamedInputText = LoadResString(129)
    sNoNamedOutputText = LoadResString(130)
    Caption = LoadResString(121)
    CmdOk.Caption = LoadResString(117)
    lblCurrentDatabaseCaption = LoadResString(111)
    cmdChangeCurrentDatabase.Caption = LoadResString(112)
    cmdNoDatabase.Caption = LoadResString(113)
    fmUtilities.Caption = LoadResString(114)
    cmdLoadAllIncoming.Caption = LoadResString(115)
    cmdLoadAllOutgoing.Caption = LoadResString(116)
    SSTab1.TabCaption(0) = LoadResString(118)
    SSTab1.TabCaption(1) = LoadResString(119)
    SSTab1.TabCaption(2) = LoadResString(120)
    lblCurrentIncomingMessage = LoadResString(122)
    cmdAddToDataBaseIn.Caption = LoadResString(123)
    lblMessagesInputDatabase = LoadResString(124)
    cmdRemoveIn.Caption = LoadResString(125)
    lblCurrentOutgoingMessages = LoadResString(126)
    lblMessagesInOutDatabase = LoadResString(127)
    cmdAddToDataBaseOut.Caption = LoadResString(128)
    cmdRemoveOut.Caption = LoadResString(125)
    sNoDataBaseConfiguredText = LoadResString(135)
    chkMakeDatabaseDefault.Caption = LoadResString(160)
    SSTab1.Tab = 0 '// always default to the genral tab

End Sub

Public Sub SetupUI()

    Dim lNumItems As Long
    Dim lCount As Long
    Dim sString As String


    '// Setup the incoming messages combo
    lstInputMessages.Clear
    lNumItems = obApp.IncomingMessages.Count
    For lCount = 1 To lNumItems
        sString = obApp.IncomingMessages(lCount).Description
        If sString = "" Then
            sString = sNoNamedInputText & " " & lCount
        End If
        lstInputMessages.AddItem sString
    Next lCount

    
    '// enable only if there are incoming messages
    If lstInputMessages.ListCount = 0 Then
        cmdAddToDataBaseIn.Enabled = False
        lstInputMessages.Enabled = False
    Else
        lstInputMessages.ListIndex = 0
    End If
    '///////////////////////////////////////////////////////
    
    '// Setup the Outgoing messages combo
    lstOutputMessages.Clear
    lNumItems = obApp.OutgoingMessages.Count
    For lCount = 1 To lNumItems
        sString = obApp.OutgoingMessages(lCount).Description
        If sString = "" Then
            sString = sNoNamedOutputText & " " & lCount
        End If
        lstOutputMessages.AddItem sString
    Next lCount
    
    '// enable only if there are incoming messages
    If lstOutputMessages.ListCount = 0 Then
        cmdAddToDataBaseOut.Enabled = False
        lstOutputMessages.Enabled = False
    Else
        lstOutputMessages.ListIndex = 0
    End If
    '///////////////////////////////////////////////////////
    
    '// Set the database location
    If Trim$(obApp.DatabasePath) = "" Then
        txtDatabase = sNoDataBaseConfiguredText
    Else
        txtDatabase = obApp.DatabasePath
    End If
    
    '// Open the data base ////////////////////////////////////
    If obApp.OpenDataBase Then
        bDatabaseOpen = True
        Call obApp.LoadListWithIncomingMessages(lstDBInputMessages)
        Call obApp.LoadListWithOutputs(lstDBOutputMessages)
        cmdAddToDataBaseIn.Enabled = True
        cmdAddToDataBaseOut.Enabled = True
        cmdRemoveOut.Enabled = True
        cmdRemoveIn.Enabled = True
        cmdLoadAllIncoming.Enabled = True
        cmdLoadAllOutgoing.Enabled = True
    Else
        lstDBInputMessages.Clear
        lstDBOutputMessages.Clear
        bDatabaseOpen = False
        cmdAddToDataBaseIn.Enabled = False
        cmdAddToDataBaseOut.Enabled = False
        cmdRemoveOut.Enabled = False
        cmdRemoveIn.Enabled = False
        cmdLoadAllIncoming.Enabled = False
        cmdLoadAllOutgoing.Enabled = False
    End If
    '////////////////////////////////////////////////////////////////////////
End Sub

Private Sub Form_Unload(Cancel As Integer)
    If bDatabaseOpen Then
        bDatabaseOpen = False
        obApp.CloseDataBase
        fMain.UpdateDataBaseLists
    End If
End Sub


Private Sub lstInputMessages_DblClick()
    If cmdAddToDataBaseIn.Enabled Then cmdAddToDataBaseIn_Click
End Sub

Private Sub lstOutputMessages_DblClick()
    If cmdAddToDataBaseOut.Enabled Then cmdAddToDataBaseOut_Click
End Sub

Private Sub txtDatabase_KeyPress(KeyAscii As Integer)
    KeyAscii = 0
End Sub
