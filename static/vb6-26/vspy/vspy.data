    MyData.mvarValueSource = lNew
End Property

'// Returns/Sets the value type of this message. This sets how
'// the value will be displayed and the custom equation evaluated.
Public Property Get ValueType() As icsVSPYIncomingType
Attribute ValueType.VB_Description = "Returns/Sets the value type of this message. This sets how the value will be displayed and the custom equation evaluated."
    ValueType = MyData.mvarValueType
End Property

Public Property Let ValueType(ByVal vNewValue As icsVSPYIncomingType)
    MyData.mvarValueType = vNewValue
End Property
