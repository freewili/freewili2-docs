Private Sub mnuControlDelete_Click()
    
    Dim sIndex As String
    Dim sName As String
    
    obApp.App.SaveNeeded = True
    sName = UI.SelectedControl.Name
    sIndex = str$(UI.SelectedControl.Index)
    
    Select Case sName
        Case "cwg"
            obApp.UserDialog.Graphs.Remove sIndex
        Case "cwbTest"
            obApp.UserDialog.TestButtons.Remove sIndex
        Case "lblStatic"
            obApp.UserDialog.cStaticTexts.Remove sIndex
        Case "cwbLight"
            obApp.UserDialog.cDigitalDisplays.Remove sIndex
        Case "cmdTX"
            obApp.UserDialog.cDigitalEntries.Remove sIndex
        Case "cwkMeter"
            obApp.UserDialog.cAnalogDisplays.Remove sIndex
        Case "cwkKnob"
            obApp.UserDialog.cAnalogEntries.Remove sIndex
        Case "ineNumericEntry"
            obApp.UserDialog.NumericEntries.Remove sIndex
    End Select

    Unload UI.SelectedControl                     '// Unload the control
    Set UI.SelectedControl = Nothing        '// Free the reference
    pctDisplay.Cls                          '// Clear any control drag ears

End Sub

Private Sub mnuControlProperties_Click()
    Dim sIndex As String
    Dim sName As String
    Dim cOb As Control
    Dim lIndex As Long
    
    
    obApp.App.SaveNeeded = True
    Set cOb = UI.SelectedControl
    sName = cOb.Name
    sIndex = str$(cOb.Index)
    
    
    Select Case sName
        Case "cwg"
            obApp.UserDialog.Graphs(str$(cOb.Index)).ShowPropertiesDialog
            SetupGraph cOb
        Case "cwbTest"
            obApp.UserDialog.TestButtons(str$(cOb.Index)).ShowPropertiesDialog
            SetupTestButton cOb
        Case "lblStatic"
            obApp.UserDialog.cStaticTexts(str$(cOb.Index)).ShowPropertiesDialog
            cOb = obApp.UserDialog.cStaticTexts(str$(cOb.Index)).Caption
        Case "cwbLight"
            obApp.UserDialog.cDigitalDisplays(str$(cOb.Index)).ShowPropertiesDialog
        Case "cmdTX"
            obApp.UserDialog.cDigitalEntries(str$(cOb.Index)).ShowPropertiesDialog
            lIndex = obApp.UserDialog.cDigitalEntries(str$(cOb.Index)).DataID
            If lIndex > 0 And lIndex <= obApp.OutgoingMessages.Count Then
                cOb.Caption = obApp.OutgoingMessages(obApp.UserDialog.cDigitalEntries(str$(cOb.Index)).DataID).Description
            End If
        Case "cwkMeter"
            obApp.UserDialog.cAnalogDisplays(str$(cOb.Index)).ShowPropertiesDialog
            '// setup the meter
            SetupMeter cOb
        Case "cwkKnob"
            obApp.UserDialog.cAnalogEntries(str$(cOb.Index)).ShowPropertiesDialog
            SetupKnob cOb
        Case "ineNumericEntry"
            obApp.UserDialog.NumericEntries(str$(cOb.Index)).ShowPropertiesDialog
        Case "cwbOnOff"
            obApp.UserDialog.OnOffButtons(str$(cOb.Index)).ShowPropertiesDialog
            cOb.Caption = obApp.IncomingMessages(obApp.UserDialog.OnOffButtons(str$(cOb.Index)).DataID).Description
    End Select
    
End Sub
Private Sub SetupGraph(cOb As Control)
    Dim lMsg As Long
    Dim obCwg As CWGraph
    Dim dMultipler As Double
    Dim obGraph As cGraph
    
    '// set a ref from the object to the actual cwgraph object
    Set obCwg = cOb
    Set obGraph = obApp.UserDialog.Graphs(str$(cOb.Index))

    '// set the caption
    obCwg.Caption = obGraph.Title
    
    If obGraph.GraphType = 1 Then
        '// its a strip
        
        '// get the index of the message to set up the left x axis
        lMsg = obGraph.DataID
        
        '// is the left axis an incoimg or outgoing message
        If obGraph.DataIDType = icsUDIncomingMessage Then
            If lMsg > 0 And lMsg <= obApp.IncomingMessages.Count Then
                obCwg.Axes(2).Caption = obApp.IncomingMessages(lMsg).Description & " (blue)"
            Else
                obCwg.Axes(2).Caption = "None"
            End If
        Else
            '// it is an outgoing message
            If lMsg > 0 And lMsg <= obApp.OutgoingMessages.Count Then
                obCwg.Axes(2).Caption = obApp.OutgoingMessages(lMsg).Description & " (blue)"
            Else
                obCwg.Axes(2).Caption = "None"
            End If
        End If
        
        
        '// get the index of the message to set up the right x axis
        lMsg = obGraph.AnalogItemID2
        
        '// is the left axis an incoimg or outgoing message
        If obGraph.AnalogItemID2Type = icsUDIncomingMessage Then
            '// it is an incoming message
            If lMsg > 0 And lMsg <= obApp.IncomingMessages.Count Then
                obCwg.Axes(3).Caption = obApp.IncomingMessages(lMsg).Description & " (green)"
            Else
                obCwg.Axes(3).Caption = "None"
            End If
        Else
            '// it is an outgoing message
            If lMsg > 0 And lMsg <= obApp.OutgoingMessages.Count Then
                obCwg.Axes(3).Caption = obApp.OutgoingMessages(lMsg).Description & " (green)"
            Else
                obCwg.Axes(3).Caption = "None"
            End If
        End If
        
        
        '// setup the first Y-axis scaling
        obCwg.Axes(2).AutoScale = obGraph.Parameter1AutoScale
        If Not obCwg.Axes(2).AutoScale Then
            obCwg.Axes(2).SetMinMax obGraph.Parameter1Min, obGraph.Parameter1Max
        End If
        
        '// setup the second Y-axis scaling
        obCwg.Axes(3).AutoScale = obGraph.Parameter2AutoScale
        If Not obCwg.Axes(3).AutoScale Then
            obCwg.Axes(3).SetMinMax obGraph.Parameter2Min, obGraph.Parameter2Max
        End If
        
        '// setup the x-axis caption
        dMultipler = obGraph.StripRate * 0.25
        obCwg.Axes(1).FormatString = "*" & dMultipler
        
        '// setup the chart length
        obCwg.Axes(3).Visible = True
        obCwg.ChartLength = obGraph.StripLength
        obCwg.Axes(1).SetMinMax 0, obGraph.StripLength
    Else
        '// its an xy
        
        '// get the index of the message to set up the left x axis
        lMsg = obGraph.DataID
        
        '// the X axis if the first data item
        If obGraph.DataIDType = icsUDIncomingMessage Then
            If lMsg > 0 And lMsg <= obApp.IncomingMessages.Count Then
                obCwg.Axes(1).Caption = obApp.IncomingMessages(lMsg).Description
            Else
                obCwg.Axes(1).Caption = "None"
            End If
        Else
            '// it is an outgoing message
            If lMsg > 0 And lMsg <= obApp.OutgoingMessages.Count Then
                obCwg.Axes(1).Caption = obApp.OutgoingMessages(lMsg).Description
            Else
                obCwg.Axes(1).Caption = "None"
            End If
        End If
        
        
        '// get the index of the message to set up the left y axis
        lMsg = obGraph.AnalogItemID2
        
        '// is the left axis an incoimg or outgoing message
        If obGraph.AnalogItemID2Type = icsUDIncomingMessage Then
            '// it is an incoming message
            If lMsg > 0 And lMsg <= obApp.IncomingMessages.Count Then
                obCwg.Axes(2).Caption = obApp.IncomingMessages(lMsg).Description
            Else
                obCwg.Axes(2).Caption = "None"
            End If
        Else
            '// it is an outgoing message
            If lMsg > 0 And lMsg <= obApp.OutgoingMessages.Count Then
                obCwg.Axes(2).Caption = obApp.OutgoingMessages(lMsg).Description
            Else
                obCwg.Axes(2).Caption = "None"
            End If
        End If
        
        
        '// setup the first Y-axis scaling
        obCwg.Axes(1).AutoScale = obGraph.Parameter1AutoScale
        If Not obCwg.Axes(1).AutoScale Then
            obCwg.Axes(1).SetMinMax obGraph.Parameter1Min, obGraph.Parameter1Max
        End If
        
        '// setup the second Y-axis scaling
        obCwg.Axes(2).AutoScale = obGraph.Parameter2AutoScale
        If Not obCwg.Axes(2).AutoScale Then
            obCwg.Axes(2).SetMinMax obGraph.Parameter2Min, obGraph.Parameter2Max
        End If
        
        '// setup the chart length
        obCwg.Axes(3).Visible = False
        obCwg.ChartLength = obGraph.StripLength
        
        
    End If
    
    
    '// clear the graph
    obCwg.ClearData
    
End Sub

Private Sub SetupKnob(cOb As Control)
    
    Dim lInMsg As Long
    Dim obKnob As CWKnob
    Dim dMultipler As Double
    Dim sUDIndex As String
    
    '// set a ref from the object to the actual cwgraph object
    Set obKnob = cOb

    '// set the caption
    sUDIndex = str$(cOb.Index)
    
    '// setup the caption of the knob
    lInMsg = obApp.UserDialog.cAnalogEntries(sUDIndex).DataID
    If lInMsg > 0 Then
        obKnob.Caption = obApp.OutgoingMessages(lInMsg).Description
    Else
        obKnob.Caption = "None"
    End If
    
    '// setup the range
    With obApp.UserDialog.cAnalogEntries(sUDIndex)
        obKnob.Axis.SetMinMax .Minimum, .Maximum
    End With
    
End Sub

Private Sub SetupMeter(cOb As Control)
    
    Dim lInMsg As Long
    Dim obKnob As CWKnob
    Dim dMultipler As Double
    Dim sUDIndex As String
    
    '// set a ref from the object to the actual cwgraph object
    Set obKnob = cOb

    '// set the caption
    sUDIndex = str$(cOb.Index)
    
    '// setup the caption of the knob
    lInMsg = obApp.UserDialog.cAnalogDisplays(sUDIndex).DataID
    If lInMsg > 0 Then
        obKnob.Caption = obApp.IncomingMessages(lInMsg).Description
    Else
        obKnob.Caption = "None"
    End If
    
    '// setup the range
    With obApp.UserDialog.cAnalogDisplays(sUDIndex)
        obKnob.Axis.SetMinMax .Minimum, .Maximum
    End With
    
End Sub

Private Sub SetupTestButton(cOb As Control)
    
    Dim lInMsg As Long
    Dim obButton As CWButton
    Dim sUDIndex As String
    
    '// set a ref from the object to the actual cwgraph object
    Set obButton = cOb

    '// set the caption
    sUDIndex = str$(cOb.Index)
    
    '// setup the caption of the button
    lInMsg = obApp.UserDialog.TestButtons(sUDIndex).DataID
    If lInMsg > 0 Then
        obButton.Caption = obApp.Tests(lInMsg).Description
    Else
        obButton.Caption = "None"
    End If
    
    '// setup the on/off test
    Select Case obApp.UserDialog.TestButtons(sUDIndex).TestAction
        Case icsUDSaveTestData
            obButton.OnText = "Save"
            obButton.OffText = "Save"
        Case icsUDStartTest
            obButton.OnText = "Start"
            obButton.OffText = "Start"
        Case icsUDStopTest
            obButton.OnText = "Stop"
            obButton.OffText = "Stop"
        Case icsUDTriggerTest
            obButton.OnText = "Trigger"
            obButton.OffText = "Trigger"
    End Select
    
    obButton = False
    
End Sub

