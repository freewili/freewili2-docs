Attribute VB_Name = "frmAVTSetup"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public obApp As cicsSpy

Public Sub SetupUI()

    With obApp.AVTHardware
        lstAVTProtocol.ListIndex = .Protocol
        lstUnitType.ListIndex = .UnitType
        optKWP2000Mode(.KWP2000Mode) = True
        optPWMMode(.PWMMode) = True
        optISOMode(.ISOMode) = True
        txtISOBaudRate = Format$(.ISOMonitorBaud)
        txtKWPBaudRate = Format$(.KWP2000MonitorBaud)
    End With
    
End Sub


Private Sub CmdCancel_Click()
    Unload Me
End Sub

Private Sub cmdHBCCSetup_Click()
    MsgBox "Please call Intrepid Control Systems for more information on HBCC setup.", _
                vbInformation, "Vehicle Spy"
End Sub

Private Sub CmdOk_Click()
    Dim lCount As Long
    Dim dTemp As Double
    
    
    dTemp = Val(txtKWPBaudRate)
    If dTemp < 0 Or dTemp > 1000000 Then
        MsgBox "The baudrate for Keyword 2000 protocol is out of range. Please fix.", _
            vbInformation, "Vehicle Spy"
        Exit Sub
    End If
    
    dTemp = Val(txtISOBaudRate)
    If dTemp < 0 Or dTemp > 1000000 Then
        MsgBox "The baudrate for ISO9141 is out of range. Please fix.", _
            vbInformation, "Vehicle Spy"
        Exit Sub
    End If

    With obApp.AVTHardware
        
        .Protocol = lstAVTProtocol.ListIndex
        .UnitType = lstUnitType.ListIndex
        
        
        For lCount = 0 To 3
            If optKWP2000Mode(lCount) Then .KWP2000Mode = lCount
        Next lCount
        For lCount = 0 To 2
            If optPWMMode(lCount) Then .PWMMode = lCount
        Next lCount
        For lCount = 0 To 1
            If optISOMode(lCount) Then .ISOMode = lCount
        Next lCount
        
        '// set the baud rates
        .KWP2000MonitorBaud = CLng(Val(txtKWPBaudRate))
        .ISOMonitorBaud = CLng(Val(txtISOBaudRate))
        
        '// handle the default settings here...
        If chkMakeDefault = vbChecked Then .MakeCurrentValuesDefault
    
    End With
    
    Unload Me
    
    
End Sub

Private Sub Form_Load()


    '// setup the unit type list
    'Public Enum icsavtUnitType
    '    icsavtUnitAVT716
    '    icsavtUnitAVT715
    '    icsavtUnitAVT921
    '    icsavtUnitAVT931
    '    icsavtUnitAVT932
    'End Enum
        
    With lstUnitType
        .Clear
        .AddItem "AVT-716"
        .AddItem "AVT-715"
        .AddItem "AVT-921"
        .AddItem "AVT-931"
        .AddItem "AVT-932"
    End With

End Sub
