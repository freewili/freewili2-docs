Option Explicit

'local variable to hold collection
Private mCol As Collection
Public Function Add(Key As String, Optional sKey As String) As cDigitalEntry
    'create a new object
    Dim objNewMember As cDigitalEntry
    Set objNewMember = New cDigitalEntry


    'set the properties passed into the method
    objNewMember.Key = Key
    objNewMember.Key = Key
    objNewMember.Key = Key
    objNewMember.Key = Key




    If Len(sKey) = 0 Then
        mCol.Add objNewMember
    Else
        mCol.Add objNewMember, sKey
    End If


    'return the object created
    Set Add = objNewMember
    Set objNewMember = Nothing


End Function

Public Property Get Item(vntIndexKey As Variant) As cDigitalEntry
Attribute Item.VB_UserMemId = 0
    'used when referencing an element in the collection
    'vntIndexKey contains either the Index or Key to the collection,
    'this is why it is declared as a Variant
    'Syntax: Set foo = x.Item(xyz) or Set foo = x.Item(5)
  Set Item = mCol(vntIndexKey)
End Property



Public Property Get Count() As Long
    'used when retrieving the number of elements in the
    'collection. Syntax: Debug.Print x.Count
    Count = mCol.Count
End Property


Public Sub Remove(vntIndexKey As Variant)
    'used when removing an element from the collection
    'vntIndexKey contains either the Index or Key, which is why
    'it is declared as a Variant
    'Syntax: x.Remove(xyz)


    mCol.Remove vntIndexKey
End Sub


Public Property Get NewEnum() As IUnknown
Attribute NewEnum.VB_UserMemId = -4
Attribute NewEnum.VB_MemberFlags = "40"
    'this property allows you to enumerate
    'this collection with the For...Each syntax
    Set NewEnum = mCol.[_NewEnum]
End Property


Private Sub Class_Initialize()
    'creates the collection when this class is created
    Set mCol = New Collection
End Sub


Private Sub Class_Terminate()
    'destroys collection when this class is terminated
    Set mCol = Nothing
End Sub
Public Sub RemoveAll()

Dim NumItems As Integer
Dim iCount As Integer

NumItems = mCol.Count
'// Remove all items
For iCount = 1 To NumItems
    mCol.Remove 1
Next iCount

End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cDigitalEntry"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Option Explicit

Public Key As String

'// Location
Public Top As Long
Public height As Long
Public Width As Long
Public Left As Long

Public ParentUD As cUserDialog

'// Data
Public DataID As Long


Public Sub ShowPropertiesDialog()
    
    Dim TxNames As Variant
    
    TxNames = ParentUD.FireTXNamesEvent
        
    If IsEmpty(TxNames) Then
        MsgBox "There are no outgoing messages for to assign to this TX button"
    Else
        '// Shows the properties dialog
        With frmSelectItem
            .ItemDescriptions = TxNames
            .SelectedItem = DataID
            .Caption = "Select Output Message"
            .Show vbModal
            DataID = .SelectedItem
        End With
    
        Unload frmSelectItem
    End If

End Sub


'// Read the size and position //////////////////////////
Public Sub ReadSizeAndPosition(ob As Variant)
    Top = ob.Top
    height = ob.height
    Width = ob.Width
    Left = ob.Left
End Sub
'////////////////////////////////////////////////////



Public Sub ReadWriteData(bWriteDirection As Boolean, obSave As Object)

    Dim vData As Variant
    Dim obPB As New PropertyBag
    Dim vDummy As Variant
    Dim vReturn As Variant
    
    If bWriteDirection Then
        
        '// first, write the properties into the bag
        With obPB
            .WriteProperty "Key", Key, ""
            .WriteProperty "Top", Top, 0
            .WriteProperty "Height", height, 0
            .WriteProperty "Left", Left, 0
            .WriteProperty "Width", Width, 0
            .WriteProperty "DataID", DataID, 0
        End With


        '// return the contents of the bag
        vData = obPB.Contents
        
        '// write the array with the binary storage object
        obSave.readwritearray vData
        
    Else
        '// read the array from the binary storage object
        obSave.readwritearray vDummy, vReturn
        
    
        '// fill the property bag if there is somethign in the return array
        If Not IsEmpty(vReturn) Then
            
            '// fill the property bag with the data
            obPB.Contents = vReturn
            
            '// read the data out of the property bag
            With obPB
                Key = .ReadProperty("Key", "")
                Top = .ReadProperty("Top", 0)
                height = .ReadProperty("Height", 0)
                Left = .ReadProperty("Left", 0)
                Width = .ReadProperty("Width", 0)
                DataID = .ReadProperty("DataID", 0)
            End With
        End If
    End If
'//////////////////////////////


End Sub
Public Sub SetEqualTo(MasterOb As cDigitalEntry)

'// Equalize all the properties
With MasterOb
    Key = .Key
    Top = .Top
    height = .height
    Width = .Width
    Left = .Left
    DataID = .DataID
End With
'//////////////////////////////

End Sub

Private Sub Class_Initialize()
    DataID = 1
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cGraph"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Option Explicit

Public Key As String

'// Location
Public Top As Long
Public height As Long
Public Width As Long
Public Left As Long

'// Ref to
Public ParentUD As cUserDialog

'// Data //// charm just takes me away...
Public DataID As Long
Public DataIDType As icsSpyUDDataType

Public AnalogItemID2 As Long
Public AnalogItemID2Type As icsSpyUDDataType

Public GraphType As Long
Public StripRate As Long
Public StripLength As Long
Public Title As String

'// scaling for parameter 1
Public Parameter1AutoScale As Boolean
Public Parameter1Max As Double
Public Parameter1Min As Double

'// scaling for parameter 2
Public Parameter2AutoScale As Boolean
Public Parameter2Max As Double
Public Parameter2Min As Double

'// private data
Public CurrentStripCount As Long

'// defaults for the parameters
Const defStripLength = 50
Const defDataID = 1
Const defDataIDType = icsUDIncomingMessage
Const defGraphType = 1
Const defStripRate = 4
Const defAnalogItemID2Type = icsUDIncomingMessage
Const defAnalogItemID2 = 0
Const defTitle = ""
Const defParameter1AutoScale = True
Const defParameter1Max = 100
Const defParameter1Min = 0
Const defParameter2AutoScale = True
Const defParameter2Max = 100
Const defParameter2Min = 0



Public Sub ReadWriteData(bWriteDirection As Boolean, obSave As Object)

    Dim vData As Variant
    Dim obPB As New PropertyBag
    Dim vDummy As Variant
    Dim vReturn As Variant
    
    If bWriteDirection Then
        
        '// first, write the properties into the bag
        With obPB
            .WriteProperty "Key", Key, ""
            .WriteProperty "Top", Top, 0
            .WriteProperty "Height", height, 0
            .WriteProperty "Left", Left, 0
            .WriteProperty "Width", Width, 0
            .WriteProperty "DataID", DataID, defDataID
            .WriteProperty "DataIDType", DataIDType, defDataIDType
            
            .WriteProperty "AnalogItem2ID", AnalogItemID2, defAnalogItemID2
            .WriteProperty "AnalogItemID2Type", AnalogItemID2Type, defAnalogItemID2Type
            
            .WriteProperty "GraphType", GraphType, defGraphType
            .WriteProperty "StripRate", StripRate, defStripRate
            .WriteProperty "StripLength", StripLength, defStripLength
            .WriteProperty "Title", Title, defTitle
            .WriteProperty "Parameter1AutoScale", Parameter1AutoScale, defParameter1AutoScale
            .WriteProperty "Parameter1Max", Parameter1Max, defParameter1Max
            .WriteProperty "Parameter1Min", Parameter1Min, defParameter1Min
            .WriteProperty "Parameter2AutoScale", Parameter2AutoScale, defParameter2AutoScale
            .WriteProperty "Parameter2Min", Parameter2Min, defParameter2Min
            .WriteProperty "Parameter2Max", Parameter2Max, defParameter2Max
        End With


        '// return the contents of the bag
        vData = obPB.Contents
        
        '// write the array with the binary storage object
        obSave.readwritearray vData
        
    Else
        '// read the array from the binary storage object
        obSave.readwritearray vDummy, vReturn
        
    
        '// fill the property bag if there is somethign in the return array
        If Not IsEmpty(vReturn) Then
            
            '// fill the property bag with the data
            obPB.Contents = vReturn
            
            '// read the data out of the property bag
            With obPB
                Key = .ReadProperty("Key", "")
                Top = .ReadProperty("Top", 0)
                height = .ReadProperty("Height", 0)
                Left = .ReadProperty("Left", 0)
                Width = .ReadProperty("Width", 0)
                DataID = .ReadProperty("DataID", defDataID)
                DataIDType = .ReadProperty("DataIDType", defDataIDType)
                
                AnalogItemID2 = .ReadProperty("AnalogItem2ID", defAnalogItemID2)
                AnalogItemID2Type = .ReadProperty("AnalogItemID2Type", defAnalogItemID2Type)
                     
                GraphType = .ReadProperty("GraphType", defGraphType)
                StripRate = .ReadProperty("StripRate", defStripRate)
                StripLength = .ReadProperty("StripLength", defStripLength)
                Title = .ReadProperty("Title", defTitle)
                Parameter1AutoScale = .ReadProperty("Parameter1AutoScale", defParameter1AutoScale)
                Parameter1Max = .ReadProperty("Parameter1Max", defParameter1Max)
                Parameter1Min = .ReadProperty("Parameter1Min", defParameter1Min)
                Parameter2AutoScale = .ReadProperty("Parameter2AutoScale", defParameter2AutoScale)
                Parameter2Min = .ReadProperty("Parameter2Min", defParameter2Min)
                Parameter2Max = .ReadProperty("Parameter2Max", defParameter2Max)
            End With
        End If
    End If
    

'//////////////////////////////


End Sub


'// Read the size and position //////////////////////////
Public Sub ReadSizeAndPosition(ob As Variant)
    Top = ob.Top
    height = ob.height
    Width = ob.Width
    Left = ob.Left
End Sub
'////////////////////////////////////////////////////


Public Sub SetEqualTo(MasterOb As cGraph)

'// Equalize all the properties
With MasterOb
    Key = .Key
    Top = .Top
    height = .height
    Width = .Width
    Left = .Left
    DataID = .DataID
    DataIDType = .DataIDType
    GraphType = .GraphType
    StripRate = .StripRate
    StripLength = .StripLength
    Title = .Title
    Parameter1AutoScale = .Parameter1AutoScale
    Parameter1Max = .Parameter1Max
    Parameter1Min = .Parameter1Min
    Parameter2AutoScale = .Parameter2AutoScale
    Parameter2Max = .Parameter2Max
    Parameter2Min = .Parameter2Min
End With
'//////////////////////////////////////////////////////////////////

End Sub


Public Sub ShowPropertiesDialog()
    Dim TxNames As Variant
    Dim OutNames As Variant
    
    TxNames = ParentUD.FireRXNamesEvent
    OutNames = ParentUD.FireTXNamesEvent
        
        
    '// Shows the properties dialog
    With frmGraphProperties
        .IncomingMessageDescriptions = TxNames
        .OutgoingMessageDescriptions = OutNames
        Set .G = Me
        .Show vbModal
    End With

    Unload frmGraphProperties
    Set frmGraphProperties = Nothing
    
End Sub

Private Sub Class_Initialize()
    '// setup the defaults
    StripLength = defStripLength
    DataID = defDataID
    DataIDType = defDataIDType
    GraphType = defGraphType
    StripRate = defStripRate
    AnalogItemID2Type = defAnalogItemID2Type
    AnalogItemID2 = defAnalogItemID2
    Title = defTitle
    Parameter1AutoScale = defParameter1AutoScale
    Parameter1Max = defParameter1Max
    Parameter1Min = defParameter1Min
    Parameter2AutoScale = defParameter2AutoScale
    Parameter2Max = defParameter2Max
    Parameter2Min = defParameter2Min
End Sub

