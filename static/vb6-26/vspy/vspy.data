Private Sub mnuToolsExcelWorkbook_Click()
    Dim obTest As cTest
    Dim stSpymsgtime As SpyMsgTime
    
    Dim lCount As Long
    Dim sFilename As String
    Dim lNumItems As Long
    Dim sWorkbookToCopy As String
    
    '// let the user know that this is prototype
    MsgBox "You must have MS Excel version 7 or higher installed to run." & vbCrLf & vbCrLf & "Also each test must be named something unique", vbInformation
    
    '// change the pointer
    MousePointer = vbHourglass
    
'    Dim xl As New Excel.Application
'    Dim xlWorkBook As Excel.Workbook
'    Dim xlworksheet As Excel.Worksheet
    On Error GoTo mnuToolsExcelWorkbook_ClickError
    
    Dim xl As Object
    Dim xlworkbook As Object
    Dim xlworksheet As Object
    
    '// create the excel object
    Set xl = CreateObject("Excel.Application")
    
    With xl
        '// create all the workbooks
        For Each obTest In obApp.Tests
            lCount = lCount + 1
            sFilename = App.Path & "\tempdata " & lCount & ".csv"
            Call obTest.Buffer.SaveBuffer(sFilename, 0, stSpymsgtime, False, obApp)
            .Workbooks.OpenText sFilename
        Next obTest
        
        lCount = 0
        If obApp.Tests.Count > 1 Then
            For Each obTest In obApp.Tests
                lCount = lCount + 1
                If lCount > 1 Then
                    '// add this workbook to he
                    sWorkbookToCopy = "tempdata " & lCount & ".csv"
                    Set xlworksheet = .Workbooks(sWorkbookToCopy).Worksheets(1)
                    xlworksheet.Copy , .Workbooks("tempdata 1.csv").Worksheets(1)
                    Set xlworksheet = .Workbooks("tempdata 1.csv").Worksheets(2)
                    xlworksheet.Name = obTest.Description
                    .Workbooks(sWorkbookToCopy).Close
                End If
            Next obTest
        End If
            
        '// name the last test
        If obApp.Tests.Count > 0 Then
            Set xlworksheet = .Workbooks("tempdata 1.csv").Worksheets(1)
            xlworksheet.Name = obApp.Tests(1).Description
        End If
        .Visible = True
        
    End With 'xl

    MousePointer = vbDefault

    Exit Sub
    
mnuToolsExcelWorkbook_ClickError:

    MousePointer = vbDefault
    
    MsgBox "There was a problem creating the workbook." & vbCrLf & vbCrLf & _
                "Description: " & Err.Description, vbInformation, "Problem"
                

End Sub

