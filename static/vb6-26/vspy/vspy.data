Attribute VB_Name = "frmTXPanel"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit


Public WithEvents obApp As cicsSpy
Attribute obApp.VB_VarHelpID = -1
Public WithEvents OutMsgs As cOutgoingMessages
Attribute OutMsgs.VB_VarHelpID = -1
Public WithEvents fMain As frmMain
Attribute fMain.VB_VarHelpID = -1

'// set by the program
Private bProgramSetlstTXMessages As Boolean
Private bProgramSetTXTab As Boolean
Private bChangedDescription As Boolean

Public Sub SetupUI()

    Dim obOutMsg As cOutgoingMessage
    Dim sDescription As String
    Dim obTxButton As cTransmitButton
    
    '// set the outgoing message ref
    Set OutMsgs = obApp.OutgoingMessages
    
    '// place each message description into the box
    With lstTXMessages
        .Clear      '// clear the box
        For Each obOutMsg In obApp.OutgoingMessages
            sDescription = obOutMsg.Description
            If sDescription = "" Then sDescription = "Unnamed message"
            .AddItem sDescription
        Next obOutMsg
    End With

    '// setup the buttons used in the transmit panel
     'bProgramSetTXTab = True
    ts.Tabs.Clear
    For Each obTxButton In obApp.Monitor.TxButtons
        '// add a tab for each txbutton
        Set obTxButton.aTxTab = ts.Tabs.Add(, , obTxButton.FullCaption)
    Next obTxButton
    Set ts.SelectedItem = ts.Tabs(1)
    'bProgramSetTXTab = False
    
    '// setup the tx box
    UpdateListWithTxMessages

End Sub



Private Sub fMain_NumberOfOutputsChanged()
    SetupUI
End Sub

Private Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)
    '// close the form if esc is pressed
    If KeyCode = vbKeyEscape Then
        Unload Me
    End If
End Sub

Private Sub Form_QueryUnload(Cancel As Integer, UnloadMode As Integer)
    Dim obtx As cTransmitButton
    '// for each transmit button
    If Not (obApp Is Nothing) Then
        For Each obtx In obApp.Monitor.TxButtons
            Set obtx.aTxTab = Nothing
        Next obtx
    End If
End Sub

Private Sub Form_Resize()
    Dim lNew As Long
    On Error Resume Next
    
    lNew = pctToolbar.Top + pctToolbar.Height
    lstTXMessages.Move 0, lNew, ScaleWidth, ScaleHeight - lNew
End Sub


'// Update the messages collection every time a message is selected
'//
Private Sub lstTXMessages_Click()
    
    Dim lSelectedCount As Long
    Dim lNum As Long
    Dim lCount As Long
    Dim bSetCaption As Boolean
    
    If Not bProgramSetlstTXMessages Then
        
        obApp.App.SaveNeeded = True
        
        If Not (ts.SelectedItem Is Nothing) Then
            '// assign for each message
            With obApp.Monitor.TxButtons(ts.SelectedItem.Index)
                lNum = lstTXMessages.SelCount
                .NumberOfMessages = lNum
                
                If lNum = 1 And obApp.Monitor.TxButtons(ts.SelectedItem.Index).Caption = "" Then
                    bSetCaption = True
                Else
                    bSetCaption = False
                End If
                
                For lCount = 1 To lstTXMessages.ListCount
                    If lstTXMessages.Selected(lCount - 1) Then
                        If bSetCaption Then
                            '//
                            obApp.Monitor.TxButtons(ts.SelectedItem.Index).Caption = obApp.OutgoingMessages(lCount).Description
                            txtDescription = obApp.OutgoingMessages(lCount).Description
                            If obApp.MonitorOn Then obApp.SetupTxMessageVoiceList
                        End If
                        
                        lSelectedCount = lSelectedCount + 1
                        Call .SetMessage(lSelectedCount, obApp.OutgoingMessages(lCount).Key)
                    End If
                Next lCount
            End With
        End If
    
    End If
    
End Sub

'// this will select the messages for a particular TX button
Private Sub UpdateListWithTxMessages()
    
    Dim lNum As Long
    Dim lCount As Long
    Dim obtx As cTransmitButton
    Dim lNumSelected As Long
    
    '// we are going to set the list box via program (avoid click event handler with this flag)
    bProgramSetlstTXMessages = True
    
    If Not (ts.SelectedItem Is Nothing) Then
        
        '// first, unselect all messages
        For lCount = 1 To lstTXMessages.ListCount
            lstTXMessages.Selected(lCount - 1) = False
        Next lCount
        
        '// now select the appropiate items
        Set obtx = obApp.Monitor.TxButtons(ts.SelectedItem.Index)
        lNum = obtx.NumberOfMessages    '// get the number of messages
        For lCount = 1 To lNum
            lNumSelected = obApp.OutgoingMessages.ReturnIndexFromKey(obtx.GetMessage(lCount)) - 1
            If lNumSelected >= 0 And lNumSelected < lstTXMessages.ListCount Then
                lstTXMessages.Selected(lNumSelected) = True
            End If
        Next lCount

    End If
    
    '// we are going to set the list box via program (avoid click event handler with this flag)
    bProgramSetlstTXMessages = False
        
End Sub


Private Sub mnuEdit_Click()
    If ts.SelectedItem.Index > 9 Then
        mnuEditDelete.Enabled = True
    Else
        mnuEditDelete.Enabled = False
    End If
End Sub

Private Sub mnuEditDelete_Click()
    If Not (ts.SelectedItem Is Nothing) Then
        If ts.SelectedItem.Index > 9 Then
            obApp.Monitor.TxButtons.Remove ts.SelectedItem.Index
            'RaiseEvent NumberOfTxButtonsChanged
            fMain.UpdateTxPanel
            SetupUI
        End If
    End If
End Sub

Private Sub mnuEditInsert_Click()
    '// asdkfjsdl
    obApp.Monitor.TxButtons.Add
    'RaiseEvent NumberOfTxButtonsChanged
    fMain.UpdateTxPanel
    SetupUI
    Set ts.SelectedItem = ts.Tabs(ts.Tabs.Count)    '// show the largest tab
End Sub

Private Sub mnuFileExit_Click()
    Unload Me
End Sub

Private Sub pctToolbar_Resize()
    Dim lNewWidth As Long
    Dim lNewHeight As Long
    
    ts.Left = 0
    ts.Width = pctToolbar.ScaleWidth
    txtDescription.Left = 0
    lNewWidth = pctToolbar.ScaleWidth - txtUpdate.Width
    lNewHeight = pctToolbar.ScaleHeight - ts.Height - lblDescription.Height
    
    If lNewWidth > 0 And lNewHeight > 0 Then
        txtDescription.Move 0, ts.Height + lblDescription.Height, lNewWidth, lNewHeight
        txtUpdate.Move txtDescription.Width, ts.Height + lblDescription.Height, txtUpdate.Width, lNewHeight
        lblDelay.Move txtDescription.Width
    End If
    
    
End Sub

Private Sub ts_Click()
    Dim lCount As Long
    Dim lNum As Long
        
    If Not bProgramSetTXTab Then
    '// no item selected -> exit sub (this may never happen in the click event)
    If ts.SelectedItem Is Nothing Then Exit Sub
    
    '// fill the item
    With obApp.Monitor.TxButtons(ts.SelectedItem.Index)
        
        '// Get the description for this tx button
        txtDescription = .Caption
        txtUpdate = Format$(.InterMessageDelaySec)
        
        '// allow tx only during run
        UpdateListWithTxMessages
    
    End With
    
    End If
    
End Sub

Private Sub txtDescription_Change()
    '// assign the description to the appropiate TX button
    If Not (ts.SelectedItem Is Nothing) Then
        obApp.Monitor.TxButtons(ts.SelectedItem.Index).Caption = txtDescription
        bChangedDescription = True
    End If
End Sub

Private Sub txtDescription_GotFocus()
    bChangedDescription = False
End Sub

Private Sub txtDescription_LostFocus()
    If bChangedDescription Then
        If obApp.MonitorOn Then obApp.SetupTxMessageVoiceList
    End If
End Sub

Private Sub txtUpdate_Change()
    '// assign the description to the appropiate TX button
    If Not (ts.SelectedItem Is Nothing) Then
        If Abs(Val(txtUpdate)) < 214748 Then
            obApp.Monitor.TxButtons(ts.SelectedItem.Index).InterMessageDelaySec = Abs(Val(txtUpdate))
        Else
            txtUpdate = 0
        End If
    End If
End Sub


Private Sub txtUpdate_KeyPress(KeyAscii As Integer)
    If KeyAscii = Asc("-") Then
        KeyAscii = 0
    End If
    If LCase$(Chr$(KeyAscii)) Like "[a-z]" Then
        KeyAscii = 0
    End If
End Sub
