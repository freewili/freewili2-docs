Private Sub Class_Initialize()
    Continuous = True
    NumberOfIterations = 1
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cEvaluateExpression"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'//

Public OnErrorShowMsgbox As Boolean
Public LastErrorString As String

Dim e_input As String
Dim e_tok As String
Dim e_spelling As String
Dim e_error As String

Private Values() As Double
Private NumValues  As Long


Private Sub ExpressionError(sErrorString As String)
    'sub
    If OnErrorShowMsgbox Then
        MsgBox sErrorString
    Else
        LastErrorString = sErrorString
    End If
End Sub

Public Sub SetValue(lIndex As Long, dValue As Double)
    Values(lIndex) = dValue
End Sub

Public Sub SetNumValues(lNum As Long)
    If lNum > NumValues Then
        ReDim Preserve Values(1 To lNum + 20)
        NumValues = lNum + 20
    End If
End Sub
    
'// eval
'// Evaluate a string containing an infix numeric expression
'// If successful , return true and place result in <value>.
'// This is the top-level function in the expression evaluator.
Public Function Evaluate(ByVal s As String, Value As Double) As Boolean

    s = LCase$(s) '// added to handle case changing of the equation

    '//Initialize
    e_error = 0
    e_input = s
    Call e_nxt
    
    '// Evaluate
    Value = e_prs(1)
    
    '// Check for unrecognized input
    If e_tok <> "" And Not e_error Then
        ExpressionError "Syntax error, token = '" & e_spelling & "'"
        e_error = -1
    End If
    
    Evaluate = Not e_error
    
End Function

'// e_prs
'//
'// Parse an expression, allowing operators of a specified
'// precedence or higher. The lower precedence is 1. This function
'// gets tokens with e_nxt and recursively applies operator precedence
'// rules.
Private Function e_prs(p As Integer) As Double
    Dim n As Double
    Dim fun As String
    Dim newvalue As Single
    '// Parse expression that begins with a token (precedence 12)
    If e_tok = "num" Then
        '// Number
        n = Val(e_spelling)
        Call e_nxt
    ElseIf e_tok = "-" Then
        '// Unary minus
        Call e_nxt
        n = -e_prs(11)  '// Operator precedence 11
    ElseIf e_tok = "not" Then
        '// Logical not
        Call e_nxt
        n = Not e_prs(6)    '// precedence 6
    ElseIf e_tok = "(" Then
        '// Parentheses
        Call e_nxt
        n = e_prs(1)
        Call e_match(")")
    ElseIf e_tok = "id" Then
        '// Function call
        fun = e_spelling
        Call e_nxt
        Call e_match("(")
        n = e_prs(1)
        Call e_match(")")
        n = e_function(fun, n)
    Else
        If Not e_error Then
            ExpressionError "syntax error, token = '" & e_spelling & "'"
            e_error = -1
        End If
    End If
    
    '// Parse Binary Operators
    Do While Not e_error
        If 0 Then
            ElseIf p <= 11 And e_tok = "^" Then Call e_nxt: n = n ^ e_prs(12)
            ElseIf p <= 10 And e_tok = "*" Then Call e_nxt: n = n * e_prs(11)
            ElseIf p <= 10 And e_tok = "/" Then
                    Call e_nxt              '// Avoid divide by zero
                    newvalue = e_prs(11)
                    If newvalue <> 0 Then
                        n = n / newvalue
                    End If
            ElseIf p <= 9 And e_tok = "\" Then Call e_nxt: n = n \ e_prs(10)
            ElseIf p <= 8 And e_tok = "mod" Then Call e_nxt: n = n Mod e_prs(9)
            ElseIf p <= 7 And e_tok = "+" Then Call e_nxt: n = n + e_prs(8)
            ElseIf p <= 7 And e_tok = "-" Then Call e_nxt: n = n - e_prs(8)
            ElseIf p <= 6 And e_tok = "=" Then Call e_nxt: n = n = e_prs(7)
            ElseIf p <= 6 And e_tok = ">" Then Call e_nxt: n = n > e_prs(7)
            ElseIf p <= 6 And e_tok = "<" Then Call e_nxt: n = n < e_prs(7)
            ElseIf p <= 6 And e_tok = "<>" Then Call e_nxt: n = n <> e_prs(7)
            ElseIf p <= 6 And e_tok = "<=" Then Call e_nxt: n = n <= e_prs(7)
            ElseIf p <= 6 And e_tok = ">=" Then Call e_nxt: n = n >= e_prs(7)
            ElseIf p <= 5 And e_tok = "and" Then Call e_nxt: n = n And e_prs(6)
            ElseIf p <= 4 And e_tok = "or" Then Call e_nxt: n = n Or e_prs(5)
            ElseIf p <= 3 And e_tok = "xor" Then Call e_nxt: n = n Xor e_prs(4)
            ElseIf p <= 2 And e_tok = "eqv" Then Call e_nxt: n = n Eqv e_prs(3)
            ElseIf p <= 1 And e_tok = "imp" Then Call e_nxt: n = n Imp e_prs(2)
            Else
                Exit Do
        End If
    Loop
    
    e_prs = n
    

End Function


'// e_function
'//
'// Evaluate a function. This is a helper function to simplify e_prs.
Private Function e_function(fun As String, arg As Double) As Double
    Dim n As Double
    
    Select Case LCase$(fun)
        Case "vat": n = Values(arg)
        Case "bit0": n = (arg And 2 ^ 0) > 0
        Case "bit1": n = (arg And 2 ^ 1) > 0
        Case "bit2": n = (arg And 2 ^ 2) > 0
        Case "bit3": n = (arg And 2 ^ 3) > 0
        Case "bit4": n = (arg And 2 ^ 4) > 0
        Case "bit5": n = (arg And 2 ^ 5) > 0
        Case "bit6": n = (arg And 2 ^ 6) > 0
        Case "bit7": n = (arg And 2 ^ 7) > 0
        Case "byte0": n = arg And 255
        Case "byte1": n = (arg And 65280) \ 256
        Case "byte2": n = (arg And &HFF0000) \ 256 ^ 2
        Case "byte3": n = (arg / CDbl(256 ^ 3)) And 255
        Case "abs": n = Abs(arg)
        Case "atn": n = Atn(arg)
        Case "cos": n = Cos(arg)
        Case "exp": n = Exp(arg)
        Case "fix": n = Fix(arg)
        Case "int": n = Int(arg)
        Case "log": n = Log(arg)
        Case "rnd": n = Rnd(arg)
        Case "sgn": n = Sgn(arg)
        Case "sin": n = Sin(arg)
        Case "sqr": n = Sqr(arg)
        Case "tan": n = Tan(arg)
        Case Else
            If Not e_error Then
            ExpressionError "Undefined function '" & fun & "'"
            e_error = -1
            End If
    End Select
    
    e_function = n
    
End Function

'// e_nxt
'//
'// Get the next token into e_tok and e_spelling and remove the token
'// from e_input. This function groups the input into "words" like numbers,
'// operations and function names.
Private Sub e_nxt()
    Dim is_keyword As Integer
    Dim c As String
    Dim is_id As Boolean
    
    
    
    
    e_tok = ""
    e_spelling = ""
    
    '// Skip white space
    Do
        c = Left$(e_input, 1)
        e_input = Mid$(e_input, 2)
    Loop While c = " " Or c = Chr$(9) Or c = Chr$(13) Or c = Chr$(10)
    
    Select Case LCase$(c)
        '// Number constant.
        Case "0" To "9", "."
            e_tok = "num"
        Do
            e_spelling = e_spelling + c
            c = Left$(e_input, 1)
            e_input = Mid$(e_input, 2)
        Loop While (c >= "0" And c <= "9") Or c = "."
        e_input = c + e_input
        
        '// identifier or keyword
        Case "a" To "z", "_"
        e_tok = "id"
        Do
            e_spelling = e_spelling & c
            c = LCase$(Left$(e_input, 1))
            e_input = Mid$(e_input, 2)
            is_id = (c >= "a" And c <= "z")
            is_id = is_id Or c = "_" Or (c >= "0" And c <= "9")
        Loop While is_id
        e_input = c + e_input
        
        '// Check for keyword
        is_keyword = -1
        Select Case LCase$(e_spelling)
            Case "and"
            Case "eqv"
            Case "imp"
            Case "mod"
            Case "not"
            Case "or"
            Case "xor"
            Case "mod"
            Case Else: is_keyword = 0
        End Select
        If is_keyword Then
            e_tok = LCase$(e_spelling)
        End If
        
        Case ">", "<"
            e_tok = c
            c = Left$(e_input, 1)
            If c = "=" Or c = ">" Then
                e_tok = e_tok + c
                e_input = Mid$(e_input, 2)
            End If
        Case Else
            e_tok = c
        End Select
        
        If e_spelling = "" Then
            e_spelling = e_tok
        End If
        
        
        
End Sub



'// e_match
'//
'// Check the current token and skip past it.
'// This function helps with syntax checking
Private Sub e_match(token As String)

    If Not e_error And e_tok <> token Then
        ExpressionError "Expected " & token & ", got '" & e_spelling & "'"
        e_error = -1
    End If
    Call e_nxt
    
End Sub

Private Sub Class_Initialize()
    ReDim Values(1 To 20)
    NumValues = 20
    OnErrorShowMsgbox = True
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cFIFO"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit
Option Base 1

''////////////////////////////////////////////////////////////////////////////////////////
Dim msgs() As icsSpyMessageJ1850
Dim lNumSpace As Long
Dim lLastMessage As Long
Dim lFirstMessage As Long


Friend Sub Init()
    lNumSpace = 200
    lFirstMessage = 1
    lLastMessage = 1
    ReDim msgs(lNumSpace)
End Sub


'// Returns the number of items in the fifo
Friend Property Get Count() As Long
    If lLastMessage - lFirstMessage < 0 Then
        Count = lLastMessage + (15 - lFirstMessage)
    Else
        Count = Abs(lLastMessage - lFirstMessage)
    End If
End Property

Friend Function PopItem(msg As icsSpyMessageJ1850) As Boolean
    On Error GoTo PopItemError
    If Count > 0 Then
        LSet msg = msgs(lFirstMessage)
        lFirstMessage = lFirstMessage + 1
        If lFirstMessage > lNumSpace Then lFirstMessage = 1
        PopItem = True
    Else
        PopItem = False
    End If
    Exit Function
PopItemError:
    PopItem = False
    Debug.Print "Error in cFIFO::Popitem ************************************"
End Function

Friend Sub PushItem(msg As icsSpyMessageJ1850)
    On Error GoTo PushItemError
    If Count + 1 >= lNumSpace Then
        ReDim Preserve msgs(lNumSpace + 100)
        lNumSpace = lNumSpace + 100
    End If
    LSet msgs(lLastMessage) = msg
    lLastMessage = lLastMessage + 1
    If lLastMessage > lNumSpace Then lLastMessage = 1
    Exit Sub
PushItemError:
    Debug.Print "Error in cFIFO::PushItem ************************************"
End Sub

Private Sub Class_Initialize()
    Init
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cFilters"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Attribute VB_Ext_KEY = "Member0" ,"cExcludedFilters"
Attribute VB_Ext_KEY = "Member1" ,"cIncludedFilters"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit
Option Base 1

'// Filters object
'// Copyright 1997-99 Intrepid Control Systems,Inc.



'// filters that are included
Private mIncludedFilters() As Long
Private mIncludedFiltersCount As Long
Private mIncludedFilterKeys() As String


'// filters that are excluded
Private mExcludedFilters() As Long
Private mExcludedFiltersCount As Long
Private mExcludedFilterKeys() As String


'/// excluded filters ////////////////////////////////////////////////////////////
Public Sub SetNumExcludedFilters(lNum As Long)
    If lNum <> 0 Then
        ReDim Preserve mExcludedFilters(lNum)
        ReDim Preserve mExcludedFilterKeys(lNum)
    End If
    mExcludedFiltersCount = lNum
End Sub
Public Property Get ExcludedFiltersCount() As Long
    ExcludedFiltersCount = mExcludedFiltersCount
End Property
Public Property Get ExcludedFiltersIndex(lIndex As Long) As Long
    ExcludedFiltersIndex = mExcludedFilters(lIndex)
End Property
Public Property Let ExcludedFiltersIndex(lIndex As Long, lMsg As Long)
    mExcludedFilters(lIndex) = lMsg
End Property
Public Property Get ExcludedFiltersKey(lIndex As Long) As String
    ExcludedFiltersKey = mExcludedFilterKeys(lIndex)
End Property
Public Property Let ExcludedFiltersKey(lIndex As Long, sKey As String)
    mExcludedFilterKeys(lIndex) = sKey
End Property

'//////////////////////////////////////////////////////////////////////////////


Public Sub SetNumIncludedFilters(lNum As Long)
    If lNum <> 0 Then
        ReDim Preserve mIncludedFilters(lNum)
        ReDim Preserve mIncludedFilterKeys(lNum)
    End If
    mIncludedFiltersCount = lNum
End Sub
Public Property Get IncludedFiltersCount() As Long
    IncludedFiltersCount = mIncludedFiltersCount
End Property
Public Property Get IncludedFiltersIndex(lIndex As Long) As Long
    IncludedFiltersIndex = mIncludedFilters(lIndex)
End Property
Public Property Let IncludedFiltersIndex(lIndex As Long, lMsg As Long)
    mIncludedFilters(lIndex) = lMsg
End Property
Public Property Get IncludedFiltersKey(lIndex As Long) As String
    IncludedFiltersKey = mIncludedFilterKeys(lIndex)
End Property
Public Property Let IncludedFiltersKey(lIndex As Long, sKey As String)
    mIncludedFilterKeys(lIndex) = sKey
End Property



Friend Function SetEqualTo(ob As cFilters)
    Dim lCount As Long
    
    With ob
        '// how many included filters does the ob have
        SetNumIncludedFilters .IncludedFiltersCount
        
        '// add that many filters to this object
        For lCount = 1 To mIncludedFiltersCount
            mIncludedFilterKeys(lCount) = .IncludedFiltersKey(lCount)
        Next lCount
        
        '// how many included filters does the ob have
        SetNumExcludedFilters .ExcludedFiltersCount
        
        '// add that many filters to this object
        For lCount = 1 To mExcludedFiltersCount
            mExcludedFilterKeys(lCount) = .ExcludedFiltersKey(lCount)
        Next lCount
        
    End With

End Function


Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage) As Boolean

    Dim lTemp As Long
    Dim lNumInclude As Long
    Dim lNumExclude As Long
    Dim lCount As Long
    Dim lSpace As Long
    Dim bSpace As Boolean
    Dim bHasKeyInfo As Boolean
    Dim sTemp As String
    
    '// How many messages are there?
    obSave.ReadWriteLong mIncludedFiltersCount
    lNumInclude = mIncludedFiltersCount
    
    '// Add procedures if necessary
    If Not bWriteDirection Then
        Call SetNumIncludedFilters(lNumInclude)
    End If
    
    '// Store the procedures
    For lCount = 1 To lNumInclude
        lTemp = mIncludedFilters(lCount)
        obSave.ReadWriteLong lTemp
        mIncludedFilters(lCount) = lTemp
    Next lCount
    '////////////////////////////////////////////////
    
    '// How many excluded messages are there?
    obSave.ReadWriteLong mExcludedFiltersCount
    lNumExclude = mExcludedFiltersCount
    
    '// Set if we are not saving...
    If Not bWriteDirection Then
        Call SetNumExcludedFilters(lNumExclude)
    End If
    
    '// Store the procedures
    For lCount = 1 To lNumExclude
        lTemp = mExcludedFilters(lCount)
        obSave.ReadWriteLong lTemp
        mExcludedFilters(lCount) = lTemp
    Next lCount
    '////////////////////////////////////////////////

    '// new space
    With obSave
        '// DAVE EDIT 2/9/99 '// added keys to the data file...
        '.ReadWriteLong lSpace
        If bWriteDirection Then
            bHasKeyInfo = True
        End If
        
        '// read or write the MIO information flag
        .ReadWriteBoolean bHasKeyInfo
        
        If bHasKeyInfo Then
            '// Read/Write the Keys for the included filters
            For lCount = 1 To lNumInclude
                sTemp = mIncludedFilterKeys(lCount)
                obSave.ReadWriteString sTemp
                mIncludedFilterKeys(lCount) = sTemp
            Next lCount
            
            '// Read/Write the Keys for the excluded filters
            For lCount = 1 To lNumExclude
                sTemp = mExcludedFilterKeys(lCount)
                obSave.ReadWriteString sTemp
                mExcludedFilterKeys(lCount) = sTemp
            Next lCount
        Else
            
            '// build the keys from indexes (excluded)
            '// (note we are always in the read direction for this part of the if/else
            For lCount = 1 To lNumInclude
                mIncludedFilterKeys(lCount) = "in" & mIncludedFilters(lCount)
            Next lCount
            
            '// build the keys from indexes (excluded)
            For lCount = 1 To lNumExclude
                mExcludedFilterKeys(lCount) = "in" & mExcludedFilters(lCount)
            Next lCount
            
        End If
        .ReadWriteBoolean bSpace
        '// DAVE EDIT ///////
        
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
    End With

End Function


Public Function CompileFilterIndexes(obIncomingMessages As cIncomingMessages) As Boolean
    
    Dim lCount As Long
    'Dim lNumItems As Long
    Dim bAllKeysAreGood As Boolean
    Dim sKey As String
    
    bAllKeysAreGood = True
    
    '// Check the included filters
    For lCount = 1 To mIncludedFiltersCount
        sKey = mIncludedFilterKeys(lCount)
        If obIncomingMessages.KeyExists(sKey) Then
            '// get it's index
            mIncludedFilters(lCount) = obIncomingMessages.ReturnIndexFromKey(sKey)
        Else
            mIncludedFilters(lCount) = 0
            bAllKeysAreGood = False
        End If
    Next lCount
    
    '// Check the included filters
    For lCount = 1 To mExcludedFiltersCount
        sKey = mExcludedFilterKeys(lCount)
        If obIncomingMessages.KeyExists(sKey) Then
            '// get it's index
            mExcludedFilters(lCount) = obIncomingMessages.ReturnIndexFromKey(sKey)
        Else
            mExcludedFilters(lCount) = 0
            bAllKeysAreGood = False
        End If
    Next lCount
    
    '// return/true or false
    CompileFilterIndexes = bAllKeysAreGood
    
End Function


Public Function AllowMessage(obspy As cicsSpy) As Boolean
Attribute AllowMessage.VB_UserMemId = 0
    Dim lCount As Long
    
    With obspy
        
        '// Check excluded messages first
        For lCount = 1 To mExcludedFiltersCount '// for each filter
            If .IncomingMessagePassed(mExcludedFilters(lCount)) Then
                AllowMessage = False
                Exit Function
            End If
        Next lCount
        
        If mIncludedFiltersCount = 0 Then   '// no more filters -> we passed
            AllowMessage = True
            Exit Function
        End If
    
        For lCount = 1 To mIncludedFiltersCount
            If .IncomingMessagePassed(mIncludedFilters(lCount)) Then
                AllowMessage = True
                Exit Function
            End If
        Next lCount
    End With
End Function

VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cIncomingMessage"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'// cIncomingMessage
Public Enum icsspyAutoResponseType
    icsspyRespondImmediately
    icsspyRespondFixedDelay
    icsspyRespondRandomDelay
End Enum

'// this is the new data structure for the filters
Private Type MessageFilter
    StatusValue As Long
    StatusMask As Long
    Header As Long
    HeaderMask As Long
    MiscData As Long
    MiscDataMask As Long
    ByteData(1 To 8) As Byte
    ByteDataMask(1 To 8) As Byte
    J1850HeaderLength As Long
    ByteDataLength As Long
End Type

Public Parent As cicsSpy                '// ref to parent object avail during run only
Private m_sKey As String
Private mMsg As MessageFilterLong

'// this objects data is implemented as a global structure
Private MyData As stIncomingMessage

'// Save the last two messages
Private mLastMsg As icsSpyMessageLong
Private mMsgBeforeLastMsg As icsSpyMessageLong

Private mUpdateScreen As Boolean        '// flag indicating this message should be updated on the UI
Private mvarInputIndex As Long          '// index of message only avaiable during run
Private mvarPresent As Boolean          '//

'// this event indicates the value of this message has changed
Public Event ValueChanged(ByVal newvalue As Variant)


Friend Property Let ItemByteArray(bArray() As Byte)
    Dim ob As New cBinaryStorage
    Dim lVersion As Long
    ob.WriteDirection = False
    ob.UseByteArray = True      '// setup for a byte array
    ob.Bytes = bArray
    Call Me.ReadWrite(False, ob, lVersion)
    ob.UseByteArray = False
End Property

Friend Property Get ItemByteArray() As Byte()
    Dim ob As New cBinaryStorage
    Dim lVersion As Long
    ob.WriteDirection = True
    ob.UseByteArray = True      '// setup for a byte array
    Call Me.ReadWrite(True, ob, lVersion)
    ItemByteArray = ob.Bytes
    ob.UseByteArray = False
End Property


Public Property Get Key() As String
    Key = m_sKey
End Property

Friend Property Let Key(ByVal sNew As String)
    m_sKey = sNew
End Property


Public Property Get PresentString() As String
    If mvarPresent Then
        PresentString = "Yes"
    Else
        PresentString = "No"
    End If
End Property
Public Property Get Present() As Boolean
    Present = mvarPresent
End Property
Public Property Let Present(bNew As Boolean)
    
    If mvarPresent <> bNew Then
        mvarPresent = bNew
        
        mUpdateScreen = True
        
        '// update the main object value cache
        If Not (Parent Is Nothing) Then
            '// set the cache value
            If Parent.MonitorOn Then
                Parent.IncomingMessagePresent(InputIndex) = mvarPresent
            End If
        End If
    End If
    
End Property

Public Property Get AutoRepondType() As icsspyAutoResponseType
    AutoRepondType = MyData.mvarResponseType
End Property
Public Property Let AutoRepondType(ByVal lType As icsspyAutoResponseType)
    MyData.mvarResponseType = lType
End Property

Public Property Get AutoRepondDelayOne() As Double
    AutoRepondDelayOne = MyData.mvarResponseDelayOne
End Property
Public Property Let AutoRepondDelayOne(ByVal dType As Double)
    MyData.mvarResponseDelayOne = dType
End Property

Public Property Get AutoRepondDelayTwo() As Double
    AutoRepondDelayTwo = MyData.mvarResponseDelayTwo
End Property
Public Property Let AutoRepondDelayTwo(ByVal dType As Double)
    MyData.mvarResponseDelayTwo = dType
End Property


Friend Property Get stData() As stIncomingMessage
    stData = MyData
End Property
Friend Property Let stData(stNewData As stIncomingMessage)
    MyData = stData
End Property

Friend Property Get InputIndex() As Long
    InputIndex = mvarInputIndex
End Property
Friend Property Let InputIndex(lNew As Long)
    mvarInputIndex = lNew
End Property
Public Property Get UpdateScreen() As Boolean
    UpdateScreen = mUpdateScreen
End Property
Public Sub UpdateScreenClear()
    mUpdateScreen = False
End Sub
'////////////////////////////////////////////////////////////////////////
Public Property Get DisplayColor() As Long
    DisplayColor = MyData.mvarDisplayColor
End Property
Public Property Let DisplayColor(lNew As Long)
    MyData.mvarDisplayColor = lNew
End Property
'////////////////////////////////////////////////////////////////////////
Public Property Get ResponseIndex() As Long
    ResponseIndex = MyData.mvarResponseIndex
End Property
Public Property Let ResponseIndex(lNew As Long)
    MyData.mvarResponseIndex = lNew
End Property
'////////////////////////////////////////////////////////////////////////
Public Property Get RequestIndex() As Long
    RequestIndex = MyData.mvarRequestIndex
End Property
Public Property Let RequestIndex(lNew As Long)
    MyData.mvarRequestIndex = lNew
End Property
'////////////////////////////////////////////////////////////////////////
'// this is the most powerful ///////////////////////////////////////////////////////
Public Property Get Status() As String
    Status = MyData.mStatusString
End Property
Public Property Let Status(sNew As String)
    MyData.mStatusString = sNew
End Property
'////////////////////////////////////////////////////////////////////////////////


Public Property Get RequestKey() As String
    RequestKey = MyData.mvarRequestKey
End Property
Public Property Let RequestKey(sNew As String)
    MyData.mvarRequestKey = sNew
End Property


Public Property Get ResponseKey() As String
    ResponseKey = MyData.mvarResponseKey
End Property
Public Property Let ResponseKey(sNew As String)
    MyData.mvarResponseKey = sNew
End Property


'// bNewValue indicates that this value has changed
Friend Sub PassedFilter(msg As icsSpyMessageLong, lResponseIndex As Long, lResponseDelay As Long, dResult As Double)
    
    Dim newvalue As Double
    Dim dDelay As Double
'    Dim lvalue As Long
'
'    '// Compile byte strings if necessary
'    If Not bCompiled Then
'        CompileByteStrings
'    End If
'
'    '// Only test this message if its source is the bus....
'    If mvarValueSource <> icsVSPYSourceBus Then
'        bEqualsLastByte = False
'        Exit Function
'    End If
'
'    '// Check the status byte first
'    lvalue = msg.StatusBitField And mMsg.StatusMask
'    If lvalue <> mMsg.StatusValue Then
'        '// This filter failed change the flag
'        bEqualsLastByte = False
'        Exit Function
'    End If
'
'
'
'    '// Check the header, first mask the don't care bits by setting them all to
'    '// zero
'    lvalue = msg.ArbIDOrHeader And mMsg.HeaderMask
'    If lvalue <> mMsg.Header Then
'        'This filter failed change the flag
'        bEqualsLastByte = False '// Set the equals last byte flag
'        Exit Function
'    Else
'        'the header passed, so check data bytes
'        'Check the first four data bytes, apply the mask and compare
'        lvalue = msg.DataMsb And mMsg.ByteDataMaskMsb '// change this
'        If lvalue <> mMsg.ByteDataMsb Then
'            'This filter failed
'            bEqualsLastByte = False '// Set the equals last byte flag
'            Exit Function
'        Else
'            'Check the last four data bytes, apply the mask and compare
'            lvalue = msg.DataLsb And mMsg.ByteDataMaskLsb
'            If lvalue <> mMsg.ByteDataLsb Then
'                bEqualsLastByte = False '// Set the equals last byte flag
'                Exit Function
'            End If
'        End If
'    End If
'    '////////////////////////////////////////////////////////////////////////////////////
'

    
    

    '// is the message an analog, digital, or none?
    If MyData.mvarEquation <> "" And MyData.mvarValueType <> icsVSPYNone Then
        '// We have an equation, evaluate it
        Call ParseExpression(False, MyData.mvarEquation, newvalue, msg, True, 0)
        
        msg.Value = newvalue
        msg.StatusBitField = msg.StatusBitField Or icsSpyStatusHasValue                 '// Set the value bit
        If MyData.mvarValueType = icsVSPYAnalogInput Then
            msg.StatusBitField = msg.StatusBitField And (Not icsSpyStatusValueIsBoolean)    '// clear the bool bit
        Else
            msg.StatusBitField = msg.StatusBitField Or icsSpyStatusValueIsBoolean     '// set the bool bit
        End If
        
        If newvalue <> MyData.mvarValue Then
            RaiseEvent ValueChanged(newvalue)   '// indicate that this analog input has changed
            MyData.mvarValue = newvalue
        End If
    Else
        '// if this is not an analog input, change its value to
        '// true to indicate it was received
        If MyData.mvarValueType <> icsVSPYAnalogInput Then
            If MyData.mvarValue <> True Then
                RaiseEvent ValueChanged(newvalue) '// indicate that this digital output has changed
                MyData.mvarValue = True
            End If
        End If
    End If
    
    '// save the message as the last message
    CopyData mLastMsg, mMsgBeforeLastMsg, Len(msg)
    CopyData msg, mLastMsg, Len(msg)
    
    mvarPresent = True  '// mark this message as present
    lResponseIndex = MyData.mvarResponseIndex
    If lResponseIndex <> 0 Then
        Select Case MyData.mvarResponseType
            Case 0 '// immediately
                lResponseDelay = 0
            Case 1 '// fixed delay
                lResponseDelay = CLng(MyData.mvarResponseDelayOne * 1000)
            Case 2 '// random delay
                dDelay = Rnd * (MyData.mvarResponseDelayTwo - MyData.mvarResponseDelayOne) + MyData.mvarResponseDelayOne
                lResponseDelay = CLng(dDelay * 1000)
        End Select
    End If
        
    dResult = MyData.mvarValue
    mUpdateScreen = True    '// indicate that we need to update the screen
    
End Sub

Public Property Get UpdateRate() As Double
    Dim dTimeRecent As Double
    Dim dTimeLast As Double
    Dim StartTime As SpyMsgTime
    Dim StopTime As SpyMsgTime
    
    With StartTime
        .HardwareTimeMs = mMsgBeforeLastMsg.TimeHardware
        .HardwareTimePresent = HardwareTimePresent(mMsgBeforeLastMsg)
        .SystemTimeMs = mMsgBeforeLastMsg.TimeSystem
    End With
    
    With StopTime
        .HardwareTimeMs = mLastMsg.TimeHardware
        .HardwareTimePresent = HardwareTimePresent(mLastMsg)
        .SystemTimeMs = mLastMsg.TimeSystem
    End With
    
    '// do not return an update rate unless we have a value start and stop time
    If StartTime.SystemTimeMs = 0 Or StopTime.SystemTimeMs = 0 Then
        UpdateRate = 0
    Else
        UpdateRate = GetSpyTimeSec(StartTime, StopTime)
    End If
    
End Property

Public Sub ClearLastMessage()
    
    If mMsgBeforeLastMsg.TimeSystem <> 0 Then
        With mMsgBeforeLastMsg
            .TimeSystem = 0
            .TimeHardware = 0
            .NumberBytesData = 0
            .NumberBytesHeader = 0
        End With
        mUpdateScreen = True
    End If
    
    If mLastMsg.TimeSystem <> 0 Then
        With mLastMsg
            .TimeHardware = 0
            .TimeSystem = 0
            .NumberBytesData = 0
            .NumberBytesHeader = 0
        End With
        mUpdateScreen = True    '// indicate that we need to update the screen
    End If
    
End Sub

Private Function HardwareTimePresent(msg As icsSpyMessageLong)
    HardwareTimePresent = (msg.StatusBitField And icsSpyStatusHardwareTimePresent) <> 0
End Function
Public Property Get LastMessageBytes() As Variant
    Dim bMsg() As Byte
    Dim lNum As Long
    lNum = Len(mLastMsg)                '// how big are the message bytes
    ReDim bMsg(1 To lNum)               '// redim the array
    CopyData mLastMsg, bMsg(1), lNum    '// copy the message into the bytes
    LastMessageBytes = bMsg             '// return the byte array
End Property

Public Property Get LastMessageData() As icsSpyMessageLong
    LSet LastMessageData = mLastMsg
End Property

Friend Property Get MessageFilter() As MessageFilterLong
    MessageFilter = mMsg
End Property

Public Property Get MessageBeforeLastMessageBytes() As Variant
    Dim bMsg() As Byte
    Dim lNum As Long
    lNum = Len(mMsgBeforeLastMsg)               '// how big are the message bytes
    ReDim bMsg(1 To lNum)                       '// redim the array
    CopyData mMsgBeforeLastMsg, bMsg(1), lNum   '// copy the message into the bytes
    MessageBeforeLastMessageBytes = bMsg        '// return the byte array
End Property

'// this returns a string based on the mask bytes ////////////////////////
Public Property Get DataByteString(lByte As Long) As String
    DataByteString = MyData.mByteString(lByte)
End Property
'// this function takes the entry and places it in a string
Public Property Let DataByteString(lByte As Long, sNew As String)
    MyData.mByteString(lByte) = UCase(sNew)
End Property
'////////////////////////////////////////////////////////////////



    
Friend Sub CompileByteStrings()

    Dim msg As spyFilterJ1850
    Dim canmsg As MessageFilter
    Dim lCount As Long
    
    '// setup the request index
    With Parent.OutgoingMessages
        MyData.mvarRequestIndex = .ReturnIndexFromKey(MyData.mvarRequestKey)
        MyData.mvarResponseIndex = .ReturnIndexFromKey(MyData.mvarResponseKey)
    End With
    
    '// Complile the status byte
    If Len(MyData.mStatusString) = 34 Then '// is it 32 bits long plus a #b
        Call Build32BitMaskAndValue(MyData.mStatusString, msg.StatusMask, msg.StatusValue)
    End If

    '// is this a CAN message or a J1850 one
    If Parent.Protocol = icsVSPYProtocolCAN Then
        '// Setup the CAN Arb ID
        If Len(MyData.mByteString(1)) = 34 Then '// its bit encoded
            LSet canmsg = msg
            Call Build32BitMaskAndValue(MyData.mByteString(1), canmsg.HeaderMask, canmsg.Header)
            LSet msg = canmsg
        Else    '// its just a decimal number
            LSet canmsg = msg
            If Trim$(MyData.mByteString(1)) = "" Or Trim$(MyData.mByteString(1)) = "X" Then
                canmsg.Header = 0
                canmsg.HeaderMask = 0
                LSet msg = canmsg
            Else
                canmsg.Header = Val(MyData.mByteString(1))
                'canmsg.HeaderMask = Val(MyData.mByteString(1))
                LSet msg = canmsg
                msg.J1850HeaderMask(1) = &HFF
                msg.J1850HeaderMask(2) = &HFF
                msg.J1850HeaderMask(3) = &HFF
                msg.J1850HeaderMask(4) = &HFF
            End If
        End If
    Else
        '// Setup the J1850 Header
        For lCount = 1 To 3
            Call SetupByteIndex(lCount, msg.J1850HeaderMask(lCount), msg.J1850Header(lCount))
        Next lCount
    End If
    
    
    '// Setup the data bytes
    For lCount = 1 To 8
        Call SetupByteIndex(lCount + 3, msg.ByteDataMask(lCount), msg.ByteData(lCount))
    Next lCount
       
    LSet mMsg = msg
    'bCompiled = True
    
End Sub

Friend Property Get stJ1850FilterStructure() As spyFilterJ1850
    LSet stJ1850FilterStructure = mMsg
End Property


Private Sub Build32BitMaskAndValue(sString As String, Mask As Long, Value As Long)
    Dim lCount As Long
    Dim sBit As String
    Dim lBitCount As Long
    
    Mask = 0
    Value = 0
    For lCount = 34 To 4 Step -1    '// All the bits in the string except one
        '// Get the bit of the string
        sBit = UCase(Mid$(sString, lCount, 1))
        
        '// Handle the mask
        If sBit <> "X" Then
            Mask = Mask + 2 ^ lBitCount
        End If
        If sBit = "1" Then
            Value = Value + 2 ^ lBitCount
        End If
        
        '// increment the bitcount
        lBitCount = lBitCount + 1
    Next lCount
End Sub

Private Sub Build8BitMaskAndValue(sString As String, Mask As Byte, Value As Byte)
    Dim lCount As Long
    Dim sBit As String
    Dim lBitCount As Long
    
    Mask = 0
    Value = 0
    For lCount = 10 To 3 Step -1    '// All the bits in the
        '// Get the bit of the string
        sBit = UCase(Mid$(sString, lCount, 1))
        
        '// Handle the mask
        If sBit <> "X" Then
            Mask = Mask + 2 ^ lBitCount
        End If
        If sBit = "1" Then
            Value = Value + 2 ^ lBitCount
        End If
        
        '// increment the bitcount
        lBitCount = lBitCount + 1
    Next lCount
End Sub


Private Sub SetupByteIndex(lCount As Long, lMask As Byte, lValue As Byte)
    Dim sNew As String
    Dim ValueMsd As Byte
    Dim ValueLsd As Byte
    Dim MaskMsd As Byte
    Dim MaskLsd As Byte
    
    Dim sTemp As String
    
    sNew = MyData.mByteString(lCount)
        
    If Len(sNew) = 10 Then  'it is bit encoded
        Call Build8BitMaskAndValue(sNew, lMask, lValue)
    Else
        If Len(sNew) = 2 Then   '// how long is the string
    
            '// since it is 2 bytes, we know there is a msd present...
            sTemp = Mid(sNew, 1, 1) '// get the first character in the string (the msd)

            If sTemp = "x" Or sTemp = "X" Then  '// is it a wild card
                MaskMsd = 0
                ValueMsd = 0
            Else
                MaskMsd = &HF      '// its value is the mask and the value
                ValueMsd = Val("&H" & sTemp)
            End If
    
            sTemp = Mid(sNew, 2, 1) '// get the second character in the string (the lsd)
            If sTemp = "x" Or sTemp = "X" Then  '// is it a wild card?
                MaskLsd = 0
                ValueLsd = 0
            Else
                MaskLsd = &HF      '// its value is the mask and the value
                ValueLsd = Val("&H" & sTemp)
            End If
    
        Else
            
            If Len(sNew) = 1 Then   '// there is only one char (the lsd)
    
                '// Default the MSD to a wildcard
                MaskMsd = 0
                ValueMsd = 0
    
                sTemp = Mid(sNew, 1, 1) '
                If sTemp = "x" Or sTemp = "X" Then
                    MaskLsd = 0
                    ValueLsd = 0
                Else
                    MaskLsd = &HF     '// its value is the mask and the value
                    ValueLsd = Val("&H" & sTemp)
                End If
            Else
                '// there were no chararcters in the string default to wild cards
                MaskLsd = 0
                ValueLsd = 0
                MaskMsd = 0
                ValueMsd = 0
            End If
        End If
        
        lValue = ValueMsd * 16 + ValueLsd
        lMask = MaskMsd * 16 + MaskLsd
    End If
    
    
    
End Sub

'// This stores this object to a stream
Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage, lVersion As Long) As Boolean

Call ReadWriteVer1000(bWriteDirection, obSave)

'// indicate a readwrite is needed
mUpdateScreen = True

End Function
'///////////


Private Sub ReadWriteVer1000(bWriteDirection As Boolean, obSave As cBinaryStorage)
    Dim lSpace As Long
    Dim dSpace As Double
    Dim sSpace As String
    Dim lCount As Long
    

    With obSave
        .ReadWriteString MyData.mvarDescription
        .ReadWriteLong MyData.mvarValueType
        .ReadWriteLong MyData.mvarValueSource
        .ReadWriteString MyData.mvarEquation
        
        '// DAVEEDIT 2/8/99 ////////////
        If bWriteDirection Then
            MyData.mvarRequestIndex = 0
            MyData.mvarResponseIndex = 0
        End If
        '//////////////////////////////
        
        .ReadWriteLong MyData.mvarRequestIndex
        .ReadWriteLong MyData.mvarResponseIndex
        
        .ReadWriteString MyData.mvarFormat
        .ReadWriteDouble MyData.mvarUpperRange
        .ReadWriteDouble MyData.mvarLowerRange
        .ReadWriteLong MyData.mvarDisplayColor
        
        .ReadWriteString MyData.mvarUnitString
        .ReadWriteString MyData.mStatusString
        
        
        '// add padding //////////////////////////////
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        '////////////////////////////////////////////////
        
        '.. new padding
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
        .ReadWriteLong lSpace
            
            '/// DAVE EDIT start 1/26/99 ////
        '.ReadWriteLong lSpace
        .ReadWriteLong MyData.mvarResponseType
            '/// DAVE EDIT stop 1/26/99 ////
        
            '/// DAVE EDIT start 1/26/99 ////
        '.ReadWriteDouble dSpace
        '.ReadWriteDouble dSpace
        .ReadWriteDouble MyData.mvarResponseDelayOne
        .ReadWriteDouble MyData.mvarResponseDelayTwo
            '/// DAVE EDIT stop 1/26/99 ////
            
        .ReadWriteDouble dSpace
        .ReadWriteDouble dSpace
        .ReadWriteDouble dSpace
        .ReadWriteDouble dSpace
        .ReadWriteDouble dSpace
        .ReadWriteDouble dSpace
        .ReadWriteDouble dSpace
        .ReadWriteString sSpace
        .ReadWriteString sSpace
        .ReadWriteString sSpace
        
            '// DAVEEDIT 2/8/99
        .ReadWriteString MyData.mvarRequestKey
        .ReadWriteString MyData.mvarResponseKey
        
        '// received the indexes
        If Not bWriteDirection Then
            If MyData.mvarRequestIndex <> 0 Then
                MyData.mvarRequestKey = "out" & MyData.mvarRequestIndex
            End If
            If MyData.mvarResponseIndex <> 0 Then
                 MyData.mvarRequestKey = "out" & MyData.mvarResponseIndex
            End If
        End If
        '// DAVEEDIT 2/8/99
            
        '// Write the byte descriptions to whereever
        For lCount = 1 To 20
            .ReadWriteString MyData.mByteString(lCount)
        Next lCount
    End With
    
End Sub

Private Sub Class_Initialize()
    MyData.mvarValueType = icsVSPYNone
    MyData.mStatusString = "#bXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
End Sub

Public Property Get ValueTypeString() As String
    Select Case MyData.mvarValueType
        Case icsVSPYAnalogInput
            ValueTypeString = "Analog In"
        Case icsVSPYDigitalInput
            ValueTypeString = "Digital In"
        Case icsVSPYStateEncoded
            ValueTypeString = "State Encoded"
        Case icsVSPYASCII
            ValueTypeString = "ASCII"
        Case icsVSPYNone
            ValueTypeString = "None"
    End Select
End Property

