Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Option Explicit

'// Performance monitoring/setting object
'// Copyright 1999 Intrepid Control Systems, Inc. All rights reserved
'// www.intrepidcs.com

Public Enum icsspyPerformanceTextMonitor
    icsspyPerformanceMonitorForceUpdates
    icsspyPerformanceMonitorAttemptButYield
    icsspyPerformanceMonitorDoNotAttempt
End Enum

Public Enum icsspyPerformanceMainEngineSetup
    icsspyPerformanceRunInTightLoop
    icsspyRunInWindowsTimerLoop
End Enum

'// member variables that do not get stored anyther
Private m_lDisplayUpdateRateMs As Long
Private m_lDisplayUpdateRateMsMax As Long
Private m_lDisplayUpdateRateMsMin As Long
Private m_lDisplayUpdateRateCount As Long
Private m_dDisplayUpdateRateSum As Double

Private m_lPollIntervalMs As Long
Private m_lPollIntervalMsMax As Long
Private m_lPollIntervalMsMin As Long
Private m_lPollIntervalMsCount As Long
Private m_dPollIntervalMsSum As Double

'// parameters
Public MainEngineSetup As icsspyPerformanceMainEngineSetup
Public ProcessSleepTimeMs As Long
Public TextMonitorUpdateRateMs As Long
Public TextMonitorUpdateType As icsspyPerformanceTextMonitor


Const defMainEngineSetup As Long = icsspyPerformanceRunInTightLoop
Const defProcessSleepTimeMs As Long = 0
Const defTextMonitorUpdateRateMs As Long = 0
Const defTextMonitorUpdateType As Long = icsspyPerformanceMonitorForceUpdates

Public Sub MakeNew()
    '// read the settings from the registry
    MainEngineSetup = GetSetting("icsVSpy", "Defaults", "PerformanceMainEngineSetup", defMainEngineSetup)
    ProcessSleepTimeMs = GetSetting("icsVSpy", "Defaults", "PerformanceProcessSleepTimeMs", defProcessSleepTimeMs)
    TextMonitorUpdateRateMs = GetSetting("icsVSpy", "Defaults", "PerformanceTextMonitorUpdateRateMs", defTextMonitorUpdateRateMs)
    TextMonitorUpdateType = GetSetting("icsVSpy", "Defaults", "PerformanceTextMonitorUpdateType", defTextMonitorUpdateType)
End Sub


Public Sub SaveCurrentValuesAsDefault()
    Call SaveSetting("icsVSpy", "Defaults", "PerformanceMainEngineSetup", MainEngineSetup)
    Call SaveSetting("icsVSpy", "Defaults", "PerformanceProcessSleepTimeMs", ProcessSleepTimeMs)
    Call SaveSetting("icsVSpy", "Defaults", "PerformanceTextMonitorUpdateRateMs", TextMonitorUpdateRateMs)
    Call SaveSetting("icsVSpy", "Defaults", "PerformanceTextMonitorUpdateType", TextMonitorUpdateType)
End Sub

Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage, lVersion As Long) As Boolean
    'this is it
    Dim vData As Variant
    Dim obPB As New PropertyBag
    Dim vDummy As Variant
    Dim vReturn As Variant
        
    
    If bWriteDirection Then
        
        '// first, write the properties into the bag
        With obPB
            .WriteProperty "MainEngineSetup", MainEngineSetup, defMainEngineSetup
            .WriteProperty "ProcessSleepTimeMs", ProcessSleepTimeMs, defProcessSleepTimeMs
            .WriteProperty "TextMonitorUpdateRateMs", TextMonitorUpdateRateMs, defTextMonitorUpdateRateMs
            .WriteProperty "TextMonitorUpdateType", TextMonitorUpdateType, defTextMonitorUpdateType
        End With


        '// return the contents of the bag
        vData = obPB.Contents
        
        '// write the array with the binary storage object
        obSave.ReadWriteArray vData
        
    Else
        '// read the array from the binary storage object
        obSave.ReadWriteArray vDummy, vReturn
        
    
        '// fill the property bag if there is somethign in the return array
        If Not IsEmpty(vReturn) Then
            
            '// fill the property bag with the data
            obPB.Contents = vReturn
            
            '// read the data out of the property bag
            With obPB
                MainEngineSetup = .ReadProperty("MainEngineSetup", defMainEngineSetup)
                ProcessSleepTimeMs = .ReadProperty("ProcessSleepTimeMs", defProcessSleepTimeMs)
                TextMonitorUpdateRateMs = .ReadProperty("TextMonitorUpdateRateMs", defTextMonitorUpdateRateMs)
                
                TextMonitorUpdateType = .ReadProperty("TextMonitorUpdateType", defTextMonitorUpdateType)
            End With
        End If
    End If
    

End Function


Friend Property Let DisplayUpdateRateMs(lNew As Long)
    m_lDisplayUpdateRateMs = lNew
    If m_lDisplayUpdateRateCount = 0 Then
        m_lDisplayUpdateRateMsMax = lNew
        m_lDisplayUpdateRateMsMin = lNew
    Else
        If lNew > m_lDisplayUpdateRateMsMax Then m_lDisplayUpdateRateMsMax = lNew
        If lNew < m_lDisplayUpdateRateMsMin Then m_lDisplayUpdateRateMsMin = lNew
    End If
    m_lDisplayUpdateRateCount = m_lDisplayUpdateRateCount + 1
    m_dDisplayUpdateRateSum = m_dDisplayUpdateRateSum + CDbl(lNew)
End Property

Public Property Get DisplayUpdateRateMax() As Long
    DisplayUpdateRateMax = m_lDisplayUpdateRateMsMax
End Property
Public Property Get DisplayUpdateRateMin() As Long
    DisplayUpdateRateMin = m_lDisplayUpdateRateMsMin
End Property
Public Property Get DisplayUpdateRateMean() As Double
    If m_lDisplayUpdateRateCount > 0 Then
    DisplayUpdateRateMean = CLng(m_dDisplayUpdateRateSum / CDbl(m_lDisplayUpdateRateCount))
    End If
End Property
Public Property Get DisplayUpdateRateMs() As Long
    DisplayUpdateRateMs = m_lDisplayUpdateRateMs
End Property

Public Sub ResetDisplayUpdateRate()
    m_lDisplayUpdateRateCount = 0
    m_dDisplayUpdateRateSum = 0
End Sub



Friend Property Let PollIntervalMs(lNew As Long)
    m_lPollIntervalMs = lNew
    If m_lPollIntervalMsCount = 0 Then
        m_lPollIntervalMsMax = lNew
        m_lPollIntervalMsMin = lNew
    Else
        If lNew > m_lPollIntervalMsMax Then m_lPollIntervalMsMax = lNew
        If lNew < m_lPollIntervalMsMin Then m_lPollIntervalMsMin = lNew
    End If
    m_lPollIntervalMsCount = m_lPollIntervalMsCount + 1
    m_dPollIntervalMsSum = m_dPollIntervalMsSum + CDbl(lNew)
End Property

Public Property Get PollIntervalMsMax() As Long
    PollIntervalMsMax = m_lPollIntervalMsMax
End Property
Public Property Get PollIntervalMsMin() As Long
    PollIntervalMsMin = m_lPollIntervalMsMin
End Property
Public Property Get PollIntervalMsMean() As Double
    If m_lPollIntervalMsCount > 0 Then
        PollIntervalMsMean = CLng(m_dPollIntervalMsSum / CDbl(m_lPollIntervalMsCount))
    End If
End Property
Public Property Get PollIntervalMs() As Long
    PollIntervalMs = m_lPollIntervalMs
End Property

Public Sub ResetPollIntervalMs()
    m_lPollIntervalMsCount = 0
    m_dPollIntervalMsSum = 0
End Sub



Private Sub Class_Initialize()
MakeNew
End Sub
