Private Sub Form_Initialize()
   
    
    Set mmSound = New cSoundMCI
    Set mmSound.MultiMediaControl = MMControl1
    Set obScl = New cMonitorScroll

    
    Set UI = New cCustomUI
    With UI
        Set .pctUIPanel = pctDisplay
        Set .lbllocation = lbllocation
        Set .pctToolTip = pctLocation
        Set .sMove = sMove
        .mGridValue = 100
        .mGridScaleM = 0.01
        .mFormatString = "0"
        .mBoxOutlineColor = vbWhite
    End With
    
    
    
    
End Sub

'// Setup the toolbar with pretty images
Public Sub LoadToolBarFromResource()


    '// Load the bitmaps into the image list from the resourse file
    With imgToolbar.ListImages
        .Add , , LoadResPicture(IDB_RUN, vbResBitmap)
        .Add , , LoadResPicture(IDB_STOP, vbResBitmap)
        .Add , , LoadResPicture(IDB_SCROLL, vbResBitmap)
        .Add , , LoadResPicture(IDB_FILTER, vbResBitmap)
        .Add , , LoadResPicture(IDB_MESSAGE, vbResBitmap)
        .Add , , LoadResPicture(IDB_FILTERON, vbResBitmap)
        .Add , , LoadResPicture(IDB_ADD, vbResBitmap)
        .Add , , LoadResPicture(IDB_DELETE, vbResBitmap)
        .Add , , LoadResPicture(IDB_CHART, vbResBitmap)
        .Add , , LoadResPicture(IDB_MONSAVE, vbResBitmap)
        .Add , , LoadResPicture(IDB_MONDELETE, vbResBitmap)
        .Add , , LoadResPicture(IDB_MONFILTERS, vbResBitmap)
        .Add , , LoadResPicture(IDB_MONPAUSE, vbResBitmap)
        .Add , , LoadResPicture(IDB_REL, vbResBitmap)
        .Add , , LoadResPicture(IDB_NOTEST, vbResBitmap)
        .Add , , LoadResPicture(IDB_LOGBOOK, vbResBitmap)
        .Add , , LoadResPicture(IDB_MONEDIT, vbResBitmap)
        .Add , , LoadResPicture(IDB_EXPLORE, vbResBitmap)
        .Add , , LoadResPicture(IDB_SORTASCENDING, vbResBitmap)
        .Add , , LoadResPicture(IDB_SORTDESCENDING, vbResBitmap)
    End With
    
    Set tb.ImageList = imgToolbar
    Set tbMonitor.ImageList = imgToolbar
    
    '// Set the tool bar images
    With tb
        .Buttons("start").Image = 1
        .Buttons("stop").Image = 2
        .Buttons("viewscroll").Image = 3
        .Buttons("viewfilter").Image = 4
        .Buttons("viewmsg").Image = 5
        '.Buttons("testsetup").Image = 6
        .Buttons("add").Image = 7
        .Buttons("delete").Image = 8
        .Buttons("viewchart").Image = 9
        .Buttons("viewnotes").Image = 16
        .Buttons("explore").Image = 18
        .Buttons("sorta").Image = 19
        .Buttons("sortd").Image = 20
    End With
    
    With tbMonitor
        .Buttons("save").Image = 10
        .Buttons("clear").Image = 11
        .Buttons("filterson").Image = 12
        .Buttons("pause").Image = 13
        .Buttons("relative").Image = 14
        '.Buttons("testbuffer").Image = 15
        .Buttons("viewfilters").Image = 17
        
    End With

End Sub

Public Sub UpdateMonitorDisplay(bForceUpdate As Boolean)
    
    Dim pct As PictureBox
    Dim lCount As Long
    Dim lNumItems As Long
    Dim sgLeft As Single
    Dim buff As cBuffer
    Dim CanMode As Boolean
    Dim lNumberOfDisplayedLines As Long
    Dim lTextHeight As Long
    Dim lScaleWidth As Long
    Dim lDefaultColor As Long
    
    '// create some temporary references
    If obApp.MonitorOn And obApp.Performance.TextMonitorUpdateType = icsspyPerformanceMonitorDoNotAttempt Then
        Exit Sub
    End If
    
    
    
    Set pct = pctDraw
    Set buff = obApp.Monitor.Buffer

    
    '// update the tests and values grid
    UpdateTestDisplay
    UpdateMessageMonitorDisplay

    With obApp.Monitor
        If buff.UpdateScreen Or bForceUpdate Then
    
            'imlTransmit.BackColor = .BackColor
            
            '// set the font
            pct.FontName = .FontName
            pct.FontSize = .FontSize
            pct.FontBold = .FontBold
            pct.FontItalic = .FontItalic
            pctRead.FontName = .FontName
            pctRead.FontSize = .FontSize
            pctRead.FontItalic = .FontItalic
            pctRead.FontBold = .FontBold
            
            lDefaultColor = .ForeColor
            
            '// Are we in CAN mode
            CanMode = obApp.Protocol = icsVSPYProtocolCAN
            pct.Cls '// clear the drawing area
          
            '// Draw the message data
            lTextHeight = pct.TextHeight("A")
            lNumberOfDisplayedLines = NumberOfDisplayedLines
        
            '// Print the first header line
            Call PrintHeaderLine(pct, lDefaultColor, CanMode)
            
'        Dim ltime As Long
'
'            ltime = timeGetTime
            If .Paused Then
                Call buff.PrintBufferInPctBox(obApp, imlTransmit, pct, _
                       lNumberOfDisplayedLines, .SpyMsgTime, _
                    obScl.lNumBeforeStartIndex, obScl.lStartPointMsgNumber, _
                    obScl.lStartMsgPointer, CanMode, .RelativeTimeStamping, lDefaultColor)
            Else
                Call buff.PrintBufferInPctBox(obApp, imlTransmit, pct, _
                lNumberOfDisplayedLines, .SpyMsgTime, -1, 0, 0, CanMode, _
                .RelativeTimeStamping, lDefaultColor)
            End If
            'Debug.Print "Update : " & Abs(timeGetTime - ltime)
            
            '// draw the highlight bar
            DrawHightLightBar pct, False
        
            '// Paint the picture to the display
            pctRead.PaintPicture pct.Image, 0, 0 '// transfer the bitmap to the screen
        
            
            UpdateBufferPointer     '// update the buffer pointer
            buff.UpdateScreenClear  '// clear the update screen flag
            
        End If
    End With 'oapp.monitor
    
    
End Sub

Private Sub UpdateBufferPointer()
    cwsBuffer.Pointers(2).Value = obApp.Monitor.Buffer.PointerPercent
    cwsBuffer.Pointers(1).Value = obApp.Monitor.Buffer.PercentFull

End Sub

Private Sub DrawHightLightBar(pct As PictureBox, bEraseOld As Boolean)
    Dim lNum As Long
    Dim lTextHeight As Long
    Dim lScaleWidth As Long
    Dim lNumberOfDisplayedLines As Long
    Dim lDefaultColor As Long
    
    
    '// Draw the message data
    lTextHeight = pct.TextHeight("A")
    lNumberOfDisplayedLines = NumberOfDisplayedLines()
     
    '// Draw the highlight box
    lNum = MouseY \ lTextHeight
    If lNum <= 1 Then lNum = 1
    If lNum > lNumberOfDisplayedLines Then lNum = lNumberOfDisplayedLines
    
    If lNum > obApp.Monitor.Buffer.NumberItems Then
         lCurrentMessageHighlighted = 0
    Else
        If obApp.Monitor.Paused Then
            If obApp.Monitor.Buffer.NumberItems > obApp.Monitor.Buffer.BufferLength Then
                lCurrentMessageHighlighted = lNum + obScl.lStartPointMsgNumber + obScl.lNumBeforeStartIndex - lNumberOfDisplayedLines - obApp.Monitor.Buffer.BufferLength
            Else
                If obScl.lNumBeforeStartIndex > lNumberOfDisplayedLines Then
                    lCurrentMessageHighlighted = lNum + obScl.lNumBeforeStartIndex - lNumberOfDisplayedLines
                Else
                    If lNum <= obScl.lNumBeforeStartIndex Then
                        lCurrentMessageHighlighted = lNum
                    Else
                        lCurrentMessageHighlighted = 0
                    End If
                End If
            End If
        Else
            If lNumberOfDisplayedLines > obApp.Monitor.Buffer.NumberItems Then
                lCurrentMessageHighlighted = lNum
            Else
                lCurrentMessageHighlighted = lNum + obApp.Monitor.Buffer.NumberItems - lNumberOfDisplayedLines
            End If
        End If
    End If
    
    
    Dim msg As icsSpyMessageLong
    Dim Jmsg As icsSpyMessageJ1850
    
    If lCurrentMessageHighlighted <> 0 Then
        If obApp.Monitor.Buffer.GetElement(msg, lCurrentMessageHighlighted) Then
            
            RaiseEvent NewMessageSelected(msg) '// indicate a message was select
            
            LSet Jmsg = msg
            If msg.DescriptionID > 0 And msg.DescriptionID <= obApp.IncomingMessages.Count Then
                lDefaultColor = obApp.IncomingMessages(msg.DescriptionID).DisplayColor
                If lDefaultColor = 0 Then lDefaultColor = obApp.Monitor.ForeColor
                If lLastValueHighlight <> msg.DescriptionID Then
                    
                    With gValues
                        .Redraw = False
                    
                        '// return the last cell to the original color
                        If lLastValueHighlight <> 0 And lLastValueHighlight < .Rows Then
                            .Row = lLastValueHighlight
                            .RowSel = lLastValueHighlight
                            .Col = 0
                            .ColSel = 0
                            .CellBackColor = vbWhite
                            .CellForeColor = vbBlack
                        End If
                    
                        '// now highlight the new cell - if necessary
                        If mnuMonitorTrack.Checked Then
                            If Not .RowIsVisible(msg.DescriptionID) Then
                                .TopRow = msg.DescriptionID
                            End If
                        End If
                        
                        If msg.DescriptionID <= .Rows Then
                            .Row = msg.DescriptionID
                            .RowSel = msg.DescriptionID
                            .Col = 0
                            .ColSel = 0
                            .CellBackColor = vbBlue
                            .CellForeColor = vbWhite
                        End If
                        
                        .Redraw = True
                    End With
                    
                    '// remember this cell
                    lLastValueHighlight = msg.DescriptionID
                    
                End If
            Else
                lDefaultColor = obApp.Monitor.ForeColor
            End If
        End If
    End If
    
    
    lScaleWidth = pct.ScaleWidth
    
    
    
    
    If bEraseOld Then
        pct.DrawStyle = lOldDrawStyle
        If Not lLastRowFirst Then
            pct.Line (0, lOldStartX)-(lOldEndX, lOldStartX), pct.BackColor
        End If
        
        pct.Line (0, lOldEndY)-(lOldEndX, lOldEndY), pct.BackColor
        '// the block
        pct.DrawMode = vbXorPen
        pct.Line (0, lOldStartX)-(lOldEndX, lOldEndY), &H200000, BF '
        pct.DrawMode = vbCopyPen
    End If
    
    
    '// draw the new one
    lOldStartX = lNum * lTextHeight
    lOldEndX = lScaleWidth
    lOldEndY = (lNum + 1) * lTextHeight
    lLastRowFirst = lNum = 1

    If Not (ActiveControl Is Nothing) Then
        If ActiveControl.Name = "pctRead" Then
            lOldDrawStyle = vbSolid
        Else
            lOldDrawStyle = vbDot
        End If
    Else
        lOldDrawStyle = vbDot
    End If
    pct.DrawStyle = lOldDrawStyle
    If Not lLastRowFirst Then
        pct.Line (0, lOldStartX)-(lOldEndX, lOldStartX), lDefaultColor
    End If
    pct.Line (0, lOldEndY)-(lOldEndX, lOldEndY), lDefaultColor
    
    '// the block
    pct.DrawMode = vbXorPen
    pct.Line (0, lOldStartX)-(lOldEndX, lOldEndY), &H200000, BF   '
    pct.DrawMode = vbCopyPen '// return to the copy pen
    pct.DrawStyle = vbSolid
    
End Sub

Private Function NumberOfDisplayedLines() As Long
    Dim lNumberOfDisplayedLines As Long
    Dim lTextHeight As Long
    lTextHeight = pctRead.TextHeight("A")
    lNumberOfDisplayedLines = (pctRead.ScaleHeight - 1 * lTextHeight) \ lTextHeight
    NumberOfDisplayedLines = lNumberOfDisplayedLines
End Function

'// Handle the Function keys for the Manual TX buttons ////////////////////////////////////
Private Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)
    
    '// manual tx buttons
    If (Shift And vbCtrlMask) > 0 Or (Shift And vbAltMask) > 0 Then
    
        Exit Sub
    End If
    
    
    
    Select Case KeyCode
        Case vbKeyF1
            Set tbsTX.SelectedItem = tbsTX.Tabs(2)
        Case vbKeyF2
            Set tbsTX.SelectedItem = tbsTX.Tabs(3)
        Case vbKeyF3
            Set tbsTX.SelectedItem = tbsTX.Tabs(4)
        Case vbKeyF4
            Set tbsTX.SelectedItem = tbsTX.Tabs(5)
        Case vbKeyF5
            Set tbsTX.SelectedItem = tbsTX.Tabs(6)
        Case vbKeyF6
            Set tbsTX.SelectedItem = tbsTX.Tabs(7)
        Case vbKeyF7
            Set tbsTX.SelectedItem = tbsTX.Tabs(8)
        Case vbKeyF8
            Set tbsTX.SelectedItem = tbsTX.Tabs(9)
        Case vbKeyX
            Set tbsTX.SelectedItem = tbsTX.Tabs(1)
        Case vbKeyF11
            mnuMonitorPaused_Click
    End Select
    
    
    Select Case CurrentView
        Case icsSpyGraphicalView
            Select Case KeyCode
                Case vbKeyV
                    CurrentView = icsSpyTextView
                Case vbKeyI
                    mnuViewFilters_Click
                Case vbKeyO
                    mnuViewMessages_Click
            End Select
        
        Case icsSpyTextView
            Select Case KeyCode
                Case vbKeySpace, vbKeyP
                    mnuMonitorPaused_Click
                Case vbKeyC, vbKeyD
                    mnuMonitorDelete_Click
                Case vbKeyS
                    '// make sure its not CTRL S
                    If Not ((Shift And vbCtrlMask) > 0) Then
                        mnuMonitorSave_Click
                    End If
                Case vbKeyV
                    '// switch to graphical monitor only if it is enabled
                    If obApp.UIShowGraphicalMonitor Then
                        CurrentView = icsSpyGraphicalView
                    End If
                Case vbKeyB
                    ShowNextBuffer
                Case vbKeyE
                    MousePointer = vbHourglass
                    obApp.Monitor.ShowFiltersSetupForm obApp
                    MousePointer = vbDefault
                Case vbKeyF
                    mnuMonitorFilterOn_Click
                Case vbKeyH
                    ToggleDisplayFormat
                Case vbKeyT
                    mnuMonitorRelative_Click
                Case vbKeyI
                    mnuViewFilters_Click
                Case vbKeyO
                    mnuViewMessages_Click
                Case vbKeyRight
                    MiddleBarPercentRL = MiddleBarPercentRL - 0.05
                    If MiddleBarPercentRL < 0.05 Then MiddleBarPercentRL = 0.05
                    'Debug.Print MiddleBarPercentRL
                    Call Form_Resize
                    Call UpdateMonitorDisplay(True)
                Case vbKeyLeft
                    MiddleBarPercentRL = MiddleBarPercentRL + 0.05
                    If MiddleBarPercentRL > 0.95 Then MiddleBarPercentRL = 0.95
                    'Debug.Print MiddleBarPercentRL
                    Call Form_Resize
                    Call UpdateMonitorDisplay(True)
            End Select
        
    End Select


End Sub
