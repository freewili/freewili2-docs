'// This
Public Function ParseExpression(ShowDialog As Boolean, tExpression As String, _
        Value As Double, msg As icsSpyMessageLong, bUseHex As Boolean, dValue As Double) As Boolean
    
    Dim iStartLocation As Integer
    Dim iStopLocation As Integer
    Dim sExpression As String
    Dim sNewExpression As String
    Dim variablecount  As Integer
    Dim sEnteredValue As String
    Dim sItemName As String
    Dim cEval As New cEvaluateExpression
    Dim bBytes() As Byte
    Dim lValueCount As Long
    Dim dTempValue As Double
    
    
    '// vars for finding what item number the variables are
    Dim lFirstLetterLocation As Long
    Dim lColonLocation As Long
    Dim lInput As Long
    Dim lNumBytes As Long
    Dim J1850Msg As icsSpyMessageJ1850
    Dim Stdmsg As icsSpyMessage
    
    On Error GoTo ParseExpressionError
    

    '// copy the messages
    LSet J1850Msg = msg
    LSet Stdmsg = msg
    
    sExpression = tExpression
    Do
        '// Remove the {} from the expression and replace with variables
        variablecount = variablecount + 1
        iStartLocation = InStr(sExpression, "{")
        iStopLocation = InStr(sExpression, "}")
        If iStartLocation <> 0 And iStopLocation <> 0 Then
            '// we found a value
            lValueCount = lValueCount + 1
            cEval.SetNumValues lValueCount
            
            sItemName = UCase$(Mid$(sExpression, iStartLocation + 1, iStopLocation - iStartLocation - 1))
            sNewExpression = sNewExpression & Left$(sExpression, iStartLocation - 1)
            sExpression = Right$(sExpression, Len(sExpression) - iStopLocation)


            '// Determine the value to be replaced //////////////////////////////
            If ShowDialog Then
                If bUseHex Then
                    dTempValue = Val("&H" & InputBox("Enter a dummy value for " & sItemName & " in Hex", "Enter Value"))
                Else
                    dTempValue = Val(InputBox("Enter a dummy value for " & sItemName, "Enter Value"))
                End If
                Call cEval.SetValue(lValueCount, dTempValue)
            Else
                '// Get the current value
                'bBytes = MessageBytes
                'lNumBytes = UBound(bBytes)
                
                Select Case sItemName
                    Case "VALUE"
                        Call cEval.SetValue(lValueCount, dValue)
                    Case "PT"
                         Call cEval.SetValue(lValueCount, CDbl(J1850Msg.Header(1)))
                    Case "TRGT"
                        Call cEval.SetValue(lValueCount, CDbl(J1850Msg.Header(2)))
                    Case "SRC"
                          Call cEval.SetValue(lValueCount, CDbl(J1850Msg.Header(3)))
                    Case "B1"
                        Call cEval.SetValue(lValueCount, CDbl(Stdmsg.data(1)))
                    Case "B2"
                        Call cEval.SetValue(lValueCount, CDbl(Stdmsg.data(2)))
                    Case "B3"
                       Call cEval.SetValue(lValueCount, CDbl(Stdmsg.data(3)))
                    Case "B4"
                        Call cEval.SetValue(lValueCount, CDbl(Stdmsg.data(4)))
                    Case "B5"
                        Call cEval.SetValue(lValueCount, CDbl(Stdmsg.data(5)))
                    Case "B6"
                        Call cEval.SetValue(lValueCount, CDbl(Stdmsg.data(6)))
                    Case "B7"
                        Call cEval.SetValue(lValueCount, CDbl(Stdmsg.data(7)))
                    Case "B8"
                        Call cEval.SetValue(lValueCount, CDbl(Stdmsg.data(8)))
                    Case "ERR/STATUS"
                        Call cEval.SetValue(lValueCount, CDbl(Stdmsg.StatusBitField))
                    Case "ARB ID"
                        Call cEval.SetValue(lValueCount, CDbl(Stdmsg.ArbIDOrHeader))
                    Case "RMT"
                        Call cEval.SetValue(lValueCount, CDbl((Stdmsg.StatusBitField And icsSpyStatusRemoteFrame) > 0))
                    Case Else
                        Debug.Print "There was an undefined token in the expression: " & sItemName
                End Select
                
            End If
            '////////////////////////////////////////////////////////////////////

            sNewExpression = sNewExpression & "vat(" & lValueCount & ")"

        End If
    Loop Until iStartLocation = 0 Or iStopLocation = 0

    sNewExpression = sNewExpression & sExpression

    '// Determine the value
    cEval.OnErrorShowMsgbox = ShowDialog
    ParseExpression = cEval.Evaluate(sNewExpression, Value)
    
    Exit Function
ParseExpressionError:
    Debug.Print "There was an error in the Parse Expression"
    ParseExpression = False
End Function

Public Function ChangeExpressionAnalogItems(obApp As cicsSpy, ToIndexesOnly As Boolean, tExpression As String, _
    NewExpression As String) As Boolean
    
    Dim iStartLocation As Integer
    Dim iStopLocation As Integer
    Dim sExpression As String
    Dim sNewExpression As String
    Dim sEnteredValue As String
    Dim sItemName As String
    Dim sKey As String
    Dim lColonLocation As Long
    Dim sTempDescription As String
    
    On Error GoTo ChangeExpressionAnalogItemsError
    
    sExpression = tExpression
    Do
        '// Remove the {} from the expression and replace with variables
        iStartLocation = InStr(sExpression, "{")
        iStopLocation = InStr(sExpression, "}")
        
        If iStartLocation <> 0 And iStopLocation <> 0 Then
            
            sItemName = Mid$(sExpression, iStartLocation + 1, iStopLocation - iStartLocation - 1)
            sNewExpression = sNewExpression & Left$(sExpression, iStartLocation - 1)
            sExpression = Right$(sExpression, Len(sExpression) - iStopLocation)
            
            '// get the key
            lColonLocation = InStr(sItemName, ":")
            sKey = LCase$(Right$(sItemName, Len(sItemName) - lColonLocation))
                
            '// Get the current value
            If LCase$(sItemName) = "my value" Then
                sEnteredValue = "{My Value}"
            Else
            If Left$(sKey, 2) = "in" Then
                If ToIndexesOnly Then
                    sEnteredValue = "{ :" & sKey & "}"
                Else
                    If obApp.IncomingMessages.KeyExists(sKey) Then
                        sTempDescription = obApp.IncomingMessages(sKey).Description
                        If sTempDescription <> "" Then
                            sEnteredValue = "{" & sTempDescription & " :" & sKey & "}"
                        Else
                            sEnteredValue = "{Unamed In Message :" & sKey & "}"
                        End If
                    Else
                        sEnteredValue = "{ :" & sKey & "}"
                    End If
                End If
            Else
                If ToIndexesOnly Then
                    sEnteredValue = "{ :" & sKey & "}"
                Else
                    If obApp.OutgoingMessages.KeyExists(sKey) Then
                        sTempDescription = obApp.OutgoingMessages(sKey).Description
                        If sTempDescription <> "" Then
                            sEnteredValue = "{" & sTempDescription & " :" & sKey & "}"
                        Else
                            sEnteredValue = "{Unamed Out Message :" & sKey & "}"
                        End If
                    Else
                        sEnteredValue = "{ :" & sKey & "}"
                    End If
                End If
            End If
            End If
            '////////////////////////////////////////////////////////////////////
            
            sNewExpression = sNewExpression & sEnteredValue
            
        End If
    Loop Until iStartLocation = 0 Or iStopLocation = 0

    NewExpression = sNewExpression & sExpression
    ChangeExpressionAnalogItems = True '// Determine the value
    
    Exit Function
ChangeExpressionAnalogItemsError:
    '// revert to old expression
    ChangeExpressionAnalogItems = False '// Determine the value
    NewExpression = tExpression
    Debug.Print " error converting expression in  changeexpressionAnalogItems"
    
End Function

Public Function ParseExpressionForAnalogItems(obApp As cicsSpy, ShowDialog As Boolean, tExpression As String, _
                Value As Double, OwnerValue As Double) As Boolean
    
    Dim iStartLocation As Integer
    Dim iStopLocation As Integer
    Dim sExpression As String
    Dim sNewExpression As String
    Dim variablecount  As Integer
    Dim sEnteredValue As String
    Dim sItemName As String
    Dim cEval As New cEvaluateExpression
    Dim lValueCount As Long
    Dim dValue As Double
    '// vars for finding what item number the variables are
    Dim lColonLocation As Long
    Dim sKey As String

    On Error GoTo ParseExpressionForAnalogItemsError
    
    sExpression = tExpression
    Do
        '// Remove the {} from the expression and replace with variables
        variablecount = variablecount + 1
        iStartLocation = InStr(sExpression, "{")
        iStopLocation = InStr(sExpression, "}")
        If iStartLocation <> 0 And iStopLocation <> 0 Then
            '// we found a value
            lValueCount = lValueCount + 1
            cEval.SetNumValues lValueCount
            
            sItemName = UCase$(Mid$(sExpression, iStartLocation + 1, iStopLocation - iStartLocation - 1))
            
            sNewExpression = sNewExpression & Left$(sExpression, iStartLocation - 1)
            sExpression = Right$(sExpression, Len(sExpression) - iStopLocation)
            
            
            '// Determine the value to be replaced //////////////////////////////
            If ShowDialog Then
               dValue = Val(InputBox("Enter a dummy value for " & sItemName, "Enter Value"))
               Call cEval.SetValue(lValueCount, dValue)
            Else
                If sItemName = "MY VALUE" Then
                    Call cEval.SetValue(lValueCount, OwnerValue)
                Else
                    '// get the key
                    lColonLocation = InStr(sItemName, ":")
                    sKey = LCase$(Right$(sItemName, Len(sItemName) - lColonLocation))
                
                    '// Get the current value
                    If Left$(sKey, 2) = "in" Then
                        With obApp.IncomingMessages
                            If .KeyExists(sKey) Then
                                Call cEval.SetValue(lValueCount, .Item(sKey).DoubleValue)
                            Else
                                ParseExpressionForAnalogItems = False
                                Exit Function
                            End If
                        End With
                    Else
                        With obApp.OutgoingMessages
                            If .KeyExists(sKey) Then
                                Call cEval.SetValue(lValueCount, .Item(sKey).DoubleValue)
                            Else
                                ParseExpressionForAnalogItems = False
                                Exit Function
                            End If
                        End With
                    End If
                End If
            End If
            '////////////////////////////////////////////////////////////////////
            
            sNewExpression = sNewExpression & "vat(" & lValueCount & ")"
            
        End If
    Loop Until iStartLocation = 0 Or iStopLocation = 0

    sNewExpression = sNewExpression & sExpression

    '// Determine the value
    cEval.OnErrorShowMsgbox = ShowDialog
    ParseExpressionForAnalogItems = cEval.Evaluate(sNewExpression, Value)
    
    Exit Function
    
ParseExpressionForAnalogItemsError:
    
    
    ParseExpressionForAnalogItems = False
    
    
End Function

Public Function ParseStringExpressionForAnalogItems(obApp As cicsSpy, ShowDialog As Boolean, tExpression As String, _
                sReturnExpression As String) As Boolean
    
    Dim iStartLocation As Integer
    Dim iStopLocation As Integer
    Dim sExpression As String
    Dim sNewExpression As String
    Dim sItemName As String
    Dim dValue As Double
    Dim lColonLocation As Long
    Dim sKey As String
    
    On Error GoTo ParseStringExpressionForAnalogItemsError
    
    sExpression = tExpression
    Do
        '// Remove the {} from the expression and replace with variables
        iStartLocation = InStr(sExpression, "{")
        iStopLocation = InStr(sExpression, "}")
        
        If iStartLocation <> 0 And iStopLocation <> 0 Then
            '// we found a value
            sItemName = UCase$(Mid$(sExpression, iStartLocation + 1, iStopLocation - iStartLocation - 1))
            
            sNewExpression = sNewExpression & Left$(sExpression, iStartLocation - 1)
            sExpression = Right$(sExpression, Len(sExpression) - iStopLocation)
            
            
            '// Determine the value to be replaced //////////////////////////////
            If ShowDialog Then
               dValue = Val(InputBox("Enter a dummy value for " & sItemName, "Enter Value"))
            
            sNewExpression = sNewExpression & Format$(dValue)
                
            Else
                '// get the key
                lColonLocation = InStr(sItemName, ":")
                sKey = LCase$(Right$(sItemName, Len(sItemName) - lColonLocation))
                
                '// Get the current value
                If Left$(sKey, 2) = "in" Then
                    With obApp.IncomingMessages
                        If .KeyExists(sKey) Then
                            sNewExpression = sNewExpression & Format$(.Item(sKey).DoubleValue, "0.0")
                        Else
                            ParseStringExpressionForAnalogItems = False
                            Exit Function
                        End If
                    End With
                Else
                    With obApp.OutgoingMessages
                        If .KeyExists(sKey) Then
                            sNewExpression = sNewExpression & Format$(.Item(sKey).Value, "0.0")
                        Else
                            ParseStringExpressionForAnalogItems = False
                            Exit Function
                        End If
                    End With
                End If
            End If
            '////////////////////////////////////////////////////////////////////
        End If
    Loop Until iStartLocation = 0 Or iStopLocation = 0

    sNewExpression = sNewExpression & sExpression

    '// Determine the value
    sReturnExpression = sNewExpression
    ParseStringExpressionForAnalogItems = True
    
    Exit Function
ParseStringExpressionForAnalogItemsError:
    
    ParseStringExpressionForAnalogItems = False
    
End Function

Public Function StepValueToTime(ByVal dTime As Double, bCANMode As Boolean) As String
    Dim hours As Long
    Dim minutes As Long
    Dim seconds As Long
    Dim TimeMS As Double
    Dim sTime As String
    Dim StepValue As Long
    Dim sTimeFormat As String
    
    If bCANMode Then
        sTimeFormat = ".0000"
    Else
        sTimeFormat = ".000"
    End If
    '// How many milliseconds do we have
    'If bCANMode Then
    StepValue = CLng(dTime * 1000)
    

    Do While StepValue - 3600000 >= 0
        StepValue = StepValue - 3600000
        hours = hours + 1
    Loop
    
    Do While StepValue - 60000 >= 0
        StepValue = StepValue - 60000
        minutes = minutes + 1
    Loop
    
    Do While StepValue - 1000 >= 0
        StepValue = StepValue - 1000
        seconds = seconds + 1
    Loop
    
    TimeMS = StepValue / 1000
    
    If hours <> 0 Then
        sTime = Format(hours, "##0") & ":" & Format(minutes, "00") & ":"
        StepValueToTime = sTime & Format(seconds, "00") & Format(TimeMS, sTimeFormat)
    Else
        If minutes <> 0 Then
            sTime = Format(minutes, "00") & ":"
            StepValueToTime = sTime & Format(seconds, "00") & Format(TimeMS, sTimeFormat)
        Else
            StepValueToTime = Format(seconds, "#0") & Format(TimeMS, sTimeFormat) & " Sec"
        End If
    End If
    
End Function

'// function is called to determine if the ascii char is a valid one
Public Function IsValidNumeric(iChar As Integer, WildCardValid As Boolean, Optional HexValid As Boolean = True) As Boolean

    '// Default to valid condition, exit function is called when ichar is valid
    IsValidNumeric = True
    
    '// Allow hex bytes only !!!
    If iChar >= Asc("0") And iChar <= Asc("9") Then Exit Function
    
    '// Are hex bytes valid?
    If HexValid Then
        If iChar >= Asc("A") And iChar <= Asc("F") Then Exit Function
        If iChar >= Asc("a") And iChar <= Asc("f") Then Exit Function
    End If
    
    '// Test for wild cards, if valid
    If WildCardValid Then
        If iChar = Asc("x") Or iChar = Asc("X") Then Exit Function
    End If
    
    IsValidNumeric = False  '// If we made it this far, this char is not valid

End Function
