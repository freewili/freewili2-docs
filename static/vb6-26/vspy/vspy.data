'// this function saves the data as shown in the monitor
Private Sub SaveMonitorData(sUseDefaultFileName As Boolean)

On Error GoTo ErrorSaveMonitorData
    Dim sSavePath As String
    Dim sFilename As String
    
    
    mnuMonitorSave.Enabled = False
    mnuMonitorDelete.Enabled = False
    tbMonitor.Buttons("save").Enabled = False
    tbMonitor.Buttons("clear").Enabled = False
    
    lMonitorDataFileCount = lMonitorDataFileCount + 1
    sFilename = "MonitorDataFile" & lMonitorDataFileCount
    
    
    If Not sUseDefaultFileName Then
    
        With frmSaveFile
            '// show the save file form
            
            .txtFileName = sFilename
            .txtFileName.SelStart = 0
            .txtFileName.SelLength = Len(.txtFileName)
            .Show vbModal, Me
    
            '// check the ok pressed flag
            If .OkPressed Then
                '// Save the buffer
                Call obApp.BufferSave(obApp.Monitor.Buffer, "Monitor", obApp.LogBook.LogBookDirectory & "\" & .txtFileName & ".csv", 0, obApp.Monitor.SpyMsgTime, False)
            End If
        End With
    
    Else
        '// get the data directory from the registry
        Call obApp.BufferSave(obApp.Monitor.Buffer, "Monitor", _
            obApp.LogBook.LogBookDirectory & "\" & sFilename & ".csv", 0, obApp.Monitor.SpyMsgTime, False)
    End If
    
    
    '// unload the form
    Unload frmSaveFile
    Set frmSaveFile = Nothing
        
    
    mnuMonitorSave.Enabled = True
    mnuMonitorDelete.Enabled = True
    tbMonitor.Buttons("save").Enabled = True
    tbMonitor.Buttons("clear").Enabled = True
        
    Exit Sub
    
ErrorSaveMonitorData:

'// as long as it is not the cancel error
If Err.Number <> 32755 Then
    MsgBox "There was an error trying to save the monitor data. Err Number: " _
        & Err.Number & vbCrLf & vbCrLf & "Description: " & Err.Description, vbExclamation, "Problem Saving Data"
End If

    mnuMonitorSave.Enabled = True
    mnuMonitorDelete.Enabled = True
    tbMonitor.Buttons("save").Enabled = True
    tbMonitor.Buttons("clear").Enabled = True
    
End Sub

