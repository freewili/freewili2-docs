Private Sub tmrUpdateGraphical_Timer()
    
    Dim lCount As Long
    Dim lObIndex As Long
    Dim sIndex As String
    Dim bNewValue As Boolean
    Dim dNewValue As Double
    Dim obCwb As CWButton
    Dim obCwk As CWKnob
    Dim obCwg As CWGraph
    Dim dXVal As Double
    Dim dYVal As Double
    Dim bMakePlot As Boolean
    
    If obApp.MonitorOn And obApp.Performance.TextMonitorUpdateType = icsspyPerformanceMonitorDoNotAttempt Then
        Exit Sub
    End If
    
    
    '// Update the LEDs
    For Each obCwb In cwbLight 'lCount = 1 To cwbLight.Count - 1
        
        If obCwb.Index <> 0 Then
        
        '// get the index
        sIndex = str$(obCwb.Index)
        
        With obApp.UserDialog.cDigitalDisplays(sIndex)
            '// get the index for the first value
            lObIndex = obApp.UserDialog.cDigitalDisplays(sIndex).DataID
            '// get the current value
            bNewValue = obApp.IncomingMessages(lObIndex).BooleanValue
            '// set the value
            If bNewValue <> obCwb Then obCwb = bNewValue
        End With
        
        
        End If
        
    Next obCwb
    
    
    '// Update the knobs
    For Each obCwk In cwkMeter
    
        If obCwk.Index <> 0 Then
    
        '// get the index
        sIndex = str$(obCwk.Index)
        
        With obApp.UserDialog.cAnalogDisplays(sIndex)
            '// get the index for the first value
            lObIndex = obApp.UserDialog.cAnalogDisplays(sIndex).DataID
            '// get the current value
            dNewValue = obApp.IncomingMessages(lObIndex).DoubleValue
            '// set the value
            If dNewValue <> obCwk Then obCwk = dNewValue
        End With
        
        End If
        
    Next obCwk
    
    '// Update the graphs (remember cwg(0) is hidden and is not updated)
    For Each obCwg In cwg
    
        If obCwg.Index <> 0 Then
    
        '// get the index
        sIndex = str$(obCwg.Index)
        
        With obApp.UserDialog.Graphs(sIndex)
            
            '// increment the strip count
            .CurrentStripCount = .CurrentStripCount + 1
            
            '// do we need to chart a value
            If .CurrentStripCount >= .StripRate Then
                .CurrentStripCount = 0   '// reset the stripchart count
                
                If .GraphType = 1 Then
                    '// strip chart
                
                    '// get the index for the first value
                    lObIndex = obApp.UserDialog.Graphs(sIndex).DataID
                
                    '// plot the data
                    If .DataIDType = icsUDIncomingMessage Then
                        If lObIndex > 0 And lObIndex <= obApp.IncomingMessages.Count Then
                            obCwg.Plots(1).ChartY Val(obApp.IncomingMessages(lObIndex).Value)
                        End If
                    Else
                        If lObIndex > 0 And lObIndex <= obApp.OutgoingMessages.Count Then
                            obCwg.Plots(1).ChartY Val(obApp.OutgoingMessages(lObIndex).Value)
                        End If
                    End If
                    
                    
                    '// get the index for the second value
                    lObIndex = obApp.UserDialog.Graphs(sIndex).AnalogItemID2
                
                    
                    If .AnalogItemID2Type = icsUDIncomingMessage Then
                        If lObIndex > 0 And lObIndex <= obApp.IncomingMessages.Count Then
                            obCwg.Plots(2).ChartY Val(obApp.IncomingMessages(lObIndex).Value)
                        End If
                    Else
                        If lObIndex > 0 And lObIndex <= obApp.OutgoingMessages.Count Then
                            obCwg.Plots(2).ChartY Val(obApp.OutgoingMessages(lObIndex).Value)
                        End If
                    End If
                    
                    
                
                Else
                    '// x-y strip chart
                    '// get the index for the first value
                    lObIndex = obApp.UserDialog.Graphs(sIndex).DataID
                
                        bMakePlot = True
                        
                        '// get the x value
                        If .DataIDType = icsUDIncomingMessage Then
                            If lObIndex > 0 And lObIndex <= obApp.IncomingMessages.Count Then
                                dXVal = Val(obApp.IncomingMessages(lObIndex).Value)
                            Else
                                bMakePlot = False
                            End If
                        Else
                            If lObIndex > 0 And lObIndex <= obApp.OutgoingMessages.Count Then
                                dXVal = Val(obApp.OutgoingMessages(lObIndex).Value)
                            Else
                                bMakePlot = False
                            End If
                        End If
                        
                        lObIndex = obApp.UserDialog.Graphs(sIndex).AnalogItemID2
                        
                        If .AnalogItemID2Type = icsUDIncomingMessage Then
                            If lObIndex > 0 And lObIndex <= obApp.IncomingMessages.Count Then
                                dYVal = Val(obApp.IncomingMessages(lObIndex).Value)
                            Else
                                bMakePlot = False
                            End If
                        Else
                            If lObIndex > 0 And lObIndex <= obApp.OutgoingMessages.Count Then
                                dYVal = Val(obApp.OutgoingMessages(lObIndex).Value)
                            Else
                                bMakePlot = False
                            End If
                        End If
                        
                        '// plot the data
                        If bMakePlot Then obCwg.ChartXvsY dXVal, dYVal
                            
                    End If
                    
                    '// get the index for the second value
                    
                End If
            
            End With
        
        End If
        
    Next obCwg

End Sub




Private Sub tsBuffers_Click()
    If Not bProgramEdit_tsBuffers Then
        '// set the test in the row
        MousePointer = vbHourglass
        If tsBuffers.SelectedItem.Index > 1 Then
            Call ShowTestInMonitor(tsBuffers.SelectedItem.Index - 1)
        Else
            RemoveViewOfTestMonitor True
        End If
        MousePointer = vbDefault
    End If
End Sub

Private Sub txtArbID_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditIncoming Then
        Select Case KeyCode
            Case vbKeyReturn: Call LeaveCellIncomingMessages: Call GotoNextColumn(grdIncomingMessages)
            Case vbKeyEscape: Call LeaveCellIncomingMessages(True)
        End Select
    End If
End Sub

Private Sub txtArbID_KeyPress(KeyAscii As Integer)
    
    If IsValidNumeric(KeyAscii, True, False) Or KeyAscii = 8 Then
        Exit Sub
    End If
    
    If KeyAscii = Asc("#") Then
        With frmBitwise
            .MaximumNumberOfBits = 31
            .HasBitDescriptions = False
            .IsStatusByte = False
            .lDataByteIndex = DataByteFromEditCol(lEditCol)
            .sIncomingMessageKey = sEditKey
            Set .obApp = obApp
            .SetupUI
            .Show vbModal
            Call LeaveCellIncomingMessages(True)
            Call UpdateIncomingMessageRow(lEditRow) '// update the changes
            obApp.RefreshIncomingMessageFilterTable '// refresh the filter table
        End With
    End If
    
    KeyAscii = 0    '// if it made it this far the character is not valid
    
End Sub

Private Sub lstOutgoingMessageHexByte_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditOutgoing Then
        Select Case KeyCode
            Case vbKeyReturn: Call LeaveCellOutgoingMessages: Call GotoNextColumn(grdOutgoingMessages)
            Case vbKeyEscape: Call LeaveCellOutgoingMessages(True)
        End Select
    End If
End Sub

Private Sub InitializeTheIncomingMessagesGrid()

    Dim lCount As Long
    Dim lNumItems As Long


    With grdIncomingMessages

        '// Setup the common message types
        mInMsgDescriptionCol = 1    '// the description col is always first
        mInMsgStatusCol = 2
        mInMsgFirstHeaderCol = 3
        .Redraw = False
    
        If obApp.Protocol = icsVSPYProtocolCAN Then
            .Cols = 13
                    
            mInMsgValueFirstByteCol = 4
            mInMsgValueLastByteCol = 6
            
            .TextMatrix(0, mInMsgFirstHeaderCol) = "Arb ID"
            
            .ColWidth(2) = 1000
            .ColWidth(3) = 1000
            
            '// Setup the col width for the remaining cells
            For lCount = mInMsgValueFirstByteCol To mInMsgValueLastByteCol
                .ColWidth(lCount) = 400
            Next lCount
        
            '// Setup the remaning columns
            mInMsgValueTypeCol = 7
            mInMsgValueSourceCol = 8
            mInMsgEquationCol = 9
            mInMsgReponseCol = 10
            mInMsgRequestCol = 11
            mInMsgColorCol = 12
        Else
            .Cols = 15
            
            mInMsgValueFirstByteCol = 6
            mInMsgValueLastByteCol = 8
            
            .TextMatrix(0, mInMsgFirstHeaderCol) = "PT"
            .TextMatrix(0, mInMsgFirstHeaderCol + 1) = "Trgt"
            .TextMatrix(0, mInMsgFirstHeaderCol + 2) = "Src"
            
            '// Setup the col width
            For lCount = 3 To 8
                .ColWidth(lCount) = 400
            Next lCount
            
            '// Setup the remaning columns
            mInMsgValueTypeCol = 9
            mInMsgValueSourceCol = 10
            mInMsgEquationCol = 11
            mInMsgReponseCol = 12
            mInMsgRequestCol = 13
            mInMsgColorCol = 14
        End If
    
        .TextMatrix(0, mInMsgValueFirstByteCol) = "B1"
        .TextMatrix(0, mInMsgValueFirstByteCol + 1) = "B2"
        .TextMatrix(0, mInMsgValueFirstByteCol + 2) = "B3"
        .TextMatrix(0, mInMsgStatusCol) = "Status"
        .TextMatrix(0, 0) = "Key": .ColWidth(0) = 600
        .TextMatrix(0, mInMsgDescriptionCol) = "Description": .ColWidth(mInMsgDescriptionCol) = 2000
        .TextMatrix(0, mInMsgValueTypeCol) = "Value Type": .ColWidth(mInMsgValueTypeCol) = 1200
        .TextMatrix(0, mInMsgEquationCol) = "Equation": .ColWidth(mInMsgEquationCol) = 2000
        .TextMatrix(0, mInMsgValueSourceCol) = "Value Source": .ColWidth(mInMsgValueSourceCol) = 1500
        .TextMatrix(0, mInMsgReponseCol) = "Reponse"
        .TextMatrix(0, mInMsgRequestCol) = "Request"
        .TextMatrix(0, mInMsgColorCol) = "Color"
        
        
        
        lNumItems = obApp.IncomingMessages.Count    '// How many messages do we have
        .Rows = 1                                   '// reset to clear the data
        .Rows = lNumItems + 1                       '// Set the number of grid rows
        
        For lCount = 1 To lNumItems                 '// Update all the rows
            .TextMatrix(lCount, 0) = obApp.IncomingMessages(lCount).Key
            Call UpdateIncomingMessageRow(lCount)
        Next lCount
        .Redraw = True
    End With
    
    '// Update the values grid
    InitializeTheValuesGrid
    
End Sub

Public Sub InitializeTheTestsGrid()
    Dim g As MSFlexGrid
    Dim lCount As Long
    Dim lNumItems As Long
    Dim lOldRow As Long
    Dim lOldCol As Long
    Dim obTest As cTest
    Dim Test As cTest
    
    Set g = gTest    '// temp ref
    
    '// Setup the grid
    With g
        .Redraw = False
        .Cols = 2
        .TextMatrix(0, 0) = "Description": .ColWidth(0) = 2000
        .TextMatrix(0, 1) = "Status": .ColWidth(1) = 4000
        
    
        lNumItems = obApp.Tests.Count    '// How many messages do we have
        .Rows = lNumItems + 1                      '// Set the number of grid rows
        
'        lOldRow = .Row
'        lOldCol = .Col
        

        '// Update all the rows
        For lCount = 1 To lNumItems
            
            '// Set a ref to the input being edited
            Set Test = obApp.Tests(lCount)
            .TextMatrix(lCount, TEST_DESCRIPTION_COL) = Test.Description
            .TextMatrix(lCount, TEST_STATUS_COL) = Test.TestStatusString
        
'            .Row = lCount
'            .Col = 1
'            If lCurrentTest = lCount Then
'                .CellPictureAlignment = flexAlignRightTop
'                Set .CellPicture = pctTX
'            Else
'                Set .CellPicture = Nothing
'            End If
            
        Next lCount
        
        '// return the old row
'         .Row = lOldRow
'         .Col = lOldCol
        .Redraw = True
    End With
    
    '// setup the test buffer tabs
    Dim aTab As msComctlLib.Tab
    tsBuffers.Tabs.Clear
    Set aTab = tsBuffers.Tabs.Add
    aTab.Caption = "Monitor"
    For Each obTest In obApp.Tests
        Set aTab = tsBuffers.Tabs.Add
        aTab.Caption = obTest.Description
    Next obTest
    
    
End Sub

Public Sub InitializeTheValuesGrid()
    Dim g As MSFlexGrid
    Dim lCount As Long
    Dim lNumItems As Long
    Dim sKey As String
    

    Set g = gValues                 '// temp ref
    
    '// return the last cell to the original color
    With g
        
        .Redraw = False
        '// take care of the last message highlight in the values column
        If lLastValueHighlight <> 0 And lLastValueHighlight < .Rows Then
            .Row = lLastValueHighlight
            .RowSel = lLastValueHighlight
            .Col = 0
            .ColSel = 0
            .CellBackColor = vbWhite
            .CellForeColor = vbBlack
        End If
        lLastValueHighlight = 0         '// reset the last value highlight
        
        If obApp.Protocol = icsVSPYProtocolJ1850 Then
            .Cols = 15
            
            For lCount = 1 To 14
                .MergeCol(lCount) = True
            Next lCount
        Else
            '// its CAN!!
            .Cols = 14
            
            For lCount = 1 To 13
                .MergeCol(lCount) = True
            Next lCount
        
        End If
        
        
        .TextMatrix(0, 0) = "Description": g.ColWidth(0) = 2000
        
        .TextMatrix(0, 1) = "Value"
        .TextMatrix(0, 2) = "Update"
        .TextMatrix(0, 3) = "Present"
        
        
        If obApp.Protocol = icsVSPYProtocolJ1850 Then
            '// its j1850 protocol
            .TextMatrix(0, 4) = "PT"
            .TextMatrix(0, 5) = "TG"
            .TextMatrix(0, 6) = "SC"
            For lCount = 1 To 11
                .ColWidth(3 + lCount) = 370
            Next lCount
        
            For lCount = 1 To 8
                .TextMatrix(0, lCount + 6) = "B" & lCount
            Next lCount
        
        Else
            '// its can protocol
            .TextMatrix(0, 4) = "Arb ID"
            .ColWidth(4) = 1000
            .TextMatrix(0, 5) = "R"
            .ColWidth(5) = 250
            For lCount = 1 To 8
                .TextMatrix(0, lCount + 5) = "B" & lCount
            Next lCount
        End If
        
        
        lNumItems = obApp.IncomingMessages.Count    '// How many messages do we have
        .Rows = lNumItems + 1                       '// Set the number of grid rows
        For lCount = 1 To lNumItems                 '// Update all the rows
            sKey = obApp.IncomingMessages(lCount).Key
            .RowData(lCount) = CLng(Right$(sKey, Len(sKey) - 2))
            Call UpdateValuesRow(lCount)
        Next lCount
        .Redraw = True
    
    End With

End Sub
Public Sub UpdateDataBaseLists()
    With obApp
        If .OpenDataBase Then      '// Open database and fill list boxes with database values
            Call .LoadListWithIncomingMessages(lstIncomingMessageDescription)
            Call .LoadListWithOutputs(lstOutgoingMessageDescription)
            Call .CloseDataBase
        Else
            '// there is no database
            lstIncomingMessageDescription.Clear
            lstOutgoingMessageDescription.Clear
        End If
    End With
End Sub

'// This sub updates all the displays of the UI with the data in the spy object
Public Sub UpdateDisplay()
    Dim lCount As Long
    
    With obApp
    
        '// Load the custom user dialog
        SetupUserDialog
    
        '// setup the backcolor of the on and off screen drawning objects
        pctRead.BackColor = .Monitor.BackColor
        pctDraw.BackColor = .Monitor.BackColor
        
        '// setup the bus load max bargraph
        pgBusLoad.Max = .Monitor.BusLoadMaxMessages
        
        '// the tx panel
        UpdateTxPanel
        
        
        '// setup what to display in the monitor
        Call SetShowParameters(.Monitor.ShowDescription, .Monitor.ShowDataBytes, .Monitor.DisplayFormat)
    
        '// Setup the various grid controls
        InitializeTheOutgoingMessagesGrid
        InitializeTheIncomingMessagesGrid '(this function calls InitializeTheValuesGrid)
        InitializeTheTestsGrid
    
      
        .App.UpdateMenu            '// Update the MRU File menu
        
        '// update the monitor toolbar buttons
        With .Monitor
            If .UseFilters Then
                tbMonitor.Buttons("filterson").Value = tbrPressed
            Else
                tbMonitor.Buttons("filterson").Value = tbrUnpressed
            End If
    
            If .ShowDescription Then
                tbScroll.Buttons("description").Value = tbrPressed
            Else
                tbScroll.Buttons("description").Value = tbrUnpressed
            End If
        
            tbScroll.Buttons("format").Image = .DisplayFormat + 3
            
            If .ShowDataBytes Then
                tbScroll.Buttons("databytes").Value = tbrPressed
            Else
                tbScroll.Buttons("databytes").Value = tbrUnpressed
            End If
        End With
    
        '// show hide replay file base on hardware setting
        If .HardwareID = icsVSpyTypeDemo Then
            mnuSepSetReplay.Visible = True
            mnuSetReplayFile.Visible = True
        Else
            mnuSepSetReplay.Visible = False
            mnuSetReplayFile.Visible = False
        End If
    
        '// make the UI match the run state
        EnableUIForRun Not .MonitorOn
    
        
        Caption = .App.GetCaption               '// Setup the form caption
    
        UpdateDataBaseLists                     '// Setup the data base lists
        NavigateToFilename                      '// setup the comment file
    
        '// make sure not tests are visible
        RemoveViewOfTestMonitor True
    
        '// Paint the picture to the display
        Call UpdateMonitorDisplay(True)

        '// show and hide the graphical monitor feature
       ' If .UIShowGraphicalMonitor Then
        mnuViewChart.Visible = True
        tb.Buttons.Item("viewchart").Visible = True
'        Else
'            If CurrentView = icsSpyGraphicalView Then CurrentView = icsSpyTextView
'            mnuViewChart.Visible = False
'            tb.Buttons.Item("viewchart").Visible = False
'        End If
    
        '// show and hide the log file feature
        mnuViewNotes.Visible = True
        tb.Buttons.Item("viewnotes").Visible = True
        
End With 'obapp

End Sub

Private Sub UpdateValueSoureList()
    
    Dim lCount As Long
    
    '// First add the standard symbols
    With lstIncomingSource
        .Clear
        .AddItem "None"
        .AddItem "Bus"
        .AddItem "Bus Load(msg / sec)"
        .AddItem "Latitude (GPS)"
        .AddItem "Longitude (GPS)"
        .AddItem "Altitude (GPS)"
        .AddItem "Speed (GPS)"
    
        '// add all of the channels
        For lCount = 1 To obApp.MultiIO.NumberOfChannels
            .AddItem obApp.MultiIO.ChannelDescription(lCount)
        Next lCount
    
    End With


End Sub

        

Public Sub UpdateOutgoingMessageRow(lRow As Long)
    Dim lCount As Long
    Dim outMsg As cOutgoingMessage
    Dim sKey As String
    Dim bNewDescription As Boolean
    
    With grdOutgoingMessages
        sKey = .TextMatrix(lRow, 0)
        Set outMsg = obApp.OutgoingMessages(sKey)
        If .TextMatrix(lRow, mOutMsgDescriptionCol) <> outMsg.Description Then
            .TextMatrix(lRow, mOutMsgDescriptionCol) = outMsg.Description
            bNewDescription = True
        End If
        .TextMatrix(lRow, mOutMsgValueTypeCol) = outMsg.ValueTypeString
        .TextMatrix(lRow, mOutMsgValueCol) = outMsg.Value
        .TextMatrix(lRow, mOutMsgUpdateRateCol) = outMsg.UpdateRateString
        .TextMatrix(lRow, mOutMsgRespondFileName) = outMsg.AutoRespondValueFile
        For lCount = mOutMsgDescriptionCol + 1 To mOutMsgLastByteCol
            grdOutgoingMessages.TextMatrix(lRow, lCount) = outMsg.ByteString(lCount - mOutMsgDescriptionCol)
        Next lCount
    End With
    
    '// update the tx panel
    If bNewDescription Then
        RaiseEvent NumberOfOutputsChanged
    End If
    
End Sub

Public Function ValueSourceString(lValueSource As Long) As String
    Select Case lValueSource
        Case icsVSPYSourceBus
            ValueSourceString = "Bus"
        Case icsVSPYSourceNone
            ValueSourceString = "None"
        Case icsVSPYSourceBusLoad
            ValueSourceString = "Bus Load (msg/sec)"
        Case icsVSPYSourceGPSLatitude
            ValueSourceString = "GPS Latitude"
        Case icsVSPYSourceGPSLongitude
            ValueSourceString = "GPS Longitude"
        Case icsVSPYSourceGPSAltitude
            ValueSourceString = "GPS Altitude"
        Case icsVSPYSourceGPSSpeed
            ValueSourceString = "GPS Speed"
        Case Is >= icsVSPYSourceHardware
            ValueSourceString = obApp.MultiIO.ChannelDescription(lValueSource - icsVSPYSourceGPSSpeed)
    End Select
End Function

Public Sub UpdateIncomingMessageRow(lRow As Long)

    Dim lCount As Long
    Dim lItemCount As Long
    Dim inMsg As cIncomingMessage
    Dim lOldRow As Long
    Dim lOldCol As Long
    Dim lIndex As Long
    Dim sDescription As String
    
    
    '// Set a ref to the input being edited
    
    With grdIncomingMessages
        Set inMsg = obApp.IncomingMessages(.TextMatrix(lRow, 0))
        .TextMatrix(lRow, mInMsgDescriptionCol) = inMsg.Description
        .TextMatrix(lRow, mInMsgEquationCol) = "= " & inMsg.Equation
        .TextMatrix(lRow, mInMsgValueTypeCol) = inMsg.ValueTypeString
        .TextMatrix(lRow, mInMsgStatusCol) = inMsg.Status
        .TextMatrix(lRow, mInMsgValueSourceCol) = ValueSourceString(inMsg.ValueSource)

        '// display color selection ///////////////////////////////////
        lOldRow = .Row  'save current position
        lOldCol = .Col
        .Col = mInMsgColorCol
        .Row = lRow
        .CellBackColor = inMsg.DisplayColor
        .Col = lOldCol
        .Row = lOldRow  'restore the position
        '/////////////////////////////////////////////////////////////////
        
        '// the response column
        If Len(inMsg.ResponseKey) = 0 Then
            .TextMatrix(lRow, mInMsgReponseCol) = "None"
        Else
            If obApp.OutgoingMessages.KeyExists(inMsg.ResponseKey) Then
                sDescription = obApp.OutgoingMessages(inMsg.ResponseKey).Description
                If Len(sDescription) = 0 Then sDescription = "Unnamed (" & inMsg.ResponseKey & ")"
                .TextMatrix(lRow, mInMsgReponseCol) = sDescription
            Else
                .TextMatrix(lRow, mInMsgReponseCol) = "Key Missing: " & inMsg.ResponseKey
            End If
        End If
        
        '// the request column
        If Len(inMsg.RequestKey) = 0 Then
            .TextMatrix(lRow, mInMsgRequestCol) = "None"
        Else
            If obApp.OutgoingMessages.KeyExists(inMsg.RequestKey) Then
                sDescription = obApp.OutgoingMessages(inMsg.RequestKey).Description
                If Len(sDescription) = 0 Then sDescription = "Unnamed (" & inMsg.RequestKey & ")"
                .TextMatrix(lRow, mInMsgRequestCol) = sDescription
            Else
                .TextMatrix(lRow, mInMsgRequestCol) = "Key Missing: " & inMsg.RequestKey
            End If
        End If

        '// display based on the protocol
        If obApp.Protocol = icsVSPYProtocolCAN Then

            '// First the Arb ID and the RTM
            .TextMatrix(lRow, mInMsgFirstHeaderCol) = inMsg.DataByteString(1)
            .TextMatrix(lRow, mInMsgFirstHeaderCol + 1) = inMsg.DataByteString(2)

            '// Now the data bytes
            lItemCount = 3
            For lCount = mInMsgValueFirstByteCol To mInMsgValueLastByteCol
                lItemCount = lItemCount + 1
                .TextMatrix(lRow, lCount) = inMsg.DataByteString(lItemCount)
            Next lCount
        Else
            '// Update the header bytes first
            lItemCount = 0
            For lCount = mInMsgFirstHeaderCol To mInMsgValueLastByteCol
                lItemCount = lItemCount + 1
                .TextMatrix(lRow, lCount) = inMsg.DataByteString(lItemCount)
            Next lCount
        End If
    End With

End Sub


'// This sub updates one row in the incoming message monitor
Public Sub UpdateValuesRow(lRow As Long)
    Dim lCount As Long
    Dim inMsg As cIncomingMessage
    Dim msg As icsSpyMessageJ1850
    Dim canmsg As icsSpyMessageLong
    Dim bBytes() As Byte
    Dim sTemp As String
    
    '// Set a ref to the input being edited
    Set inMsg = obApp.IncomingMessages(lRow)
    
    '// copy the message into the J1850 structure
    bBytes = inMsg.LastMessageBytes
    CopyData bBytes(1), msg, Len(msg)
    
    With gValues
        .TextMatrix(lRow, 0) = inMsg.Description
        If inMsg.ValueType = icsVSPYAnalogInput Then
            .TextMatrix(lRow, 1) = Format(inMsg.Value, "0.000")
        Else
            .TextMatrix(lRow, 1) = inMsg.Value
        End If
        
        .TextMatrix(lRow, 2) = StepValueToTime(inMsg.UpdateRate, obApp.Protocol = icsVSPYProtocolCAN)
        .TextMatrix(lRow, 3) = inMsg.PresentString

        If obApp.Protocol = icsVSPYProtocolJ1850 Then
        
            For lCount = 1 To 11
                .TextMatrix(lRow, 3 + lCount) = ""
            Next lCount
            
            For lCount = 1 To msg.NumberBytesHeader
                sTemp = Hex(msg.Header(lCount))
                If Len(sTemp) = 1 Then '// make sure the number is two long
                    sTemp = "0" & sTemp
                End If
                .TextMatrix(lRow, 3 + lCount) = sTemp
            Next lCount
            
            For lCount = 1 To msg.NumberBytesData
                sTemp = Hex(msg.data(lCount))
                If Len(sTemp) = 1 Then '// make sure the number is two long
                    sTemp = "0" & sTemp
                End If
                .TextMatrix(lRow, 6 + lCount) = sTemp
            Next lCount
            
        Else
            '// it is the CAN protocol
            LSet canmsg = msg
            
            '// clear the byte columns
            For lCount = 1 To 10
                .TextMatrix(lRow, 3 + lCount) = ""
            Next lCount
            
            .TextMatrix(lRow, 4) = canmsg.ArbIDOrHeader
            If (canmsg.StatusBitField And icsSpyStatusRemoteFrame) > 0 Then
                .TextMatrix(lRow, 5) = "Y"
            Else
                .TextMatrix(lRow, 5) = "N"
            End If
            
            For lCount = 1 To msg.NumberBytesData
                sTemp = Hex(msg.data(lCount))
                If Len(sTemp) = 1 Then '// make sure the number is two long
                    sTemp = "0" & sTemp
                End If
                .TextMatrix(lRow, 5 + lCount) = sTemp
            Next lCount
        End If
    End With
    
End Sub

Private Sub lstOutgoingMessageHexByte_KeyPress(KeyAscii As Integer)
    
    If IsValidNumeric(KeyAscii, False) Or KeyAscii = 8 Then
        Exit Sub
    End If
    
    If KeyAscii = Asc("=") Then
        bEditOutgoing = False
        With frmOutgoingEquation
            Set .obApp = obApp
            .sOutgoingKey = sEditKey
            .lByte = lEditCol - mOutMsgDescriptionCol
            .SetupUI
            .Show vbModal, Me
            Call UpdateOutgoingMessageRow(lEditRow) '// update the changes
        End With
        bEditOutgoing = True
        Call LeaveCellOutgoingMessages(True)
    End If
    
    KeyAscii = 0    '// Key was not valid - > cancel it
    
End Sub

Private Sub lstOutgoingMessageHexByte_LostFocus()
    If bEditOutgoing Then Call LeaveCellOutgoingMessages: Call GotoNextColumn(grdOutgoingMessages)
End Sub

Private Sub txtArbIDOut_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditOutgoing Then
        Select Case KeyCode
            Case vbKeyReturn: Call LeaveCellOutgoingMessages: Call GotoNextColumn(grdOutgoingMessages)
            Case vbKeyEscape: Call LeaveCellOutgoingMessages(True)
        End Select
    End If
End Sub

Private Sub txtArbIDOut_KeyPress(KeyAscii As Integer)
    
    If IsValidNumeric(KeyAscii, False, False) Or KeyAscii = 8 Then
        Exit Sub
    End If
    
    If KeyAscii = Asc("=") Then
        bEditOutgoing = False
        With frmOutgoingEquation
            Set .obApp = obApp
            .sOutgoingKey = sEditKey
            .lByte = lEditCol - mOutMsgDescriptionCol
            .SetupUI
            .Show vbModal, Me
            Call UpdateOutgoingMessageRow(lEditRow) '// update the changes
        End With
        bEditOutgoing = True
        Call LeaveCellOutgoingMessages(True)
    End If
    
    KeyAscii = 0    '// Key was not valid - > cancel it
End Sub

Private Sub txtIncomingMessageHexByte_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditIncoming Then
        If vbKeyReturn = KeyCode Then: LeaveCellIncomingMessages: Call GotoNextColumn(grdIncomingMessages)
        If vbKeyEscape = KeyCode Then LeaveCellIncomingMessages (True)
    End If
End Sub
Private Sub txtIncomingMessageHexByte_KeyPress(KeyAscii As Integer)
    
    If IsValidNumeric(KeyAscii, True) Or KeyAscii = 8 Then
        Exit Sub
    End If
    
    
    If KeyAscii = Asc("#") Then
        bEditIncoming = False
        With frmBitwise
            .MaximumNumberOfBits = 7
            .HasBitDescriptions = False
            .IsStatusByte = False
            .lDataByteIndex = DataByteFromEditCol(lEditCol)
            .sIncomingMessageKey = sEditKey
            Set .obApp = obApp
            .SetupUI
            .Show vbModal, Me
        End With
        bEditIncoming = True
        Call LeaveCellIncomingMessages(True)
        obApp.RefreshIncomingMessageFilterTable '// refresh the filter table
        Call GotoNextColumn(grdIncomingMessages)    '// move to the next cell
        'Call UpdateIncomingMessageRow(lEditRow) '// update the changes
    End If
    
    KeyAscii = 0    '// if it made it this far the character is not valid
    
End Sub

Private Sub txtIncomingMessageHexByte_LostFocus()
    If bEditIncoming Then LeaveCellIncomingMessages: Call GotoNextColumn(grdIncomingMessages)
End Sub

Private Sub txtOutgoingMessageValue_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditOutgoing Then
        If vbKeyReturn = KeyCode Then: Call LeaveCellOutgoingMessages: Call GotoNextColumn(grdOutgoingMessages)
        If vbKeyEscape = KeyCode Then Call LeaveCellOutgoingMessages(True)
    End If
End Sub





Private Sub AddItemToCustomDisplay(lItemToAdd As icsSpyUDObjectType)

    Dim Count As Integer
    Dim an As Object
    Dim sKey As String
    
    obApp.App.SaveNeeded = True
    
    Select Case lItemToAdd
        Case icsSpyUDTxButton
            Set an = cmdTX
        Case icsSpyUDChart
            Set an = cwg
        Case icsSpyUDText
            Set an = lblStatic
        Case icsSpyUDLED
            Set an = cwbLight
        Case icsSpyUDMeter
            Set an = cwkMeter
        Case icsSpyUDKnob
            Set an = cwkKnob
        Case icsSpyUDNumericEntry
            Set an = ineNumericEntry
        Case icsSpyUDTestButton
            Set an = cwbTest
        Case icsSpyUDOnOffButton
            Set an = cwbOnOff
        Case Else
            MsgBox "Please select an item to add.", vbInformation
            Exit Sub
    End Select
    
    On Error Resume Next
    
    Do
    
        Err.Clear
        Count = Count + 1
        Load an(Count)
    
    Loop Until Err.Number = 0
    
    
    '// move then make visible
    an(Count).Move UI.mNewControlInsertX, UI.mNewControlInsertY
    an(Count).Visible = True
    
    sKey = str$(Count)
    
    Select Case lItemToAdd
        Case icsSpyUDTxButton
            With obApp.UserDialog.cDigitalEntries
                .Add sKey, sKey
                Set .Item(sKey).ParentUD = obApp.UserDialog
                .Item(sKey).ShowPropertiesDialog
                an(Count).Caption = obApp.OutgoingMessages(obApp.UserDialog.cDigitalEntries(sKey).DataID).Description
            End With
        Case icsSpyUDOnOffButton
            With obApp.UserDialog.OnOffButtons
                .Add sKey, sKey
                Set .Item(sKey).ParentUD = obApp.UserDialog
                .Item(sKey).ShowPropertiesDialog
                an(Count).Caption = obApp.IncomingMessages(obApp.UserDialog.OnOffButtons(sKey).DataID).Description
            End With
        Case icsSpyUDTestButton
            With obApp.UserDialog.TestButtons
                .Add sKey, sKey
                Set .Item(sKey).ParentUD = obApp.UserDialog
                .Item(sKey).ShowPropertiesDialog
                
            End With
            
            '// setup the test button
            SetupTestButton an(Count)
            
        Case icsSpyUDChart
            
            With obApp.UserDialog.Graphs
                .Add sKey, sKey
                Set .Item(sKey).ParentUD = obApp.UserDialog
                .Item(sKey).ShowPropertiesDialog
            End With
            '// setup the graph
            SetupGraph an(Count)
            
        Case icsSpyUDText
            With obApp.UserDialog.cStaticTexts
                .Add sKey, sKey
                .Item((sKey)).ShowPropertiesDialog
                an(Count) = obApp.UserDialog.cStaticTexts(sKey).Caption
            End With
        Case icsSpyUDLED
            With obApp.UserDialog.cDigitalDisplays
                .Add sKey, sKey
                Set .Item(sKey).ParentUD = obApp.UserDialog
                .Item(sKey).ShowPropertiesDialog
            End With
        Case icsSpyUDNumericEntry
            With obApp.UserDialog.NumericEntries
                .Add sKey, sKey
                Set .Item(sKey).ParentUD = obApp.UserDialog
                .Item(sKey).ShowPropertiesDialog
            End With
        Case icsSpyUDMeter
            With obApp.UserDialog.cAnalogDisplays
                .Add sKey, sKey
                Set .Item(sKey).ParentUD = obApp.UserDialog
                .Item(sKey).ShowPropertiesDialog
            End With
                '// setup the knob
                SetupMeter an(Count)
        Case icsSpyUDKnob
            With obApp.UserDialog.cAnalogEntries
                .Add sKey, sKey
                Set .Item(sKey).ParentUD = obApp.UserDialog
                .Item(sKey).ShowPropertiesDialog
                '// setup the knob
                SetupKnob an(Count)
            End With
        Case Else
            MsgBox "Please select an item to add.", vbInformation
            Exit Sub
    End Select
    
    SaveDialogSettings
    
End Sub

Private Sub SavePositionsOfControls(Cancel As Integer)

Dim lCount As Long
Dim lNumItems As Long

        
'// Graph/ - Chart
lNumItems = obApp.UserDialog.Graphs.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.Graphs(lCount).ReadSizeAndPosition(cwg(Val(obApp.UserDialog.Graphs(lCount).Key)))
Next lCount

'// Static Text
lNumItems = obApp.UserDialog.cStaticTexts.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.cStaticTexts(lCount).ReadSizeAndPosition(lblStatic(Val(obApp.UserDialog.cStaticTexts(lCount).Key)))
Next lCount

'// Digital Display
lNumItems = obApp.UserDialog.cDigitalDisplays.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.cDigitalDisplays(lCount).ReadSizeAndPosition(cwbLight(Val(obApp.UserDialog.cDigitalDisplays(lCount).Key)))
Next lCount


'// Digtial Entry
lNumItems = obApp.UserDialog.cDigitalEntries.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.cDigitalEntries(lCount).ReadSizeAndPosition(cmdTX(Val(obApp.UserDialog.cDigitalEntries(lCount).Key)))
Next lCount

'// Analog Entry
lNumItems = obApp.UserDialog.cAnalogEntries.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.cAnalogEntries(lCount).ReadSizeAndPosition(cwkKnob(Val(obApp.UserDialog.cAnalogEntries(lCount).Key)))
Next lCount

'// Analog Display
lNumItems = obApp.UserDialog.cAnalogDisplays.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.cAnalogDisplays(lCount).ReadSizeAndPosition(cwkMeter(Val(obApp.UserDialog.cAnalogDisplays(lCount).Key)))
Next lCount

'// Numeric entries
lNumItems = obApp.UserDialog.NumericEntries.Count
For lCount = 1 To lNumItems
    Call obApp.UserDialog.NumericEntries(lCount).ReadSizeAndPosition(ineNumericEntry(Val(obApp.UserDialog.NumericEntries(lCount).Key)))
Next lCount


End Sub

'// This function returns the databyte being edited in the incoming message grid
Private Function DataByteFromEditCol(lEditCol As Long) As Long

'// Determine based on the protocol
If obApp.Protocol = icsVSPYProtocolCAN Then
    If lEditCol >= mInMsgFirstHeaderCol And lEditCol < mInMsgValueFirstByteCol Then
        '// It is arb id or rtm frame
        DataByteFromEditCol = lEditCol - mInMsgFirstHeaderCol + 1
    Else
        '// It is a data byte
        DataByteFromEditCol = lEditCol - mInMsgValueFirstByteCol + 4
    End If
Else
    '// The data bytes are sequential for the blah blah blah
    DataByteFromEditCol = lEditCol - mInMsgFirstHeaderCol + 1
End If

End Function

