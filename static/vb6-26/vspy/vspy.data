Private Sub mnuToolsWizStats_Click()
    Dim mTest As cTest
    Dim sMsg As String
    Dim sFile As String
    Dim sCaption As String
    
    
    On Error GoTo MnuToolsWizError
    
    MousePointer = vbHourglass
    
    With cmn
        .DialogTitle = "Select Output File"
        .InitDir = App.Path
        .Flags = &H4&     '// Setup filters to hide read only and force existences of file &H1000& 'Or
        .Filter = "HTML (intra/inter-net) (*.htm)|*.htm|Comma Seperated Files (*.csv)|*.csv"
        .ShowOpen
        sFile = .FileName
    End With
        
    
    '// create the message to show the wizard
    sMsg = "The buffer stats wizard will take the buffer that " & _
        "is currently viewed and then determine statistics on it."
    
    sMsg = sMsg & vbCrLf & vbCrLf
    sMsg = sMsg & "Press ok to continue"
    
    '// show the message
    MsgBox sMsg, vbInformation, "How the buffer statistics wizard works..."
    
    
    
    '// use the wizard
    Call obApp.BufferStatsWizard(obApp.Monitor.Buffer, sFile, sCaption)
    MousePointer = vbDefault

    '// open the file
    Call OpenThisDoc(Me.hwnd, sFile)
    
    '// return the mousepointer
    MousePointer = vbDefault
    

    Exit Sub

MnuToolsWizError:

    If Err.Number <> 32755 Then
        '// Report the error
        MsgBox "num " & Err.Description & " des: " & Err.Number
    End If
    
    '// return the mousepointer
    MousePointer = vbDefault

End Sub

