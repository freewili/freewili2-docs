Attribute VB_Name = "frmSaveFile"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public OkPressed As Boolean

Private Sub CmdCancel_Click()
    OkPressed = False
    Hide
End Sub

Private Sub cmdYes_Click()
    OkPressed = True
    Hide
End Sub

Private Sub Form_Load()
    Caption = LoadResString(136)
    lblFilenameCaption = LoadResString(137)
    lblNotesCaption = LoadResString(138)
    cmdYes.Caption = LoadResString(139)
End Sub

Private Sub txtFileName_KeyPress(KeyAscii As Integer)
    Select Case KeyAscii
        Case Asc("\"), Asc("/"), Asc(":"), Asc("*"), Asc("?"), Asc("<"), Asc(">"), Asc("|")
            KeyAscii = 0
    End Select
End Sub
