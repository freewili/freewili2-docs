Private Function GetBaudRate() As Long
    Dim lValue As Long
    
    Select Case HardwareBaudRate
        Case icsVSPYBaud9600
            lValue = 9600
        Case icsVSPYBaud19200
            lValue = 19200
        Case icsVSPYBaud28800
            lValue = 28800
        Case icsVSPYBaud38400
            lValue = 38400
        Case icsVSPYBaud57600
            lValue = 57600
    End Select
    
    '// return the baud rate
    GetBaudRate = lValue
End Function

'// This function opens the database ///////////////////////////
Public Function OpenDataBase() As Boolean
    Dim lResponse As Long
    
    On Error GoTo opendatabaseerror
    
    If DatabasePath <> "" Then
        If FileExists(DatabasePath) Then
            Set db = DBEngine.Workspaces(0).OpenDataBase(DatabasePath)
            Set tblInputs = db.OpenRecordset("InputTable", dbOpenTable)
            Set tblOutputs = db.OpenRecordset("OutputTable", dbOpenTable)
            OpenDataBase = True
        Else
            lResponse = MsgBox("The database file at path: " & DatabasePath & " doesn't exist." & _
                vbCrLf & vbCrLf & "Would you like to not use a database?", _
                                                vbQuestion + vbYesNo, "Problem locating database file")
            If lResponse = vbYes Then
                '// clear the database path
                DatabasePath = ""
            End If
            OpenDataBase = False
        End If
    Else
        OpenDataBase = False
    End If
    
    Exit Function
    
opendatabaseerror:
    
    MsgBox "There was an error opening the database. Please check file path" & vbCrLf _
        & vbCrLf & "Error Number: " & Err.Number & vbCrLf & "Description: " & Err.Description _
            , vbInformation, "Problem with database"
    
    OpenDataBase = False

End Function

'// This function adds an incoming message to the database
Friend Function AddIncomingMessageToDatabase(lIndex As Long) As Boolean

    Dim inMsg As cIncomingMessage
    
    On Error GoTo AddIncomingMessageToDatabaseError:
    
    If lIndex <= IncomingMessages.Count Then    '// Make sure index is with in bounds
        Set inMsg = IncomingMessages(lIndex)
        tblInputs.AddNew
        If inMsg.Description = "" Then
            tblInputs("Description") = "Unnamed message"
        Else
            tblInputs("Description") = inMsg.Description
        End If
        tblInputs("PT-Arb Id") = inMsg.DataByteString(1)
        tblInputs("Trgt-Rtm") = inMsg.DataByteString(2)
        tblInputs("Src") = inMsg.DataByteString(3)
        tblInputs("B1") = inMsg.DataByteString(4)
        tblInputs("B2") = inMsg.DataByteString(5)
        tblInputs("B3") = inMsg.DataByteString(6)
        tblInputs("Status") = inMsg.Status
        tblInputs("ValueType") = inMsg.ValueType
        tblInputs("Equation") = inMsg.Equation
        tblInputs("ValueSource") = inMsg.ValueSource
        tblInputs("DisplayColor") = inMsg.DisplayColor
        tblInputs.Update
    End If
    
    AddIncomingMessageToDatabase = True
    
    Exit Function
    
AddIncomingMessageToDatabaseError:
    
    AddIncomingMessageToDatabase = False
    Call MsgBoxShowErrorGeneric("There was an error adding an incoming message to the database.", "No suggestions")
    Err.Clear

End Function

Public Function AddVehicleSpyError(ByVal sError As String)
    RaiseEvent ErrorMessage(sError)
End Function
Friend Function AddOutgoingMessageToDatabase(lIndex As Long) As Boolean

Dim outMsg As cOutgoingMessage

On Error GoTo AddOutgoingMessageToDatabaseHandler '// Handle error handling

If lIndex <= OutgoingMessages.Count Then    '// Make sure index is with in bounds
    Set outMsg = OutgoingMessages(lIndex)
    tblOutputs.AddNew
    If outMsg.Description = "" Then
        tblOutputs("Description") = "Unnamed message"
    Else
        tblOutputs("Description") = outMsg.Description
    End If
    tblOutputs("PT") = outMsg.ByteString(1)
    tblOutputs("Trgt") = outMsg.ByteString(2)
    tblOutputs("Src") = outMsg.ByteString(3)
    tblOutputs("B1") = outMsg.ByteString(4)
    tblOutputs("B2") = outMsg.ByteString(5)
    tblOutputs("B3") = outMsg.ByteString(6)
    tblOutputs("B4") = outMsg.ByteString(7)
    tblOutputs("B5") = outMsg.ByteString(8)
    tblOutputs("B6") = outMsg.ByteString(9)
    tblOutputs("B7") = outMsg.ByteString(10)
    tblOutputs("B8") = outMsg.ByteString(11)
    tblOutputs("ValueType") = outMsg.ValueType
    tblOutputs("Value") = Val(outMsg.Value)
    tblOutputs("TXRate") = outMsg.UpdateRate
    'tblOutputs("Equation") = OutMsg.Equation( '// This does not work
    tblOutputs.Update
End If

AddOutgoingMessageToDatabase = True

Exit Function

AddOutgoingMessageToDatabaseHandler:

AddOutgoingMessageToDatabase = False
Call MsgBoxShowErrorGeneric("There was an error adding a outgoing message to the database.", "No suggestions")
Err.Clear

End Function

Friend Sub LoadListWithIncomingMessages(lst As Control)
    On Error GoTo LoadListWithIncomingMessagesError
    lst.Clear                                   '// Clear the list box
    If tblInputs.RecordCount = 0 Then Exit Sub  '// Check for a blank database
    tblInputs.MoveFirst                         '// Move to the first record
    Do While Not tblInputs.EOF                  '// Add all the items
        With lst
            .AddItem tblInputs("Description")
            .ItemData(.NewIndex) = tblInputs("ID")
        End With
        tblInputs.MoveNext
    Loop
    If lst.ListCount > 0 Then lst.ListIndex = 0    '// Set the first item in the list
    Exit Sub
LoadListWithIncomingMessagesError:
    Call MsgBoxShowErrorGeneric("There was an error loading  incoming messages from the database.", "No suggestions")
    Err.Clear
End Sub

Friend Sub LoadInputsWithAllDatabaseMessages()
    On Error GoTo LoadInputsWithAllDatabaseMessages:
    Dim inMsg As cIncomingMessage
    If tblInputs.RecordCount = 0 Then Exit Sub  '// Check for a blank database
    tblInputs.MoveFirst                         '// Move to the first record
    
    Do While Not tblInputs.EOF                  '// Add all the items
        Set inMsg = mvarcIncomingMessages.Add
        If Not TransferDataFromInputRecordToObject(inMsg) Then
            Exit Do
        End If
        tblInputs.MoveNext
    Loop
    Exit Sub
LoadInputsWithAllDatabaseMessages:
    Call MsgBoxShowErrorGeneric("There was an error loading incoming messages from the database.", "No suggestions")
    Err.Clear
End Sub
Friend Sub LoadOutputsWithAllDatabaseMessages()
    Dim outMsg As cOutgoingMessage
    On Error GoTo LoadOutputsWithAllDatabaseMessagesError:
    
    
    If tblOutputs.RecordCount = 0 Then Exit Sub  '// Check for a blank database
    tblOutputs.MoveFirst                         '// Move to the first record
    
    Do While Not tblOutputs.EOF                  '// Add all the items
        Set outMsg = mvarcMessages.Add
        If Not TransferDataFromOutputRecordToObject(outMsg) Then
            Exit Do
        End If
        tblOutputs.MoveNext
    Loop
    Exit Sub
LoadOutputsWithAllDatabaseMessagesError:
    Call MsgBoxShowErrorGeneric("There was an error loading outgoing messages from the database.", "No suggestions")
    Err.Clear
End Sub

Friend Sub LoadListWithOutputs(lst As Control)
    On Error GoTo LoadListWithOutputsError
    
    lst.Clear   '// Clear the list box
    If tblOutputs.RecordCount = 0 Then Exit Sub '// Check for a blank database
    tblOutputs.MoveFirst        '// Move to the first record
    Do While Not tblOutputs.EOF
        With lst
            .AddItem tblOutputs("Description")
            .ItemData(.NewIndex) = tblOutputs("ID")
        End With
        tblOutputs.MoveNext
    Loop
    If lst.ListCount > 0 Then lst.ListIndex = 0 '// Set the first item in the lis
    Exit Sub
LoadListWithOutputsError:
    Call MsgBoxShowErrorGeneric("There was an error loading outgoing messages from the database.", "No suggestions")
    Err.Clear
End Sub

Friend Function LoadInputMessageFromDatabase(DatabaseID As Long, sKey As String) As Boolean

On Error GoTo LoadInputMessageFromDatabaseError

Dim inMsg As cIncomingMessage

If OpenDataBase Then ' Open the database
    If IncomingMessages.KeyExists(sKey) Then
        Set inMsg = IncomingMessages(sKey)
        tblInputs.Index = "PrimaryKey"
        tblInputs.Seek "=", DatabaseID
        Call TransferDataFromInputRecordToObject(inMsg)
    End If
    CloseDataBase
    LoadInputMessageFromDatabase = True
Else
    LoadInputMessageFromDatabase = False
End If

Exit Function
LoadInputMessageFromDatabaseError:
    LoadInputMessageFromDatabase = False
    Call MsgBoxShowErrorGeneric("There was an error loading the incoming message from the database.", "No suggestions")
    Err.Clear

End Function

Private Function TransferDataFromInputRecordToObject(inMsg As cIncomingMessage) As Boolean
    
    On Error GoTo TransferDataFromInputRecordToObjectError
    
    If Not IsNull(tblInputs("Description")) Then inMsg.Description = tblInputs("Description")
    If Not IsNull(tblInputs("PT-Arb Id")) Then inMsg.DataByteString(1) = tblInputs("PT-Arb Id")
    If Not IsNull(tblInputs("Trgt-Rtm")) Then inMsg.DataByteString(2) = tblInputs("Trgt-Rtm")
    If Not IsNull(tblInputs("Src")) Then inMsg.DataByteString(3) = tblInputs("Src")
    If Not IsNull(tblInputs("B1")) Then inMsg.DataByteString(4) = tblInputs("B1")
    If Not IsNull(tblInputs("B2")) Then inMsg.DataByteString(5) = tblInputs("B2")
    If Not IsNull(tblInputs("B3")) Then inMsg.DataByteString(6) = tblInputs("B3")
    If Not IsNull(tblInputs("ValueType")) Then inMsg.ValueType = tblInputs("ValueType")
    If Not IsNull(tblInputs("ValueSource")) Then inMsg.ValueSource = tblInputs("ValueSource")
    If Not IsNull(tblInputs("DisplayColor")) Then inMsg.DisplayColor = tblInputs("DisplayColor")
    
    If IsNull(tblInputs("Equation")) Then
        inMsg.Equation = ""
    Else
        inMsg.Equation = tblInputs("Equation")
    End If
    If IsNull(tblInputs("Status")) Then
        inMsg.Status = ""
    Else
        inMsg.Status = tblInputs("Status")
    End If

    TransferDataFromInputRecordToObject = True
    
    Exit Function
    
TransferDataFromInputRecordToObjectError:

    TransferDataFromInputRecordToObject = False
    Call MsgBoxShowErrorGeneric("There was an error reading the incoming message from the database.", "No suggestions")
    Err.Clear

End Function

