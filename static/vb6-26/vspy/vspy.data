      Width           =   1785
   End
   Begin VB.Label lblExclude 
      Caption         =   "Exclude List"
      Height          =   195
      Left            =   4275
      TabIndex        =   12
      Top             =   45
      Width           =   1785
   End
   Begin VB.Label lblFilters 
      Caption         =   "Incoming Messages"
      Height          =   300
      Left            =   75
      TabIndex        =   11
      Top             =   0
      Width           =   1560
   End
   Begin VB.Menu mnuPop 
      Caption         =   "mnuPop"
      Begin VB.Menu mnuPopAddInclude 
         Caption         =   "Add to Include"
      End
      Begin VB.Menu mnuPopAddExclude 
         Caption         =   "Add to Exclude"
      End
      Begin VB.Menu mnuPopSep1 
         Caption         =   "-"
      End
      Begin VB.Menu mnuPopSelectAll 
         Caption         =   "Select All"
      End
   End
End
Attribute VB_Name = "filterUI"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Option Explicit

Public Filters As cFilters
Public obApp As cicsSpy
Public DonotShowExcluded As Boolean



Public Sub SetupUI()

Dim lCount As Long
Dim lNumItems As Long
Dim sDescription As String

If Not Filters.CompileFilterIndexes(obApp.IncomingMessages) Then
    MsgBox "There was an reference to a message that has been deleted." & vbCrLf & vbCrLf _
        & "The message reference will be deleted unless you press cancel. You may be able to still undo the delete operation that caused this problem.", _
                            vbInformation, "Problem with the filter setup"
End If


With obApp.IncomingMessages
    lNumItems = .Count
    For lCount = 1 To lNumItems
        sDescription = .Item(lCount).Description
        If sDescription = "" Then sDescription = "Message In " & lCount
        lstFilters.AddItem sDescription
    Next lCount
    If lNumItems > 0 Then
        lstFilters.ListIndex = 0
    Else
        cmdAddInclude.Enabled = False
        cmdAddExclude.Enabled = False
        lstFilters.Enabled = False
        mnuPop.Enabled = False
    End If
End With

'// Add the included filters to the list
With Filters
    lNumItems = .IncludedFiltersCount
    For lCount = 1 To lNumItems
        lstInclude.AddItem lstFilters.List(obApp.IncomingMessages.ReturnIndexFromKey(.IncludedFiltersKey(lCount)) - 1)
        lstInclude.ItemData(lstInclude.NewIndex) = obApp.IncomingMessages.ReturnIndexFromKey(.IncludedFiltersKey(lCount)) - 1
    Next lCount
End With

'// Add the included filters to the list
With Filters
    lNumItems = .ExcludedFiltersCount
    For lCount = 1 To lNumItems
        lstExclude.AddItem lstFilters.List(obApp.IncomingMessages.ReturnIndexFromKey(.ExcludedFiltersKey(lCount)) - 1)
        lstExclude.ItemData(lstExclude.NewIndex) = obApp.IncomingMessages.ReturnIndexFromKey(.ExcludedFiltersKey(lCount)) - 1
    Next lCount
End With

If DonotShowExcluded Then
    cmdAddExclude.Visible = False
    lstExclude.Visible = False
    lblExclude.Visible = False
    cmdRemoveExclude.Visible = False
    cmdOutWizard.Visible = False
    cmdExcludeClear.Value = False
End If
    


End Sub

Public Sub SaveUI()
    '// Add the included filters to the list
    Dim lNumItems As Long
    Dim lCount As Long

    lNumItems = lstInclude.ListCount
    With Filters
        .SetNumIncludedFilters lNumItems
        For lCount = 1 To lNumItems
            .IncludedFiltersKey(lCount) = obApp.IncomingMessages(lstInclude.ItemData(lCount - 1) + 1).Key
        Next lCount
    End With
    
    lNumItems = lstExclude.ListCount
    With Filters
        .SetNumExcludedFilters lNumItems
        For lCount = 1 To lNumItems
            .ExcludedFiltersKey(lCount) = obApp.IncomingMessages(lstExclude.ItemData(lCount - 1) + 1).Key
        Next lCount
    End With
End Sub

Private Sub cmdAddExclude_Click()
    Dim lCount As Long
    Dim lTotal As Long
    lTotal = lstFilters.ListCount - 1
    For lCount = 0 To lTotal
        If lstFilters.Selected(lCount) Then
            lstExclude.AddItem lstFilters.List(lCount)
            lstExclude.ItemData(lstExclude.NewIndex) = lCount
        End If
    Next lCount
End Sub

Private Sub cmdAddInclude_Click()
    Dim lCount As Long
    Dim lTotal As Long
    lTotal = lstFilters.ListCount - 1
    For lCount = 0 To lTotal
        If lstFilters.Selected(lCount) Then
            lstInclude.AddItem lstFilters.List(lCount)
            lstInclude.ItemData(lstInclude.NewIndex) = lCount
        End If
    Next lCount
End Sub

Private Sub cmdExcludeClear_Click()
    lstExclude.Clear '// clear the exclude listbox
End Sub

Private Sub cmdIncludeClear_Click()
    lstInclude.Clear '// clear the include list box
End Sub

Private Sub cmdOutWizard_Click()
    With frmFilterWizard
        Set .obApp = obApp
        Set .lstInclude = lstExclude
        .lblCaption = "Add to excluded filters all messages with these bytes:"
        .Setup
        .Show vbModal
    End With
    
    Set frmFilterWizard = Nothing
End Sub

Private Sub cmdRemoveExclude_Click()
'    If lstExclude.ListIndex >= 0 Then
'        lstExclude.RemoveItem lstExclude.ListIndex
'        If lstExclude.ListCount > 0 Then lstExclude.ListIndex = 0
'    End If
    
    Dim lCount As Long
    Dim lTotal As Long

    
    Do While lCount <= lstExclude.ListCount - 1
        If lstExclude.Selected(lCount) Then
            lstExclude.RemoveItem lCount
            lCount = lCount - 1
        End If
        lCount = lCount + 1
    Loop
    
    If lstExclude.ListCount > 0 Then lstExclude.ListIndex = 0
End Sub

Private Sub cmdRemoveInclude_Click()
    Dim lCount As Long
    Dim lTotal As Long

    
    Do While lCount <= lstInclude.ListCount - 1
        If lstInclude.Selected(lCount) Then
            lstInclude.RemoveItem lCount
            lCount = lCount - 1
        End If
        lCount = lCount + 1
    Loop
    
    If lstInclude.ListCount > 0 Then lstInclude.ListIndex = 0
    
End Sub

Private Sub cmdWizard_Click()
    With frmFilterWizard
        Set .obApp = obApp
        Set .lstInclude = lstInclude
        .Setup
        .Show vbModal
    End With
    
    Set frmFilterWizard = Nothing
End Sub

Private Sub lstExclude_DragDrop(Source As Control, X As Single, Y As Single)
cmdAddExclude_Click
End Sub

Private Sub lstFilters_DblClick()
    cmdAddInclude_Click
End Sub

Private Sub lstFilters_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If Button And vbRightButton Then
        PopupMenu mnuPop
    End If
End Sub

Private Sub lstFilters_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)

    If (Button And vbLeftButton) > 0 Then
        If X > lstFilters.Width Then
            lstFilters.Drag vbBeginDrag
        End If
    End If
End Sub

Private Sub lstInclude_DragDrop(Source As Control, X As Single, Y As Single)
    cmdAddInclude_Click
End Sub

Private Sub mnuPopAddExclude_Click()
    cmdAddExclude_Click
End Sub

Private Sub mnuPopAddInclude_Click()
    cmdAddInclude_Click
End Sub

Private Sub mnuPopSelectAll_Click()
    Dim lCount As Long
    Dim lTotal As Long
    lTotal = lstFilters.ListCount - 1
    For lCount = 0 To lTotal
        lstFilters.Selected(lCount) = True
    Next lCount
End Sub

Private Sub UserControl_Resize()
    Dim lWidth As Long
    Dim lHeight As Long
    Dim lNew As Long
    
    lHeight = ScaleHeight - 1000
    If lHeight <= 0 Then
        lHeight = lstFilters.Height
    End If
        
    '// determine the width
    lWidth = ScaleWidth \ 3
    
    '// labels
    lblFilters.Move 0, 0
    lblInclude.Move lWidth, 0
    lblExclude.Move lWidth * 2, 0
    
    '// list boxes
    lstFilters.Move 0, 250, lWidth, lHeight
    lstInclude.Move lWidth, 250, lWidth, lHeight
    lstExclude.Move lWidth * 2, 250, lWidth, lHeight
    
    '// remove and  clear buttons
    cmdRemoveExclude.Move lWidth * 2, lHeight + 250
    cmdRemoveInclude.Move lWidth, lHeight + 250
    lNew = lWidth * 2 + lWidth - cmdExcludeClear.Width - 50
    If lNew > 0 Then cmdExcludeClear.Move lNew, lHeight + 250
    lNew = lWidth + lWidth - cmdIncludeClear.Width - 50
    If lNew > 0 Then cmdIncludeClear.Move lNew, lHeight + 250
    
    '// add buttons
    cmdAddInclude.Move lWidth - cmdAddExclude.Width - 50, lHeight + 250
    cmdAddExclude.Move lWidth - cmdAddExclude.Width - 50, lHeight + 250 + cmdAddInclude.Height + 50
    cmdWizard.Move 0, lHeight + 250
    cmdOutWizard.Move 0, lHeight + 250 + cmdAddInclude.Height + 50
        
End Sub
