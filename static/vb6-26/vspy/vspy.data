Begin VB.Form frmSpyError 
   BorderStyle     =   4  'Fixed ToolWindow
   Caption         =   "ID140 - Vehicle Spy Error"
   ClientHeight    =   3195
   ClientLeft      =   45
   ClientTop       =   285
   ClientWidth     =   4680
   LinkTopic       =   "Form1"
   MaxButton       =   0   'False
   MinButton       =   0   'False
   ScaleHeight     =   3195
