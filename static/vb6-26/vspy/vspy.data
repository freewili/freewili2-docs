Attribute VB_Name = "General"
Option Explicit

'// Compile time constants
Public DebugOn As Boolean
Public InDemoMode As Boolean



'// Getting the system time
Public Declare Function timeGetTime Lib "winmm.dll" () As Long
'// Copying data (namely the data time)

Public Sub CollectionRemoveAll(mCol As Collection)
    Dim NumItems As Integer
    Dim iCount As Integer
    
    NumItems = mCol.Count
    '// Remove all items
    For iCount = 1 To NumItems
        mCol.Remove 1
    Next iCount
End Sub

Public Function CollectionKeyExists(mCol As Collection, sKey As String)
    Dim object As Object
    
    On Error Resume Next            '// turn off error checking

    Set object = mCol.Item(sKey)    '// reference the item property
    
    If Err.Number = 0 Then
        CollectionKeyExists = True
    Else
        CollectionKeyExists = False
    End If
    Set object = Nothing '// free the object
    Err.Clear
End Function



Public Sub MsgBoxShowErrorCommPort(sBasicDescription As String, sCauses As String)
'
 
 '// Report the error
    MsgBox sBasicDescription & vbCrLf & vbCrLf & "Suggested Cause(s) & fix(es): " & vbCrLf & sCauses _
         & vbCrLf & vbCrLf & "Technical Support Details " & vbCrLf & "Number: " & _
         Err.Number & vbCrLf & "Description: " & _
        Err.Description & vbCrLf, vbInformation, "Problem opening comm port"

End Sub

Public Sub MsgBoxShowErrorGeneric(sBasicDescription As String, Optional sCauses As String = "None")
    Dim sErrorDescription As String
    
    sErrorDescription = Err.Description
    If Len(sErrorDescription) = 0 Then
        sErrorDescription = "None"
    End If

    '// Report the error
    MsgBox sBasicDescription & vbCrLf & vbCrLf & "Suggested Cause(s) & fix(es): " & vbCrLf & sCauses _
         & vbCrLf & vbCrLf & "Technical Support Details " & vbCrLf & "Number: " & _
         Err.Number & vbCrLf & "Description: " & _
        sErrorDescription & vbCrLf, vbInformation, "Vehicle Spy Problem"
        
End Sub


Public Sub centerform(f As Form)
'/////////////////////////////////////////////////////
'          Center form
'/////////////////////////////////////////////////////

    f.Left = (Screen.Width - f.Width) / 2
    f.Top = (Screen.Height - f.Height) / 2
    
'/////////////////////////////////////////////////////

''* code to call this function
'// Center the form on the screen
'Call CenterForm(Me)

End Sub

'//
'// this piece of code trims long file names to fit into forms captions
'// text boxes, and other limited spaces. The code allows you to specify
'// the number of characters a file name must be before it performs the
'// triming. For example, if the label can hold 50 characters the you would
'// type LongDirFix(nFile,50). Its as simple as that.
'// VBPJ Tip 2-97 "Trimmed to Fit"
Public Function LongDirFix(Incoming As String, Max As Integer) As String
Dim i As Integer, lblLen As Integer, stringlen As Integer
Dim tempstring As String
tempstring = Incoming
lblLen = Max
If Len(tempstring) <= lblLen Then
    LongDirFix = tempstring
    Exit Function
End If
lblLen = lblLen - 6
For i = Len(tempstring) - lblLen To Len(tempstring)
    If Mid$(tempstring, i, 1) = "\" Then Exit For
Next
LongDirFix = Left$(tempstring, 3) + _
    "..." & Right$(tempstring, Len(tempstring) - (i - 1))
    
End Function


Public Function CreateDirectoryIfNotExists(sPath As String) As Boolean
    On Error GoTo ErrCreateDirectoryIfNotExists
    
    '// create the path if it does not exist
    If Not DirectoryExists(sPath) And sPath <> "" Then
        MkDir sPath
    End If
    CreateDirectoryIfNotExists = True
    
    Exit Function

ErrCreateDirectoryIfNotExists:

    CreateDirectoryIfNotExists = False
    Debug.Print "CreateDirectoryIfNotExists) error creating directory: " _
                    & sPath & " error description: " & Err.Description

End Function


'// Determines if the a directory exist or not
Public Function DirectoryExists(sPath As String) As Boolean
    If Dir$(sPath, vbDirectory) = "" Or Trim$(sPath) = "" Then
        DirectoryExists = False
    Else
        DirectoryExists = True
    End If
End Function

Public Function FileExists(sPath As String) As Boolean
    If Dir$(sPath) = "" Or Trim$(sPath) = "" Then
        FileExists = False
    Else
        FileExists = True
    End If
End Function
