Attribute VB_Name = "cOutgoingMessage"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

Public Parent As cicsSpy

Private mByteString(1 To 20) As String
Private msg As icsSpyMessage

'local variable(s) to hold property value(s)
Private mvarDescription As String 'local copy
Private mvarValueType As icsVSPYOutgoingType
Private mvarValue As Double
Private mvarUpdateRate As Double

Private mvarFormat As String
Private mvarUpperRange As Double
Private mvarLowerRange As Double
Private mvarAutoRespondValueFile As String
Private mvarNextUpdateTime As Long
Private m_sKey As String

Event DescriptionChanged()

Friend Property Let ItemByteArray(bArray() As Byte)
    Dim ob As New cBinaryStorage
    Dim lVersion As Long
    ob.WriteDirection = False
    ob.UseByteArray = True      '// setup for a byte array
    ob.Bytes = bArray
    Call Me.ReadWrite(False, ob, lVersion)
    ob.UseByteArray = False
End Property

Friend Property Get ItemByteArray() As Byte()
    Dim ob As New cBinaryStorage
    Dim lVersion As Long
    ob.WriteDirection = True
    ob.UseByteArray = True      '// setup for a byte array
    Call Me.ReadWrite(True, ob, lVersion)
    ItemByteArray = ob.Bytes
    ob.UseByteArray = False
End Property


