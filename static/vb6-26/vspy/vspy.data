Private Sub ObApp_MessagesPerTimeInMs(ByVal NumberOfMessages As Long, ByVal NumberOfMilliseconds As Long)
    
    Dim dNewBusload As Double
    
    On Error Resume Next
    
    If obApp.MonitorOn And obApp.Performance.TextMonitorUpdateType = icsspyPerformanceMonitorDoNotAttempt Then
        Exit Sub
    End If
    
    '// calculate the bus load
    dNewBusload = (NumberOfMessages / NumberOfMilliseconds * 1000) ' / obApp.Monitor.BusLoadMaxMessages * 100
    'Debug.Print dNewBusload
    
    '// set the bus load
    If dNewBusload > pgBusLoad.Max Then
        pgBusLoad = pgBusLoad.Max
    Else
        pgBusLoad = CLng(dNewBusload)
    End If
    
End Sub

Private Sub obApp_PlaySound(sSound As String)
    Dim lStart As Long
    
    If sSound <> "" Then
        If Dir$(sSound) <> "" Then
            If mmSound.IsAudioOutInstalled Then
                With mmSound
                    .filepath = sSound
                    If Not .PlaySound Then
                        SendKeys "^%", True
                        'Sleep 10
                        lStart = timeGetTime
                        Do
                        Loop Until timeGetTime > (lStart + 25)
                        If Not .PlaySound Then
                            Debug.Print .LastErrorString
                        End If
                    End If
                End With
            End If
        End If
    End If
End Sub

