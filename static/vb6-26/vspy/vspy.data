'local variable to hold collection
Private mCol As Collection
Public Function Add(ByteValue As Byte, Optional sKey As String) As cMessageByte
    'create a new object
    Dim objNewMember As cMessageByte
    Set objNewMember = New cMessageByte


    'set the properties passed into the method
    objNewMember.ByteValue = ByteValue

    If Len(sKey) = 0 Then
        mCol.Add objNewMember
    Else
        mCol.Add objNewMember, sKey
    End If


    'return the object created
    Set Add = objNewMember
    Set objNewMember = Nothing


End Function

