Private Sub pctmonTest_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim lnewleft As Long
    
    pctmonTest.MousePointer = vbSizeWE
    
    If Button And vbLeftButton Then
        lnewleft = pctmonTest.Left + X
        If lnewleft < (ScaleWidth - 100) Then
            pctResize.Move lnewleft, pctmonTest.Top, 75, pctmonTest.Height
        End If
    End If
    
End Sub
Private Sub pctmonTest_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If Button And vbLeftButton Then
        pctResize.Visible = True
    End If
End Sub

Private Sub pctmonTest_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim lNew As Long
    If Button And vbLeftButton Then
        lNew = ScaleWidth - pctResize.Left
        MiddleBarPercentRL = lNew / (ScaleWidth - tbMonitor.Width)
        pctResize.Visible = False               '// Hide the resizing bar
        Call Form_Resize
        Call UpdateMonitorDisplay(True)
    End If
End Sub

Private Sub pctmonTest_Resize()
    Dim lNewHeight As Long
    Dim lValuesHeight As Long
    Dim lNewWidth As Long
    
    
    '// limit the range of percent
    If MiddleBarPercent > 1 Then MiddleBarPercent = 1
    If MiddleBarPercent < 0.01 Then MiddleBarPercent = 0.01
    lNewHeight = (pctmonTest.ScaleHeight - 100) * MiddleBarPercent
    
    If lNewHeight > 0 Then
        lValuesHeight = pctmonTest.ScaleHeight - lNewHeight - 100
        lNewWidth = pctmonTest.ScaleWidth - 75
        If lValuesHeight > 0 And lNewWidth > 0 Then
            gTest.Move 75, 0, lNewWidth, lNewHeight
            gValues.Move 75, gTest.Height + 100, lNewWidth, lValuesHeight
        End If
        pctMiddle.Move 75, gTest.Height, pctmonTest.ScaleWidth, 100
    End If
    
End Sub

Private Sub HandleOLEDragDropDataFiles(bDropMonitor As Boolean, vFiles() As String, lNumFiles)
    Dim lCount As Long
    Dim sFile As String
    Dim bFoundFirstCSV As Boolean
    Dim bCSVFileCount As Long
    Dim obTest As cTest
    
    MousePointer = vbHourglass '// make the hourglass pointer
    '// is the format a list of files
    
        '// Load the buffer
        For lCount = 1 To lNumFiles
            sFile = vFiles(lCount)  '// get the file name
        
            '// make sure it is a CSV file
            If Len(sFile) > 4 Then
                If LCase(Right$(sFile, 4)) = ".csv" Then
                    bCSVFileCount = bCSVFileCount + 1 '// count how many csv files
                    If Not bFoundFirstCSV And bDropMonitor Then
                        bFoundFirstCSV = True
                        If Not obApp.Monitor.MonitorBuffer.LoadBufferFromFile(vFiles(lCount)) Then
                            MsgBox "There was an problem loading this buffer." & vbCrLf & vbCrLf & "Details: " & obApp.Monitor.MonitorBuffer.LastErrorString, vbInformation, "Problem opening file"
                            obApp.Monitor.MonitorBuffer.Reset
                        End If
                    Else
                        '// add as an additional test
                        Set obTest = obApp.Tests.Add
                        If obTest.Buffer.LoadBufferFromFile(vFiles(lCount)) Then
                            obTest.Description = vFiles(lCount)
                        Else
                            MsgBox "There was an problem loading this buffer." & vbCrLf & vbCrLf & "Details: " & obApp.Monitor.MonitorBuffer.LastErrorString, vbInformation, "Problem opening file"
                            Set obTest = Nothing
                            obApp.Tests.Remove obApp.Tests.Count
                        End If
                    End If
                End If
            End If
        Next lCount
        
        '// update the tests grid if we added a buffer to the test collection
        If bCSVFileCount > 1 Or Not bDropMonitor Then Call InitializeTheTestsGrid
    
    MousePointer = vbDefault '// return the pointer
End Sub

Private Sub pctRead_OLEDragDrop(data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim sFiles() As String
    Dim lCount As Long
    
    If data.GetFormat(vbCFFiles) Then
        ReDim sFiles(1 To data.Files.Count)
        For lCount = 1 To data.Files.Count
            sFiles(lCount) = data.Files(lCount)
        Next lCount
        '// handle the drag/drop
        HandleOLEDragDropDataFiles True, sFiles, data.Files.Count
    End If
    
End Sub

Private Sub pctRead_OLEDragOver(data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single, State As Integer)
    Dim lCount As Long
    Dim sFile As String
    Dim bDropOk As Boolean

    '// do not allow drops during run
    If obApp.MonitorOn Then
        Effect = vbDropEffectNone
        Exit Sub
    End If

    '// The picture box only accepts files
    If data.GetFormat(vbCFFiles) Then
        For lCount = 1 To data.Files.Count
            sFile = data.Files(lCount)  '// get the file name
            If Len(sFile) > 4 Then
                If LCase(Right$(sFile, 4)) = ".csv" Then
                    bDropOk = True
                    Exit For
                End If
            End If
        Next lCount
        If Not bDropOk Then Effect = vbDropEffectNone
    Else
        Effect = vbDropEffectNone
    End If
End Sub


Private Sub pctRead_Paint()
        
    '// Paint the picture to the display
    UpdateMonitorDisplay (True)
End Sub

Private Sub pctRead_Resize()
    Dim lNew As Long
    Dim lWholePage As Long
    
    '// position the scroll bar
    lNew = pctRead.ScaleWidth - scl.Width
    If lNew > 0 Then
        scl.Move lNew, 0, scl.Width, pctRead.ScaleHeight
        scl.Left = lNew
    End If
    
    '// reset the scrolling if we are currently paused
    If Not (obApp Is Nothing) Then
        If obApp.Monitor.Paused Then
            lWholePage = NumberOfDisplayedLines
            If lWholePage <> obScl.lItemsPerPage Then
                obScl.SetupScroll lWholePage
            End If
        End If
    End If
End Sub


Private Sub pgBusLoad_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If (Button And vbRightButton) > 0 Then
        PopupMenu mnubusload
    End If
End Sub

Private Sub pgBusLoad_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim sNew As String
    sNew = Format$(obApp.CurrentBusLoadMsgPerSec, "0") & " msg/sec of max " & obApp.Monitor.BusLoadMaxMessages
    If pgBusLoad.ToolTipText <> sNew Then pgBusLoad.ToolTipText = sNew
    Call ShowHelpFile("spyBusTraffic.htm")
End Sub

Private Sub sBar_Resize()
    Dim lNewWidth As Long
    
    cmdMasterTx.Left = 0
    tbsTX.TabFixedHeight = sBar.ScaleHeight
    lNewWidth = sBar.ScaleWidth - cmdMasterTx.Width - 20
    If lNewWidth > 0 Then
        tbsTX.Move cmdMasterTx.Width + 20, 0, lNewWidth, sBar.ScaleHeight
    End If
End Sub



Private Sub InsertOutgoing()
    Dim lNewRowPosition As Long
    Dim obOut As cOutgoingMessage
    
    Set obOut = obApp.OutgoingMessages.Add
    lNewRowPosition = grdOutgoingMessages.Row
    If lNewRowPosition = 0 Then lNewRowPosition = 1
    Call grdOutgoingMessages.AddItem("", lNewRowPosition)
    grdOutgoingMessages.TextMatrix(lNewRowPosition, 0) = obOut.Key
    Call UpdateOutgoingMessageRow(lNewRowPosition)
    RaiseEvent NumberOfOutputsChanged
    
End Sub

Private Sub OutgoingDeleteItems()
    Dim lRowToDelete As Long
    Dim sDeleteKey As String
    
    If grdOutgoingMessages.Rows > 2 Then
        lRowToDelete = grdOutgoingMessages.Row
        sDeleteKey = grdOutgoingMessages.TextMatrix(lRowToDelete, 0)
        Call obApp.UndoStack.Add("Undo Delete Outgoing Message " _
            & obApp.OutgoingMessages(sDeleteKey).Description, _
            cicsUndoDeleteOutgoingMessages, obApp.OutgoingMessages(sDeleteKey).ItemByteArray, sDeleteKey)
        
        obApp.OutgoingMessages.Remove sDeleteKey
        Call grdOutgoingMessages.RemoveItem(lRowToDelete)
        RaiseEvent NumberOfOutputsChanged
    End If
    
End Sub

Private Sub IncomingDeleteItems()
    
    Dim lRowToDelete As Long
    Dim sDeleteKey As String

    If grdIncomingMessages.Rows > 2 Then
        lRowToDelete = grdIncomingMessages.Row
        sDeleteKey = grdIncomingMessages.TextMatrix(lRowToDelete, 0)
        Call obApp.UndoStack.Add("Undo Delete Incoming Message (" & obApp.IncomingMessages(sDeleteKey).Description & ")", _
            cicsUndoDeleteIncomingMessages, obApp.IncomingMessages(sDeleteKey).ItemByteArray, sDeleteKey)
        obApp.IncomingMessages.Remove sDeleteKey
        Call grdIncomingMessages.RemoveItem(lRowToDelete)
        Call InitializeTheValuesGrid '// make sure the value grid matches
    End If
    
End Sub




Private Sub SysInfo1_DisplayChanged()
    '// change vspy if it is not on the screen
    If Left + Width > SysInfo1.WorkAreaWidth Then
        Me.Left = SysInfo1.WorkAreaLeft
        Me.Width = SysInfo1.WorkAreaWidth
    End If
    If Top + Height > SysInfo1.WorkAreaHeight Then
        Me.Top = SysInfo1.WorkAreaTop
        Me.Height = SysInfo1.WorkAreaHeight
    End If
End Sub

Private Sub tb_ButtonClick(ByVal Button As msComctlLib.Button)
    Dim sDataDirectory As String
    Dim sNewTestName As String
    Dim lNewRowPos As Long
    
    
    Select Case Button.Key
        Case "explore"
            MousePointer = vbHourglass
            ExploreDirectory Me.hwnd, obApp.LogBook.LogBookDirectory
            MousePointer = vbDefault
        Case "sorta"
            Select Case CurrentView
                Case icsSpyIncomingMessagesView
                    grdIncomingMessages.Sort = flexSortGenericAscending
                Case icsSpyOutgoingMessagesView
                    grdOutgoingMessages.Sort = flexSortGenericAscending
                Case icsSpyTextView
                   ' gValues.Sort = flexSortGenericAscending
            End Select
        Case "sortd"
            Select Case CurrentView
                Case icsSpyIncomingMessagesView
                    grdIncomingMessages.Sort = flexSortGenericDescending
                Case icsSpyOutgoingMessagesView
                    grdOutgoingMessages.Sort = flexSortGenericDescending
                Case icsSpyTextView
                    'gValues.Sort = flexSortGenericDescending
            End Select
        Case "start"
            mnuRunStart_Click
        Case "stop"
            mnuRunStop_Click
        Case "viewchart"
            mnuViewChart_Click
        Case "viewfilter"
            mnuViewFilters_Click
        Case "viewscroll"
            mnuViewScroll_Click
        Case "viewmsg"
            mnuViewMessages_Click
        Case "viewnotes"
            mnuViewNotes_Click
        Case "add"
            obApp.App.SaveNeeded = True
            MousePointer = vbHourglass
            If mnuViewFilters.Checked = True Then
                Call IncomingInsertItems(1)
            ElseIf mnuViewMessages.Checked = True Then
                InsertOutgoing
            Else
                With obApp.Tests
                    .Add
                    Call InitializeTheTestsGrid
                    sNewTestName = InputBox("Please enter a name for the new test.")
                    If Trim$(sNewTestName) = "" Then
                        sNewTestName = "Generic Test " & obApp.Tests.Count
                    End If
                    .Item(obApp.Tests.Count).Description = sNewTestName
                End With
                Call InitializeTheTestsGrid
            End If
            MousePointer = vbDefault
        Case "delete"
            obApp.App.SaveNeeded = True
            MousePointer = vbHourglass
            If mnuViewFilters.Checked = True Then
                If bEditIncoming Then   '// Are we currently performing an edit
                    Call LeaveCellIncomingMessages
                End If
                IncomingDeleteItems
                'If obApp.IncomingMessages.Count > 0 And obApp.IncomingMessages.Count >= grdIncomingMessages.Row Then
                '    obApp.IncomingMessages.Remove grdIncomingMessages.Row
                '    Call InitializeTheIncomingMessagesGrid
                'End If
            ElseIf mnuViewMessages.Checked = True Then
                If bEditOutgoing Then   '// Are we currently performing an edit
                    Call LeaveCellOutgoingMessages
                End If
                OutgoingDeleteItems
'                If obApp.OutgoingMessages.Count > 0 And _
'                    obApp.OutgoingMessages.Count >= grdOutgoingMessages.Row Then
'                        obApp.OutgoingMessages.Remove grdOutgoingMessages.RowData(grdOutgoingMessages.Row)
'                        Call InitializeTheOutgoingMessagesGrid
'                End If
            Else
                If obApp.Tests.Count > 0 And obApp.Tests.Count >= gTest.Row Then
                    '// delete that test
                    Call obApp.UndoStack.Add("Undo Delete Test " & obApp.Tests(gTest.Row).Description, _
                            cicsUndoDeleteTest, obApp.Tests(gTest.Row).ItemByteArray, obApp.Tests(gTest.Row).Key)
                    RemoveViewOfTestMonitor True
                    obApp.Tests.Remove gTest.Row
                    Call InitializeTheTestsGrid
                End If
            End If
            MousePointer = vbDefault
        Case "testsetup"
            mnuTestEdit_Click
    End Select
End Sub


Private Sub InitializeTheOutgoingMessagesGrid()


Dim lCount As Long
Dim lNumItems As Long

With grdOutgoingMessages
    .Redraw = False
    
    '// what are the default columns
    mOutMsgDescriptionCol = 1
    mOutMsgFirstHeaderCol = 2
    
    Select Case obApp.Protocol
        Case icsVSPYProtocolCAN
            .Cols = 16
            
            .TextMatrix(0, mOutMsgFirstHeaderCol) = "Arb ID"
            .ColWidth(mOutMsgFirstHeaderCol) = 1200
            
            .TextMatrix(0, mOutMsgFirstHeaderCol + 1) = "Rtm"
            .ColWidth(mOutMsgFirstHeaderCol + 1) = 600
            
            mOutMsgValueCol = 13
            mOutMsgValueTypeCol = 12
            mOutMsgUpdateRateCol = 14
            mOutMsgLastByteCol = 11
            mOutMsgFirstByteCol = 4
            mOutMsgRespondFileName = 15
        Case Else
    
            mOutMsgValueCol = 14
            mOutMsgValueTypeCol = 13
            mOutMsgUpdateRateCol = 15
            mOutMsgLastByteCol = 12
            mOutMsgFirstByteCol = 5
            mOutMsgRespondFileName = 16
        
            .Cols = 17
            
            .TextMatrix(0, mOutMsgFirstHeaderCol) = "PT"
            .TextMatrix(0, mOutMsgFirstHeaderCol + 1) = "Trgt"
            .TextMatrix(0, mOutMsgFirstHeaderCol + 2) = "Src"
            .ColWidth(mOutMsgFirstHeaderCol) = 400
            .ColWidth(mOutMsgFirstHeaderCol + 1) = 400
            .ColWidth(mOutMsgFirstHeaderCol + 2) = 400
            
    End Select
    
    
    .ColWidth(mOutMsgDescriptionCol) = 2000
    .TextMatrix(0, 0) = "Key": .ColWidth(0) = 700
    .TextMatrix(0, mOutMsgDescriptionCol) = "Description"
    .TextMatrix(0, mOutMsgValueTypeCol) = "Value Type"
    .TextMatrix(0, mOutMsgValueCol) = "Value"
    .TextMatrix(0, mOutMsgUpdateRateCol) = "Tx Rate (S)"
    .TextMatrix(0, mOutMsgRespondFileName) = "Respond File"
    .TextMatrix(0, mOutMsgFirstByteCol) = "B1"
    .TextMatrix(0, mOutMsgFirstByteCol + 1) = "B2"
    .TextMatrix(0, mOutMsgFirstByteCol + 2) = "B3"
    .TextMatrix(0, mOutMsgFirstByteCol + 3) = "B4"
    .TextMatrix(0, mOutMsgFirstByteCol + 4) = "B5"
    .TextMatrix(0, mOutMsgFirstByteCol + 5) = "B6"
    .TextMatrix(0, mOutMsgFirstByteCol + 6) = "B7"
    .TextMatrix(0, mOutMsgFirstByteCol + 7) = "B8"
    
    
    .ColWidth(mOutMsgValueCol) = 1200
    .ColWidth(mOutMsgValueTypeCol) = 1200
    .ColWidth(mOutMsgUpdateRateCol) = 1200
    .ColWidth(mOutMsgRespondFileName) = 1200
    

    For lCount = mOutMsgFirstByteCol To mOutMsgFirstByteCol + 7
        .ColWidth(lCount) = 400
    Next lCount
    
    '// Setup the rows
    lNumItems = obApp.OutgoingMessages.Count
    .Rows = lNumItems + 1
    
    '// Setup the incoming messages drop down
    FillOutgoingMessagesListBox
    
    For lCount = 1 To lNumItems
        .TextMatrix(lCount, 0) = obApp.OutgoingMessages(lCount).Key '// set the key string
        Call UpdateOutgoingMessageRow(lCount)
    Next lCount
    .Redraw = True
End With

'// update the tx panel if it is visible
If frmTXPanel.Visible = False Then
    Unload frmTXPanel
Else
    frmTXPanel.SetupUI
End If

'// make sure the indexes do not become invalid
VerifyTheRequestResponseIndexes

End Sub

'// this function checks to make sure refered to indexes are still valid
Private Sub VerifyTheRequestResponseIndexes()
    
    Dim lCount As Long
    Dim inMsg As cIncomingMessage
    Dim lNumOutgoing As Long
    Dim bIndexChanged As Boolean
    
    '// cache the number of outgoing messages
    lNumOutgoing = obApp.OutgoingMessages.Count

    With obApp.IncomingMessages
        For lCount = 1 To .Count
           Set inMsg = .Item(lCount)
           
           '// check the request index
           If inMsg.RequestIndex > lNumOutgoing Then
                inMsg.RequestIndex = 0
                bIndexChanged = True
           End If
           
            '// check the response index
            If inMsg.ResponseIndex > lNumOutgoing Then
                 inMsg.ResponseIndex = 0
                 bIndexChanged = True
            End If
                 
            If bIndexChanged Then 'update the row
                UpdateIncomingMessageRow lCount
                MsgBox "The incoming message: " & inMsg.Description & _
                    " has an invaild referece to an outgoing message. The reference has been deleted.", vbInformation, "Problem with incoming message"
            End If
            
            '// reset the changed flag
            bIndexChanged = False
                
        Next lCount
    End With
    
End Sub


Private Sub FillOutgoingMessagesListBox()
    Dim sName As String
    Dim lCount As Long
    
    lstOutgoingMessages.Clear
    lstOutgoingMessages.AddItem "None"
    For lCount = 1 To obApp.OutgoingMessages.Count
        sName = obApp.OutgoingMessages(lCount).Description
        If sName = "" Then sName = "Unamed message " & lCount
        lstOutgoingMessages.AddItem sName
    Next lCount

End Sub


'// Called when in cell editing is started, it sets up the helper controls
Private Sub StartEditIncomingMessages(Optional lFirstChar As Long = -1)
    Dim sTemp As String
    Dim sNewEquation As String
    Dim lTempIndex As Long
    
    Const NO_INTIAL_CHARACTER = -1
    
    '// Trap enter keys from becoming the first character
    If lFirstChar = 13 Then lFirstChar = NO_INTIAL_CHARACTER
    
    '// Set the edit row and col properties
    lEditCol = grdIncomingMessages.Col
    lEditRow = grdIncomingMessages.Row
    sEditKey = grdIncomingMessages.TextMatrix(lEditRow, 0)
    
    If lEditRow = 0 Then Exit Sub
    
    '// First set the type of control to edit with based on column
    '// Store it to the private editcontrol member
    Select Case lEditCol
        Case mInMsgReponseCol
            FillOutgoingMessagesListBox '// fill the outgoing message box with the latest message descriptions
            With frmAutoRespond
                .sIncomingMessageKey = sEditKey
                Set .obApp = obApp
                .SetupUI
                .Show vbModal
            End With
            Call UpdateIncomingMessageRow(lEditRow)     '// update the changes
            obApp.RefreshIncomingMessageFilterTable     '// refresh the filter table
            Call GotoNextColumn(grdIncomingMessages)    '// goto the next column
            Exit Sub
        Case mInMsgRequestCol
            FillOutgoingMessagesListBox '// fill the outgoing message box with the latest message descriptions
            Set EditControl = lstOutgoingMessages
        Case mInMsgDescriptionCol
            Set EditControl = lstIncomingMessageDescription
            
        Case mInMsgValueTypeCol
            Set EditControl = lstIncomingMessageValueType
            
        Case mInMsgValueSourceCol
            UpdateValueSoureList
            Set EditControl = lstIncomingSource
        Case mInMsgStatusCol
            With frmBitwise
                .MaximumNumberOfBits = 31
                .HasBitDescriptions = True
                .sIncomingMessageKey = sEditKey
                .IsStatusByte = True
                Set .obApp = obApp
                .BitDescriptions = ReturnStatusBitDescriptions
                .SetupUI
                .Show vbModal
            End With
            Call UpdateIncomingMessageRow(lEditRow)     '// update the changes
             
            obApp.RefreshIncomingMessageFilterTable '// refresh the filter table
            Call GotoNextColumn(grdIncomingMessages)    '// goto the next column
            Exit Sub
        Case mInMsgColorCol
            On Error Resume Next
            cmn.ShowColor
            If Err.Number = 0 Then
                obApp.IncomingMessages(sEditKey).DisplayColor = cmn.Color
                Call UpdateIncomingMessageRow(lEditRow) '// update the changes
                Call GotoNextColumn(grdIncomingMessages) '// goto the next column
                obApp.RefreshIncomingMessageFilterTable '// refresh the filter table
                obApp.App.SaveNeeded = True
            End If
            Exit Sub
        Case mInMsgEquationCol
        
            Select Case obApp.IncomingMessages(sEditKey).ValueType
             Case icsVSPYStateEncoded
                    With frmStateEncoded
                        Set .obApp = obApp              '// Give it a ref to the spy object
                        .sIncomingKeyString = sEditKey  '// Tell it what filter we are editing
                        .SetupUI
                        .Show vbModal, Me
                    End With
                Case icsVSPYASCII
                    With frmASCIIEquation
                        Set .obApp = obApp              '// Give it a ref to the spy object
                        .sIncomingKeyString = sEditKey  '// Tell it what filter we are editing
                        .SetupUI
                        .Show vbModal, Me
                    End With
                Case Else
                    '// Show the equation editor for the equation dialog and then exit
                    With frmIncomingEquation
                        .Expression = obApp.IncomingMessages(sEditKey).Equation
                        .IsDigital = obApp.IncomingMessages(sEditKey).ValueType = icsVSPYDigitalInput
                        .SetupUI                        '// Call to setup dialog
                        .Show vbModal, Me               '// Show modally
                        If .OkPressed Then
                            sNewEquation = .Expression
                            If sNewEquation <> obApp.IncomingMessages(sEditKey).Equation Then
                                obApp.IncomingMessages(sEditKey).Equation = sNewEquation
                                obApp.App.SaveNeeded = True
                            End If
                        End If
                    End With
                    Unload frmIncomingEquation
                    Set frmIncomingEquation = Nothing
            End Select
            Call UpdateIncomingMessageRow(lEditRow) '// update the changes
            obApp.RefreshIncomingMessageFilterTable '// refresh the filter table
            Call GotoNextColumn(grdIncomingMessages) '// goto the next column
            Exit Sub
        Case mInMsgFirstHeaderCol
            If obApp.Protocol = icsVSPYProtocolCAN Then
                Set EditControl = txtArbID
            Else
                If Not IsValidNumeric(CInt(lFirstChar), True) Then lFirstChar = NO_INTIAL_CHARACTER
                Set EditControl = txtIncomingMessageHexByte
            End If
        Case Else '// This must be a hex edit column
            '// Trap ivalid key input for the Hex only input
            If Not IsValidNumeric(CInt(lFirstChar), True) Then lFirstChar = NO_INTIAL_CHARACTER
            Set EditControl = txtIncomingMessageHexByte
    End Select
    '////////////////////////////////////////////////////////////////////
    
    
    '// Now set the edit control's inital value
    Select Case lEditCol
        Case mInMsgValueTypeCol
            '// Make it show its current value
            With EditControl
                .ListIndex = obApp.IncomingMessages(sEditKey).ValueType
                .Move grdIncomingMessages.CellLeft, grdIncomingMessages.Top + grdIncomingMessages.CellTop, _
                                    grdIncomingMessages.CellWidth
            End With
        Case mInMsgDescriptionCol
                With lstIncomingMessageDescription
                    .Move grdIncomingMessages.CellLeft, grdIncomingMessages.Top + grdIncomingMessages.CellTop, _
                                    grdIncomingMessages.CellWidth
                
                    .text = obApp.IncomingMessages(sEditKey).Description
                End With
                
        Case mInMsgValueSourceCol
            With lstIncomingSource
                .Move grdIncomingMessages.CellLeft, grdIncomingMessages.Top + grdIncomingMessages.CellTop, _
                                    grdIncomingMessages.CellWidth
                
                If obApp.IncomingMessages(sEditKey).ValueSource >= 0 And _
                            obApp.IncomingMessages(sEditKey).ValueSource < .ListCount Then
                    .ListIndex = obApp.IncomingMessages(sEditKey).ValueSource
                End If
                
                
            End With
        Case mInMsgRequestCol
            With lstOutgoingMessages
                .Move grdIncomingMessages.CellLeft, grdIncomingMessages.Top + grdIncomingMessages.CellTop, _
                                    grdIncomingMessages.CellWidth
                If obApp.IncomingMessages(sEditKey).RequestKey = "" Then
                    .ListIndex = 0
                Else
                    lTempIndex = obApp.OutgoingMessages.ReturnIndexFromKey(obApp.IncomingMessages(sEditKey).RequestKey)
                    If lTempIndex <> 0 Then
                        .ListIndex = lTempIndex
                    End If
                End If
            End With
        Case Else   '// it is a data byte edit
            With EditControl
                If lFirstChar = NO_INTIAL_CHARACTER Then
                    sTemp = grdIncomingMessages.TextMatrix(lEditRow, lEditCol)
                    If lEditCol = mInMsgFirstHeaderCol And obApp.Protocol = icsVSPYProtocolCAN Then
                        If Len(sTemp) > 2 Then
                            If Mid$(sTemp, 1, 1) = "#" Then
                                .text = ""
                            Else
                                .text = sTemp
                            End If
                        Else
                            .text = ""
                        End If
                    Else
                        If Len(sTemp) > 2 Then
                            .text = ""
                        Else
                            .text = sTemp
                        End If
                    End If
                    .SelStart = 0
                    .SelLength = Len(EditControl)
                Else
                    .text = ""
                End If
                .Move grdIncomingMessages.CellLeft, grdIncomingMessages.Top + grdIncomingMessages.CellTop, _
                                    grdIncomingMessages.CellWidth, grdIncomingMessages.CellHeight
            End With
        
    End Select
     
    '// Turn editing on
    bEditIncoming = True
    
    '// Properties common to all controls
    With EditControl
        .Visible = True
        .SetFocus
        If lEditCol = mInMsgRequestCol Then
            Call SendMessage(lstOutgoingMessages.hwnd, CB_SHOWDROPDOWN, 1, 0) '// Show drop down
        End If
        If lEditCol = mInMsgDescriptionCol Then  '// This has to be sent after focus occurs
            Call SendMessage(lstIncomingMessageDescription.hwnd, CB_SHOWDROPDOWN, 1, 0) '// Show drop down
        End If
        If lEditCol = mInMsgValueTypeCol Then  '// This has to be sent after focus occurs
            Call SendMessage(lstIncomingMessageValueType.hwnd, CB_SHOWDROPDOWN, 1, 0) '// Show drop down
        End If
        If lEditCol = mInMsgValueSourceCol Then  '// This has to be sent after focus occurs
            Call SendMessage(lstIncomingSource.hwnd, CB_SHOWDROPDOWN, 1, 0) '// Show drop down
        End If
        
        '// Place the first character in th
        If lFirstChar <> NO_INTIAL_CHARACTER Then
            SendKeys Chr(lFirstChar)
        End If
    End With
    
End Sub

'// Called when in cell editing is started
Private Sub StartEditOutgoingMessages(Optional lFirstChar As Long = -1)
    Dim sTemp As String
    Const NO_INTIAL_CHARACTER = -1
 
    '// Store the edit location
    lEditRow = grdOutgoingMessages.Row
    If lEditRow = 0 Then Exit Sub
    sEditKey = grdOutgoingMessages.TextMatrix(lEditRow, 0)
    lEditCol = grdOutgoingMessages.Col
    
    '// Trap enter keys from becoming the first character
    If lFirstChar = 13 Then lFirstChar = NO_INTIAL_CHARACTER
    
    '// First set the type of control to edit with
    Select Case lEditCol
        Case mOutMsgDescriptionCol: Set EditControl = lstOutgoingMessageDescription
        Case mOutMsgValueTypeCol: Set EditControl = lstOutgoingMessageType
        Case mOutMsgUpdateRateCol: Set EditControl = lstOutgoingMessageTxRate
        Case mOutMsgValueCol: Set EditControl = txtOutgoingMessageValue
        Case Else
            If lEditCol = (mOutMsgDescriptionCol + 1) And obApp.Protocol = icsVSPYProtocolCAN Then
                Set EditControl = txtArbIDOut
            ElseIf lEditCol = (mOutMsgDescriptionCol + 2) And obApp.Protocol = icsVSPYProtocolCAN Then
                Set EditControl = lstOutRemoteFrame
            Else
                '// Trap ivalid key input for the Hex only input
                If Not IsValidNumeric(CInt(lFirstChar), False) Then lFirstChar = NO_INTIAL_CHARACTER
                Set EditControl = lstOutgoingMessageHexByte
            End If
    End Select
    
    
    '// Now set the editcontrols default value
    Select Case lEditCol
        Case mOutMsgValueTypeCol
            '// Make it show its current value
            With EditControl
                .ListIndex = obApp.OutgoingMessages(sEditKey).ValueType
                .Move grdOutgoingMessages.CellLeft, grdOutgoingMessages.Top + grdOutgoingMessages.CellTop, _
                                    grdOutgoingMessages.CellWidth
            End With
        Case mOutMsgDescriptionCol
            With EditControl
                .Move grdOutgoingMessages.CellLeft, grdOutgoingMessages.Top + grdOutgoingMessages.CellTop, _
                                    grdOutgoingMessages.CellWidth
                .text = obApp.OutgoingMessages(sEditKey).Description
            End With
        Case mOutMsgUpdateRateCol
            With EditControl
                .Move grdOutgoingMessages.CellLeft, grdOutgoingMessages.Top + grdOutgoingMessages.CellTop, _
                                    grdOutgoingMessages.CellWidth
                .text = ""
            End With
        Case Else
            
            If lEditCol = (mOutMsgDescriptionCol + 2) And obApp.Protocol = icsVSPYProtocolCAN Then
                EditControl.Move grdOutgoingMessages.CellLeft, grdOutgoingMessages.Top + grdOutgoingMessages.CellTop, _
                                    grdOutgoingMessages.CellWidth
                If Len(obApp.OutgoingMessages(sEditKey).ByteString(2)) >= 1 Then
                    If LCase$(Mid$(obApp.OutgoingMessages(sEditKey).ByteString(2), 1, 1)) = "y" Then
                        EditControl.ListIndex = 0
                    Else
                        EditControl.ListIndex = 1
                    End If
                End If
            Else
                With EditControl
                    If lFirstChar = NO_INTIAL_CHARACTER Then
                        sTemp = grdOutgoingMessages.TextMatrix(lEditRow, lEditCol)
                        If Len(sTemp) > 1 Then
                            If Mid$(sTemp, 1, 1) = "=" Then
                                .text = ""
                            Else
                                .text = sTemp
                            End If
                        Else
                            .text = sTemp
                        End If
                        .SelStart = 0
                        .SelLength = Len(EditControl)
                    Else
                        .text = ""
                    End If
                     .Move grdOutgoingMessages.CellLeft, grdOutgoingMessages.Top + grdOutgoingMessages.CellTop, _
                                    grdOutgoingMessages.CellWidth, grdOutgoingMessages.CellHeight
                End With
            End If
    End Select
    
    '// Turn editing on
    bEditOutgoing = True
    
    '// Properties common to all controls
    With EditControl
        .Visible = True
        .SetFocus
        If lEditCol = mOutMsgDescriptionCol Then
            Call SendMessage(lstOutgoingMessageDescription.hwnd, CB_SHOWDROPDOWN, 1, 0)
        End If
        If lEditCol = mOutMsgValueTypeCol Then  '// This has to be sent after focus occurs
            Call SendMessage(lstOutgoingMessageType.hwnd, CB_SHOWDROPDOWN, 1, 0) '// Show drop down
        End If
        If lEditCol = mOutMsgUpdateRateCol Then
            Call SendMessage(lstOutgoingMessageTxRate.hwnd, CB_SHOWDROPDOWN, 1, 0) '// Show drop down
        End If
        If lEditCol = (mOutMsgDescriptionCol + 2) And obApp.Protocol = icsVSPYProtocolCAN Then
            Call SendMessage(.hwnd, CB_SHOWDROPDOWN, 1, 0) '// Show drop down
        End If
        
        '// Place the first character in th
        If lFirstChar <> NO_INTIAL_CHARACTER Then
            SendKeys Chr(lFirstChar)
        End If
        
    End With

End Sub

'// Called when in cell editing is complete
Private Sub LeaveCellOutgoingMessages(Optional bAbortChanges As Boolean = False)
    If bEditOutgoing Then
        If Not bAbortChanges Then
            obApp.App.SaveNeeded = True
            Select Case lEditCol
                Case mOutMsgDescriptionCol
                    If lstOutgoingMessageDescription.ListIndex = -1 Then   '// did the user select from list?
                        obApp.OutgoingMessages(sEditKey).Description = EditControl.text
                    Else
                        If Not obApp.LoadOutputMessageFromDatabase(lstOutgoingMessageDescription.ItemData( _
                                                    lstOutgoingMessageDescription.ListIndex), sEditKey) Then
                            obApp.OutgoingMessages(sEditKey).Description = EditControl
                        End If
                    End If
                Case mOutMsgValueTypeCol
                    obApp.OutgoingMessages(sEditKey).ValueType = EditControl.ListIndex
                Case mOutMsgValueCol
                    If obApp.OutgoingMessages(sEditKey).ValueType = icsVSPYDigitalOutput Then
                        MsgBox "Only analog outputs can have a value. Please change value type.", vbInformation, "Problem with value entry"
                    End If
                    obApp.OutgoingMessages(sEditKey).Value = Val(txtOutgoingMessageValue)
                Case mOutMsgUpdateRateCol
                    obApp.OutgoingMessages(sEditKey).UpdateRate = Val(EditControl)
                Case Else
                    obApp.OutgoingMessages(sEditKey).ByteString(lEditCol - mOutMsgDescriptionCol) = EditControl
            End Select
            Call UpdateOutgoingMessageRow(lEditRow)
        End If
        '// clear the edits
        EditControl.Visible = False
        bEditOutgoing = False
    End If
End Sub

'// Called when in cell editing is complete
Private Sub LeaveCellIncomingMessages(Optional bAbortChanges As Boolean = False)

    If bEditIncoming Then
        If Not bAbortChanges Then
            obApp.App.SaveNeeded = True
            Select Case lEditCol
                Case mInMsgDescriptionCol
                    If lstIncomingMessageDescription.ListIndex = -1 Then   '// did the user select from list?
                        obApp.IncomingMessages(sEditKey).Description = EditControl
                    Else
                        If Not obApp.LoadInputMessageFromDatabase( _
                            lstIncomingMessageDescription.ItemData(lstIncomingMessageDescription.ListIndex), sEditKey) Then
                            obApp.IncomingMessages(sEditKey).Description = EditControl
                        End If
                    End If
                Case mInMsgValueTypeCol
                    obApp.IncomingMessages(sEditKey).ValueType = EditControl.ListIndex
                Case mInMsgValueSourceCol
                    obApp.IncomingMessages(sEditKey).ValueSource = EditControl.ListIndex
                Case mInMsgRequestCol
                    If EditControl.ListIndex > 0 Then
                        obApp.IncomingMessages(sEditKey).RequestKey = obApp.OutgoingMessages(EditControl.ListIndex).Key
                    Else
                        If EditControl.ListIndex = 0 Then
                            obApp.IncomingMessages(sEditKey).RequestKey = ""
                        End If
                    End If
                Case mInMsgEquationCol
                    '// Do nothing
                Case Else
                    obApp.IncomingMessages(sEditKey).DataByteString(DataByteFromEditCol(lEditCol)) = EditControl
                    obApp.IncomingMessages(sEditKey).ValueSource = icsVSPYSourceBus
            End Select
            '// refresh the filter table
            obApp.RefreshIncomingMessageFilterTable
        End If
        
        '// Return to default state
        EditControl.Visible = False
        bEditIncoming = False
        Call UpdateIncomingMessageRow(lEditRow)
    End If

End Sub



Private Sub tb_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim lX1  As Long
    Dim lX2 As Long
    
    '// start and stop buttons
    lX1 = tb.Buttons("start").Left
    lX2 = tb.Buttons("stop").Left + tb.Buttons("stop").Width
    If X > lX1 And X <= lX2 Then
        Call ShowHelpFile("spyStartStop.htm")
    End If
        
        
    '// add and delete buttons
    lX1 = tb.Buttons("add").Left
    lX2 = tb.Buttons("delete").Left + tb.Buttons("delete").Width
    If X > lX1 And X <= lX2 Then
        If mnuViewFilters.Checked = True Then
            Call ShowHelpFile("spyInAddDelete.htm")
        ElseIf mnuViewMessages.Checked = True Then
            Call ShowHelpFile("spyOutAddDelete.htm")
        Else
            Call ShowHelpFile("spyAddDelTests.htm")
        End If
    End If
    
    '// the graphical monitor
    lX1 = tb.Buttons("viewchart").Left
    lX2 = tb.Buttons("viewchart").Left + tb.Buttons("viewchart").Width
    If X > lX1 And X <= lX2 Then
        ShowHelpFile "spyGraphicalMonitor.htm"
    End If
    
    lX1 = tb.Buttons("explore").Left
    lX2 = tb.Buttons("explore").Left + tb.Buttons("explore").Width
    If X > lX1 And X <= lX2 Then
        ShowHelpFile "spyReviewingData.htm"
    End If
    
    
    '// the html logbook
    lX1 = tb.Buttons("viewnotes").Left
    lX2 = tb.Buttons("viewnotes").Left + tb.Buttons("viewnotes").Width
    If X > lX1 And X <= lX2 Then
        ShowHelpFile "spyHTMLLogBook.htm"
    End If
    
    '// the text monitor
    lX1 = tb.Buttons("viewscroll").Left
    lX2 = tb.Buttons("viewscroll").Left + tb.Buttons("viewscroll").Width
    If X > lX1 And X <= lX2 Then
        ShowHelpFile "spyTextMonitor.htm"
    End If
    
    '// the incoming messages
    lX1 = tb.Buttons("viewfilter").Left
    lX2 = tb.Buttons("viewfilter").Left + tb.Buttons("viewfilter").Width
    If X > lX1 And X <= lX2 Then
        ShowHelpFile "spyIncomingMessages.htm"
    End If
    
    '// the outgoing message button
    lX1 = tb.Buttons("viewmsg").Left
    lX2 = tb.Buttons("viewmsg").Left + tb.Buttons("viewmsg").Width
    If X > lX1 And X <= lX2 Then
        ShowHelpFile "spyOutgoingMessages.htm"
    End If
    
End Sub

Private Sub tbMonitor_ButtonClick(ByVal Button As msComctlLib.Button)
    '// Call the appropiate item on the monitor context menu
    Select Case Button.Key
        Case "relative"
            mnuMonitorRelative_Click
        Case "filterson"
            mnuMonitorFilterOn_Click
        Case "viewfilters"
            MousePointer = vbHourglass
            obApp.Monitor.ShowFiltersSetupForm obApp
            MousePointer = vbDefault
        Case "pause"
            mnuMonitorPaused_Click
        Case "clear"
            mnuMonitorDelete_Click
        Case "save"
            mnuMonitorSave_Click
        Case "testbuffer"
            If Button.Value = tbrUnpressed Then
                RemoveViewOfTestMonitor True
            End If
    End Select
End Sub

'// this function ends viewing of test data in the monitor /////////
Private Sub RemoveViewOfTestMonitor(bUpdateDisplay As Boolean)
    If obApp.Monitor.Paused Then mnuMonitorPaused_Click     '// turn of pause mode
    tbMonitor.Buttons("filterson").Enabled = True           '// re-enable filtering
    tbMonitor.Buttons("viewfilters").Enabled = True           '// re-enable filtering
    obApp.Monitor.UseTestBuffer = False                     '// turn-off use test buffer flag
    lCurrentTest = 0                                        '// change the current test to zero
    '// set the tab
    bProgramEdit_tsBuffers = True
    Set tsBuffers.SelectedItem = tsBuffers.Tabs(1)
    bProgramEdit_tsBuffers = False
    If bUpdateDisplay Then UpdateMonitorDisplay True                               '// a monitor display is required
        
End Sub
'//////////////////////////////////////////////////////////////////////

Private Sub tbMonitor_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    
    Dim lY1  As Long
    Dim lY2 As Long
    
    '// filter buttons
    lY1 = tbMonitor.Buttons("filterson").Top
    lY2 = tbMonitor.Buttons("viewfilters").Top + tbMonitor.Buttons("viewfilters").Height
    If Y > lY1 And Y <= lY2 Then
        Call ShowHelpFile("spyMonitorFilter.htm")
    End If
    
    '// abs/relative buttons
    lY1 = tbMonitor.Buttons("relative").Top
    lY2 = tbMonitor.Buttons("relative").Top + tbMonitor.Buttons("relative").Height
    If Y > lY1 And Y <= lY2 Then
        Call ShowHelpFile("spyTimeStamp.htm")
    End If
    
    '// pause button
    lY1 = tbMonitor.Buttons("pause").Top
    lY2 = tbMonitor.Buttons("pause").Top + tbMonitor.Buttons("pause").Height
    If Y > lY1 And Y <= lY2 Then
        Call ShowHelpFile("spyPause.htm")
    End If
    

    '// Clear/Delete
    lY1 = tbMonitor.Buttons("clear").Top
    lY2 = tbMonitor.Buttons("clear").Top + tbMonitor.Buttons("clear").Height
    If Y > lY1 And Y <= lY2 Then
        Call ShowHelpFile("spyDeleteBuffer.htm")
    End If
    
    '// save button
    lY1 = tbMonitor.Buttons("save").Top
    lY2 = tbMonitor.Buttons("save").Top + tbMonitor.Buttons("save").Height
    If Y > lY1 And Y <= lY2 Then
        Call ShowHelpFile("spySaveBuffer.htm")
    End If
    
    '// testbuffer
'    lY1 = tbMonitor.Buttons("testbuffer").Top
'    lY2 = tbMonitor.Buttons("testbuffer").Top + tbMonitor.Buttons("testbuffer").Height
'    If y > lY1 And y <= lY2 Then
'        Call ShowHelpFile("spyStopViewTest.htm")
'    End If
End Sub

Private Sub tbNotes_ButtonClick(ByVal Button As msComctlLib.Button)
    On Error Resume Next
    Select Case Button.Key
        Case "back"
            wbNotes.GoBack
        Case "forward"
            wbNotes.GoForward
        Case "print"
            Call PrintThisFile(Me.hwnd, wbNotes.LocationURL)
    End Select
End Sub

Private Sub tbScroll_ButtonClick(ByVal Button As msComctlLib.Button)
    
    
    Select Case Button.Key
        Case "description"
            With obApp.Monitor
                .ShowDescription = Button.Value = tbrPressed
                Call SetShowParameters(.ShowDescription, .ShowDataBytes, .DisplayFormat)
            End With
            UpdateMonitorDisplay True
        Case "databytes"
            With obApp.Monitor
                .ShowDataBytes = Button.Value = tbrPressed
                Call SetShowParameters(.ShowDescription, .ShowDataBytes, .DisplayFormat)
            End With
            UpdateMonitorDisplay True
        Case "format"
            ToggleDisplayFormat
    End Select
End Sub

Private Sub ToggleDisplayFormat()
    Dim lCurrentFormat As Long
    With obApp.Monitor
        lCurrentFormat = .DisplayFormat
        lCurrentFormat = lCurrentFormat + 1
        If lCurrentFormat > 2 Then
            lCurrentFormat = 0
        End If
        .DisplayFormat = lCurrentFormat
        tbScroll.Buttons("format").Image = .DisplayFormat + 3
        Call SetShowParameters(.ShowDescription, .ShowDataBytes, .DisplayFormat)
        UpdateMonitorDisplay True
    End With
End Sub

Private Sub tbScroll_ButtonMenuClick(ByVal ButtonMenu As msComctlLib.ButtonMenu)

    With obApp.Monitor
        .DisplayFormat = ButtonMenu.Index - 1
        tbScroll.Buttons("format").Image = ButtonMenu.Index + 2
        Call SetShowParameters(.ShowDescription, .ShowDataBytes, .DisplayFormat)
        UpdateMonitorDisplay True
    End With
    
End Sub

