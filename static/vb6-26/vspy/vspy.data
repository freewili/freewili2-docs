Attribute VB_Name = "cOutgoingMessages"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"No"
Attribute VB_Ext_KEY = "Collection" ,"cMessage"
Attribute VB_Ext_KEY = "Member0" ,"cMessage"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'local variable to hold collection
Private mCol As Collection
Private m_lKeyIndexCount As Long


Public Event NumberOfMessagesChanged()

Friend Property Let IndexCount(lCount As Long)
    m_lKeyIndexCount = lCount
End Property

Friend Property Get IndexCount() As Long
    IndexCount = m_lKeyIndexCount
End Property

Public Function ReturnIndexFromKey(sKey As String) As Long
    Dim lCount As Long
    Dim lNum As Long
    Dim obOut As cOutgoingMessage
    
    lNum = mCol.Count
    For lCount = 1 To lNum
        Set obOut = mCol(lCount)
        If obOut.Key = sKey Then
            ReturnIndexFromKey = lCount
            Exit For
        End If
    Next lCount
    
End Function

'// this is only called when the item is being called from the readwrite method
Friend Function PrivateAdd(sKey As String) As cOutgoingMessage
    Dim ob As New cOutgoingMessage
    
    mCol.Add ob, sKey           '// add it at the end
    ob.Key = sKey               '// set the key property
    'Set ob.Parent = Me          '// give the item a ref to the created item
    Set PrivateAdd = ob         '// Return the created item
    
    RaiseEvent NumberOfMessagesChanged
End Function


'// this adds an item to the collection
Public Function Add(Optional Before As Variant) As cOutgoingMessage
    Dim nStep As New cOutgoingMessage
    Dim sKey As String
    
    m_lKeyIndexCount = m_lKeyIndexCount + 1
    If m_lKeyIndexCount > 2 ^ 30 Then m_lKeyIndexCount = 1 '// doubt that this is needed (hope)
    
    sKey = "out" & m_lKeyIndexCount
    
    If IsEmpty(Before) Then
        mCol.Add nStep, sKey                '// add it at the end
    Else
        mCol.Add nStep, sKey, Before     '// add it in the middle
    End If
    
    nStep.Key = sKey
    'Set nStep.Parent = Me       '// give the item a ref to the created item
    Set Add = nStep             '// Return the created item
    
    RaiseEvent NumberOfMessagesChanged
    
End Function
'Public Function Add(Optional sKey As String) As cOutgoingMessage
'    'create a new object
'    Dim objNewMember As cOutgoingMessage
'    Set objNewMember = New cOutgoingMessage
'
'
'    'set the properties passed into the method
'    If Len(sKey) = 0 Then
'        mCol.Add objNewMember
'    Else
'        mCol.Add objNewMember, sKey
'    End If
'
'
'    'return the object created
'    Set Add = objNewMember
'    Set objNewMember = Nothing
'
'    RaiseEvent NumberOfMessagesChanged
'
'
'End Function
'
Public Property Get Item(vntIndexKey As Variant) As cOutgoingMessage
Attribute Item.VB_UserMemId = 0
    'used when referencing an element in the collection
    'vntIndexKey contains either the Index or Key to the collection,
    'this is why it is declared as a Variant
    'Syntax: Set foo = x.Item(xyz) or Set foo = x.Item(5)
  Set Item = mCol(vntIndexKey)
End Property



Public Property Get Count() As Long
    'used when retrieving the number of elements in the
    'collection. Syntax: Debug.Print x.Count
    Count = mCol.Count
End Property


Public Sub Remove(vntIndexKey As Variant)
    'used when removing an element from the collection
    'vntIndexKey contains either the Index or Key, which is why
    'it is declared as a Variant
    'Syntax: x.Remove(xyz)

    mCol.Remove vntIndexKey
    
    RaiseEvent NumberOfMessagesChanged
    
End Sub

Public Function KeyExists(Key As String) As Boolean '// indicates if a key exists in the collection
    KeyExists = CollectionKeyExists(mCol, Key)
End Function

Public Property Get NewEnum() As IUnknown
Attribute NewEnum.VB_UserMemId = -4
Attribute NewEnum.VB_MemberFlags = "40"
    'this property allows you to enumerate
    'this collection with the For...Each syntax
    Set NewEnum = mCol.[_NewEnum]
End Property


