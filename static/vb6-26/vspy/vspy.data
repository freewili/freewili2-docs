Public Sub ReadWriteByteArray2Dim(vData As Variant, Optional vReturnArray As Variant)

Dim lHeight As Long
Dim lWidth As Long
Dim byteArray() As Byte
Dim lDataLength As Long


If m_UseByteArray Then ' are we storing to a memory
    
    If IsEmpty(vData) Then
        
    Else
        byteArray = vData
        If m_bWriteMode Then
            lWidth = UBound(byteArray) + 1
            lHeight = UBound(byteArray, 2) + 1
        End If
    End If
    
    ReadWriteLong lWidth
    ReadWriteLong lHeight
    
    '// Length of data
    lDataLength = lWidth * lHeight
    
    If lDataLength <> 0 Then
        '// Copy the data
        If m_bWriteMode Then
            '// Determmine if we need to increase the byte size
            If (lDataLength + m_CurrentOffset) > m_CurrentMax Then
                Do
                    m_CurrentMax = m_CurrentMax + 1000
                    ReDim Preserve m_Byte(m_CurrentMax)
                Loop Until (lDataLength + m_CurrentOffset) < m_CurrentMax
            End If
            Call CopyData(byteArray(0, 0), m_Byte(m_CurrentOffset), lDataLength)
        Else
            ReDim byteArray(lWidth - 1, lHeight - 1)
            Call CopyData(m_Byte(m_CurrentOffset), byteArray(0, 0), lDataLength)
            vReturnArray = byteArray
        End If
    End If
    
    m_CurrentOffset = m_CurrentOffset + lDataLength
    
Else
    If m_bWriteMode Then
        '// Store the Double
        Put #m_iFileNumber, , vData
    Else
        '// Read a variant
        Get #m_iFileNumber, , vReturnArray
    End If
End If

End Sub

Public Sub ReadWriteLong(lData As Long)


If m_UseByteArray Then
    
    Const length = 4
    '// Copy the data
    If m_bWriteMode Then
        '// Determmine if we need to increase the byte size
        If (length + m_CurrentOffset) > m_CurrentMax Then
            m_CurrentMax = m_CurrentMax + 1000
            ReDim Preserve m_Byte(m_CurrentMax)
        End If
        Call CopyData(lData, m_Byte(m_CurrentOffset), length)
    Else
        Call CopyData(m_Byte(m_CurrentOffset), lData, length)
    End If
    
    m_CurrentOffset = m_CurrentOffset + length
    
Else
    '// Write to file
    If m_bWriteMode Then
        '// Store a long
        Put #m_iFileNumber, , lData
    Else
        '// Read a long
        Get #m_iFileNumber, , lData
    End If
End If

End Sub

Public Sub ReadWriteSingle(sgData As Single)

If m_UseByteArray Then
    Const length = 4
    '// Copy the data
    If m_bWriteMode Then
        '// Determmine if we need to increase the byte size
        If (length + m_CurrentOffset) > m_CurrentMax Then
            m_CurrentMax = m_CurrentMax + 1000
            ReDim Preserve m_Byte(m_CurrentMax)
        End If
        Call CopyData(sgData, m_Byte(m_CurrentOffset), length)
    Else
        Call CopyData(m_Byte(m_CurrentOffset), sgData, length)
    End If
    
    m_CurrentOffset = m_CurrentOffset + length
    
Else
    If m_bWriteMode Then
        '// Store the single
        Put #m_iFileNumber, , sgData
    Else
        '// Read a single
        Get #m_iFileNumber, , sgData
    End If
End If

End Sub

Public Property Get FileOpen() As Boolean
    '// Return the file open member
    FileOpen = m_bFileOpen
End Property

Public Property Let FileOpen(bOpenFile As Boolean)

'// Turn on error handling if appropiate
'If Not InDebugMode Then
    On Error GoTo FileOpenErrorHandle
'End If

'// Check and see if the path name was set or not
If Trim$(m_sfilepathname) = "" Then
    Debug.Print "Path name was not set"
End If

If bOpenFile Then
    '// Open the file if not already open
    If Not m_bFileOpen Then
        '// Open the file
        m_iFileNumber = FreeFile
        Open m_sfilepathname For Binary Access Read Write Shared As #m_iFileNumber
        m_bFileOpen = True
    Else
        Debug.Print "This file is already open!!"
    End If
Else
    '// Close the file if not already open
    If m_bFileOpen Then
        '// Close the file
        Close #m_iFileNumber
        m_bFileOpen = False
    Else
        Debug.Print "This file was already closed or it was never opened"
    End If
End If

Exit Property
FileOpenErrorHandle:

'// Report the errors
Dim errorMsg As String
Select Case Err.Number
    Case Else
        errorMsg = "There was an unhandled error in the file open command, cBinaryStorage"
        errorMsg = errorMsg & vbCrLf & " ( " & Err.Description & " ) "
        errorMsg = errorMsg & vbCrLf & vbCrLf & "Please fix problem and contact program vendor if this error persists."
End Select

'// Raise an error to be trapped in the calling function
Err.Raise vbObjectError + 2000, "cBinaryStorage::FileOpen", errorMsg

End Property

Private Sub Class_Initialize()
    '// Intialize data members
    m_bFileOpen = False
    m_UseByteArray = False
End Sub

Public Property Get FilePathName() As String

FilePathName = m_sfilepathname

End Property

Public Property Let FilePathName(sNewValue As String)
    m_sfilepathname = sNewValue
End Property

Public Property Get WriteDirection() As Boolean
    WriteDirection = m_bWriteMode
End Property

Public Property Let WriteDirection(bNewValue As Boolean)
    m_bWriteMode = bNewValue
End Property

Public Property Get FileNumber() As Integer
    FileNumber = m_iFileNumber
End Property

Public Property Let FileNumber(ByVal vNewValue As Integer)
    m_iFileNumber = vNewValue
End Property

Public Sub ReadWriteVariant(vData As Variant)

If m_UseByteArray Then
    
Else
    If m_bWriteMode Then
        '// Store the Double
        Put #m_iFileNumber, , vData
    Else
        '// Read a variant
        Get #m_iFileNumber, , vData
    End If
End If

End Sub


Public Sub ReadWriteArray(vData As Variant, Optional vReturnArray As Variant)

Dim lDataWidth As Long
Dim lLength As Long
Dim dArray() As Double
Dim sgArray() As Single
Dim byteArray() As Byte
Dim iArray() As Integer
Dim lArray() As Long

Dim lLowerBound As Long
Dim lCount As Long
Dim bEmpty As Boolean
Dim lVarType As Long


If m_bWriteMode Then
    If IsEmpty(vData) Then  '// was the passed array empty
        '// empty arrays indicate there is no data, this is ok
        lLength = 0
        bEmpty = True
    Else
        lVarType = VarType(vData)     '// get the vartype
        bEmpty = False          '// this is not empty
        
        '// this better be an array...
        If (lVarType And vbArray) = 0 Then
            MsgBox "the data type sent to readwritearray is not an array.", vbCritical
            lLength = 0
        End If
        
        
        Select Case lVarType
            Case (vbDouble + vbArray), (vbArray + vbSingle), _
                    (vbArray + vbByte), vbLong + vbArray, vbInteger + vbArray
                'ok
            Case Else
                lLength = 0
                MsgBox "this array data type is not supported by readwritearray"
        End Select
        
    End If
End If

If m_UseByteArray Then
    
    '// First determine the passed arrays length if in write mode
    If Not bEmpty Then
        If m_bWriteMode Then
            
            lLowerBound = LBound(vData)
            lLength = UBound(vData) - lLowerBound + 1
    
            Select Case lVarType
                Case (vbDouble + vbArray)
                    '// Copy the data to be written into a double array
                    ReDim dArray(1 To lLength)
                    For lCount = 1 To lLength
                        dArray(lCount) = vData(lCount - 1 + lLowerBound)
                    Next lCount
                    '/////
                Case (vbArray + vbSingle)
                    '// Copy the data to be written into a single array
                    ReDim sgArray(1 To lLength)
                    For lCount = 1 To lLength
                        sgArray(lCount) = vData(lCount - 1 + lLowerBound)
                    Next lCount
                Case vbLong + vbArray
                    '// Copy the data to be written into a long array
                    ReDim lArray(1 To lLength)
                    For lCount = 1 To lLength
                        lArray(lCount) = vData(lCount - 1 + lLowerBound)
                    Next lCount
                Case vbInteger + vbArray
                    '// Copy the data to be written into a long array
                    ReDim iArray(1 To lLength)
                    For lCount = 1 To lLength
                        iArray(lCount) = vData(lCount - 1 + lLowerBound)
                    Next lCount
                Case (vbArray + vbByte)
                    byteArray = vData
            End Select
        End If
    End If
    
    ReadWriteLong lVarType
    ReadWriteLong lLength '// Write the length
    
    Select Case lVarType
        Case vbDouble + vbArray: lDataWidth = 8
        Case vbArray + vbSingle: lDataWidth = 4
        Case vbArray + vbByte: lDataWidth = 1
        Case vbLong + vbArray: lDataWidth = 4
        Case vbInteger + vbArray: lDataWidth = 2
    End Select
    
    If lLength <> 0 Then
        '// Copy the data
        If m_bWriteMode Then
            
            '// Determmine if we need to increase the byte size of our byte cache
            If ((lLength * lDataWidth) + m_CurrentOffset) > m_CurrentMax Then
                Do
                    m_CurrentMax = m_CurrentMax + 1000
                    ReDim Preserve m_Byte(m_CurrentMax)
                Loop Until ((lLength * lDataWidth) + m_CurrentOffset) < m_CurrentMax
            End If
            
            Select Case lVarType
                Case (vbDouble + vbArray)
                    Call CopyData(dArray(1), m_Byte(m_CurrentOffset), lLength * lDataWidth)
                Case (vbArray + vbSingle)
                    Call CopyData(sgArray(1), m_Byte(m_CurrentOffset), lLength * lDataWidth)
                Case (vbArray + vbByte)
                    Call CopyData(byteArray(lLowerBound), m_Byte(m_CurrentOffset), lLength * lDataWidth)
                Case vbLong + vbArray
                    Call CopyData(lArray(1), m_Byte(m_CurrentOffset), lLength * lDataWidth)
                Case vbInteger + vbArray
                    Call CopyData(iArray(1), m_Byte(m_CurrentOffset), lLength * lDataWidth)
            End Select
            
        Else
            '// copy the data from the stream
            Select Case lVarType
                Case vbDouble + vbArray
                    ReDim dArray(lLength - 1)
                    Call CopyData(m_Byte(m_CurrentOffset), dArray(0), lLength * lDataWidth)
                    vReturnArray = dArray
                Case vbArray + vbSingle
                    ReDim sgArray(lLength - 1)
                    Call CopyData(m_Byte(m_CurrentOffset), sgArray(0), lLength * lDataWidth)
                    vReturnArray = sgArray
                Case vbArray + vbByte
                    ReDim byteArray(lLength - 1)
                    Call CopyData(m_Byte(m_CurrentOffset), byteArray(0), lLength * lDataWidth)
                    vReturnArray = byteArray
                Case vbLong + vbArray
                    ReDim lArray(lLength - 1)
                    Call CopyData(m_Byte(m_CurrentOffset), lArray(0), lLength * lDataWidth)
                    vReturnArray = lArray
                Case vbInteger + vbArray
                    ReDim iArray(lLength - 1)
                    Call CopyData(m_Byte(m_CurrentOffset), iArray(0), lLength * lDataWidth)
                    vReturnArray = iArray
            End Select
        End If
    End If
    
    m_CurrentOffset = m_CurrentOffset + (lLength * lDataWidth)
    
Else
    If m_bWriteMode Then
        '// Store the Double
        Put #m_iFileNumber, , vData
    Else
        '// Read a variant
        Get #m_iFileNumber, , vReturnArray
    End If
End If

End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cGPS"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Option Explicit

'// Copyright 1998-99 Intrepid Control Systems, Inc. All rights reserved
'// Intrepid Control Systems, Inc.
'// 43512 Mound Rd, Ste C
'// Sterling Heights, MI 48314
'// 810-731-7950
'// (website) www.intrepidcs.com
'// Written by: Dave Robins (drobins@intrepidcs.com)

'// Acknowledgements */
'// this software was assisted with the use of the NMEA faq
'// this can be found at URL: http://www.vancouver-webpages.com/pub/peter/nmeafaq.txt
'// the NMEQ Faq is authored by: Peter Bennett (bennett@triumf.ca)
'// for those of you wishing to expand the functionality of this software may need this document

Public WithEvents obComm As MSComm      '// ref to vb6 mscomm control
Attribute obComm.VB_VarHelpID = -1
Public WithEvents obTimer As Timer      '// ref to vb6 timer control
Attribute obTimer.VB_VarHelpID = -1

'// Enumerations (speed units)
Public Enum icsgpsSpeedUnits
    icsgpsMetersPerSecond
    icsgpsMilesPerHour
    icsgpsKMPerHour
    icsgpsKnots
    icsgpsFeetPerSecond
    icsgpsCentimetersPerSecond
End Enum

'//
Public Enum icsgpsAltitudeUnits
    icsgpsMeters
    icsgpsFeet
End Enum

'// Events
Public Event PropertiesUpdated()

'// used for time analysis
Private Declare Function timeGetTime Lib "winmm.dll" () As Long


'// private member variables
Private mLatitude As Double
Private mLongitude As Double
Private mSpeedOverGround As Double '// always in knots
Private mSpeedUnits As icsgpsSpeedUnits
Private mAltitudeUnits As icsgpsAltitudeUnits
Private mAltitude As Double '// assume to always be in feet

Private mPortOpen As Boolean

Private mGPSDataGood As Boolean
Private mLastUpdateTime As Single



Public Property Get GPSDataGood() As Boolean
    GPSDataGood = mGPSDataGood
End Property

'// fills a combo box with speed units (read listindex property to determine the user setting)
Friend Sub FillComboWithSpeedUnits(lst As ComboBox)
    lst.Clear
    lst.AddItem "Meters Per Second"
    lst.AddItem "Miles Per Hour"
    lst.AddItem "Kilometers Per Hour"
    lst.AddItem "Knots"
    lst.AddItem "Feet Per Second"
    lst.AddItem "Centimeters Per Second"
End Sub

'// fills a combo box with altitude units (read listindex property to determine the user setting)
Friend Sub FillComboWithAltitudeUnits(lst As ComboBox)
    lst.Clear
    lst.AddItem "Meters"
    lst.AddItem "Feet"
End Sub

Public Property Get Altitude() As Double
    Select Case mAltitudeUnits
        Case icsgpsMeters
            Altitude = mAltitude * 0.3048
        Case icsgpsFeet
            Altitude = mAltitude
    End Select
End Property

Public Property Get AltitudeUnits() As icsgpsAltitudeUnits
    AltitudeUnits = mAltitudeUnits
End Property
Public Property Let AltitudeUnits(lUnits As icsgpsAltitudeUnits)
    mAltitudeUnits = lUnits
End Property

Public Property Get SpeedUnits() As icsgpsSpeedUnits
    SpeedUnits = mSpeedUnits
End Property

Public Property Let SpeedUnits(lUnits As icsgpsSpeedUnits)
    mSpeedUnits = lUnits
End Property

'// returns speed, speed is stored internally in knots, for other units they are converted when the property is
'// accessed
Public Property Get SpeedOverGround() As Double
    Dim dReturn As Double
    Select Case mSpeedUnits
        Case icsgpsMilesPerHour
            dReturn = mSpeedOverGround * 1.150779448
        Case icsgpsMetersPerSecond
            dReturn = mSpeedOverGround * 0.5144444444
        Case icsgpsKMPerHour
            dReturn = mSpeedOverGround * 1.852
        Case icsgpsKnots
            dReturn = mSpeedOverGround
        Case icsgpsFeetPerSecond
            dReturn = mSpeedOverGround * 1.6878098571
        Case icsgpsCentimetersPerSecond
            dReturn = mSpeedOverGround * 51.4444444444
    End Select
    '// always round to one digit place
    SpeedOverGround = Val(Format$(dReturn, "0.0"))
End Property

Public Property Get Latitude() As Double
    Latitude = mLatitude
End Property

Public Property Get Longitude() As Double
    Longitude = mLongitude
End Property


Public Property Get PortOpen() As Boolean
    PortOpen = mPortOpen
End Property

Public Property Let PortOpen(ByVal bNew As Boolean)
    
    If bNew Then
        If Not mPortOpen Then
            With obComm
                .Settings = "4800,n,8,1"            '// comm port settings for NMEA-0183
                .InputMode = comInputModeText       '// read the port in text mode
                .PortOpen = True                    '// open the port
            End With
            mPortOpen = True                        '// record that the port was opened
        End If
    Else
        If mPortOpen Then                           '// close the port only if it is open
            obComm.PortOpen = False                 '// close the port
            mPortOpen = False                       '// set the flag
        End If
    End If
        
        
End Property

'// return/set the comm port ////////////////////////////////////////////////////////////
Public Property Get CommPort() As Long
    CommPort = obComm.CommPort
End Property
Public Property Let CommPort(lNew As Long)
    obComm.CommPort = lNew
End Property
'//////////////////////////////////////////////////////////////////////////////////////////


Private Sub Class_Initialize()
    mSpeedUnits = icsgpsMilesPerHour    '// default to american units
    mAltitudeUnits = icsgpsFeet
End Sub


Private Sub obTimer_Timer()
    Dim sInput As String
    Dim lLocation As Long
    Dim sLineFeed As String
    Dim sLine As String
    
    
    sLineFeed = vbCrLf
    
    '// read the serial port
    sInput = obComm.Input
    
    '// parse the strings
    Do
        lLocation = InStr(1, sInput, sLineFeed)
        If lLocation > 1 Then
            '// read the string
            sLine = Left$(sInput, lLocation - 1)
            
            '// is this (recommended minimum specific GPS/Transmit time?)
            Select Case Mid$(sLine, 1, 6)
                Case "$GPRMC"
                    ParseRMC sLine
                    mLastUpdateTime = Timer
                Case "$PGRMZ"
                    ParseRMZ sLine
                    
                Case "$GPGGA"
                    ParseGGA sLine
                Case Else
                    'Debug.Print sLine
            End Select
            
        End If
        If lLocation > 0 Then
            sInput = Right$(sInput, Len(sInput) - lLocation - 1)
        End If
    Loop Until lLocation = 0
    
    
    If (mLastUpdateTime + 10) < Timer Then
        '// if we haven't had a lat/long update in 10 seconds make an error
        mGPSDataGood = False
    End If


End Sub

'// this function verifies the check sum included with each NMEA sentence
Private Function PassedChecksum(sTemp As String) As Boolean
    Dim lIndex As Long
    Dim lCheckSumRec As Long
    Dim sCheckSumRec As String
    Dim lCount As Long
    Dim lSum As Long
    
    '// verify the checksum
    lIndex = InStrRev(sTemp, "*")
    sCheckSumRec = Right$(sTemp, Len(sTemp) - lIndex)
    lCheckSumRec = CLng(Val("&H" & sCheckSumRec))
    
    '// Calculate the sum
    lIndex = InStr(sTemp, "*") - 1
    For lCount = 2 To lIndex
        lSum = lSum Xor Asc(Mid$(sTemp, lCount, 1))
    Next lCount

    '// Verify the sub
    If lSum <> lCheckSumRec Then
        '// there was a check sum error
        Debug.Print "Checksum error"
        PassedChecksum = False
    Else
        PassedChecksum = True
    End If
End Function

'// contains latitude and longitude information
Private Sub ParseRMC(sTemp As String)
    Dim vStrings As Variant
    
    '// verify the checksum
    If Not PassedChecksum(sTemp) Then Exit Sub
   
    
   
    '// $GPRMC constants
    Const RMC_TIME_OF_FIX = 1
    Const RMC_NAV_REC_WARNING = 2
    Const RMC_LATITUDE = 3
    Const RMC_LATITUDE_NS = 4
    Const RMC_LONGITUDE = 5
    Const RMC_LONGITUDE_WE = 6
    Const RMC_SPEED_OVER_GROUND = 7
    Const RMC_COURSE_MADE_GOOD = 8
    Const RMC_DATE_OF_FIX = 9
    Const RMC_MAGNETIC_VAR = 10
    
    '// Read the information from the array
    vStrings = Split(sTemp, ",")
    
    
    If vStrings(RMC_LATITUDE) = "" Then
        mGPSDataGood = False
    Else
        mGPSDataGood = True
    End If
    
    mLatitude = ConvertLatToDegrees(vStrings(RMC_LATITUDE), vStrings(RMC_LATITUDE_NS))
    mLongitude = ConvertLongToDegrees(vStrings(RMC_LONGITUDE), vStrings(RMC_LONGITUDE_WE))
    
    
    mSpeedOverGround = Val(vStrings(RMC_SPEED_OVER_GROUND))
    
    
    '// indicate to the user object that the properties have been updated
    RaiseEvent PropertiesUpdated

End Sub

'// the RMZ contains altitude data - Used by the garmin receivers
Private Sub ParseRMZ(sTemp As String)
    Dim vStrings As Variant
 
    '// verify the checksum
    If Not PassedChecksum(sTemp) Then Exit Sub
   
    '// $GPRMC constants
    Const RMZ_ALTITUDE = 1
    Const RMZ_ALTITUDE_UNITS = 2
    Const RMZ_POSITION_FIX_DIMENSIONS = 3
    
    '// constants for the (RMZ_POSITION_FIX_DIMENSIONS) field
    Const RMZ_POSITION_FIX_DIMENSIONS_USER = 2
    Const RMZ_POSITION_FIX_DIMENSIONS_GPS = 3
    
    '// Read the information from the array
    vStrings = Split(sTemp, ",")
    mAltitude = Val(vStrings(RMZ_ALTITUDE))
    
    
    '// indicate to the user object that the properties have been updated
    RaiseEvent PropertiesUpdated

End Sub

Private Sub ParseGGA(sTemp As String)

    Dim vStrings As Variant
 
    '// verify the checksum
    If Not PassedChecksum(sTemp) Then Exit Sub
   
    '// $GPRMC constants
    Const GGA_FIX_TIME = 1
    Const GGA_LATITUDE = 2
    Const GGA_LATITUDE_NS = 3
    Const GGA_LONGITUDE = 4
    Const GGA_LONGITUDE_EW = 5
    Const GGA_FIX_QUALITY = 6
    Const GGA_NUMBER_SAT_TRACKED = 7
    Const GGA_HORZ_DILUTION_OF_POS = 8
    Const GGA_ALTITUDE_METERS = 9
    Const GGA_ALTITUDE_METERS_UNITS = 10
    Const GGA_HEIGHT_OF_GEOID = 11
    Const GGA_HEIGHT_OF_GEOID_units = 12
    
    '// fix information used in GGA_FIX_QUALITY field
    Const FIX_INVALID = 0
    Const FIX_GPS = 1
    Const FIX_DGPS = 2
    
    '// Read the information from the array
    vStrings = Split(sTemp, ",")
   ' mAltitude = Val(vStrings(RMZ_ALTITUDE))
    
    
    '// indicate to the user object that the properties have been updated
    RaiseEvent PropertiesUpdated

End Sub

Private Function ConvertLatToDegrees(sLat, sDirection) As Double
    
    Dim dMultipler As Double
    Dim dMinutes As Double
    Dim dDegrees As Double
    Dim vStrings As Variant
    
    On Error GoTo ErrorConvertLat '// trap errors
    
    
    '// this should always be larger than two
    If Len(sLat) < 2 Then Exit Function
    
    vStrings = Split(sLat, ".")
    
    '// sign
    If UCase$(Mid$(sDirection, 1, 1)) = "N" Then
        dMultipler = 1
    Else
        dMultipler = -1
    End If
    
    dMinutes = (Val(Right$(vStrings(0), 2)) + Val("." & vStrings(1)))
    dDegrees = Val(Left$(vStrings(0), Len(vStrings(0)) - 2)) + (dMinutes * 0.01666666666666) '// arc min to degrees
    dDegrees = dDegrees * dMultipler
    
    ConvertLatToDegrees = dDegrees
    
    
    Exit Function
    
ErrorConvertLat:
    
    Debug.Print "Error converting to degrees!!!!! cGPS::ConvertLatToDegrees"
    ConvertLatToDegrees = 0

End Function

Private Function ConvertLongToDegrees(sLong, sDirection) As Double
    
    Dim dMultipler As Double
    Dim dMinutes As Double
    Dim dDegrees As Double
    Dim vStrings As Variant
    
    On Error GoTo ErrorConvertLong '// trap errors
    
    
    '// this should always be larger than two
    If Len(sLong) < 2 Then Exit Function
    
    vStrings = Split(sLong, ".")
    
    '// sign
    If UCase$(Mid$(sDirection, 1, 1)) = "W" Then
        dMultipler = 1
    Else
        dMultipler = -1
    End If
    
    dMinutes = (Val(Right$(vStrings(0), 2)) + Val("." & vStrings(1)))
    dDegrees = Val(Left$(vStrings(0), Len(vStrings(0)) - 2)) + (dMinutes * 0.01666666666666) '// arc min to degrees
    dDegrees = dDegrees * dMultipler
    
    ConvertLongToDegrees = dDegrees
    
    
    Exit Function
    
ErrorConvertLong:
    
    Debug.Print "Error converting to degrees!!!!! cGPS::ConvertLongToDegrees"
    ConvertLongToDegrees = 0

End Function

Attribute VB_Name = "basMMTime"
Option Explicit

Declare Function timeGetTime Lib "winmm.dll" () As Long
Public Sub TimerEvent(ByVal wTimerID As Long, ByVal msg As Long, ByVal obTimer As cMMTime, ByVal dw1 As Long, ByVal dw2 As Long)
    obTimer.FireTimerEvent
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cMMTime"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

Public StopTimer As Boolean
Private m_bEnabled As Boolean
Private m_TimeMode As icsmmTimeTimerAction
Private m_TimerID As Long
Private m_Interval As Long
Private m_Resolution As Long

Public Enum icsmmTimeTimerAction
    icsmmSingleShot
    icsmmPeriodic
End Enum

Private Type TIMECAPS
        wPeriodMin As Long
        wPeriodMax As Long
End Type

Private Const TIME_ONESHOT = 0
Private Const TIME_PERIODIC = 1
Private Const TIMERR_NOERROR = (0)

Private Declare Function timeGetDevCaps Lib "winmm.dll" (lpTimeCaps As TIMECAPS, ByVal uSize As Long) As Long
Private Declare Function timeGetTime Lib "winmm.dll" () As Long
Private Declare Function timeBeginPeriod Lib "winmm.dll" (ByVal uPeriod As Long) As Long
Private Declare Function timeEndPeriod Lib "winmm.dll" (ByVal uPeriod As Long) As Long
Private Declare Function timeSetEvent Lib "winmm.dll" (ByVal uDelay As Long, _
    ByVal uResolution As Long, ByVal lpFunction As Long, ByVal dwUser As Object, _
                                                            ByVal uFlags As Long) As Long
Private Declare Function timeKillEvent Lib "winmm.dll" (ByVal uID As Long) As Long

Event Timer()

Public Property Get Resolution() As Long
    Resolution = m_Resolution
End Property

Public Property Let Resolution(ByVal newvalue As Long)
    If Not m_bEnabled Then
        m_Resolution = newvalue
    End If
End Property


Public Property Get Enabled() As Boolean
    Enabled = m_bEnabled
End Property

Public Property Let Enabled(ByVal vNewValue As Boolean)
Dim lresult As Long


If m_bEnabled Then
    '// we are enabled
    If vNewValue Then
        '// We are already are  timing
    Else
        '// Kill the timer
        Call timeEndPeriod(m_Resolution)
        
        lresult = timeKillEvent(m_TimerID)
        If TIMERR_NOERROR <> lresult Then
            Debug.Print "The was an error handling the kill event."
        End If
        m_bEnabled = False
    End If
Else
    '// we are not enabled yet
    If vNewValue Then
        StopTimer = False
        
        '// Set the timer event
        If MinTimerResolutionMS > m_Resolution Then
            m_Resolution = MinTimerResolutionMS
        End If
        If MaxTimerResolutionMS < m_Resolution Then
            m_Resolution = MaxTimerResolutionMS
        End If
        Call timeBeginPeriod(m_Resolution)
        
        If Me.TimerMode = icsmmSingleShot Then
            m_TimerID = timeSetEvent(m_Interval, 0, AddressOf TimerEvent, Me, TIME_ONESHOT)
        Else
            m_TimerID = timeSetEvent(m_Interval, 0, AddressOf TimerEvent, Me, TIME_PERIODIC)
        End If
        If m_TimerID <> &H0 Then
            m_bEnabled = True
        End If
    Else
        '// We are already shut off - do nothing
    End If
End If



End Property


Public Property Get CurrentSystemTime() As Long
    CurrentSystemTime = timeGetTime
End Property

Public Property Get MinTimerResolutionMS() As Long

Dim Tcap As TIMECAPS
Dim lresult As Long

lresult = timeGetDevCaps(Tcap, Len(Tcap))
MinTimerResolutionMS = Tcap.wPeriodMin

End Property

Public Property Get MaxTimerResolutionMS() As Long

Dim Tcap As TIMECAPS
Dim lresult As Long

lresult = timeGetDevCaps(Tcap, Len(Tcap))
MaxTimerResolutionMS = Tcap.wPeriodMax

End Property

Friend Sub FireTimerEvent()
    If StopTimer Then
        Me.Enabled = False
    Else
        RaiseEvent Timer
    End If
End Sub

Public Property Get TimerMode() As icsmmTimeTimerAction
    TimerMode = m_TimeMode
End Property

Public Property Let TimerMode(ByVal vNewValue As icsmmTimeTimerAction)
    m_TimeMode = vNewValue
End Property

Private Sub Class_Initialize()
    m_TimeMode = icsmmPeriodic
    m_Interval = 1000
    m_Resolution = 5
End Sub

Private Sub Class_Terminate()
    Enabled = False
End Sub

Public Property Get Interval() As Long
Attribute Interval.VB_UserMemId = 0
    Interval = m_Interval
End Property

Public Property Let Interval(ByVal vNewValue As Long)
    m_Interval = vNewValue
End Property
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cParseFileString"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'// object to handle file name / directory parsing
'// copyright Intrepid Control Systems, Inc. 1998-99

Public m_sPathString As String      '// holds the path without the drive letter
Public m_sExtension As String       '// holds the file extenstion
Public m_sFileName As String        '// holds the file name without the extenstion
Public m_sDriveLetter As String     '// holds the drive letter

Private m_sfullPath As String
Private m_bFullPathSet As Boolean

Public Property Get PathString() As String
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    PathString = m_sPathString
End Property
Public Property Get FileExtension() As String
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    FileExtension = m_sExtension
End Property

Public Property Get FileName() As String
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    FileName = m_sFileName
End Property
Public Property Get DriveLetter() As String
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    DriveLetter = m_sDriveLetter
End Property

Public Sub AttachTimeDateToFileName()
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    m_sFileName = m_sFileName & Format$(Now(), " mm-dd-yy hh-mm-ss ")
End Sub

Public Sub AttachValueToFileName(dValue As Double)
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    m_sFileName = m_sFileName & Format$(dValue)
End Sub

'// this function converts a path with embedded "\" and makes them "\\" to be compatible with Javascript
Public Property Get JavaOrCFilePathString() As String
    Dim lCount As Long
    Dim lNum As Long
    Dim sOut As String
    Dim sCurrentChar As String
    
    '// make sure full path is set
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    
    lNum = Len(m_sfullPath)
    For lCount = 1 To lNum
        sCurrentChar = Mid$(m_sfullPath, lCount, 1)
        If sCurrentChar = "\" Then
            sOut = sOut & "\\"
        Else
            sOut = sOut & sCurrentChar
        End If
    Next lCount
    
    JavaOrCFilePathString = sOut '// return the string
End Property

Public Property Get FilePathWithoutExtension() As String
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    FilePathWithoutExtension = m_sDriveLetter & m_sPathString & m_sFileName
End Property

Public Property Get FullPath() As String
Attribute FullPath.VB_UserMemId = 0
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    FullPath = m_sDriveLetter & m_sPathString & m_sFileName & m_sExtension
End Property

Public Property Let FullPath(sNewValue As String)
    m_sfullPath = sNewValue
    m_bFullPathSet = True           '// set the full path flag
    m_sFileName = FileNameFromPath(m_sfullPath, m_sPathString, m_sExtension, m_sDriveLetter)
End Property

Public Property Get DirectoryPath() As String
    If Not m_bFullPathSet Then Err.Raise vbObjectError + 1000, "Full Path Property Not Set"
    Select Case Len(m_sPathString)
        Case 0 ' no path
            DirectoryPath = ""
        Case 1 ' root
             DirectoryPath = m_sDriveLetter & m_sPathString
        Case Else
            DirectoryPath = m_sDriveLetter & Left$(m_sPathString, Len(m_sPathString) - 1)
    End Select
End Property


Public Property Get IsUNCFileName() As Boolean
    Dim sDirectory As String
    sDirectory = DirectoryPath
    If Len(sDirectory) >= 2 Then
        If Left$(sDirectory, 2) = "\\" Then
            IsUNCFileName = True
        Else
            IsUNCFileName = False
        End If
    End If
End Property

Private Function FileNameFromPath(PathStringSent As String, sPath As String, _
                    sExt As String, sDrive As String) As String

    Dim iPathLength As Integer
    Dim iCount As Integer
    Dim bFileFound As Boolean
    Dim ThisLength As Integer
    Dim PathString As String
    
    '// File/Path information ////////////////////
    Dim sDriveLetter As String
    Dim sDirectoryPath As String
    Dim sFileName As String
    Dim sExtension As String
    '////////////////////////////////////
    
    PathString = PathStringSent
    
    '// First find the drive letter if it is in the pathstring ////////////////////
    If Mid$(PathString, 2, 1) = ":" Then
        sDriveLetter = Left(PathString, 2)   '// Save the drive letter from this string
        PathString = Mid$(PathString, 3)    '// Return the rest of the string
    End If
    '///////////////////////////////////////////////////
    
    bFileFound = False
    
    '// Get the current path from the string
    iPathLength = Len(PathString)
    
    For iCount = iPathLength To 1 Step -1
    
        '// cycle though all the characters in the string
        Select Case Mid$(PathString, iCount, 1)
        
            Case "."
                '// The previous three characters are an extension
                '// so truncate the string
                ThisLength = Len(PathString) - iCount
                If ThisLength >= 1 And ThisLength <= 3 Then
                    sExtension = Mid$(PathString, iCount, ThisLength + 1)
                End If
                PathString = Left(PathString, iCount - 1)   '// Remove the extension
                                                            '// from the string
            Case "\"
                ThisLength = Len(PathString) - iCount
                If ThisLength >= 1 Then '// We have the file name
                    sFileName = Mid$(PathString, iCount + 1, ThisLength)
                    PathString = Left(PathString, iCount)
                    bFileFound = True
                    Exit For
                End If
        End Select
    Next iCount
    
    If bFileFound Then
        sDirectoryPath = PathString
    Else
        sFileName = PathString
    End If
    
    '// Return the parameters
    sDrive = sDriveLetter
    sPath = sDirectoryPath
    sExt = sExtension
    FileNameFromPath = sFileName

End Function

Private Sub Class_Initialize()
    m_bFullPathSet = False
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cSoundMCI"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'// api call used to determine if wav capablitiy is present on the system
Private Declare Function waveOutGetNumDevs Lib "winmm.dll" () As Long

'// Private members
Private WithEvents mmcon As MMControl
Attribute mmcon.VB_VarHelpID = -1

'// Public members
Public FilePath As String
Public LastErrorString As String

Private mCurrentlyPlaying As Boolean
Private mCurrentlyOpen As Boolean
Private mCurrentlyRecording As Boolean

'// Events
Public Event SoundComplete()


Public Property Get MultiMediaControl()
    Set MultiMediaControl = mmcon
End Property

Public Property Set MultiMediaControl(newMMCon As MMControl)
    Set mmcon = newMMCon
    
    If newMMCon Is Nothing Then
        CloseControl
        Set mmcon = Nothing
        Exit Property
    End If
    
    With mmcon
        .DeviceType = "WaveAudio"
        .Notify = False
        .wait = True
        .Shareable = False
    End With

End Property

Public Function StopOperation() As Boolean
    With mmcon
        .command = "Stop"
        If .Error <> 0 Then
            LastErrorString = "There was an error trying to stop the waveaudio device."
            StopOperation = False
            CloseControl
            Exit Function
        End If
    End With
End Function

Public Function PlaySound() As Boolean
    
    ' Set properties needed by MCI to open.
    If mCurrentlyPlaying Then
        StopOperation
    End If
    
    If mCurrentlyOpen Then
        CloseControl
    End If
        
    With mmcon
        .FileName = FilePath
        ' Open the MCI WaveAudio device.
        .command = "Open"
        If .Error <> 0 Then
            LastErrorString = "There was an error opening the waveaudio device."
            PlaySound = False
            CloseControl
            Exit Function
        Else
            mCurrentlyOpen = True
        End If
        
        .command = "Play"
        If .Error <> 0 Then
            LastErrorString = "There was an error trying to play the waveaudio device."
            PlaySound = False
            CloseControl
            Exit Function
        End If
    End With
    
    '// if we made it this far we have succeeded
    mCurrentlyPlaying = True
    PlaySound = True
    
End Function


Public Function RecordSound() As Boolean
    
    '// Set properties needed by MCI to open.
    If mCurrentlyPlaying Then
        StopOperation
    End If
    
    If mCurrentlyOpen Then
        CloseControl
    End If
        
    With mmcon
        .FileName = FilePath
        ' Open the MCI WaveAudio device.
        .command = "Open"
        If .Error <> 0 Then
            LastErrorString = "There was an error opening the waveaudio device."
            RecordSound = False
            CloseControl
            Exit Function
        Else
            mCurrentlyOpen = True
        End If
        
        .command = "Record"
        If .Error <> 0 Then
            LastErrorString = "There was an error trying to play the waveaudio device."
            RecordSound = False
            CloseControl
            Exit Function
        End If
    End With
    
    '// if we made it this far we have succeeded
    mCurrentlyRecording = True
    mCurrentlyPlaying = True
    RecordSound = True
    
End Function


Public Property Get IsAudioOutInstalled() As Boolean
    Dim lCount As Long
    lCount = waveOutGetNumDevs
    If lCount > 0 Then
        IsAudioOutInstalled = True
    Else
        IsAudioOutInstalled = False
    End If
End Property

Private Sub Class_Terminate()
    CloseControl
End Sub

Private Sub mmcon_Done(NotifyCode As Integer)
    
    If mCurrentlyRecording Then
        mCurrentlyRecording = False
        mmcon.command = "Save"
        If mmcon.Error <> 0 Then
            LastErrorString = "There was an error trying to save the recorded waveaudio."
            CloseControl
        End If
    End If
    
    Select Case NotifyCode
        Case mciNotifySuccessful
            CloseControl
            RaiseEvent SoundComplete
            mCurrentlyPlaying = False
            Debug.Print "The sound completed successfully"
        Case mciNotifySuperseded
            Debug.Print "The sound was superseeded"
        Case mciAborted
            Debug.Print "The sound was aborted"
        Case mciFailure
            Debug.Print "There was a sound failure."
    End Select
    
End Sub


Private Sub CloseControl()
    If Not (mmcon Is Nothing) And mCurrentlyOpen Then
        mmcon.command = "Close"
        mCurrentlyOpen = False
        mCurrentlyRecording = False
    End If
End Sub
# Browser demo start-up for Vehicle Spy (VB6_TEST_SCRIPT, see web/vspy_shell.html).
# The project opens the panel given on the command line (demo.ivs); this script answers
# the "database not found" prompt, switches to the graphical monitor and starts the replay.
# No "end": the program keeps running for the visitor.
waitdialog 120
key enter
wait 1
menu frmMain.mnuViewChart
wait 1
menu frmMain.mnuRunStart
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cspyHardwareInterface"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Description = "Interface to be implemented for Vehicle Spy hardware."
Option Explicit

'// protocols
Public Enum icsSpyHardwareProtocol
    icsspyCAN
    icsspyCANOneWireGM
    icsspyJ1850VPW
    icsspyJ1850PWM
    icsspyISO9141
    icsspyKeyword2000
    icsspyGM_ALDL_UART
    icsspyChryslerCCD
    iscspyChryslerSCI
    icsspyRS232
End Enum

Public Type icsSpyMessage
    StatusBitField As Long
    TimeHardware As Long
    TimeSystem As Long
    NumberBytesHeader As Byte
    NumberBytesData As Byte
    DescriptionID As Integer
    ArbIDOrHeader As Long    '// Holds (up to 3 byte 1850 header or 29 bit CAN header)
    Data(1 To 8) As Byte
    Value As Single
End Type

'// these are bitmasks for the status bitfield
Public Enum icsSpyDataStatusBitfield
    icsSpyStatusGlobalError = 2 ^ 0
    icsSpyStatusTx = 2 ^ 1
    icsSpyStatusIsCanType = 2 ^ 2
    icsSpyStatusRemoteFrame = 2 ^ 3
    icsSpyStatusErrCRCError = 2 ^ 4
    icsSpyStatusHardwareTimePresent = 2 ^ 5
    icsSpyStatusErrIncompleteFrame = 2 ^ 6
    icsSpyStatusErrLostArbitration = 2 ^ 7
    icsSpyStatusErrUndefined = 2 ^ 8
    icsSpyStatusHasValue = 2 ^ 9
    icsSpyStatusValueIsBoolean = 2 ^ 10
    icsSpyStatusBusShortedPlus = 2 ^ 11
    icsSpyStatusBusShortedGnd = 2 ^ 12
    icsSpyStatusCheckSumError = 2 ^ 13
    icsSpyStatusErrBadMessageBitTimeError = 2 ^ 14
    icsSpyStatusIFRData = 2 ^ 15
    icsSpyStatusCommInOverflow = 2 ^ 16
    icsSpyStatusCommOutOverflow = 2 ^ 17
    icsSpyStatusCommMiscError = 2 ^ 18
    icsSpyStatusBreak = 2 ^ 19
    icsSpyStatusAVT_VSIRecOverflow = 2 ^ 20
    icsSpyStatusTestTrigger = 2 ^ 21
    icsSpyStatusAudioCommentType = 2 ^ 22
    icsSpyStatusGPSDataValue = 2 ^ 23
    icsSpyStatusAnalogDigitalInputValue = 2 ^ 24
    icsSpyStatusTextCommentType = 2 ^ 25
    icsSpyStatusNetworkMessageType = 2 ^ 26
    icsSpyStatusVSI_TxUnderRun = 2 ^ 27
    icsSpyStatusVSI_IFR_CRCBit = 2 ^ 28
End Enum


'//
Public Type icsSpyMessageLong
    StatusBitField As Long
    TimeHardware As Long
    TimeSystem As Long
    NumberBytesHeader As Byte
    NumberBytesData As Byte
    DescriptionID As Integer
    ArbIDOrHeader As Long    '// Holds (up to 3 byte 1850 header or 29 bit CAN header)
    DataMsb As Long
    DataLsb As Long
    Value As Single
End Type

'// Same 32 byte message
Public Type icsSpyMessageJ1850
    StatusBitField As Long '4
    TimeHardware As Long '4
    TimeSystem As Long '4
    NumberBytesHeader As Byte '1
    NumberBytesData As Byte '1
    DescriptionID As Integer '2
    Header(1 To 4) As Byte  '4  '// Holds (up to 3 byte 1850 header or 29 bit CAN header)
    Data(1 To 8) As Byte '8
    Value As Single '4
End Type

Public Type icsSpyMessageGPS
    StatusBitField As Long  '4
    TimeHardware As Long    '4
    TimeSystem As Long '4
    GPSDataID As Integer    '2
    DescriptionID As Integer '2
    Value1 As Double '8
    Value2 As Double '8
End Type

Public Type icsSpyMessageAnalog
    StatusBitField As Long  '4
    TimeHardware As Long    '4
    TimeSystem As Long '4
    AIDataID As Integer    '2
    DescriptionID As Integer '2
    Value As Double '8
    HardwareIndex As Integer '2
    iDummy As Integer '2
    lDummy As Long '4
End Type
'


'////////////////////////////////////////////////////////////////////////////////////////

'// ActiveX interface for Vehicle Spy hardware
Public Sub ShowConfigurationDialog()
Attribute ShowConfigurationDialog.VB_Description = "Shows the dialog to configure the spy hardware object."
    '// shows the configuration dialog
End Sub

Public Property Get Protocol(lProtocol As icsSpyHardwareProtocol)
Attribute Protocol.VB_Description = "Returns the protocol setup by this hardware."
    '// Returns the protocol setup by this hardware.
End Property

Public Function StartMonitoring() As Boolean
Attribute StartMonitoring.VB_Description = "Starts monitoring the vehicle network."
    '// starts monitoring the vehicle network
End Function

Public Function StopMonitoring() As Boolean
Attribute StopMonitoring.VB_Description = "Stops monitoring the vehicle network."
    '// Stops monitoring the vehicle network
End Function

Public Function ReadMessagesJ1850(stVSPYMessages() As icsSpyMessageJ1850, lNumberOfMessages As Long) As Boolean
Attribute ReadMessagesJ1850.VB_Description = "Reads messages into a user defined buffer."
    '// Reads messages into a user defined buffer
End Function

Public Function ReadMessagesCAN(stVSPYMessages() As icsSpyMessage, lNumberOfMessages As Long) As Boolean
    '// Reads messages into a user defined buffer
End Function

Public Function TransmitMessages(ByVal vBuffer As Variant, ByVal lNumberOfMessages As Long) As Boolean
Attribute TransmitMessages.VB_Description = "Transmits  messages into a user defined buffer."
    '// Reads messages into a user defined buffer
End Function

Public Property Get HardwareDescription() As String
Attribute HardwareDescription.VB_Description = "Returns a description of this hardware"
    '// Returns a description of this hardware
End Property

Public Property Get HardwareClassID() As String
Attribute HardwareClassID.VB_Description = "Returns a description of the class ID use to create this object"
    '// Returns a description of the class id to create this object
End Property

'//////////////////////////////////////////////////////////////////////////////////////
Public Function CleanUpObjects() As Boolean
Attribute CleanUpObjects.VB_Description = "This allows the object to release all its circular references (if any) before it is destroyed."
    '// This allows the object to release all its circular references
End Function

'// Storage operations //////////////////////////////////////////////////////////
Public Function ReadWriteHardware(ByVal WriteDirection As Boolean, vBytes As Variant)
Attribute ReadWriteHardware.VB_Description = "This function allows the hardware to write to the stream of the Vehicle Spy."
    '// This function allows the data to write to the permannet stream of the procedure
End Function

Public Property Get MessagesPerSecond() As Double
Attribute MessagesPerSecond.VB_Description = "Returns the bus load in messages per second"
    '// Returns the bus load in messages per second
End Property
