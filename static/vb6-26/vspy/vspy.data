    Set mvarcAnalyses = vData
End Property

Private Sub Class_Initialize()
    
    Set mvarResetFilters = New cFilters
    Set mvarFilters = New cFilters
    Set mvarcBuffer = New cBuffer
    mvarCircularBufferLength = 10000
    mvarDescription = "Generic Test"
    mvarLogRate = 1
    mvarResetAllValues = True
    mvarFilePath = "icsSpyDataFile.csv"
    mAfterStopMessages = 1  '// this is an after stop time
    mAfterStopTime = 1
    mStopNumberOfMessages = 1
    mStopAfterTime = 1
    mvarValueToAppendKey = ""
    mvarAppendFileValueTypeInput = True
    mNumberOfGenerations = 1
    mContinuousGeneration = True
    mvarValueReplayOutKey = "out1"
End Sub

Private Sub Class_Terminate()
    Set mvarcAnalyses = Nothing
    Set mvarResetFilters = Nothing
    Set mvarFilters = Nothing
End Sub


