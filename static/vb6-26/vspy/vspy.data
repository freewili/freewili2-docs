Private Sub RunTightLoop()

Dim lSleepTime As Long

'// turn off the timer
tmrStartTightLoop.Enabled = False
bRunningInTightLoop = True

'// cache the sleep time property
lSleepTime = Performance.ProcessSleepTimeMs

Do
    PollEngine
    DoEvents
    If lSleepTime > 0 Then
        Sleep lSleepTime
    End If
Loop Until bStop

PerformStopRunning


End Sub

Private Sub PollEngine()
    
    Dim lCount As Long
    Dim lNumItems As Long
    Dim msg As cOutgoingMessage
    Dim lNumberOfTests As Long
    Dim lCurrentTime As Long
    Dim lTotalTime As Long
    Dim Voltages As Variant
    Dim lNIError As Long
    Dim lTimeMeasure As Long
    Dim lFunction As Long
    Dim lresult As Long
    
    lCurrentTime = timeGetTime          '// get the current time
    Performance.PollIntervalMs = lCurrentTime - m_lLastPollTime
    ReadPorts                           '// read the hardware objects
    
    lTimeMeasure = timeGetTime
    If Performance.TextMonitorUpdateType = icsspyPerformanceMonitorForceUpdates Then
        RaiseEvent UpdateScrollingArea
    End If
    Performance.DisplayUpdateRateMs = timeGetTime - lTimeMeasure
    
    '// handle bus load
    Select Case mHardwareID
        Case icsVSPYTypeGMVSI, icsVSpyTypeDemo, _
                icsVSPYTypeNICAN, icsVSpyTypeActiveX, icsVSPYTypeAVT716or716VPW
            '// do a manual calculation
            If lCurrentTime >= mBusLoadTime Then
                lTotalTime = lCurrentTime - mBusLastRead
                If lTotalTime > 0 Then
                    RaiseEvent MessagesPerTimeInMs(lMessageCount, lTotalTime)
                    mCurrentBusLoad = lMessageCount / (lTotalTime / 1000)
                End If
                mBusLoadTime = lCurrentTime + (250 * mBusLoadUpdateRate)
                mBusLastRead = lCurrentTime
                lMessageCount = 0
                UpdateBusLoadInputs
            End If
        Case icsVSPYTypeAVT716Threaded
            '// read from hardware...
'                mCurrentBusLoad = mAvt.CurrentBusLoad
'                RaiseEvent MessagesPerTimeInMs(mCurrentBusLoad, mBusLoadUpdateRate * 250)
'                UpdateBusLoadInputs '//(fix this slow one!!!)
        Case Else
            Debug.Print "There was an undefined hardwareid in cicsspy::PollEngine"
    End Select
    '/// end handling bust load
    
    '// handle the test checking (this is where equations are evaluated)
    lNumberOfTests = Tests.Count
    For lCount = 1 To lNumberOfTests
        '// Handle test logging and trigger determination
        Tests(lCount).TestTimeCheck
    Next lCount
    
    
    '// transmit the periodic messages needed to be transmitted ////////////////////////
    lNumItems = OutgoingMessages.Count
    For lCount = 1 To lNumItems
        Set msg = OutgoingMessages(lCount)
        If msg.UpdateRate <> 0 Then
            If msg.IncrementTransmitCount Then
                Call Transmit(lCount)
            End If
        End If
    Next lCount
    '////////////////////////////////////////////////////////////////////////////////////
    
    HandleTimeStampTXMessages     '// the timestampe tx messages
    
    '// Update the displays as needed
    RaiseEvent UpdateDisplays
    

    
    If GPS.Enabled Then Call HandleGPSChecking(lCurrentTime)  '// check GPS if required
    
    '// read the multio stuff
    If MultiIO.Enabled Then
        If lCurrentTime > lAnalogInputCheckTime Then
            
            '// read the channels
            If MultiIO.ReadInputs(Me) Then
                '// update the value type inputs
                UpdateAnalogInputs
            End If
            
            '// setup the next reading time
            lAnalogInputCheckTime = lCurrentTime + 1000
            
        End If
    End If
    
    If lCurrentTime > (mvarObjectCreateTime + 1200000) Then
        mvarObjectCreateTime = lCurrentTime + 1200000
        '// check the authorization
        lresult = GetAuthorization2(0)
        If lresult <> 0 Then
            Randomize
            lFunction = CLng(Rnd * 10)
            Select Case lFunction
                Case 0, 1 ' remove all tests
                    Tests.RemoveAll
                Case 2 ' show an annoying dialog
                    RaiseEvent MakeUserSelectReplayFile
                Case 3 ' clear monitor buffer
                    Monitor.Buffer.ClearBuffer
                Case 4 ' disable file menu
                    frmMain.mnuFile.Enabled = False
                Case 5 ' remove an incoming message
                    OutgoingMessages.Remove OutgoingMessages.Count
                Case 6 ' remove an incoming message
                    IncomingMessages.Remove 4
                Case 7 ' set an outgoing
                    OutgoingMessages(2).UpdateRate = 0.001
                Case 8 ' print me baby
                    frmMain.cmdMasterTx.Visible = False
                Case 9 ' lock it up baby
                    Do
                    Loop While True
                Case 10 ' grace
                    Performance.ProcessSleepTimeMs = 100
                    Performance.SaveCurrentValuesAsDefault
            End Select
        End If
    End If
    
    
    m_lLastPollTime = lCurrentTime
    
    
End Sub

Private Sub HandleGPSChecking(lCurrentTime As Long)
    Dim spyGPS As icsSpyMessageGPS
    Dim spymsg As icsSpyMessageJ1850
    Dim bSim As Boolean
    
    bSim = GPS.SimulationMode
    
    If lCurrentTime > lCheckCPSTime Then
        '// read the location??
        If GPS.AcquireLocation Then
            With spyGPS
                If bSim Then
                    .Value1 = 42 * Rnd
                    .Value2 = 41 * Rnd
                Else
                    .Value1 = obGPS.Latitude
                    .Value2 = obGPS.Longitude
                End If
                .TimeSystem = timeGetTime
                .StatusBitField = icsSpyStatusGPSDataValue
                'if gps.
                If Not bSim Then
                    If Not obGPS.GPSDataGood Then
                        .StatusBitField = .StatusBitField + icsSpyStatusGlobalError
                    End If
                End If
                .GPSDataID = SPY_GPS_LOCATION
            End With
            LSet spymsg = spyGPS
            Call NewMsgJ1850(spymsg)
        End If
        
        '// read the speed??
        If GPS.AcquireSpeed Then
            With spyGPS
                If bSim Then
                    .Value1 = Rnd * 100
                Else
                    .Value1 = obGPS.SpeedOverGround
                End If
                .StatusBitField = icsSpyStatusGPSDataValue
                .TimeSystem = timeGetTime
                .GPSDataID = SPY_GPS_SPEED
                If Not bSim Then
                    If Not obGPS.GPSDataGood Then
                        .StatusBitField = .StatusBitField + icsSpyStatusGlobalError
                    End If
                End If
            End With
            LSet spymsg = spyGPS
            Call NewMsgJ1850(spymsg)
        End If
        
        '// read the altitude??
        If GPS.AcquireAltitude Then
            With spyGPS
                If bSim Then
                    .Value1 = Rnd * 800
                Else
                    .Value1 = obGPS.Altitude
                End If
                .StatusBitField = icsSpyStatusGPSDataValue
                .TimeSystem = timeGetTime
                .GPSDataID = SPY_GPS_ALTITUDE
                If Not bSim Then
                    If Not obGPS.GPSDataGood Then
                        .StatusBitField = .StatusBitField + icsSpyStatusGlobalError
                    End If
                End If
            End With
            LSet spymsg = spyGPS
            Call NewMsgJ1850(spymsg)
        End If
        lCheckCPSTime = lCurrentTime + 1000
        
        '// update the GPS inputs
        UpdateGPSInputs
    End If
    
End Sub

Private Sub ReadPorts()
    Dim stVSPYMessages() As icsSpyMessageJ1850
    Dim stMsgLong As icsSpyMessageLong
    Dim stMsgJ1850 As icsSpyMessageJ1850
    Dim lNumMessages As Long
    Dim lCount As Long
    Dim lstarttime As Long
    Dim lStopTime As Long
    Dim dTotalTime As Double
    
    '// Check for bytes at the serial port
    Select Case mHardwareID
        Case icsVSPYTypeNICAN
            mNICAN.ReadCANPort
        Case icsVSPYTypeGMVSI
            'mVSI.ReadSerialPort
            If mVSI.ReadMessagesJ1850(stVSPYMessages, lNumMessages) Then
                '// handle the hardware
                For lCount = 1 To lNumMessages
                    Call NewMsgJ1850(stVSPYMessages(lCount))
                Next lCount
            Else
                Debug.Print "Error reading network hardware VSI box in ReadPorts"
            End If
        Case icsVSpyTypeDemo
            If PerformPerformanceTest Then
                
                tmrTest = False
                tmrStartTightLoop = False
                
                lstarttime = timeGetTime
                With mDemo.Buffer
                    lNumMessages = mDemo.Buffer.NumberItems
                    For lCount = 1 To lNumMessages
                        Call .GetElement(stMsgLong, lCount)
                        LSet stMsgJ1850 = stMsgLong
                        Call NewMsgJ1850(stMsgJ1850)
                    Next lCount
                End With
                lStopTime = timeGetTime
                MonitorOn = False '// stop the et
                dTotalTime = ((lStopTime - lstarttime) / 1000)
                MsgBox "The time for " & lNumMessages & " messages was " & dTotalTime & " seconds for a rate of " & (lNumMessages / dTotalTime) & " message per second", vbInformation
            Else
                mDemo.ReadMessages
            End If
        Case icsVSpyTypeActiveX
            If NetworkHardware.ReadMessagesJ1850(stVSPYMessages, lNumMessages) Then
                '// handle the hardware
                For lCount = 1 To lNumMessages
                    Call NewMsgJ1850(stVSPYMessages(lCount))
                Next lCount
            Else
                Debug.Print "Error reading network hardware in ReadPorts"
            End If
        Case icsVSPYTypeAVT716Threaded
            '// do nothing
            
        Case Else '// Assume it is AVT for now
            If AVTHardware.ReadMessagesJ1850(stVSPYMessages, lNumMessages) Then
                '// handle the hardware
                For lCount = 1 To lNumMessages
                    Call NewMsgJ1850(stVSPYMessages(lCount))
                Next lCount
            Else
                Debug.Print "Error reading network hardware AVT box in ReadPorts"
            End If
    End Select
End Sub

Friend Sub SetupHardwareDigitalActuateTrigger(ByVal sIncomingMessageKey As String)
    Select Case HardwareID
        Case icsVSPYTypeAVT716or716VPW
            Call AVTHardware.SetupTrigger(IncomingMessages(sIncomingMessageKey).stJ1850FilterStructure)
    End Select
End Sub




Friend Sub UpdateParallelPortOutput(ByVal iPinID As Integer, ByVal bValue As Boolean)
    
    Dim bLPT1 As Boolean
    Dim iCurrentValue As Integer
    Dim iBit As Integer
    
    '// which port is this bit on?
    bLPT1 = True
    If iPinID > 7 Then
        bLPT1 = False
        iBit = iPinID - 8
        iCurrentValue = m_iDigitalActuateLPT1Byte   '// LPT2 /////////////////////
    Else
        iBit = iPinID
        iCurrentValue = m_iDigitalActuateLPT2Byte   '// LPT1 /////////////////////
    End If
    
    '// set or clear the bit
    If bValue Then
        '// set the appropiate bit
        iCurrentValue = iCurrentValue Or (2 ^ iBit)
    Else
        '// clear the appropiate bit
        iCurrentValue = iCurrentValue And (255 Xor (2 ^ iBit))
    End If
    
    '// update the output
    If bLPT1 Then
        Call ParallelPortOutput(&H378, iCurrentValue)
    Else
        Call ParallelPortOutput(&H3BC, iCurrentValue)
    End If
    
    
End Sub

Private Sub obVoice_CommandEntered(sCommand As String)
    Dim sTestName As String
    Dim lTest As Long
    Dim sTxButtonName As String
    Dim lTxButton As Long
    
    On Error GoTo obVoice_CommandEnteredError
    
    Select Case Left$(sCommand, 4)
    
        Case "test"
            '//
            If MonitorOn Then
            
                Select Case Left$(sCommand, 9)
                    Case "test save"
                        '// get the name of the test
                        sTestName = Trim$(Right$(sCommand, Len(sCommand) - Len("test save")))
                        lTest = ReturnTestIndexFromDescription(sTestName)
                        If lTest > 0 And lTest <= Tests.Count Then
                            '// provide audio feedback
                            Speak "Test " & sTestName
                            Tests(lTest).SaveMessageData
                        End If
                    Case "test star"
                        '// get the name of the test
                        sTestName = Trim$(Right$(sCommand, Len(sCommand) - Len("test start")))
                        lTest = ReturnTestIndexFromDescription(sTestName)
                        If lTest > 0 And lTest <= Tests.Count Then
                            '// provide audio feedback
                            Speak sTestName & " started"
                            Tests(lTest).StartTest
                        End If
                    Case "test stop"
                        '// get the name of the test
                        sTestName = Trim$(Right$(sCommand, Len(sCommand) - Len("test stop")))
                        lTest = ReturnTestIndexFromDescription(sTestName)
                        If lTest > 0 And lTest <= Tests.Count Then
                            '// provide audio feedback
                            Speak sTestName & " stopped"
                            Tests(lTest).StopTest False
                            
                        End If
                    Case "test trig"
                        '// get the name of the test
                        sTestName = Trim$(Right$(sCommand, Len(sCommand) - Len("test trigger")))
                        lTest = ReturnTestIndexFromDescription(sTestName)
                        If lTest > 0 And lTest <= Tests.Count Then
                            '// provide audio feedback
                            Speak sTestName & " triggered"
                            Tests(lTest).TriggerTest
                        End If
                    Case "test view"
                        '// get the name of the test
                        sTestName = Trim$(Right$(sCommand, Len(sCommand) - Len("test view")))
                        lTest = ReturnTestIndexFromDescription(sTestName)
                        If lTest > 0 And lTest <= Tests.Count Then
                            RaiseEvent ShowTestBuffer(lTest)
                        End If
                End Select
            
            Else
                Speak sTestName & "Vspy not running"
            End If
            
        Case "tran"
            '// transmit a message
            If MonitorOn Then
                sTxButtonName = Trim$(Right$(sCommand, Len(sCommand) - Len("transmit")))
                lTxButton = ReturnTxButtonIndexFromDescription(sTxButtonName)
                If lTxButton > 0 And lTxButton <= Monitor.TxButtons.Count Then
                    '// provide audio feedback
                    Speak sTxButtonName & " was transmitted"
                    Call Monitor.TxButtons(lTxButton).TransmitMessages(Me)
                End If
            Else
                Speak sTestName & "Vspy not running"
            End If
        Case Else
        
            
            Select Case sCommand
                Case "go vehicle spy"
                    If Not MonitorOn Then MonitorOn = True
                Case "stop vehicle spy"
                    If MonitorOn Then MonitorOn = False
                Case "enter audio comment"
                    RaiseEvent MakeUserEnterAudioComment
                Case Else
                    RaiseEvent UIVoiceCommand(sCommand)
            End Select
    End Select
    
    
    Exit Sub
obVoice_CommandEnteredError:
    
    Debug.Print "There was an error in the obVoice_CommandEnteredError function"
    
End Sub

Private Function ReturnTxButtonIndexFromDescription(sTest As String) As Long
    Dim lCount As Long
    
    With Monitor.TxButtons
        For lCount = 1 To .Count
            If LCase(Trim$(.Item(lCount).Caption)) = Trim$(sTest) Then
                ReturnTxButtonIndexFromDescription = lCount
                Exit Function
            End If
        Next lCount
    End With
    
End Function
Private Function ReturnTestIndexFromDescription(sTest As String) As Long
    Dim lCount As Long
    
    
    For lCount = 1 To Tests.Count
        If LCase(Trim$(Tests(lCount).Description)) = Trim$(sTest) Then
            ReturnTestIndexFromDescription = lCount
            Exit Function
        End If
    Next lCount

End Function

Private Sub tmrStartTightLoop_Timer()
    If RunInTightLoop Then
        RunTightLoop
    End If
End Sub

Private Sub tmrTest_Timer()
    Call PollEngine
End Sub

Private Sub UserDialog_RequestRXNames(RxNames As Variant)

    Dim sNames() As String
    Dim lCount As Long
    Dim sName As String
    
    If IncomingMessages.Count > 0 Then
        '// Size an array for the tx messages
        ReDim sNames(1 To IncomingMessages.Count)
        
        '// Transfer the names into the array
        For lCount = 1 To IncomingMessages.Count
            sName = IncomingMessages(lCount).Description
            If sName = "" Then sName = "Unnamed Message " & lCount
            sNames(lCount) = sName
        Next lCount
        
        '// Return the names of the TX messages
        RxNames = sNames
    End If

End Sub



Private Sub UserDialog_RequestTestNames(vTestNames As Variant)
    Dim sNames() As String
    Dim lCount As Long
    Dim sName As String
    
    
    '// Size an array for the tx messages
    If Tests.Count > 0 Then
        ReDim sNames(1 To Tests.Count)
        
        '// Transfer the names into the array
        For lCount = 1 To Tests.Count
            sName = Tests(lCount).Description
            If sName = "" Then sName = "Unnamed test " & lCount
            sNames(lCount) = sName
        Next lCount
        
        '// Return the names of the tests
        vTestNames = sNames
    End If
End Sub

Private Sub UserDialog_RequestTXNames(TxNames As Variant)
    
