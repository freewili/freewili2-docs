'// this function changes the enabled state of the toolbar
Public Sub EnableUIForRun(Enabled As Boolean)

If Enabled = False Then
    '// Only switch the view if we are viewing a non run time view
    If CurrentView = icsSpyIncomingMessagesView Or CurrentView = icsSpyOutgoingMessagesView Then
        CurrentView = icsSpyTextView
    End If
    tb.Buttons("start").Value = tbrPressed
    tb.Buttons("stop").Value = tbrUnpressed
    If obApp.RoboTechRunMode Then
        tb.Buttons("start").Enabled = False
        tb.Buttons("stop").Enabled = False
        mnuRun.Enabled = False
    Else
        tb.Buttons("start").Enabled = True
        tb.Buttons("stop").Enabled = True
        mnuRun.Enabled = True
    End If
    If obApp.Monitor.Paused Then mnuMonitorPaused_Click '// turn off pause
Else
    mnuRun.Enabled = True
    tb.Buttons("start").Enabled = True
    tb.Buttons("stop").Enabled = True
    tb.Buttons("start").Value = tbrUnpressed
    tb.Buttons("stop").Value = tbrPressed
End If

mnuRunStart.Enabled = Enabled
mnuRunStop.Enabled = Not Enabled
tmrUpdateGraphical.Enabled = Not Enabled

mnuFile.Enabled = Enabled
mnuViewMessageDatabase.Enabled = Enabled
mnuToolsWizards.Enabled = Enabled
mnuSetupOptions.Enabled = Enabled


If CurrentView = icsSpyTextView Then
    tb.Buttons("add").Enabled = Enabled
End If

With tb
    .Buttons("delete").Enabled = Enabled
End With

End Sub


