Private Sub Class_Initialize()
    
    On Error Resume Next
    
    mvarObjectCreateTime = timeGetTime
    
    
    Set mvarcMonitor = New cMonitor '// Create a new monitor object
    Set mvarcIncomingMessages = New cIncomingMessages
    Set UserDialog = New cUserDialog
    
    Call RestoreApplicationDefaults            '// read defaults from the registry
    DatabasePath = DefaultDatabasePath
    
    
    Set mNICAN = New cNICan '// object for acessing can
    Set mVSI = New cVSI     '// object for accessing GM-VSI hardware
    
    Set App = New cApplicationClass     '// This class manages the save, open and other operations
    
    
    '// setup the defaults
    'InputHardwareType = icsVSPYInTypeNone
    UIShowGraphicalMonitor = True
    UIShowLogFile = True
    mBusLoadUpdateRate = 4
    
    MakeNew
    
    RunInTightLoop = True
    
    
End Sub

'// Destroy all of the objects
Private Sub Class_Terminate()
    Set mvarcUndoStack = Nothing
    StopVoiceEngine
    Unload frmControlHolder
    Set mvarcMonitor = Nothing
    Set mvarcTests = Nothing
    Set mvarcIncomingMessages = Nothing
    Set mvarcMessages = Nothing
    EndCrypkey
End Sub

Public Sub StopVoiceEngine()
    If Not (obVoice Is Nothing) Then
        If Not (obVoice.obCommand Is Nothing) Then
            Set obVoice.obCommand = Nothing
        End If
        If Not (obVoice.obTextToSpeech Is Nothing) Then
            Set obVoice.obTextToSpeech = Nothing
        End If
    End If
    Unload frmVoiceHolder
End Sub

Friend Function ReadWrite(bWriteDirection As Boolean, _
            Optional ObSavePassed As cBinaryStorage) As Boolean

Dim obSave As cBinaryStorage
Dim NumItems As Long
Dim lCount As Long
Dim bPassed As Boolean
Dim lSpace As Long
Dim bSpace As Boolean
Dim sSpace As String
Dim dSpace As Double
Dim bDummy As Boolean
Dim lVersion As Long
Dim lFileType As Long
Dim bHasCustomUIInformation As Boolean
Dim bHasCustomGPSInformation As Boolean
Dim bHasMIOInformation As Boolean
Dim bHasPerformanceInfo As Boolean
Dim bHasIncomingKeyInfo As Boolean
Dim bHasOutgoingKeyInfo As Boolean
Dim sPathTemp As String
Dim lDummy As Long
Dim lTemp As Long
Dim sTemp As String
Dim bHasAVTInformation As Boolean

On Error GoTo readwriteerrorHandle

'// file info are version information
Const FILE_TYPE_ID = 3221002        '// randomly picked long variable
Const FILE_VERSION = 1000

If ObSavePassed Is Nothing Then
    bPassed = False '// we are responible for closing this file
    '// Open the file
    Set obSave = New cBinaryStorage
    With obSave
        .FilePathName = mvarFilePath
        .WriteDirection = bWriteDirection
        .FileOpen = True
    End With
Else
    Set obSave = ObSavePassed
    bPassed = True '// we are not responible for closing this file
End If

'// check file version information
If bWriteDirection Then
    '// write the info to the file
    obSave.ReadWriteLong FILE_TYPE_ID
    obSave.ReadWriteLong FILE_VERSION
Else
    '// read type and version info from the file
    obSave.ReadWriteLong lFileType
    If lFileType <> FILE_TYPE_ID Then
        MsgBox "This is not a valid ICS Vehicle Spy Setup file.", vbCritical, "Problem loading file"
        ReadWrite = False
        Exit Function
    End If
    
    obSave.ReadWriteLong lVersion
    If lVersion > FILE_VERSION Then
        MsgBox "This version of ICS Vehicle Spy Setup file is not compatible with this software.", vbCritical, "Problem loading file"
        ReadWrite = False
        Exit Function
    End If
    If lVersion <> FILE_VERSION Then
        MsgBox "This is an older version of ICS Vehicle Spy Setup file. " & _
            "When saved, it will be saved in the latest format.", _
            vbInformation, "Older file format of Vehicle Spy"
    End If
End If



lTimeStart = timeGetTime

With obSave
    .ReadWriteLong mHardwareID
    .ReadWriteLong mBusLoadUpdateRate
    .ReadWriteString sPathTemp
    .ReadWriteLong lDummy

'.. new padding
    .ReadWriteString mvarDatabasePath
    bDummy = False
    
    '// DAVEEDIT 10/31/98 Happy Halloween...
    If bWriteDirection Then
        bHasCustomUIInformation = True
    End If
    
    .ReadWriteBoolean bHasCustomUIInformation '// has custom UI information?
    
    If bHasCustomUIInformation Then
        Call UserDialog.ReadWriteData(bWriteDirection, obSave)
    End If
    
    '// DAVEEDIT STOP 10/31/98 Happy Halloween... why am i here?
    
    .ReadWriteBoolean UIShowLogFile       '// edit 7/9/98
    .ReadWriteBoolean UIShowGraphicalMonitor
    
    '.ReadWriteLong lSpace DAVE EDIT START 12/20/98
    If bWriteDirection Then
        bHasCustomGPSInformation = True
    End If
    
    .ReadWriteBoolean bHasCustomGPSInformation
    
    If bHasCustomGPSInformation Then
        Call GPS.ReadWrite(bWriteDirection, obSave, lVersion)
    End If
    
    .ReadWriteBoolean bSpace
    '                       DAVE EDIT STOP 12/20/98
    
        
    '.ReadWriteLong lSpace ---- DAVE EDIT START 12/30/98
    If bWriteDirection Then
        bHasMIOInformation = True
    End If
    
    '// read or write the MIO information flag
    .ReadWriteBoolean bHasMIOInformation
    
    If bHasMIOInformation Then
        Call MultiIO.ReadWrite(bWriteDirection, obSave, lVersion)
    End If
    
    .ReadWriteBoolean bSpace
    '/////////////////// ------ DAVE EDIT STOP 12/30/98
    

    '// DAVE EDIT START 2/8/99
    '.ReadWriteLong lSpace
    If bWriteDirection Then
        bHasPerformanceInfo = True
    End If
    
    '// read or write the MIO information flag
    .ReadWriteBoolean bHasPerformanceInfo
    
    If bHasPerformanceInfo Then
        Call Performance.ReadWrite(bWriteDirection, obSave, lVersion)
    End If
    .ReadWriteBoolean bSpace
    '// DAVE EDIT START 2/8/99
    
    
    '// DAVE EDIT START 2/23/99
    '.ReadWriteLong lSpace
    If bWriteDirection Then
        bHasAVTInformation = True
    End If
    
    .ReadWriteBoolean bHasAVTInformation
    
    If bHasAVTInformation Then
        Call AVTHardware.ReadWrite(bWriteDirection, obSave, lVersion)
    End If
    
    .ReadWriteBoolean bSpace
    
    '// DAVE EDIT STOP 2/23/99
    
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    
    
    .ReadWriteString mReplayFilePath '// added to file format 7/11/98
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
        '// dave edit start 12/27/98
    .ReadWriteLong SimulationProtocol  'lSpace
        '// dave edit end 12/27/98
    
    
        '// dave edit start 1/26/99
    '.ReadWriteLong lSpace
    '.ReadWriteLong lSpace
    .ReadWriteLong HardwareBaudRate
    .ReadWriteLong HardwareCommPort
    
    If Not bWriteDirection Then
        '// we are reading
        If HardwareCommPort = 0 Then
            HardwareCommPort = 1
        End If
        '//// HANDLE OLD BAUD RATES OF ZERO this is an illegal baud rate
        If HardwareID = icsVSPYTypeGMVSI Then
            If HardwareBaudRate = 0 Then
                HardwareBaudRate = icsVSPYBaud28800 '// default baud rate
            End If
        Else
            If HardwareBaudRate = 0 Then
                HardwareBaudRate = icsVSPYBaud9600 '// default baud rate
            End If
        End If
    End If
    '// dave edit stop 1/26/99
    
    
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    
        '// DAVE EDIT 2/9/99 STart
    '.ReadWriteLong lSpace
    If bWriteDirection Then
        bHasOutgoingKeyInfo = True
    End If
    '// get the info flag
    .ReadWriteBoolean bHasOutgoingKeyInfo
    .ReadWriteBoolean bSpace
        '// DAVE EDIT 2/9/99 STOP
    
    
        '// DAVE EDIT 2/9/99
    '.ReadWriteLong lSpace
    If bWriteDirection Then
        bHasIncomingKeyInfo = True
    End If
    
    '// get the info flag
    .ReadWriteBoolean bHasIncomingKeyInfo
    
    .ReadWriteBoolean bSpace
        '// DAVE EDIT END 2/9/99
    
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
