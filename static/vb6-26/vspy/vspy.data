End Property

Public Property Let DialogTitle(ByVal New_DialogTitle As String)
    cmn.DialogTitle() = New_DialogTitle
    PropertyChanged "DialogTitle"
End Property

'Load property values from storage
Private Sub UserControl_ReadProperties(PropBag As PropertyBag)
    cmn.InitDir = PropBag.ReadProperty("InitDir", "")
    cmn.Filter = PropBag.ReadProperty("Filter", "")
    txtDatabasePath.text = PropBag.ReadProperty("FileName", "Text1")
    cmn.DialogTitle = PropBag.ReadProperty("DialogTitle", "")
End Sub

'Write property values to storage
Private Sub UserControl_WriteProperties(PropBag As PropertyBag)
    Call PropBag.WriteProperty("InitDir", cmn.InitDir, "")
    Call PropBag.WriteProperty("Filter", cmn.Filter, "")
    Call PropBag.WriteProperty("FileName", txtDatabasePath.text, "Text1")
    Call PropBag.WriteProperty("DialogTitle", cmn.DialogTitle, "")
End Sub

Public Property Get Enabled() As Boolean
    Enabled = txtDatabasePath.Enabled
End Property

Public Property Let Enabled(bNew As Boolean)
    If txtDatabasePath.Enabled <> bNew Then
        txtDatabasePath.Enabled = bNew
        cmdBrowse.Enabled = bNew
        PropertyChanged "Enabled"
    End If
End Property
