Option Explicit

Private Sub UserControl_Initialize()
    With lstOperators
        .AddItem "\"
        .AddItem "="
        .AddItem ">"
        .AddItem "<"
        .AddItem "<>"
        .AddItem "<="
        .AddItem ">="
        .AddItem "bit0"
        .AddItem "bit1"
        .AddItem "bit2"
        .AddItem "bit3"
        .AddItem "bit4"
        .AddItem "bit5"
        .AddItem "bit6"
        .AddItem "bit7"
        .AddItem "byte0("
        .AddItem "byte1("
        .AddItem "byte2("
        .AddItem "byte3("
        .AddItem "and"
        .AddItem "or"
        .AddItem "not"
        .AddItem "xor"
        .AddItem "rnd(1)"
        .AddItem "abs("
        .AddItem "sin("
        .AddItem "cos("
        .AddItem "tan("
        .AddItem "log("
        .AddItem "log10("
        .AddItem "exp("
        .AddItem "sqr("
        .AddItem "int("
        .AddItem "mod("
        .ListIndex = 0
    End With
End Sub


Public Sub InsertText(sString As String)
    Dim sExpression As String
    Dim sFront As String
    Dim sBack As String
    With txtExpression
        sExpression = .Text
        sFront = Left$(.Text, .SelStart)
        sBack = Right$(.Text, Len(.Text) - .SelStart)
        .Text = sFront & sString & sBack
        .SelStart = Len(sFront & sString)
        .SetFocus
    End With
End Sub

Private Sub cmdAddOperator_Click()
    Call InsertText(lstOperators)
End Sub


Private Sub cmdDecimalPoint_Click()
    Call InsertText(".")
End Sub

Private Sub cmdDivide_Click()
    Call InsertText("/")
End Sub

Private Sub cmdEight_Click()
    Call InsertText("8")
End Sub

Private Sub CmdFive_Click()
    Call InsertText("5")
End Sub

Private Sub cmdFour_Click()
    Call InsertText("4")
End Sub

Private Sub cmdMultiply_Click()
    Call InsertText("*")
End Sub

Private Sub cmdNine_Click()
    Call InsertText("9")
End Sub

Private Sub cmdOne_Click()
    Call InsertText("1")
End Sub

Private Sub cmdPlus_Click()
    Call InsertText("+")
End Sub

Private Sub cmdPower_Click()
    Call InsertText("^")
End Sub

Private Sub cmdSeven_Click()
    Call InsertText("7")
End Sub

Private Sub cmdSix_Click()
    Call InsertText("6")
End Sub

Private Sub cmdStartParenthesis_Click()
    Call InsertText("(")
End Sub

Private Sub cmdStopParenthesis_Click()
    Call InsertText(")")
End Sub

Private Sub cmdSubtract_Click()
    Call InsertText("-")
End Sub

Private Sub cmdThree_Click()
    Call InsertText("3")
End Sub

Private Sub cmdTwo_Click()
    Call InsertText("2")
End Sub

Private Sub cmdZero_Click()
    Call InsertText("0")
End Sub

Public Property Get Expression() As String
    Expression = txtExpression
End Property

Public Property Let Expression(ByVal vNewValue As String)
    txtExpression = vNewValue
End Property

