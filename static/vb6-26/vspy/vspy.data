Attribute VB_Name = "frmFilterWizard"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

'// public ref
Public obApp As cicsSpy
Public lstInclude As ListBox


Public Sub Setup()

    If obApp.Protocol = icsVSPYProtocolJ1850 Then
        With lstBytes
            .Clear
            .AddItem "PT"
            .AddItem "Trgt"
            .AddItem "Src"
            .AddItem "B1"
            .AddItem "B2"
            .AddItem "B3"
            .ListIndex = 0
        End With
    Else
        With lstBytes
            .Clear
            .AddItem "ARB ID"
            .AddItem "B1"
            .AddItem "B2"
            .AddItem "B3"
            .ListIndex = 0
        End With
    End If
        
End Sub


Private Sub cmdCancel_Click()
    Unload Me
End Sub

Private Sub cmdChangeColor_Click()
    CommonDialog1.ShowColor
End Sub

Private Sub cmdOk_Click()

    Dim lDataByteIndex As Long
    Dim obInMsg As cIncomingMessage
    Dim sMatch As String
    Dim lNum As Long
    Dim lCount As Long
    Dim sDescription As String
    
    MousePointer = vbHourglass
    
    '// change the match string to upper case
    sMatch = UCase$(txtFilter)
    
    '// are we in can mode
    If obApp.Protocol = icsVSPYProtocolJ1850 Then
        lDataByteIndex = lstBytes.ListIndex + 1
    Else
        '// its can
        If lstBytes.ListIndex = 0 Then
            lDataByteIndex = 1
        Else
            lDataByteIndex = lstBytes.ListIndex + 3
        End If
    End If
    
    '// cycle through all incoming messages, change the all appropiate
    lNum = obApp.IncomingMessages.Count
    With obApp.IncomingMessages
        For lCount = 1 To lNum
            With .Item(lCount)
                If .DataByteString(lDataByteIndex) = sMatch Then
                    sDescription = .Description
                    If sDescription = "" Then sDescription = "Message In " & lCount
                    lstInclude.AddItem sDescription
                    lstInclude.ItemData(lstInclude.NewIndex) = lCount - 1
                End If
            End With
        Next lCount
    End With
    
    '// return the mousepointer
    MousePointer = vbDefault
    
    Unload Me
    
End Sub


Private Sub txtFilter_KeyPress(KeyAscii As Integer)
    If IsValidNumeric(KeyAscii, True) Or KeyAscii = 8 Then
        Exit Sub
    End If
    KeyAscii = 0    '// Key was not valid - > cancel it
End Sub
