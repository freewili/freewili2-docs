'// Should this be method in the buffer
Friend Sub PrintBufferInPctBox(obApp As cicsSpy, imlPic As ImageList, pct As PictureBox, NumberOfPointsString As Long, _
    SpyStartTime As SpyMsgTime, ByVal lNumBeforeStartIndex As Long, ByVal lStartPointMsgNumber As Long, ByVal lStartMsgPointer As Long, CanMode As Boolean, RelativeTime As Boolean, ByVal lDefaultColor As Long)

Dim lCount As Long
Dim MessageBytes() As Byte
Dim bufferPointer As Long
Dim lNumberOfMessagesToSend As Long
Dim lNumMessagesNotUsed As Long
Dim sNum As String
Dim lNum As Long
Dim msg As icsSpyMessageJ1850
Dim canmsg As icsSpyMessage
Dim dTime As Double
Dim NumberOfMostRecentPoints As Long
Dim lHeightRow As Long
Dim SpyTimeMsg As SpyMsgTime
Dim SpyLastTime As SpyMsgTime
Dim lLastMsg As Long
Dim lMaxArea As Long    '// used to cache to max buffer position
Dim lItem As Long
Dim lNew As Long


'// Initialize the count to start at lStartPoint sample
NumberOfMostRecentPoints = NumberOfPointsString

'// First determine if the Buffer is full yet?
If mMesssagesInBuffer <= mBufferLength Then
    
    '// Setup the buffer pointer and number of messages to send
    If lNumBeforeStartIndex = -1 Then
        
        bufferPointer = mMesssagesInBuffer   '// the most recent message
        
        '// Determine how many messages to send
        If NumberOfMostRecentPoints > mMesssagesInBuffer Then
            lNumberOfMessagesToSend = mMesssagesInBuffer
        Else
            lNumberOfMessagesToSend = NumberOfMostRecentPoints
        End If
        
        lNumBeforeStartIndex = mMesssagesInBuffer
    Else
        
        '// Handle the case where the startpoint is out of range
        If lNumBeforeStartIndex > mMesssagesInBuffer Then Exit Sub
        
        bufferPointer = lNumBeforeStartIndex         '// the message number requested
        
        
        '// Determine how many messages to send
        If NumberOfMostRecentPoints > lNumBeforeStartIndex Then
            lNumberOfMessagesToSend = lNumBeforeStartIndex
        Else
            lNumberOfMessagesToSend = NumberOfMostRecentPoints
        End If
        
        lStartPointMsgNumber = lStartPointMsgNumber - (lStartMsgPointer - lNumBeforeStartIndex)
        
    End If
    
Else
    '// The buffer is full

    '// Setup the buffer pointer and number of messages to send
    If lNumBeforeStartIndex = -1 Then
        bufferPointer = MessageHistoryPointer - 1   '// the most recent message
        If bufferPointer <= 0 Then bufferPointer = mBufferLength
            '// the messagehistory pointer always points at the next message
        lNumberOfMessagesToSend = NumberOfMostRecentPoints
        If lNumberOfMessagesToSend > mBufferLength Then lNumberOfMessagesToSend = mBufferLength
        lNumBeforeStartIndex = mMesssagesInBuffer
    Else
        '// mod the start point with the buffer length
        lNew = lStartMsgPointer - (mBufferLength - lNumBeforeStartIndex)
        If lNew < 1 Then
            lNew = mBufferLength + lNew
        End If
        bufferPointer = lNew
        
        '// set this up for
        lStartPointMsgNumber = lStartPointMsgNumber - (mBufferLength - lNumBeforeStartIndex)
        lNumberOfMessagesToSend = NumberOfMostRecentPoints
        
        If bufferPointer = 0 Then lNumberOfMessagesToSend = 0
        If lNumberOfMessagesToSend > mBufferLength Then lNumberOfMessagesToSend = mBufferLength
    End If
End If

lHeightRow = pct.TextHeight("A")

'// Cycle through the number of samples requested //////////////////////////////////////
'// the first message is
lMaxArea = (lNumberOfMessagesToSend + 1) * lHeightRow
For lCount = 1 To lNumberOfMessagesToSend
        
    '// Setup for can or what ever
    If CanMode Then
        CopyData MessageHistory(bufferPointer), canmsg, Len(canmsg)
    Else
        CopyData MessageHistory(bufferPointer), msg, Len(msg)
    End If
    
    '// Copy the timing info
    With SpyTimeMsg
        .HardwareTimePresent = (MessageHistory(bufferPointer).StatusBitField And icsSpyStatusHardwareTimePresent) <> 0
        .HardwareTimeMs = MessageHistory(bufferPointer).TimeHardware
        .SystemTimeMs = MessageHistory(bufferPointer).TimeSystem
    End With
    
    If RelativeTime Then
        '// is this the first message in the buffer?
        If mMesssagesInBuffer <= mBufferLength And bufferPointer = 1 Then
            dTime = 0   '// can be no delta with one message
        Else
            lLastMsg = bufferPointer - 1
            If lLastMsg = 0 Then
                lLastMsg = mBufferLength    '// it must of rolled over because we have more than one message in the buffer
            End If
            With SpyLastTime
                .HardwareTimePresent = (MessageHistory(lLastMsg).StatusBitField And icsSpyStatusHardwareTimePresent) <> 0
                .HardwareTimeMs = MessageHistory(lLastMsg).TimeHardware
                .SystemTimeMs = MessageHistory(lLastMsg).TimeSystem
            End With
            dTime = GetSpyTimeSec(SpyLastTime, SpyTimeMsg)
        End If
    Else
        SpyTimeMsg.HardwareTimePresent = (MessageHistory(bufferPointer).StatusBitField And icsSpyStatusHardwareTimePresent) <> 0
        SpyTimeMsg.HardwareTimeMs = MessageHistory(bufferPointer).TimeHardware
        SpyTimeMsg.SystemTimeMs = MessageHistory(bufferPointer).TimeSystem
        dTime = GetSpyTimeSec(SpyStartTime, SpyTimeMsg)
    End If
    
    '// Print the byte string
    'lStartPointMsgNumber -
    If lStartPointMsgNumber = 0 Then
        lItem = lNumBeforeStartIndex - lCount
    Else
        lItem = lStartPointMsgNumber - lCount
    End If
    
    Call PrintDataRow(obApp, imlPic, pct, lItem, lMaxArea - lHeightRow * lCount, msg, canmsg, dTime, lDefaultColor, CanMode)
    
    '// Move backwards in the buffer //////////////////////////
    bufferPointer = bufferPointer - 1
    If bufferPointer <= 0 Then bufferPointer = mBufferLength
    '//////////////////////////////////////////////////////////
    
Next lCount
'////////////////////////////////////////////////////////////////////////////////

End Sub

Private Sub Class_Initialize()
    MessageHistoryPointer = 1 '// Start at the first element
    mUpdateScreen = True
End Sub



Public Function LoadTXValueBufferFromFile(obApp As cicsSpy, obOutputMessage As cOutgoingMessage, sFilePath As String) As Boolean
    
    Dim lFileNum As Long
    Dim sTemp As String
    Dim lMessageCount As Long
    Dim lCommaCount As Long
    Dim lNextComma As Long
    Dim lCount As Long
    Dim msg As icsSpyMessageJ1850
    Dim canmsg As icsSpyMessageLong
    Dim lItemCount As Long
    Dim dTimeMs As Double
    Dim dValue As Long
    Dim lProtocol As Long
    Dim lDescriptionId As Long
    
    
    On Error GoTo LoadTXValueBufferFromFile
    
    lFileNum = FreeFile '// get a file num
    Open sFilePath For Input As lFileNum
    
    
    '// set the initial buffer length
    ReDim MessageHistory(1000)  '// This function returns
    mBufferLength = 1000
    
    '// cache the protocol property and description iD
    lProtocol = obApp.Protocol
    lDescriptionId = obApp.OutgoingMessages.ReturnIndexFromKey(obOutputMessage.Key)
    
    '// find the first line in the data file
    Do
        Line Input #lFileNum, sTemp
    Loop Until EOF(lFileNum) Or UCase$(Left$(sTemp, 5)) = "TIME,"
    
    '// Now read the data into the buffer
    Do
        
        '// read the next line from the file
        Line Input #lFileNum, sTemp
    
    
        lMessageCount = lMessageCount + 1 '// count the number of messages
        
        '// do we need to make the buffer larger
        If lMessageCount > mBufferLength Then
            mBufferLength = mBufferLength + 1000
            ReDim Preserve MessageHistory(mBufferLength)
        End If
        
        '// parse the string - find the first data byte
        lItemCount = 0  '// reset the item count
        lCommaCount = 1 '// start at the first character
        For lCount = 1 To 2
            lItemCount = lItemCount + 1
            lNextComma = InStr(lCommaCount, sTemp, ",")
            'If lNextComma = 0 Then Exit For
            
            '// get the time
            If lItemCount = 1 Then
                dTimeMs = Val(Mid$(sTemp, lCommaCount, lNextComma - lCommaCount)) * 1000
            End If
            
            '// get the value
            If lItemCount = 2 Then
                dValue = Val(Mid$(sTemp, lCommaCount, Len(sTemp) - lCommaCount + 1))
                obOutputMessage.Value = dValue
            End If
            
            '// the next comma location
            lCommaCount = lNextComma + 1
        Next lCount
        
        '// handle the different protocols
        Select Case lProtocol
            Case icsVSPYProtocolJ1850
                LSet msg = obOutputMessage.J1850Msg
                msg.TimeSystem = CLng(dTimeMs)
                msg.StatusBitField = icsSpyStatusNetworkMessageType
                msg.DescriptionID = lDescriptionId
                LSet MessageHistory(lMessageCount) = msg
            Case icsVSPYProtocolCAN
                canmsg = obOutputMessage.canmsg
                canmsg.TimeSystem = CLng(dTimeMs)
                canmsg.StatusBitField = icsSpyStatusNetworkMessageType
                canmsg.DescriptionID = lDescriptionId
                LSet MessageHistory(lMessageCount) = canmsg
            Case Else
                Debug.Print "Error *********************** Unsupported protocol found in cBuffer:LoadTXValueBufferFromFile"
        End Select
           
    Loop Until EOF(lFileNum)
    
    '// resize the buffer to the message size
    ReDim Preserve MessageHistory(lMessageCount)
    mBufferLength = lMessageCount           '// set the buffer length
    mMesssagesInBuffer = mBufferLength      '// we XX messages in this buffer
    MessageHistoryPointer = 1               '// the buffer is full, so the next message is this
    mUpdateScreen = True                    '// new buffer, needs updating
     
    '// close the file
    Close lFileNum
    
    '// if we made it this file the file is valid
    LoadTXValueBufferFromFile = True
    
    
    Exit Function
    
LoadTXValueBufferFromFile:

    LastErrorString = Err.Description
    LoadTXValueBufferFromFile = False
    
End Function


