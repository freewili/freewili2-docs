Private Sub grdIncomingMessages_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If m_bGridSelChanged Then
        '// fill down if ctrl key is pressed
        If (Shift And vbCtrlMask) > 0 Then
            mnuIncomingFillDown_Click
        ElseIf (Shift And vbShiftMask) > 0 Then
            Call IncomingInsertItems(1)
        End If
    End If
End Sub

Private Sub grdIncomingMessages_SelChange()
    m_bGridSelChanged = True
End Sub

Private Sub grdOutgoingMessages_EnterCell()
    Select Case grdOutgoingMessages.Col
        Case mOutMsgUpdateRateCol
            ShowHelpFile "spyOutTxPeriodic.htm", True
        Case mOutMsgValueTypeCol, mOutMsgValueCol
            ShowHelpFile "spyOutgoingMessageType.htm", True
        Case Else
            ShowHelpFile "spyEnterOutgoing.htm", True
    End Select
End Sub

Private Sub grdOutgoingMessages_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If m_bGridSelChanged Then
        '// fill down if ctrl key is pressed
        If (Shift And vbCtrlMask) > 0 Then
            mnuOutgoingFill_Click
        ElseIf (Shift And vbShiftMask) > 0 Then
            InsertOutgoing
        End If
    End If
End Sub

Private Sub grdOutgoingMessages_SelChange()
    m_bGridSelChanged = True
End Sub

