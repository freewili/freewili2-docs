Private Sub IicsHardware_GetNameForIOPoint(ByVal IOPointType _
    As icsHardware.iicsIOPointType, ByVal lNumber As Long, _
    sDescription As String, sPlusConnection As String, sMinusConnection As String)
    
    Dim lCount As Long
    Dim OutputNumber As Long
    Dim lIndex As Long
    
    '// Clear the descriptions
    sDescription = ""
    sPlusConnection = ""
    sMinusConnection = ""
    
    '// Which IO point type was requested?
    Select Case IOPointType
        Case iicsTypeAnalogInput
            If lNumber <= IncomingMessages.Count And lNumber > 0 Then
                For lCount = 1 To IncomingMessages.Count
                    If IncomingMessages(lCount).ValueType = icsVSPYAnalogInput Then
                        OutputNumber = OutputNumber + 1
                        If OutputNumber = lNumber Then
                            sDescription = IncomingMessages(lCount).Description
                            Exit For
                        End If
                    End If
                Next lCount
            End If
        Case iicsTypeDigitalOutput
            If lNumber <= OutgoingMessages.Count And lNumber > 0 Then
                sDescription = OutgoingMessages(lNumber).Description
                If Len(sDescription) = 0 Then
                    sDescription = "Unamed Output " & lNumber
                End If
            End If
        Case iicsTypeDigitalInput
            For lCount = 1 To IncomingMessages.Count
                If IncomingMessages(lCount).ValueType = icsVSPYDigitalInput Then
                    OutputNumber = OutputNumber + 1
                    If OutputNumber = lNumber Then
                        sDescription = IncomingMessages(lCount).Description
                        Exit For
                    End If
                End If
            Next lCount
            If lNumber > OutputNumber Then
                '// its a present flag
                lIndex = lNumber - OutputNumber
                If lIndex > 0 And lIndex <= IncomingMessages.Count Then
                    sDescription = IncomingMessages(lIndex).Description & " (present)"
                End If
            End If
                
                
                
            
        Case iicsTypeAnalogOutput
            If lNumber <= OutgoingMessages.Count And lNumber > 0 Then
                For lCount = 1 To OutgoingMessages.Count
                    If OutgoingMessages(lCount).ValueType = icsVSPYAnalogoutput Then
                        OutputNumber = OutputNumber + 1
                        If OutputNumber = lNumber Then
                            sDescription = OutgoingMessages(lCount).Description
                            Exit For
                        End If
                    End If
                Next lCount
            End If
    End Select
    
End Sub


