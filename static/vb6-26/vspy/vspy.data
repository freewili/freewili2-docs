Private Sub mnuSetupFilterWizard_Click()
    Dim mTest As cTest
    Dim sMsg As String
    
    '// create the message to show the wizard
    sMsg = "The filter wizard will take the data that " & _
        "is loaded into the monitor, apply the current" & _
        " monitor filter, and then create a new buffer from that data. It will be placed in as test."
    
    sMsg = sMsg & vbCrLf & vbCrLf
    sMsg = sMsg & "Press ok to continue"
    
    '// show the message
    MsgBox sMsg, vbInformation, "How the filter wizard works..."
    
    MousePointer = vbHourglass
    Set mTest = obApp.Tests.Add
    Set mTest.Buffer = obApp.NewBufferFromFilter(obApp.Monitor.Buffer, obApp.Monitor.Filters)
    mTest.TestStartTimeMs = obApp.Monitor.StartTimeMs
    mTest.Description = "Filter Wiz Test " & obApp.Tests.Count
    InitializeTheTestsGrid
    MousePointer = vbDefault
    
End Sub

Private Sub ShowTestInMonitor(lTest As Long)
    '// unpause the monitor if it is paused
    If obApp.Monitor.Paused Then mnuMonitorPaused_Click
     
    '// set the tab
    bProgramEdit_tsBuffers = True
    Set tsBuffers.SelectedItem = tsBuffers.Tabs(lTest + 1)
    bProgramEdit_tsBuffers = False
    
    
    lCurrentTest = lTest
    
    Set obApp.Monitor.Test = obApp.Tests(lCurrentTest)
    obApp.Monitor.UseTestBuffer = True
    With tbMonitor.Buttons
        .Item("filterson").Enabled = False
        .Item("viewfilters").Enabled = False
    End With
    UpdateMonitorDisplay True
End Sub

