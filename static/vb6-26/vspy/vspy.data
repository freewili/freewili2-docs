Attribute VB_Name = "frmStateEncoded"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit



Public obApp As cicsSpy
Public sIncomingKeyString As String               '// keystring of the equation we are editing

Public Sub SetupUI()

    Dim sStates As String
    Dim vStates As Variant
    Dim vParts As Variant
    Dim obItem As ListItem
    Dim lCount As Long
    
    '// get the states
    vStates = Split(obApp.IncomingMessages(sIncomingKeyString).Equation, "|")
    
    For lCount = 0 To UBound(vStates)
        vParts = Split(vStates(lCount), "@")
        If UBound(vStates) >= 0 Then
            Set obItem = lvwStates.ListItems.Add(, , vParts(0))
            If UBound(vStates) >= 1 Then
                obItem.SubItems(1) = vParts(1)
            End If
        End If
    Next lCount
    
End Sub

Private Sub cmdAdd_Click()
    Dim obItem As ListItem
    
    Set obItem = lvwStates.ListItems.Add(, , txtStateDescription)
    obItem.SubItems(1) = txtEquation
    
    txtStateDescription = ""
    txtEquation = ""
    
End Sub

Private Sub CmdCancel_Click()
    Unload Me
End Sub

Private Sub cmdEditEquation_Click()
    With frmIncomingEquation
        .Expression = txtEquation
        .IsDigital = True
        .SetupUI
        .Show vbModal, Me
        If .OkPressed Then
            txtEquation = .Expression
        End If
    End With
    Unload frmIncomingEquation
    Set frmIncomingEquation = Nothing
End Sub

Private Sub cmdRemove_Click()
    If Not (lvwStates Is Nothing) Then
        lvwStates.ListItems.Remove lvwStates.SelectedItem.Index
    End If
End Sub

Private Sub cmdYes_Click()
    Dim lCount As Long
    Dim sStates As String
    
    
    For lCount = 1 To lvwStates.ListItems.Count
        sStates = sStates & lvwStates.ListItems(lCount).Text & "@" & lvwStates.ListItems(lCount).SubItems(1) & "|"
    Next
    
    '// trim the extra pipe character
    If Len(sStates) > 1 Then
        sStates = Left$(sStates, Len(sStates) - 1)
    End If
    
    obApp.App.SaveNeeded = True
    obApp.IncomingMessages(sIncomingKeyString).Equation = sStates
    
    Unload Me
End Sub

