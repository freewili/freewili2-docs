'// the sub transmits a message by index
Public Sub Transmit(vntIndexOrKey As Variant)
    Dim msg As icsSpyMessageJ1850
    Dim canmsg As icsSpyMessage
    Dim lMessageIndex As Long
    
    lMessageIndex = OutgoingMessages.ReturnIndexFromKey(OutgoingMessages(vntIndexOrKey).Key)
    
    Select Case HardwareID
        Case icsVSPYTypeNICAN
            LSet canmsg = OutgoingMessages(vntIndexOrKey).canmsg
            
            canmsg.DescriptionID = lMessageIndex
            Call mNICAN.TransmitMessage(canmsg)
        Case icsVSPYTypeGMVSI
            LSet msg = OutgoingMessages(vntIndexOrKey).J1850Msg
            msg.DescriptionID = lMessageIndex
            Call mVSI.SendMessage(msg)
        Case icsVSpyTypeDemo
            If Protocol = icsVSPYProtocolCAN Then
                LSet msg = OutgoingMessages(vntIndexOrKey).canmsg
            Else
                LSet msg = OutgoingMessages(vntIndexOrKey).J1850Msg
            End If
            'Call Me.TransmitWithTimeStamp(lIndex, timeGetTime + 1000)
            
            Call mDemo.SendMessage(msg, lMessageIndex)
        Case icsVSpyTypeActiveX
            '// transmit messages
        Case Else '// Assume it is AVT for now
            LSet msg = OutgoingMessages(vntIndexOrKey).J1850Msg
            msg.DescriptionID = lMessageIndex
            Call AVTHardware.SendMessage(msg)
    End Select
End Sub


'// the sub transmits a message by index
Public Sub TransmitWithTimeStamp(vntIndexOrKey As Variant, lTime As Long)
    Dim lCount As Long
    Dim bLocationFound As Boolean
    
    '// find the first message avaliable
    bLocationFound = False
    Do
        lCount = lCount + 1 '// count each message
        
        If lCount > outDelayMsgsSize Then
            outDelayMsgsSize = outDelayMsgsSize + 1000 '// increase the array by one thousand
            ReDim Preserve outDelayMsg(1 To outDelayMsgsSize)
        End If
            
        
        If Not outDelayMsg(lCount).bNotSent Then
            With outDelayMsg(lCount)
                .lTime = lTime
                .lIndex = OutgoingMessages.ReturnIndexFromKey(OutgoingMessages(vntIndexOrKey).Key)
                .bNotSent = True
                outDelayMsgsCount = outDelayMsgsCount + 1
                bLocationFound = True
            End With
        End If
        
    Loop Until bLocationFound
    
    
    Debug.Print "out message size " & lCount
    
End Sub

Private Sub HandleTimeStampTXMessages()
    Dim lCount As Long
    
    '// if there are no messages then exit
    If outDelayMsgsCount = 0 Then Exit Sub
    
    For lCount = 1 To outDelayMsgsSize
        If outDelayMsg(lCount).bNotSent Then
            '// check the time
            If timeGetTime > outDelayMsg(lCount).lTime Then
                Call Transmit(outDelayMsg(lCount).lIndex)
                outDelayMsg(lCount).bNotSent = False
                outDelayMsgsCount = outDelayMsgsCount - 1
                If outDelayMsgsCount = 0 Then Exit For
                Debug.Print "out delay count " & outDelayMsgsCount
            End If
        End If
    Next lCount
                
End Sub


'// the sub transmits a message by index
Friend Sub TransmitByBytes(msg As icsSpyMessageJ1850)
    Dim canmsg As icsSpyMessage
    
    Select Case HardwareID
        Case icsVSPYTypeNICAN
            LSet canmsg = msg
            Call mNICAN.TransmitMessage(canmsg)
        Case icsVSPYTypeGMVSI
            Call mVSI.SendMessage(msg)
        Case icsVSpyTypeDemo
            Call mDemo.SendMessage(msg, CLng(msg.DescriptionID))
        Case Else '// Assume it is AVT for now
            Call AVTHardware.SendMessage(msg)
    End Select
End Sub


Public Property Let MonitorOn(ByVal vData As Boolean)
    
    mvarMonitorOn = vData
    If mvarMonitorOn Then
        Randomize
        mChNum1 = Rnd * 14550
        If Not StartRunning Then
            StopRunning
            mvarMonitorOn = False
        End If
    Else
        StopRunning
    End If
    
End Property

Private Function StopRunning() As Boolean
    If RunInTightLoop And bRunningInTightLoop Then
        bStop = True
    Else
        PerformStopRunning
    End If
    mChNum1 = Rnd * 30000
End Function

Private Function PerformStopRunning() As Boolean
        Dim lCount As Long
        Dim lNumItems As Long
        
        On Error GoTo PerformStopRunningError
        
        '// setup the multifunction io hardware ////////////////////////////////////////////////////////////////////
        If MultiIO.Enabled Then
            If Not MultiIO.CloseHardware Then
                Debug.Print "Error closing MultiIO hardware"
            End If
        End If
        
        lNumItems = Tests.Count
        For lCount = 1 To lNumItems
            Tests(lCount).StopTest False
            Set Tests(lCount).Parent = Nothing
        Next lCount
        
        '// free refs
        For lCount = 1 To OutgoingMessages.Count
            Set OutgoingMessages(lCount).Parent = Nothing
        Next lCount
        For lCount = 1 To IncomingMessages.Count
            Set IncomingMessages(lCount).Parent = Nothing
        Next lCount
        
         '// Setup the hardware
        Select Case HardwareID
            Case icsVSPYTypeNICAN
                mNICAN.PortOpen = False
            Case icsVSPYTypeGMVSI
                mVSI.PortOpen = False
                Set mVSI.Comm = Nothing
            Case icsVSpyTypeDemo
                Set mDemo = Nothing
            Case icsVSpyTypeActiveX
                NetworkHardware.StopMonitoring
            Case Else '// Assume it is AVT for now
                AVTHardware.PortOpen = False
        End Select
        
         '// setup the GPS ///////////////////////////////////////////////////////////////////////////////
        If GPS.Enabled Then
            If Not GPS.SimulationMode Then
                obGPS.PortOpen = False
                Set obGPS.obComm = Nothing
                Set obGPS.obTimer = Nothing
            End If
        End If
        '////////////////////////////////////////////////////////////////////////////////////////////////
        
   
        
        '// disable poll events /////////////////////////////////////////////////
        Set tmrStartTightLoop = Nothing
        frmControlHolder.tmrStartTightLoop.Enabled = False
        Set tmrTest = Nothing     '// set a ref to the timer
        frmControlHolder.tmr.Enabled = False
        Unload frmControlHolder
        '//////////////////////////////////////////////////////////////////////
    
        '// reset the last bus load parameter
        mCurrentBusLoad = 0
        Call Speak("V Spy Stopped") '// Play the stopped
        RaiseEvent VSpyStopped  '// Indicate that the monitor stopped

        PerformStopRunning = True   '// return success

        Exit Function
        
PerformStopRunningError:

    '// report the error
    MsgBox "There was a problem stopping vehicle spy. " & vbCrLf & _
        vbCrLf & "Description: " & Err.Description, vbInformation
    PerformStopRunning = False   '// return success

End Function

Public Sub RefreshIncomingMessageFilterTable()
    Dim lStart As Long
    
    If MonitorOn Then '// rebuild the filter table
        lStart = timeGetTime
        SetupIncomingMessagesForRun
        Debug.Print "rebuild time: " & (timeGetTime - lStart)
    End If
End Sub

Private Function StartRunning() As Boolean
    Dim sCause As String
    Dim lCount As Long
    Dim lNumItems As Long
    Dim sTempPath As String
    Dim lresult As Long
    Dim lCalcResult As Long
    Dim bPassed As Boolean

    For lCount = 1 To 5
        lCalcResult = (lCalcResult * mChNum1 + 7956182) Mod 16381 + (lCalcResult * mChNum2 + 355710712) Mod 16369
    Next lCount
        
On Error GoTo StartRunningErrorHandler

    bStop = False                       '\\ reset the false flag
    bRunningInTightLoop = False
    
    '// Play the Start indicator
    If mUseEventSounds Then
        Call Speak("V Spy Started")
        SetupTestVoiceList              '// setup the test voice list
        SetupTxMessageVoiceList         '// setup the tx message voice list
    End If
    
    For lCount = 1 To 6
        lCalcResult = ((7956182 + (lCalcResult * mChNum1)) * 1) Mod 16381 + (lCalcResult * mChNum2 + 355710712) Mod 16369
    Next lCount
    
    '// Setup the hardware first
    Select Case HardwareID
        Case icsVSPYTypeNICAN
            '// setup the can object
            mNICAN.ObjectName = "CAN" & Me.HardwareCommPort - 1
            mNICAN.PortOpen = True
        Case icsVSPYTypeGMVSI
            frmControlHolder.MSComm1.CommPort = Me.HardwareCommPort
            mVSI.BaudRate = GetBaudRate
            Set mVSI.Comm = frmControlHolder.MSComm1
            mVSI.PortOpen = True
            mVSI.MonitorOn = True
            '// are we using hardware inputs ??
            'mVSI.UseAnalogInputs = InputHardwareType = icsVSPYInTypeGMVSI
        Case icsVSpyTypeDemo
            '// do nothing
            
            '// check the replay path
            sTempPath = ReplayFilePath
            
            '/ does the replay file exist?
            If Dir(sTempPath) = "" Or sTempPath = "" Then
                
                RaiseEvent MakeUserSelectReplayFile '// make the user select the replay file
                
                '// check the replay path
                sTempPath = ReplayFilePath
                
                '// check the replay file again user may have canceled
                If Dir(sTempPath) = "" Or sTempPath = "" Then
                    MsgBox "You must set the replay file before running." & vbCrLf & vbCrLf & "Do this from the file pull down menu.", vbInformation, "No Replay file set"
                    StartRunning = False
                    Exit Function
                End If
            End If
            Set mDemo = New cDemo   '// create a new demo object
            If Not mDemo.Buffer.LoadBufferFromFile(sTempPath) Then
                MsgBox "The replay file setup is not valid." & vbCrLf & vbCrLf & "Do this from the file pull down menu.", vbInformation, "Replay file problem"
                StartRunning = False
                Exit Function
            End If
            mDemo.Start     '// record the start time
        Case icsVSpyTypeActiveX
            
            If Not NetworkHardware.StartMonitoring Then
                MsgBox "There was a problem starting the vehicle network hardware." & vbCrLf & vbCrLf & "Description: " & "Description", vbInformation, "Replay file problem"
                StartRunning = False
                Exit Function
            End If
        Case icsVSPYTypeAVT716Threaded
            ''/
            
        Case Else '// Assume it is AVT for now
            With AVTHardware
                frmControlHolder.MSComm1.CommPort = Me.HardwareCommPort
                .BaudRate = GetBaudRate
                Set .MsCommControl = frmControlHolder.MSComm1
                
                
                'Call .SetBusLoadWindowMs(mBusLoadUpdateRate * 250)
                .PortOpen = True
                If Not .ResetHardware Then
                    Call MsgBoxShowErrorGeneric("The AVT Unit is not responding.", _
                         "1) It is not connected. Fix by connecting to the PC." & vbCrLf & "2) The comm port settings are not correct." _
                            & " Fix through the options dialog from the tools pull down menu. Select the bus hardware tab.")
                    StartRunning = False
                    Exit Function
                End If
            End With
    End Select

    '// check all of the filters for the monitor
    If Not Monitor.Filters.CompileFilterIndexes(IncomingMessages) Then
        '// There was a problem
        MsgBox "There was an reference to an incoming message that has been deleted. Please fix.", _
                        vbInformation, "Problem with the monitor filter setup"
    End If
    
    '// Reset the parallel port bytes
    m_iDigitalActuateLPT1Byte = 0
    m_iDigitalActuateLPT2Byte = 0
    
    lresult = ckChallenge(mChNum1, mChNum2)
    
    '// setup the buffer length
    If Not Monitor.MonitorBuffer.SetBufferLength(Monitor.NumberOfMessagesHistory) Then
        MsgBox "There was a problem setting up the buffer for the monitor. Your buffer may be too large.", vbInformation
        StartRunning = False
        Exit Function
    End If
    
    Call IntializeEveryThing    '// ??
    
    SetupIncomingMessagesForRun ' setup value properties (Called before tests are setup)
    
    '// Start each test
    mNumTests = Tests.Count
    For lCount = 1 To mNumTests
        Set Tests(lCount).Parent = Me
        If Not Tests(lCount).IntializeTest Then
            MsgBox Tests(lCount).LastErrorMessage, vbInformation, "Problem with test """ & Tests(lCount).Description & """"
            StartRunning = False
            Exit Function
        End If
    Next lCount
    Monitor.StartTest   '// Start the monitor
    
    
    '// set refs on the incoming and outgoing messages to the main object
    For lCount = 1 To OutgoingMessages.Count
        Set OutgoingMessages(lCount).Parent = Me
    Next lCount
    '////////////////////////////////////////////////////////////////////////
    
    bPassed = lresult = lCalcResult '// calculate for licence
        
    '// clear the last message properties
    For lCount = 1 To mNumInMsgs
        IncomingMessages(lCount).ClearLastMessage            '// reset the last message cache
    Next lCount
    
    '// setup the GPS ///////////////////////////////////////////////////////////////////////////////
    If GPS.Enabled Then
        obGPS.SpeedUnits = GPS.SpeedUnits                   '// setup the units for speed
        obGPS.AltitudeUnits = GPS.AltitudeUnits             '// setup the units for altitude
        If Not GPS.SimulationMode Then
            Set obGPS.obComm = frmControlHolder.commGPS         '// set a ref to comm port objects
            Set obGPS.obTimer = frmControlHolder.tmrGPS             '// set a ref to the timer objects
            obGPS.CommPort = GPS.CommPort                       '// set the comm port number
            obGPS.obTimer = False
            obGPS.PortOpen = True                               '// open the comm port
            obGPS.obTimer = True
        End If
    End If
    '////////////////////////////////////////////////////////////////////////////////////////////////
    
    '// setup the multifunction io hardware ////////////////////////////////////////////////////////////////////
    If MultiIO.Enabled Then
        If Not MultiIO.OpenHardware Then
            Debug.Print "Error opening MultiIO hardware"
            RaiseEvent ErrorMessage("Problem opening the IO hardware")
        End If
    End If
    '////////////////////////////////////////////////////////////////////
    
    If Not bPassed Then
        Debug.Print "challange failed"
        Performance.ProcessSleepTimeMs = 300 '// license stuff
    End If

    Set tmrTest = frmControlHolder.tmr     '// set a ref to the timer
    tmrTest.Enabled = True          '// Enable the polling time

    If Performance.MainEngineSetup = icsspyPerformanceRunInTightLoop Then
        Set tmrStartTightLoop = frmControlHolder.tmrStartTightLoop
        tmrStartTightLoop = True
    End If


    '// Return success
    StartRunning = True
    RaiseEvent VSpyStarted  '// Indicate that the monitor operation started
    
    Exit Function

StartRunningErrorHandler:

    '// Play the error wave file
    PlaySoundFile VB.App.Path & "\spyerror.wav"
    
    Select Case Err.Number
        Case 8002
            sCause = "1) The hardware comm port setting is incorrect. Fix in the hardware setup dialog found in the Setup pull down menu."
        Case 8005
            sCause = "1) There is another program using the comm port. Please close it to fix. " & vbCrLf & "2) The hardware comm port setting is incorrect. Fix this in the hardware setup dialog found in the Setup pull down menu."
        Case 8018
            If HardwareID = icsVSPYTypeGMVSI Then
                sCause = "1) The VSI Box is not switched on and/or power is not supplied to it. Fix this by attaching the cable or changing the switch position to on." & vbCrLf
                sCause = sCause & "2) The VSI box is not connected to the PC. Please fix this by connecting the VSI box."
            Else
                sCause = "1) No suggested causes."
            End If
        Case Else
            sCause = "1) No suggested causes."
    End Select

    Call MsgBoxShowErrorCommPort("There was an error trying to open the comm port assigned to this hardware. Please check the hardware setup.", sCause)

'// Return failure

End Function

Private Sub SetupIncomingMessagesForRun()
    Dim lCount As Long
    

    mNumInMsgs = IncomingMessages.Count
    For lCount = 1 To mNumInMsgs
        With IncomingMessages(lCount)
            Set .Parent = Me            '// set a ref to the the parent
            .InputIndex = lCount        '// setup the index
        End With
    Next lCount
        
    '// setup the value cache ////////////////////////////////////////////////////////////////////////
    If mNumInMsgs <> 0 Then
        ReDim dIncomingValues(1 To mNumInMsgs)
        ReDim inmsgInputMessages(1 To mNumInMsgs)
        ReDim dIncomingPresentFlags(1 To mNumInMsgs)
    
        '// Enter the current values into the value cache, so that the cache is consistent
        For lCount = 1 To mNumInMsgs
            With mvarcIncomingMessages(lCount)
                dIncomingValues(lCount) = .DoubleValue
                dIncomingPresentFlags(lCount) = .Present
                .CompileByteStrings             '// compile the byte strings into the filter
                With inmsgInputMessages(lCount)
                    .bEnabled = mvarcIncomingMessages(lCount).ValueSource = icsVSPYSourceBus
                    .bLastBytePassed = False
                    .mMsg = mvarcIncomingMessages(lCount).MessageFilter
                End With
            End With
        Next lCount
    End If
    '//////////////////////////////////////////////////////////////////////////////////////////////////////////////

End Sub

Public Property Get MonitorOn() As Boolean
    MonitorOn = mvarMonitorOn
End Property

Public Sub IntializeEveryThing()
    Dim lCount As Long
    Dim lNumItems As Long
    
    For lCount = 1 To lNumItems     '// Reset the transmit counts
        OutgoingMessages(lCount).StartTransmitCount
    Next lCount
    
    outDelayMsgsSize = 1000         '// start at 1000 messages
    ReDim outDelayMsg(1 To outDelayMsgsSize) '// setup the out delay
    outDelayMsgsCount = 0 '// reset the count
    
End Sub

