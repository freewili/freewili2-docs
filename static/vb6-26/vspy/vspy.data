    Dim lReturn As Long
    Dim sTemp As String
    Dim sDummy As String

    '// open the directory
    lReturn = ShellExecute(hwndOwner, "Explore", sPath, _
                                    &H0, &H0, SW_SHOWNORMAL)
        
End Function

Public Function ShowWinFindDialog(ByVal hwndOwner As Long)
    Call ShellExecute(hwndOwner, "find", vbNullString, vbNullString, vbNullString, SW_SHOWNORMAL)
End Function


Public Function ShowURLInDefaultBrowser(ByVal hwndOwner As Long, ByVal sUrl As String) As Boolean

    Dim FileName, Dummy As String
    Dim BrowserExec As String * 255
    Dim RetVal As Long
    Dim FileNumber As Integer
      
    '// First, create a known, temporary HTML file
    BrowserExec = Space(255)
    FileName = App.Path & "\temphtm.HTM"
    FileNumber = FreeFile                    ' Get unused file number
    Open FileName For Output As #FileNumber  ' Create temp HTML file
        Write #FileNumber, "<HTML> <\HTML>"  ' Output text
    Close #FileNumber                        ' Close file
      
    '// Then find the application associated with it
    RetVal = FindExecutable(FileName, Dummy, BrowserExec)
    BrowserExec = Trim(BrowserExec)
      
    ' If an application is found, launch it!
    If RetVal <= 32 Or IsEmpty(BrowserExec) Then ' Error
        ShowURLInDefaultBrowser = False
    Else
        RetVal = ShellExecute(hwndOwner, "open", BrowserExec, _
            sUrl, Dummy, SW_SHOWNORMAL)
        If RetVal <= 32 Then        ' Error
            ShowURLInDefaultBrowser = False
        Else
            ShowURLInDefaultBrowser = True
        End If
    End If
    Kill FileName                   ' delete temp HTML file
End Function

Public Sub ExecuteAndWait(ByVal apppath As String, ByVal cmdline As String, ByVal bHidden As Boolean)
    Dim NameOfProc As PROCESS_INFORMATION
    Dim NameStart As STARTUPINFO
    Dim X As Long
    
    cmdline = GetShortName(apppath) & " " & cmdline
    
    If bHidden Then
        '// make the window hidden
        NameStart.dwFlags = STARTF_USESHOWWINDOW
        NameStart.wShowWindow = SW_HIDE
    End If
    
    NameStart.cb = Len(NameStart)
    X = CreateProcessA(0&, cmdline$, 0&, 0&, 1&, _
        NORMAL_PRIORITY_CLASS, 0&, 0&, NameStart, NameOfProc)
    If X <> 0 Then
        X = WaitForSingleObject(NameOfProc.hProcess, INFINITE)
        X = CloseHandle(NameOfProc.hProcess)
    Else
        Debug.Print "Problem starting process"
    End If
End Sub



   
Public Function GetShortName(ByVal sLongFileName As String) As String
    Dim lRetVal As Long, sShortPathName As String, iLen As Integer
    'Set up buffer area for API function call return
    sShortPathName = Space(255)
    iLen = Len(sShortPathName)

    'Call the function
    lRetVal = GetShortPathName(sLongFileName, sShortPathName, iLen)
    'Strip away unwanted characters.
    GetShortName = Left(sShortPathName, lRetVal)
End Function



Attribute VB_Name = "basFormMain"
Option Explicit

'// Moves to the next column in a grid
Public Sub GotoNextColumn(g As MSFlexGrid)
    Dim lNew As Long
    On Error Resume Next
    lNew = g.Col + 1
    '// are we at the end of the row
    If lNew <= (g.Cols - 1) Then
        g.Col = lNew
        g.SetFocus
    Else
        lNew = g.Row + 1 '// increment the row
        If lNew <= (g.Rows - 1) Then
            g.Col = 1
            g.Row = lNew
            g.SetFocus
        End If
    End If
    
    '// make sure that the col is visible
    If Not g.ColIsVisible(g.Col) Then g.LeftCol = g.Col
    If Not g.RowIsVisible(g.Row) Then g.TopRow = g.Row
    
End Sub
Public Sub GotoNextRow(g As MSFlexGrid)
    Dim lNew As Long
    lNew = g.Row + 1
    '// are we at the end of the row
    If lNew <= (g.Rows - 1) Then
        g.Row = lNew
        g.SetFocus
    End If
End Sub
Public Function FillDownColPassed(lCol, lMin, lMax) As Boolean
    If lCol >= lMin And lCol <= lMax Then FillDownColPassed = True
End Function
