      Height          =   315
      Left            =   225
      Style           =   2  'Dropdown List
      TabIndex        =   0
      Top             =   1080
      Width           =   2445
   End
   Begin icsSPYObjects.ctlUserExpression ctlUserExpression1 
      Height          =   2775
