Public Property Get HardwareID() As icsVPYHardwareType
    HardwareID = mHardwareID
End Property
Public Property Let HardwareID(ByVal lNew As icsVPYHardwareType)
    mHardwareID = lNew
    SetupProtocol   '// c
End Property
'// Returns a string description of the hardware setup including port number
Public Property Get HardwareDescription() As String
Attribute HardwareDescription.VB_Description = "Returns a string description of the hardware setup including port number."
    Dim sName As String
    
    Select Case mHardwareID
        Case icsVSPYTypeAVT716or716VPW
            sName = "AVT-715/716 VPW on Comm " & HardwareCommPort
        Case icsVSPYTypeAVT716Threaded
            sName = "AVT-716 (threaded)"
        Case icsVSPYTypeGMVSI
            sName = "GM-VSI on Comm " & HardwareCommPort
        Case icsVSPYTypeNICAN
            sName = "NI-CAN on port " & HardwareCommPort
        Case icsVSpyTypeActiveX
            sName = NetworkHardware.HardwareDescription
        Case icsVSpyTypeDemo
            Select Case Protocol
                Case icsVSPYProtocolJ1850
                    sName = "Demo mode J1850"
                Case icsVSPYProtocolCAN
                    sName = "Demo mode J1850"
                Case Else
            End Select
        Case Else
            sName = "Undefined Hardware Type"
    End Select
    
    HardwareDescription = sName
    
End Property

'// this function setups up the protocol property based on the value of the
'// hardwareid property
Private Sub SetupProtocol()
    '// check for the protocol
    Select Case mHardwareID
        Case icsVSPYTypeNICAN
            Protocol = icsVSPYProtocolCAN
        Case icsVSpyTypeDemo
            Protocol = SimulationProtocol
        Case Else
            Protocol = icsVSPYProtocolJ1850
    End Select
End Sub
Public Property Get Protocol() As icsVSPYProtocol
    Protocol = mProtocol
End Property
Public Property Let Protocol(bNew As icsVSPYProtocol)
    mProtocol = bNew
End Property
'///////'///////'///////'///////'///////'///////'///////'///////'///////'///////'///////

Private Sub UpdateBusLoadInputs()
    Dim lCount As Long

    For lCount = 1 To mvarcIncomingMessages.Count
        If mvarcIncomingMessages(lCount).ValueSource = icsVSPYSourceBusLoad Then
             mvarcIncomingMessages(lCount).Value = mCurrentBusLoad
        End If
    Next lCount
    
End Sub


Private Sub UpdateAnalogInputs()
    Dim lCount As Long
    Dim lValueSource As Long
    Dim lIndex As Long
    
    On Error GoTo UpdateAnalogInputsError
    
    For lCount = 1 To mvarcIncomingMessages.Count
        '// what type of value source is this
        lValueSource = mvarcIncomingMessages(lCount).ValueSource
        
        If lValueSource >= icsVSPYSourceHardware Then
            lIndex = lValueSource - icsVSPYSourceHardware + 1
            mvarcIncomingMessages(lCount).Value = MultiIO.InputValue(lIndex)
        End If
    Next lCount
    
    Exit Sub
UpdateAnalogInputsError:
    AddVehicleSpyError "Error updating the analog inputs"
End Sub

Private Sub UpdateGPSInputs()
    Dim lCount As Long
    Dim lValueSource As Long
    
    For lCount = 1 To mvarcIncomingMessages.Count
        '// what type of value source is this
        lValueSource = mvarcIncomingMessages(lCount).ValueSource
        
        '// assign the value if it is type of GPS data
        Select Case lValueSource
            Case icsVSPYSourceGPSAltitude
                mvarcIncomingMessages(lCount).Value = obGPS.Altitude
            Case icsVSPYSourceGPSLatitude
                mvarcIncomingMessages(lCount).Value = obGPS.Latitude
            Case icsVSPYSourceGPSLongitude
                mvarcIncomingMessages(lCount).Value = obGPS.Longitude
            Case icsVSPYSourceGPSSpeed
                mvarcIncomingMessages(lCount).Value = obGPS.SpeedOverGround
        End Select
    Next lCount
    
End Sub

