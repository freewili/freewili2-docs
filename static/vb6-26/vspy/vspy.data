Public Function FireTXNamesEvent() As Variant
    Dim TxNames As Variant
    RaiseEvent RequestTXNames(TxNames)
    FireTXNamesEvent = TxNames
End Function

Public Function FireRXNamesEvent() As Variant
    Dim TxNames As Variant
    RaiseEvent RequestRXNames(TxNames)
    FireRXNamesEvent = TxNames
End Function

Public Function FireTestNamesEvent() As Variant
    Dim TxNames As Variant
    RaiseEvent RequestTestNames(TxNames)
    FireTestNamesEvent = TxNames
End Function

Public Sub ReadWriteData(bWriteDirection As Boolean, obSave As Object)
    Dim sDummy As String
    Dim dDummy As Double
    Dim lDummy As Long
    Dim bDummy As Boolean
    
'// Equalize all the properties
With obSave

    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    
    .readwriteboolean DisplayLocked
    
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    
    
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    .readwritedouble dDummy
    
    
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    .ReadWriteString sDummy
    
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    .readwriteboolean bDummy
    
End With
'//////////////////////////////

'// read write the collection into the storage area
Call CollectionReadWriteData(Graphs, bWriteDirection, obSave)
Call CollectionReadWriteData(cMessageDisplays, bWriteDirection, obSave)
Call CollectionReadWriteData(MessageEntries, bWriteDirection, obSave)
Call CollectionReadWriteData(cStaticTexts, bWriteDirection, obSave)
Call CollectionReadWriteData(cDigitalDisplays, bWriteDirection, obSave)
Call CollectionReadWriteData(cDigitalEntries, bWriteDirection, obSave)
Call CollectionReadWriteData(cAnalogEntries, bWriteDirection, obSave)
Call CollectionReadWriteData(cAnalogDisplays, bWriteDirection, obSave)
Call CollectionReadWriteData(TestButtons, bWriteDirection, obSave)
Call CollectionReadWriteData(OnOffButtons, bWriteDirection, obSave)
Call CollectionReadWriteData(NumericEntries, bWriteDirection, obSave)
    
With obSave
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
    .readwritelong lDummy
End With


End Sub
Public Sub SetEqualTo(MasterUD As cUserDialog)



'// All it takes is just one glance /////////////////
With MasterUD
    
    '// Save the dialog properties
    Call CollectionSetEqualTo(Graphs, .Graphs)
    Call CollectionSetEqualTo(cMessageDisplays, .cMessageDisplays)
    Call CollectionSetEqualTo(MessageEntries, .MessageEntries)
    Call CollectionSetEqualTo(cStaticTexts, .cStaticTexts)
    Call CollectionSetEqualTo(cDigitalDisplays, .cDigitalDisplays)
    Call CollectionSetEqualTo(cDigitalEntries, .cDigitalEntries)
    Call CollectionSetEqualTo(cAnalogEntries, .cAnalogEntries)
    Call CollectionSetEqualTo(cAnalogDisplays, .cAnalogDisplays)
    Call CollectionSetEqualTo(TestButtons, .TestButtons)
    Call CollectionSetEqualTo(OnOffButtons, .OnOffButtons)
    Call CollectionSetEqualTo(NumericEntries, .NumericEntries)
    
End With
'//////////////////////////////////////////////////////////////////////

End Sub

'// this sub clears all of the collections
Public Sub MakeNew()

    Graphs.RemoveAll
    cMessageDisplays.RemoveAll
    MessageEntries.RemoveAll
    cStaticTexts.RemoveAll
    cDigitalDisplays.RemoveAll
    cDigitalEntries.RemoveAll
    cAnalogEntries.RemoveAll
    cAnalogDisplays.RemoveAll
    TestButtons.RemoveAll
    OnOffButtons.RemoveAll
    NumericEntries.RemoveAll
    
End Sub

Private Sub CollectionSetEqualTo(cCol As Object, cColToCopy As Object)

    Dim lNumItems As Long
    Dim lCount As Long
    Dim TempGraph As Object
    Dim TempKey As String
    
    cCol.RemoveAll
    lNumItems = cColToCopy.Count
    For lCount = 1 To lNumItems
        TempKey = cColToCopy(lCount).Key
        Set TempGraph = cCol.Add(TempKey, TempKey)
        Call TempGraph.SetEqualTo(cColToCopy(TempKey))
    Next lCount
    '//////////////////////////////////////////////


End Sub

Private Sub CollectionReadWriteData(cCol As Object, bWriteDirection As Boolean, obSave As Object)

    Dim lNumItems As Long
    Dim lCount As Long
    Dim TempOb As Object
    Dim TempKey As String
    Dim sKey As String
    
    
    '// First read or write the number of elements in the collection
    lNumItems = cCol.Count
    obSave.readwritelong lNumItems
    
    
    If Not bWriteDirection Then
        cCol.RemoveAll  '// Remove all items in this collection
    End If



    '// Now add all the needed items
    For lCount = 1 To lNumItems
        
        If bWriteDirection Then
            sKey = cCol(lCount).Key
            obSave.ReadWriteString sKey
            cCol(lCount).Key = sKey
        Else
            obSave.ReadWriteString sKey
        End If
        
        '// Add this key if we are reading from a stream
        If Not bWriteDirection Then
            '// Add the items to the collection
            Set TempOb = cCol.Add(sKey, sKey)
        Else
            Set TempOb = cCol(lCount)
        End If
        
        '// Now read write the rest of the information to the storage
        Call TempOb.ReadWriteData(bWriteDirection, obSave)
    
    Next lCount
    


End Sub




