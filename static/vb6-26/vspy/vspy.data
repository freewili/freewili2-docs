Attribute VB_Name = "frmOptions"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public obApp As cicsSpy

Public ClassIDCanceled As Boolean
Public ClassIDEntered As String
    




Private Sub chkUseLogFile_Click()
    If chkUseLogFile = vbChecked Then
        ctlSpyStart.Enabled = True
        lblLogFile.Enabled = True
    Else
        ctlSpyStart.Enabled = False
        lblLogFile.Enabled = False
    End If
End Sub



Private Sub cmdAddHardwareChannel_Click()
    Dim lvwItem As ListItem
    If Trim$(txtHardwareChannelDescription) <> "" Then
        Set lvwItem = lvwAIChannels.ListItems.Add(, , txtHardwareChannelDescription)
        lvwItem.SubItems(1) = lstHardwareChannels
        lvwItem.Tag = lstHardwareChannels.ListIndex
        txtHardwareChannelDescription = ""
    Else
        MsgBox "Please enter a name for this channel", vbInformation, "You must describe this channel"
    End If
End Sub

Private Sub cmdAINewServer_Click()
    Dim sInput As String
    
    On Error GoTo NewAIServer   '// handle possible errors
    
    '// set the mousepointer
    MousePointer = vbHourglass
    
    '// setup the class id of the server
    Set frmEnterClassID.frm = Me
    frmEnterClassID.Show vbModal
    
    
    '    sInput = InputBox("Please enter in the class id of the hardware server.", "Setup Spy Hardware", "dllNIHardware.cNIHardware")
    
    '// create the object
    If Not ClassIDCanceled Then
        obApp.MultiIO.ClassNameOfServer = ClassIDEntered
        If obApp.MultiIO.CreateServerObject Then
            lblAIDisplay = obApp.MultiIO.HardwareDescription
            Call obApp.MultiIO.FillListWithAnalogInputPoints(lstHardwareChannels)
            lblAIDisplay.Enabled = True
            cmdSetupAI.Enabled = True
        Else
             MsgBox "There was a problem creating this object." & vbCrLf & _
                vbCrLf & "Error: " & obApp.MultiIO.LastErrorString, vbInformation
        End If
    End If
    
    '// return the mousepointer
    MousePointer = vbDefault
    
    
    Exit Sub

NewAIServer:
    
    '// return the mousepointer
    MousePointer = vbDefault
    
    MsgBox "There was a problem creating this object." & vbCrLf & _
        vbCrLf & "Error: " & Err.Description, vbInformation
End Sub

Private Sub cmdAuthorizeLicense_Click()
    Dim sSiteKey As String
    
    sSiteKey = Me.txtSiteKey

    If Not ChangeAuthorization(sSiteKey) Then
        psMsg = "Authorization NOT accepted." & Chr$(13) & "Error: " & ErrorNum & "-" & ErrorMsg
        MsgBox psMsg, vbCritical
        psMsg = ""
        Me.txtSiteKey = ""
        Exit Sub
    Else
        MsgBox "Authorization accepted.", vbInformation
        psMsg = ""
        Me.Hide
        AppIsAuthorized = True
    End If
End Sub

Private Sub cmdAVTSetup_Click()
    MousePointer = vbHourglass
    With frmAVTSetup
        Set .obApp = obApp
        .SetupUI
        .Show vbModal, Me
    End With
    MousePointer = vbDefault
End Sub

Private Sub CmdCancel_Click()
    Unload Me
End Sub

Private Sub cmdClearHardware_Click()
    lvwAIChannels.ListItems.Clear '// clear the list
End Sub

Private Sub cmdCopySiteCode_Click()
    Clipboard.Clear
    Clipboard.SetText txtLicenseSiteCode
End Sub

Private Sub cmdCreateFaxOrEmail_Click()
    Call obApp.CreateOrderForm(Me.hwnd, False, True)
End Sub




Private Sub cmdHardwareWiz_Click()
    Dim ob As Object
    On Error GoTo ShowFirstFormError
    Set ob = CreateObject("icsvspyFirst.cicsvspyFirst")
    ob.ShowWelcome = True
    Set ob.obApp = obApp
    ob.showform
    Set ob = Nothing
    SetupUI
    Exit Sub
ShowFirstFormError:
    MsgBox "There was an error showing the hardware wizard form." & _
        vbCrLf & vbCrLf & "Description: " & Err.Description, vbInformation
    Set ob = Nothing
    SetupUI
    Exit Sub
End Sub

Private Sub cmdLicensePrint_Click()
    Call obApp.CreateOrderForm(hwnd, True, False)
End Sub

Private Sub cmdNewActiveXHardware_Click()
    Dim sInput As String
    
    On Error GoTo NewActiveXHardwareError
    
    '// setup the class id of the server
    sInput = InputBox("Please enter in the class id of the Hardware server.", "Setup Spy Hardware", "icsspySenseNet.cSenseNet")
    If sInput <> "" Then
        Set obApp.NetworkHardware = CreateObject(sInput)
        lblActiveXDisplay = obApp.NetworkHardware.HardwareDescription
        lblActiveXDisplay.Enabled = True
        cmdSetupActiveXHardware.Enabled = True
    End If
    
    Exit Sub

NewActiveXHardwareError:
    MsgBox "There was a problem creating this object." & vbCrLf & _
        vbCrLf & "Error: " & Err.Description, vbInformation

End Sub

Private Sub CmdOk_Click()
Dim lNumberOfItems As Long
Dim lCount As Long

    
    With obApp
        
        If Val(txtNumberOfTests) < 0 Then
            MsgBox "The default number of tests must be at least 0. Please fix."
            Exit Sub
        End If
        If Val(txtNumberOfTests) > 100 Then
            MsgBox "The default number of tests must be less than 100. Please fix."
            Exit Sub
        End If
        If Val(txtNumberOfFilters) < 0 Then
            MsgBox "The default number of incoming messages must be at least 0. Please fix."
            Exit Sub
        End If
        
        If Val(txtNumberOfFilters) > 1000 Then
            MsgBox "The default number of incoming messages must be less than 1000. Please fix."
            Exit Sub
        End If
        
        If Val(txtNumberOfMessages) < 0 Then
            MsgBox "The default number of outgoing messages must be at least 0. Please fix."
            Exit Sub
        End If
        
        If Val(txtNumberOfMessages) > 1000 Then
            MsgBox "The default number of outgoing messages must be less than 1000. Please fix."
            Exit Sub
        End If
        
        If Val(txtDisplayUpdateRate) < 0 Then
            MsgBox "The text monitor display rate must be greater than 0. Please fix."
            Exit Sub
        End If
        
        If Val(txtDisplayUpdateRate) > 1000 Then
            MsgBox "The text monitor display less than or equal to 1000. Please fix."
            Exit Sub
        End If
        
        If Val(txtProcessSleepTime) < 0 Then
            MsgBox "The process sleep time must be less than zero. Please fix."
            Exit Sub
        End If
        If Val(txtProcessSleepTime) > 100 Then
            MsgBox "The process sleep time must be less than or equal to 100. Please fix."
            Exit Sub
        End If
    
        '// performance settings
        With .Performance
            If optRunMode(0) Then .MainEngineSetup = icsspyPerformanceRunInTightLoop
            If optRunMode(1) Then .MainEngineSetup = icsspyRunInWindowsTimerLoop
            .ProcessSleepTimeMs = txtProcessSleepTime
            .TextMonitorUpdateRateMs = txtDisplayUpdateRate
            If optTextMonitorDisplay(0) Then .TextMonitorUpdateType = icsspyPerformanceMonitorForceUpdates
            If optTextMonitorDisplay(1) Then .TextMonitorUpdateType = icsspyPerformanceMonitorAttemptButYield
            If optTextMonitorDisplay(2) Then .TextMonitorUpdateType = icsspyPerformanceMonitorDoNotAttempt
            If chkMakeDefaultPerformance = vbChecked Then .SaveCurrentValuesAsDefault
        End With
        
        '.AVTProtocol = lstAVTProtocol.ListIndex
        
        .DefaultNumTests = Val(txtNumberOfTests)
        .DefaultNumFilters = Val(txtNumberOfFilters)
        .DefaultNumMessages = Val(txtNumberOfMessages)
        
        .ReplayFilePath = bfSimDataFile.FileName
        
        .UseEventSounds = chkEnableEventSounds = vbChecked
        .UIShowLogFile = chkUseLogFile = vbChecked
        
        '// setup the GPS parameters
        With .GPS
            .Enabled = chkUseGPS And vbChecked
            .CommPort = lstGPSCommPort.ListIndex + 1
            .AcquireLocation = chkGPSLocation = vbChecked
            .AcquireSpeed = chkGPSSpeedOverGround = vbChecked
            .AcquireAltitude = chkGPSAltitude = vbChecked
            .AltitudeUnits = lstGPSAltitudeUnits.ListIndex
            .SpeedUnits = lstGPSSpeedUnits.ListIndex
            .SimulationMode = chkGPSSim = vbChecked
        End With
        
        '// record the analog input
        With .MultiIO
            .Enabled = chkUseAnalogInput And vbChecked
            lNumberOfItems = lvwAIChannels.ListItems.Count
            Call .SetNumberOfChannels(lNumberOfItems)
            For lCount = 1 To lNumberOfItems
                .ChannelDescription(lCount) = lvwAIChannels.ListItems(lCount).text
                .ChannelIndex(lCount) = lvwAIChannels.ListItems(lCount).Tag
            Next lCount
        End With
        
        '// set the performance
        .PerformPerformanceTest = chkPerformance = vbChecked
        .SimulationProtocol = lstSimulationProtocol.ListIndex
    
    End With
    
    '// Save the changes
    With obApp
        .HardwareID = lstHardware.ItemData(lstHardware.ListIndex)  '// hardware selected
        .HardwareCommPort = lstCommPorts.ListIndex + 1             '// comm port selected
        .HardwareBaudRate = lstBaudRate.ItemData(lstBaudRate.ListIndex)
    End With
    
    '// save the defaults if make default is checked
    If chkMakeDefaultGPS = vbChecked Then
        obApp.GPS.SaveCurrentValuesAsDefault
        
    End If
    
    If chkMakeDefaultHardware = vbChecked Then
        obApp.SaveHardwareDefaults
    End If
    
    obApp.SaveApplicationDefaults
    obApp.App.SaveNeeded = True
    
    Unload Me
    
End Sub

Private Sub cmdRemoveHardwareItem_Click()
    If Not (lvwAIChannels.SelectedItem Is Nothing) Then
        lvwAIChannels.ListItems.Remove lvwAIChannels.SelectedItem.Index
    End If
End Sub

