End Sub
Private Sub grdOutgoingMessages_KeyPress(KeyAscii As Integer)
    Call StartEditOutgoingMessages(CLng(KeyAscii))
End Sub
Private Sub grdOutgoingMessages_LeaveCell()
    Call LeaveCellOutgoingMessages
End Sub
Private Sub grdOutgoingMessages_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim sOutMsgKey As String
    m_bGridSelChanged = False
    If Button And vbRightButton Then
        '// setup the popup menu
        If obApp.OutgoingMessages.Count <> 0 Then
            If obApp.OutgoingMessages.Count >= grdOutgoingMessages.Row Then
                '// set the set menu text
                sOutMsgKey = grdOutgoingMessages.TextMatrix(grdOutgoingMessages.Row, 0)
                If Trim$(obApp.OutgoingMessages(sOutMsgKey).Description) = "" Then
                    mnuOutgoingSet.Caption = "Set Message as TX"
                Else
                    mnuOutgoingSet.Caption = "Set " & obApp.OutgoingMessages(sOutMsgKey).Description & " as TX"
                End If
                mnuOutgoingSet.Enabled = True
                
                '// setup the fill down menu text
                If grdOutgoingMessages.Row > grdOutgoingMessages.RowSel Then
                    mnuOutgoingFill.Caption = "Fill Up"
                Else
                    mnuOutgoingFill.Caption = "Fill down"
                End If
                '// is there more than one row selected?
                If grdOutgoingMessages.Row = grdOutgoingMessages.RowSel Then
                    mnuOutgoingFill.Enabled = False
                Else
                    mnuOutgoingFill.Enabled = True
                End If
            End If
        Else
            '// no messages disable fill and set functions
            mnuOutgoingFill.Enabled = False
            mnuOutgoingSet.Enabled = False
        End If
        
            
        PopupMenu mnuOutgoing
    End If
End Sub

