    lTestNumber = gTest.Row
    '// the row in the test grid corresponds to the test number
    If lTestNumber <= obApp.Tests.Count And lTestNumber > 0 Then
        obApp.Tests(gTest.Row).StartTest
    End If
End Sub

Private Sub mnuTestStop_Click()
    Dim lTestNumber As Long
    lTestNumber = gTest.Row
    '// the row in the test grid corresponds to the test number
    If lTestNumber <= obApp.Tests.Count And lTestNumber > 0 Then
        obApp.Tests(gTest.Row).StopTest True
    End If
End Sub

'// this function sets the current view
Public Property Let CurrentView(lNew As ICSSpyMainUIView)

mCurrentView = lNew

'// handle the true case first
Select Case lNew
    Case icsSpyGraphicalView
        mnuViewChart.Checked = True
        tb.Buttons("viewchart").Value = tbrPressed
        tb.Buttons("add").Enabled = False
        pctDisplay.Visible = True
    Case icsSpyNotesView
        mnuViewNotes.Checked = True
        tb.Buttons("add").Enabled = False
        tb.Buttons("viewnotes").Value = tbrPressed
        tbNotes.Visible = True
    Case icsSpyTextView
        mnuViewScroll.Checked = True
        pctRead.Visible = True
        tbMonitor.Visible = True
        pctmonTest.Visible = True
        pctBufferTab.Visible = True
        If Not (obApp Is Nothing) Then
        If obApp.MonitorOn Then
            tb.Buttons("add").Enabled = False
        Else
            tb.Buttons("add").Enabled = True
        End If
        End If
        tb.Buttons("viewscroll").Value = tbrPressed
    Case icsSpyIncomingMessagesView
        mnuViewFilters.Checked = True
        grdIncomingMessages.Visible = True
        tb.Buttons("add").Enabled = True
        tb.Buttons("viewfilter").Value = tbrPressed
    Case icsSpyOutgoingMessagesView
        mnuViewMessages.Checked = True
        grdOutgoingMessages.Visible = True
        tb.Buttons("add").Enabled = True
        tb.Buttons("viewmsg").Value = tbrPressed
End Select
    
If lNew <> icsSpyGraphicalView Then 'its not the graphical monitor
    mnuViewChart.Checked = False
    tb.Buttons("viewchart").Value = tbrUnpressed
    pctDisplay.Visible = False
End If
    
If lNew <> icsSpyNotesView Then
    mnuViewNotes.Checked = False
    tb.Buttons("viewnotes").Value = tbrUnpressed
    NavigateToFilename
    wbNotes.AddressBar = True
    tbNotes.Visible = False
End If

    
If lNew <> icsSpyTextView Then 'its the text monitor
    mnuViewScroll.Checked = False
    pctRead.Visible = False
    pctBufferTab.Visible = False
    tbMonitor.Visible = False
    pctmonTest.Visible = False
    tb.Buttons("viewscroll").Value = tbrUnpressed
End If
    
If lNew <> icsSpyIncomingMessagesView Then 'its the input messages
    If bEditIncoming Then   '// Are we currently performing an edit
        Call LeaveCellIncomingMessages(False)
    End If
    mnuViewFilters.Checked = False
    grdIncomingMessages.Visible = False
    tb.Buttons("viewfilter").Value = tbrUnpressed
End If
    
If lNew <> icsSpyOutgoingMessagesView Then ' its the output messages
    If bEditOutgoing Then   '// Are we currently performing an edit
        Call LeaveCellOutgoingMessages(False)
    End If
    mnuViewMessages.Checked = False
    grdOutgoingMessages.Visible = False
    tb.Buttons("viewmsg").Value = tbrUnpressed
End If
    
End Property
Public Property Get CurrentView() As ICSSpyMainUIView
    CurrentView = mCurrentView
End Property


