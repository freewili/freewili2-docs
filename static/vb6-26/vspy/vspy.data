'// lean and mean
Private Function IicsHardware_ReadSinglePointInputs(AnalogInputValues As Variant, _
    DigitalInputValues As Variant, MessageValues As Variant, _
    CounterValues As Variant) As Boolean
    
    Dim lCount As Long
    Dim lInCount As Long
    Dim lStart As Long
    Dim lStop As Long
    
    For lCount = 1 To lNumAnalogInputs  '// transfer the analog inputs
        AnalogInputValues(lCount) = dIncomingValues(lAnalogInputVector(lCount))
    Next lCount
    For lCount = 1 To lNumDigitalInputs '// transfer the digital inputs
        DigitalInputValues(lCount) = CBool(dIncomingValues(lDigitalInputVector(lCount)))
    Next lCount
    lStart = lNumDigitalInputs + 1
    lStop = lNumDigitalInputs + m_lRoboTechInputCount
    For lCount = lStart To lStop        '// transfer the present flags
        lInCount = lInCount + 1
        DigitalInputValues(lCount) = dIncomingPresentFlags(lInCount)
    Next lCount
    
    '// return success
    IicsHardware_ReadSinglePointInputs = True
    
End Function

Private Function IicsHardware_ReadWriteHardware(ByVal WriteDirection As Boolean, vBytes As Variant) As Boolean
    Dim tempstring As String
    Dim obSave As New cBinaryStorage
    
    '// handle the saving object - this changes the bytes into information
    obSave.UseByteArray = True
    obSave.WriteDirection = WriteDirection
    
    '// are we reading or writing the filename
    If WriteDirection Then
        '// we are writing the string to a stream of bytes
        'obSave.ReadWriteString FilePath ' for saving the filename only
        Call ReadWrite(WriteDirection, obSave)
        vBytes = obSave.Bytes
        obSave.UseByteArray = False
    Else
        '// we are reading the bytes from a stream
        obSave.Bytes = vBytes
        Call ReadWrite(WriteDirection, obSave)
        'obSave.ReadWriteString tempstring '// used for the file
        obSave.UseByteArray = False
        'FilePath = tempstring
        
        '// Load the file
        'If FilePath <> "" Then
            'Call ReadWrite(False)
        
        RaiseEvent NewConfigurationLoaded   '// indicate attached object to update their display
        'End If
    End If
End Function


