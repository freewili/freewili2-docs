    If Len(frmSpyError.txtError) > 1000 Then
        frmSpyError.txtError = ""
    End If
    frmSpyError.txtError = "A Vehicle Spy Error Occured at " & Format$(Now(), "hh:mm:ss") & vbCrLf & sErrorString & vbCrLf & frmSpyError.txtError
