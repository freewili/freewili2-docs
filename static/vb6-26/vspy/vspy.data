Attribute VB_Name = "ctlBrowseFile"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Option Explicit

Private Sub cmdBrowse_Click()
    
    On Error GoTo errorbrowse
    
    With cmn
        .CancelError = True
        .Flags = cdlOFNHideReadOnly
        If FileExists(txtDatabasePath) Then
            .FileName = txtDatabasePath
        End If
        .ShowOpen
        txtDatabasePath = .FileName
    End With
    
    Exit Sub
    
errorbrowse:
    If Err.Number <> 32755 Then
        MsgBox "There was an error. " & Err.Number
    End If

End Sub

