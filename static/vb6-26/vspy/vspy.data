Private Sub mnuOutgoingFill_Click()
    Dim lCount As Long
    Dim lStartRow As Long
    Dim lStopRow As Long
    Dim lMinCol As Long
    Dim lMaxCol As Long
    Dim lSwap As Long
    Dim sMsgToCopy  As String
    Dim lByteCount As Long
    Dim sEditItem As String

    '// turn off the grid repainting
    grdOutgoingMessages.Redraw = False
    MousePointer = vbHourglass
    
    '// setup the parameters
    sMsgToCopy = grdOutgoingMessages.TextMatrix(grdOutgoingMessages.Row, 0)
    lStartRow = grdOutgoingMessages.Row
    lStopRow = grdOutgoingMessages.RowSel
    If lStartRow > lStopRow Then
        lSwap = lStartRow
        lStartRow = lStopRow
        lStopRow = lSwap - 1 ' minus one needed because do not need the current row
    Else
        lStartRow = lStartRow + 1
    End If
    lMinCol = grdOutgoingMessages.Col
    lMaxCol = grdOutgoingMessages.ColSel
    If lMaxCol < lMinCol Then
        lSwap = lMinCol
        lMinCol = lMaxCol
        lMaxCol = lSwap
    End If
    
    '// cached inital values
    'Dim lInitalColor As Long
    Dim lInitalValueType As Long
    Dim dIntialValue As Double
    Dim sInitalDescription As String
    Dim sInitalDataBytes(1 To 11) As String
    Dim dInitalTxRate As Double
    
    '// first handle all non-message bytes
    With obApp.OutgoingMessages
        '// get the color to fill down with
        With .Item(sMsgToCopy)
            'lInitalColor = .DisplayColor
            lInitalValueType = .ValueType
            dInitalTxRate = .UpdateRate
            dIntialValue = .DoubleValue
            sInitalDescription = .Description
            
            '// all the data bytes
            For lByteCount = 1 To 11
                sInitalDataBytes(lByteCount) = .ByteString(lByteCount)
            Next lByteCount
        End With
            
        '// cycle through applicable messages
        For lCount = lStartRow To lStopRow
            sEditItem = grdOutgoingMessages.TextMatrix(lCount, 0)
            With .Item(sEditItem)
'                If FillDownIncomingColPassed(mInMsgColorCol, lMinCol, lMaxCol) Then
'                    .DisplayColor = lInitalColor
'                End If
                
                If FillDownColPassed(mOutMsgValueTypeCol, lMinCol, lMaxCol) Then
                    .ValueType = lInitalValueType
                End If
                If FillDownColPassed(mOutMsgUpdateRateCol, lMinCol, lMaxCol) Then
                    .UpdateRate = dInitalTxRate
                End If
                If FillDownColPassed(mOutMsgDescriptionCol, lMinCol, lMaxCol) Then
                    .Description = sInitalDescription
                End If
                If FillDownColPassed(mOutMsgValueCol, lMinCol, lMaxCol) Then
                    .Value = dIntialValue
                End If
                
                '// the message bytes
                For lByteCount = 1 To 11
                    If FillDownColPassed(mOutMsgFirstHeaderCol + lByteCount - 1, lMinCol, lMaxCol) Then
                        .ByteString(lByteCount) = sInitalDataBytes(lByteCount)
                    End If
                Next lByteCount
            End With
            
            '// update the changes
            UpdateOutgoingMessageRow lCount
        Next lCount
    End With
                
    '// refresh the grid repainting
    grdOutgoingMessages.Redraw = True
    MousePointer = vbDefault
        
End Sub

