Attribute VB_Name = "frmStatusByte"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public WithEvents fMain As frmMain
Attribute fMain.VB_VarHelpID = -1

Private Sub fMain_NewMessageSelected(stMsg As icsspyHardware.icsSpyMessageLong)
     
    Dim lStatus As Long
    Dim lCount As Long
    Dim bRedrawSetToFalse As Boolean '// only repaint if not necessary
     
    lStatus = stMsg.StatusBitField
    
    With g
        For lCount = 0 To 30
            If (lStatus And 2 ^ lCount) > 0 Then
                If .TextMatrix(lCount + 1, 1) <> "Y" Then
                    If Not bRedrawSetToFalse Then
                        bRedrawSetToFalse = True
                        .Redraw = False
                    End If
                    .TextMatrix(lCount + 1, 1) = "Y"
                End If
            Else
                If .TextMatrix(lCount + 1, 1) <> "N" Then
                    If Not bRedrawSetToFalse Then
                        bRedrawSetToFalse = True
                        .Redraw = False
                    End If
                    .TextMatrix(lCount + 1, 1) = "N"
                End If
            End If
        Next lCount
        
        '// fix the redraw (if necessary
        If bRedrawSetToFalse Then
            .Redraw = True
        End If
    
    End With
    
    
End Sub

Private Sub Form_Load()
    Dim lCount As Long
    Dim vDescriptions As Variant
    
    g.Redraw = False
    g.Rows = 32  '// setup the grid
    
    '// get the status bit descriptions
    vDescriptions = ReturnStatusBitDescriptions()
    
    g.ColWidth(0) = 2500
    g.ColWidth(1) = 500
    
    g.TextMatrix(0, 0) = "Description"
    g.TextMatrix(0, 1) = "State"
    
    
    For lCount = 0 To 30
        g.TextMatrix(lCount + 1, 0) = vDescriptions(lCount)
    Next lCount
    
    g.Redraw = True
    
End Sub

Private Sub Form_QueryUnload(Cancel As Integer, UnloadMode As Integer)
    Set fMain = Nothing
End Sub

Private Sub Form_Resize()
    g.Move 0, 0, ScaleWidth, ScaleHeight
End Sub

