VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cCustomUI"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'// Public members
Public WithEvents pctUIPanel As PictureBox   '// This is the picture box which is the UI Panel
Attribute pctUIPanel.VB_VarHelpID = -1

Public sMove As Shape                       '// This is the rectangle that is shown during a move
Public pctToolTip As PictureBox             '// This is the tool tip window that shows the current location
Public lbllocation As Label                 '// This is the label inside the tool tip


'// Public members
Public mLockControls As Boolean        '// Indicates the UI is locked
Public mNewControlInsertX As Long       '// Indicates where the control was inserted on the UI X
Public mNewControlInsertY As Long       '// Indicates where the control was inserted on the UI Y
Public mGridValue As Long
Public mGridScaleM As Double
Public mFormatString As String
Public mBoxOutlineColor As Long


Private Enum ResizeType
    relowerright
    relowerleft
    reUpperRight
    reUpperLeft
End Enum

'// private members
Private mResizeType As ResizeType
Private mStartX As Single                   '// Indicates the start X position
Private mStartY As Single                   '// Indicates the start y position
Private bMovingFlag As Boolean              '// Indicates a move is in progress
Private bResizingFlag As Boolean            '// Indicates a resize operation is in progress
Private mSelectedControl As Control           '// Control that is selected

Public Event ShowControlPopup()
Public Event SelectedControlChanged()
Public Event ShowAddPopup()
Public Event ControlMoved()


Public Property Get SelectedControl() As Control
    Set SelectedControl = mSelectedControl
End Property
Public Property Set SelectedControl(ob As Control)
    Set mSelectedControl = ob
    RaiseEvent SelectedControlChanged
End Property

'// This function shows the drag ears around a control
Friend Sub DrawDragEars(ob As Control)
    
    Dim lLeft As Long
    Dim lTop As Long
    Dim lHeight As Long
    Dim lWidth As Long
    
    
    '// Clear the picture display
    pctUIPanel.Cls
    
    lLeft = ob.Left
    lTop = ob.Top
    lHeight = ob.Height
    lWidth = ob.Width
    
    
    '// Draw the upper left hand box
    pctUIPanel.Line (lLeft - 100, lTop - 100)-(lLeft, lTop), &H800000, BF
    pctUIPanel.Line (lLeft - 100, lTop - 100)-(lLeft, lTop), mBoxOutlineColor, B

    '// Draw the lower left hand box
    pctUIPanel.Line (lLeft - 100, lTop + lHeight)-(lLeft, lTop + lHeight + 100), &H800000, BF
    pctUIPanel.Line (lLeft - 100, lTop + lHeight)-(lLeft, lTop + lHeight + 100), mBoxOutlineColor, B
    
    '// Draw the upper right hand box
    pctUIPanel.Line (lLeft + lWidth, lTop)-(lLeft + lWidth + 100, lTop - 100), &H800000, BF
    pctUIPanel.Line (lLeft + lWidth, lTop)-(lLeft + lWidth + 100, lTop - 100), mBoxOutlineColor, B

    '// Draw the lower right hand box
    pctUIPanel.Line (lLeft + lWidth, lTop + lHeight)-(lLeft + lWidth + 100, lTop + lHeight + 100), &H800000, BF
    pctUIPanel.Line (lLeft + lWidth, lTop + lHeight)-(lLeft + lWidth + 100, lTop + lHeight + 100), mBoxOutlineColor, B
    

End Sub

Public Sub MouseDown(ob As Control, Button As Integer, X As Single, Y As Single)
    
    If Button And vbLeftButton Then '// is this a properties type function
        If mLockControls Then Exit Sub  '// do not respond to this event if controls are locked
        Call DrawDragEars(ob)           '// Draw the drag ears on the selected control
        Set SelectedControl = ob        '// Setup the select control property
    End If
    
    If Not (bMovingFlag Or bResizingFlag) Then '(do not show properties windows when moving)
        If Button And vbRightButton Then
            Call DrawDragEars(ob)           '// Draw the drag ears on the selected control
            Set SelectedControl = ob        '// Setup the select control property
            RaiseEvent ShowControlPopup     '// Show the right click menu
        End If
    End If
End Sub


'// This function sets the mouse pointer based on the mouse poistion of the control.
'// On the corners the X and Y arrows are shown
Private Function CheckForBox(SelectedControl As Control, X As Single, Y As Single, MousePointer As Long, Optional ChangeMousePointerOnly As Boolean = True) As Boolean
    
    If TypeName(SelectedControl) = "Nothing" Then
        MousePointer = vbDefault
        Exit Function
    End If
    
    CheckForBox = True
    
    '// upper left
    If (X > (SelectedControl.Left - 100) And X < SelectedControl.Left) And _
       (Y > (SelectedControl.Top - 100) And Y < SelectedControl.Top) Then
        MousePointer = vbSizeNWSE
        mResizeType = reUpperLeft
        Exit Function
    End If
    
    '// lower left
    If (X > (SelectedControl.Left - 100) And X < SelectedControl.Left) And _
       (Y > (SelectedControl.Top + SelectedControl.Height) And _
            Y < SelectedControl.Top + SelectedControl.Height + 100) Then
        MousePointer = vbSizeNESW
        mResizeType = relowerleft
        Exit Function
    End If
    
    '// upper right
    If (X > (SelectedControl.Left + SelectedControl.Width) And X < _
            (SelectedControl.Left + SelectedControl.Width + 100)) And _
       (Y > (SelectedControl.Top - 100) And Y < SelectedControl.Top) Then
        MousePointer = vbSizeNESW
        mResizeType = reUpperRight
        Exit Function
    End If
    
    '// lower left
    If (X > (SelectedControl.Left + SelectedControl.Width) And X < _
            (SelectedControl.Left + SelectedControl.Width + 100)) And _
           (Y > (SelectedControl.Top + SelectedControl.Height) And _
            Y < SelectedControl.Top + SelectedControl.Height + 100) Then
        MousePointer = vbSizeNWSE
        mResizeType = relowerright
        Exit Function
    End If
    
    '// no match
    MousePointer = vbDefault
    CheckForBox = False
        
End Function

'// This function is used to perform the grid type movements
Private Function RoundToTheNearest(Value As Long, Nearest As Long) As Long
    RoundToTheNearest = Value - Value Mod Nearest
End Function

Private Sub Class_Initialize()
    mGridValue = 144
    mGridScaleM = 6.944444444444E-04
    mFormatString = "0.000"
    mBoxOutlineColor = vbYellow
End Sub

Private Sub pctUIPanel_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    
    
    If Button And vbRightButton Then
        If Not bResizingFlag Then '(only show the properties dialog if not resizing)
            mNewControlInsertX = X
            mNewControlInsertY = Y
            RaiseEvent ShowAddPopup
        End If
    Else
            If CheckForBox(SelectedControl, X, Y, pctUIPanel.Parent.MousePointer) Then
                pctUIPanel.Cls
                bResizingFlag = True
                pctToolTip.Visible = True
                SelectedControl.Visible = False
                sMove.Move SelectedControl.Left, SelectedControl.Top, SelectedControl.Width, SelectedControl.Height
                sMove.Visible = True
            End If
       ' End If
    End If
End Sub

Private Sub pctUIPanel_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim lNewMousePointer As Long
    Dim lNewX As Long
    Dim lNewY As Long
    Dim lNewWidth As Long
    Dim lNewHeight As Long
    
    '// Force the resizing to the available area ////////////////////////
    If X < 0 Then X = 0
    If Y < 0 Then Y = 0
    If X > pctUIPanel.ScaleWidth Then X = pctUIPanel.ScaleWidth
    If Y > pctUIPanel.ScaleHeight Then Y = pctUIPanel.ScaleHeight
    '////////////////////////////////////////////////////////////////////
    
    If bResizingFlag Then
        '// Resize the control
        Select Case mResizeType
            Case relowerright
                
                lNewX = SelectedControl.Left
                lNewY = SelectedControl.Top
                lNewWidth = X - SelectedControl.Left
                lNewHeight = Y - SelectedControl.Top
                
                '// Move only if the new dimensions are valid
                If lNewWidth > 0 And lNewHeight > 0 Then
                    sMove.Move lNewX, lNewY, RoundToTheNearest((lNewWidth), mGridValue), _
                        RoundToTheNearest(lNewHeight, mGridValue)
                End If
                    
            Case relowerleft
                
               
                
                lNewX = RoundToTheNearest(CLng(X), mGridValue)
                lNewWidth = -(lNewX - (SelectedControl.Left + SelectedControl.Width))
                lNewHeight = Y - SelectedControl.Top
                
                '// Move only if the new dimensions are valid
                If lNewWidth > 0 And lNewHeight > 0 Then
                    sMove.Move lNewX, SelectedControl.Top, lNewWidth, _
                        RoundToTheNearest(lNewHeight, mGridValue)
                End If
                    
            Case reUpperRight
            
                lNewY = RoundToTheNearest(CLng(Y), mGridValue)
                lNewWidth = RoundToTheNearest(X - SelectedControl.Left, mGridValue)
                lNewHeight = -(lNewY - (SelectedControl.Top + SelectedControl.Height))
                
                '// Move only if the new dimensions are valid
                If lNewWidth > 0 And lNewHeight > 0 Then
                    sMove.Move SelectedControl.Left, lNewY, lNewWidth, lNewHeight
                End If
            Case reUpperLeft
                lNewX = RoundToTheNearest(CLng(X), mGridValue)
                lNewY = RoundToTheNearest(CLng(Y), mGridValue)
                lNewWidth = -(lNewX - (SelectedControl.Left + SelectedControl.Width))
                lNewHeight = -(lNewY - (SelectedControl.Top + SelectedControl.Height))
                
                '// Move only if the new dimensions are valid
                If lNewWidth > 0 And lNewHeight > 0 Then
                    sMove.Move lNewX, lNewY, lNewWidth, lNewHeight
                End If
                
        End Select

        '// Setup the tool tip window
        If (Y + 200 + pctToolTip.Height) > pctUIPanel.ScaleHeight Then
            lNewY = Y - pctToolTip.Height
        Else
            lNewY = Y + 200
        End If
        
        If (X + pctToolTip.Width) > pctUIPanel.ScaleWidth Then
            lNewX = X - 200 - pctToolTip.Width
        Else
            lNewX = X
        End If
        
        pctToolTip.Move lNewX, lNewY
        lbllocation = Format((sMove.Width * mGridScaleM), mFormatString) & "," & Format((sMove.Height * mGridScaleM), mFormatString) '// Report the location on the tool tip
        'Format(RoundToTheNearest(sMove.Width, mGridValue), "0.000") & _
         '               " x " & Format(RoundToTheNearest(sMove.height, mGridValue), "0.000")
                        
    Else
        Call CheckForBox(SelectedControl, X, Y, lNewMousePointer)
        pctUIPanel.Parent.MousePointer = lNewMousePointer
    End If
End Sub

Private Sub pctUIPanel_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
    
    If bResizingFlag Then
        bResizingFlag = False                   '// Clear the resizing operation
        sMove.Visible = False                   '// Hide the resizing control
        pctToolTip.Visible = False             '// Hide the tool tip window
        SelectedControl.Move sMove.Left, sMove.Top, sMove.Width, sMove.Height ' move control
        SelectedControl.Visible = True          '// Make the control visible
        RaiseEvent ControlMoved
    End If
    
End Sub

Public Sub MouseMove(ob As Control, Button As Integer, X As Single, Y As Single)
    Dim newX As Long
    Dim newY As Long
    Dim lNewToolTipX As Long
    Dim lNewToolTipY As Long
    
    '// do not respond to this event if the UI is locked
    If mLockControls Then Exit Sub
    
        If Button And vbLeftButton Then '// This is a move operation
            
            If Not bMovingFlag Then '// Start a move operation
                bMovingFlag = True      '// Set the moving flag
                sMove.Move ob.Left, ob.Top, ob.Width, ob.Height '// move the shape into place
                sMove.Visible = True        '// make the shape visible
                ob.Visible = False          '// hide the object
                pctToolTip.Visible = True   '// Show the tool tip
                mStartX = X                 '// Record the starting position
                mStartY = Y
                pctUIPanel.Cls              '// Clear the UI panel
            End If
        
            '// Determine the new left and top properties for the control
            newX = ob.Left + X
            newY = ob.Top + Y
            If newX < 1 Then newX = 0
            If newY < 1 Then newY = 0
            '////////////////////////////////////////////////////////////
            
             '// Setup the tool tip window
            If (newY + 400 + pctToolTip.Height) > pctUIPanel.ScaleHeight Then
                lNewToolTipY = newY - pctToolTip.Height
            Else
                lNewToolTipY = newY + 400
            End If
            
            If (newX + pctToolTip.Width) > pctUIPanel.ScaleWidth Then
                lNewToolTipX = newX - 200 - pctToolTip.Width
            Else
                lNewToolTipX = newX
            End If
            
            pctToolTip.Move lNewToolTipX, lNewToolTipY
            
            
            newX = newX - mStartX
            newY = newY - mStartY
            
            If newX < 0 Then newX = 0
            If newY < 0 Then newY = 0
            If (newX + ob.Width) > pctUIPanel.ScaleWidth Then
                newX = pctUIPanel.ScaleWidth - ob.Width
            End If
            If (newY + ob.Height) > pctUIPanel.ScaleHeight Then
                newY = pctUIPanel.ScaleHeight - ob.Height
            End If
            
            '// New locations
            newX = RoundToTheNearest(newX, mGridValue)
            newY = RoundToTheNearest(newY, mGridValue)
            
            sMove.Move newX, newY       '// Move the outline control to the new position
            lbllocation = Format((newX * mGridScaleM), mFormatString) & "," & Format((newY * mGridScaleM), mFormatString) '// Report the location on the tool tip
            
        Else
            '// Return the UI panels mouse to the default
            pctUIPanel.Parent.MousePointer = vbDefault
        End If
End Sub

Public Sub MouseUp(ob As Control, X As Single, Y As Single)
    
    If mLockControls Then Exit Sub
    
    If bMovingFlag Then
        ob.Move sMove.Left, sMove.Top, sMove.Width, sMove.Height
        sMove.Visible = False
        pctToolTip.Visible = False
        ob.Visible = True
        bMovingFlag = False
        Call DrawDragEars(ob)
        RaiseEvent ControlMoved
    End If

End Sub

Private Sub pctUIPanel_Paint()
    If Not (SelectedControl Is Nothing) Then
        If Not bMovingFlag And Not bResizingFlag Then
            Call DrawDragEars(SelectedControl)
        End If
    End If
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cDemo"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit

'// Demo/Replay object - copyright Intrepid Control Systems, Inc. 1998
'// Written by Dave Robins

Public Buffer As New cBuffer                    '// buffer object
Public Continuous As Boolean                    '// should the object be replayed over and over
Public NumberOfIterations As Long               '// how many time should the


'// Private members
Private mlNextMessage As Long                   '// next message in the buffer to read
Private mlSystemStartTime As Long               '// start of this test
Private bHasFirstMessage As Boolean             '// use to seed the message loop
Private mCurrentMessage As icsSpyMessageLong    '// current message
Private mlBufferStartTime As Long               '// start time of the buffer
Private mCurrentIteration As Long               '// indicate how many roll overs occurred in the TX buffer
Private mCurrentlyReplaying As Boolean          '// indicates a replay in progress

Private mTransmitMessages() As icsSpyMessageJ1850
Private lTransmitBufferSize As Long
Private lNumTransmitMessages As Long



'// Event to hand message bytes to the spy object
Public Event NewMessageBytes(MessageBytes As icsSpyMessageJ1850)
Public Event ReplayComplete()




Public Property Get CurrentMessageIndex() As Long
    Dim lTemp As Long
    lTemp = mlNextMessage - 1
    If lTemp = 0 Then
        lTemp = Buffer.BufferLength
    End If
    CurrentMessageIndex = lTemp
End Property

Public Property Get CurrentIteration() As Long
    CurrentIteration = mCurrentIteration
End Property

Public Function Start() As Boolean
    mlSystemStartTime = timeGetTime     '// initialize the start time
    mlBufferStartTime = mlSystemStartTime
    mlNextMessage = 1
    bHasFirstMessage = False
    mCurrentIteration = 1
    mCurrentlyReplaying = True
    ReDim mTransmitMessages(1 To 100)
    lTransmitBufferSize = 100
    lNumTransmitMessages = 0
    
End Function

'// get the next message
Public Sub ReadMessages()
    Dim lCurrentTime As Long
    Dim lStart As Long
    Dim Jmsg As icsSpyMessageJ1850
    Dim lCount As Long
    
    
    '// if we are done ->exit
    If Buffer.BufferLength < 1 Then Exit Sub         '// only replay if there is one message in the buffer
    If Not mCurrentlyReplaying Then Exit Sub
    
    
    If Not bHasFirstMessage Then
        bHasFirstMessage = True
        '// get the first message in the buffer
        Call Buffer.GetElement(mCurrentMessage, 1)
        mCurrentMessage.TimeSystem = mlBufferStartTime + mCurrentMessage.TimeSystem
        mCurrentMessage.StatusBitField = icsSpyStatusNetworkMessageType
    End If
    
    '// handle the tx messages ///////////////////////////////////
    For lCount = 1 To lNumTransmitMessages
        LSet Jmsg = mTransmitMessages(lCount)
        RaiseEvent NewMessageBytes(Jmsg)
    Next lCount
    lNumTransmitMessages = 0
    '////////////////////////////////////////////////////////////
    
    '// what is the test time
    lCurrentTime = timeGetTime - mlSystemStartTime

    Do While (mCurrentMessage.TimeSystem - mlSystemStartTime) <= lCurrentTime
        '// transfer the current message to spy
        mCurrentMessage.TimeSystem = timeGetTime '// fresh time stamp before send
        LSet Jmsg = mCurrentMessage
        RaiseEvent NewMessageBytes(Jmsg)
        
        '// now setup the next message
        
        '// set the index for the next message
        mlNextMessage = mlNextMessage + 1
        If mlNextMessage > Buffer.BufferLength Then
            mCurrentIteration = mCurrentIteration + 1
            If Not Continuous Then
                If mCurrentIteration > NumberOfIterations Then
                    mCurrentlyReplaying = False
                    RaiseEvent ReplayComplete
                End If
            End If
            mlNextMessage = 1
            mlBufferStartTime = timeGetTime
            '// get the first element of the second buffer
            Call Buffer.GetElement(mCurrentMessage, 1)
            mCurrentMessage.TimeSystem = mlBufferStartTime + mCurrentMessage.TimeSystem
            mCurrentMessage.StatusBitField = icsSpyStatusNetworkMessageType
        Else
            '// get the next message in the buffer
            Call Buffer.GetElement(mCurrentMessage, mlNextMessage)
            mCurrentMessage.TimeSystem = mlBufferStartTime + mCurrentMessage.TimeSystem
            mCurrentMessage.StatusBitField = icsSpyStatusNetworkMessageType
        End If
    Loop
    
    
End Sub

Friend Function SendMessage(msg As icsSpyMessageJ1850, DescriptionID As Long) As Boolean
    Dim MessageBytes() As Byte
    If (msg.StatusBitField And icsSpyStatusRemoteFrame) > 0 Then
        msg.StatusBitField = icsSpyStatusNetworkMessageType + icsSpyStatusTx + icsSpyStatusRemoteFrame
    Else
        msg.StatusBitField = icsSpyStatusNetworkMessageType + icsSpyStatusTx
    End If
    msg.TimeSystem = timeGetTime
    msg.DescriptionID = DescriptionID
    
    lNumTransmitMessages = lNumTransmitMessages + 1
    If lNumTransmitMessages > lTransmitBufferSize Then
        lTransmitBufferSize = lTransmitBufferSize + 100
        ReDim Preserve mTransmitMessages(1 To lTransmitBufferSize)
    End If
    
    LSet mTransmitMessages(lNumTransmitMessages) = msg
    
    
End Function


