Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage) As Boolean
Dim NumItems As Long
Dim lCount As Long
Dim lSpace As Long
Dim sSpace As String
Dim dSpace As Double
Dim bSpace As Boolean
Dim bJunk As Boolean

With obSave
    .ReadWriteLong mvarTestType
    
    
    .ReadWriteLong mvarTimeOut
    .ReadWriteString mvarTriggerEquation
    .ReadWriteBoolean mvarStoreRawData
    .ReadWriteBoolean mvarAppendValueToFileName
    .ReadWriteString mvarFilePath
    
    '// DAVE EDIT BEGIN 2/9/99
    '.ReadWriteLong mvarValueToAppendIndex
    .ReadWriteLong 0
    '// DAVE EDIT END 2/9/99
    
    .ReadWriteBoolean mvarResetAllValues
    .ReadWriteString mvarDescription
    .ReadWriteLong mvarStartMode
    .ReadWriteString mvarStartExpression
    .ReadWriteString mvarSaveExpression
    .ReadWriteBoolean mvarAppendDateTimeToFileName
    .ReadWriteBoolean mvarUseSaveExpression
    .ReadWriteBoolean mvarAppendFileValueTypeInput
    .ReadWriteLong mvarLogRate
    .ReadWriteBoolean mAfterStopCollect
    .ReadWriteLong mAfterStopDataType
    .ReadWriteLong mAfterStopMessages
    .ReadWriteLong mAfterStopTime
    .ReadWriteLong mvarCircularBufferLength
    .ReadWriteBoolean mStopOnExpressionEnabled
    .ReadWriteBoolean mStopTimeEnabled
    .ReadWriteBoolean mStopNumberOfMessagesEnabled
    .ReadWriteLong mStopNumberOfMessages
    .ReadWriteLong mStopAfterTime
    .ReadWriteBoolean bJunk
    .ReadWriteString mSoundStartedPath
    .ReadWriteString mSoundTriggeredPath
    .ReadWriteString mSoundCompletePath
    .ReadWriteBoolean mvarSaveDecimalFormatting


'.. new padding
    .ReadWriteLong mNumberOfGenerations         '// added 7/11/98
    .ReadWriteBoolean mContinuousGeneration     '// added 7/11/98
    .ReadWriteBoolean bSpace                    '// added 7/11/98 2 bools = 1 long
    
        '/// DAVEEDIT START 2/10/99
    '.ReadWriteLong lSpace
    .ReadWriteBoolean mvarAutoRestart
    .ReadWriteBoolean bSpace
        '/// DAVEEDIT END 2/10/99
    
        '// DAVEEDIT START 2/10/99
    .ReadWriteLong m_lTxMessageTestWhenTransmit
        '// DAVEEDIT STOP 2/10/99
    
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    
        '// DAVE EDIT START 2/9/99
    '.ReadWriteString sSpace
    .ReadWriteString mvarValueToAppendKey
        '// DAVE EDIT STOP 2/9/99
    
        '// DAVE EDIT START 1/2/99
    '.ReadWriteLong lSpace
    '.ReadWriteLong lSpace
    .ReadWriteLong m_lStopTestAction
    .ReadWriteLong m_lStopTestActionTestIndex
        '// DAVE EDIT STOP 1/2/99
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
    .ReadWriteLong lSpace
        '// DAVE EDIT START 1/28/99
    .ReadWriteLong m_lDigitalActuateTriggerType
    .ReadWriteLong m_lDigitalActuatePinID
        '// DAVE EDIT STOP 1/28/99
        
        '// DAVE EDIT START 1/28/99
    .ReadWriteDouble m_dTxMessageTestIntermessageDelaySec
        '// DAVE EDIT STOP 1/28/99

        '// DAVE EDIT START 2/10/99
    .ReadWriteDouble m_dTxMessageTestIntermessageDelaySec
        '// DAVE EDIT 2/10/99
    
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteDouble dSpace
    .ReadWriteString mReplayFilePath        '// added 7/8/98
    
        ''// DAVE EDIT START  1/28/99
    .ReadWriteString m_sActiveXServerClassID '// added 1/28/99
        '// DAVE EDIT STOP  1/28/99
        
        '// DAVE EDIT START 1/31/99
    .ReadWriteString mvarValueReplayOutKey
        '// DAVE EDIT STOP 1/31/99
        
    .ReadWriteString sSpace
    .ReadWriteString sSpace
    



End With

'// How many messages are there?
NumItems = Analyses.Count
obSave.ReadWriteLong NumItems

'// Add procedures if necessary
If Not bWriteDirection Then
    Analyses.RemoveAll
    For lCount = 1 To NumItems
        Analyses.Add
    Next lCount
End If

'// Store the procedures
For lCount = 1 To NumItems
    Call Analyses.Item(lCount).ReadWrite(bWriteDirection, obSave)
Next lCount
'////////////////////////////////////////////////

Call mvarResetFilters.ReadWrite(bWriteDirection, obSave)
Call mvarFilters.ReadWrite(bWriteDirection, obSave)

End Function

