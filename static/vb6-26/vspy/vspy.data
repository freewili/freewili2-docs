Private Sub mnuMonitor_Click()
    Dim msg As icsSpyMessageLong
    
    mnuMonitorShowInTable.Enabled = Not obApp.MonitorOn
    
    If lCurrentMessageHighlighted <> 0 Then
        If obApp.Monitor.Buffer.GetElement(msg, lCurrentMessageHighlighted) Then
            If msg.DescriptionID = 0 Then
                mnuMonitorAddToIncoming.Enabled = True
            Else
                mnuMonitorAddToIncoming.Enabled = False
            End If
        End If
    End If
    
End Sub


Private Sub mnuMonitorAddToExFilter_Click()
    Dim lNew As Long
    Dim msg As icsSpyMessageLong
    Dim Jmsg As icsSpyMessageJ1850
    
    If lCurrentMessageHighlighted <> 0 Then
        If obApp.Monitor.Buffer.GetElement(msg, lCurrentMessageHighlighted) Then
            LSet Jmsg = msg
            
            If msg.DescriptionID = 0 Then
                If AddToIncomingMessages(Jmsg) Then
                    msg.DescriptionID = obApp.IncomingMessages.Count
                Else
                    Exit Sub 'do not add a filter to this message
                End If
            End If
            
            With obApp.Monitor.Filters
                lNew = .ExcludedFiltersCount + 1
                Call .SetNumExcludedFilters(lNew)
                .ExcludedFiltersKey(lNew) = obApp.IncomingMessages(msg.DescriptionID).Key
                Call .CompileFilterIndexes(obApp.IncomingMessages)
            End With
        End If
    End If
End Sub

Private Sub mnuMonitorAddToIncoming_Click()
    Dim msg As icsSpyMessageLong
    Dim Jmsg As icsSpyMessageJ1850
    
    If lCurrentMessageHighlighted <> 0 Then
        If obApp.Monitor.Buffer.GetElement(msg, lCurrentMessageHighlighted) Then
            LSet Jmsg = msg
            Call AddToIncomingMessages(Jmsg)
        End If
    End If
End Sub

Private Function AddToIncomingMessages(msg As icsSpyMessageJ1850) As Boolean
    
    Dim inMsg As cIncomingMessage
    Dim lCount As Long
    Dim lDataByteCount As Long
    Dim sDescription As String
    Dim lMaxDataByte As Long
    Dim canmsg As icsSpyMessageLong
    
    sDescription = InputBox("Enter a description for this message.")
    If sDescription <> "" Then
        '// add a new incoming message
        Set inMsg = obApp.IncomingMessages.Add
        
        '// set the properties to bus and its description
        inMsg.Description = sDescription
        inMsg.ValueSource = icsVSPYSourceBus
        
        If obApp.Protocol = icsVSPYProtocolJ1850 Then
            '// for each byte
            For lCount = 1 To msg.NumberBytesHeader
                lDataByteCount = lDataByteCount + 1
                If msg.Header(lCount) <> 0 Then
                    inMsg.DataByteString(lDataByteCount) = Hex(msg.Header(lCount))
                End If
            Next lCount
        Else
            LSet canmsg = msg
            inMsg.DataByteString(1) = Format$(canmsg.ArbIDOrHeader)
            lDataByteCount = 3  '// start at the fourth byte
            LSet msg = canmsg
        End If
        
        lMaxDataByte = msg.NumberBytesData
        If lMaxDataByte > 3 Then lMaxDataByte = 3   '// the ui only supports 3 data byte filters
        For lCount = 1 To lMaxDataByte
            lDataByteCount = lDataByteCount + 1
            If msg.data(lCount) <> 0 Then
                inMsg.DataByteString(lDataByteCount) = Hex(msg.data(lCount))
            End If
        Next lCount
        
        '// refresh the filter table
        obApp.RefreshIncomingMessageFilterTable
        
        '// refresh the input grid
        Call InitializeTheIncomingMessagesGrid
        AddToIncomingMessages = True
    Else
        AddToIncomingMessages = False
    End If
End Function

Private Sub mnuMonitorAddToInFilter_Click()
    Dim lNew As Long
    Dim msg As icsSpyMessageLong
    Dim Jmsg As icsSpyMessageJ1850
    
    If lCurrentMessageHighlighted <> 0 Then
        If obApp.Monitor.Buffer.GetElement(msg, lCurrentMessageHighlighted) Then
            LSet Jmsg = msg
            
            If msg.DescriptionID = 0 Then
                If AddToIncomingMessages(Jmsg) Then
                    msg.DescriptionID = obApp.IncomingMessages.Count
                Else
                    Exit Sub 'do not add a filter to this message
                End If
            End If
            
            With obApp.Monitor.Filters
                lNew = .IncludedFiltersCount + 1
                Call .SetNumIncludedFilters(lNew)
                .IncludedFiltersKey(lNew) = obApp.IncomingMessages(msg.DescriptionID).Key
                Call .CompileFilterIndexes(obApp.IncomingMessages)
            End With
        End If
    End If
        
End Sub

Private Sub mnuMonitorAddToOutgoing_Click()
    Dim msg As icsSpyMessageLong
    Dim Jmsg As icsSpyMessageJ1850
    Dim outMsg As cOutgoingMessage
    Dim lCount As Long
    Dim lDataByteCount As Long
    Dim sDescription As String
    

    If lCurrentMessageHighlighted <> 0 Then
        If obApp.Monitor.Buffer.GetElement(msg, lCurrentMessageHighlighted) Then
            LSet Jmsg = msg
            
            sDescription = InputBox("Enter a description for this message.")
            If sDescription <> "" Then
                '// add a new incoming message
                Set outMsg = obApp.OutgoingMessages.Add
                
                '// set the properties to bus and its description
                outMsg.Description = sDescription
                
                '// for each byte
                If obApp.Protocol = icsVSPYProtocolJ1850 Then
                    For lCount = 1 To Jmsg.NumberBytesHeader
                        lDataByteCount = lDataByteCount + 1
                        If Jmsg.Header(lCount) <> 0 Then
                            outMsg.ByteString(lDataByteCount) = Hex(Jmsg.Header(lCount))
                        End If
                    Next lCount
                Else
                    outMsg.ByteString(1) = Format$(msg.ArbIDOrHeader)
                    If (msg.StatusBitField And icsSpyStatusRemoteFrame) > 0 Then
                        outMsg.ByteString(2) = "Y"
                    Else
                        outMsg.ByteString(2) = "N"
                    End If
                    lDataByteCount = 2  '// start at the fourth byte
                End If
                
                For lCount = 1 To Jmsg.NumberBytesData
                    lDataByteCount = lDataByteCount + 1
                    If Jmsg.data(lCount) <> 0 Then
                        outMsg.ByteString(lDataByteCount) = Hex(Jmsg.data(lCount))
                    End If
                Next lCount
                
                '// refresh the input grid
                Call InitializeTheOutgoingMessagesGrid
            End If
        End If
    End If
End Sub

