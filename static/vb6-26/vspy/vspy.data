Attribute VB_Name = "cVSI"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Attribute VB_Ext_KEY = "SavedWithClassBuilder" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Option Explicit
Option Base 1

'// Holds the last error message
Public UseAnalogInputs As Boolean
Public LastErrorMessage As String       '// shows the last error message
Public Comm As MSComm                    '// comm control used by the software
Attribute Comm.VB_VarHelpID = -1

Const ERR_NO_RESPONSE = "Error communicating with the VSI hardware, please check comm port settings and connections."
Const ERR_CONNECT_DLC_TO_ALDL = "Error connecting the DLC to ALDL"

'// used for threading
Private Declare Sub EnterCriticalSection Lib "kernel32" (lpCriticalSection As CRITICAL_SECTION)
Private Declare Sub LeaveCriticalSection Lib "kernel32" (lpCriticalSection As CRITICAL_SECTION)
Private Declare Sub InitializeCriticalSection Lib "kernel32" (lpCriticalSection As CRITICAL_SECTION)
Private Declare Sub DeleteCriticalSection Lib "kernel32" (lpCriticalSection As CRITICAL_SECTION)


Private Type CRITICAL_SECTION
    Dummy As Long
End Type

'// baud rates for the DLC
Public Enum icsVSIDLCBaudRate
    icsVSIDLC10400 = 0
    icsVSIDLC41200 = 1
End Enum

'// types of monitor modes
Public Enum icsVSIMonitorMode
    icsVsiMonitorOnly = 1
    icsVsiBlockMonitorOnly = 2
    icsVsiMonitorBoth = 3
End Enum

'// different ways to connect the DLC chip to the ALDL
Public Enum icsVSIConnectDLCtoALDLPin
    icsVsiDisconnectDLS = 0
    icsVsiConnectToPrimary = 1
    icsVsiConnectToSecondary = 2
    icsVsiConnectToMainNode = 4
    icsVsiConnectPrimSec = 3
    icsVsiConnectPrimMain = 5
    icsVsiConnectSecMain = 6
    icsVsiConnectPrimSecMain = 7
End Enum
    

Private mMonitorOn As Boolean           '// Turn monitoring on/off
Private mPortOpen As Boolean
Private sSave As String

'// Collection of bytes to send

'// function used for time stamping
Private Declare Function timeGetTime Lib "winmm.dll" () As Long
Private Declare Sub CopyData Lib "apigid32.dll" Alias "agCopyData" (Source As Any, dest As Any, ByVal nCount&)

'Default Property Values:
Const m_def_DLCConnection = icsVsiConnectToPrimary
Const m_def_MonitorMode = icsVsiMonitorOnly
Const m_def_BaudRate = 28800
Const m_def_DLCBaudRate = icsVSIDLC10400
Const VSI_REC_MSG_BITFIELD = icsSpyStatusHardwareTimePresent + icsSpyStatusNetworkMessageType
Const VSI_TX_MSG_BITFIELD = icsSpyStatusHardwareTimePresent + icsSpyStatusTx + icsSpyStatusNetworkMessageType

'Property Variables:
Dim m_DLCConnection As Long
Dim m_MonitorMode As Long
Dim m_BaudRate As Long
Dim m_DLCBaudRate As icsVSIDLCBaudRate
Private VSpyMessages(1 To 1000) As icsSpyMessageJ1850
Private VSpyMessagesCopy(1 To 1000) As icsSpyMessageJ1850
Private lMessageCount As Long


'// These are used for the read algorithim
Private bNewData() As Byte
Private bOldData() As Byte
Private bDataUsed() As Byte
Private lNumberOfBytesOld As Long
Private TXFIFO As New cFIFO

Private mLastRead As Long

Private WithEvents obTimer As cMMTime
Attribute obTimer.VB_VarHelpID = -1
Private m_bRunMultiThreaded As Boolean
Private mCriticalSection As CRITICAL_SECTION


Public Property Get RunMultiThreaded() As Boolean
    RunMultiThreaded = m_bRunMultiThreaded
End Property
Public Property Let RunMultiThreaded(lNew As Boolean)
    m_bRunMultiThreaded = lNew
End Property



Friend Sub SendMessage(msg As icsSpyMessageJ1850)
    Dim bData() As Byte
    Dim lNumMessageBytes As Long
    Dim lArrayCount As Long
    Dim lCount As Long
    Dim lSum As Long
    
    Call TXFIFO.PushItem(msg)
        
    '// Setup the data used to send the message
    lNumMessageBytes = msg.NumberBytesHeader + msg.NumberBytesData
    
    ReDim bData(0 To lNumMessageBytes + 3)
    
    
    '// Setup the array
    bData(0) = 84 '// asc("T")
    bData(1) = Asc(Hex(lNumMessageBytes))
    bData(2) = 13 '// Asc(vbCr)
    
    lCount = 2  '// start at the second byte
    
    '// First add the header bytes
    For lArrayCount = 1 To msg.NumberBytesHeader
        lCount = lCount + 1
        bData(lCount) = msg.Header(lArrayCount)
        lSum = lSum + bData(lCount)
    Next lArrayCount

    '// Now the data
    For lArrayCount = 1 To msg.NumberBytesData
        lCount = lCount + 1
        bData(lCount) = msg.data(lArrayCount)
        lSum = lSum + bData(lCount)
    Next lArrayCount
    
    '// Setup the check sum
    bData(lCount + 1) = ((lSum Xor 255) + 1) And 255
    
    '// Transmit the data and return success
    Comm.Output = bData '// Set the reset message


End Sub

Public Property Get MonitorOn() As Boolean
    MonitorOn = mMonitorOn
End Property

Public Property Let MonitorOn(ByVal vNewValue As Boolean)
   
    
    If mMonitorOn Then  '// we are already in monitor mode
        If vNewValue Then
            '// we are already on - do nothing
        Else
            
            If m_bRunMultiThreaded Then
                obTimer.StopTimer = True
                'Set obTimer = Nothing
                
            End If
            Call DeleteCriticalSection(mCriticalSection)
            Comm.Output = "M0" & vbCr    '// Send command off
            mMonitorOn = False
             
            
        End If
    Else
        If vNewValue Then
            TXFIFO.Init
            lMessageCount = 0
            Comm.Output = "M" & Trim$(str$(m_def_MonitorMode)) & vbCr    '// Send command on
            mMonitorOn = True
            ReDim bDataUsed(1 To 2000)  '// setup the serial cache
            ReDim bOldData(1 To 2000)   '//
            lNumberOfBytesOld = 0       '// reset the old byte counter
            
            Call InitializeCriticalSection(mCriticalSection)
            
            If m_bRunMultiThreaded Then
                If obTimer Is Nothing Then
                    Set obTimer = New cMMTime
                End If
                obTimer.Interval = 100
                obTimer.Resolution = obTimer.MinTimerResolutionMS
                
            End If
            
        Else
            '// we are alreay off - do nothing
        End If
    End If
End Property


Public Property Get PortOpen() As Boolean
    PortOpen = mPortOpen
End Property

Public Property Let PortOpen(ByVal vNewValue As Boolean)
    If mPortOpen Then  '// we are already in monitor mode
        If vNewValue Then
            '// we are already on - do nothing
        Else
            If mMonitorOn Then MonitorOn = False   '// Turn off monitor mode if on
            Comm.PortOpen = False
            mPortOpen = False
        End If
    Else
        If vNewValue Then
            With Comm
                .Handshaking = comNone
                .DTREnable = False
                .RTSEnable = True
                .InputMode = comInputModeBinary
                '.Settings = BaudRate & ",n,8,2"
                .Settings = 28800 & ",n,8,2"
                .PortOpen = True
            End With
            If Reset Then   '// Reset the hardware
                mPortOpen = True
            Else
                Comm.PortOpen = False
                mPortOpen = False
            End If
        Else
            '// we are alreay off - do nothing
        End If
    End If
End Property


Private Function WaitForBytes(lLength As Long, lTimeOutMS As Long) As Boolean

Dim StartTime As Long
Dim bTimeOut As Boolean
Dim bDone As Boolean


StartTime = timeGetTime
Do
    bTimeOut = (Abs(timeGetTime - StartTime) > lTimeOutMS)
    bDone = CLng(Comm.InBufferCount) >= lLength
Loop Until bTimeOut Or bDone

WaitForBytes = Not bTimeOut

End Function

Private Function FindFX(vBytes As Variant, lNumBytes As Long, lIndex As Long) As Boolean
    Dim lCount As Long
    
    '// Find first byte greater the hex &hF0
    For lCount = 0 To lNumBytes - 1
        If vBytes(lCount) > &HF0 Then
            FindFX = True
            lIndex = lCount
            Exit Function
        End If
    Next lCount
    
End Function

'// This method resets the VSI by toggling
Public Function Reset() As Boolean

    Dim sString As String

    '// Pull DTR low for 100mS
    Comm.DTREnable = True
    Call WaitMs(100)

    Comm.DTREnable = False
    '// Wait another 100mS to reset
    Call WaitMs(100)

    '// Set up for pin to connect DLC //////
    sString = Comm.Input    '// Clear comm port
    Comm.Output = ("C" & Trim$(str$(m_DLCConnection)) & vbCr)
    If Not WaitForBytes(1, 1000) Then
        LastErrorMessage = ERR_NO_RESPONSE
        Reset = False
        Exit Function
    Else
        If Comm.InBufferCount <> 1 Then
            LastErrorMessage = ERR_CONNECT_DLC_TO_ALDL
            Reset = False
            Exit Function
        End If
    End If

    '// Clear the buffer on the VSI /////////////////////
    sString = Comm.Input    '// Clear comm port
    Comm.Output = ("CB" & vbCr)
    If Not WaitForBytes(1, 1000) Then
        LastErrorMessage = ERR_NO_RESPONSE
        Reset = False
        Exit Function
    End If
    
    '// Set the DLC Baud Rate ///////////////////////////
    sString = Comm.Input    '// Clear comm port
    Comm.Output = ("I" & Trim$(str$(m_DLCBaudRate)) & vbCr)
    If Not WaitForBytes(1, 1000) Then
        LastErrorMessage = ERR_NO_RESPONSE
        Reset = False
        Exit Function
    End If
    
    '// Set the analog input stuff
    If UseAnalogInputs Then
        sString = Comm.Input
        Comm.Output = "A" & Chr(&H80 + 40) & vbCr   '// update analog outputs every 250mS
        If Not WaitForBytes(1, 1000) Then
            LastErrorMessage = ERR_NO_RESPONSE
            Reset = False
            Exit Function
        End If
    End If
    
    Reset = True

End Function

