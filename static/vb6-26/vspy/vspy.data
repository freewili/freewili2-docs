Attribute VB_Name = "frmIncomingEquation"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit


Public Expression As String
Public OkPressed As Boolean
Public IsDigital As Boolean


Private Sub cmdAddAI_Click()
    Call ctlUserExpression1.InsertText(lstAnalogInputs)
End Sub

Private Sub cmdAddConvert_Click()
    Call ctlUserExpression1.InsertText(txtNumber)
End Sub

Private Sub CmdCancel_Click()
    Me.Hide
End Sub

Private Sub CmdOk_Click()
    OkPressed = True
    Expression = ctlUserExpression1.Expression
    Me.Hide
End Sub

Private Sub cmdTestExpression_Click()
    Dim Bytes As icsSpyMessageLong
    Dim Value As Double
    If ParseExpression(True, ctlUserExpression1.Expression, Value, Bytes, False, 0) Then
        If IsDigital Then
            MsgBox "The result is " & CBool(Value)       '// Set up the result
        Else
            MsgBox "The result is " & Value       '// Set up the result
        End If
    Else
        MsgBox "Error in the expression, Please fix.", vbInformation
    End If
End Sub

Public Sub SetupUI()
    OkPressed = False
    ctlUserExpression1.Expression = Expression
End Sub

Private Sub cmdToAscii_Click()
    On Error Resume Next
    txtNumber = Format$(Asc(txtNumber))
End Sub

Private Sub Form_Load()
    Dim iNumItems As Integer
    Dim iCount As Integer
    
    ''// Fill the list with the analog items
    For iCount = 1 To 8
        lstAnalogInputs.AddItem "{B" & iCount & "}"
    Next iCount
    lstAnalogInputs.AddItem "{PT}"
    lstAnalogInputs.AddItem "{TRGT}"
    lstAnalogInputs.AddItem "{SRC}"
    lstAnalogInputs.AddItem "{VALUE}"
    lstAnalogInputs.AddItem "{ARB ID}"
    lstAnalogInputs.AddItem "{RMT}"
    lstAnalogInputs.AddItem "{ERR/STATUS}"
    lstAnalogInputs.ListIndex = 0
End Sub


Private Sub cmdToDecimal_Click()
    On Error Resume Next
    txtNumber = Format(Val("&H" & txtNumber))
End Sub

Private Sub cmdToHex_Click()
    On Error Resume Next
    txtNumber = Hex(Val(txtNumber))
End Sub

