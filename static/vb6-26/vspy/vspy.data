Attribute VB_Name = "frmEnterClassID"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

'// hardware setup form
Public frm As frmOptions

Private Sub cmdCancel_Click()
    Unload Me
End Sub

Private Sub cmdOk_Click()
    frm.ClassIDCanceled = False
    frm.ClassIDEntered = txtClassID
    Unload Me
End Sub

Private Sub Form_Load()
    With lstHardwareObjects
        .AddItem "National Instruments DAQ (Plug in DAQ boards)"
        .AddItem "Port IO parallel port or 82C55 for Win 9X"
        .AddItem "Connectix QuickCam Video Driver"
        .AddItem "National Instruments DAQMeter 435X"
        .AddItem "DAQ Plugin Analog Parallel"
        .AddItem "Tektronix TDS Series Scope (GPIB)"
        .AddItem "ICS Vehicle Spy"
    End With
End Sub

Private Sub Form_QueryUnload(Cancel As Integer, UnloadMode As Integer)
    Set frm = Nothing
End Sub

Private Sub lstHardwareObjects_Click()
    Select Case lstHardwareObjects.ListIndex
        Case 0 ' NIDAQ
            txtClassID = "dllNIHardware.cNIHardware"
        Case 1 ' Port IO parallel port
            txtClassID = "cicsrtPortIO.cPortIO"
        Case 2 ' Connectix quickcam video driver
            txtClassID = "icsQuickCam.Hardware"
        Case 3 ' DAQMeter 435X
            txtClassID = "icsrtNIDAQMeter.cNIMeter435X"
        Case 4 ' DAQ Plugin Analog Parallel
            txtClassID = "icsrtNIDAQParallel.cNIDAQParallel"
        Case 5 ' Tektronix TDS Series Scope
            txtClassID = "icsrtTDSO.cTDSScope"
        Case 6 ' ICS Vehicle Spy
            txtClassID = "icsspyObjects.cicsSpy"
    End Select
End Sub
