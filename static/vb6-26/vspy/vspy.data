'// This property gets/sets the value of the message. This will return a different type
'// based on the value type property
Public Property Get Value() As Variant
Attribute Value.VB_Description = "This property gets/sets the value of the message. This will return a different type based on the value type property."
Attribute Value.VB_UserMemId = 0
    
    Select Case MyData.mvarValueType
        Case icsVSPYAnalogInput
            Value = MyData.mvarValue
            
        Case icsVSPYDigitalInput
            Value = CBool(MyData.mvarValue)
        Case Else
            Value = "n/a"   '// this case the value type is nothing, so return "n/a"
    End Select

End Property


Public Property Let Value(ByVal vNewValue As Variant)
    Dim dTempValue As Double
    
    dTempValue = CDbl(vNewValue)
    
    If MyData.mvarValue <> dTempValue Then
        MyData.mvarValue = dTempValue
        mUpdateScreen = True
        
        '// update the main object value cache
        If Not (Parent Is Nothing) Then
            '// set the cache value
            If Parent.MonitorOn Then
                Parent.IncomingMessageValue(InputIndex) = MyData.mvarValue
            End If
        End If
        
        '// signal the event
        RaiseEvent ValueChanged(MyData.mvarValue)
    
    End If
    
End Property
'//////////////////////////////////////////////////////////////////////////////////////////

'// Returns/Sets the description for this message.
Public Property Let Description(ByVal sData As String)
    If MyData.mvarDescription <> sData Then
        MyData.mvarDescription = sData
        mUpdateScreen = True
    End If
End Property
Public Property Get Description() As String
    Description = MyData.mvarDescription
End Property
