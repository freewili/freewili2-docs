Attribute VB_Name = "frmAuthorization"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit


Sub cmdAuthorize_Click()
    
    

End Sub



Sub cmdTransferOut_Click()
    If Not IsAuthorizedForLevel(nDecrement:=0) Then
        MsgBox "This program is NOT authorized yet!", vbCritical, "Crypkey"
        Exit Sub
    End If
    If Not TransferOutAuth("A:\") Then
        MsgBox ErrorMsg, vbCritical, "Crypkey"
        Exit Sub
    End If
    MsgBox "Transferred Authorization out successfully. Insert this diskette into target computer and transfer in this new authorization.", vbInformation, "Crypkey"
    AppIsAuthorized = False
    
End Sub




Sub Form_Load()
    
    Dim sSiteCode As String
    Dim i%
    
    sSiteCode = SiteCode
    If sSiteCode = "" Or ErrorNum <> 0 Then
        psMsg = ErrorMsg
        MsgBox psMsg, vbCritical
        psMsg = ""
        Exit Sub
    End If
    Me.txtSiteCode = sSiteCode
    Me.txtSiteKey = ""
    Me.cmdTransferStart.Enabled = Not AppIsAuthorized
    Me.cmdTransferOut.Enabled = AppIsAuthorized
    
    
End Sub






