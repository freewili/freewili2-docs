Attribute VB_Name = "frmPerformance"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public WithEvents obApp As cicsSpy
Attribute obApp.VB_VarHelpID = -1


Private Sub cmdResetDisplayUpdate_Click()
    obApp.Performance.ResetDisplayUpdateRate
    obApp_UpdateScrollingArea
End Sub

Private Sub cmdResetPollEngine_Click()
    obApp.Performance.ResetPollIntervalMs
    obApp_UpdateScrollingArea
End Sub

Private Sub Form_Load()
    obApp_UpdateScrollingArea
End Sub

Private Sub Form_QueryUnload(Cancel As Integer, UnloadMode As Integer)
    Set obApp = Nothing
End Sub

Private Sub obApp_UpdateScrollingArea()
    With obApp.Performance
        lblDisplayUpdateTime(0) = .DisplayUpdateRateMs
        lblDisplayUpdateTime(1) = .DisplayUpdateRateMean
        lblDisplayUpdateTime(2) = .DisplayUpdateRateMax
        lblDisplayUpdateTime(3) = .DisplayUpdateRateMin
        
        lblPollEngine(0) = .PollIntervalMs
        lblPollEngine(1) = .PollIntervalMsMean
        lblPollEngine(2) = .PollIntervalMsMax
        lblPollEngine(3) = .PollIntervalMsMin
    End With
End Sub

Private Sub tmrUpdate_Timer()
    obApp_UpdateScrollingArea
End Sub
