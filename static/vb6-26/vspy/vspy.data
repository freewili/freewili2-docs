Attribute VB_Name = "frmOutgoingEquation"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public obApp As cicsSpy
Public sOutgoingKey  As String               '// index of the equation we are editing
Public lByte As Long

Private Sub cmdAddMessage_Click()
    ctlUserExpression1.InsertText ("{" & lstMessages.List(lstMessages.ListIndex) & "}")
End Sub

Private Sub CmdCancel_Click()
    Unload Me
End Sub


Private Sub cmdHelp_Click()
End Sub

Private Sub CmdOk_Click()
    obApp.OutgoingMessages(sOutgoingKey).ByteString(lByte) = "=" & ctlUserExpression1.Expression
    obApp.App.SaveNeeded = True
    Unload Me
End Sub

Private Sub cmdTestExpression_Click()
    Dim Bytes As icsSpyMessageLong
    Dim Value As Double
    Dim sResultText As String
    Dim sErrorInExpressionText As String
    
    If ParseExpressionForAnalogItems(obApp, True, ctlUserExpression1.Expression, Value, 0#) Then
        sResultText = LoadResString(148)
        MsgBox sResultText & " : " & Value       '// Set up the result
    Else
        sErrorInExpressionText = LoadResString(149)
        MsgBox sErrorInExpressionText, vbInformation
    End If
End Sub

'// This sub sets up the user interface
Public Sub SetupUI()
    Dim sTemp As String
    Dim lNumItems As Long
    Dim lCount As Long
    Dim obIn As cIncomingMessage
    Dim obOut As cOutgoingMessage
    Dim sDescription As String
    Dim sNew As String
    
    '// Remove the leader "=" sign
    sTemp = obApp.OutgoingMessages(sOutgoingKey).ByteString(lByte)
    If Len(sTemp) > 1 Then
        Call ChangeExpressionAnalogItems(obApp, False, Right$(sTemp, Len(sTemp) - 1), sNew)
        ctlUserExpression1.Expression = sNew
    End If
    
    '// add the default
    lstMessages.AddItem "My Value"
    
    '// Now add them to the list
    lCount = 0
    For Each obIn In obApp.IncomingMessages
        lCount = lCount + 1
        sDescription = obIn.Description
        If Len(sDescription) = 0 Then
            sDescription = "Unnamed In Message " & lCount
        End If
        lstMessages.AddItem sDescription & " :" & obIn.Key
    Next obIn
    
    '// Now add them to the list
    lCount = 0
    For Each obOut In obApp.OutgoingMessages
        lCount = lCount + 1
        sDescription = obOut.Description
        If Len(sDescription) = 0 Then
            sDescription = "Unnamed Out Message " & lCount
        End If
        lstMessages.AddItem sDescription & " :" & obOut.Key
    Next obOut
        
    '// set to the first item in the list
    lstMessages.ListIndex = 0
End Sub



Private Sub Form_Load()
    Caption = LoadResString(142)
    lblMessageCaption = LoadResString(143)
    cmdAddMessage.Caption = LoadResString(144)
    cmdTestExpression.Caption = LoadResString(145)
    CmdOk.Caption = LoadResString(147)
End Sub
