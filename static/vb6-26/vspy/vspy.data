'// function used to wait a specific period of time
Private Function WaitMs(ByVal lMs As Long)
    Dim StartTime As Long
    StartTime = timeGetTime
    Do
    Loop Until Abs(timeGetTime - StartTime) > lMs
End Function

Private Sub Class_Initialize()
    m_DLCBaudRate = m_def_DLCBaudRate
    m_BaudRate = m_def_BaudRate
    m_MonitorMode = m_def_MonitorMode
    m_DLCConnection = m_def_DLCConnection
End Sub

Private Sub Class_Terminate()
    If mPortOpen Then PortOpen = False
End Sub

Public Sub ReadSerialPort()

    Dim lNumberOfBytes As Long
    Dim lCount As Long
    Dim lNumMessageBytes As Long
    Dim lNumMessageBytesPlusCC As Long
    Dim lMessageByteCount As Long
    Dim lTotalBytes As Long
    Dim bCount As Long
    Dim lLastValidIndex As Long
    Dim ReadTime As Long
    Dim LastTime As Long
    Dim MessageBytes() As Byte
    Dim msg As icsSpyMessageJ1850
    Dim txmsg As icsSpyMessageJ1850
    Dim bStatusByte As Byte
    Dim lSum As Long

    
    Const NUMBER_OF_TIMEBYTES_AND_CHKSUM = 3
    
    lNumberOfBytes = 0
    
    '// Read the comm port
    If Comm.InBufferCount > 0 Then
        bNewData() = Comm.Input
        ReadTime = timeGetTime
        lNumberOfBytes = UBound(bNewData) + 1 '// How many bytes were in the comm port
        'Debug.Print "read data"
    Else
        Exit Sub
    End If
    
    If lNumberOfBytes > 0 Then
        
        '// do we have new data
        lLastValidIndex = 1 '// initalize to 1
        lTotalBytes = lNumberOfBytes + lNumberOfBytesOld
        
        '// redim only if necessary
        If lTotalBytes > 2000 Then
            ReDim bDataUsed(lTotalBytes)
        End If
        
        If lNumberOfBytesOld <> 0 Then
            CopyData bOldData(1), bDataUsed(1), lNumberOfBytesOld
        End If
        CopyData bNewData(0), bDataUsed(lNumberOfBytesOld + 1), lNumberOfBytes
        
        '// Look for the first char with a upper nibble of F
        lCount = 0
        Do
            lCount = lCount + 1
            
            '// if the lower nibble
            If bDataUsed(lCount) >= &HF0 Then
                
                
                '// the number of data bytes is encoded in the lower nibble
                lNumMessageBytesPlusCC = bDataUsed(lCount) And &HF
                
                '// is this entire message present is the serial read (if it is a message)
                If (lCount + lNumMessageBytesPlusCC + NUMBER_OF_TIMEBYTES_AND_CHKSUM) <= lTotalBytes Then
                
                        '// the next byte should be 0 if we had a good message
                        '// it is the completion code appended by the DLC
                        lSum = 0 '// clear the checksum value
                        
                        bStatusByte = bDataUsed(lCount + lNumMessageBytesPlusCC)
                        msg.TimeSystem = ReadTime   '// set this messages read time
                        lNumMessageBytes = lNumMessageBytesPlusCC - 1
                        
                        '// Determine the number of header and data bytes
                        Select Case bStatusByte
                            Case 0
                                msg.StatusBitField = VSI_REC_MSG_BITFIELD
                            Case 48
                                msg.StatusBitField = VSI_TX_MSG_BITFIELD
                                If TXFIFO.PopItem(txmsg) Then
                                    msg.DescriptionID = txmsg.DescriptionID
                                Else
                                    TXFIFO.Init '// clear the fifo
                                End If
                            Case Else
                                msg.StatusBitField = icsSpyStatusGlobalError
                                TXFIFO.Init '// clear the fifo
                                If (bStatusByte And 128) > 0 Then
                                    '// the error bit is set
                                    Select Case (bStatusByte And 3) '// clear all but the lower 2 bits
                                        Case 0 '// CRC Error
                                           msg.StatusBitField = msg.StatusBitField + icsSpyStatusErrCRCError
                                        Case 1 '// Incomplete Byte
                                           msg.StatusBitField = msg.StatusBitField + icsSpyStatusErrIncompleteFrame
                                        Case 2 '// Bit Timing Error
                                           msg.StatusBitField = msg.StatusBitField + icsSpyStatusErrBadMessageBitTimeError
                                        Case 3 '// Break
                                            msg.StatusBitField = msg.StatusBitField + icsSpyStatusBreak
                                    End Select
                                End If
                                If (bStatusByte And 64) > 0 Then '// Receive FIFO overrun bit
                                    msg.StatusBitField = msg.StatusBitField + icsSpyStatusAVT_VSIRecOverflow
                                End If
                                If (bStatusByte And 8) > 0 Then '// IFR data
                                    msg.StatusBitField = msg.StatusBitField + icsSpyStatusIFRData
                                End If
                                If (bStatusByte And 4) > 0 Then '// IFR data CRC
                                    msg.StatusBitField = msg.StatusBitField + icsSpyStatusVSI_IFR_CRCBit
                                End If
                                If (bStatusByte And 16) > 0 Then '// Transmitter Underrun
                                    msg.StatusBitField = msg.StatusBitField + icsSpyStatusVSI_TxUnderRun
                                ElseIf (bStatusByte And 32) Then '// Lost arbitration
                                    msg.StatusBitField = msg.StatusBitField + icsSpyStatusErrLostArbitration
                                End If
                                
                        End Select
                        
                        If lNumMessageBytes - 3 > 0 Then
                            '// there is larger than a 3 byte header
                            msg.NumberBytesData = lNumMessageBytes - 3
                            If msg.NumberBytesData > 8 Then msg.NumberBytesData = 8
                        Else
                            msg.NumberBytesData = 0
                        End If
                        
                        
                        If lNumMessageBytes > 0 Then
                            If lNumMessageBytes > 3 Then
                                msg.NumberBytesHeader = 3
                            Else
                                msg.NumberBytesHeader = lNumMessageBytes
                            End If
                        Else
                            msg.NumberBytesHeader = 0
                        End If
                        
                        '// Copy the header bytes
                        For lMessageByteCount = 1 To msg.NumberBytesHeader
                             msg.Header(lMessageByteCount) = bDataUsed(lCount + lMessageByteCount)
                             lSum = lSum + msg.Header(lMessageByteCount)
                        Next lMessageByteCount
                        
                        '// Copy the data bytes
                        If msg.NumberBytesData < 9 Then
                            For lMessageByteCount = 1 To msg.NumberBytesData
                                 msg.data(lMessageByteCount) = bDataUsed(lCount + lMessageByteCount + msg.NumberBytesHeader)
                                lSum = lSum + msg.data(lMessageByteCount)
                            Next lMessageByteCount
                        End If
                        
                        '// Setup the hardware time
                        'Call CopyData(bDataUsed(lCount + lNumMessageBytesPlusCC + 1), ByVal (VarPtr(msg.TimeHardware) + 2), 2)
                        msg.TimeHardware = CLng(bDataUsed(lCount + lNumMessageBytesPlusCC + 1)) * 256 + CLng(bDataUsed(lCount + lNumMessageBytesPlusCC + 2))
                        
                        '// verify the checksum
                        lSum = lSum + bDataUsed(lCount) + bDataUsed(lCount + lNumMessageBytesPlusCC) + bDataUsed(lCount + lNumMessageBytesPlusCC + 1) + bDataUsed(lCount + lNumMessageBytesPlusCC + 2)
                        
                        If bDataUsed(lCount + lNumMessageBytesPlusCC + 3) = (((lSum Xor 255) + 1) And 255) Then
                            '// Send the data to the servers
                            Call EnterCriticalSection(mCriticalSection)
                            lMessageCount = lMessageCount + 1
                            LSet VSpyMessages(lMessageCount) = msg
                            Call LeaveCriticalSection(mCriticalSection)
                        Else
                            msg.StatusBitField = msg.StatusBitField Or (icsSpyStatusGlobalError + icsSpyStatusCheckSumError)
                            Call EnterCriticalSection(mCriticalSection)
                            lMessageCount = lMessageCount + 1
                            LSet VSpyMessages(lMessageCount) = msg
                            Call LeaveCriticalSection(mCriticalSection)
                        End If
                        
                        lCount = lCount + lNumMessageBytesPlusCC + NUMBER_OF_TIMEBYTES_AND_CHKSUM
                        lLastValidIndex = lCount + 1
                Else
                    lCount = lTotalBytes
                    'Debug.Print "total problem"
                End If
            
            ElseIf bDataUsed(lCount) = &HE8 Then
                
                
                '// is the entire analog value present
                If (lCount + 11) <= lTotalBytes Then
                    '// there is enough data
                    '// its analog data
                    'Debug.Print "analog data " & bDataUsed(lCount + 1)
                    
                    '// change the count
                    lCount = lCount + 12
                    lLastValidIndex = lCount
                Else
                    lCount = lTotalBytes
                End If
            Else
                If bDataUsed(lCount) <> Asc(vbCr) Then
                    '// THIS IS ERROR data
                    msg.TimeSystem = ReadTime   '// set this messages read time
                    msg.NumberBytesData = 0
                    msg.NumberBytesHeader = 1
                    msg.Header(1) = bDataUsed(lCount)
                    msg.StatusBitField = icsSpyStatusGlobalError
                    lMessageCount = lMessageCount + 1
                    LSet VSpyMessages(lMessageCount) = msg
                End If
            End If '
            
        Loop Until lCount >= lTotalBytes
        
        '// How many bytes do we have left over
        lNumberOfBytesOld = lTotalBytes - lLastValidIndex + 1
        If lNumberOfBytesOld > 0 Then
            If lNumberOfBytesOld > 2000 Then
                ReDim bOldData(lNumberOfBytesOld)
            End If
            CopyData bDataUsed(lLastValidIndex), bOldData(1), lNumberOfBytesOld
        End If
    
    End If

End Sub


Public Function ReadMessagesJ1850(stVSPYMessages() As icsspyHardware.icsSpyMessageJ1850, lNumberOfMessages As Long) As Boolean
    Dim lCount As Long
    
    If m_bRunMultiThreaded Then
        If Not obTimer.Enabled = True Then obTimer.Enabled = True
        '// enter critical Call EnterCriticalSection(lpCr)
        Call EnterCriticalSection(mCriticalSection)
        For lCount = 1 To lNumberOfMessages
            VSpyMessagesCopy(lCount) = VSpyMessages(lCount)
        Next lCount
        lNumberOfMessages = lMessageCount
        Call LeaveCriticalSection(mCriticalSection)
        '// end critcal
        
        stVSPYMessages = VSpyMessagesCopy
        lMessageCount = 0                               '// reset the message count
        ReadMessagesJ1850 = True  '// return success
    Else
        ReadSerialPort
        '// return the messages
        stVSPYMessages = VSpyMessages
        lNumberOfMessages = lMessageCount
        lMessageCount = 0                               '// reset the message count
        ReadMessagesJ1850 = True  '// return success
    End If
    
End Function

Private Sub obTimer_Timer()
    ReadSerialPort
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cVoiceRecognition"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Option Explicit

'// this class is a wrapper over the microsoft speech api (ver 4.0)
'// copyright 1998 intrepid control systems inc


'// Initialize the text to speech e
Public WithEvents obTextToSpeech As TextToSpeech
Attribute obTextToSpeech.VB_VarHelpID = -1


Private WithEvents mObCommand As Vcommand
Attribute mObCommand.VB_VarHelpID = -1

Public Event CommandEntered(sCommand As String)



'// status variables
Private bCurrentlyActivated As Boolean
Private lCurrentMenu As Long
Private bMenuEntered As Boolean

Friend Property Set obCommand(obNew As Vcommand)
    If obNew Is Nothing Then
        If bMenuEntered Then
            If Not (mObCommand Is Nothing) Then
                mObCommand.ReleaseMenu lCurrentMenu    '// deactive the engine
                bMenuEntered = False
            End If
        End If
        Set mObCommand = Nothing
    Else
        Set mObCommand = obNew
    End If
End Property

Friend Property Get obCommand() As Vcommand
    Set obCommand = mObCommand
End Property
'

Public Property Get IsSpeaking() As Boolean
    If obTextToSpeech.Speaking = 1 Then
        IsSpeaking = True '// the command is currently speaking
    Else
        IsSpeaking = False
    End If
End Property

Public Sub Speak(ByVal sText As String)
    On Error Resume Next
'    If bCurrentlyActivated Then
'        mObCommand.Deactivate lCurrentMenu
'        bCurrentlyActivated = False
'    End If
    Call obTextToSpeech.Speak(sText)
    
    If Err.Number <> 0 Then
        Debug.Print "Error description: " & Err.Description
    End If
End Sub

Public Function InitVoiceCommands() As Boolean

    On Error GoTo InitVoiceCommandsError
    
    Dim lEngine As Long
    Dim lVoice As Long
    
    
    '// Now load the synthesizer, find and select any female voice from microsoft
    lVoice = obTextToSpeech.Find("MfgName=Microsoft;Gender=1")
    obTextToSpeech.Select lVoice
    
    
    '// Initialize the recognizer. We want command and control, so find and select that engine (or best match)
    mObCommand.Initialized = 1
    
    'lEngine = mObCommand.Find("MfgName=Microsoft;Grammars=1")
    'mObCommand.Select lEngine
    
    '// create the initial command window
    mObCommand.Enabled = 1
    lCurrentMenu = mObCommand.MenuCreate("ICS Vehicle Spy", "Main", 4)
    bMenuEntered = True
    mObCommand.AddCommand lCurrentMenu, 1, "Go Vehicle Spy", "When you say " + "go vehicle spy ICS Vehicle Spy will start monitoring the vehicle network.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Stop Vehicle Spy", "When you say " + "stop vehicle spy ICS Vehicle Spy will start monitoring the vehicle network.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Enter Audio Comment", "When you say " + "enter audio comment ICS Vehicle Spy will allow you to enter an audio comment.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Toggle Timestamp", "When you say " + "Toggle Timestamp ICS Vehicle Spy will change the time stamp of the monitor data.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Transmit <Message>", "When you say " + "Transmit <Message> ICS Vehicle Spy will transimit message named <Message>.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Test Trigger <Test>", "When you say " + "Test Trigger <Test> ICS Vehicle Spy will trigger test named <Test>.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Test View <Test>", "When you say " + "Test View <Test> ICS Vehicle Spy will show the buffer for test named <Test>.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Test Save <Test>", "When you say " + "Test Save <Test> ICS Vehicle Spy will save the test named <Test> buffer.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Test Stop <Test>", "When you say " + "Test Stop <Test> ICS Vehicle Spy will stop the test named <Test>.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Test Start <Test>", "When you say " + "Test Start <Test> ICS Vehicle Spy will start the test named <Test>.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Toggle View", "When you say " + "Toggle View ICS Vehicle Spy will toggle between text and graphical views.", "", 0, ""
    mObCommand.AddCommand lCurrentMenu, 1, "Save Monitor Buffer", "When you say " + "Save Monitor Buffer ICS Vehicle Spy will save the data in the buffer to the data directory.", "", 0, ""
    
    
    mObCommand.Activate lCurrentMenu
    bCurrentlyActivated = True
    

    '// return true
    InitVoiceCommands = False
    
    
    Exit Function
    
InitVoiceCommandsError:
    
    Debug.Print "Error description: " & Err.Description
    
    
    '// return false
    InitVoiceCommands = False

End Function

Public Function ListSet(sListName As String, lNumberOfListItems As Long, sList As String) As Boolean

On Error GoTo listseterror

'call the list set command
mObCommand.ListSet lCurrentMenu, sListName, lNumberOfListItems, sList

Exit Function
listseterror:

ListSet = False



End Function

Private Sub Class_Terminate()
    If bMenuEntered Then
        If Not (mObCommand Is Nothing) Then
            mObCommand.ReleaseMenu lCurrentMenu    '// deactive the engine
            bMenuEntered = False
        End If
    End If
    bCurrentlyActivated = False
End Sub
Public Sub ShowGeneralDialog(ByVal hwnd As Long)
    Call obTextToSpeech.GeneralDlg(hwnd, "Setup Speech Engine")
    'Call mObCommand.TrainPhrasesDlg(hWnd, "Setup microphone")
End Sub




Public Property Get VoiceRecEnabled() As Boolean
    VoiceRecEnabled = bCurrentlyActivated
End Property

Public Property Let VoiceRecEnabled(bNew As Boolean)
    
    If bNew Then
        '// activate the voice if deactivated
        If Not bCurrentlyActivated Then
            mObCommand.Activate lCurrentMenu
            bCurrentlyActivated = True
        End If
    Else
        '// deactivate the voice if activated
        If bCurrentlyActivated Then
            mObCommand.Deactivate lCurrentMenu
            bCurrentlyActivated = False
        End If
    End If
    
    
End Property


Private Sub mObCommand_CommandRecognize(ByVal ID As Long, ByVal CmdName As String, _
    ByVal Flags As Long, ByVal Action As String, ByVal NumLists As Long, _
        ByVal ListValues As String, ByVal command As String)
 
    RaiseEvent CommandEntered(LCase(command))
    
    Debug.Print "spoke " & command
    
End Sub





Private Sub obTextToSpeech_SpeakingDone()
 '// restart rec engine
    If Not bCurrentlyActivated Then
        If Not (mObCommand Is Nothing) Then
            mObCommand.Activate lCurrentMenu
        End If
        bCurrentlyActivated = True
    End If
End Sub

Private Sub obTextToSpeech_SpeakingStarted()
    If bCurrentlyActivated Then
        If Not (mObCommand Is Nothing) Then
            mObCommand.Deactivate lCurrentMenu
        End If
        bCurrentlyActivated = False
    End If
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
  Persistable = 0  'NotPersistable
  DataBindingBehavior = 0  'vbNone
  DataSourceBehavior  = 0  'vbNone
  MTSTransactionMode  = 0  'NotAnMTSObject
END
Attribute VB_Name = "cicsLogBook"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Option Explicit

Public Enabled As Boolean
Public LogBookDirectory As String

Public LogBookPath As String
Public CommentLogPath As String
Public HeaderFilePath As String
Public CompiledFilePath As String
Public TestLogPath As String




'// Keeps count of comment types
Private lTextCommentCount As Long   '// counts the number of text comments
Private lAudioCommentCount As Long  '// counts the number of audio comments

Public Sub CompileLogBook()
    Dim sHelpCompilerPath As String     '// path to the help file
    Dim sErrorMsg As String
    
    '// first verify that the HTML compiler exists
    sErrorMsg = "There was a problem locating the HTML help compiler. If it is installed, please enter the location of file ""hhc.exe"". Follow the steps to find it otherwise press cancel." & vbCrLf & vbCrLf
    sErrorMsg = sErrorMsg & "1) Choose find files from the Windows start menu." & vbCrLf
    sErrorMsg = sErrorMsg & "2) Enter ""hhc.exe"" for the name and select your windows harddisk (usually C:\)." & vbCrLf
    sErrorMsg = sErrorMsg & "3) Click Find Now." & vbCrLf
    sErrorMsg = sErrorMsg & "4) If it appears, right click and select properties. It will indicate where its located. If it doesn't appear it is not installed." & vbCrLf
    sErrorMsg = sErrorMsg & "5) Enter the full path in to the box below (example ""C:\Program Files\HTML Help Workshop\hhc.exe"")." & vbCrLf
    
    '// get the path from the registry
    sHelpCompilerPath = GetSetting("icsVSpy", "Defaults", "HelpCompilerPath", "C:\Program Files\HTML Help Workshop\hhc.exe")
     
    '// Verify its there
    If Not FileExists(sHelpCompilerPath) Then
        '// prompt the user for the actual path
        sHelpCompilerPath = InputBox(sErrorMsg, "Problem locating help compiler")
        If Trim$(sHelpCompilerPath = "") Then
            Exit Sub
        End If
        If FileExists(sHelpCompilerPath) Then
            Call SaveSetting("icsVSpy", "Defaults", "HelpCompilerPath", sHelpCompilerPath)
        Else
            MsgBox "The filepath: { " & sHelpCompilerPath & " } could not be located - still! Aborting LogBook compilation.", vbInformation
            Exit Sub
        End If
    End If
    
    
    '// compile the helpfile
    Call ExecuteAndWait(sHelpCompilerPath, GetShortName(CompiledFilePath), True)
    
End Sub

Public Sub CreateLogBook()
    Dim sUrl As String
    Dim sDataDirectoryPath As String
    
    
    
    Dim lFileNum As Long
    
    lFileNum = FreeFile
    
    '// create the data directory
    sDataDirectoryPath = App.Path & "\Data Directory"
    
    '// create the data directory if necessary
    Call CreateDirectoryIfNotExists(sDataDirectoryPath)
    
    '// create logpath directory
    LogBookDirectory = sDataDirectoryPath & "\LogBook " & Format(Now, "mm-dd-yyyy hh-mm-ss am/pm")
    
     '// create the log book directory
    Call CreateDirectoryIfNotExists(LogBookDirectory)
    
    '// setup the main files
    LogBookPath = LogBookDirectory & "\index.htm"
    CommentLogPath = LogBookDirectory & "\comment.htm"
    HeaderFilePath = LogBookDirectory & "\header.htm"
    CompiledFilePath = LogBookDirectory & "\test.hhp"
    TestLogPath = LogBookDirectory & "\testlog.htm"
    
    Open CompiledFilePath For Output As #lFileNum
    Print #lFileNum, "[Options]"
    Print #lFileNum, "Compatibility = 1.1 Or later"
    Print #lFileNum, "Compiled file = Test.chm"
    Print #lFileNum, "Default topic = Index.htm"
    Print #lFileNum, "Display compile progress=No"
    Print #lFileNum, "Full-text search=Yes"
    Print #lFileNum, "Language=0x409 English (United States)"
    Print #lFileNum, "Title=Vehicle Spy Logbook"
    Print #lFileNum, ""
    Print #lFileNum, "[Files]"
    Print #lFileNum, "index.htm"
    Close #lFileNum
    
    '// first the frame set
    Open LogBookPath For Output As #lFileNum
    Print #lFileNum, "<HTML>"
    Print #lFileNum, "<HEAD><title>Vehicle Spy LogBook</title></HEAD>"
    Print #lFileNum, "<FRAMESET ROWS=""75,*"" BORDER=0>"
    Print #lFileNum, "<FRAME SRC=header.htm NAME=TOP >"
    Print #lFileNum, "<FRAME SRC=comment.htm NAME=BOTTOM>"
    Print #lFileNum, "</FRAMESET>"
    Print #lFileNum, "<NOFRAME>"
    Print #lFileNum, "<BODY>"
    Print #lFileNum, "This page requires a browser that supports frames."
    Print #lFileNum, "</BODY>"
    Print #lFileNum, "</NOFRAME>"
    Print #lFileNum, "</HTML>"
    Close #lFileNum
    
    '// now the header
    Open HeaderFilePath For Output As #lFileNum
    Print #lFileNum, "<HTML>"
    Print #lFileNum, "<title>Intrepid Control Systems Vehicle Spy Log File</title>"
    Print #lFileNum, "<head>"
    Print #lFileNum, "<meta name=""GENERATOR"" content=""Intrepid Control Systems Vehicle Spy V10"">"
    Print #lFileNum, "<table border=""0"" width=""100%"" height=""43"">"
    Print #lFileNum, "<tr>"
    Print #lFileNum, "<td width=""11%"" height=""39""><font FACE=""Arial"" SIZE=""3""><b><img src=""vspy.bmp"" width=""55"""
    Print #lFileNum, "height=""35"" alt=""vpsy""></b></font></td>"
    Print #lFileNum, "<td width=""89%"" height=""39""><font face=""Arial""><font SIZE=""3""><b>Vehicle Spy <i>LogBook</i></b></font>"
    Print #lFileNum, "&nbsp; <strong><small><small>(Recorded " & Format$(Now(), "Long Date") & " at " & Format$(Now(), "hh:mm:ss AM/PM") & ")</small></small></strong></font><br>"
    Print #lFileNum, "<a href=""comment.htm"" TARGET=""BOTTOM""><font FACE=""Arial"" SIZE=""1"">Comments</font></a>"
    Print #lFileNum, " - <a href=""testlog.htm"" TARGET=""BOTTOM""><font FACE=""Arial"" SIZE=""1"">Test Results</font></a>"
    Print #lFileNum, " - <a href=""testlog.htm"" TARGET=""BOTTOM""><font FACE=""Arial"" SIZE=""1"">User Buffers</font></a>"
    Print #lFileNum, " - <a href=""testlog.htm"" TARGET=""BOTTOM""><font FACE=""Arial"" SIZE=""1"">Test Events</font></a>"
    Print #lFileNum, " - <a href=""testlog.htm"" TARGET=""BOTTOM""><font FACE=""Arial"" SIZE=""1"">Buffer Statistics</font></a>"
    Print #lFileNum, " - <a href=""testlog.htm"" TARGET=""BOTTOM""><font FACE=""Arial"" SIZE=""1"">Setup Information</font></a>"
    Print #lFileNum, "</td></tr>"
    Print #lFileNum, "</table>"

    Print #lFileNum, "<script language=""JavaScript"">"
    Print #lFileNum, "<!--"
    Print #lFileNum, "function OpenInNewWindow(sURL)"
    Print #lFileNum, "{"
    Print #lFileNum, "wNewWindow = window.open(sURL,""DataFile"",""toolbar=yes,resizable=yes,menubar=yes,status=yes"");"
    Print #lFileNum, "}"
    Print #lFileNum, "// -->"
    Print #lFileNum, "</script>"
    Print #lFileNum, "</head>"
    Print #lFileNum, "<FONT FACE=""Arial"" SIZE=2>"
    Print #lFileNum, "<BODY LINK=""#0000ff"" VLINK=""#800080"" BGCOLOR=""#ffffff"">"
    Close #lFileNum
    
    '// now the comment log
    Open CommentLogPath For Output As #lFileNum
    Print #lFileNum, "<HTML>"
    Print #lFileNum, "<title>Vehicle Spy LogBook Comments</title>"
    Print #lFileNum, "<head>"
    Print #lFileNum, "<meta name=""GENERATOR"" content=""Intrepid Control Systems Vehicle Spy V10"">"
    Print #lFileNum, "<FONT FACE=""Arial"" SIZE=3><b>Vehicle Spy <i>LogBook Comment Log</i></b></FONT><p>"
    Print #lFileNum, "<script language=""JavaScript"">"
    Print #lFileNum, "<!--"
    Print #lFileNum, "function OpenInNewWindow(sURL)"
    Print #lFileNum, "{"
    Print #lFileNum, "wNewWindow = window.open(sURL,""DataFile"",""toolbar=yes,resizable=yes,menubar=yes,status=yes"");"
    Print #lFileNum, "}"
    Print #lFileNum, "// -->"
    Print #lFileNum, "</script>"
    Print #lFileNum, "</head>"
    Print #lFileNum, "<FONT FACE=""Arial"" SIZE=2>"
    Print #lFileNum, "<BODY LINK=""#0000ff"" VLINK=""#800080"" BGCOLOR=""#ffffff"">"
    Close #lFileNum
    
    '// now the comment log
    Open TestLogPath For Output As #lFileNum
    Print #lFileNum, "<HTML>"
    Print #lFileNum, "<title>Vehicle Spy LogBook Test records</title>"
    Print #lFileNum, "<head>"
    Print #lFileNum, "<meta name=""GENERATOR"" content=""Intrepid Control Systems Vehicle Spy V10"">"
    Print #lFileNum, "<FONT FACE=""Arial"" SIZE=3><b>Vehicle Spy <i>LogBook Test Log</i></b></FONT><p>"
    Print #lFileNum, "<script language=""JavaScript"">"
    Print #lFileNum, "<!--"
    Print #lFileNum, "function OpenInNewWindow(sURL)"
    Print #lFileNum, "{"
    Print #lFileNum, "wNewWindow = window.open(sURL,""DataFile"",""toolbar=yes,resizable=yes,menubar=yes,status=yes"");"
    Print #lFileNum, "}"
    Print #lFileNum, "// -->"
    Print #lFileNum, "</script>"
    Print #lFileNum, "</head>"
    Print #lFileNum, "<FONT FACE=""Arial"" SIZE=2>"
    Print #lFileNum, "<BODY LINK=""#0000ff"" VLINK=""#800080"" BGCOLOR=""#ffffff"">"
    Close #lFileNum
    
    '// write the log book pictures
    SavePicture frmLogBookPictures.pctVSPY.Picture, LogBookDirectory & "\vspy.bmp"
    Unload frmLogBookPictures
    Set frmLogBookPictures = Nothing
    
    
    
End Sub




Public Function AddTestHyperLinkToFile(sFilePath As String, _
            sFileDescriptionShort As String, sFileDescriptionLong, bOpenInNewWindow As Boolean)
    '
    Dim lFileNum As Long
    Dim obFile As New cParseFileString
    
    
    obFile.FullPath = sFilePath
    
    lFileNum = FreeFile
    
    Open TestLogPath For Append As #lFileNum
    Print #lFileNum, "<p>"
    Print #lFileNum, "<P ALIGN=""CENTER""><b>Test Recorded</b><i> " & Format(Now, "mm/dd/yyyy hh:mm:ss am/pm") & "</i></p> "
    Print #lFileNum, "<p>" & sFileDescriptionLong & "<P>"
    If bOpenInNewWindow Then
        Print #lFileNum, "<a HREF=""#"" OnClick=""OpenInNewWindow('" & obFile.JavaOrCFilePathString & "')"">" & sFileDescriptionShort & "</a>"
    Else
        Print #lFileNum, "<A HREF="" " & sFilePath & """> " & sFileDescriptionShort & "</a>"
    End If
    Print #lFileNum, "<hr>"
    Close #lFileNum
    
End Function

Public Sub AddTextCommentToLog(obApp As cicsSpy, _
                                        sComment As String)
    Dim spymsg As icsSpyMessageJ1850
    
    '// increment the comment count
    lTextCommentCount = lTextCommentCount + 1
    
    '// this is a comment
    Call AddCommentToLog(sComment, lTextCommentCount)
    
    '// send the message
    If obApp.MonitorOn Then '// add a message to the log
        '// setup the messages
        With spymsg
            .StatusBitField = icsSpyStatusTextCommentType
            .Value = lTextCommentCount
            .TimeSystem = timeGetTime
        End With
        '// send to all buffers
        Call obApp.NewMsgJ1850(spymsg)
    End If
    
End Sub
Public Function AddCommentToLog(sComment As String, lCommentIndex As Long)
    '
    Dim lFileNum As Long

    lFileNum = FreeFile

    Open CommentLogPath For Append As #lFileNum
    Print #lFileNum, "<table border=""1"" width=""100%"">"
    Print #lFileNum, "<tr>"
    Print #lFileNum, "<td width=""33%"" bgcolor=""#808080""><font color=""#FFFFFF"" face=""Arial""><small><A NAME=""TEXTCOMMENT" & lCommentIndex & """><b>Text Comment Recorded #" & lCommentIndex & "</b><br>"
    Print #lFileNum, Format(Now, "mm/dd/yyyy hh:mm:ss am/pm") & "</small></font></td>"
    Print #lFileNum, "<td><small>" & sComment & "</small></td>"
    Print #lFileNum, "</tr>"
    Print #lFileNum, "</table>"
    Close #lFileNum

End Function
Public Property Get NextAudioCommentFileString() As String
    NextAudioCommentFileString = "AudioComment" & lAudioCommentCount & ".wav"
End Property

Public Function AddWaveAudioCommentToLog(sFilePath As String, lCommentIndex As Long)
    Dim lFileNum As Long

    lFileNum = FreeFile

    Open CommentLogPath For Append As #lFileNum
    Print #lFileNum, "<table border=""1"" width=""100%"">"
    Print #lFileNum, "<tr>"
    Print #lFileNum, "<td width=""33%"" bgcolor=""#800080""><font color=""#FFFFFF"" face=""Arial""><small><A NAME=""AUDIOCOMMENT" & lCommentIndex & """><b>Audio Comment Recorded #" & lCommentIndex & "</b><br>"
    Print #lFileNum, Format(Now, "mm/dd/yyyy hh:mm:ss am/pm") & "</small></font></td>"
    Print #lFileNum, "<td><small><A HREF=""" & sFilePath & """>" & sFilePath & "</a></small></td>"

    Print #lFileNum, "</tr>"
    Print #lFileNum, "</table>"
    Close #lFileNum

End Function


Public Sub AddAudioCommentToLog(obApp As cicsSpy, _
                                            sComment As String)
    Dim spymsg As icsSpyMessageJ1850
    
    '// increment the comment count
    lAudioCommentCount = lAudioCommentCount + 1
    
    '// this is a comment
    Call AddWaveAudioCommentToLog(sComment, lAudioCommentCount)
        
    '// send the message
    If obApp.MonitorOn Then '// add a message to the log
        With spymsg
             .StatusBitField = icsSpyStatusAudioCommentType
             .Value = lAudioCommentCount
             .TimeSystem = timeGetTime
        End With
        '// send to all the buffers
        Call obApp.NewMsgJ1850(spymsg)
    End If
    
End Sub
VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
