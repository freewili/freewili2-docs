'Load property values from storage
Private Sub UserControl_ReadProperties(PropBag As PropertyBag)

    txt.BackColor = PropBag.ReadProperty("BackColor", &H80000005)
    txt.ForeColor = PropBag.ReadProperty("ForeColor", &H80000008)
    m_Enabled = PropBag.ReadProperty("Enabled", m_def_Enabled)
    Set txt.Font = PropBag.ReadProperty("Font", Ambient.Font)
    txt.BorderStyle = PropBag.ReadProperty("BorderStyle", 1)
    txt.Text = PropBag.ReadProperty("Value", "Text1")
End Sub

'Write property values to storage
Private Sub UserControl_WriteProperties(PropBag As PropertyBag)

    Call PropBag.WriteProperty("BackColor", txt.BackColor, &H80000005)
    Call PropBag.WriteProperty("ForeColor", txt.ForeColor, &H80000008)
    Call PropBag.WriteProperty("Enabled", m_Enabled, m_def_Enabled)
    Call PropBag.WriteProperty("Font", txt.Font, Ambient.Font)
    Call PropBag.WriteProperty("BorderStyle", txt.BorderStyle, 1)
    Call PropBag.WriteProperty("Value", txt.Text, "Text1")
End Sub


'This procedure formats the number box according to the lower and upper limits specified
'it also attaches a units string to the number.  If the number entered is outside the limits
'it either forces to limit(scroll bar) or resets to nothing(text box) is zero_trail is zero
'it is assumed that its a integer box
'
Sub number_format(Current As TextBox, zero_trail As Integer, lower_limit As Double, upper_limit As Double, units As String)

Dim format_string As String
Dim greater_length As Integer

number_pressed = True

limit_not_exceeded = True 'reset flag


If Not scroll Then
    Select Case without_units(Current)

    Case Is > upper_limit
        
        Beep
        MsgBox "The upper limit is " & upper_limit, 48, "Entry Limit reached"
            Current = " " & units
            limit_not_exceeded = False
        
            
        

    Case Is < lower_limit
        Beep
        
        MsgBox "The lower limit is " & lower_limit, 48, "Entry Limit reached"
        Current = " " & units
        limit_not_exceeded = False
    
       
    End Select
Else    'it the scroll
    Select Case number_value

    Case Is > upper_limit
        Beep
        number_value = upper_limit
        
    Case Is < lower_limit
        Beep
        number_value = lower_limit
    End Select
    Current = Str$(number_value)
End If

    
greater_length = Len(Str(Int(upper_limit)))

If greater_length < Len(Str(Int(lower_limit))) - 1 Then greater_length = Len(Str(Int(lower_limit))) - 1
If zero_trail = 0 Then
        format_string = String$(greater_length - 1, "#") & "0"
Else
        format_string = String$(greater_length - 1, "#") & "0." & String$(zero_trail, "0")
End If


If Current <> " " & units Then Current = Format$(Val(Current), format_string) & " " & units

End Sub





'this function will center a form on the users screen
'
'
Sub center_form(centerform As Form)
    'Center form
    centerform.Left = (Screen.Width - centerform.Width) / 2
    centerform.Top = (Screen.Height - centerform.Height) / 2

End Sub

'this function waits until a enter is sent before formatting the characters
'
'
Sub enter_format_tab(KeyCode As Integer, Current As TextBox, zero_trail As Integer, lower_limit As Double, upper_limit As Double, units As String)
Dim minus_place As Integer
Const ENTER = 13
scroll = False


If KeyCode = ENTER Then
    Call number_format(Current, zero_trail, lower_limit, upper_limit, units)
    If limit_not_exceeded Then SendKeys "{TAB}"
End If


End Sub

'This function make sure that the sign only stays at the front of a string
'
'
Sub handle_sign(Current As TextBox)
Dim sign_place As Integer
    
    
sign_place = InStr(Current, "-") 'Find out where and if a minus is in string
    If sign_place > 1 Then
        Current = "-" & Left$(Current, sign_place - 1) & Right$(Current, Len(Current) - sign_place)
        SendKeys "{RIGHT}" 'Send right key so numbers can be entered correctly
        If Abs(Val(Current)) < 10 Then SendKeys "{RIGHT}"
    End If
    
    
    
sign_place = InStr(Current, "+") 'Find out where and if a fplus is in string
    
    If sign_place > 1 Then
        Current = "+" & Left$(Current, sign_place - 1) & Right$(Current, Len(Current) - sign_place)
        SendKeys "{RIGHT}" 'Send right key so numbers can be entered correctly
        If Abs(Val(Current)) < 10 Then SendKeys "{RIGHT}" 'non elegant send two rights if first number
    End If


End Sub

'This function will make an ordinary text box accept only numbers
'it forces only one possible minus at the beginning of the text and
'allows only one . if the int_type vaule id false
'
Function number_box(Current As TextBox, KeyCode As Integer, int_type As Integer)
Dim Count As Integer


Const BACKSPACE = 8
Const MINUS = 45
Const PERIOD = 46
Const PLUS = 43


'***************************************************************
'* Is the number a vaild number
'***************************************************************

If (KeyCode >= 48 And KeyCode <= 57) Then   'between/including 0 and 9
    number_box = KeyCode
    Exit Function
End If

'***************************************************************************
'* Allow only one period in the number string if this isn't a integer type
'***************************************************************************
If KeyCode = PERIOD And Not int_type Then
    If InStr(Current, ".") <> 0 Then KeyCode = 0
    number_box = KeyCode
    Exit Function
End If
'**********************
'* Attach minus/plus to beginning of number
'**********************

If KeyCode = MINUS Then
    If Left$(Current, 1) = "-" Then Exit Function
    If Left$(Current, 1) = "+" Then
        Current = "-" & Right$(Current, Len(Current) - 1)
    Else
        Current = "-" & Current
    End If
End If

If KeyCode = PLUS Then
    If Left$(Current, 1) = "+" Then Exit Function
    If Left$(Current, 1) = "-" Then
        Current = "+" & Right$(Current, Len(Current) - 1)
    Else
        Current = "+" & Current
    End If
End If

'Allow backspaces to occur

If KeyCode = BACKSPACE Then
    number_box = KeyCode
    Exit Function
End If




number_box = 0










End Function


Sub number_lost_focus(Current As TextBox, zero_trail As Integer, lower_limit As Double, upper_limit As Double, units As String)
'Dim minus_place As Integer


'To prevent cascading focus events only reformat and set focus if a change was made

If Not number_pressed Then
    scroll = False
    Call number_format(Current, zero_trail, lower_limit, upper_limit, units)
    If Not limit_not_exceeded Then Current.SetFocus
End If



End Sub


'This will resize all the font for all the controls on the form to the
'font size constant. these are all dervire from the orginal height of an elastic
'which all controls are placed on
'
'
Sub resize_fonts(the_form As Form, elasticmain As Variant, original_height As Single)
  
  'Code to Change fonts when form is resized
  Dim Count%
  On Error Resume Next

  
  For Count = 0 To the_form.Controls.Count - 1
    the_form.Controls(Count).FontSize = 10 * (elasticmain.Height / original_height)
    the_form.Controls(Count).FontName = "Arial"
    the_form.Controls(Count).FontName = True
  Next Count
    'the_form.lbl_sent.FontSize = 10
    'the_form.lbl_sent.FontName = "Courier"
    'the_form.lbl_sent.FontName = True
  

End Sub

'Generic wait or timeout routine
'accurate to the the second
'
'
Sub wait(seconds As Integer)
Dim timestart As Long

timestart = Timer
Do
'Hog windows
Loop While (Timer - timestart) < seconds

End Sub

'
'*************************************************************************************
'*  Date Created:  06/28/95    05:08 AM
'*
'*  Project:  FRM_PRJ.MAK           Author: Dave
'*
'*  Purpose: This subroutine is to determine how many characters are left in the
'*           number box so when they are removed an error won't be generated from
'*           removing too many characters that aren't there anymore
'*
'*
'*  Parameters:
'*
'*  Returns:
'*
'*************************************************************************************\
'
Function without_units(Current As TextBox)
'This function returns the number in the text box without the units
'It only reads till the first non number or decimal is entered
'then it call the val function on the rest.  This eleimnates the errors
'assoicated is the units are of the percent type
Dim Count As Integer
Dim length As Integer
Dim current_char As Integer

'intialize the local variables
length = Len(Current)
Count = 0
'

'Only check if there are at least one character in the text box
If length = 0 Then
    without_units = Val("")
    Exit Function
End If

current_char = Asc("0") 'seed the while loop


While ((current_char >= Asc("0") And current_char <= Asc("9")) Or (current_char = Asc(".")) Or (current_char = Asc("+")) Or (current_char = Asc("-")) Or (current_char = Asc(" "))) And (Count < length - 1)
Count = Count + 1                                       'increment index
current_char = Asc(Mid(Current, Count, 1))              'Current characters asc value
Wend

'loop while its a number or decimal place and only while there are still characters left in
'the string multiple decimal points,which would be illegal would be taken care of by the val
'function



'Return the value of the current text box with out the extra non-numeric characters
without_units = Val(Left$(Current, Count))

End Function



VERSION 5.00
Object = "{648A5603-2C6E-101B-82B6-000000000014}#1.1#0"; "MSCOMM32.OCX"
Begin VB.UserControl icsVSI 
   ClientHeight    =   1200
   ClientLeft      =   0
   ClientTop       =   0
   ClientWidth     =   1800
   InvisibleAtRuntime=   -1  'True
   Picture         =   "icsVSI.ctx":0000
   ScaleHeight     =   1200
   ScaleWidth      =   1800
   Begin VB.Timer Timer1 
      Enabled         =   0   'False
      Interval        =   250
      Left            =   210
      Top             =   495
   End
   Begin MSCommLib.MSComm comm 
      Left            =   705
      Top             =   300
      _ExtentX        =   1005
      _ExtentY        =   1005
      _Version        =   327681
      CommPort        =   2
      DTREnable       =   0   'False
      RTSEnable       =   -1  'True
      BaudRate        =   28800
      StopBits        =   2
      InputMode       =   1
   End
End
Attribute VB_Name = "icsVSI"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit


'// Holds the last error message
Public LastErrorMessage As String

Const ERR_NO_RESPONSE = "Error communicating with the VSI hardware, please check comm port settings and connections."
Const ERR_CONNECT_DLC_TO_ALDL = "Error connecting the DLC to ALDL"

Public Enum icsVSIDLCBaudRate
    icsVSIDLC10400 = 0
    icsVSIDLC41200 = 1
End Enum

Public Enum icsVSIMonitorMode
    icsVsiMonitorOnly = 1
    icsVsiBlockMonitorOnly = 2
    icsVsiMonitorBoth = 3
End Enum

Public Enum icsVSIConnectDLCtoALDLPin
    icsVsiDisconnectDLS = 0
    icsVsiConnectToPrimary = 1
    icsVsiConnectToSecondary = 2
    icsVsiConnectToMainNode = 4
    icsVsiConnectPrimSec = 3
    icsVsiConnectPrimMain = 5
    icsVsiConnectSecMain = 6
    icsVsiConnectPrimSecMain = 7
End Enum
    
    

Private mMonitorOn As Boolean           '// Turn monitoring on/off
Private mPortOpen As Boolean
Private sSave As String

'// Collection of bytes to send
Private mvarcMessageBytes As cMessageBytes

'// function used for time stamping
Private Declare Function timeGetTime Lib "winmm.dll" () As Long
Private Declare Sub CopyData Lib "apigid32.dll" Alias "agCopyData" (source As Any, dest As Any, ByVal nCount&)

'To fire this event, use RaiseEvent with the following syntax:
'RaiseEvent NewMessage[(arg1, arg2, ... , argn)]
Public Event NewMessage(MessageString As String, MessageBytes As Variant)

'Default Property Values:
Const m_def_DLCConnection = icsVsiConnectToPrimary
Const m_def_MonitorMode = icsVsiMonitorOnly
Const m_def_BaudRate = 28800
Const m_def_DLCBaudRate = icsVSIDLC10400
'Property Variables:
Dim m_DLCConnection As Long
Dim m_MonitorMode As Long
Dim m_BaudRate As Long
Dim m_DLCBaudRate As icsVSIDLCBaudRate



'// This transmits the message contained in the message bytes collection
Public Function TransmitMessage() As Boolean
    
    Dim sSend As String
    Dim lCount As Long
    Dim lNumItems As Long
    Dim lSum As Long
    
    '// Determine the number of items in this message
    lNumItems = Me.MessageBytes.Count
    
    ReDim BytesToSend(lNumItems + 2)
    
    sSend = "T" & Trim(Str$(lNumItems)) & vbCr
    
    '// Attach the msg bytes
    For lCount = 1 To lNumItems
        sSend = sSend & Chr(MessageBytes(lCount).ByteValue)
    Next lCount
    
    '// Attach the checksum
    For lCount = 1 To lNumItems
        lSum = lSum + MessageBytes(lCount).ByteValue
    Next lCount
    
    '// Invert the bytes, add one, and mask off all but lower byte
    lSum = ((lSum Xor 255) + 1) And 255
    
    '// Attach the checksum to the code
    sSend = sSend & Chr(lSum)
    
    '// Send the string
    comm.Output = sSend

End Function



Public Property Get MessageBytes() As cMessageBytes
    If mvarcMessageBytes Is Nothing Then
        Set mvarcMessageBytes = New cMessageBytes
    End If


    Set MessageBytes = mvarcMessageBytes
End Property


Public Property Set MessageBytes(vData As cMessageBytes)
    Set mvarcMessageBytes = vData
End Property

Public Property Get MonitorOn() As Boolean
Attribute MonitorOn.VB_Description = "Turns monitor mode of VSI box on."
Attribute MonitorOn.VB_MemberFlags = "400"
    MonitorOn = mMonitorOn
End Property

Public Property Let MonitorOn(ByVal vNewValue As Boolean)
    
    If mMonitorOn Then  '// we are already in monitor mode
        If vNewValue Then
            '// we are already on - do nothing
        Else
            comm.Output = "M0" & vbCr    '// Send command off
            mMonitorOn = False
            Timer1.Enabled = False
        End If
    Else
        If vNewValue Then
            comm.Output = "M" & Trim$(Str$(m_def_MonitorMode)) & vbCr    '// Send command on
            mMonitorOn = True
            Timer1.Enabled = True
        Else
            '// we are alreay off - do nothing
        End If
    End If
End Property


Public Property Get PortOpen() As Boolean
Attribute PortOpen.VB_Description = "Opens and configures the comm port for this control."
Attribute PortOpen.VB_MemberFlags = "400"
    PortOpen = mPortOpen
End Property

Public Property Let PortOpen(ByVal vNewValue As Boolean)
    If mPortOpen Then  '// we are already in monitor mode
        If vNewValue Then
            '// we are already on - do nothing
        Else
            If mMonitorOn Then MonitorOn = False   '// Turn off monitor mode if on
            comm.PortOpen = False
            mPortOpen = False
        End If
    Else
        If vNewValue Then
            comm.Settings = BaudRate & ",n,8,2"
            comm.PortOpen = True
            If Reset Then
                mPortOpen = True
            Else
                comm.PortOpen = False
                mPortOpen = False
            End If
        Else
            '// we are alreay off - do nothing
        End If
    End If
End Property


Private Function WaitForBytes(lLength As Long, lTimeOutMS As Long) As Boolean
Dim StartTime As Long
Dim bTimeOut As Boolean
Dim bDone As Boolean


StartTime = timeGetTime
Do
    bTimeOut = (Abs(timeGetTime - StartTime) > lTimeOutMS)
    bDone = CLng(comm.InBufferCount) >= lLength
Loop Until bTimeOut Or bDone

WaitForBytes = Not bTimeOut

End Function

Private Sub comm_OnComm()
Select Case comm.CommEvent
    ' Handle each event or error by placing
    ' code below each case statement

    ' Errors
        Case comEventBreak  ' A Break was received.
        Case comEventCDTO   ' CD (RLSD) Timeout.
        Case comEventCTSTO  ' CTS Timeout.
        Case comEventDSRTO  ' DSR Timeout.
        Case comEventFrame  ' Framing Error
        Case comEventOverrun    ' Data Lost.
        Case comEventRxOver ' Receive buffer overflow.
            MsgBox "rec buffer overflow"
        Case comEventRxParity   ' Parity Error.

        Case comEventTxFull ' Transmit buffer full.
        Case comEventDCB    ' Unexpected error retrieving DCB]

    ' Events
        Case comEvCD    ' Change in the CD line.
        Case comEvCTS   ' Change in the CTS line.
        Case comEvDSR   ' Change in the DSR line.
        Case comEvRing  ' Change in the Ring Indicator.
        Case comEvReceive   ' Received RThreshold # of
                                ' chars.
        Case comEvSend  ' There are SThreshold number of
                            ' characters in the transmit
                            ' buffer.

        Case comEvEOF   ' An EOF charater was found in                              ' the input stream
    End Select

End Sub

Private Sub Timer1_Timer()

Dim sRead As String
Dim sPrintString As String
Dim lNumMessageBytes As Long
Dim lCount As Long
Dim lLocation As Long
Dim lSum As Long
Dim ByteArray() As Byte
Dim lbytecount As Long
Dim CurrentTime As Long
Dim vBytes As Variant
Dim lNumBytes As Long


'// Read the bytes out of the serial port
vBytes = comm.Input

'// Verify that we have an array
If VarType(vBytes) <> vbArray + vbByte Then
    Exit Sub
End If

'// get the number of bytes
lNumBytes = UBound(vBytes) - LBound(vBytes) + 1


For lCount = 0 To UBound(vBytes)
    Debug.Print Hex(vBytes(lCount)) & " : ";
Next lCount


Do While FindFX(vBytes, lNumBytes, lLocation)

    lNumMessageBytes = vBytes(lLocation) And &HF '// Determine num bytes
    ReDim ByteArray(lNumMessageBytes - 1 + 4)   '// Number of bytes plus the time

    
    '// Make sure all the bytes of this message are in the string
    If lLocation + lNumMessageBytes > lNumBytes Then
        Exit Do
    End If

    CurrentTime = timeGetTime
    Call CopyData(CurrentTime, ByteArray(0), 4) '// Place the time as the first four bytes
    
    lSum = 0
    lbytecount = 4
    For lCount = lLocation + 1 To lLocation + lNumMessageBytes - 1
        '// Sum
        ByteArray(lbytecount) = vBytes(lCount)
        lSum = lSum + ByteArray(lbytecount)
        sPrintString = sPrintString & Format(Hex(ByteArray(lbytecount)), "00") & " "
        lbytecount = lbytecount + 1
    Next lCount
    RaiseEvent NewMessage(sPrintString, ByteArray)
    sPrintString = ""

    lSum = lSum And 255 '// convert to
    If lSum = 0 Then
        '// This was a valid message!
        Debug.Print "Valid Message"
    End If

    'sRead = Right$(sRead, Len(sRead) - (lLocation + lNumMessageBytes - 1))
    
    lLocation = 0
Loop

sSave = sRead

End Sub

Private Function FindFX(vBytes As Variant, lNumBytes As Long, lIndex As Long) As Boolean
    Dim lCount As Long
    
    '// Find first byte greater the hex &hF0
    For lCount = 0 To lNumBytes - 1
        If vBytes(lCount) > &HF0 Then
            FindFX = True
            lIndex = lCount
            Exit Function
        End If
    Next lCount
    
End Function


