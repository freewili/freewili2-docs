Private Sub tmrUpdateDisplay_Timer()
    Dim lTime As Long
    Dim lNewHeight As Long
    Dim lNewTop As Long
    Dim lNewWidth As Long
    Dim bNewMove As Boolean
    
    If obApp.MonitorOn And obApp.Performance.TextMonitorUpdateType = icsspyPerformanceMonitorDoNotAttempt Then
        Exit Sub
    End If
    
    
    If Visible Then
        '// update during visible only
        'lTime = timeGetTime
        If mnuViewScroll.Checked = True Then
            UpdateMonitorDisplay (False)
        Else
            With obApp.Monitor.Buffer
                If .UpdateScreen Then
                    UpdateBufferPointer     '// update the buffer pointer
                    .UpdateScreenClear  '// clear the update screen flag
                End If
            End With
        End If
        
       ' DrawRunningBar
        
        'Debug.Print "Update : " & Abs(timeGetTime - lTime)
    End If
    
    
    lNewTop = tbMonitor.Buttons("relative").Top + tbMonitor.Buttons("relative").Height
    lNewHeight = tbMonitor.Height - lNewTop
    lNewWidth = tbMonitor.Width - 50
    If lNewHeight > 0 And lNewWidth > 0 And lNewTop > 0 Then
        pgBusLoad.Move 0, lNewTop, lNewWidth, lNewHeight
    End If
    
   'Debug.Print "active: " & Screen.ActiveControl.Name
    
End Sub

