Private Sub cwbTest_Click(Index As Integer)
    If obApp.MonitorOn Then
        '// start the particular test
        With obApp.UserDialog.TestButtons(str$(Index))
            Select Case .TestAction
                Case icsUDSaveTestData
                    obApp.Tests(.DataID).SaveMessageData
                Case icsUDStartTest
                    obApp.Tests(.DataID).StartTest
                Case icsUDStopTest
                    obApp.Tests(.DataID).StopTest True
                Case icsUDTriggerTest
                    obApp.Tests(.DataID).TriggerTest
            End Select
        End With
    End If
End Sub

