␀␀␀graphical panel demo.IVS␀␀␀asdf.IVS␀␀␀␀␀␀␀␀Attribute VB_Name = "basCrypkeyFunctions"
Option Explicit
Option Base 1
Option Private Module

Declare Function ExplainErr% Lib "crp32dll.dll" (ByVal functioncode%, ByVal errcode%)
Declare Function ExplainErr2% Lib "crp32dll.dll" (ByVal functioncode%, ByVal errcode%, ByVal text$)

Declare Function InitCrypkey% Lib "crp32dll.dll" (ByVal filepath$, ByVal MasterKey$, ByVal UserKey$, ByVal floppy%, ByVal checktime%)
Declare Function ckChallenge% Lib "crp32dll.dll" (ByVal Random1%, ByVal Random2%)

Declare Function readyToTryDays% Lib "crp32dll.dll" (ByVal oplevel%, ByVal numdays%, ByVal version%, ByVal Copies%)
Declare Function readyToTryRuns% Lib "crp32dll.dll" (ByVal oplevel%, ByVal numruns%, ByVal version%, ByVal Copies%)

Declare Function GetAuthorization% Lib "crp32dll.dll" (oplevel&, ByVal Decrement%)
Declare Function GetAuthorization2% Lib "crp32dll.dll" (ByVal Decrement%)
Declare Function Get1RestInfo% Lib "crp32dll.dll" (ByVal which%)
Declare Function GetRestrictionInfo% Lib "crp32dll.dll" (authopt&, Start_date&, num_allowed&, Num_used&)



Declare Function GetNumCopies% Lib "crp32dll.dll" ()
Declare Function GetNumMultiUsers% Lib "crp32dll.dll" ()
Declare Function GetLevel& Lib "crp32dll.dll" (ByVal nDefinedLevels%)
Declare Function GetOption% Lib "crp32dll.dll" (ByVal nDefinedOptions%, nOptionNum%)

Declare Function GetSiteCode% Lib "crp32dll.dll" (ByVal SiteCode$)
Declare Function SaveSiteKey% Lib "crp32dll.dll" (ByVal sitekey$)

Declare Function directTransfer% Lib "crp32dll.dll" (ByVal directory$)
Declare Function RegisterTransfer% Lib "crp32dll.dll" (ByVal destination$)
Declare Function TransferOut% Lib "crp32dll.dll" (ByVal destination$)
Declare Function TransferIn% Lib "crp32dll.dll" (ByVal destination$)


Declare Function crypkeyVersion Lib "crp32dll.dll" () As Long
Declare Function EndCrypkey Lib "crp32dll.dll" () As Long
Declare Function KillLicense Lib "crp32dll.dll" (ByVal ConfirmCode$) As Long




Public Copies As Integer
Public NumMaxUsers As Integer
Public TypeOfAuthorization As Integer
Public NumAllowed As Integer
Public NumUsed As Integer

'Errors
Public ErrorNum As Integer
Public ErrorMsg As String
Public AuthorizedOptionsCSV As String
Public UnAuthorizedOptionsCSV As String

'// change these constants per your model
Public Const MasterKey As String = "2451 55C4 8313 E0A9 6700 62A3 8F5E 8FA3 3481 50A6 FC2F"
Public Const UserKey As String = "CE02 CD5C 4E3D 5E49 6886 4C50 1D"
Public Const FileName As String = "ICSVSPY.EXE"

'// Variables
Public psMsg As String
Public AppIsAuthorized As Boolean

Function IsAuthorized() As Boolean
    Dim bSuccess As Boolean
    bSuccess = FullyInitCrypkey '// initialize crpykey function
    If bSuccess Then
        Call SetUpReadyToTryDays(1, 5, 1, 1)
        IsAuthorized = IsAuthorizedForLevel(nDecrement:=1)
        If Not PassedChallange Then
            IsAuthorized = False
        End If
    Else
        psMsg = ErrorMsg
    End If
End Function


Function FullyInitCrypkey() As Boolean
    ChDrive App.Path
    ChDir App.Path
    On Error Resume Next
    FullyInitCrypkey = Initialized()
    On Error GoTo 0
End Function

Public Function PassedChallange() As Boolean
    Dim lresult As Long
    Dim lCalcResult As Long
    Dim lCompanyNum As Long
    Dim lPassNum As Long
    Dim lCount As Long
    Dim num1 As Long
    Dim num2 As Long
    
    Randomize
    num1 = Rnd * 30000
    Randomize
    num2 = Rnd * 30000
    
    lCompanyNum = 7956182
    lPassNum = 355710712
    
    lresult = ckChallenge(num1, num2)
    
    For lCount = 1 To 11
        lCalcResult = (lCalcResult * num1 + lCompanyNum) Mod 16381 + (lCalcResult * num2 + lPassNum) Mod 16369
    Next lCount
    
    If lresult = lCalcResult Then
        PassedChallange = True
    Else
        PassedChallange = False
    End If
    


End Function


Private Function TranslatedErrorMessage(ByVal CrypKeyFnCode As Integer) As String
    Dim str As String * 100
    Dim nReturnVal As Integer
    
    nReturnVal = ExplainErr2(CrypKeyFnCode, ErrorNum, str)
    
    Select Case CrypKeyFnCode
        Case 1
            str = "License Error in Function " & "GetAuthorization"
        Case 2
            str = "License Error in Function " & "GetSiteCode"
        Case 3
            str = "License Error in Function " & "SaveSiteKey"
        Case 4
            str = "License Error in Function " & "RegisterTransfer"
        Case 5
            str = "License Error in Function " & "TransferOut"
        Case 6
            str = "License Error in Function " & "TransferIn"
        Case 8
            str = "License Error in Function " & "Init"
        Case Else
            str = "License Error in Function " & "Unknown"
    End Select
    
    TranslatedErrorMessage = "License Errorcode: " & ErrorNum & ". " & str
    
End Function

Function Initialized() As Boolean
    Dim allow_floppy As Integer
    Dim network_max_checktime As Integer
    Dim sFilename$, sMasterKey$, sUserKey$
    
    sFilename = App.Path & "\" & FileName '& Chr$(0)
    sMasterKey = MasterKey '& Chr$(0)
    sUserKey = UserKey '& Chr$(0)
    allow_floppy = 0
    On Error Resume Next
    ErrorNum = InitCrypkey(sFilename, sMasterKey, sUserKey, allow_floppy, 3600)
    If Err.Number <> 0 Then GoTo ExitFn
    If ErrorNum <> 0 Then
        ErrorMsg = TranslatedErrorMessage(8)
    Else
        ErrorMsg = ""
        Initialized = True
    End If
    Exit Function
ExitFn:
    ErrorNum = Err
    ErrorMsg = Chr$(13) & "XL error " & Error()
    On Error GoTo 0
End Function


Function IsAuthorizedForLevel(nDecrement As Integer) As Boolean
    Dim lOptionsAndLevels As Long
    Dim nOption As Integer, nBit As Integer, bln As Boolean, i%, str$
    
    ErrorNum = GetAuthorization(lOptionsAndLevels, nDecrement)
    If ErrorNum > 0 Then
        ErrorMsg = "Network Error. Waiting for " & ErrorNum & " users to quit."
    ElseIf ErrorNum < 0 Then
        ErrorMsg = TranslatedErrorMessage(1)
    Else
        If Not GetAllRestrictions() Then
            Exit Function
        End If
        AuthorizedOptionsCSV = ""
        UnAuthorizedOptionsCSV = ""
        IsAuthorizedForLevel = True
        ErrorMsg = ""
    End If
    
End Function



Private Function GetAllRestrictions() As Boolean
        
    'Either All in 1 swoop does not work
    'ErrorNum = GetRestrictionInfo(TypeOfAuthorization, nDateNum, NumAllowed, NumUsed)
    'If ErrorNum <> 0 Then GoTo ErrorFound
    'or 1 by 1
    On Error GoTo ErrorFound
    Copies = GetNumCopies()
    NumMaxUsers = GetNumMultiUsers()
    TypeOfAuthorization = Get1RestInfo(1)
    NumAllowed = Get1RestInfo(2)
    NumUsed = Get1RestInfo(3)
    GetAllRestrictions = True
    
    Exit Function
ErrorFound:
    ErrorMsg = "Could not get Information about restrictions."
End Function

Function SiteCode() As String
    Dim sSiteCode As String * 80
    
    On Error GoTo ErrorFound
    ErrorNum = GetSiteCode(sSiteCode)
    If ErrorNum <> 0 Then
        ErrorMsg = TranslatedErrorMessage(2)
        GoTo ErrorFound
    Else
        ErrorMsg = ""
        SiteCode = sSiteCode
    End If
    Exit Function
ErrorFound:
    ErrorMsg = "Could NOT obtain site code." & Chr$(13) & " Error :" & ErrorNum & Chr$(13) & "Error Num: " & Err & ". Desc: " & Error()
End Function



Function SetUpReadyToTryDays(nSetLevel As Integer, nDays As Integer, _
                        nVersion As Integer, nCopies As Integer) As Boolean
    ErrorNum = readyToTryDays(nSetLevel, nDays, nVersion, nCopies)
    If ErrorNum <> 0 Then
        ErrorMsg = TranslatedErrorMessage(9)
    Else
        ErrorMsg = ""
        SetUpReadyToTryDays = True
    End If
End Function

Function SetUpReadyToTryRuns(nSetLevel As Integer, nRuns As Integer, nVersion As Integer, nCopies As Integer) As Boolean
    ErrorNum = readyToTryRuns(nSetLevel, 5, nVersion, nCopies)
    If ErrorNum <> 0 Then
        ErrorMsg = TranslatedErrorMessage(9)
    Else
        ErrorMsg = ""
        SetUpReadyToTryRuns = True
    End If
End Function



Function ChangeAuthorization(sSiteKey As String) As Boolean
        
    On Error GoTo ErrorFound
    sSiteKey = sSiteKey & Chr$(0)
    ErrorNum = SaveSiteKey(sSiteKey)
    If ErrorNum <> 0 Then
        ErrorMsg = TranslatedErrorMessage(3)
    Else
        ErrorMsg = ""
        If IsAuthorizedForLevel(nDecrement:=1) Then
            ChangeAuthorization = True
        End If
    End If
    Exit Function
ErrorFound:
    ErrorMsg = "Error Number: " & Err & ". Desc: " & Error()
End Function



Function PrepareToTransfer(ByVal WhereTo As String) As Boolean
    Dim s$
    On Error GoTo ErrorRte
    s = Dir(WhereTo)
    'WhereTo is in DOS 8.3 format
    WhereTo = WhereTo & Chr$(0)
    
    ErrorNum = RegisterTransfer(WhereTo)
    If ErrorNum <> 0 Then
        ErrorMsg = TranslatedErrorMessage(4)
    Else
        PrepareToTransfer = True
        ErrorMsg = ""
    End If
    Exit Function
ErrorRte:
    ErrorMsg = "Error number " & Err & ". Could not register transfer to " & WhereTo
End Function

Function TransferOutAuth(ByVal WhereTo As String) As Boolean
    Dim s$
    On Error GoTo ErrorRte
    s = Dir(WhereTo)

    'WhereTo is in DOS 8.3 format
    WhereTo = WhereTo & Chr$(0)
    
    ErrorNum = TransferOut(WhereTo)
    If ErrorNum <> 0 Then
        ErrorMsg = TranslatedErrorMessage(5)
    Else
        TransferOutAuth = True
        ErrorMsg = ""
    End If
    Exit Function
ErrorRte:
    ErrorMsg = "Error number " & Err & ". Could not transfer out authorization to " & WhereTo
End Function

Function TransferInAuth(ByVal WhereFrom As String) As Boolean
    Dim s$
    
    On Error GoTo ErrorRte
    s = Dir(WhereFrom)

    'WhereFrom is in DOS 8.3 format
    WhereFrom = WhereFrom & Chr$(0)
    ErrorNum = TransferIn(WhereFrom)
    
    If ErrorNum <> 0 Then
        ErrorMsg = TranslatedErrorMessage(6)
    Else
        TransferInAuth = True
        ErrorMsg = ""
    End If
    Exit Function
ErrorRte:
    ErrorMsg = "Error number " & Err & ". Could not transfer in authorization from " & WhereFrom
End Function

Function KillCurrentLicense() As String
    Dim str As String
    
    ErrorNum = KillLicense(str)
    If ErrorNum <> 0 Then
        ErrorMsg = TranslatedErrorMessage(10)
    Else
        ErrorMsg = ""
        KillCurrentLicense = str
    End If

End Function









