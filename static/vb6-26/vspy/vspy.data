Private Sub ShowNextBuffer()
    Dim lNewIndex As Long
    
    lNewIndex = tsBuffers.SelectedItem.Index
    If lNewIndex > obApp.Tests.Count Then
        RemoveViewOfTestMonitor True
    Else
        Call ShowTestInMonitor(lNewIndex)
    End If
                    
End Sub
                    
Private Sub Form_Unload(Cancel As Integer)
    '// save the locations of the the panel bars /////////////////////////
    Call SaveSetting("ICSVSpy", "UI", "BarUpDwn", MiddleBarPercent)
    Call SaveSetting("ICSVSpy", "UI", "BarLftRght", MiddleBarPercentRL)
    Call SaveSetting("ICSVSpy", "UI", "MainLeft", Me.Left)
    Call SaveSetting("ICSVSpy", "UI", "MainTop", Top)
    Call SaveSetting("ICSVSpy", "UI", "MainWidth", Width)
    Call SaveSetting("ICSVSpy", "UI", "MainHeight", Height)
End Sub

