Attribute VB_Name = "frmAudioComment"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public Event AddComment(sComment As String)
Public Event RecordStart()
Public Event RecordStop()

'// Public members
Public sMCI As cSoundMCI
Public sDataDirectory As String
Public sAudioFileName As String

'// private members
Private lTimeCount As Long
Private lTimeTotal As Long
Private sCurrentRecordFile As String
Private bRaisedStartEvent As Boolean

Private Sub cmdCancel_Click()
    Unload Me
End Sub

Private Sub cmdOk_Click()
'    Dim sComment As String
'    sComment = txtComment
'    sComment ="<P ALIGN=""CENTER""><b>Comment Recorded</b><i> " & Format(Now, "mm/dd/yyyy hh:mm:ss am/pm") & "</i></p> " & sComment
    RaiseEvent AddComment(sAudioFileName)
    Unload Me
End Sub

Private Sub txtComment_KeyDown(KeyCode As Integer, Shift As Integer)
    If (Shift And 2) > 0 Then
        Select Case KeyCode
            Case vbKeyG
                Call cmdOk_Click
            Case vbKeyH
                Call cmdCancel_Click
        End Select
    End If
End Sub

Public Sub cmdStart_Click()
    lTimeCount = mt.Value
    lTimeTotal = mt.Value
    RaiseEvent RecordStart
    bRaisedStartEvent = True    '// if we raise the start event, we must raise the stop event
    tmrRecord.Enabled = True
    cmdStart.Enabled = False
    cmdStop.Enabled = True
    mt.Enabled = False
    lblLength.Enabled = False
    sCurrentRecordFile = sDataDirectory & "\" & sAudioFileName
    sMCI.FilePath = sCurrentRecordFile
    sMCI.RecordSound
End Sub

Private Sub cmdStop_Click()
    StopRecord
    RaiseEvent RecordStop
    bRaisedStartEvent = False    '// if we raise the start event, we must raise the stop event
End Sub

Private Sub Form_Load()
    mt.Value = 40
End Sub

Private Sub Form_QueryUnload(Cancel As Integer, UnloadMode As Integer)
    If bRaisedStartEvent Then RaiseEvent RecordStop
End Sub

Private Sub tmrRecord_Timer()
    lTimeCount = lTimeCount - 1
    
    '// oh yes
    If lTimeCount <= 0 Then
        StopRecord      '// stop recording
        cmdOk_Click     '// exit and save the comment
    Else
        ProgressBar1 = (lTimeCount / lTimeTotal) * 100
    End If
    
End Sub

Private Sub StopRecord()
    tmrRecord.Enabled = False
    cmdStart.Enabled = True
    cmdStop.Enabled = False
    ProgressBar1 = 0
    mt.Enabled = True
    lblLength.Enabled = True
    sMCI.StopOperation
End Sub
