'// sets up the test to be started and verifys everything is working
Public Function IntializeTest() As Boolean
    Dim lCount As Long
    Dim lNumItems As Long
    
    On Error GoTo IntializeError

    mTestHasStarted = False
    mTestIsComplete = False                 '// Reset the test complete flag
    mNextMessageSetTriggerFlag = False
    
    If mvarTestType <> icsTestRawMessages Then
        Buffer.ClearBuffer  '// clear the buffer if not a message collect type test
    End If
    
    If CircularBufferLength < 10 Then CircularBufferLength = 10   '// setup a minimum message count
    
    
    Select Case mvarTestType
        Case icsTestActuateOutputOnEvent
            
            ReDim mDigitalActuateAllMessagesFound(Filters.IncludedFiltersCount) '// setup the flag array
            
            If Filters.IncludedFiltersCount = 0 Then
                '// There was a problem
                mvarLastErrorMessage = "There are no messages selected in the trigger filter. Please fix"
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            
            If Filters.IncludedFiltersCount > 1 And m_lDigitalActuateTriggerType = icsVSPYTestActutateTriggerHardware Then
                '// There was a problem
                mvarLastErrorMessage = "The hardware trigger will only accept one incoming message. Please fix."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            
            '// Check the second filter
            If Not Filters.CompileFilterIndexes(Parent.IncomingMessages) Then
                '// There was a problem
                mvarLastErrorMessage = "There was an reference to a message that has been deleted. (Test filters)" & _
                        vbCrLf & vbCrLf & "The message reference was changed."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
    
        Case icstestwait
            '// check this test's filters to see if they point to a filter that
            '// no longer exists
            '// check the indexes for the reset filters and main filters...
            If Not Filters.CompileFilterIndexes(Parent.IncomingMessages) Then
                '// There was a problem
                mvarLastErrorMessage = "There was an reference to a message that has been deleted. (Test filters)" & _
                        vbCrLf & vbCrLf & "The message reference was changed."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            
            If Not ResetFilters.CompileFilterIndexes(Parent.IncomingMessages) Then
                '// There was a problem
                mvarLastErrorMessage = "There was an reference to a message that has been deleted. (Reset filters)" & vbCrLf & vbCrLf & "The message reference was changed."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            '/////////////////////////////////////////////////////////////////////////////
        
        Case icsTestRawMessages, icsTestValues
            '// check this test's filters to see if they point to a filter that
            '// no longer exists
            '// check the indexes for the reset filters and main filters...
            If Not Filters.CompileFilterIndexes(Parent.IncomingMessages) Then
                '// There was a problem
                mvarLastErrorMessage = "There was an reference to a message that has been deleted. (Test filters)" & _
                        vbCrLf & vbCrLf & "The message reference was changed."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            
            If Not ResetFilters.CompileFilterIndexes(Parent.IncomingMessages) Then
                '// There was a problem
                mvarLastErrorMessage = "There was an reference to a message that has been deleted. (Reset filters)" & vbCrLf & vbCrLf & "The message reference was changed."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            '/////////////////////////////////////////////////////////////////////////////
            
            If mvarAppendValueToFileName Then '// verify the referenced index...
                If AppendFileValueTypeInput Then
                    If Not Parent.IncomingMessages.KeyExists(mvarValueToAppendKey) Then
                        mvarLastErrorMessage = "There was an reference to a message that has been deleted (appending a value to the file name message)  " & _
                                    vbCrLf & vbCrLf & "Please fix by undoing the delete or changing in the test dialog."
                        IntializeTest = False
                        mTestIsComplete = True
                        Exit Function
                    End If
                Else
                    If Not Parent.OutgoingMessages.KeyExists(mvarValueToAppendKey) Then
                        mvarLastErrorMessage = "There was an reference to a message that has been deleted (appending a value to the file name message)  " & _
                                    vbCrLf & vbCrLf & "Please fix by undoing the delete or changing in the test dialog."
                        IntializeTest = False
                        mTestIsComplete = True
                        Exit Function
                    End If
                End If
            End If
                
            '// Clear all the analyses and check for errors
            lNumItems = Analyses.Count
            For lCount = 1 To lNumItems
                Set Analyses(lCount).ParentTest = Me
                If Not Analyses(lCount).Reset Then
                    mvarLastErrorMessage = Analyses(lCount).LastErrorMessage
                    IntializeTest = False
                    mTestIsComplete = True
                    Exit Function
                End If
            Next lCount
            
            
            
            '// Setup the buffer based on selections
            If StopNumberOfMessagesEnabled Then
                If AfterStopCollect Then
                    If Not Buffer.SetBufferLength(AfterStopMessages + StopNumberOfMessages) Then
                        mvarLastErrorMessage = "There was a problem setting up the memory for this test."
                        IntializeTest = False
                        mTestIsComplete = True
                        Exit Function
                    End If
                Else
                    If Not Buffer.SetBufferLength(StopNumberOfMessages) Then
                        mvarLastErrorMessage = "There was a problem setting up the memory for this test."
                        IntializeTest = False
                        mTestIsComplete = True
                        Exit Function
                    End If
                End If
            Else
                '// Setup the circular buffer length
                If Not Buffer.SetBufferLength(CircularBufferLength) Then
                    mvarLastErrorMessage = "There was a problem setting up the memory for this test."
                    IntializeTest = False
                    mTestIsComplete = True
                    Exit Function
                End If
            End If
        Case icsTestTransmitValuesFromFile
            '// create a new replay object (if not already created) and load the data into the buffer
            If mReplay Is Nothing Then
                Set mReplay = New cDemo
            End If
            If mReplayFilePath = "" Or Dir$(mReplayFilePath) = "" Then
                mvarLastErrorMessage = "The replay file for this test: " & mReplayFilePath & " does not exist." & vbCrLf & vbCrLf & "Please change the replay file to a valid file."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            If Not Parent.OutgoingMessages.KeyExists(mvarValueReplayOutKey) Then
                mvarLastErrorMessage = "The tx message for this test has been deleted. Outgoing Message Key: " & _
                    mvarValueReplayOutKey & vbCrLf & vbCrLf & "Please either undo this delete operation or change the replay message."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            mReplay.Continuous = mContinuousGeneration
            mReplay.NumberOfIterations = mNumberOfGenerations
            If Not mReplay.Buffer.LoadTXValueBufferFromFile(Parent, Parent.OutgoingMessages(mvarValueReplayOutKey), mReplayFilePath) Then
                Debug.Print "cTest::InitializeTest ) problem loading replay file: " & mReplay.Buffer.LastErrorString
                mvarLastErrorMessage = "The replay file for this test: " & mReplayFilePath & " is not a valid data file." & vbCrLf & vbCrLf & "Please change the replay file to a valid file."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
        Case icsTestTransmitMessagesFromFile
            '// create a new replay object (if not already created) and load the data into the buffer
            If mReplay Is Nothing Then
                Set mReplay = New cDemo
            End If
            If mReplayFilePath = "" Or Dir$(mReplayFilePath) = "" Then
                mvarLastErrorMessage = "The replay file for this test: " & mReplayFilePath & " does not exist." & vbCrLf & vbCrLf & "Please change the replay file to a valid file."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            mReplay.Continuous = mContinuousGeneration
            mReplay.NumberOfIterations = mNumberOfGenerations
            If Not mReplay.Buffer.LoadBufferFromFile(mReplayFilePath) Then
                Debug.Print "cTest::InitializeTest ) problem loading replay file: " & mReplay.Buffer.LastErrorString
                mvarLastErrorMessage = "The replay file for this test: " & mReplayFilePath & " is not a valid data file." & _
                    vbCrLf & vbCrLf & "Please change the replay file to a valid file."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            
            '// filter the buffer
            Set mReplay.Buffer = Parent.NewBufferFromFilter(mReplay.Buffer, Filters)
            
            
        Case icsTestTransmitMessages
            
            '// check this test's filters to see if they point to a filter that
            '// no longer exists
            '// check the output indexes
            For lCount = 1 To Filters.IncludedFiltersCount
                If Not Parent.OutgoingMessages.KeyExists(Filters.IncludedFiltersKey(lCount)) Then
                    '// There was a problem
                    mvarLastErrorMessage = "There was an reference to a message that has been deleted. (Test Output Messages)" & _
                                vbCrLf & vbCrLf & "Please remove or undo the delete operation."
                    IntializeTest = False
                    mTestIsComplete = True
                    Exit Function
                End If
            Next lCount
            
        
        Case icsTestCallActiveXComponent
            
            '// Create the server componenet
            If Trim$(m_sActiveXServerClassID) = "" Then
                mvarLastErrorMessage = "The Class ID string of the server to create is blank."
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            
            '// create the server
            If CreateActiveXServer Then
                If Not m_obTest.InitializeTest(Parent, Me, mvarLastErrorMessage) Then
                    If Trim$(mvarLastErrorMessage) = "" Then
                        mvarLastErrorMessage = "Test initalization failed (false was returned from the InitializeTest method in the server component)."
                    End If
                    IntializeTest = False
                    mTestIsComplete = True
                    Exit Function
                End If
            Else
                '// the last error message is set by the create object setup
                IntializeTest = False
                mTestIsComplete = True
                Exit Function
            End If
            
            
        Case Else
            '// check stuff here
            
    End Select

    '// start the test if we should start it immediately
    If mvarStartMode = icsSpyStartNow Then
        If Not StartTest Then
            IntializeTest = False
            mTestIsComplete = True
            Exit Function
        End If
    End If

    '// if we made it this far then the test should be initalize propertry
    IntializeTest = True

Exit Function
    
IntializeError:

    '// There probably was an error starting a test
    IntializeTest = False
    mvarLastErrorMessage = "There was an error intializing the test." & vbCrLf & vbCrLf & _
                Err.Description
    
End Function

Private Function CreateActiveXServer() As Boolean
    On Error GoTo createActiveXServerError
    '// Create the object
    If Not (m_sCurrentActiveXServerID = m_sActiveXServerClassID And Not (m_obTest Is Nothing)) Then
        '// we are
        Set m_obTest = Nothing
        Set m_obTest = CreateObject(m_sActiveXServerClassID)
        m_sCurrentActiveXServerID = m_sActiveXServerClassID
    End If
    CreateActiveXServer = True
    Exit Function
createActiveXServerError:
    mvarLastErrorMessage = Err.Description
    CreateActiveXServer = False
    m_sCurrentActiveXServerID = ""
    Set m_obTest = Nothing
End Function
Public Function StartTest() As Boolean
    
    Dim lCount As Long
    Dim lNumItems As Long
    Dim obFile As New cParseFileString
    Dim sNewPath As String
    
    '// Setup error handling
    On Error GoTo TestStartError
    
    
    mStartDateTime = Now                    '// Record the start test time and date
    mvarTestStartTimeMs = timeGetTime       '// Record the start test time
    mSpyMsgStartTime.SystemTimeMs = mvarTestStartTimeMs
    mTestIsComplete = False                 '// Reset the test complete flag
    mTriggerCaptured = False                '// Clear the trigger captured flag
    mPostTriggerMessages = 0                '// Clear the trigger message count
    mLogLineCount = 0                       '// reset the number of items collected
    mTimeOutCount = 0                       '// reset the number of time outs
    
    
    '// Reset all the values as commanded ////////////////////////////////////////////
    If mvarResetAllValues Then
        lNumItems = Parent.IncomingMessages.Count
        For lCount = 1 To lNumItems
            Parent.IncomingMessages(lCount).Value = 0
            Parent.IncomingMessages(lCount).Present = False
        Next lCount
    Else
        lNumItems = mvarResetFilters.IncludedFiltersCount
        For lCount = 1 To lNumItems
            Parent.IncomingMessages(mvarResetFilters.IncludedFiltersKey(lCount)).Value = 0
            Parent.IncomingMessages(mvarResetFilters.IncludedFiltersKey(lCount)).Present = False
        Next lCount
    End If
    '/////////////////////////////////////////////////////////////////////////////
    
    '// Clear all the analyses - we don't need error checking which is done in test::intialize
    lNumItems = Analyses.Count
    For lCount = 1 To lNumItems
        Set Analyses(lCount).ParentTest = Me
        Analyses(lCount).Reset
    Next lCount
    
    
    Select Case TestType
        Case icstestwait
            m_lWaitMessageCount = 0
            If StopNumberOfMessagesEnabled Then
                If AfterStopCollect Then
                    m_lWaitBufferLength = AfterStopMessages + StopNumberOfMessages
                Else
                    m_lWaitBufferLength = StopNumberOfMessages
                End If
            Else
                '// Setup the circular buffer length
                m_lWaitBufferLength = CircularBufferLength
            End If
            
        Case icsTestRawMessages
            
            Buffer.Reset
        
       
        Case icsTestTransmitMessagesFromFile, icsTestTransmitValuesFromFile
            mReplay.Start
            
        Case icsTestTransmitValuesFromFile
            
        Case icsTestValues
            mStartMessageTransmission = True    '// Indicate that we need to start the round robin test
            Call BuildMessageScanList           '// build the scan list for the round robining

            '// we do not need a buffer, open the log file
            If mvarFilePath <> "" And mvarStoreRawData = True Then
                
                '// parse the file name
                obFile.FullPath = mvarFilePath
                
                If mvarAppendDateTimeToFileName Then '// append the date
                    obFile.AttachTimeDateToFileName
                End If
            
                '//
                If mvarAppendValueToFileName Then
                    If AppendFileValueTypeInput Then
                        With Parent.IncomingMessages
                            If .KeyExists(mvarValueToAppendKey) Then
                                Call obFile.AttachValueToFileName(.Item(mvarValueToAppendKey).DoubleValue)
                            End If
                        End With
                    Else
                        With Parent.OutgoingMessages
                            If .KeyExists(mvarValueToAppendKey) Then
                                Call obFile.AttachValueToFileName(.Item(mvarValueToAppendKey).DoubleValue)
                            End If
                        End With
                    End If
                End If
                
                If obFile.DriveLetter = "" And obFile.PathString = "" Then
                    sNewPath = Parent.LogBook.LogBookDirectory & "\" & (Trim$(obFile.FileName & obFile.FileExtension))
                Else
                    sNewPath = obFile.FullPath
                End If
            
                mLogFileNum = FreeFile                              '// get a free file number
                Open sNewPath For Output As mLogFileNum             '// open the file num
                Call LogFileHeader                                  '// write the header into the file
                '// setup the next time to log
                mLogNextTime = timeGetTime + (mvarLogRate * 250)    '// determine the next log time
                mLogFileOpen = True                                 '// indicate that the log file is open
            Else
                mLogFileOpen = False
            End If
        Case icstestwait
        Case icsTestCallActiveXComponent
            '// create the object and call the start test method
            If Not (m_obTest Is Nothing) Then Call m_obTest.StartTest
        Case icsTestActuateOutputOnEvent
                    
            lNumItems = UBound(mDigitalActuateAllMessagesFound)             '// for each -item
            For lCount = 1 To lNumItems                                     '// cycle through all of the items
                mDigitalActuateAllMessagesFound(lCount).WasFound = False    '// reset the "was found" flags
            Next lCount
            m_lDigitalActuateFoundCount = 0
        
            If m_lDigitalActuateTriggerType = icsVSPYTestActutateTriggerSoftware Then
                '// reset the parent
                Call Parent.UpdateParallelPortOutput(m_lDigitalActuatePinID, False)
            Else
                Call Parent.SetupHardwareDigitalActuateTrigger(Filters.IncludedFiltersKey(1)) '// the first filter only
            End If
        
        Case icsTestTransmitMessages
            If m_lTxMessageTestWhenTransmit = icsVPSYTestTxWhenStarted Then
                StartTest = True
                mTestHasStarted = True
                RaiseEvent TestStarted
                TxTransmitMessages
                Exit Function
            End If
    End Select

    '// This test was started successfully
    StartTest = True
    mTestHasStarted = True
    mHaveFirstMessage = False
    
    '// Raise the test started event
    RaiseEvent TestStarted
    
    Exit Function
    
TestStartError:
    
    '// There probably was an error starting a test
    StartTest = False
    mLogFileOpen = False
    mvarLastErrorMessage = "There was an error starting the test." & vbCrLf & vbCrLf & _
                Err.Description
    
End Function

Public Function StopTest(bAllowRestart As Boolean) As Boolean
    '// Stop the test if it is not already
    If (Not mTestIsComplete) And mTestHasStarted Then
        mTestIsComplete = True
        Call TestComplete(bAllowRestart)
        
        RaiseEvent TestStopped
    End If
    StopTest = True
End Function


Friend Property Get SpyMsgTime() As SpyMsgTime
    SpyMsgTime = mSpyMsgStartTime
End Property

Private Sub SetupStartTime(msg As icsSpyMessageLong)
    
    Dim lDiff As Long
    Dim lStartHardware As Long
    Dim mSpyMsgTime As SpyMsgTime
    
    If (msg.StatusBitField And icsSpyStatusHardwareTimePresent) Then
        '// calculate a hardware time based on the
        lDiff = msg.TimeSystem - mvarTestStartTimeMs
        If lDiff < 0 Then
            lDiff = 0
        End If

        lStartHardware = (msg.TimeHardware - lDiff) Mod 60000
        If lStartHardware < 0 Then
            lStartHardware = 60000 + lStartHardware
        End If
        
        mSpyMsgStartTime.HardwareTimeMs = lStartHardware
        mSpyMsgStartTime.HardwareTimePresent = True
    Else
        mSpyMsgStartTime.HardwareTimePresent = False
    End If
    mHaveFirstMessage = True
    
End Sub

'// this adds messages to the tests buffer
Friend Sub AddMessage(msg As icsSpyMessageLong)
    
    Dim lNumAnalyses As Long
    Dim lCount As Long
    Dim lNumItems As Long
    Dim bAllComplete As Boolean
    
    If (Not mTestIsComplete) And mTestHasStarted Then
    
        Select Case mvarTestType
            Case icstestwait
                If Filters(Parent) Then
                    If mTriggerCaptured Then mPostTriggerMessages = mPostTriggerMessages + 1
                    m_lWaitMessageCount = m_lWaitMessageCount + 1
                    IsTestComplete '// check if the test is complete
                End If
        
            Case icsTestRawMessages
                '// handle the first message time
                If Not mHaveFirstMessage Then
                    SetupStartTime msg
                End If
            
                '// Add the element to the buffer if it has passed the fitlers
                If Filters(Parent) Then
                    If mNextMessageSetTriggerFlag Then
                        mNextMessageSetTriggerFlag = False
                        msg.StatusBitField = msg.StatusBitField + icsSpyStatusTestTrigger
                    End If
                    
                    '// add the message to the buffer
                    Call Buffer.AddElement(msg)
                    
                    '// increment the post count
                    If mTriggerCaptured Then mPostTriggerMessages = mPostTriggerMessages + 1
                    
                    
                    '// Handle all of the analyses
                    lNumAnalyses = Analyses.Count
                    For lCount = 1 To lNumAnalyses
                        Call Analyses(lCount).AddMessage(msg)
                    Next lCount
        
                    '// check if the test is complete
                    IsTestComplete
                End If
            Case icsTestActuateOutputOnEvent
                '// Pass it through the filters
                If Filters(Parent) Then
                    lNumItems = UBound(mDigitalActuateAllMessagesFound)  '// for each -item
                    For lCount = 1 To lNumItems         '// cycle through all of the items
                        If Not mDigitalActuateAllMessagesFound(lCount).WasFound Then
                            '// check this message
                            If Parent.IncomingMessagePassed(Parent.IncomingMessages.ReturnIndexFromKey(Filters.IncludedFiltersKey(lCount))) Then
                                mDigitalActuateAllMessagesFound(lCount).WasFound = True   '// set the found flag
                                m_lDigitalActuateFoundCount = m_lDigitalActuateFoundCount + 1
                                Exit For '// don't check any more
                            End If
                        End If
                    Next lCount

                    '// Are we done?
                    bAllComplete = True
                    For lCount = 1 To lNumItems         '// cycle through all of the items
                        If Not mDigitalActuateAllMessagesFound(lCount).WasFound Then bAllComplete = False
                    Next lCount
                
                    '// if ball complete is still true, this analysis is complete
                    If bAllComplete Then
                        '// activate the output
                        If m_lDigitalActuateTriggerType = icsVSPYTestActutateTriggerSoftware Then
                            Call Parent.UpdateParallelPortOutput(m_lDigitalActuatePinID, True)
                        End If
                        TestComplete True
                    End If
                End If
                
            Case icsTestValues
                If ScanNumberOfValues > 0 Then
                
            
                If Parent.IncomingMessagePassed(Parent.IncomingMessages.ReturnIndexFromKey(ScanWaitingForIncomingKey)) Then
                    TransmitNextRequest
                End If
           
                End If
            Case Else
                '// do nothing
        End Select
    End If


End Sub

'// this is called every interval to check if a  operation should be completed
'//
Public Sub TestTimeCheck()
    
    
   
    Dim dValue As Double
    Dim sReturn As String
    
    
    '// exit immediately if the test is complete
    If mTestIsComplete Then Exit Sub
    
    '// has this test started yet?
    If Not mTestHasStarted Then
        '// do we need to start thought the start expression
        If mvarStartMode = icsSpyStartExpression Then
            '// evaluate the start expression
            If Not ParseExpressionForAnalogItems(Parent, False, StartExpression, dValue, 0#) Then
                Parent.ReportError "There is an error in the save expression for starting test " & Description
                dValue = True
            End If
            
            '// if false exit sub, otherwise start the test
            If Not CBool(dValue) Then Exit Sub
            StartTest
            
            '// do we need to sound the test started audio event
            If Trim$(mSoundStartedPath) <> "" Then
                '// parse the string for values and speak it if successful
                If ParseStringExpressionForAnalogItems(Parent, False, mSoundStartedPath, sReturn) Then
                    Parent.Speak sReturn
                End If
            End If
        Else
            '// exit the function
            Exit Sub
        End If
    End If
    
    '// does the test have to do with values?
    Select Case TestType
        Case icsTestRawMessages, icstestwait '// Check if test is complete
            IsTestComplete
        Case icsTestTransmitMessages
            If m_lTxMessageTestWhenTransmit = icsVSPYTestTxWhenTriggerEquation Then
                IsTestComplete
            End If
        Case icsTestValues
        
            If ScanNumberOfValues > 0 Then
                If mStartMessageTransmission Then
                    Call TransmitNextRequest
                    mStartMessageTransmission = False '// Transmit the first message request
                Else
                    If timeGetTime > ScanTimeOut Then   '// we did not receive the request
                        mTimeOutCount = mTimeOutCount + 1
                        TransmitNextRequest
                    End If
                End If
            End If
            
            '// do we need to save?
            If timeGetTime >= mLogNextTime Then
                
                If mLogFileOpen Then '// log the values to disk
                    Call LogWriteDataLine   '// write the data to the file
                    mLogNextTime = timeGetTime + (mvarLogRate * 250)    '// setup the next time to log
                End If

            End If
        Case icsTestTransmitMessagesFromFile, icsTestTransmitValuesFromFile
            mReplay.ReadMessages
        Case Else
            '// handle other tests here
    
    End Select
        


End Sub

Private Function LogWriteDataLine() As Boolean
    Dim sLog As String
    Dim lCount As Long
    
    On Error GoTo LogWriteDataLineError
    
    mLogLineCount = mLogLineCount + 1
    
    '// build the value string to log
    sLog = Format$(Now, "Short Date") & "," & Format$(Now, "Long Time") & ","
    For lCount = 1 To Filters.IncludedFiltersCount
        sLog = sLog & _
            Parent.IncomingMessages(Filters.IncludedFiltersKey(lCount)).Value & ","
    Next lCount

    sLog = Left$(sLog, Len(sLog) - 1)   '// Remove that last comma

    '// Build the string to log to the disk
    Print #mLogFileNum, sLog

    '// return success
    LogWriteDataLine = True
    
    Exit Function
    
LogWriteDataLineError:

    '// return problems
    LogWriteDataLine = False

    Parent.ReportError ("There was a problem writing to the value data file for the test named: " & Description & _
        vbCrLf & vbCrLf & "Description: " & Err.Description)
        
End Function

Private Function LogFileHeader() As Boolean
    Dim sLog As String
    Dim lCount As Long
    
    sLog = "Test Data File" & vbCrLf
    sLog = sLog & "Description," & mvarDescription & vbCrLf
    sLog = sLog & "Start System Time (ms)," & TestStartTimeMs & vbCrLf
    sLog = sLog & "Start Date&Time," & Format$(Now, "Short Date") & " " & Format$(Now, "Long Time") & vbCrLf
    
    '// build the value string to log
    sLog = sLog & "Date,Time,"
    For lCount = 1 To Filters.IncludedFiltersCount
        sLog = sLog & _
                Me.Parent.IncomingMessages(Filters.IncludedFiltersKey(lCount)).Description & ","
    Next lCount
    
    sLog = Left$(sLog, Len(sLog) - 1)   '// Remove that last comma
    
    '// Build the string to log to the disk
    Print #mLogFileNum, sLog
    
End Function

Private Sub IsTestComplete()
    Dim dValue As Double
    Dim IsTestComplete As Boolean

    Select Case TestType
        Case icsTestTransmitMessages
            
            If Not mTriggerCaptured Then
                '// evaluate the trigger expression
                If Not ParseExpressionForAnalogItems(Parent, False, TriggerEquation, dValue, 0#) Then
                    Parent.ReportError "There is an error in the trigger expression for test: " & Description
                    IsTestComplete = True
                    Exit Sub
                End If
                        
                '// trigger the test
                If CBool(dValue) Then TriggerTest
            End If
            
        Case icsTestRawMessages, icstestwait
            
            If mTriggerCaptured And mAfterStopCollect = True Then
                
                Debug.Assert AfterStopCollect = True
                
                If mAfterStopDataType = icsSpyAfterMessages Then
                    '// its messages
                    If mPostTriggerMessages >= mAfterStopMessages Then
                        IsTestComplete = True
                    End If
                Else
                    '// its time
                    If Abs(timeGetTime - mvarTriggerTimeMs) >= (mAfterStopTime * 250) Then
                        IsTestComplete = True
                    End If
                End If
            Else
            
                '// First handle a time based test
                If mStopTimeEnabled Then
                    If Abs(timeGetTime - mvarTestStartTimeMs) >= (mStopAfterTime * 250) Then
                        If AfterStopCollect Then
                            '// we can now go in to the after stop (trigger)
                            TriggerTest
                        Else
                            '// we are complete as far as time goes
                            IsTestComplete = True
                        End If
                    End If
                End If
                
                If mStopNumberOfMessagesEnabled Then
                    If Buffer.NumberItems >= mStopNumberOfMessages Then
                        If AfterStopCollect Then
                            '// we can now go in to the after stop (trigger)
                            TriggerTest
                        Else
                            '// we are complete as far as time goes
                            IsTestComplete = True
                        End If
                    End If
                End If
                
                If mStopOnExpressionEnabled Then
                    
                    If Not ParseExpressionForAnalogItems(Parent, False, TriggerEquation, dValue, 0#) Then
                        Parent.ReportError "There is an error in the trigger expression for test: " & Description
                        IsTestComplete = True
                        Exit Sub
                    End If
                    
                    If CBool(dValue) Then
                        If AfterStopCollect Then
                            '// we can now go in to the after stop (trigger)
                            TriggerTest
                        Else
                            '// we are complete as far as time goes
                            IsTestComplete = True
                        End If
                    End If
                End If
            End If

    End Select
    
    '// should we complete the test
    If IsTestComplete Then
        Call TestComplete(True)
    End If

End Sub

Public Sub TriggerTest()
    Dim sReturn As String
    
    
    If mTestHasStarted Then
        mTriggerCaptured = True
        mNextMessageSetTriggerFlag = True
        mvarTriggerTimeMs = timeGetTime
        
        '// do we need to sound the test triggered audio event
        If Trim$(mSoundTriggeredPath) <> "" Then
            '// parse the string for values and speak it if successful
            If ParseStringExpressionForAnalogItems(Parent, False, mSoundTriggeredPath, sReturn) Then
                Parent.Speak sReturn
            End If
        End If
        
        '// transmit the messages from this test
        Select Case TestType
            Case icsTestTransmitMessages
                TxTransmitMessages
            Case icsTestCallActiveXComponent
                If Not (m_obTest Is Nothing) Then Call m_obTest.TriggerTest
        End Select
        
        RaiseEvent TestTriggered
    End If
End Sub
Private Sub TxTransmitMessages()
    Dim lTransmitInterval As Long
    Dim lTransmitOffset As Long
    Dim lTransmitIntervalCount As Long
    Dim sKeyToTx As String
    Dim lNumItems As Long
    Dim lCount As Long
    
  
    '// determine the transmit interval
    If m_dTxMessageTestIntermessageDelaySec > 214748 Then
        m_dTxMessageTestIntermessageDelaySec = 0
    End If
    lTransmitInterval = CLng(m_dTxMessageTestIntermessageDelaySec * 1000)
    lTransmitOffset = CLng(m_dTxMessageTestOffsetDelaySec * 1000)



    lNumItems = Filters.IncludedFiltersCount
                    
    '// now, transmit all the messages
    For lCount = 1 To lNumItems
        sKeyToTx = Filters.IncludedFiltersKey(lCount)
        If Parent.OutgoingMessages.KeyExists(sKeyToTx) Then
            If lTransmitInterval = 0 And lTransmitOffset = 0 Then
                Call Parent.Transmit(sKeyToTx)
            Else
                If lTransmitOffset = 0 And lCount = 1 Then
                    Call Parent.Transmit(sKeyToTx) '/ tx the first one immediately
                Else
                    Call Parent.TransmitWithTimeStamp(sKeyToTx, timeGetTime + lTransmitOffset + (lTransmitInterval * lTransmitIntervalCount))
                End If
            End If
            lTransmitIntervalCount = lTransmitIntervalCount + 1
        End If
    Next lCount
    
    '// restart test
    StopTest True
End Sub

Public Function TestStatusString() As String
    Dim lNumPresamples As Long
    Dim lBufferNumber As Long
    
    If Not mTestHasStarted Then
        TestStatusString = "Test has not started"
        Exit Function
    End If
    
    If mTestIsComplete Then
        TestStatusString = "Test is Complete"
        Exit Function
    End If

    If mvarTestType = icsTestRawMessages Then
        lBufferNumber = Buffer.NumberItems
    Else
        lBufferNumber = m_lWaitMessageCount
    End If

    Select Case TestType
       Case icsTestActuateOutputOnEvent
            TestStatusString = "Waiting for messages... (found " & m_lDigitalActuateFoundCount _
                                & " of " & Filters.IncludedFiltersCount & ")"
        Case icsTestTransmitMessages
            If mTriggerCaptured Then
                TestStatusString = "Messages Transmitted"
            Else
                TestStatusString = "Waiting for Trigger"
            End If
        Case icsTestTransmitMessagesFromFile, icsTestTransmitValuesFromFile
            If mContinuousGeneration Then
                TestStatusString = "Iteration " & mReplay.CurrentIteration & " Transmitting msg: " & mReplay.CurrentMessageIndex & " of " & mReplay.Buffer.BufferLength
            Else
                TestStatusString = "Iteration " & mReplay.CurrentIteration & " of " & mNumberOfGenerations & " Transmitting msg: " & mReplay.CurrentMessageIndex & " of " & mReplay.Buffer.BufferLength
            End If
        Case icsTestRawMessages, icstestwait
            If mAfterStopCollect Then
                If mTriggerCaptured Then
                    If AfterStopDataType = icsSpyAfterMessages Then
                        TestStatusString = "Triggered " & (mAfterStopMessages - mPostTriggerMessages) & " msg(s) remaining"
                    Else
                        TestStatusString = "Triggered " & Format(Abs(Abs(timeGetTime - mvarTriggerTimeMs) - (mStopAfterTime * 250)) / 1000, "0.000") & " time (s) remaining"
                    End If
                Else
                    If StopTimeEnabled Then
                        If mStopNumberOfMessagesEnabled Then
                            TestStatusString = "Time(s): " & Format(Abs(Abs(timeGetTime - mvarTestStartTimeMs) - (mStopAfterTime * 250)) / 1000, "0.000") _
                                & " Msgs: " & (mStopNumberOfMessages - lBufferNumber) & " waiting for trigger"
                        Else
                            TestStatusString = "Time(s): " & Format(Abs(Abs(timeGetTime - mvarTestStartTimeMs) - (mStopAfterTime * 250)) / 1000, "0.000") & " waiting for trigger"
                        End If
                    Else
                        If mStopNumberOfMessagesEnabled Then

                            TestStatusString = " Msgs remaining: " & (mStopNumberOfMessages - lBufferNumber) & " waiting for trigger"
                        Else
                            TestStatusString = " Msgs collected: " & lBufferNumber & " waiting for trigger"
                        End If
                    End If
                    
                End If
            Else
                If StopTimeEnabled Then
                    If mStopNumberOfMessagesEnabled Then
                        TestStatusString = "Time(s): " & Format(Abs(Abs(timeGetTime - mvarTestStartTimeMs) - (mStopAfterTime * 250)) / 1000, "0.000") _
                            & " Msgs: " & (mStopNumberOfMessages - lBufferNumber)
                    Else
                        TestStatusString = "Time(s): " & Format(Abs(Abs(timeGetTime - mvarTestStartTimeMs) - (mStopAfterTime * 250)) / 1000, "0.000")
                    End If
                Else
                    If mStopNumberOfMessagesEnabled Then
                        
                        TestStatusString = " Msgs remaining: " & (mStopNumberOfMessages - lBufferNumber)
                    Else
                        TestStatusString = " Msgs collected: " & lBufferNumber
                    End If
                End If
            End If
        Case icsTestValues
            If mTimeOutCount = 0 Then
                TestStatusString = "Lines collected: " & mLogLineCount
            Else
                TestStatusString = "Lines collected: " & mLogLineCount & "  Timeout Count: " & mTimeOutCount
            End If
        Case icsTestCallActiveXComponent
            If Not (m_obTest Is Nothing) Then
                TestStatusString = m_obTest.TestStatusString
            Else
                TestStatusString = "No Test Object is Available"
            End If
    End Select
    
End Function

'// This function saves the data in the buffer
Public Function SaveMessageData() As Boolean
        Dim sH As String
        Dim lTriggerLocation As Long
        Dim lCount As Long
        Dim lNumItems As Long
        Dim obFile As New cParseFileString
        Dim sNewPath As String
        Dim sFileNameWithoutSpaces As String
        
        If TestType = icsTestCallActiveXComponent Then
            If Not (m_obTest Is Nothing) Then Call m_obTest.SaveTest
        End If
        
        If TestType = icsTestRawMessages Or TestType = icsTestValues Then
        
            If mvarFilePath <> "" Then
            
                '// Build the header string
                sH = "Test Data File" & vbCrLf
                sH = sH & "Description," & mvarDescription & vbCrLf
                sH = sH & "Duration (sec)," & Format(Abs(TestStopTimeMs - TestStartTimeMs) / 1000, "0.000") & vbCrLf
                sH = sH & "Start System Time (ms)," & TestStartTimeMs & vbCrLf
                sH = sH & "Start Date&Time," & Format(mStartDateTime, "mm/dd/yyyy hh:mm:ss AM/PM") & vbCrLf
                If mAfterStopCollect Then
                    sH = sH & "Trigger Time (sec)," & Format(Abs(TriggerTimeMs - TestStartTimeMs) / 1000, "0.000") & vbCrLf
                    sH = sH & "Trigger Equation," & TriggerEquation & vbCrLf
                    lTriggerLocation = mPostTriggerMessages + 1
                Else
                    sH = sH & "Trigger Time (sec), N/A" & vbCrLf
                    sH = sH & "Trigger Equation,N/A" & vbCrLf
                End If
                sH = sH & "Number Messages," & Buffer.NumberItems & vbCrLf & vbCrLf
                sH = sH & "Analysis Info" & vbCrLf
                sH = sH & "Description,Result,Details" & vbCrLf
                
                '// Write the analyses to the file
                lNumItems = Analyses.Count
                If lNumItems = 0 Then sH = sH & "No analyses for this test" & vbCrLf
                For lCount = 1 To lNumItems
                    sH = sH & Analyses(lCount).Description & "," & Analyses(lCount).Result & Analyses(lCount).AnalysisString & vbCrLf
                Next lCount
                
                obFile.FullPath = mvarFilePath
                
                
                '// Build the file path
                If mvarAppendDateTimeToFileName Then
                    obFile.AttachTimeDateToFileName
                End If
                
                '// setup the filename which appends to a file
                If mvarAppendValueToFileName Then
                    If AppendFileValueTypeInput Then
                        With Parent.IncomingMessages
                            If .KeyExists(mvarValueToAppendKey) Then
                                Call obFile.AttachValueToFileName(.Item(mvarValueToAppendKey).DoubleValue)
                            End If
                        End With
                    Else
                        With Parent.OutgoingMessages
                            If .KeyExists(mvarValueToAppendKey) Then
                                Call obFile.AttachValueToFileName(.Item(mvarValueToAppendKey).DoubleValue)
                            End If
                        End With
                    End If
                End If
                
                If obFile.DriveLetter = "" And obFile.PathString = "" Then
                    sFileNameWithoutSpaces = (Trim$(obFile.FileName & obFile.FileExtension))
                    sNewPath = Parent.LogBook.LogBookDirectory & "\" & sFileNameWithoutSpaces
                    Call Parent.BufferSave(Buffer, "Test", sNewPath, lTriggerLocation, mSpyMsgStartTime, mvarSaveDecimalFormatting, sH)
                    Call Parent.TestInfoToLog(sFileNameWithoutSpaces, HTMLHeader)  '// log to the html file
                Else
                    sNewPath = obFile.DriveLetter & obFile.PathString & obFile.FileName & obFile.FileExtension
                    Call Parent.BufferSave(Buffer, "Test", sNewPath, lTriggerLocation, mSpyMsgStartTime, mvarSaveDecimalFormatting, sH)
                    Call Parent.TestInfoToLog(sNewPath, HTMLHeader) '// log to the html file
                End If
                
            End If
    End If
        
End Function





Private Function ReplaceSpaces(ByVal sString As String) As String
    Dim lCount As Long
    For lCount = 1 To Len(sString)
        If Mid$(sString, lCount, 1) = " " Then
            Mid(sString, lCount, 1) = "_"
        End If
    Next lCount
    ReplaceSpaces = sString
End Function
'// builds the html header for the test
Private Function HTMLHeader() As String
    Dim sH As String
    Dim lTriggerLocation As Long
    Dim lNumItems As Long
    Dim lCount As Long
    
    
    '// Build the header string
    sH = "<TABLE>"
    sH = sH & "<TR><TD><FONT SIZE=2><B>ICS VSpy Test Data File</B></FONT></TD></TR>"
    sH = sH & "<TR><TD><FONT SIZE=2>Description</FONT></Td><TD><FONT SIZE=2>" & mvarDescription & "</FONT></TD></TR>"
    sH = sH & "<TR><TD><FONT SIZE=2>Duration (sec)</Td><TD><FONT SIZE=2>" & Format(Abs(TestStopTimeMs - TestStartTimeMs) / 1000, "0.000") & "</TD></TR>"
    sH = sH & "<TR><TD><FONT SIZE=2>Start System Time (ms)</Td><TD><FONT SIZE=2>" & TestStartTimeMs & "</TD></TR>"
    sH = sH & "<TR><TD><FONT SIZE=2>Start Date&Time</Td><TD><FONT SIZE=2>" & Format(mStartDateTime, "mm/dd/yyyy hh:mm:ss AM/PM") & "</TD></TR>"
    If mAfterStopCollect Then
        sH = sH & "<TR><TD><FONT SIZE=2>Trigger Time (sec)</Td><TD><FONT SIZE=2>" & Format(Abs(TriggerTimeMs - TestStartTimeMs) / 1000, "0.000") & "</TD></TR>"
        sH = sH & "<TR><TD><FONT SIZE=2>Trigger Equation</Td><TD><FONT SIZE=2>" & TriggerEquation & "</TD></TR>"
        lTriggerLocation = mPostTriggerMessages + 1
    Else
        sH = sH & "<TR><TD><FONT SIZE=2>Trigger Time (sec)</Td><TD><FONT SIZE=2> N/A" & "</TD></TR>"
        sH = sH & "<TR><TD><FONT SIZE=2>Trigger Equation</Td><TD><FONT SIZE=2>N/A" & "</TD></TR>"
    End If
    sH = sH & "<TR><TD><FONT SIZE=2>Number Messages</Td><TD><FONT SIZE=2>" & Buffer.NumberItems & "</TD></TR>"
    sH = sH & "<TR><TD><FONT SIZE=2>Analysis Info" & "</TD></TR>"
    sH = sH & "<TR><TD><FONT SIZE=2><u>Description</u></Td><TD><FONT SIZE=2><u>Result</U></Td><TD><FONT SIZE=2><u>Details</u>" & "</TD></TR>"
    
    '// Write the analyses to the file
    lNumItems = Analyses.Count
    If lNumItems = 0 Then sH = sH & "<TR><TD><FONT SIZE=2>No analyses for this test" & "</TD></TR>"
    For lCount = 1 To lNumItems
        sH = sH & "<TR><TD><FONT SIZE=2>" & Analyses(lCount).Description & "</Td><TD><FONT SIZE=2>" & Analyses(lCount).Result & "</Td><TD><FONT SIZE=2>" & Analyses(lCount).AnalysisString & "</TD></TR>"
    Next lCount

    '// Store the string
    HTMLHeader = sH & "</TABLE>"

End Function

Private Function TestComplete(bAllowRestart As Boolean)
Attribute TestComplete.VB_Description = "Fired when this test and the analysis  is completed and before test data is saved."
    Dim lCount As Long
    Dim lNumItems As Long
    Dim dValue As Double
    Dim sReturn As String
    
    '// The test is complete store data and perform analysis
    mvarTestStopTimeMs = timeGetTime    '// Record when the test is complete

    '// Perform all the analyses
    lNumItems = Analyses.Count
    For lCount = 1 To lNumItems
        Analyses(lCount).PerformAnalysis            '// peform any remaining analyses
        Set Analyses(lCount).ParentTest = Nothing   '// free the ref to the parent
    Next lCount
    
    '// Raise the test complete event
    RaiseEvent TestComplete
    
    '// Handle storage of values or message buffers ///////
    Select Case mvarTestType
        Case icsTestValues
            '// Close the log file if it was opened
            If mLogFileOpen Then
                '// Close the test filename
                Close #mLogFileNum
                mLogFileOpen = False
            End If
        Case icsTestRawMessages
            '// Store the buffer if necessary
            If mvarStoreRawData Then
                            
                '// do we need to evaluate the save expression
                If UseSaveExpression Then
                    If Not ParseExpressionForAnalogItems(Parent, False, SaveExpression, dValue, 0#) Then
                        Parent.ReportError "There is an error in the save expression for test, saving anyway: " & Description
                        dValue = True
                    End If
                    
                    '// if true save the data
                    If CBool(dValue) Then SaveMessageData
                Else
                    SaveMessageData
                End If
            Else
                If bAllowRestart Then
                    Call Parent.TestInfoToLog("", HTMLHeader)
                End If
            End If
        
        Case icsTestCallActiveXComponent
            If Not (m_obTest Is Nothing) Then Call m_obTest.StopTest
        Case Else
            '// do nothin
    End Select
    
    '// if we were not stopped by the user announce it
    If bAllowRestart Then
        
        '// do we need to sound the test triggered audio event
        If Trim$(mSoundCompletePath) <> "" Then
            '// parse the string for values and speak it if successful
            If ParseStringExpressionForAnalogItems(Parent, False, mSoundCompletePath, sReturn) Then
                Parent.Speak sReturn
            End If
        End If
    End If
        
    '// handle the test stop actions
    If m_lStopTestAction = icsVspytestDoNothing Or Not (bAllowRestart) Then
        mTestIsComplete = True
    Else
        If m_lStopTestActionTestIndex > 0 And m_lStopTestActionTestIndex <= Parent.Tests.Count Then
            mTestIsComplete = True
            Select Case m_lStopTestAction
                Case icsVspytestSaveTestData
                    Call Parent.Tests(m_lStopTestActionTestIndex).SaveMessageData
                Case icsVspytestTriggerTest
                    Call Parent.Tests(m_lStopTestActionTestIndex).TriggerTest
                Case icsVspytestStartTest
                    Call Parent.Tests(m_lStopTestActionTestIndex).StartTest
                Case icsVspytestStopTest
                    If Parent.Tests(m_lStopTestActionTestIndex).Description <> Description Then
                        Call Parent.Tests(m_lStopTestActionTestIndex).StopTest(True)
                    End If
            End Select
        Else
            Parent.AddVehicleSpyError ("The stop test action index on test: " & Me.Description & " is not a valid test.")
        End If
        
     
    End If
    
    '// restart the test if necessary
    If bAllowRestart Then
        If mvarAutoRestart And bAllowRestart Then
            StartTest
        End If
    End If
    
    
    
End Function

