Private Sub Form_Load()
    Dim lRestrictionType As Long
    Dim lStartDate As Long
    Dim lNumTotal As Long
    Dim lNumUsed As Long
    Dim lLevel As Long
    Dim dtStart As Date
    Dim dtUpgrade As Date
    Dim sErr As String
    Dim obTime As New cMMTime

    dtStart = #1/1/2000#
    
    On Error Resume Next
    
    '// get the multimedia timing metrics
    lblWinMinTime = obTime.MinTimerResolutionMS
    
    
    txtLicenseSiteCode = SiteCode
    If Err.Number <> 0 Then
        sErr = "Problem getting site code." & vbCrLf
        Err.Clear
    End If
    
    
    If GetRestrictionInfo(lRestrictionType, lStartDate, lNumTotal, lNumUsed) = 0 Then
        lLevel = GetLevel(4)
        If Err.Number <> 0 Then
            sErr = sErr & "Problem getting level code." & vbCrLf
            Err.Clear
        End If
        
        dtUpgrade = DateAdd("m", lLevel, dtStart)
        If Err.Number <> 0 Then
            sErr = sErr & "Problem adding date." & vbCrLf
            Err.Clear
        End If
        
        Select Case lRestrictionType
            Case 0 ' Unlimited
                lblLicenseInfo = "Unlimited license with free upgrades until " & Format$(dtUpgrade, "mmmm yyyy") & "."
            Case 1 ' Days
                lblLicenseInfo = lNumUsed & " of " & lNumTotal & " days are used"
            Case 2 ' Runs
                lblLicenseInfo = lNumUsed & " of " & lNumTotal & " runs are used"
            Case Else
                Debug.Print "UNDEFINED RESTRICTION TYPE"
        End Select
    Else
        lblLicenseInfo = "Can't get license info"
    End If
    
    If Err.Number <> 0 Then
        sErr = sErr & "Problem getting restriction code." & vbCrLf
    End If
    
    If Len(sErr) <> 0 Then
        Debug.Print "There was an error: " & sErr
    End If
    
    
    
loadError:
    
    
    
End Sub

Private Sub Label18_Click()

End Sub

Private Sub lstHardware_Click()
    Dim lCount As Long
    
    '// Setup the comm port dialog
    lstCommPorts.Clear
    pctActiveX.Visible = False
    pctBaudRate.Visible = False
    pctSim.Visible = False
    '// make sure the setups are in the right place
    pctBaudRate.Move 315, 1305
    pctActiveX.Move 315, 1305
    pctSim.Move 315, 1305
    
    Select Case lstHardware.ItemData(lstHardware.ListIndex)
    
        Case icsVSPYTypeNICAN
            
                lblCommPort = "Can Network Object"
                With lstCommPorts
                    For lCount = 0 To 31
                        .AddItem "CAN" & lCount
                    Next lCount
                End With
            
                '// Hide the baud rate label
                lblBaudRate.Visible = False
                lstBaudRate.Visible = False
                pctBaudRate.Visible = True
                lstCommPorts.ListIndex = 0
                
        Case icsVSpyTypeActiveX
                '// Hide the baud rate label
                pctActiveX.Visible = True

        Case icsVSpyTypeDemo
            pctSim.Visible = True
            lstSimulationProtocol.ListIndex = 0
            
        Case Else
            lblCommPort = "Comm Port"
            With lstCommPorts
                For lCount = 1 To 16
                    .AddItem "Comm " & lCount
                Next lCount
            End With
            lstCommPorts.ListIndex = 0
            
            '// show the baud rate label
            lblBaudRate.Visible = True
            lstBaudRate.Visible = True
            pctBaudRate.Visible = True
            
            '// default VSI to 28.8k baud
            If lstHardware.ItemData(lstHardware.ListIndex) = icsVSPYTypeGMVSI Then
                For lCount = 1 To lstBaudRate.ListCount
                    If lstBaudRate.ItemData(lCount - 1) = icsVSPYBaud28800 Then
                        lstBaudRate.ListIndex = lCount - 1
                        Exit For
                    End If
                Next lCount
            End If
            
            '// default AVT to 9.6k baud
            If lstHardware.ItemData(lstHardware.ListIndex) = icsVSPYTypeAVT716or716VPW Then
                For lCount = 1 To lstBaudRate.ListCount
                    If lstBaudRate.ItemData(lCount - 1) = icsVSPYBaud9600 Then
                        lstBaudRate.ListIndex = lCount - 1
                        Exit For
                    End If
                Next lCount
                cmdAVTSetup.Visible = True
            Else
                cmdAVTSetup.Visible = False
            End If
                 
    End Select
    
    
End Sub



Public Sub SetupUI()

Dim lCount As Long
Dim lNumberOfItems As Long
Dim lvwItem As ListItem
    
    On Error Resume Next '// turn off error handling
    
    
    '// set the commport
    lstGPSCommPort.Clear
    For lCount = 1 To 16
        lstGPSCommPort.AddItem "Comm " & lCount
    Next lCount
    
    '// add the items to the list box
    With lstHardware
        .Clear
        .AddItem "AVT"
        .ItemData(.NewIndex) = icsVSPYTypeAVT716or716VPW
        .AddItem "Special Test Mode (BETA)"
        .ItemData(.NewIndex) = icsVSPYTypeAVT716Threaded
        .AddItem "GM-VSI or DG-VSI VPW J1850 (Class 2)"
        .ItemData(.NewIndex) = icsVSPYTypeGMVSI
        .AddItem "NI-CAN"
        .ItemData(.NewIndex) = icsVSPYTypeNICAN
        .AddItem "Demo Replay Message Buffer Mode"
        .ItemData(.NewIndex) = icsVSpyTypeDemo
        .AddItem "ActiveX Spy Hardware"
        .ItemData(.NewIndex) = icsVSpyTypeActiveX
    End With
    
    '// the baud rate
    With lstBaudRate
        .Clear
        .AddItem "9600"
        .ItemData(.NewIndex) = icsVSPYBaud9600
        .AddItem "19200"
        .ItemData(.NewIndex) = icsVSPYBaud19200
        .AddItem "28800"
        .ItemData(.NewIndex) = icsVSPYBaud28800
        .AddItem "38400"
        .ItemData(.NewIndex) = icsVSPYBaud38400
        .AddItem "57600"
        .ItemData(.NewIndex) = icsVSPYBaud57600
    End With
    
    '// set the item in the hardware list (it will set the default baud rate)
    For lCount = 1 To lstHardware.ListCount
        If lstHardware.ItemData(lCount - 1) = obApp.HardwareID Then
            lstHardware.ListIndex = lCount - 1
        End If
    Next lCount
    
    '// Setup the baud rate
    For lCount = 1 To lstBaudRate.ListCount
        If lstBaudRate.ItemData(lCount - 1) = obApp.HardwareBaudRate Then
            lstBaudRate.ListIndex = lCount - 1
            Exit For
        End If
    Next lCount
    If lstBaudRate.ListIndex = -1 Then lstBaudRate.ListIndex = 0
    
   
    
    '// Setup the comm port list
    If lstCommPorts.ListCount > 0 Then
        lstCommPorts.ListIndex = obApp.HardwareCommPort - 1
    End If
    
    With obApp
        '// performance settings
        With .Performance
            Select Case .MainEngineSetup
                Case icsspyPerformanceRunInTightLoop
                    optRunMode(0) = True
                Case icsspyRunInWindowsTimerLoop
                    optRunMode(1) = True
            End Select
            txtProcessSleepTime = Format$(.ProcessSleepTimeMs, "0")
            txtDisplayUpdateRate = Format$(.TextMonitorUpdateRateMs)
            Select Case .TextMonitorUpdateType
                Case icsspyPerformanceMonitorForceUpdates
                    optTextMonitorDisplay(0) = True
                Case icsspyPerformanceMonitorDoNotAttempt
                    optTextMonitorDisplay(2) = True
                Case icsspyPerformanceMonitorAttemptButYield
                    optTextMonitorDisplay(1) = True
            End Select
        End With
        
        'lstAVTProtocol.ListIndex = .AVTProtocol
        chkEnableEventSounds = Abs(.UseEventSounds)
        chkUseLogFile = Abs(.UIShowLogFile)
        chkUseLogFile_Click '// update the enabled/disabled state of the buttons
        txtNumberOfFilters = str$(.DefaultNumFilters)
        txtNumberOfMessages = str$(.DefaultNumMessages)
        txtNumberOfTests = str$(.DefaultNumTests)
        bfSimDataFile.FileName = .ReplayFilePath
        
          '// setup the GPS parameters
        With .GPS
            chkUseGPS = Abs(.Enabled)
            lstGPSCommPort.ListIndex = .CommPort - 1
            chkGPSLocation = Abs(.AcquireLocation)
            chkGPSSpeedOverGround = Abs(.AcquireSpeed)
            chkGPSAltitude = Abs(.AcquireAltitude)
            Call .FillComboWithSpeedUnits(lstGPSSpeedUnits)
            lstGPSSpeedUnits.ListIndex = .SpeedUnits
            Call .FillComboWithAltitudeUnits(lstGPSAltitudeUnits)
            lstGPSAltitudeUnits.ListIndex = .AltitudeUnits
            chkGPSSim = Abs(.SimulationMode)
        End With
        
        '// record the analog input
        With .MultiIO
             chkUseAnalogInput = Abs(.Enabled)
        End With
        
        lstSimulationProtocol.ListIndex = .SimulationProtocol
        chkPerformance = Abs(.PerformPerformanceTest)
    End With
    
    '//
    If obApp.MultiIO.ObICSHardware Is Nothing Then
        lblAIDisplay.Enabled = False
        lblAIDisplay = "None Installed - Select New..."
        cmdSetupAI.Enabled = False
    Else
        lblAIDisplay.Enabled = True
        lblAIDisplay = obApp.MultiIO.HardwareDescription
        cmdSetupAI.Enabled = True
        With obApp.MultiIO
            
            Call .FillListWithAnalogInputPoints(lstHardwareChannels)
            lNumberOfItems = .NumberOfChannels
            lvwAIChannels.ListItems.Clear
            For lCount = 1 To lNumberOfItems
                '// add the channel items
                Set lvwItem = lvwAIChannels.ListItems.Add(, , .ChannelDescription(lCount))
                lvwItem.SubItems(1) = lstHardwareChannels.List(.ChannelIndex(lCount))
                lvwItem.Tag = .ChannelIndex(lCount)
            Next lCount
        End With
    End If
    
    
    '// setup the activex bus hardware display
    If obApp.HardwareID = icsVSpyTypeActiveX Then
        If obApp.NetworkHardware Is Nothing Then
            lblActiveXDisplay.Enabled = False
            cmdSetupActiveXHardware.Enabled = False
            lblActiveXDisplay = "None Installed - Select New..."
        Else
            lblActiveXDisplay.Enabled = True
            cmdSetupActiveXHardware.Enabled = True
            lblActiveXDisplay = obApp.NetworkHardware.HardwareDescription
            
        End If
    End If
    
    
    If Err.Number <> 0 Then
        MsgBox "There was an unhandled error in the Options dialog.", vbInformation
    End If
    
    
    
End Sub

Private Sub txtLicenseSiteCode_KeyPress(KeyAscii As Integer)
    KeyAscii = 0
End Sub
