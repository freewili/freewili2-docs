Attribute VB_Name = "cspyGPS"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "SavedWithClassBuilder6" ,"Yes"
Attribute VB_Ext_KEY = "Top_Level" ,"Yes"
Option Explicit

Public Enabled As Boolean
Public CommPort As Long
Public AcquireLocation As Boolean
Public AcquireSpeed As Boolean
Public AcquireAltitude As Boolean
Public AltitudeUnits As icsspygpsAltitudeUnits
Public SpeedUnits As icsspygpsSpeedUnits
Public SimulationMode As Boolean

'// Enumerations
Public Enum icsspygpsSpeedUnits
    icsspygpsMetersPerSecond
    icsspygpsMilesPerHour
    icsspygpsKMPerHour
    icsspygpsKnots
    icsspygpsFeetPerSecond
    icsspygpsCentimetersPerSecond
End Enum

'// altitude units
Public Enum icsspygpsAltitudeUnits
    icsspygpsMeters
    icsspygpsFeet
End Enum

'// default constants
Private Const defEnabled = False
Private Const defCommPort = 1
Private Const defAcquireLocation = True
Private Const defAcquireSpeed = False
Private Const defAcquireAltitude = False
Private Const defAltitudeUnits = icsspygpsFeet
Private Const defSpeedUnits = icsspygpsMilesPerHour
Private Const defSimulationMode = False


Private Sub Class_Initialize()
    MakeNew '// read the defaults from the registry
End Sub

Public Sub MakeNew()
    '// read the settings from the registry
    Enabled = GetSetting("icsVSpy", "Defaults", "GPSEnabled", defEnabled)
    CommPort = GetSetting("icsVSpy", "Defaults", "GPSCommPort", defCommPort)
    AcquireLocation = GetSetting("icsVSpy", "Defaults", "GPSAcquireLocation", defAcquireLocation)
    AcquireSpeed = GetSetting("icsVSpy", "Defaults", "GPSAcquireSpeed", defAcquireSpeed)
    AcquireAltitude = GetSetting("icsVSpy", "Defaults", "GPSAcquireAltitude", defAcquireAltitude)
    SpeedUnits = GetSetting("icsVSpy", "Defaults", "GPSSpeedUnits", defSpeedUnits)
    AltitudeUnits = GetSetting("icsVSpy", "Defaults", "GPSAltitudeUnits", defAltitudeUnits)
    SimulationMode = GetSetting("icsVSpy", "Defaults", "GPSSimulationMode", defSimulationMode)
End Sub

Friend Sub FillComboWithSpeedUnits(lst As ComboBox)
    lst.Clear
    lst.AddItem "Meters Per Second"
    lst.AddItem "Miles Per Hour"
    lst.AddItem "Kilometers Per Hour"
    lst.AddItem "Knots"
    lst.AddItem "Feet Per Second"
    lst.AddItem "Centimeters Per Second"
End Sub

Friend Sub FillComboWithAltitudeUnits(lst As ComboBox)
    lst.Clear
    lst.AddItem "Meters"
    lst.AddItem "Feet"
End Sub

Friend Function ReadWrite(bWriteDirection As Boolean, obSave As cBinaryStorage, lVersion As Long) As Boolean
    'this is it
    Dim vData As Variant
    Dim obPB As New PropertyBag
    Dim vDummy As Variant
    Dim vReturn As Variant
        
    
    If bWriteDirection Then
        
        '// first, write the properties into the bag
        With obPB
            .WriteProperty "GPSEnabled", Enabled, defEnabled
            .WriteProperty "CommPort", CommPort, defCommPort
            .WriteProperty "AcquireLocation", AcquireLocation, defAcquireLocation
            .WriteProperty "AcquireSpeed", AcquireSpeed, defAcquireSpeed
            .WriteProperty "AcquireAltitude", AcquireAltitude, defAcquireAltitude
            .WriteProperty "AltitudeUnits", AltitudeUnits, defAltitudeUnits
            .WriteProperty "SpeedUnits", SpeedUnits, defSpeedUnits
            .WriteProperty "SimulationMode", SimulationMode, defSimulationMode
            
        End With


        '// return the contents of the bag
        vData = obPB.Contents
        
        '// write the array with the binary storage object
        obSave.ReadWriteArray vData
        
    Else
        '// read the array from the binary storage object
        obSave.ReadWriteArray vDummy, vReturn
        
    
        '// fill the property bag if there is somethign in the return array
        If Not IsEmpty(vReturn) Then
            
            '// fill the property bag with the data
            obPB.Contents = vReturn
            
            '// read the data out of the property bag
            With obPB
                Enabled = .ReadProperty("GPSEnabled", defEnabled)
                CommPort = .ReadProperty("CommPort", defCommPort)
                AcquireLocation = .ReadProperty("AcquireLocation", defAcquireLocation)
                AcquireSpeed = .ReadProperty("AcquireSpeed", defAcquireSpeed)
                AcquireAltitude = .ReadProperty("AcquireAltitude", defAcquireAltitude)
                AltitudeUnits = .ReadProperty("AltitudeUnits", defAltitudeUnits)
                SpeedUnits = .ReadProperty("SpeedUnits", defSpeedUnits)
                SimulationMode = .ReadProperty("SimulationMode", defSimulationMode)
                
            End With
        End If
    End If
    

End Function

Public Sub SaveCurrentValuesAsDefault()
    Call SaveSetting("icsVSpy", "Defaults", "GPSEnabled", Enabled)
    Call SaveSetting("icsVSpy", "Defaults", "GPSCommPort", CommPort)
    Call SaveSetting("icsVSpy", "Defaults", "GPSAcquireLocation", AcquireLocation)
    Call SaveSetting("icsVSpy", "Defaults", "GPSAcquireSpeed", AcquireSpeed)
    Call SaveSetting("icsVSpy", "Defaults", "GPSAcquireAltitude", AcquireAltitude)
    Call SaveSetting("icsVSpy", "Defaults", "GPSSpeedUnits", SpeedUnits)
    Call SaveSetting("icsVSpy", "Defaults", "GPSAltitudeUnits", AltitudeUnits)
    Call SaveSetting("icsVSpy", "Defaults", "GPSSimulationMode", SimulationMode)
End Sub
