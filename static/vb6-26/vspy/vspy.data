    Call SaveSetting("icsVSpy", "Defaults", "AVTKWP2000MonitorBaud", m_lKWP2000MonitorBaud)
    Call SaveSetting("icsVSpy", "Defaults", "AVTPWMMode", m_lPWMMode)
    Call SaveSetting("icsVSpy", "Defaults", "AVTISOMode", m_lISOMode)
    Call SaveSetting("icsVSpy", "Defaults", "AVTISOMonitorBaud", m_lISOMonitorBaud)
End Sub

