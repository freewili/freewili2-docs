Private Sub lstIncomingMessageDescription_Change()
    Dim lLocation As Long
    lLocation = SendMessage(lstIncomingMessageDescription.hwnd, CB_FINDSTRING, -1, ByVal lstIncomingMessageDescription.text)  ' lLocation)
    If (lLocation + 1 <= lstIncomingMessageDescription.ListCount) And lLocation > 0 Then
        lstIncomingMessageDescription.TopIndex = lLocation
    End If
End Sub

Private Sub lstIncomingMessageDescription_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditIncoming Then
        If vbKeyReturn = KeyCode Then
            LeaveCellIncomingMessages
            If lstIncomingMessageDescription.ListIndex = -1 Then
                Call GotoNextColumn(grdIncomingMessages)
            Else
                Call GotoNextRow(grdIncomingMessages)
            End If
        End If
        If vbKeyEscape = KeyCode Then LeaveCellIncomingMessages (True)
    End If
End Sub
Private Sub lstIncomingMessageValueType_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditIncoming Then
        If vbKeyReturn = KeyCode Then
            LeaveCellIncomingMessages
            Call GotoNextColumn(grdIncomingMessages)
        End If
        If vbKeyEscape = KeyCode Then LeaveCellIncomingMessages (True)
    End If
End Sub

Private Sub lstOutgoingMessageDescription_Change()
    Dim lLocation As Long
    lLocation = SendMessage(lstOutgoingMessageDescription.hwnd, CB_FINDSTRING, -1, ByVal lstOutgoingMessageDescription.text)  ' lLocation)
    If (lLocation + 1 <= lstOutgoingMessageDescription.ListCount) And lLocation > 0 Then
        lstOutgoingMessageDescription.TopIndex = lLocation
    End If
End Sub

Private Sub lstOutgoingMessageDescription_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditOutgoing Then
        
        If vbKeyReturn = KeyCode Then
            Call LeaveCellOutgoingMessages

            If lstOutgoingMessageDescription.ListIndex = -1 Then
                Call GotoNextColumn(grdOutgoingMessages)
            Else
                Call GotoNextRow(grdOutgoingMessages)
            End If
        End If
        
        
    
        If vbKeyEscape = KeyCode Then Call LeaveCellOutgoingMessages(True)
    End If
End Sub

Private Sub lstOutgoingMessageType_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditOutgoing Then
        If vbKeyReturn = KeyCode Then: Call LeaveCellOutgoingMessages: Call GotoNextColumn(grdOutgoingMessages)
        If vbKeyEscape = KeyCode Then Call LeaveCellOutgoingMessages(True)
    End If
End Sub



Private Sub lstOutgoingMessageTxRate_KeyDown(KeyCode As Integer, Shift As Integer)
    If bEditOutgoing Then
        If vbKeyReturn = KeyCode Then
            Call LeaveCellOutgoingMessages
            Call GotoNextColumn(grdOutgoingMessages)
        End If
        If vbKeyEscape = KeyCode Then Call LeaveCellOutgoingMessages(True)
    End If
