Private m_aTab As msComctlLib.Tab           '// this is the tab on the main dialog
Public aTxTab As msComctlLib.Tab            '// this is the tab on the tx dialog
Public sFunction As String
Public InterMessageDelaySec As Double

'// keep the number of messages associated with this button
Private lMessages() As String
Private lNumMessages As Long

Private mCaption As String        '// caption attached to the TX button
Private mHotKeyCaption As String


Public Property Get aTab() As msComctlLib.Tab
    Set aTab = m_aTab
End Property
Public Property Set aTab(obNew As msComctlLib.Tab)
    Dim sNew As String
    
    '// set a ref to the private object
    Set m_aTab = obNew
    
    '// setup the default caption
    If m_aTab.Index = 1 Then
        sNew = "X"
    ElseIf m_aTab.Index > 1 And m_aTab.Index <= 9 Then
        sNew = "F" & (m_aTab.Index - 1)
    End If
    
    '// set default caption
    mHotKeyCaption = sNew
    
End Property

Public Property Get HotKeyCaption() As String
    HotKeyCaption = mHotKeyCaption
End Property

Public Property Get FullCaption() As String
    If mHotKeyCaption <> "" Then
        FullCaption = mHotKeyCaption & " - " & Caption
    Else
        FullCaption = Caption
    End If
End Property

'// the name of the group
Public Property Get Caption() As String
    Caption = mCaption
End Property
Public Property Let Caption(sNew As String)
    Dim sNewHotKey As String
    Dim sFull As String
    
    mCaption = sNew
    sFull = FullCaption
    
    If Not (m_aTab Is Nothing) Then

        If m_aTab.Caption <> sFull Then
            m_aTab.Caption = sFull
        End If

        '/// the txtab should exist only if main tab exists
        If Not (aTxTab Is Nothing) Then
            If aTxTab.Caption <> sFull Then
                aTxTab.Caption = sFull
            End If
        End If
    End If
    
End Property

Public Property Let NumberOfMessages(lMax As Long)
    If lMax > 0 Then
        ReDim Preserve lMessages(1 To lMax)
        lNumMessages = lMax
    End If
End Property
Public Property Get NumberOfMessages() As Long
    NumberOfMessages = lNumMessages
End Property


Public Sub SetMessage(lIndex As Long, sKey As String)
    lMessages(lIndex) = sKey
End Sub
Public Function GetMessage(lIndex As Long) As String
    GetMessage = lMessages(lIndex)
End Function

'// this function transmits all of the messages in the messages setup
Friend Sub TransmitMessages(obApp As cicsSpy)
    Dim lCount As Long
    Dim lIndexToTx As Long
    Dim sString As String
    Dim lTransmitInterval As Long
    Dim lTransmitIntervalCount As Long
    
    '// determine the transmit interval
    If InterMessageDelaySec < 214748 Then
        lTransmitInterval = CLng(InterMessageDelaySec * 1000)
    End If
    '// first, setup all of the analog messages
    For lCount = 1 To lNumMessages
        lIndexToTx = obApp.OutgoingMessages.ReturnIndexFromKey(lMessages(lCount))
        If lIndexToTx > 0 And lIndexToTx <= obApp.OutgoingMessages.Count Then
            '// is this an analog message or a digital message
            If obApp.OutgoingMessages(lIndexToTx).ValueType = icsVSPYAnalogoutput Then
                sString = InputBox("Enter a value in decimal for message: " & _
                    obApp.OutgoingMessages(lIndexToTx).Description, _
                        "Enter the analog output value for this message")
                If Len(Trim$(sString)) <> 0 Then
                    obApp.OutgoingMessages(lIndexToTx).Value = Val(sString)
                End If
            End If
        End If
    Next lCount


    '// now, transmit all the messages
    For lCount = 1 To lNumMessages
        lIndexToTx = obApp.OutgoingMessages.ReturnIndexFromKey(lMessages(lCount))
        If lIndexToTx > 0 And lIndexToTx <= obApp.OutgoingMessages.Count Then
            If lTransmitInterval = 0 Then
                Call obApp.Transmit(lIndexToTx)
            Else
                If lNumMessages = 1 Then
                    Call obApp.TransmitWithTimeStamp(lIndexToTx, timeGetTime + lTransmitInterval)
                Else
                    Call obApp.TransmitWithTimeStamp(lIndexToTx, timeGetTime + (lTransmitInterval * lTransmitIntervalCount))
                    lTransmitIntervalCount = lTransmitIntervalCount + 1
                End If
            End If
        End If
    Next lCount
    
End Sub

'// the key property must be set before calling this function
Friend Sub ReadWrite(bWriteDirection As Boolean, _
            obPB As PropertyBag, lIndex As Long)
    Dim lCount As Long
    Dim bV20 As Boolean
    Dim lMsgIndex As Long
    
    If bWriteDirection Then
        '// store the properties to the bag
        With obPB
            Call .WriteProperty("V20" & lIndex, True, False)
            Call .WriteProperty("Caption" & lIndex, mCaption, "")
            Call .WriteProperty("NumberOfMessages" & lIndex, lNumMessages, 0)
            '// Write the message indexes
            For lCount = 1 To lNumMessages
                Call .WriteProperty("TxMessage" & lIndex & "msg" & lCount, GetMessage(lCount), 0)
            Next lCount
        End With
    Else
        '// read the properties from the property bag
        With obPB
            bV20 = .ReadProperty("V20" & lIndex, False)
            
            mCaption = .ReadProperty("Caption" & lIndex, "")
            NumberOfMessages = .ReadProperty("NumberOfMessages" & lIndex, 0) '// set via the property method (it allocates space for messages
            
            If bV20 Then
                '// Read the message keys
                For lCount = 1 To lNumMessages
                    Call SetMessage(lCount, .ReadProperty("TxMessage" & lIndex & "msg" & lCount, 0))
                Next lCount
            Else
                '// Read the message indexes
                For lCount = 1 To lNumMessages
                    lMsgIndex = .ReadProperty("TxMessage" & lIndex & "msg" & lCount, 0)
                    Call SetMessage(lCount, "out" & lMsgIndex)
                Next lCount
            End If
        End With
    End If
        
End Sub

 
