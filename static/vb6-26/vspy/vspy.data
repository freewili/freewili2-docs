Public Function ReturnStatusBitDescriptions() As Variant
    Dim bDescriptions(31) As String
    Dim lCount As Long
    
    bDescriptions(0) = "Global Error"
    bDescriptions(1) = "Tx Message"
    bDescriptions(2) = "CAN Protocol"
    bDescriptions(3) = "Remote frame"
    bDescriptions(4) = "CRC Error"
    bDescriptions(5) = "Hardware Timed"
    bDescriptions(6) = "Incomplete Frame/Message"
    bDescriptions(7) = "Tx Lost Arbitration"
    bDescriptions(8) = "Undefined Error"
    bDescriptions(9) = "Msg Has value"
    bDescriptions(10) = "Msg value is digital"
    bDescriptions(11) = "Bus shorted plus"
    bDescriptions(12) = "Bus shorted gnd"
    bDescriptions(13) = "VSI Checksum Error"
    bDescriptions(14) = "Bad Message/Bit Time Error"
    bDescriptions(15) = "IFR Data"
    bDescriptions(16) = "Comm Rx Port Overflow"
    bDescriptions(17) = "Comm Tx Port Overflow"
    bDescriptions(18) = "Comm Port Misc Error"
    bDescriptions(19) = "Break"
    bDescriptions(20) = "AVT DLC/VSI FIFO Rx Overflow"
    bDescriptions(21) = "Test Trigger"
    bDescriptions(22) = "Audio Comment"
    bDescriptions(23) = "GPS Data Value"
    bDescriptions(24) = "Analog/Digital Hardware Data"
    bDescriptions(25) = "Text Comment Type"
    bDescriptions(26) = "Network Message Type"
    bDescriptions(27) = "VSI Tx Under run"
    bDescriptions(28) = "VSI IFR CRC Bit"
    
    For lCount = 29 To 31
        bDescriptions(lCount) = "Reserved"
    Next lCount
    
    ReturnStatusBitDescriptions = bDescriptions

End Function


'// This function prints the header line in the picture box
Public Sub PrintHeaderLine(pct As PictureBox, lDefaultColor As Long, bCANMode As Boolean)
    
    Dim lCount As Long
    Dim hdc As Long
    Dim lTwipsX As Long
    Dim lTwipsY As Long
    Dim lTextHeight As Long
    Dim pnt1 As POINTAPI
    Dim lTotalUsed As Long
    Dim lOldBackColor
    

    
    '// make sure header is drawn in black
'    lOldBackColor = pct.BackColor
'    pct.BackColor = lDefaultColor
    pct.ForeColor = pct.BackColor
        
    '// Print the divider line
    lTextHeight = pct.TextHeight("A")
    'MoveToEx hdc, 0, lTextHeight \ lTwipsY, pnt1
    'LineTo hdc, pct.ScaleWidth \ lTwipsX, lTextHeight \ lTwipsY
    pct.FillColor = lDefaultColor
    pct.Line (0, 0)-(pct.ScaleWidth, lTextHeight), lDefaultColor, BF
    
    pct.FontBold = False
    
    '//
    XLINE = 200
    XTIME = pct.TextWidth("XXXXXX0X0") + XLINE '1000
    XTX = pct.TextWidth("00:00:00.00000") + XTIME '2000
    XERR = XTX + pct.TextWidth("Tx") '2250
    XTYPE = XERR + pct.TextWidth("Er ") '2600
    
    If mShowDescription Then
        XMAXDESWIDTH = pct.TextWidth("Description  ")
    Else
        XMAXDESWIDTH = 0
    End If
    
    
    XARB = XPT
    XRMT = XARB + pct.TextWidth("0000000")
    
    '// cache the appropiate properties
    hdc = pct.hdc
    lTwipsX = Screen.TwipsPerPixelX
    lTwipsY = Screen.TwipsPerPixelY
    
    '// set the first data byte location
    XWIDTHOFBYTES = pct.TextWidth("XXX") + pct.TextWidth("X") \ 2
    XPT = XTYPE + XMAXDESWIDTH
    XTG = XPT + XWIDTHOFBYTES
    XSC = XTG + XWIDTHOFBYTES
    XB1 = XSC + XWIDTHOFBYTES
    If mShowDataBytes Then
        XVALUE = XB1 + (XWIDTHOFBYTES * 8)
    Else
        XVALUE = XPT
    End If
    
    
    
    If mShowDescription Then
        '// change the location to maximize screen width
        lTotalUsed = XVALUE + pct.TextWidth("1234.2331")
        If lTotalUsed < pct.ScaleWidth Then
            '// recalculate paramters
            XMAXDESWIDTH = pct.ScaleWidth - lTotalUsed + XMAXDESWIDTH
            XPT = XTYPE + XMAXDESWIDTH '+ (pct.ScaleWidth - XVALUE - pct.TextWidth("1234.21"))
            
            XTG = XPT + XWIDTHOFBYTES
            XSC = XTG + XWIDTHOFBYTES
            XB1 = XSC + XWIDTHOFBYTES
            
            '// do we need to show the data bytes
            If mShowDataBytes Then
                XVALUE = XB1 + (XWIDTHOFBYTES * 8)
            Else
                XVALUE = XPT
            End If
        
            'XPT = pct.ScaleWidth - 5200
        End If
    End If
    
    '// Draw the first line of text
    TextOut hdc, XTX \ lTwipsX, 0, "Tx", 2
    TextOut hdc, XLINE \ lTwipsX, 0, "Line", 4
    TextOut hdc, XTIME \ lTwipsX, 0, "Time", 4
    TextOut hdc, XERR \ lTwipsX, 0, "Er", 2
    TextOut hdc, XVALUE \ lTwipsX, 0, "Value", 5
    
    If mShowDescription Then TextOut hdc, XTYPE \ lTwipsX, 0, "Description", 11
        
        
    If mShowDataBytes Then
        '// display based if in can mode or not
        If bCANMode Then
            TextOut hdc, XPT \ lTwipsX, 0, "Arb ID", 6
            TextOut hdc, XRMT \ lTwipsX, 0, "R", 1
        Else
            TextOut hdc, XPT \ lTwipsX, 0, "PT", 2
            TextOut hdc, XSC \ lTwipsX, 0, "SC", 2
            TextOut hdc, XTG \ lTwipsX, 0, "Tg", 2
        End If
        
        
        '// Print the data byte header
        For lCount = 1 To 8
            TextOut hdc, (XB1 + (lCount - 1) * XWIDTHOFBYTES) \ lTwipsX, 0, "B" & lCount, 2
        Next lCount
    End If
        

    
    '//
   ' pct.BackColor = lOldBackColor
    pct.ForeColor = lDefaultColor
    
    
End Sub
 
Public Sub PrintDataInPictureBox()
    Dim lresult As Long
    Dim hdc As Long
    
    '// Save the device context
    lresult = SaveDC(hdc)
    
End Sub

Public Sub PrintDataRow(obApp As cicsSpy, imlPic As ImageList, _
    pct As PictureBox, lItem As Long, lHeight As Long, msg As icsSpyMessageJ1850, _
    canmsg As icsSpyMessage, dTime As Double, lDefaultColor As Long, CanMode As Boolean)

    Dim lNumItems As Long
    Dim lByteCount As Long
    Dim sBuff As String
    Dim sTime As String
    Dim lLen As Long
    Dim sDescription As String
    Dim lCount As Long
    Dim hdc As Long
    Dim lTwipsX As Long
    Dim lTwipsY As Long
    Dim lTextHeight As Long
    Dim pnt1 As POINTAPI
    Dim sMsg As String
    Dim lNewColor As Long
    Dim lHalfText As Long
    Dim spyGPS As icsSpyMessageGPS
    Dim spyAnalog As icsSpyMessageAnalog
    Dim lStatusField As Long
    Dim spyLng As icsSpyMessageLong

    
    '// cache the appropiate properties
    hdc = pct.hdc
    lTwipsX = Screen.TwipsPerPixelX
    lTwipsY = Screen.TwipsPerPixelY

    If CanMode Then
        lStatusField = canmsg.StatusBitField
    Else
        lStatusField = msg.StatusBitField
    End If

    '// the trigger LED
    If (lStatusField And icsSpyStatusTestTrigger) > 0 Then
        Call imlPic.ListImages(3).Draw(hdc, 0, lHeight, 1)
        pct.FontBold = True
    End If
    
    '// the error led
    If (lStatusField And icsSpyStatusGlobalError) <> 0 Then
        Call imlPic.ListImages(1).Draw(hdc, XERR, lHeight, 1)
    End If
    

    If (lStatusField And icsSpyStatusGPSDataValue) > 0 Then '// this is a message of type GPS
        '// it is a gps message
        If CanMode Then
            LSet spyGPS = canmsg
        Else
            LSet spyGPS = msg
        End If
        pct.ForeColor = lDefaultColor
        '// handle the different types of GPS data available
        Select Case spyGPS.GPSDataID
            Case SPY_GPS_LOCATION
                sDescription = "GPS Lat: " & Format$(spyGPS.Value1, "0.00000") & " Long: " & Format$(spyGPS.Value2, "0.00000")
            Case SPY_GPS_ALTITUDE
                sDescription = "GPS Altitude: " & spyGPS.Value1
            Case SPY_GPS_SPEED
                sDescription = "GPS Speed: " & spyGPS.Value1
        End Select
        '// write the description of the text
        TextOut hdc, XTYPE \ lTwipsX, lHeight \ lTwipsY, sDescription, Len(sDescription)
        
        '// Print the line number
        sMsg = Format(lItem + 1)
        TextOut hdc, XLINE \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
    
        '// Print the Time
        sMsg = StepValueToTime(dTime, obApp.Protocol = icsVSPYProtocolCAN)  ' Format(dTime, "0.000")
        TextOut hdc, XTIME \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
        Exit Sub
    ElseIf (lStatusField And icsSpyStatusAnalogDigitalInputValue) > 0 Then '// this is a message of type analog
        '// this is an analog reading
        If CanMode Then
            LSet spyAnalog = canmsg
        Else
            LSet spyAnalog = msg
        End If
        pct.ForeColor = lDefaultColor
        If spyAnalog.AIDataID > 0 And spyAnalog.AIDataID <= obApp.MultiIO.NumberOfChannels Then
            sDescription = obApp.MultiIO.ChannelDescription(spyAnalog.AIDataID) & " : " & Format$(spyAnalog.Value, "0.0000")
        Else
            sDescription = "Undefined Analog : " & Format$(spyAnalog.Value, "0.0000")
        End If
        '// write the description of the text
        TextOut hdc, XTYPE \ lTwipsX, lHeight \ lTwipsY, sDescription, Len(sDescription)
    
        '// Print the line number
        sMsg = Format(lItem + 1)
        TextOut hdc, XLINE \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
    
        '// Print the Time
        sMsg = StepValueToTime(dTime, obApp.Protocol = icsVSPYProtocolCAN)  ' Format(dTime, "0.000")
        TextOut hdc, XTIME \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
        Exit Sub
    ElseIf (lStatusField And icsSpyStatusTextCommentType) > 0 Then '// this is a message of type analog
        '// this is an analog reading
        If CanMode Then
            LSet spyLng = canmsg
        Else
            LSet spyLng = msg
        End If
        pct.ForeColor = lDefaultColor
        
        sDescription = "Entered Text Comment " & Format$(spyLng.Value, "0")
        
        '// write the description of the text
        TextOut hdc, XTYPE \ lTwipsX, lHeight \ lTwipsY, sDescription, Len(sDescription)
    
        '// Print the line number
        sMsg = Format(lItem + 1)
        TextOut hdc, XLINE \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
    
        '// Print the Time
        sMsg = StepValueToTime(dTime, obApp.Protocol = icsVSPYProtocolCAN)  ' Format(dTime, "0.000")
        TextOut hdc, XTIME \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
        Exit Sub
    ElseIf (lStatusField And icsSpyStatusAudioCommentType) > 0 Then '// this is a message of type analog
        '// this is an analog reading
        If CanMode Then
            LSet spyLng = canmsg
        Else
            LSet spyLng = msg
        End If
        pct.ForeColor = lDefaultColor
        
        sDescription = "Entered Audio Comment " & Format$(spyLng.Value, "0")
        
        '// write the description of the text
        TextOut hdc, XTYPE \ lTwipsX, lHeight \ lTwipsY, sDescription, Len(sDescription)
        
        '// Print the line number
        sMsg = Format(lItem + 1)
        TextOut hdc, XLINE \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
    
        '// Print the Time
        sMsg = StepValueToTime(dTime, obApp.Protocol = icsVSPYProtocolCAN)  ' Format(dTime, "0.000")
        TextOut hdc, XTIME \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
        Exit Sub
    Else
        '// its a data message
        If CanMode Then
            If (canmsg.StatusBitField And icsSpyStatusTx) <> 0 Then
                pct.ForeColor = lDefaultColor '// set the default color for tx messages
                Call imlPic.ListImages(2).Draw(hdc, XTX, lHeight, 1)
                If canmsg.DescriptionID <= obApp.OutgoingMessages.Count And (canmsg.DescriptionID <> 0) Then
                    sDescription = obApp.OutgoingMessages(canmsg.DescriptionID).Description
                End If
            Else
                '// This is a received frame
                If canmsg.DescriptionID <> 0 Then
                    If canmsg.DescriptionID <= obApp.IncomingMessages.Count Then
                        '// update the color
                        lNewColor = obApp.IncomingMessages(canmsg.DescriptionID).DisplayColor
                        If lNewColor = 0 Then
                            pct.ForeColor = lDefaultColor
                        Else
                            pct.ForeColor = lNewColor
                        End If
                        
                        sDescription = obApp.IncomingMessages(canmsg.DescriptionID).Description
                        
                         '// print the value
                        If (canmsg.StatusBitField And icsSpyStatusHasValue) <> 0 Then
                            If (canmsg.StatusBitField And icsSpyStatusValueIsBoolean) <> 0 Then
                                sMsg = Format(CBool(canmsg.Value))
                            Else
                                sMsg = Format(canmsg.Value)
                            End If
                            TextOut hdc, XVALUE \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
                        End If '(canmsg.StatusBitField And icsSpyStatusHasValue) <> 0
                        
                    Else 'canmsg.DescriptionID <= obApp.IncomingMessages.Count
                        pct.ForeColor = lDefaultColor
                    End If
                Else 'canmsg.DescriptionID <> 0
                    pct.ForeColor = lDefaultColor
                End If
            End If
        Else
            
            '// is this a tranmit type frame
            If (msg.StatusBitField And icsSpyStatusTx) <> 0 Then
                '// Yes it is...
                pct.ForeColor = lDefaultColor '// set the default color for tx messages
                Call imlPic.ListImages(2).Draw(hdc, XTX, lHeight, 1)
                If msg.DescriptionID <= obApp.OutgoingMessages.Count And (msg.DescriptionID <> 0) Then
                    sDescription = obApp.OutgoingMessages(msg.DescriptionID).Description
                End If
            Else
                '// This is a received frame
                If msg.DescriptionID <> 0 Then
                    If msg.DescriptionID <= obApp.IncomingMessages.Count Then
                        '// update the color
                        lNewColor = obApp.IncomingMessages(msg.DescriptionID).DisplayColor
                        If lNewColor = 0 Then
                            pct.ForeColor = lDefaultColor
                        Else
                            pct.ForeColor = lNewColor
                        End If
                        
                        '// get the description
                        sDescription = obApp.IncomingMessages(msg.DescriptionID).Description
                        
                        '// print the value
                        If (msg.StatusBitField And icsSpyStatusHasValue) <> 0 Then
                            If (msg.StatusBitField And icsSpyStatusValueIsBoolean) <> 0 Then
                                sMsg = Format(CBool(msg.Value))
                            Else
                                sMsg = Format(msg.Value)
                            End If
                            TextOut hdc, XVALUE \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
                        End If '(msg.StatusBitField And icsSpyStatusHasValue) <> 0
                    Else
                        pct.ForeColor = lDefaultColor
                    End If 'msg.DescriptionID <= obApp.IncomingMessages.Count
                Else
                    pct.ForeColor = lDefaultColor
                End If 'msg.DescriptionID <> 0
            End If
        End If
    End If
    
    '// Print the line number
    sMsg = Format(lItem + 1)
    TextOut hdc, XLINE \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)

    '// Print the Time
    sMsg = StepValueToTime(dTime, CanMode) ' Format(dTime, "0.000")
    TextOut hdc, XTIME \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)

    '// Print the description if setup
    If mShowDescription Then
        Do Until pct.TextWidth(sDescription) < XMAXDESWIDTH
            sDescription = Left$(sDescription, Len(sDescription) - 4) & "..."
        Loop
        TextOut hdc, XTYPE \ lTwipsX, lHeight \ lTwipsY, sDescription, Len(sDescription)
    End If
    
   
    
    If mShowDataBytes Then
        '// Was this a tx frame
        If CanMode Then
            '// setup for a arb ID or header
            sMsg = Format(canmsg.ArbIDOrHeader, "0")
            TextOut hdc, XARB \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
            
            '// Print a y/n indicating a remote frame or not
            If (canmsg.StatusBitField And icsSpyStatusRemoteFrame) > 0 Then
                TextOut hdc, XRMT \ lTwipsX, lHeight \ lTwipsY, "Y", 1
            Else
                TextOut hdc, XRMT \ lTwipsX, lHeight \ lTwipsY, "N", 1
            End If
        
            '// now the data
            lNumItems = canmsg.NumberBytesData
            For lByteCount = 1 To lNumItems
                Select Case mShowType
                    Case 0 ' hex
                        sMsg = Hex(canmsg.data(lByteCount))
                        If Len(sMsg) = 1 Then
                            sMsg = "0" & sMsg
                        End If
                        TextOut hdc, (XB1 + (lByteCount - 1) * XWIDTHOFBYTES) \ lTwipsX, lHeight \ lTwipsY, sMsg, 2
                    Case 1 ' dec
                        sMsg = canmsg.data(lByteCount)
                        TextOut hdc, (XB1 + (lByteCount - 1) * XWIDTHOFBYTES) \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
                    Case 2 'asc
                        sMsg = Chr$(canmsg.data(lByteCount))
                        TextOut hdc, (XB1 + (lByteCount - 1) * XWIDTHOFBYTES) \ lTwipsX, lHeight \ lTwipsY, sMsg, 1
                End Select
            Next lByteCount
        Else
            '// first setup the header
            lNumItems = msg.NumberBytesHeader
            For lByteCount = 1 To lNumItems
                Select Case mShowType
                    Case 0 ' hex
                        sMsg = Hex(msg.Header(lByteCount))
                        If Len(sMsg) = 1 Then
                            sMsg = "0" & sMsg
                        End If
                        TextOut hdc, (XPT + (lByteCount - 1) * XWIDTHOFBYTES) \ lTwipsX, lHeight \ lTwipsY, sMsg, 2
                    Case 1 ' dec
                        sMsg = msg.Header(lByteCount)
                        TextOut hdc, (XPT + (lByteCount - 1) * XWIDTHOFBYTES) \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
                    Case 2 ' asc
                        sMsg = Chr$(msg.Header(lByteCount))
                        TextOut hdc, (XPT + (lByteCount - 1) * XWIDTHOFBYTES) \ lTwipsX, lHeight \ lTwipsY, sMsg, 1
                End Select
            Next lByteCount
    
            '// now the data
            lNumItems = msg.NumberBytesData
            For lByteCount = 1 To lNumItems
                Select Case mShowType
                    Case 0 ' hex
                        sMsg = Hex(msg.data(lByteCount))
                        If Len(sMsg) = 1 Then
                            sMsg = "0" & sMsg
                        End If
                        TextOut hdc, (XB1 + (lByteCount - 1) * XWIDTHOFBYTES) \ lTwipsX, lHeight \ lTwipsY, sMsg, 2
                    Case 1 ' dec
                        sMsg = msg.data(lByteCount)
                        TextOut hdc, (XB1 + (lByteCount - 1) * XWIDTHOFBYTES) \ lTwipsX, lHeight \ lTwipsY, sMsg, Len(sMsg)
                    Case 2 ' asc
                        sMsg = Chr$(msg.data(lByteCount))
                        TextOut hdc, (XB1 + (lByteCount - 1) * XWIDTHOFBYTES) \ lTwipsX, lHeight \ lTwipsY, sMsg, 1
                End Select
            Next lByteCount
        End If
    End If
    
    '// turn off bold if it was turned on
    If (lStatusField And icsSpyStatusTestTrigger) > 0 Then
        pct.FontBold = False
    End If

End Sub





Public Function GetSpyTimeSec(StartTime As SpyMsgTime, StopTime As SpyMsgTime) As Double
Dim lDiff As Long
Dim lSysDiff As Long
Dim lNumOverFlows As Long

If StartTime.HardwareTimePresent And StopTime.HardwareTimePresent Then
    
    '// hardware time present
    lSysDiff = StopTime.SystemTimeMs - StartTime.SystemTimeMs
    lNumOverFlows = lSysDiff \ 60000
    
    lDiff = StopTime.HardwareTimeMs - StartTime.HardwareTimeMs
    If lDiff < 0 Then
        lDiff = 60000 - StartTime.HardwareTimeMs + StopTime.HardwareTimeMs
    End If
    
    '// get the actual time by adding the number of overflows
    lDiff = lDiff + lNumOverFlows * 60000
    
    '// did we make a rounding error higher? (assume clocks will be within 20 sec)
    If (lSysDiff - lDiff) > 20000 Then
        lDiff = lDiff + 60000
    End If
    
    '// did we make a rounding error lower (assume clocks will be within 20 sec)
    If (lSysDiff - lDiff) < -20000 Then
        lDiff = lDiff - 60000
    End If
    
    'Debug.Print "Terr: " & (lSysDiff - lDiff)
    
    '// check for remaining errors //////
    If (lSysDiff - lDiff) > 10000 Or (lSysDiff - lDiff) < -10000 Then
        '// use the system time instead
        GetSpyTimeSec = Abs(StopTime.SystemTimeMs - StartTime.SystemTimeMs) / 1000
        
'        MsgBox "System Time used at " & GetSpyTimeSec
'        Stop
'        Debug.Print "Timing Error: ********************************************************"
'        Debug.Print "Calculated Time: " & lDiff
'        Debug.Print "Hardware Diff: " & (StopTime.HardwareTimeMs - StartTime.HardwareTimeMs)
'        Debug.Print "System Diff: " & lSysDiff
'        Debug.Print "Hardware Start: " & StartTime.HardwareTimeMs
'        Debug.Print "Hardware Stop: " & StopTime.HardwareTimeMs
'        Debug.Print "System Start: " & StartTime.SystemTimeMs
'        Debug.Print "System Stop: " & StopTime.SystemTimeMs
'        Debug.Print "**********************************************************************"
    End If
    
    GetSpyTimeSec = CDbl(lDiff) / 1000
Else
    '// no hardware time present
    GetSpyTimeSec = Abs(StopTime.SystemTimeMs - StartTime.SystemTimeMs) / 1000
End If

End Function

' function returns the hardware system time from a message
Public Function MsgHardwareTime(MessageBytes() As Byte) As Long
    '// Bytes 1 and 2 indicate the hardware time
    MsgHardwareTime = MessageBytes(1) * 256 + MessageBytes(2)
End Function

' function returns the system time from a message
Public Function MsgSystemTime(MessageBytes() As Byte) As Long
    Call CopyData(MessageBytes(3), MsgSystemTime, 4)
End Function

' function returns the number of message bytes from a buffer
Public Function MsgNumberOfBytes(MessageBytes() As Byte) As Long
    MsgNumberOfBytes = UBound(MessageBytes) - MSGFIRSTBYTE + 1
End Function

