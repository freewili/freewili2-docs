Private Sub gTest_OLEDragDrop(data As MSFlexGridLib.DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim sFiles() As String
    Dim lCount As Long
    '// transfer filenames to a string array
    If data.GetFormat(vbCFFiles) Then
        ReDim sFiles(1 To data.Files.Count)
        For lCount = 1 To data.Files.Count
            sFiles(lCount) = data.Files(lCount)
        Next lCount
        '// handle the drag/drop
        HandleOLEDragDropDataFiles False, sFiles, data.Files.Count
    End If
    
End Sub

Private Sub gTest_OLEDragOver(data As MSFlexGridLib.DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single, State As Integer)
    Dim lCount As Long
    Dim sFile As String
    Dim bDropOk As Boolean

    '// do not allow drops during run
    If obApp.MonitorOn Then
        Effect = vbDropEffectNone
        Exit Sub
    End If
    
    '// The picture box only accepts files
    If data.GetFormat(vbCFFiles) Then
        For lCount = 1 To data.Files.Count
            sFile = data.Files(lCount)  '// get the file name
            If Len(sFile) > 4 Then
                If LCase(Right$(sFile, 4)) = ".csv" Then
                    bDropOk = True
                    Exit For
                End If
            End If
        Next lCount
        If Not bDropOk Then Effect = vbDropEffectNone
    Else
        Effect = vbDropEffectNone
    End If
End Sub

