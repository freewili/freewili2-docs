Private Sub mnuIncomingFillDown_Click()
    Dim lCount As Long
    Dim lStartRow As Long
    Dim lStopRow As Long
    Dim lMinCol As Long
    Dim lMaxCol As Long
    Dim lSwap As Long
    Dim sMsgToCopy  As String
    
    '// turn off the grid repainting
    grdIncomingMessages.Redraw = False
    MousePointer = vbHourglass
    
    
    '// setup the parameters
    sMsgToCopy = grdIncomingMessages.TextMatrix(grdIncomingMessages.Row, 0)
    
    lStartRow = grdIncomingMessages.Row
    lStopRow = grdIncomingMessages.RowSel
    If lStartRow > lStopRow Then
        lSwap = lStartRow
        lStartRow = lStopRow
        lStopRow = lSwap - 1 ' minus one needed because do not need the current row
    Else
        lStartRow = lStartRow + 1
    End If
    lMinCol = grdIncomingMessages.Col
    lMaxCol = grdIncomingMessages.ColSel
    If lMaxCol < lMinCol Then
        lSwap = lMinCol
        lMinCol = lMaxCol
        lMaxCol = lSwap
    End If
    
    '// cached inital values
    Dim lInitalColor As Long
    Dim lInitalResponse As Long
    Dim lInitalRequest As Long
    Dim lInitalValueType As Long
    Dim lInitalValueSource As Long
    Dim sInitalEquation As String
    Dim sInitalDescription As String
    Dim sInitalStatus As String
    Dim sInitalDataByte1 As String
    Dim sInitalDataByte2 As String
    Dim sInitalDataByte3 As String
    Dim sInitalDataByte4 As String
    Dim sInitalDataByte5 As String
    Dim sInitalDataByte6 As String
    
    '// first handle all non-message bytes
    With obApp.IncomingMessages
        '// get the color to fill down with
        With .Item(sMsgToCopy)
            lInitalColor = .DisplayColor
            lInitalResponse = .ResponseIndex
            lInitalRequest = .RequestIndex
            lInitalValueType = .ValueType
            lInitalValueSource = .ValueSource
            sInitalEquation = .Equation
            sInitalDescription = .Description
            sInitalStatus = .Status
            sInitalDataByte1 = .DataByteString(1)
            sInitalDataByte2 = .DataByteString(2)
            sInitalDataByte3 = .DataByteString(3)
            sInitalDataByte4 = .DataByteString(4)
            sInitalDataByte5 = .DataByteString(5)
            sInitalDataByte6 = .DataByteString(6)
        End With
            
        '// cycle through applicable messages
        For lCount = lStartRow To lStopRow
            With .Item(grdIncomingMessages.TextMatrix(lCount, 0))
                If FillDownColPassed(mInMsgColorCol, lMinCol, lMaxCol) Then
                    .DisplayColor = lInitalColor
                End If
                If FillDownColPassed(mInMsgReponseCol, lMinCol, lMaxCol) Then
                    .ResponseIndex = lInitalResponse
                End If
                If FillDownColPassed(mInMsgRequestCol, lMinCol, lMaxCol) Then
                    .RequestIndex = lInitalRequest
                End If
                If FillDownColPassed(mInMsgValueTypeCol, lMinCol, lMaxCol) Then
                    .ValueType = lInitalValueType
                End If
                If FillDownColPassed(mInMsgValueSourceCol, lMinCol, lMaxCol) Then
                    .ValueSource = lInitalValueSource
                End If
                If FillDownColPassed(mInMsgEquationCol, lMinCol, lMaxCol) Then
                    .Equation = sInitalEquation
                End If
                If FillDownColPassed(mInMsgDescriptionCol, lMinCol, lMaxCol) Then
                    .Description = sInitalDescription
                End If
                If FillDownColPassed(mInMsgStatusCol, lMinCol, lMaxCol) Then
                    .Status = sInitalStatus
                End If
                
                '// the message bytes
                If FillDownColPassed(mInMsgFirstHeaderCol, lMinCol, lMaxCol) Then
                    .DataByteString(1) = sInitalDataByte1
                End If
                If FillDownColPassed(mInMsgFirstHeaderCol + 1, lMinCol, lMaxCol) Then
                    .DataByteString(2) = sInitalDataByte2
                End If
                If FillDownColPassed(mInMsgFirstHeaderCol + 2, lMinCol, lMaxCol) Then
                    .DataByteString(3) = sInitalDataByte3
                End If
                If FillDownColPassed(mInMsgValueFirstByteCol, lMinCol, lMaxCol) Then
                    .DataByteString(4) = sInitalDataByte4
                End If
                If FillDownColPassed(mInMsgValueFirstByteCol + 1, lMinCol, lMaxCol) Then
                    .DataByteString(5) = sInitalDataByte5
                End If
                If FillDownColPassed(mInMsgValueFirstByteCol + 2, lMinCol, lMaxCol) Then
                    .DataByteString(6) = sInitalDataByte6
                End If

            End With
            
            '// update the changes
            UpdateIncomingMessageRow lCount
        Next lCount
    End With
                
    '// refresh the grid repainting
    obApp.RefreshIncomingMessageFilterTable '// refresh the filter table
    grdIncomingMessages.Redraw = True
    MousePointer = vbDefault
    
End Sub

Private Sub mnuIncomingFilter_Click()
    '// setup the fill down menu
    If grdIncomingMessages.Row > grdIncomingMessages.RowSel Then
        mnuIncomingFillDown.Caption = "Fill Up"
    Else
        mnuIncomingFillDown.Caption = "Fill down"
    End If
    If grdIncomingMessages.Row = grdIncomingMessages.RowSel Then
        mnuIncomingFillDown.Enabled = False
    Else
        mnuIncomingFillDown.Enabled = True
    End If
    If grdIncomingMessages.Rows <= 1 Then
        mnuIncomingFilterExclude.Enabled = False
        mnuIncomingFilterInclude.Enabled = False
    Else
        mnuIncomingFilterExclude.Enabled = True
        mnuIncomingFilterInclude.Enabled = True
    End If
    
    
End Sub

Private Sub mnuIncomingFilterExclude_Click()
    Dim lNumFilters As Long
    Dim lCount As Long
    Dim lStartRow As Long
    Dim lStopRow As Long
    Dim lSwap As Long
    Dim lNumToAdd As Long
    Dim lInitalFilterCount As Long
    Dim lFilterCount As Long


    '// determine how many to add
    lStartRow = grdIncomingMessages.Row
    lStopRow = grdIncomingMessages.RowSel
    If lStartRow > lStopRow Then
        lSwap = lStartRow
        lStartRow = lStopRow
        lStopRow = lSwap
    End If

    '// how many to add
    lNumToAdd = lStopRow - lStartRow + 1

    With obApp.Monitor.Filters
        lInitalFilterCount = .ExcludedFiltersCount
        lNumFilters = .ExcludedFiltersCount + lNumToAdd
        Call .SetNumExcludedFilters(lNumFilters)
        For lFilterCount = lStartRow To lStopRow
            lCount = lCount + 1
            .ExcludedFiltersKey(lInitalFilterCount + lCount) = obApp.IncomingMessages(lFilterCount).Key
        Next lFilterCount
        Call .CompileFilterIndexes(obApp.IncomingMessages)
    End With
    
End Sub

Private Sub mnuIncomingFilterInclude_Click()
    Dim lNumFilters As Long
    Dim lCount As Long
    Dim lStartRow As Long
    Dim lStopRow As Long
    Dim lSwap As Long
    Dim lNumToAdd As Long
    Dim lInitalFilterCount As Long
    Dim lFilterCount As Long


    '// determine how many to add
    lStartRow = grdIncomingMessages.Row
    lStopRow = grdIncomingMessages.RowSel
    If lStartRow > lStopRow Then
        lSwap = lStartRow
        lStartRow = lStopRow
        lStopRow = lSwap
    End If

    '// how many to add
    lNumToAdd = lStopRow - lStartRow + 1

    With obApp.Monitor.Filters
        lInitalFilterCount = .IncludedFiltersCount
        lNumFilters = .IncludedFiltersCount + lNumToAdd
        Call .SetNumIncludedFilters(lNumFilters)
        For lFilterCount = lStartRow To lStopRow
            lCount = lCount + 1
            .IncludedFiltersKey(lInitalFilterCount + lCount) = grdIncomingMessages.TextMatrix(lFilterCount, 0)
        Next lFilterCount
        Call .CompileFilterIndexes(obApp.IncomingMessages) '// must be called if running
    End With

End Sub

