    .ReadWriteString sSpace
    .ReadWriteString sSpace
End With

SetupProtocol   '// setup the protocol based on hardware ID



'// handle the incoming messages
If bHasOutgoingKeyInfo Then
    
    '// read/write the index count
    lTemp = OutgoingMessages.IndexCount
    obSave.ReadWriteLong lTemp
    OutgoingMessages.IndexCount = lTemp
    
    '// read/write the number of items
    NumItems = OutgoingMessages.Count
    obSave.ReadWriteLong NumItems
    
    '// read/write the key strings
    If bWriteDirection Then
        '// write the keys
        For lCount = 1 To NumItems
            sTemp = OutgoingMessages(lCount).Key
            obSave.ReadWriteString sTemp
        Next lCount
    Else
        '// read keys and do a private add
        OutgoingMessages.RemoveAll
        For lCount = 1 To NumItems
            obSave.ReadWriteString sTemp
            Call OutgoingMessages.PrivateAdd(sTemp)
        Next lCount
    End If
    
    '// read/write the collection
    For lCount = 1 To NumItems
        Call OutgoingMessages.Item(lCount).ReadWrite(bWriteDirection, obSave, lVersion)
    Next lCount

Else
   '// How many messages are there?
    OutgoingMessages.IndexCount = 0
    NumItems = OutgoingMessages.Count
    obSave.ReadWriteLong NumItems
    
    '// Add procedures if necessary
    If Not bWriteDirection Then
        OutgoingMessages.RemoveAll
        For lCount = 1 To NumItems
            OutgoingMessages.Add
        Next lCount
    End If
    
    '// Store the procedures
    For lCount = 1 To NumItems
        Call OutgoingMessages.Item(lCount).ReadWrite(bWriteDirection, obSave, lVersion)
    Next lCount
    '////////////////////////////////////////////////
End If



'// handle the incoming messages
If bHasIncomingKeyInfo Then
    
    '// read/write the index count
    lTemp = IncomingMessages.IndexCount
    obSave.ReadWriteLong lTemp
    IncomingMessages.IndexCount = lTemp
    
    '// read/write the number of items
    NumItems = IncomingMessages.Count
    obSave.ReadWriteLong NumItems
    
    '// read/write the key strings
    If bWriteDirection Then
        '// write the keys
        For lCount = 1 To NumItems
            sTemp = IncomingMessages(lCount).Key
            obSave.ReadWriteString sTemp
        Next lCount
    Else
        '// read keys and do a private add
        IncomingMessages.RemoveAll
        For lCount = 1 To NumItems
            obSave.ReadWriteString sTemp
            Call IncomingMessages.PrivateAdd(sTemp)
        Next lCount
    End If
    
    '// read/write the collection
    For lCount = 1 To NumItems
        Call IncomingMessages.Item(lCount).ReadWrite(bWriteDirection, obSave, lVersion)
    Next lCount

Else
    '////////////////////////////////////////////////'////////////////////////////////////////////////
    '// How many filters are there?
    IncomingMessages.IndexCount = 0
    NumItems = IncomingMessages.Count
    obSave.ReadWriteLong NumItems
    
    '// Add procedures if necessary
    If Not bWriteDirection Then
        IncomingMessages.RemoveAll
        For lCount = 1 To NumItems
            IncomingMessages.Add
        Next lCount
    End If
    
    '// read the incoming messages
    For lCount = 1 To NumItems
        Call IncomingMessages.Item(lCount).ReadWrite(bWriteDirection, obSave, lVersion)
    Next lCount
    '////////////////////////////////////////////////'////////////////////////////////////////////////
End If


'// How many tests are there?
NumItems = Tests.Count
obSave.ReadWriteLong NumItems

'// Add procedures if necessary
If Not bWriteDirection Then
    Tests.RemoveAll
    For lCount = 1 To NumItems
        Tests.Add
    Next lCount
End If

'// Store the procedures
For lCount = 1 To NumItems
    Call Tests.Item(lCount).ReadWrite(bWriteDirection, obSave)
Next lCount
'////////////////////////////////////////////////

'// Handle the monitor
Call Monitor.ReadWrite(bWriteDirection, obSave)

'// Close the file if we created the obsave
If Not bPassed Then
    obSave.FileOpen = False
End If


Debug.Print "The load time: " & (timeGetTime - lTimeStart)


'// reset all the buffers if this was a read operation
If Not bWriteDirection Then
    ResetAllBuffers
End If

Debug.Print "The reset buffer time: " & (timeGetTime - lTimeStart)

ReadWrite = True

Exit Function

readwriteerrorHandle:

ReadWrite = False

End Function

Private Function ResetAllBuffers()
Dim lCount As Long
Dim lNum As Long

'// First the monitor
Monitor.Reset

lNum = mvarcTests.Count
For lCount = 1 To lNum
    '// Now, the tests
    mvarcTests(lCount).Buffer.Reset
Next lCount

End Function

