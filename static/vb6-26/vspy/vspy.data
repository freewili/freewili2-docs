Attribute VB_Name = "frmASCIIEquation"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit


Public obApp As cicsSpy
Public sIncomingKeyString As String               '// keystring of the equation we are editing

Public Sub SetupUI()
    '// set it up
    txtExpression = obApp.IncomingMessages(sIncomingKeyString).Equation
End Sub

Private Sub cmdAdd_Click()
    Dim sString As String
    Dim sExpression As String
    Dim sFront As String
    Dim sBack As String
    sString = lstDataBytes
    With txtExpression
        sExpression = .Text
        sFront = Left$(.Text, .SelStart)
        sBack = Right$(.Text, Len(.Text) - .SelStart)
        .Text = sFront & sString & sBack
        .SelStart = Len(sFront & sString)
        .SetFocus
    End With
End Sub

Private Sub CmdCancel_Click()
    Unload Me
End Sub

Private Sub CmdOk_Click()
    obApp.IncomingMessages(sIncomingKeyString).Equation = txtExpression
    obApp.App.SaveNeeded = True
    Unload Me
End Sub


Private Sub Form_Load()
    Dim iNumItems As Integer
    Dim iCount As Integer
    
    ''// Fill the list with the analog items
    For iCount = 1 To 8
        lstDataBytes.AddItem "{B" & iCount & "}"
    Next iCount
    With lstDataBytes
        .AddItem "{PT}"
        .AddItem "{TRGT}"
        .AddItem "{SRC}"
        .AddItem "{VALUE}"
        .AddItem "{ARB ID}"
        .AddItem "{RMT}"
        .AddItem "{ERR/STATUS}"
        .ListIndex = 0
    End With
    
End Sub
