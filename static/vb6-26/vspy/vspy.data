    '// Size an array for the tx messages
    If OutgoingMessages.Count > 0 Then
        ReDim sNames(1 To OutgoingMessages.Count)
        
        '// Transfer the names into the array
        For lCount = 1 To OutgoingMessages.Count
            sName = OutgoingMessages(lCount).Description
            If sName = "" Then sName = "Unnamed Message " & lCount
            sNames(lCount) = sName
        Next lCount
        
        '// Return the names of the TX messages
        TxNames = sNames
    End If
    
End Sub

Friend Function NewBufferFromFilter(oldBuffer As cBuffer, mFilters As cFilters) As cBuffer

Dim lNumItems As Long
Dim lNumAdded As Long
Dim newBuffer As New cBuffer '// a new buffer
Dim lMsgCount As Long
Dim lCount As Long
Dim lResponse As Long
Dim dResult As Double
Dim lValue As Long
Dim msg As icsSpyMessageLong
Dim bNotNetworkMessage As Boolean
Dim lResponseDelay As Long

'// setup the filter table
SetupIncomingMessagesForRun

'// Did the buffer overflow?
If oldBuffer.NumberItems > oldBuffer.BufferLength Then
    lNumItems = oldBuffer.BufferLength  '// the buffer overflowed, use the entire thing
Else
    lNumItems = oldBuffer.NumberItems   '// the buffer has not overflowed yet, use the buffer length property
End If


'// set the new buffer size to the number of items in the old buffer
Call newBuffer.SetBufferLength(lNumItems)

'// now run through this filter
For lMsgCount = 1 To lNumItems
    
    Call oldBuffer.GetElement(msg, lMsgCount)   '// get the buffer item
    
    '// is this the network message
    bNotNetworkMessage = Not ((icsSpyStatusNetworkMessageType And msg.StatusBitField) > 0)
    
    '// Run Bytes through all the incoming messages
    For lCount = 1 To mNumInMsgs
        If inmsgInputMessages(lCount).bEnabled Then
            '// Check the status byte firs
            If bNotNetworkMessage Then
                lValue = msg.StatusBitField
            Else
                lValue = msg.StatusBitField And inmsgInputMessages(lCount).mMsg.StatusMask
            End If
            
            If lValue = inmsgInputMessages(lCount).mMsg.StatusValue Then
                '// Check the header, first mask the don't care bits by setting them all to
                '// zero
                lValue = msg.ArbIDOrHeader And inmsgInputMessages(lCount).mMsg.HeaderMask
                If lValue = inmsgInputMessages(lCount).mMsg.Header Or bNotNetworkMessage Then
                    'the header passed, so check data bytes
                    'Check the first four data bytes, apply the mask and compare
                    lValue = msg.DataMsb And inmsgInputMessages(lCount).mMsg.ByteDataMaskMsb '// change this
                    If lValue = inmsgInputMessages(lCount).mMsg.ByteDataMsb Or bNotNetworkMessage Then
                        'Check the last four data bytes, apply the mask and compare
                        lValue = msg.DataLsb And inmsgInputMessages(lCount).mMsg.ByteDataMaskLsb
                        If lValue = inmsgInputMessages(lCount).mMsg.ByteDataLsb Or bNotNetworkMessage Then
                            
                            'match
                            inmsgInputMessages(lCount).bLastBytePassed = True
                            
                            '// let the incoming message know it was received
                            Call mvarcIncomingMessages(lCount).PassedFilter(msg, lResponse, lResponseDelay, dResult)
                            
                            '// cache the result
                            dIncomingValues(lCount) = dResult
                            dIncomingPresentFlags(lCount) = True
                
                            '// is this a tx msg?
                            If (msg.StatusBitField And icsSpyStatusTx) = 0 Then
                                '// no it is not
                                msg.DescriptionID = lCount
                            End If

                        Else
                            inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                        End If
                    Else
                        'This filter failed
                        inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                    End If
                Else
                    'This filter failed change the flag
                    inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                End If
            Else
                '// This filter failed change the flag
                inmsgInputMessages(lCount).bLastBytePassed = False
            End If
        End If
    Next lCount '///////////////////////////////////////////////////////
    
    '// check filter
    If mFilters(Me) Then
        Call newBuffer.AddElement(msg)   '// add to the new buffer
    End If
Next lMsgCount

'// trim the messages not required
newBuffer.TrimBuffer

'// return the new buffer
Set NewBufferFromFilter = newBuffer

End Function

Friend Function BufferStatsWizard(oldBuffer As cBuffer, ByVal sFilename As String, _
            ByVal sCaption As String) As Boolean

Dim lNumItems As Long
Dim lNumAdded As Long
Dim lMsgCount As Long
Dim lCount As Long
Dim lResponse As Long
Dim dResult As Double
Dim lValue As Long
Dim msg As icsSpyMessageLong
Dim lFileNum As Long
Dim dAverageTime As Double
Dim dAverageValue As Double
Dim CurrentTime As SpyMsgTime
Dim dTime As Double
Dim stMsgs() As statmsg
Dim sDescription As String
Dim bToggleHighlight As Boolean
Dim sRowColor As String
Dim FirstMessageTime As SpyMsgTime
Dim LastMessageTime As SpyMsgTime
Dim dBufferTime As Double
Dim bNotNetworkMessage As Boolean
Dim lResponseDelay As Long

'// only do this if there is at least one message
If IncomingMessages.Count = 0 Then Exit Function

'// setup the data arrays
ReDim stMsgs(1 To IncomingMessages.Count)

'// setup the filter table
SetupIncomingMessagesForRun

'// Did the buffer overflow?
If oldBuffer.NumberItems > oldBuffer.BufferLength Then
    lNumItems = oldBuffer.BufferLength  '// the buffer overflowed, use the entire thing
Else
    lNumItems = oldBuffer.NumberItems   '// the buffer has not overflowed yet, use the buffer length property
End If



'// now run through this filter
For lMsgCount = 1 To lNumItems
    
    Call oldBuffer.GetElement(msg, lMsgCount)   '// get the buffer item
    
    '// is this the network message
    bNotNetworkMessage = Not ((icsSpyStatusNetworkMessageType And msg.StatusBitField) > 0)
    
    If lMsgCount = 1 Then
        '// get the first message time
        With FirstMessageTime
            .HardwareTimeMs = msg.TimeHardware
            .SystemTimeMs = msg.TimeSystem
            .HardwareTimePresent = (msg.StatusBitField And icsSpyStatusHardwareTimePresent) > 0
        End With
        
    ElseIf lMsgCount = lNumItems Then
        '// get the last message time
        With LastMessageTime
            .HardwareTimeMs = msg.TimeHardware
            .SystemTimeMs = msg.TimeSystem
            .HardwareTimePresent = (msg.StatusBitField And icsSpyStatusHardwareTimePresent) > 0
        End With
        '// calculate the time
        dBufferTime = GetSpyTimeSec(FirstMessageTime, LastMessageTime)
    End If
    
    '// Run Bytes through all the incoming messages
    For lCount = 1 To mNumInMsgs
        If inmsgInputMessages(lCount).bEnabled Then
            '// Check the status byte firs
            If bNotNetworkMessage Then
                lValue = msg.StatusBitField
            Else
                lValue = msg.StatusBitField And inmsgInputMessages(lCount).mMsg.StatusMask
            End If
            If lValue = inmsgInputMessages(lCount).mMsg.StatusValue Then
                '// Check the header, first mask the don't care bits by setting them all to
                '// zero
                lValue = msg.ArbIDOrHeader And inmsgInputMessages(lCount).mMsg.HeaderMask
                If lValue = inmsgInputMessages(lCount).mMsg.Header Or bNotNetworkMessage Then
                    'the header passed, so check data bytes
                    'Check the first four data bytes, apply the mask and compare
                    lValue = msg.DataMsb And inmsgInputMessages(lCount).mMsg.ByteDataMaskMsb '// change this
                    If lValue = inmsgInputMessages(lCount).mMsg.ByteDataMsb Or bNotNetworkMessage Then
                        'Check the last four data bytes, apply the mask and compare
                        lValue = msg.DataLsb And inmsgInputMessages(lCount).mMsg.ByteDataMaskLsb
                        If lValue = inmsgInputMessages(lCount).mMsg.ByteDataLsb Or bNotNetworkMessage Then
                            
                            'match
                            inmsgInputMessages(lCount).bLastBytePassed = True
                            
                            '// let the incoming message know it was received
                            Call mvarcIncomingMessages(lCount).PassedFilter(msg, lResponse, lResponseDelay, dResult)
                            
                            '// cache the result
                            dIncomingValues(lCount) = dResult
                            dIncomingPresentFlags(lCount) = True
                
                            '// is this a tx msg?
                            If (msg.StatusBitField And icsSpyStatusTx) = 0 Then
                                '// no it is not
                                msg.DescriptionID = lCount
                            End If
                            
                            With stMsgs(lCount)
                                 .lMessageCount = .lMessageCount + 1
                                 
                                 '// is this the first message?
                                 If .lMessageCount = 1 Then
                                    '// set the start value
                                    .dStartValue = dResult
                                    .dMaxValue = dResult
                                    
                                    .dMinValue = dResult
                                    .lMinValueLocation = lMsgCount
                                    .lMaxTimeLocation = lMsgCount
                                    
                                    '// set the last time
                                    .LastTime.HardwareTimeMs = msg.TimeHardware
                                    .LastTime.SystemTimeMs = msg.TimeSystem
                                    .LastTime.HardwareTimePresent = (msg.StatusBitField And icsSpyStatusHardwareTimePresent) > 0
                                    
                                 Else
                                    '// check for min and max
                                    If dResult > .dMaxValue Then
                                        .dMaxValue = dResult
                                        .lMaxValueLocation = lMsgCount
                                    End If
                                    
                                    If dResult < .dMinValue Then
                                        .dMinValue = dResult
                                        .lMinValueLocation = lMsgCount
                                    End If
                                    
                                    
                                    
                                End If
                                
                                '// set the current time
                                CurrentTime.HardwareTimeMs = msg.TimeHardware
                                CurrentTime.SystemTimeMs = msg.TimeSystem
                                CurrentTime.HardwareTimePresent = (msg.StatusBitField And icsSpyStatusHardwareTimePresent) > 0
                                
                                '// Get the time difference
                                dTime = GetSpyTimeSec(.LastTime, CurrentTime)
                                
                                '// save this time
                                .LastTime = CurrentTime
                                
                                '// see
                                If .lMessageCount > 1 Then
                                    If .lMessageCount = 2 Then
                                        '// seed
                                        .dStartTime = dTime
                                        .dMaxTime = dTime
                                        .dMinTime = dTime
                                        .lMaxTimeLocation = lMsgCount
                                        .lMinTimeLocation = lMsgCount
                                    Else
                                        '// check for the min and max timing
                                        If dTime > .dMaxTime Then
                                            .dMaxTime = dTime
                                            .lMaxTimeLocation = lMsgCount
                                        End If
                                        
                                        If dTime < .dMinTime Then
                                            .dMinTime = dTime
                                            .lMinTimeLocation = lMsgCount
                                        End If
                                    End If
                                End If
                                
                                '// determine the sum for the mean
                                .dValueSum = .dValueSum + dResult
                                .dTimeSum = .dTimeSum + dTime
                                
                                '// stop value should alway contain the last result
                                .dStopValue = dResult
                                .dStopTime = dTime
                                
                                '// setup the location string
                                '.sLineString = .sLineString & lMsgCount & " - "
                                
                            End With
                                 
                        Else
                            inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                        End If
                    Else
                        'This filter failed
                        inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                    End If
                Else
                    'This filter failed change the flag
                    inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                End If
            Else
                '// This filter failed change the flag
                inmsgInputMessages(lCount).bLastBytePassed = False
            End If
        End If
    Next lCount '///////////////////////////////////////////////////////
    
    
Next lMsgCount

'// get a free file number
lFileNum = FreeFile



If LCase$(Right$(sFilename, 3)) = "htm" Then
    Open sFilename For Output As #lFileNum    '// open the file
    
    '// print the header
    Print #lFileNum, "<HTML>"
    Print #lFileNum, "<BODY BGCOLOR=""" & "FFFFFF" & """ &  Text = """ & "000000" & """ > "
    Print #lFileNum, "<HEAD><TITLE>Vehicle Spy Buffer Statistics</TITLE>"
    Print #lFileNum, "<META NAME=""GENERATOR"" CONTENT=""Intrepid Control Systems Vehicle Spy 1.0"">"
    Print #lFileNum, "<META NAME=""VSPYDOCTYPE"" CONTENT=""VSPYBANAL""></HEAD>"
    Print #lFileNum, "<A NAME=""TOP""></A>"
    Print #lFileNum, "<B><FONT FACE=""Arial,Helvetica, Geneva, Swiss, Sans Serif""><CENTER>Vehicle Spy Buffer Analysis</FONT></B><BR>"
    Print #lFileNum, "Total Number of Messages: " & lNumItems & "<BR>"
    Print #lFileNum, "First/Last Message Time Diff (sec): " & dBufferTime & "<BR>"
    Print #lFileNum, "Time Created : " & Format$(Now(), "hh:mm:ss am/pm") & "<BR>"
    Print #lFileNum, "Date Created : " & Format$(Now(), "mm/dd/yyyy") & "</CENTER><P><HR>"
    Print #lFileNum, "<CENTER><A HREF=""#BOTTOM"">To Bottom</A></CENTER>" & "<BR>"
    
    
    Print #lFileNum, "<TABLE>"
    Print #lFileNum, "<TR><TH>&nbsp;</TH><TH>&nbsp; </TH><TH>Time Between Messages Analysis</TH><TH>&nbsp;</TH><TH>&nbsp;</TH><TH>&nbsp;</TH><TH>&nbsp;</TH><TH>Value Analysis</TH><TH></TH><TH></TH><TH></TH><TH></TH><TH>Location</TH></TR>" & "<BR>"
    Print #lFileNum, "<TR><TH WIDTH=25%>Description</TH><TH>Count</TH><TH>Start(s)</TH><TH>Stop(s)</TH><TH>Min(s)</TH>" & _
        "<TH>Max(s)</TH><TH>Mean(s)</TH><TH>Start</TH><TH>Stop</TH><TH>Min</TH><TH>Max</TH><TH>Mean</TH><TH>Lines</TH></TR>"
    '// write the rest of the file
    For lCount = 1 To IncomingMessages.Count
        
        With stMsgs(lCount)
            '// determine the averages
            If .lMessageCount > 1 Then
                dAverageValue = (.dValueSum / CDbl(.lMessageCount - 1))
                dAverageTime = (.dTimeSum / CDbl(.lMessageCount - 1))
            Else
                dAverageValue = 0
                dAverageTime = 0
            End If
            
            '// get the description of the message
            sDescription = IncomingMessages(lCount).Description
            If Trim$(sDescription) = "" Then
                sDescription = "Unnamed Messsage"
            End If
            
            '// alternate the colors of individual rows
            bToggleHighlight = Not bToggleHighlight
            If bToggleHighlight Then
                sRowColor = "BGCOLOR=""FCFCC8""" '& Hex(&H200000 Xor &HA0)
            Else
                sRowColor = ""
            End If
            
            
            
            '// write the data to the file
            Print #lFileNum, "<TR " & sRowColor & "><TD" & " NOWRAP>" & sDescription & "</TD><TD>" & .lMessageCount & "</TD><TD>" & .dStartTime & "</TD><TD>"; .dStopTime & "</TD><TD>" & _
                .dMinTime & "</TD><TD>"; .dMaxTime & "</TD><TD>" & Format$(dAverageTime, "0.000") & "</TD><TD>" & .dStartValue & "</TD><TD>" & _
                .dStopValue & "</TD><TD>" & .dMinValue & "</TD><TD>" & .dMaxValue & "</TD><TD>" & dAverageValue & "</TD><TD NOWRAP>" & .sLineString & "</TD></TR>"
        End With
    Next lCount
    
    
    Print #lFileNum, "</TABLE><BR>"
    
    Print #lFileNum, "<P><CENTER><A HREF=""#TOP"">To Top</A> <hr><br><FONT FACE=""Arial,Helvetica, Geneva, Swiss, Sans Serif"" SIZE=-1>Vehicle Spy Buffer Statistics Analysis - <A HREF=""http://www.intrepidcs.com"">Intrepid Control Systems, Inc.</a></FONT></CENTER>"
    Print #lFileNum, "<A NAME=""BOTTOM""></A>"
    Print #lFileNum, "</BODY>"
    Print #lFileNum, "</HTML>"


    '// close the file
    Close #lFileNum

Else

    Open sFilename For Output As #lFileNum    '// open the file
    
    '// print the header
    Print #lFileNum, "Vehicle Spy Buffer Statistics"
    Print #lFileNum, "Description," & sCaption
    Print #lFileNum, "Total Number of Messages:, " & lNumItems
    Print #lFileNum, "First/Last Message Time Diff (sec)," & dBufferTime
    Print #lFileNum, " , ,Time Between Messages Analysis,,,,,,,Value Analysis,,,,,,,Location"
    Print #lFileNum, "Description,Count,Start(s),Stop(s),Min(s), Min Line,Max(s),Max Line,Mean(s),Start,Stop,Min,Min Line,Max,Max Line,Mean,Lines"
    
    '// write the rest of the file
    For lCount = 1 To IncomingMessages.Count
        With stMsgs(lCount)
            '// determine the averages
            If .lMessageCount > 1 Then
                dAverageValue = (.dValueSum / CDbl(.lMessageCount - 1))
                dAverageTime = (.dTimeSum / CDbl(.lMessageCount - 1))
            Else
                dAverageValue = 0
                dAverageTime = 0
            End If
            
            '// get the description of the message
            sDescription = IncomingMessages(lCount).Description
            If Trim$(sDescription) = "" Then
                sDescription = "Unnamed Messsage"
            End If
            
            '// write the data to the file
            Print #lFileNum, sDescription & "," & .lMessageCount & "," & .dStartTime & ","; .dStopTime & "," & _
                .dMinTime & "," & .lMinTimeLocation & "," & .dMaxTime & "," & .lMaxTimeLocation & "," & dAverageTime & "," & .dStartValue & "," & _
                .dStopValue & "," & .dMinValue & "," & .lMinValueLocation & "," & .dMaxValue & "," & .lMaxValueLocation & "," & dAverageValue & "," & .sLineString
        End With
    Next lCount


    '// close the file
    Close #lFileNum


End If



End Function
'// called by the various hardware objects when a new msg is received by the hardware
Public Sub NewMsg(MessageBytes As Variant)
    
    Dim lCount As Long
    Dim msg As icsSpyMessageLong
    Dim ByteData() As Byte  '// temporarily holds the byte data
    Dim lResponse As Long
    Dim dResult As Double
    Dim lValue As Long
    Dim bNotNetworkMessage As Boolean
    Dim lResponseDelay As Long
    

    
    '// copy to the standard data structure
    ByteData = MessageBytes
    Call CopySpyBytesToSpyMessageLong(ByteData, msg)
    
    '// is this the network message
    bNotNetworkMessage = Not ((icsSpyStatusNetworkMessageType And msg.StatusBitField) > 0)
    
    '// increment the message count
    If Not bNotNetworkMessage Then
        lMessageCount = lMessageCount + 1
    End If
    
    '// Run Bytes through all the incoming messages
    For lCount = 1 To mNumInMsgs
        If inmsgInputMessages(lCount).bEnabled Then
            
            '// Check the status byte first
            If bNotNetworkMessage Then
                lValue = msg.StatusBitField
            Else
                lValue = msg.StatusBitField And inmsgInputMessages(lCount).mMsg.StatusMask
            End If
            
            If lValue = inmsgInputMessages(lCount).mMsg.StatusValue Then
                '// Check the header, first mask the don't care bits by setting them all to
                '// zero
                lValue = msg.ArbIDOrHeader And inmsgInputMessages(lCount).mMsg.HeaderMask
                If lValue = inmsgInputMessages(lCount).mMsg.Header Or bNotNetworkMessage Then
                    'the header passed, so check data bytes
                    'Check the first four data bytes, apply the mask and compare
                    lValue = msg.DataMsb And inmsgInputMessages(lCount).mMsg.ByteDataMaskMsb '// change this
                    If lValue = inmsgInputMessages(lCount).mMsg.ByteDataMsb Or bNotNetworkMessage Then
                        'Check the last four data bytes, apply the mask and compare
                        lValue = msg.DataLsb And inmsgInputMessages(lCount).mMsg.ByteDataMaskLsb
                        If lValue = inmsgInputMessages(lCount).mMsg.ByteDataLsb Or bNotNetworkMessage Then
                            
                            'match
                            inmsgInputMessages(lCount).bLastBytePassed = True
                            
                            '// let the incoming message know it was received
                            Call mvarcIncomingMessages(lCount).PassedFilter(msg, lResponse, lResponseDelay, dResult)
                            
                            '// cache the result
                            dIncomingValues(lCount) = dResult
                            dIncomingPresentFlags(lCount) = True
                
                            '// handle responses messages
                            If lResponse <> 0 Then
                                If lResponseDelay > 0 Then
                                    Call TransmitWithTimeStamp(lResponse, timeGetTime + lResponseDelay)
                                Else
                                    Call Transmit(lResponse)
                                End If
                            End If
                
                            '// is this a tx msg?
                            If (msg.StatusBitField And icsSpyStatusTx) = 0 Then
                                '// no it is not
                                msg.DescriptionID = lCount
                            End If

                        Else
                            inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                        End If
                    Else
                        'This filter failed
                        inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                    End If
                Else
                    'This filter failed change the flag
                    inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                End If
            Else
                '// This filter failed change the flag
                inmsgInputMessages(lCount).bLastBytePassed = False
            End If
        End If
    Next lCount '///////////////////////////////////////////////////////
    
    
    
    '// Add the element to the monitor ////////////////////////////////
    If mvarcMonitor.Filters(Me) Or Not mvarcMonitor.UseFilters Then
        Call mvarcMonitor.AddMessage(msg)
    End If
    
    '// Add the message to all the current tests
    For lCount = 1 To mNumTests
        Call mvarcTests(lCount).AddMessage(msg)
    Next lCount
    
End Sub

'// called by the various hardware objects when a new msg is received by the hardware
Public Sub NewMsgJ1850(msg1850 As icsSpyMessageJ1850)
    
    Dim lCount As Long
    Dim msg As icsSpyMessageLong
    Dim lResponse As Long
    Dim dResult As Double
    Dim lValue As Long
    Dim bNotNetworkMessage As Boolean
    Dim lResponseDelay As Long
    
    
    '// copy to the standard data structure
    LSet msg = msg1850
    
    '// is this the network message
    bNotNetworkMessage = Not ((icsSpyStatusNetworkMessageType And msg.StatusBitField) > 0)
    
    If Not bNotNetworkMessage Then
        '// increment the message count
        lMessageCount = lMessageCount + 1
    End If
    
    '// Run Bytes through all the incoming messages
    For lCount = 1 To mNumInMsgs
        If inmsgInputMessages(lCount).bEnabled Then
            '// Check the status byte first
            If bNotNetworkMessage Then
                lValue = msg.StatusBitField
            Else
                lValue = msg.StatusBitField And inmsgInputMessages(lCount).mMsg.StatusMask
            End If
            If lValue = inmsgInputMessages(lCount).mMsg.StatusValue Then
                '// Check the header, first mask the don't care bits by setting them all to
                '// zero
                lValue = msg.ArbIDOrHeader And inmsgInputMessages(lCount).mMsg.HeaderMask
                If lValue = inmsgInputMessages(lCount).mMsg.Header Or bNotNetworkMessage Then
                    'the header passed, so check data bytes
                    'Check the first four data bytes, apply the mask and compare
                    lValue = msg.DataMsb And inmsgInputMessages(lCount).mMsg.ByteDataMaskMsb '// change this
                    If lValue = inmsgInputMessages(lCount).mMsg.ByteDataMsb Or bNotNetworkMessage Then
                        'Check the last four data bytes, apply the mask and compare
                        lValue = msg.DataLsb And inmsgInputMessages(lCount).mMsg.ByteDataMaskLsb
                        If lValue = inmsgInputMessages(lCount).mMsg.ByteDataLsb Or bNotNetworkMessage Then
                            
                            'match
                            inmsgInputMessages(lCount).bLastBytePassed = True
                            
                            '// let the incoming message know it was received
                            Call mvarcIncomingMessages(lCount).PassedFilter(msg, lResponse, lResponseDelay, dResult)
                            
                            '// cache the result
                            dIncomingValues(lCount) = dResult
                            dIncomingPresentFlags(lCount) = True
                
                            '// handle responses messages
                            If lResponse <> 0 Then
                                If lResponseDelay > 0 Then
                                    Call TransmitWithTimeStamp(lResponse, timeGetTime + lResponseDelay)
                                Else
                                    Call Transmit(lResponse)
                                End If
                            End If
                
                            '// is this a tx msg?
                            If (msg.StatusBitField And icsSpyStatusTx) = 0 Then
                                '// no it is not
                                msg.DescriptionID = lCount
                            End If

                        Else
                            inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                        End If
                    Else
                        'This filter failed
                        inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                    End If
                Else
                    'This filter failed change the flag
                    inmsgInputMessages(lCount).bLastBytePassed = False '// Set the equals last byte flag
                End If
            Else
                '// This filter failed change the flag
                inmsgInputMessages(lCount).bLastBytePassed = False
            End If
        End If
    Next lCount '///////////////////////////////////////////////////////
    
    
    
    '// Add the element to the monitor ////////////////////////////////
    If mvarcMonitor.Filters(Me) Or Not mvarcMonitor.UseFilters Then
        Call mvarcMonitor.AddMessage(msg)
    End If
    
    '// Add the message to all the current tests
    For lCount = 1 To mNumTests
        Call mvarcTests(lCount).AddMessage(msg)
    Next lCount
    
End Sub

Friend Sub BufferSave(buff As cBuffer, sOwner As String, _
        sFilePath As String, TriggerLocation As Long, SpyStartTime As SpyMsgTime, bUseDecimalFormatting As Boolean, Optional HeaderString As String = "")
        
    Set CurrentBufferSave = buff
    RaiseEvent BufferSaveComplete(True, False, 0)
    DoEvents
    Call buff.SaveBuffer(sFilePath, TriggerLocation, SpyStartTime, bUseDecimalFormatting, Me, HeaderString)
    RaiseEvent BufferSaveComplete(False, True, 0)
    Set CurrentBufferSave = Nothing
        
End Sub

Private Sub SetupTestVoiceList()
    Dim sList As String
    Dim obTest As cTest
    
    If Not mUseEventSounds Then Exit Sub
    
    
    '// build the list
    For Each obTest In Tests
        sList = sList & obTest.Description & " |"
    Next obTest
    
    
    '// remove the last pipe character
    sList = Left$(sList, Len(sList) - 1)
    
    '// set the list setup
    Call obVoice.ListSet("Test", Tests.Count, sList)

End Sub

Friend Sub SetupTxMessageVoiceList()
    Dim sList As String
    Dim obTxMessage As cTransmitButton
    Dim lCount As Long
    
    If Not mUseEventSounds Then Exit Sub
    
    '// build the list
    For Each obTxMessage In Monitor.TxButtons
        If Trim$(obTxMessage.Caption) <> "" Then
            lCount = lCount + 1
            sList = sList & obTxMessage.Caption & " |"
        End If
    Next obTxMessage
    
    If Len(sList) > 0 Then
        '// remove the last pipe character
        sList = Left$(sList, Len(sList) - 1)
    
        '// set the list setup
        Call obVoice.ListSet("Message", lCount, sList)
    End If
    
End Sub

'// initalize for a new setup
Public Sub MakeNew()

    Dim lCount As Long
    
    UndoStack.RemoveAll '// clear the undo stack
    
    '// setup the default hardware
    RestoreHardwareDefaults '// get the defaults for the hardware
    SetupProtocol
    DatabasePath = DefaultDatabasePath  '// default database path
    
    '// Remove all messages and filters
    IncomingMessages.IndexCount = 0
    IncomingMessages.RemoveAll
    For lCount = 1 To DefaultNumFilters
        IncomingMessages.Add
    Next lCount
    
    OutgoingMessages.IndexCount = 0
    OutgoingMessages.RemoveAll
    For lCount = 1 To DefaultNumMessages
        OutgoingMessages.Add
    Next lCount
    
    Monitor.MakeNew         '// Make the monitor buffer hold the default setup
    UserDialog.MakeNew      '// Clear the custom ui panle
    AVTHardware.MakeNew     '// Reset the AVT hardware
    
    '// Add tests
    Tests.RemoveAll
    For lCount = 1 To DefaultNumTests
        Tests.Add
    Next lCount
    
    '// Update the UIs
    RaiseEvent ResetAllUI
    RaiseEvent NewConfigurationLoaded

End Sub

Public Sub Refresh()
    RaiseEvent NewConfigurationLoaded
End Sub

'// These functions save defults common to all spy objects //////
Public Sub SaveApplicationDefaults()
    Call SaveSetting("icsVSpy", "Defaults", "NumberOfMessages", DefaultNumMessages)
    Call SaveSetting("icsVSpy", "Defaults", "NumberOfFilters", DefaultNumFilters)
    Call SaveSetting("icsVSpy", "Defaults", "DefaultDataBase", DefaultDatabasePath)
    Call SaveSetting("icsVSpy", "Defaults", "UseEventSounds", UseEventSounds)
    Call SaveSetting("icsVSpy", "Defaults", "NumberOfTests", DefaultNumTests)
End Sub

Public Sub SaveHardwareDefaults()
    Call SaveSetting("icsVSpy", "Defaults", "CommPort", HardwareCommPort)
    Call SaveSetting("icsVSpy", "Defaults", "BaudRate", HardwareBaudRate)
    Call SaveSetting("icsVSpy", "Defaults", "DefaultHardware", HardwareID)
    Call SaveSetting("icsVSpy", "Defaults", "DefaultSimulationProtocol", SimulationProtocol)
    Call SaveSetting("icsVSpy", "Defaults", "DefaultSimulationFilePath", mReplayFilePath)
End Sub

Public Sub RestoreHardwareDefaults()
    HardwareCommPort = GetSetting("icsVSpy", "Defaults", "CommPort", 1)
    HardwareBaudRate = GetSetting("icsVSpy", "Defaults", "BaudRate", 1)
    HardwareID = GetSetting("icsVSpy", "Defaults", "DefaultHardware", icsVSpyTypeDemo)
    SimulationProtocol = GetSetting("icsVSpy", "Defaults", "DefaultSimulationProtocol", icsVSPYProtocolJ1850)
    ReplayFilePath = GetSetting("icsVSpy", "Defaults", "DefaultSimulationFilePath", VB.App.Path & "\" & "engine rpm demo.csv")
End Sub

Public Sub RestoreApplicationDefaults()
    DefaultNumMessages = GetSetting("icsVSpy", "Defaults", "NumberOfMessages", 10)
    DefaultNumFilters = GetSetting("icsVSpy", "Defaults", "NumberOfFilters", 10)
    DefaultDatabasePath = GetSetting("icsVSpy", "Defaults", "DefaultDataBase", VB.App.Path & "\icsSpyBlank.mdb")
    UseEventSounds = GetSetting("icsVSpy", "Defaults", "UseEventSounds", False)
    DefaultNumTests = GetSetting("icsVSpy", "Defaults", "NumberOfTests", 1)
End Sub



