    mReplayFilePath = CompilePathSet(sNew)
End Property

Private Function CompilePathGet(sNewPath As String) As String
    Dim obFile As New cParseFileString
    
    If Len(Trim$(sNewPath)) = 0 Then Exit Function
    
    
    obFile.FullPath = sNewPath
    
    If obFile.DriveLetter = "" And Not obFile.IsUNCFileName Then
        CompilePathGet = VB.App.Path & "\" & sNewPath
    Else
        CompilePathGet = sNewPath    '// return the replay path
    End If
    

End Function
Private Function CompilePathSet(sNewPath As String) As String
    Dim obFile As New cParseFileString
    Dim lRightLen As Long
    
    obFile.FullPath = sNewPath
    
    If VB.App.Path = Left$(obFile.DirectoryPath, Len(VB.App.Path)) Then
        '// it's a relative path
        If Len(obFile.DirectoryPath) = Len(VB.App.Path) Then
            CompilePathSet = obFile.FileName & obFile.FileExtension
        Else
            lRightLen = Len(obFile.DirectoryPath) - Len(VB.App.Path) - 1
            If lRightLen >= 1 Then
                CompilePathSet = Right$(obFile.DirectoryPath, lRightLen) & "\" & obFile.FileName & obFile.FileExtension
            Else
                CompilePathSet = sNewPath    '// assign the new path
            End If
        End If
    Else
        CompilePathSet = sNewPath    '// assign the new path
    End If
    
End Function

